	state_FSM_FFd1 AND NOT addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2)));


A_I(0) <= ((addr_latch(0) AND NOT $OpTx$FX_DC$65)
	OR (D(0) AND $OpTx$FX_DC$65 AND NOT $OpTx$FX_DC$61)
	OR (row0 AND $OpTx$FX_DC$65 AND $OpTx$FX_DC$61));
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(1) <= ((addr_latch(1) AND NOT $OpTx$FX_DC$65)
	OR (D(1) AND $OpTx$FX_DC$65 AND NOT $OpTx$FX_DC$61)
	OR (row1 AND $OpTx$FX_DC$65 AND $OpTx$FX_DC$61));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
