	OR (WRn AND NOT A15 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND wr_seen AND wb_ram_q)
	OR (NOT IOM AND WRn AND A15 AND state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND state_FSM_FFd1 AND wr_seen AND NOT wb_ram_q AND NOT por_run AND 
	NOT RST));

FDCPE_wr_seen: FDCPE port map (wr_seen,wr_seen_D,clk,'0','0');
wr_seen_D <= ((NOT state_FSM_FFd2 AND wr_seen AND NOT por_run AND NOT RST)
	OR (state_FSM_FFd3 AND wr_seen AND NOT por_run AND NOT RST)
	OR (NOT state_FSM_FFd1 AND wr_seen AND NOT por_run AND NOT RST)
	OR (NOT WRn AND NOT ALE AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND NOT por_run AND NOT RST)
	OR (NOT WRn AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND rd_seen AND RDn AND NOT por_run AND NOT RST));

Register Legend:
 FDCPE (Q,D,C,CLR,PRE); 
 FTCPE (Q,D,C,CLR,PRE); 
 LDCP  (Q,D,G,CLR,PRE); 

