*******************************  Equations  ********************************

********** Mapped Logic **********


$OpTx$FX_DC$131 <= (NOT X1 AND NOT t0_q);


$OpTx$FX_DC$139 <= ((por_run)
	OR (RST)
	OR (NOT WRn AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1)
	OR (NOT IOM AND ALE AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1));


$OpTx$FX_DC$61 <= (IOM AND addr_latch(0) AND addr_latch(1) AND 
	NOT addr_latch(2));


$OpTx$FX_DC$65 <= (NOT ALE AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND rd_seen AND NOT RDn);


$OpTx$FX_SC$144 <= ((por_run)
	OR (ALE AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1));


$OpTx$FX_SC$149 <= ((por_run)
	OR (IOM AND NOT WRn AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND NOT addr_latch(0) AND NOT addr_latch(1) AND NOT addr_latch(2)));


