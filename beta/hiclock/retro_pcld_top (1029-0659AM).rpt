*******************************  Equations  ********************************

********** Mapped Logic **********


$OpTx$FX_DC$163 <= ((cnt(0) AND NOT cnt(1) AND NOT cnt(2) AND NOT cnt(3))
	OR (NOT cnt(0) AND NOT cnt(1) AND cnt(2) AND NOT cnt(3)));


$OpTx$FX_DC$63 <= (IOM AND addr_latch(0) AND addr_latch(1) AND 
	NOT addr_latch(2));


$OpTx$FX_DC$67 <= (NOT ALE AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND rd_seen AND NOT RDn);


$OpTx$FX_SC$146 <= ((por_run)
	OR (ALE AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1));


$OpTx$FX_SC$149 <= ((por_run)
	OR (IOM AND NOT WRn AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND NOT addr_latch(0) AND NOT addr_latch(1) AND NOT addr_latch(2)));


$OpTx$FX_SC$151 <= ((por_run)
	OR (IOM AND NOT WRn AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND addr_latch(0) AND NOT addr_latch(1) AND NOT addr_latch(2)));


$OpTx$FX_SC$154 <= ((por_run)
	OR (RST)
	OR (IOM AND NOT WRn AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND NOT addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2)));


$OpTx$FX_SC$164 <= ((cnt(0) AND NOT cnt(2) AND FC_7_.OUT)
	OR (NOT cnt(0) AND cnt(2) AND FC_7_.OUT));


A_I(0) <= ((addr_latch(0) AND NOT $OpTx$FX_DC$67)
	OR (D(0) AND $OpTx$FX_DC$67 AND NOT $OpTx$FX_DC$63)
	OR (row0 AND $OpTx$FX_DC$67 AND $OpTx$FX_DC$63));
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(1) <= ((addr_latch(1) AND NOT $OpTx$FX_DC$67)
	OR (D(1) AND $OpTx$FX_DC$67 AND NOT $OpTx$FX_DC$63)
	OR (row1 AND $OpTx$FX_DC$67 AND $OpTx$FX_DC$63));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
A_OE(1) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(2) <= ((addr_latch(2) AND NOT $OpTx$FX_DC$67)
	OR (D(2) AND $OpTx$FX_DC$67 AND NOT $OpTx$FX_DC$63)
	OR (row2 AND $OpTx$FX_DC$67 AND $OpTx$FX_DC$63));
A(2) <= A_I(2) when A_OE(2) = '1' else 'Z';
A_OE(2) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(3) <= ((addr_latch(3) AND NOT $OpTx$FX_DC$67)
	OR (D(3) AND $OpTx$FX_DC$67 AND NOT $OpTx$FX_DC$63)
	OR (row3 AND $OpTx$FX_DC$67 AND $OpTx$FX_DC$63));
A(3) <= A_I(3) when A_OE(3) = '1' else 'Z';
A_OE(3) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(4) <= ((addr_latch(4) AND NOT $OpTx$FX_DC$67)
	OR (D(4) AND $OpTx$FX_DC$67 AND NOT $OpTx$FX_DC$63)
	OR (row4 AND $OpTx$FX_DC$67 AND $OpTx$FX_DC$63));
A(4) <= A_I(4) when A_OE(4) = '1' else 'Z';
A_OE(4) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(5) <= ((addr_latch(5) AND NOT $OpTx$FX_DC$67)
	OR (D(5) AND $OpTx$FX_DC$67 AND NOT $OpTx$FX_DC$63));
A(5) <= A_I(5) when A_OE(5) = '1' else 'Z';
A_OE(5) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(6) <= ((addr_latch(6) AND NOT $OpTx$FX_DC$67)
	OR (D(6) AND $OpTx$FX_DC$67 AND NOT $OpTx$FX_DC$63));
A(6) <= A_I(6) when A_OE(6) = '1' else 'Z';
A_OE(6) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(7) <= ((addr_latch(7) AND NOT $OpTx$FX_DC$67)
	OR (D(7) AND $OpTx$FX_DC$67 AND NOT $OpTx$FX_DC$63));
A(7) <= A_I(7) when A_OE(7) = '1' else 'Z';
A_OE(7) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_7_IOBUFE/A_7_IOBUFE_TRST <= (NOT bus_reg(7)/bus_reg(7)_TRST AND NOT $OpTx$FX_DC$67);


BUF_txm_cnt(5) <= ((txm_cnt(5) AND cnt(1) AND NOT por_run AND NOT RST)
	OR (txm_cnt(5) AND cnt(3) AND NOT por_run AND NOT RST)
	OR (cnt(0) AND txm_cnt(5) AND cnt(2) AND NOT por_run AND NOT RST)
	OR (NOT cnt(0) AND txm_cnt(5) AND NOT cnt(2) AND NOT por_run AND NOT RST)
	OR (txm_cnt(5) AND txm_cnt(6) AND txm_cnt(7) AND NOT por_run AND 
	NOT RST)
	OR (txm_cnt(0) AND cnt(0) AND txm_cnt(2) AND txm_cnt(3) AND 
	NOT txm_cnt(5) AND NOT cnt(1) AND NOT cnt(2) AND txm_cnt(1) AND txm_cnt(4) AND 
	NOT cnt(3) AND NOT por_run AND NOT RST)
	OR (txm_cnt(0) AND NOT cnt(0) AND txm_cnt(2) AND txm_cnt(3) AND 
	NOT txm_cnt(5) AND NOT cnt(1) AND cnt(2) AND txm_cnt(1) AND txm_cnt(4) AND 
	NOT cnt(3) AND NOT por_run AND NOT RST)
	OR (NOT txm_cnt(0) AND txm_cnt(5) AND NOT por_run AND NOT RST)
	OR (NOT txm_cnt(2) AND txm_cnt(5) AND NOT por_run AND NOT RST)
	OR (NOT txm_cnt(3) AND txm_cnt(5) AND NOT por_run AND NOT RST)
	OR (txm_cnt(5) AND NOT txm_cnt(1) AND NOT por_run AND NOT RST)
	OR (txm_cnt(5) AND NOT txm_cnt(4) AND NOT por_run AND NOT RST));


CS1 <= '1';


CS_n <= NOT (((NOT IOM AND A15)
	OR (state_FSM_FFd3 AND wb_ram_q)
	OR (state_FSM_FFd2 AND NOT state_FSM_FFd1 AND wb_ram_q)));


CSr_n <= NOT ((NOT IOM AND NOT A15));

FDCPE_D0: FDCPE port map (D_I(0),D(0),clk,'0','0');
D(0) <= ((D(0) AND NOT bus_reg_0__or0000/bus_reg_0__or0000_D2)
	OR (NOT WRn AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND A(0).PIN AND NOT por_run AND NOT RST)
	OR (NOT IOM AND ALE AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND D(0).PIN AND NOT por_run AND NOT RST));
D(0) <= D_I(0) when D_OE(0) = '1' else 'Z';
D_OE(0) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D1_BUFR: FDCPE port map (D(1)_BUFR,D_D(1)_BUFR,clk,'0','0');
D_D(1)_BUFR <= ((D(1) AND NOT bus_reg_0__or0000/bus_reg_0__or0000_D2)
	OR (NOT WRn AND state_FSM_FFd2 AND A(1).PIN AND NOT RST AND 
	FC_6_.OUT)
	OR (NOT IOM AND ALE AND NOT state_FSM_FFd2 AND D(1).PIN AND NOT RST AND 
	FC_6_.OUT));


D_I(1) <= D(1)_BUFR;
D(1) <= D_I(1) when D_OE(1) = '1' else 'Z';
D_OE(1) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D2_BUFR: FDCPE port map (D(2)_BUFR,D_D(2)_BUFR,clk,'0','0');
D_D(2)_BUFR <= ((D(2) AND NOT bus_reg_0__or0000/bus_reg_0__or0000_D2)
	OR (NOT WRn AND state_FSM_FFd2 AND A(2).PIN AND NOT RST AND 
	FC_6_.OUT)
	OR (NOT IOM AND ALE AND NOT state_FSM_FFd2 AND D(2).PIN AND NOT RST AND 
	FC_6_.OUT));


D_I(2) <= D(2)_BUFR;
D(2) <= D_I(2) when D_OE(2) = '1' else 'Z';
D_OE(2) <= bus_reg(7)/bus_reg(7)_TRST;


D_I(3) <= D(3)_BUFR;
D(3) <= D_I(3) when D_OE(3) = '1' else 'Z';
D_OE(3) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D3_BUFR: FDCPE port map (D(3)_BUFR,D_D(3)_BUFR,clk,'0','0');
D_D(3)_BUFR <= ((D(3) AND NOT bus_reg_0__or0000/bus_reg_0__or0000_D2)
	OR (NOT WRn AND state_FSM_FFd2 AND A(3).PIN AND NOT RST AND 
	FC_6_.OUT)
	OR (NOT IOM AND ALE AND NOT state_FSM_FFd2 AND D(3).PIN AND NOT RST AND 
	FC_6_.OUT));

FDCPE_D4_BUFR: FDCPE port map (D(4)_BUFR,D_D(4)_BUFR,clk,'0','0');
D_D(4)_BUFR <= ((D(4) AND NOT bus_reg_0__or0000/bus_reg_0__or0000_D2)
	OR (NOT WRn AND state_FSM_FFd2 AND A(4).PIN AND NOT RST AND 
	FC_6_.OUT)
	OR (NOT IOM AND ALE AND NOT state_FSM_FFd2 AND D(4).PIN AND NOT RST AND 
	FC_6_.OUT));


D_I(4) <= D(4)_BUFR;
D(4) <= D_I(4) when D_OE(4) = '1' else 'Z';
D_OE(4) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D5_BUFR: FDCPE port map (D(5)_BUFR,D_D(5)_BUFR,clk,'0','0');
D_D(5)_BUFR <= ((D(5) AND NOT bus_reg_0__or0000/bus_reg_0__or0000_D2)
	OR (NOT WRn AND state_FSM_FFd2 AND A(5).PIN AND NOT RST AND 
	FC_6_.OUT)
	OR (NOT IOM AND ALE AND NOT state_FSM_FFd2 AND D(5).PIN AND NOT RST AND 
	FC_6_.OUT));


D_I(5) <= D(5)_BUFR;
D(5) <= D_I(5) when D_OE(5) = '1' else 'Z';
D_OE(5) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D6: FDCPE port map (D_I(6),D(6),clk,'0','0');
D(6) <= ((D(6) AND NOT bus_reg_0__or0000/bus_reg_0__or0000_D2)
	OR (NOT WRn AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND A(6).PIN AND NOT por_run AND NOT RST)
	OR (NOT IOM AND ALE AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND D(6).PIN AND NOT por_run AND NOT RST));
D(6) <= D_I(6) when D_OE(6) = '1' else 'Z';
D_OE(6) <= bus_reg(7)/bus_reg(7)_TRST;


D_I(7) <= D(7)_BUFR;
D(7) <= D_I(7) when D_OE(7) = '1' else 'Z';
D_OE(7) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D7_BUFR: FDCPE port map (D(7)_BUFR,D_D(7)_BUFR,clk,'0','0');
D_D(7)_BUFR <= ((D(7) AND NOT bus_reg_0__or0000/bus_reg_0__or0000_D2)
	OR (NOT WRn AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND A(7).PIN AND NOT por_run AND NOT RST)
	OR (NOT IOM AND ALE AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND D(7).PIN AND NOT por_run AND NOT RST));




OE_n <= NOT ((NOT IOM AND A15 AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3));


OEr_n <= NOT ((NOT IOM AND NOT A15 AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3));

