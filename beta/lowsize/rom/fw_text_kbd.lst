    1            ; =====================================================================
    2            ; beta/lowsize/rom -- fw_text_kbd: ТЕСТ КЛАВИАТУРЫ (строка/колонка + бип)
    3            ;
    4            ; Плата: retro_PCLD_board V2, CPLD = beta/lowsize v3.9.1/v3.9.2
    5            ; (транзиты kbcol/kbrow/seg/dig/SND идентичны v3.2...v3.9.x).
    6            ; Прошивается в flash A29040B с offset 0 (ЗАМЕНЯЕТ fw_mon на время теста).
    7            ;
    8            ; Сборка (asm85.py, исходник CP1251):
    9            ;   python3 asm85.py fw_text_kbd.asm -o fw_text_kbd.hex -l fw_text_kbd.lst
   10            ;   быстрый вариант для стендовой симуляции:
   11            ;   python3 asm85.py fw_text_kbd.asm -o fw_text_kbd_fast.hex -D FAST=1
   12            ;
   13            ; МАТРИЦА (Task 34): 4 колонки - зарегистрированные ВЫХОДЫ порт 02h
   14            ; (D0..D3 = col0..col3, 1 = колонка заведена; после сброса 0000),
   15            ; 5 рядов - ВХОДЫ порт 03h (D0..D4 = row0..row4; подтяжки R21-R25 10к
   16            ; на GND, покой = 0; нажатие в активной колонке = 1). Читается ТОЛЬКО
   17            ; порт 03h (остальные порты CPLD не драйвит).
   18            ;
   19            ; ЧТО ДЕЛАЕТ (по ТЗ владельца):
   20            ;   1) Непрерывно сканирует матрицу (колонка -> пауза ~25 мкс -> ряды).
   21            ;   2) НАЖАТИЕ КНОПКИ СОПРОВОЖДАЕТСЯ ЗВУКОВЫМ СИГНАЛОМ: бип ~0,2 с
   22            ;      (тон ~500 Гц, SND тогглится каждый ~1 мс).
   23            ;   3) НА ДИСПЛЕЙ ВЫВОДИТСЯ: СЛЕВА (DIG3) - НОМЕР СТРОКИ, СПРАВА (DIG0) -
   24            ;      НОМЕР КОЛОНКИ нажатой кнопки. Нумерация АППАРАТНАЯ, с нуля:
   25            ;      строки 0..4 (row0..row4, биты D0..D4 порта 03h), колонки 0..3
   26            ;      (col0..col3, биты D0..D3 порта 02h). Средние разряды погашены.
   27            ;      Регенерация с БЛЭНКИНГОМ (гашение -> разряд -> глиф): послесвечения
   28            ;      чужого глифа нет (на плате 10-30 было: сквозь '1' просвечивал '2').
   29            ;      До первого нажатия на дисплее "--" (два прочерка).
   30            ;   4) После отпускания - пауза-дебаунс ~30 мс, затем скан продолжается
   31            ;      (можно нажимать следующую кнопку; дисплей показывает ПОСЛЕДНЮЮ).
   32            ;
   33            ; ПРИМЕРЫ: SW1 (row0/col0) -> дисплей "0 0"; SW11 (row2/col2) -> "2 2";
   34            ;   SW16 (row3/col3) -> "3 3"; SW17 (row4/col0) -> "4 0".
   35            ;   (расположение кнопок - PORTS_MAP.md §10: col0=SW1/SW5/SW9/SW13/SW17,
   36            ;   col1=SW2/SW6/SW10/SW14/SW18, col2=SW3/SW7/SW11/SW15/SW19,
   37            ;   col3=SW4/SW8/SW12/SW16; ряды - по R25..R21 сверху вниз).
   38            ;
   39            ; ТАЙМИНГ (CPU 3,571 МГц, T-состояние 280 нс):
   40            ;   SETTLE ~25 мкс (LXI 10 + 2x24 + 21 + RET = 89 T);
   41            ;   BEEP_UNIT ~1 мс (внутр. цикл 3463 T + тоггл SNDST 33 + CALL REFRESH
   42            ;     ~225 T с блэнкингом, клк10-67) -> бип 200 ед. ~ 0,21 с, тон ~475 Гц;
   43            ;   регенерация дисплея: разряд переключается на каждом проходе скана
   44            ;     (4 колонки x ~75 мкс ~ 0,3 мс) -> ~1,7 кГц попеременно, скважность
   45            ;     1/1 - мерцания нет;
   46            ;   дебаунс нажатия: первая ловля - мгновенно (скан активен всегда),
   47            ;     ложные дребезги ПОСЛЕ отпускания гасятся паузой ~30 мс.
   48            ;
   49            ; ОЖИДАЕМОЕ ПОВЕДЕНИЕ / ИНТЕРПРЕТАЦИЯ:
   50            ;   - бип есть, номер не тот -> перепутаны ряды/колонки ( разводка/CPLD);
   51            ;   - бипа нет, номер есть -> тракт SND;
   52            ;   - бип без нажатия (самозвон) -> ряд висит в 1: подтяжка R21-R25,
   53            ;     замыкание ряда на колонку;
   54            ;   - двойные срабатывания с одного нажатия -> дребезг контактов
   55            ;     (пауза 30 мс гасит штатно; если чаще - деградация контакта);
   56            ;   - "--" горит, на нажатия реакции нет -> тракт KBROW/разъём.
   57            ; =====================================================================
   58            
   59            ; ---- константы (переопределяются через -D) ----
   60            FAST    EQU 0               ; 1 = укороченные паузы (для симуляции)
   61            IF FAST
   62            BEEP_MS EQU 4               ; единиц ~1 мс в бипе (быстро)
   63            SET_MS  EQU 2               ; дебаунс после отпускания
   64            ELSE
   65            BEEP_MS EQU 200             ; 200 x ~1,05 мс = ~0,21 с
   66            SET_MS  EQU 30              ; 30 x ~1,04 мс = ~31 мс
   67            ENDIF
   68            
   69            K_MS    EQU 144             ; внутренний счётчик ~1 мс
   70            
   71            ; ---- порты CPLD (декод по A2-A0, зеркала mod 8) ----
   72            SEGP    EQU 00h             ; сегменты: D0=a..D6=g, D7=dp; 1 = горит
   73            DIGP    EQU 01h             ; D3-D0 разряды, D4 = SND
   74            KBCOLP  EQU 02h             ; D3-D0 колонки (1 = заведена)
   75            KBROWP  EQU 03h             ; D4-D0 ряды (1 = нажата в активной колонке)
   76            
   77            ; ---- ОЗУ ----
   78            ROWNUM  EQU 8000h           ; номер строки 0..4
   79            COLNUM  EQU 8001h           ; номер колонки 0..3
   80            DPH     EQU 8002h           ; фаза регенерации: 08h = левый (строка), 01h = правый
   81            SNDST   EQU 8003h           ; состояние тона 0/1
   82            ROWIMG  EQU 8004h           ; глиф строки (DIG3)
   83            COLIMG  EQU 8005h           ; глиф колонки (DIG0)
   84            
   85            ; =====================================================================
   86  0000: -                ORG 0000h
   87  0000: C3 91 00         JMP MAIN
   88            
   89            ; ---- глифы '0'..'5' (a,b,c,d,e,f = D0..D5) ----
   90  0003: 3F       GTBL:   DB 3Fh              ; '0'
   91  0004: 06               DB 06h              ; '1'
   92  0005: 5B               DB 5Bh              ; '2'
   93  0006: 4F               DB 4Fh              ; '3'
   94  0007: 66               DB 66h              ; '4'
   95  0008: 6D               DB 6Dh              ; '5' (запас)
   96            
   97            
   98            ; ---------------------------------------------------------------------
   99            ; SETTLE: пауза ~25 мкс (установка ряда после заведения колонки)
  100            ; ---------------------------------------------------------------------
  101  0009: 01 03 00 SETTLE: LXI B,3
  102  000C: 0B       STL:    DCX B
  103  000D: 78               MOV A,B
  104  000E: B1               ORA C
  105  000F: C2 0C 00         JNZ STL
  106  0012: C9               RET
  107            
  108            ; ---------------------------------------------------------------------
  109            ; REFRESH: ГАШЕНИЕ -> ПЕРЕКЛЮЧЕНИЕ РАЗРЯДА -> ГЛИФ (без послесвечения).
  110            ;   Наивный порядок "глиф -> разряд" даёт призрак: OUT SEGP нового глифа
  111            ;   срабатывает, когда СТАРЫЙ разряд ещё горит, и тот ~16 мкс светит
  112            ;   ЧУЖОЙ глиф (на плате: сквозь '1' просвечивал '2' при коде "2 1").
  113            ;   Порядок (клк10-67):
  114            ;   (1) OUT SEGP=0   - старый разряд гаснет, светив СВОЙ глиф;
  115            ;   (2) OUT DIGP     - разряд переключается при ПУСТЫХ сегментах:
  116            ;                      старый чужой глиф показать уже не может,
  117            ;                      новый зажигается пустым;
  118            ;   (3) OUT SEGP=глиф - новый разряд зажигается СВОИМ глифом.
  119            ;   DPH=08h -> левый разряд (ROWIMG, строка); DPH=01h -> правый (COLIMG).
  120            ;   Портит A/B/C (D/E - бит колонки и индекс скана - НЕ трогает).
  121            ; ---------------------------------------------------------------------
  122  0013: 3A 02 80 REFRESH: LDA DPH
  123  0016: 47               MOV B,A             ; B = биты разряда новой фазы
  124  0017: FE 08            CPI 08h
  125  0019: CA 22 00         JZ RF_L
  126  001C: 3A 05 80         LDA COLIMG
  127  001F: C3 25 00         JMP RF_G
  128  0022: 3A 04 80 RF_L:   LDA ROWIMG
  129  0025: 4F       RF_G:   MOV C,A             ; C = глиф нового разряда
  130  0026: 3A 03 80         LDA SNDST
  131  0029: B7               ORA A               ; тон включён?
  132  002A: CA 33 00         JZ RF_N
  133  002D: 78               MOV A,B
  134  002E: F6 10            ORI 10h
  135  0030: C3 34 00         JMP RF_D
  136  0033: 78       RF_N:   MOV A,B
  137  0034: 47       RF_D:   MOV B,A             ; B = готовые биты разряда (с SND)
  138  0035: AF               XRA A
  139  0036: D3 00            OUT SEGP            ; (1) гашение: старый разряд погас
  140  0038: 78               MOV A,B
  141  0039: D3 01            OUT DIGP            ; (2) разряд переключён (сегменты пусты)
  142  003B: 79               MOV A,C
  143  003C: D3 00            OUT SEGP            ; (3) зажгли глиф нового разряда
  144  003E: 3A 02 80         LDA DPH
  145  0041: FE 08            CPI 08h
  146  0043: CA 4C 00         JZ RF_T
  147  0046: 3E 08            MVI A,08h           ; был правый -> левый
  148  0048: 32 02 80         STA DPH
  149  004B: C9               RET
  150  004C: 3E 01    RF_T:   MVI A,01h           ; был левый -> правый
  151  004E: 32 02 80         STA DPH
  152  0051: C9               RET
  153            
  154            ; ---------------------------------------------------------------------
  155            ; BEEP_UNIT: ~1 мс + тоггл SNDST + регенерация дисплея
  156            ; ---------------------------------------------------------------------
  157  0052: 01 90 00 BEEP_UNIT: LXI B,K_MS
  158  0055: 0B       BUL:    DCX B
  159  0056: 78               MOV A,B
  160  0057: B1               ORA C
  161  0058: C2 55 00         JNZ BUL
  162  005B: 3A 03 80         LDA SNDST
  163  005E: EE 01            XRI 01h
  164  0060: 32 03 80         STA SNDST
  165  0063: CD 13 00         CALL REFRESH        ; OUT DIGP уносит актуальный бит SND
  166  0066: C9               RET
  167            
  168            ; ---------------------------------------------------------------------
  169            ; QUIET_UNIT: ~1 мс без звука, дисплей живёт
  170            ; ---------------------------------------------------------------------
  171  0067: 01 90 00 QUIET_UNIT: LXI B,K_MS
  172  006A: 0B       QUL:    DCX B
  173  006B: 78               MOV A,B
  174  006C: B1               ORA C
  175  006D: C2 6A 00         JNZ QUL
  176  0070: CD 13 00         CALL REFRESH
  177  0073: C9               RET
  178            
  179            ; ---------------------------------------------------------------------
  180            ; SCANALL: опрос всех 4 колонок; A = ИЛИ рядов (0 = нажатий нет);
  181            ; колонки на выходе погашены
  182            ; ---------------------------------------------------------------------
  183  0074: AF       SCANALL: XRA A
  184  0075: 5F               MOV E,A             ; E = накопитель (SETTLE трогает только A/B/C)
  185  0076: 16 01            MVI D,01h           ; D = бит колонки
  186  0078: 7A       SAL1:   MOV A,D
  187  0079: D3 02            OUT KBCOLP
  188  007B: CD 09 00         CALL SETTLE
  189  007E: DB 03            IN KBROWP
  190  0080: E6 1F            ANI 1Fh
  191  0082: B3               ORA E
  192  0083: 5F               MOV E,A
  193  0084: 7A               MOV A,D
  194  0085: 07               RLC
  195  0086: 57               MOV D,A
  196  0087: FE 10            CPI 10h
  197  0089: C2 78 00         JNZ SAL1
  198  008C: AF               XRA A
  199  008D: D3 02            OUT KBCOLP
  200  008F: 7B               MOV A,E
  201  0090: C9               RET
  202            
  203            ; ---------------------------------------------------------------------
  204            ; MAIN
  205            ; ---------------------------------------------------------------------
  206  0091: 31 00 84 MAIN:   LXI SP,8400h
  207  0094: AF               XRA A
  208  0095: D3 00            OUT SEGP            ; дисплей погашен
  209  0097: D3 01            OUT DIGP
  210  0099: D3 02            OUT KBCOLP          ; колонки off (безопасный INIT)
  211  009B: 3E 40            MVI A,40h           ; глиф '-' (сегмент g)
  212  009D: 32 04 80         STA ROWIMG
  213  00A0: 32 05 80         STA COLIMG          ; до первого нажатия: "--"
  214  00A3: 3E 01            MVI A,01h
  215  00A5: 32 02 80         STA DPH             ; старт регенерации с правого
  216  00A8: AF               XRA A
  217  00A9: 32 03 80         STA SNDST
  218            
  219                    ; ВНИМАНИЕ (нашлено симуляцией verify_fw.py): SETTLE/SCANALL/
  220                    ; BEEP_UNIT затирают A/B/C - бит колонки живёт в D, индекс в E.
  221  00AC: 1E 00    SCAN:   MVI E,0             ; индекс колонки 0..3
  222  00AE: 16 01            MVI D,01h           ; бит колонки
  223  00B0: 7A       SC1:    MOV A,D
  224  00B1: D3 02            OUT KBCOLP
  225  00B3: CD 09 00         CALL SETTLE
  226  00B6: DB 03            IN KBROWP
  227  00B8: E6 1F            ANI 1Fh
  228  00BA: C2 CC 00         JNZ HIT
  229  00BD: 7A               MOV A,D
  230  00BE: 07               RLC
  231  00BF: 57               MOV D,A
  232  00C0: 1C               INR E               ; следующий индекс колонки
  233  00C1: FE 10            CPI 10h
  234  00C3: C2 B0 00         JNZ SC1
  235  00C6: CD 13 00         CALL REFRESH        ; нажатий нет - шаг регенерации
  236  00C9: C3 AC 00         JMP SCAN
  237            
  238  00CC: F5       HIT:    PUSH PSW            ; A = ряды (один бит)
  239  00CD: AF               XRA A
  240  00CE: D3 02            OUT KBCOLP          ; колонки off (фиксируем факт нажатия)
  241  00D0: F1               POP PSW
  242  00D1: 16 00            MVI D,0             ; D = номер строки
  243  00D3: 0F       H1:     RRC
  244  00D4: DA DB 00         JC H2
  245  00D7: 14               INR D
  246  00D8: C3 D3 00         JMP H1
  247  00DB: 7A       H2:     MOV A,D
  248  00DC: 32 00 80         STA ROWNUM
  249  00DF: 7B               MOV A,E
  250  00E0: 32 01 80         STA COLNUM
  251                    ; глифы: COLIMG = GTBL[col], ROWIMG = GTBL[row]
  252  00E3: 3A 01 80         LDA COLNUM
  253  00E6: 5F               MOV E,A
  254  00E7: 16 00            MVI D,0
  255  00E9: 21 03 00         LXI H,GTBL
  256  00EC: 19               DAD D
  257  00ED: 7E               MOV A,M
  258  00EE: 32 05 80         STA COLIMG
  259  00F1: 3A 00 80         LDA ROWNUM
  260  00F4: 5F               MOV E,A
  261  00F5: 16 00            MVI D,0
  262  00F7: 21 03 00         LXI H,GTBL
  263  00FA: 19               DAD D
  264  00FB: 7E               MOV A,M
  265  00FC: 32 04 80         STA ROWIMG
  266                    ; ---- БИП ~0,2 с (дисплей живёт, глифы уже новые) ----
  267  00FF: 21 C8 00         LXI H,BEEP_MS
  268  0102: CD 52 00 BP1:    CALL BEEP_UNIT
  269  0105: 2B               DCX H
  270  0106: 7C               MOV A,H
  271  0107: B5               ORA L
  272  0108: C2 02 01         JNZ BP1
  273  010B: AF               XRA A
  274  010C: 32 03 80         STA SNDST           ; тон гарантированно погашен
  275                    ; ---- ожидание отпускания ----
  276  010F: CD 74 00 WREL:   CALL SCANALL
  277  0112: E6 1F            ANI 1Fh
  278  0114: CA 1D 01         JZ WDN
  279  0117: CD 13 00         CALL REFRESH
  280  011A: C3 0F 01         JMP WREL
  281  011D: 21 1E 00 WDN:    LXI H,SET_MS        ; дебаунс после отпускания
  282  0120: CD 67 00 ST1:    CALL QUIET_UNIT
  283  0123: 2B               DCX H
  284  0124: 7C               MOV A,H
  285  0125: B5               ORA L
  286  0126: C2 20 01         JNZ ST1
  287  0129: C3 AC 00         JMP SCAN
  288            
  289  012C: -                END
