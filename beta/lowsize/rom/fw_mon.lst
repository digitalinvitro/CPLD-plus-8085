    1            ; =====================================================================
    2            ; beta/lowsize/rom -- fw_mon: МОНИТОР дисплея и клавиатуры (меню ACDE)
    3            ;
    4            ; Плата: retro_PCLD_board V2, CPLD = beta/lowsize v3.9.1/v3.9.2
    5            ; (транзиты kbcol/kbrow/seg/dig/SND идентичны v3.2...v3.9.x).
    6            ; Прошивается в flash A29040B с offset 0 (это и есть fw_mon: тест-прошивки
    7            ; fw_test_disp/fw_text_kbd после приёмки 10-30 больше не нужны).
    8            ;
    9            ; Сборка (asm85.py, исходник CP1251):
   10            ;   python3 asm85.py fw_mon.asm -o fw_mon.hex -l fw_mon.lst
   11            ;   быстрый вариант для стендовой симуляции:
   12            ;   python3 asm85.py fw_mon.asm -o fw_mon_fast.hex -D FAST=1
   13            ;
   14            ; МАТРИЦА (PORTS_MAP.md §10): 4 колонки - ВЫХОДЫ порт 02h (D0..D3, 1 =
   15            ; заведена; после сброса 0000), 5 рядов - ВХОДЫ порт 03h (D0..D4,
   16            ; подтяжки 10к на GND, покой = 0, нажатие = 1). Клавиша (row,col) =
   17            ; SW_{row*4+col+1}. КАРТА КЛАВИШ (в скобках - что показывал тест
   18            ; клавиатуры fw_text_kbd, "строка__колонка"):
   19            ;
   20            ;            col0        col1        col2        col3
   21            ;   row0     A (0__0)    B (0__1)    C (0__2)    D (0__3)
   22            ;   row1     7 (1__0)    8 (1__1)    9 (1__2)    E (1__3)
   23            ;   row2     4 (2__0)    5 (2__1)    6 (2__2)    F (2__3)
   24            ;   row3     1 (3__0)    2 (3__1)    3 (3__2)    Enter (3__3)
   25            ;   row4     0 (4__0)    F1 (4__1)   F2 (4__2)   (нет: SW20 = RESET)
   26            ;
   27            ; РЕЖИМЫ (по ТЗ владельца, клк10-69/70): меню "ACDE" - 4 буквы на 4
   28            ; разрядах, каждая буква = своя функция (C созвучно с Code, клавиша
   29            ; C = 0__2 есть на матрице; "P" не потребовался вовсе):
   30            ;   F1 (4__1)  - системное меню "ACDE" (работает из ЛЮБОГО режима);
   31            ;   A (0__0)   - из меню: ввод адреса, 4 знака; цифры 0-F вдвигаются
   32            ;                справа (как на калькуляторе: 8 -> "___8", 80 -> "__80"),
   33            ;                лишние (5-й и дальше) выталкивают старшие;
   34            ;   Enter      - завершает ввод адреса (при 0 знаков - игнор);
   35            ;   C (0__2)   - из меню: ВВОД КОДА (Code). Байт в КОДАХ 8085 - 2 тетрады
   36            ;                в ПРАВЫХ разрядах, слева пусто ("__C3"); Enter - записать
   37            ;                байт в [ADDR], ADDR++, поле гасится; Enter при пустом
   38            ;                поле - игнор; F1 - конец ввода, возврат в меню;
   39            ;   D (0__3)   - из меню: ПРОСМОТР КОДА с введённого адреса: в правых
   40            ;                разрядах байт [ADDR] ("__C3"), слева пусто; Enter -
   41            ;                ADDR++ и показать следующий байт; F1 - возврат в меню;
   42            ;                режим только чтение (тетрады игнорируются);
   43            ;   E (1__3)   - из меню: запуск программы с введённого адреса (по
   44            ;                умолчанию 8000h); дисплей гасится, DI, регистры 0,
   45            ;                SP = FFE8h, в стеке - адрес возврата в монитор;
   46            ;   ВЫХОД из пользовательской программы: RET (C9) - вернёт в меню "ACDE"
   47            ;   (ждёт отпускания клавиш + дебаунс 30 мс); аварийный выход - RESET.
   48            ;   В меню остальные клавиши (0-9,B,F,F2,Enter) игнорируются; в режимах
   49            ;   адреса/кода A,C,D,E - обычные тетрады (кроме Enter/F1).
   50            ;
   51            ; ПАМЯТЬ (MEMORY_MAP.md): ROM 0000h-7FFFh (запись невозможна - железо
   52            ; отбрасывает), RAM 8000h-FFFFh. Служебные монитора: FFE8h-FFF8h
   53            ; (переменные, см. ниже), стек с FFE7h вниз. ПОЛЬЗОВАТЕЛЬСКАЯ ОБЛАСТЬ:
   54            ; 8000h-FFE7h. Пример: A -> 8000 -> Enter -> C -> C3 Enter 0E Enter ->
   55            ; F1 -> D: "__C3" (байт в 8000), Enter -> "__0E" (8001), F1 -> E - пуск.
   56            ; (RAM 8000=C3 8001=0E = JMP 000Eh... для пробы введите C9 - RET).
   57            ;
   58            ; ДИСПЛЕЙ: динамическая регенерация 4 разрядов, порядок ГАШЕНИЕ ->
   59            ; РАЗРЯД -> ГЛИФ (клк10-67, послесвечения нет - проверено на плате
   60            ; 10-30). Слот = один проход скана матрицы (~290 мкс: 4 колонки по
   61            ; ~180 T + REFRESH ~300 T) -> полный цикл дисплея ~1,16 мс (~860 Гц),
   62            ; скважность 1/4. Короткий ТИК ~31 мс (~500 Гц) на нажатую клавишу;
   63            ; бит SND (D4) едет в записи DIGP внутри REFRESH - дисплей при тике
   64            ; НЕ гаснет.
   65            ;
   66            ; ТАЙМИНГ (CPU 3,571 МГц, T = 280 нс):
   67            ;   SETTLE ~25 мкс (89 T); единица BUNIT/QUNIT ~1,05 мс (K_MS=144);
   68            ;   тик клавиши = TICK_MS единиц (полный 30 ~ 31 мс, FAST 4);
   69            ;   дебаунс отпускания = SET_MS единиц (полный 30 ~ 31 мс, FAST 2);
   70            ;   задержка реакции на нажатие < 1,2 мс (скан непрерывный).
   71            ; Ожидаемый тон тика по замеру на симуляции: ~500 Гц (полупериод ~1 мс).
   72            ; =====================================================================
   73            
   74            ; ---- константы (переопределяются через -D) ----
   75            FAST    EQU 0               ; 1 = укороченные паузы (для симуляции)
   76            IF FAST
   77            TICK_MS EQU 4               ; тик клавиши, единиц ~1 мс (быстро)
   78            SET_MS  EQU 2               ; дебаунс после отпускания
   79            ELSE
   80            TICK_MS EQU 30              ; 30 x ~1,05 мс = ~31 мс тик
   81            SET_MS  EQU 30              ; 30 x ~1,05 мс = ~31 мс дебаунс
   82            ENDIF
   83            
   84            K_MS    EQU 144             ; внутренний счётчик единицы ~1 мс
   85            
   86            ; ---- порты CPLD (декод по A2-A0, зеркала mod 8) ----
   87            SEGP    EQU 00h             ; сегменты: D0=a..D6=g, D7=dp; 1 = горит
   88            DIGP    EQU 01h             ; D3-D0 разряды, D4 = SND
   89            KBCOLP  EQU 02h             ; D3-D0 колонки (1 = заведена)
   90            KBROWP  EQU 03h             ; D4-D0 ряды (1 = нажата в активной колонке)
   91            
   92            ; ---- коды клавиш (после KEYTBL) ----
   93            ; 00h..0Fh = тетрады 0..F; далее:
   94            K_ENT   EQU 10h             ; Enter  (row3/col3, SW16)
   95            K_F1    EQU 11h             ; F1     (row4/col1, SW18) - меню
   96            K_F2    EQU 12h             ; F2     (row4/col2, SW19) - резерв
   97            K_NONE  EQU 0FFh            ; пустая позиция матрицы
   98            
   99            ; ---- состояния ----
  100            ST_MENU EQU 00h             ; меню "ACDE"
  101            ST_ADDR EQU 01h             ; ввод адреса
  102            ST_PROG EQU 02h             ; ввод кода (Code)
  103            ST_VIEW EQU 03h             ; просмотр кода
  104            
  105            ; ---- ОЗУ (служебные монитора, FFE8h-FFF8h; стек с FFE7h вниз) ----
  106            SP0     EQU 0FFE8h          ; SP монитора
  107            SNDST   EQU 0FFE8h          ; состояние тона 0/1
  108            STATE   EQU 0FFE9h          ; 0=меню, 1=адрес, 2=код, 3=просмотр
  109            ADDRH   EQU 0FFEAh          ; текущий адрес (старший)
  110            ADDRL   EQU 0FFEBh          ; текущий адрес (младший)
  111            ADCNT   EQU 0FFECh          ; введено тетрад адреса (0..4)
  112            AF3     EQU 0FFEDh          ; тетрады адреса (AF3 - старшая...)
  113            AF2     EQU 0FFEEh
  114            AF1     EQU 0FFEFh
  115            AF0     EQU 0FFF0h
  116            BDCNT   EQU 0FFF1h          ; введено тетрад байта (0..2)
  117            BF1     EQU 0FFF2h          ; старшая тетрада байта
  118            BF0     EQU 0FFF3h          ; младшая тетрада байта
  119            DPIDX   EQU 0FFF4h          ; фаза регенерации 0..3 (0 = DIG0)
  120            DIGIMG  EQU 0FFF5h          ; глифы разрядов DIG0..DIG3 (4 байта)
  121            DIGIMG0 EQU 0FFF5h          ;   правый (DIG0)
  122            DIGIMG1 EQU 0FFF6h
  123            DIGIMG2 EQU 0FFF7h
  124            DIGIMG3 EQU 0FFF8h          ;   левый (DIG3)
  125            
  126            ; =====================================================================
  127  0000: -                ORG 0000h
  128  0000: C3 99 01         JMP MAIN
  129            
  130            ; ---- глифы '0'..'F' (a,b,c,d,e,f,g = D0..D6) ----
  131  0003: 3F       GTBL:   DB 3Fh              ; '0'
  132  0004: 06               DB 06h              ; '1'
  133  0005: 5B               DB 5Bh              ; '2'
  134  0006: 4F               DB 4Fh              ; '3'
  135  0007: 66               DB 66h              ; '4'
  136  0008: 6D               DB 6Dh              ; '5'
  137  0009: 7D               DB 7Dh              ; '6'
  138  000A: 07               DB 07h              ; '7'
  139  000B: 7F               DB 7Fh              ; '8'
  140  000C: 6F               DB 6Fh              ; '9'
  141  000D: 77               DB 77h              ; 'A'
  142  000E: 7C               DB 7Ch              ; 'b'
  143  000F: 39               DB 39h              ; 'C'
  144  0010: 5E               DB 5Eh              ; 'd'
  145  0011: 79               DB 79h              ; 'E'
  146  0012: 71               DB 71h              ; 'F'
  147            
  148            ; ---- биты разрядов (индекс = DPIDX: 0=DIG0 правый ... 3=DIG3 левый) ----
  149  0013: 01 02 04 08 BITTBL: DB 01h,02h,04h,08h
  150            
  151            ; ---- КАРТА КЛАВИШ: KEYTBL[row*4+col] ----
  152  0017: 0A 0B 0C 0D KEYTBL: DB 0Ah,0Bh,0Ch,0Dh  ; row0: A  B  C  D
  153  001B: 07 08 09 0E         DB 07h,08h,09h,0Eh  ; row1: 7  8  9  E
  154  001F: 04 05 06 0F         DB 04h,05h,06h,0Fh  ; row2: 4  5  6  F
  155  0023: 01 02 03 10         DB 01h,02h,03h,10h  ; row3: 1  2  3  Enter
  156  0027: 00 11 12 FF         DB 00h,11h,12h,0FFh ; row4: 0  F1 F2 (нет)
  157            
  158            ; ---------------------------------------------------------------------
  159            ; SETTLE: пауза ~25 мкс (установка рядов после заведения колонки)
  160            ; ---------------------------------------------------------------------
  161  002B: 01 03 00 SETTLE: LXI B,3
  162  002E: 0B       STL:    DCX B
  163  002F: 78               MOV A,B
  164  0030: B1               ORA C
  165  0031: C2 2E 00         JNZ STL
  166  0034: C9               RET
  167            
  168            ; ---------------------------------------------------------------------
  169            ; SCANALL: опрос всех 4 колонок; A = ИЛИ рядов (0 = нажатий нет);
  170            ; колонки на выходе погашены. Портит A/B/C/D/E.
  171            ; ---------------------------------------------------------------------
  172  0035: AF       SCANALL: XRA A
  173  0036: 5F               MOV E,A             ; E = накопитель
  174  0037: 16 01            MVI D,01h           ; D = бит колонки
  175  0039: 7A       SAL1:   MOV A,D
  176  003A: D3 02            OUT KBCOLP
  177  003C: CD 2B 00         CALL SETTLE
  178  003F: DB 03            IN KBROWP
  179  0041: E6 1F            ANI 1Fh
  180  0043: B3               ORA E
  181  0044: 5F               MOV E,A
  182  0045: 7A               MOV A,D
  183  0046: 07               RLC
  184  0047: 57               MOV D,A
  185  0048: FE 10            CPI 10h
  186  004A: C2 39 00         JNZ SAL1
  187  004D: AF               XRA A
  188  004E: D3 02            OUT KBCOLP
  189  0050: 7B               MOV A,E
  190  0051: C9               RET
  191            
  192            ; ---------------------------------------------------------------------
  193            ; REFRESH: один слот регенерации. ГАШЕНИЕ -> РАЗРЯД -> ГЛИФ
  194            ; (клк10-67, без послесвечения). DIGIMG[DPIDX] на разряд DPIDX.
  195            ; Бит D4 (SND) уносится записью DIGP - дисплей при тоне не гаснет.
  196            ; Портит A/B/C/H/L (D/E - бит колонки и индекс скана - НЕ трогает).
  197            ; ---------------------------------------------------------------------
  198  0052: 3A F4 FF REFRESH: LDA DPIDX
  199  0055: 4F               MOV C,A             ; C = индекс 0..3
  200  0056: 06 00            MVI B,0
  201  0058: 21 13 00         LXI H,BITTBL
  202  005B: 09               DAD B
  203  005C: 46               MOV B,M             ; B = бит разряда (01,02,04,08)
  204  005D: 21 F5 FF         LXI H,DIGIMG        ; HL = DIGIMG + DPIDX (цикл вместо ADD)
  205  0060: 79       RFIL:   MOV A,C
  206  0061: B7               ORA A
  207  0062: CA 6A 00         JZ RFGD
  208  0065: 2C               INR L
  209  0066: 0D               DCR C
  210  0067: C3 60 00         JMP RFIL
  211  006A: 4E       RFGD:   MOV C,M             ; C = глиф разряда
  212  006B: 3A E8 FF         LDA SNDST
  213  006E: B7               ORA A
  214  006F: CA 76 00         JZ RFN
  215  0072: 78               MOV A,B
  216  0073: F6 10            ORI 10h
  217  0075: 47               MOV B,A             ; B |= SND
  218  0076: AF       RFN:    XRA A
  219  0077: D3 00            OUT SEGP            ; (1) гашение: старый разряд погас
  220  0079: 78               MOV A,B
  221  007A: D3 01            OUT DIGP            ; (2) разряд переключён (сегменты пусты)
  222  007C: 79               MOV A,C
  223  007D: D3 00            OUT SEGP            ; (3) зажгли глиф нового разряда
  224  007F: 3A F4 FF         LDA DPIDX
  225  0082: 3C               INR A
  226  0083: E6 03            ANI 03h
  227  0085: 32 F4 FF         STA DPIDX
  228  0088: C9               RET
  229            
  230            ; ---------------------------------------------------------------------
  231            ; BUNIT: единица ~1 мс + тоггл SNDST + регенерация дисплея
  232            ; QUNIT: единица ~1 мс без звука, дисплей живёт
  233            ; ---------------------------------------------------------------------
  234  0089: 01 90 00 BUNIT:  LXI B,K_MS
  235  008C: 0B       BUL:    DCX B
  236  008D: 78               MOV A,B
  237  008E: B1               ORA C
  238  008F: C2 8C 00         JNZ BUL
  239  0092: 3A E8 FF         LDA SNDST
  240  0095: EE 01            XRI 01h
  241  0097: 32 E8 FF         STA SNDST
  242  009A: CD 52 00         CALL REFRESH
  243  009D: C9               RET
  244            
  245  009E: 01 90 00 QUNIT:  LXI B,K_MS
  246  00A1: 0B       QUL:    DCX B
  247  00A2: 78               MOV A,B
  248  00A3: B1               ORA C
  249  00A4: C2 A1 00         JNZ QUL
  250  00A7: CD 52 00         CALL REFRESH
  251  00AA: C9               RET
  252            
  253            ; ---------------------------------------------------------------------
  254            ; TICKON: короткий тик подтверждения клавиши (TICK_MS единиц ~1 мс,
  255            ; тон ~500 Гц). Дисплей живёт (SND едет в записи DIGP внутри REFRESH).
  256            ; Счётчик - В DE: REFRESH портит HL, но гарантирует D/E.
  257            ; ---------------------------------------------------------------------
  258  00AB: 11 1E 00 TICKON: LXI D,TICK_MS
  259  00AE: CD 89 00 TK1:    CALL BUNIT
  260  00B1: 1B               DCX D
  261  00B2: 7A               MOV A,D
  262  00B3: B3               ORA E
  263  00B4: C2 AE 00         JNZ TK1
  264  00B7: AF               XRA A
  265  00B8: 32 E8 FF         STA SNDST           ; тон гарантированно погашен
  266  00BB: C9               RET
  267            
  268            ; ---------------------------------------------------------------------
  269            ; GLOOK: A = тетрада 0..F -> A = глиф (GTBL). Портит A/B/C/H/L.
  270            ; ---------------------------------------------------------------------
  271  00BC: 4F       GLOOK:  MOV C,A
  272  00BD: 06 00            MVI B,0
  273  00BF: 21 03 00         LXI H,GTBL
  274  00C2: 09               DAD B
  275  00C3: 7E               MOV A,M
  276  00C4: C9               RET
  277            
  278            ; ---------------------------------------------------------------------
  279            ; REDRAW: пересобрать DIGIMG[0..3] по состоянию.
  280            ;   меню : DIG3='A'(77) DIG2='C'(39) DIG1='d'(5E) DIG0='E'(79) = "ACDE"
  281            ;   адрес: 4 тетрады вдвигаются СПРАВА (новая - в AF0/DIG0, старые
  282            ;          уходят влево), показаны последние ADCNT, пустые старшие
  283            ;          гаснут; 5-я тетрада вытесняет старшую
  284            ;   код  : DIG3/DIG2 пусто, DIG1 = BF1 (при BDCNT>=2), DIG0 = BF0
  285            ;          (при BDCNT>=1) - вид "__C3"
  286            ;   просм.: DIG3/DIG2 пусто, DIG1/DIG0 = байт [ADDR] - вид "__C3"
  287            ; ---------------------------------------------------------------------
  288  00C5: 3A E9 FF REDRAW: LDA STATE           ; пересборка глифов по состоянию
  289  00C8: B7               ORA A
  290  00C9: CA 30 01         JZ RDM
  291  00CC: FE 01            CPI 01h
  292  00CE: CA 47 01         JZ RDA
  293  00D1: FE 03            CPI 03h
  294  00D3: CA 07 01         JZ RDV
  295                    ; ---- ST_PROG ----
  296  00D6: AF               XRA A
  297  00D7: 32 F8 FF         STA DIGIMG3
  298  00DA: 32 F7 FF         STA DIGIMG2
  299  00DD: 32 F6 FF         STA DIGIMG1
  300  00E0: 32 F5 FF         STA DIGIMG0
  301  00E3: 3A F1 FF         LDA BDCNT
  302  00E6: FE 02            CPI 02h
  303  00E8: DA F4 00         JC RDPR0            ; <2 - старшая тетрада пуста
  304  00EB: 3A F2 FF         LDA BF1
  305  00EE: CD BC 00         CALL GLOOK
  306  00F1: 32 F6 FF         STA DIGIMG1
  307  00F4: 3A F1 FF RDPR0:  LDA BDCNT
  308  00F7: B7               ORA A
  309  00F8: CA 98 01         JZ RDRE             ; 0 - младшая тоже пуста
  310  00FB: 3A F3 FF         LDA BF0
  311  00FE: CD BC 00         CALL GLOOK
  312  0101: 32 F5 FF         STA DIGIMG0
  313  0104: C3 98 01         JMP RDRE
  314  0107: 3A EA FF RDV:    LDA ADDRH           ; ---- ST_VIEW: [ADDR] в правых разрядах ----
  315  010A: 67               MOV H,A
  316  010B: 3A EB FF         LDA ADDRL
  317  010E: 6F               MOV L,A             ; HL = ADDR
  318  010F: 7E               MOV A,M             ; A = [ADDR] (HL>=8000h - ОЗУ)
  319  0110: 57               MOV D,A             ; D = байт (GLOOK портит B)
  320  0111: 0F               RRC
  321  0112: 0F               RRC
  322  0113: 0F               RRC
  323  0114: 0F               RRC
  324  0115: E6 0F            ANI 0Fh             ; старшая тетрада
  325  0117: CD BC 00         CALL GLOOK
  326  011A: 32 F6 FF         STA DIGIMG1
  327  011D: 7A               MOV A,D
  328  011E: E6 0F            ANI 0Fh             ; младшая тетрада
  329  0120: CD BC 00         CALL GLOOK
  330  0123: 32 F5 FF         STA DIGIMG0
  331  0126: AF               XRA A
  332  0127: 32 F8 FF         STA DIGIMG3
  333  012A: 32 F7 FF         STA DIGIMG2
  334  012D: C3 98 01         JMP RDRE
  335  0130: 3E 77    RDM:    MVI A,77h           ; 'A'
  336  0132: 32 F8 FF         STA DIGIMG3
  337  0135: 3E 39            MVI A,39h           ; 'C'
  338  0137: 32 F7 FF         STA DIGIMG2
  339  013A: 3E 5E            MVI A,5Eh           ; 'd' (D)
  340  013C: 32 F6 FF         STA DIGIMG1
  341  013F: 3E 79            MVI A,79h           ; 'E'
  342  0141: 32 F5 FF         STA DIGIMG0
  343  0144: C3 98 01         JMP RDRE
  344  0147: AF       RDA:    XRA A               ; ---- ST_ADDR: последняя тетрада справа ----
