    1            ; =====================================================================
    2            ; beta/lowsize/rom -- fw_mon: МОНИТОР дисплея и клавиатуры (меню ACDE)
    3            ;
    4            ; Плата: retro_PCLD_board V2, CPLD = beta/lowsize v3.9.1/v3.9.2
    5            ; (транзиты kbcol/kbrow/seg/dig/SND идентичны v3.2...v3.9.x).
    6            ; Прошивается в flash A29040B с offset 0 (это и есть fw_mon: тест-прошивки
    7            ; fw_test_disp/fw_text_kbd после приёмки 10-30 больше не нужны).
    8            ;
    9            ; Сборка (asm85.py, исходник CP1251):
   10            ;   python3 asm85.py fw_mon.asm -o fw_mon.hex -l fw_mon.lst
   11            ;   быстрый вариант для стендовой симуляции:
   12            ;   python3 asm85.py fw_mon.asm -o fw_mon_fast.hex -D FAST=1
   13            ;
   14            ; МАТРИЦА (PORTS_MAP.md §10): 4 колонки - ВЫХОДЫ порт 02h (D0..D3, 1 =
   15            ; заведена; после сброса 0000), 5 рядов - ВХОДЫ порт 03h (D0..D4,
   16            ; подтяжки 10к на GND, покой = 0, нажатие = 1). Клавиша (row,col) =
   17            ; SW_{row*4+col+1}. КАРТА КЛАВИШ (в скобках - что показывал тест
   18            ; клавиатуры fw_text_kbd, "строка__колонка"):
   19            ;
   20            ;            col0        col1        col2        col3
   21            ;   row0     A (0__0)    B (0__1)    C (0__2)    D (0__3)
   22            ;   row1     7 (1__0)    8 (1__1)    9 (1__2)    E (1__3)
   23            ;   row2     4 (2__0)    5 (2__1)    6 (2__2)    F (2__3)
   24            ;   row3     1 (3__0)    2 (3__1)    3 (3__2)    Enter (3__3)
   25            ;   row4     0 (4__0)    F1 (4__1)   F2 (4__2)   (нет: SW20 = RESET)
   26            ;
   27            ; РЕЖИМЫ (по ТЗ владельца, клк10-69/70): меню "ACDE" - 4 буквы на 4
   28            ; разрядах, каждая буква = своя функция (C созвучно с Code, клавиша
   29            ; C = 0__2 есть на матрице; "P" не потребовался вовсе):
   30            ;   F1 (4__1)  - системное меню "ACDE" (работает из ЛЮБОГО режима);
   31            ;   F2 (4__2)  - ПОКАЗАТЬ АДРЕС ОПЕРАЦИЙ (ADDR) в любом режиме: 4
   32            ;                тетрады на всех разрядах ("8012") - адрес, по
   33            ;                которому монитор ведёт запись (C), просмотр (D) и
   34            ;                пуск (E); повторное F2 возвращает прежний экран
   35            ;                (поле ввода/просмотр сохраняются); F1 - в меню;
   36            ;   A (0__0)   - из меню: ввод адреса, 4 знака; цифры 0-F вдвигаются
   37            ;                справа (как на калькуляторе: 8 -> "___8", 80 -> "__80"),
   38            ;                лишние (5-й и дальше) выталкивают старшие;
   39            ;   Enter      - завершает ввод адреса (при 0 знаков - игнор);
   40            ;   C (0__2)   - из меню: ВВОД КОДА (Code). Байт в КОДАХ 8085 - 2 тетрады
   41            ;                в ПРАВЫХ разрядах, слева пусто ("__C3"); Enter - записать
   42            ;                байт в [ADDR], ADDR++, поле гасится; Enter при пустом
   43            ;                поле - игнор; F1 - конец ввода, возврат в меню;
   44            ;   D (0__3)   - из меню: ПРОСМОТР КОДА с введённого адреса: в правых
   45            ;                разрядах байт [ADDR] ("__C3"), слева пусто; Enter -
   46            ;                ADDR++ и показать следующий байт; F1 - возврат в меню;
   47            ;                режим только чтение (тетрады игнорируются);
   48            ;   E (1__3)   - из меню: запуск программы с введённого адреса (по
   49            ;                умолчанию 8000h); дисплей гасится, DI, регистры 0,
   50            ;                SP = FFE8h, в стеке - адрес возврата в монитор;
   51            ;   ВЫХОД из пользовательской программы: RET (C9) - вернёт в меню "ACDE"
   52            ;   (ждёт отпускания клавиш + дебаунс 30 мс); аварийный выход - RESET.
   53            ;   В меню остальные клавиши (0-9,B,F,Enter) игнорируются; в режимах
   54            ;   адреса/кода A,C,D,E - обычные тетрады (кроме Enter/F1/F2).
   55            ;
   56            ; ПАМЯТЬ (MEMORY_MAP.md): ROM 0000h-7FFFh (запись невозможна - железо
   57            ; отбрасывает), RAM 8000h-FFFFh. Служебные монитора: FFE8h-FFF9h
   58            ; (переменные, см. ниже), стек с FFE7h вниз. ПОЛЬЗОВАТЕЛЬСКАЯ ОБЛАСТЬ:
   59            ; 8000h-FFE7h. Пример: A -> 8000 -> Enter -> C -> C3 Enter 0E Enter ->
   60            ; F1 -> D: "__C3" (байт в 8000), Enter -> "__0E" (8001), F1 -> E - пуск.
   61            ; (RAM 8000=C3 8001=0E = JMP 000Eh... для пробы введите C9 - RET).
   62            ;
   63            ; ДИСПЛЕЙ: динамическая регенерация 4 разрядов, порядок ГАШЕНИЕ ->
   64            ; РАЗРЯД -> ГЛИФ (клк10-67, послесвечения нет - проверено на плате
   65            ; 10-30). Слот = один проход скана матрицы (~290 мкс: 4 колонки по
   66            ; ~180 T + REFRESH ~300 T) -> полный цикл дисплея ~1,16 мс (~860 Гц),
   67            ; скважность 1/4. Короткий ТИК ~31 мс (~500 Гц) на нажатую клавишу;
   68            ; бит SND (D4) едет в записи DIGP внутри REFRESH - дисплей при тике
   69            ; НЕ гаснет.
   70            ;
   71            ; ТАЙМИНГ (CPU 3,571 МГц, T = 280 нс):
   72            ;   SETTLE ~25 мкс (89 T); единица BUNIT/QUNIT ~1,05 мс (K_MS=144);
   73            ;   тик клавиши = TICK_MS единиц (полный 30 ~ 31 мс, FAST 4);
   74            ;   дебаунс отпускания = SET_MS единиц (полный 30 ~ 31 мс, FAST 2);
   75            ;   задержка реакции на нажатие < 1,2 мс (скан непрерывный).
   76            ; Ожидаемый тон тика по замеру на симуляции: ~500 Гц (полупериод ~1 мс).
   77            ; =====================================================================
   78            
   79            ; ---- константы (переопределяются через -D) ----
   80            FAST    EQU 0               ; 1 = укороченные паузы (для симуляции)
   81            IF FAST
   82            TICK_MS EQU 4               ; тик клавиши, единиц ~1 мс (быстро)
   83            SET_MS  EQU 2               ; дебаунс после отпускания
   84            ELSE
   85            TICK_MS EQU 30              ; 30 x ~1,05 мс = ~31 мс тик
   86            SET_MS  EQU 30              ; 30 x ~1,05 мс = ~31 мс дебаунс
   87            ENDIF
   88            
   89            K_MS    EQU 144             ; внутренний счётчик единицы ~1 мс
   90            
   91            ; ---- порты CPLD (декод по A2-A0, зеркала mod 8) ----
   92            SEGP    EQU 00h             ; сегменты: D0=a..D6=g, D7=dp; 1 = горит
   93            DIGP    EQU 01h             ; D3-D0 разряды, D4 = SND
   94            KBCOLP  EQU 02h             ; D3-D0 колонки (1 = заведена)
   95            KBROWP  EQU 03h             ; D4-D0 ряды (1 = нажата в активной колонке)
   96            
   97            ; ---- коды клавиш (после KEYTBL) ----
   98            ; 00h..0Fh = тетрады 0..F; далее:
   99            K_ENT   EQU 10h             ; Enter  (row3/col3, SW16)
  100            K_F1    EQU 11h             ; F1     (row4/col1, SW18) - меню
  101            K_F2    EQU 12h             ; F2     (row4/col2, SW19) - показ адреса
  102            K_NONE  EQU 0FFh            ; пустая позиция матрицы
  103            
  104            ; ---- состояния ----
  105            ST_MENU EQU 00h             ; меню "ACDE"
  106            ST_ADDR EQU 01h             ; ввод адреса
  107            ST_PROG EQU 02h             ; ввод кода (Code)
  108            ST_VIEW EQU 03h             ; просмотр кода
  109            ST_SHOW EQU 04h             ; показ адреса операций (F2)
  110            
  111            ; ---- ОЗУ (служебные монитора, FFE8h-FFF9h; стек с FFE7h вниз) ----
  112            SP0     EQU 0FFE8h          ; SP монитора
  113            SNDST   EQU 0FFE8h          ; состояние тона 0/1
  114            STATE   EQU 0FFE9h          ; 0=меню, 1=адрес, 2=код, 3=просмотр
  115            ADDRH   EQU 0FFEAh          ; текущий адрес (старший)
  116            ADDRL   EQU 0FFEBh          ; текущий адрес (младший)
  117            ADCNT   EQU 0FFECh          ; введено тетрад адреса (0..4)
  118            AF3     EQU 0FFEDh          ; тетрады адреса (AF3 - старшая...)
  119            AF2     EQU 0FFEEh
  120            AF1     EQU 0FFEFh
  121            AF0     EQU 0FFF0h
  122            BDCNT   EQU 0FFF1h          ; введено тетрад байта (0..2)
  123            BF1     EQU 0FFF2h          ; старшая тетрада байта
  124            BF0     EQU 0FFF3h          ; младшая тетрада байта
  125            DPIDX   EQU 0FFF4h          ; фаза регенерации 0..3 (0 = DIG0)
  126            DIGIMG  EQU 0FFF5h          ; глифы разрядов DIG0..DIG3 (4 байта)
  127            DIGIMG0 EQU 0FFF5h          ;   правый (DIG0)
  128            DIGIMG1 EQU 0FFF6h
  129            DIGIMG2 EQU 0FFF7h
  130            DIGIMG3 EQU 0FFF8h          ;   левый (DIG3)
  131            PREVST  EQU 0FFF9h          ; прежний режим для F2 (показ адреса)
  132            
  133            ; =====================================================================
  134  0000: -                ORG 0000h
  135  0000: C3 D3 01         JMP MAIN
  136            
  137            ; ---- глифы '0'..'F' (a,b,c,d,e,f,g = D0..D6) ----
  138  0003: 3F       GTBL:   DB 3Fh              ; '0'
  139  0004: 06               DB 06h              ; '1'
  140  0005: 5B               DB 5Bh              ; '2'
  141  0006: 4F               DB 4Fh              ; '3'
  142  0007: 66               DB 66h              ; '4'
  143  0008: 6D               DB 6Dh              ; '5'
  144  0009: 7D               DB 7Dh              ; '6'
  145  000A: 07               DB 07h              ; '7'
  146  000B: 7F               DB 7Fh              ; '8'
  147  000C: 6F               DB 6Fh              ; '9'
  148  000D: 77               DB 77h              ; 'A'
  149  000E: 7C               DB 7Ch              ; 'b'
  150  000F: 39               DB 39h              ; 'C'
  151  0010: 5E               DB 5Eh              ; 'd'
  152  0011: 79               DB 79h              ; 'E'
  153  0012: 71               DB 71h              ; 'F'
  154            
  155            ; ---- биты разрядов (индекс = DPIDX: 0=DIG0 правый ... 3=DIG3 левый) ----
  156  0013: 01 02 04 08 BITTBL: DB 01h,02h,04h,08h
  157            
  158            ; ---- КАРТА КЛАВИШ: KEYTBL[row*4+col] ----
  159  0017: 0A 0B 0C 0D KEYTBL: DB 0Ah,0Bh,0Ch,0Dh  ; row0: A  B  C  D
  160  001B: 07 08 09 0E         DB 07h,08h,09h,0Eh  ; row1: 7  8  9  E
  161  001F: 04 05 06 0F         DB 04h,05h,06h,0Fh  ; row2: 4  5  6  F
  162  0023: 01 02 03 10         DB 01h,02h,03h,10h  ; row3: 1  2  3  Enter
  163  0027: 00 11 12 FF         DB 00h,11h,12h,0FFh ; row4: 0  F1 F2 (нет)
  164            
  165            ; ---------------------------------------------------------------------
  166            ; SETTLE: пауза ~25 мкс (установка рядов после заведения колонки)
  167            ; ---------------------------------------------------------------------
  168  002B: 01 03 00 SETTLE: LXI B,3
  169  002E: 0B       STL:    DCX B
  170  002F: 78               MOV A,B
  171  0030: B1               ORA C
  172  0031: C2 2E 00         JNZ STL
  173  0034: C9               RET
  174            
  175            ; ---------------------------------------------------------------------
  176            ; SCANALL: опрос всех 4 колонок; A = ИЛИ рядов (0 = нажатий нет);
  177            ; колонки на выходе погашены. Портит A/B/C/D/E.
  178            ; ---------------------------------------------------------------------
  179  0035: AF       SCANALL: XRA A
  180  0036: 5F               MOV E,A             ; E = накопитель
  181  0037: 16 01            MVI D,01h           ; D = бит колонки
  182  0039: 7A       SAL1:   MOV A,D
  183  003A: D3 02            OUT KBCOLP
  184  003C: CD 2B 00         CALL SETTLE
  185  003F: DB 03            IN KBROWP
  186  0041: E6 1F            ANI 1Fh
  187  0043: B3               ORA E
  188  0044: 5F               MOV E,A
  189  0045: 7A               MOV A,D
  190  0046: 07               RLC
  191  0047: 57               MOV D,A
  192  0048: FE 10            CPI 10h
  193  004A: C2 39 00         JNZ SAL1
  194  004D: AF               XRA A
  195  004E: D3 02            OUT KBCOLP
  196  0050: 7B               MOV A,E
  197  0051: C9               RET
  198            
  199            ; ---------------------------------------------------------------------
  200            ; REFRESH: один слот регенерации. ГАШЕНИЕ -> РАЗРЯД -> ГЛИФ
  201            ; (клк10-67, без послесвечения). DIGIMG[DPIDX] на разряд DPIDX.
  202            ; Бит D4 (SND) уносится записью DIGP - дисплей при тоне не гаснет.
  203            ; Портит A/B/C/H/L (D/E - бит колонки и индекс скана - НЕ трогает).
  204            ; ---------------------------------------------------------------------
  205  0052: 3A F4 FF REFRESH: LDA DPIDX
  206  0055: 4F               MOV C,A             ; C = индекс 0..3
  207  0056: 06 00            MVI B,0
  208  0058: 21 13 00         LXI H,BITTBL
  209  005B: 09               DAD B
  210  005C: 46               MOV B,M             ; B = бит разряда (01,02,04,08)
  211  005D: 21 F5 FF         LXI H,DIGIMG        ; HL = DIGIMG + DPIDX (цикл вместо ADD)
  212  0060: 79       RFIL:   MOV A,C
  213  0061: B7               ORA A
  214  0062: CA 6A 00         JZ RFGD
  215  0065: 2C               INR L
  216  0066: 0D               DCR C
  217  0067: C3 60 00         JMP RFIL
  218  006A: 4E       RFGD:   MOV C,M             ; C = глиф разряда
  219  006B: 3A E8 FF         LDA SNDST
  220  006E: B7               ORA A
  221  006F: CA 76 00         JZ RFN
  222  0072: 78               MOV A,B
  223  0073: F6 10            ORI 10h
  224  0075: 47               MOV B,A             ; B |= SND
  225  0076: AF       RFN:    XRA A
  226  0077: D3 00            OUT SEGP            ; (1) гашение: старый разряд погас
  227  0079: 78               MOV A,B
  228  007A: D3 01            OUT DIGP            ; (2) разряд переключён (сегменты пусты)
  229  007C: 79               MOV A,C
  230  007D: D3 00            OUT SEGP            ; (3) зажгли глиф нового разряда
  231  007F: 3A F4 FF         LDA DPIDX
  232  0082: 3C               INR A
  233  0083: E6 03            ANI 03h
  234  0085: 32 F4 FF         STA DPIDX
  235  0088: C9               RET
  236            
  237            ; ---------------------------------------------------------------------
  238            ; BUNIT: единица ~1 мс + тоггл SNDST + регенерация дисплея
  239            ; QUNIT: единица ~1 мс без звука, дисплей живёт
  240            ; ---------------------------------------------------------------------
  241  0089: 01 90 00 BUNIT:  LXI B,K_MS
  242  008C: 0B       BUL:    DCX B
  243  008D: 78               MOV A,B
  244  008E: B1               ORA C
  245  008F: C2 8C 00         JNZ BUL
  246  0092: 3A E8 FF         LDA SNDST
  247  0095: EE 01            XRI 01h
  248  0097: 32 E8 FF         STA SNDST
  249  009A: CD 52 00         CALL REFRESH
  250  009D: C9               RET
  251            
  252  009E: 01 90 00 QUNIT:  LXI B,K_MS
  253  00A1: 0B       QUL:    DCX B
  254  00A2: 78               MOV A,B
  255  00A3: B1               ORA C
  256  00A4: C2 A1 00         JNZ QUL
  257  00A7: CD 52 00         CALL REFRESH
  258  00AA: C9               RET
  259            
  260            ; ---------------------------------------------------------------------
  261            ; TICKON: короткий тик подтверждения клавиши (TICK_MS единиц ~1 мс,
  262            ; тон ~500 Гц). Дисплей живёт (SND едет в записи DIGP внутри REFRESH).
  263            ; Счётчик - В DE: REFRESH портит HL, но гарантирует D/E.
  264            ; ---------------------------------------------------------------------
  265  00AB: 11 1E 00 TICKON: LXI D,TICK_MS
  266  00AE: CD 89 00 TK1:    CALL BUNIT
  267  00B1: 1B               DCX D
  268  00B2: 7A               MOV A,D
  269  00B3: B3               ORA E
  270  00B4: C2 AE 00         JNZ TK1
  271  00B7: AF               XRA A
  272  00B8: 32 E8 FF         STA SNDST           ; тон гарантированно погашен
  273  00BB: C9               RET
  274            
  275            ; ---------------------------------------------------------------------
  276            ; GLOOK: A = тетрада 0..F -> A = глиф (GTBL). Портит A/B/C/H/L.
  277            ; ---------------------------------------------------------------------
  278  00BC: 4F       GLOOK:  MOV C,A
  279  00BD: 06 00            MVI B,0
  280  00BF: 21 03 00         LXI H,GTBL
  281  00C2: 09               DAD B
  282  00C3: 7E               MOV A,M
  283  00C4: C9               RET
  284            
  285            ; ---------------------------------------------------------------------
  286            ; REDRAW: пересобрать DIGIMG[0..3] по состоянию.
  287            ;   меню : DIG3='A'(77) DIG2='C'(39) DIG1='d'(5E) DIG0='E'(79) = "ACDE"
  288            ;   адрес: 4 тетрады вдвигаются СПРАВА (новая - в AF0/DIG0, старые
  289            ;          уходят влево), показаны последние ADCNT, пустые старшие
  290            ;          гаснут; 5-я тетрада вытесняет старшую
  291            ;   код  : DIG3/DIG2 пусто, DIG1 = BF1 (при BDCNT>=2), DIG0 = BF0
  292            ;          (при BDCNT>=1) - вид "__C3"
  293            ;   просм.: DIG3/DIG2 пусто, DIG1/DIG0 = байт [ADDR] - вид "__C3"
  294            ;   показ(F2): DIG3..DIG0 = 4 тетрады ADDR - вид "8012"
  295            ; ---------------------------------------------------------------------
  296  00C5: 3A E9 FF REDRAW: LDA STATE           ; пересборка глифов по состоянию
  297  00C8: B7               ORA A
  298  00C9: CA 6A 01         JZ RDM
  299  00CC: FE 01            CPI 01h
  300  00CE: CA 81 01         JZ RDA
  301  00D1: FE 03            CPI 03h
  302  00D3: CA 0C 01         JZ RDV
  303  00D6: FE 04            CPI 04h
  304  00D8: CA 35 01         JZ RDW
  305                    ; ---- ST_PROG ----
  306  00DB: AF               XRA A
  307  00DC: 32 F8 FF         STA DIGIMG3
  308  00DF: 32 F7 FF         STA DIGIMG2
  309  00E2: 32 F6 FF         STA DIGIMG1
  310  00E5: 32 F5 FF         STA DIGIMG0
  311  00E8: 3A F1 FF         LDA BDCNT
  312  00EB: FE 02            CPI 02h
  313  00ED: DA F9 00         JC RDPR0            ; <2 - старшая тетрада пуста
  314  00F0: 3A F2 FF         LDA BF1
  315  00F3: CD BC 00         CALL GLOOK
  316  00F6: 32 F6 FF         STA DIGIMG1
  317  00F9: 3A F1 FF RDPR0:  LDA BDCNT
  318  00FC: B7               ORA A
  319  00FD: CA D2 01         JZ RDRE             ; 0 - младшая тоже пуста
  320  0100: 3A F3 FF         LDA BF0
  321  0103: CD BC 00         CALL GLOOK
  322  0106: 32 F5 FF         STA DIGIMG0
  323  0109: C3 D2 01         JMP RDRE
  324  010C: 3A EA FF RDV:    LDA ADDRH           ; ---- ST_VIEW: [ADDR] в правых разрядах ----
  325  010F: 67               MOV H,A
  326  0110: 3A EB FF         LDA ADDRL
  327  0113: 6F               MOV L,A             ; HL = ADDR
  328  0114: 7E               MOV A,M             ; A = [ADDR] (HL>=8000h - ОЗУ)
  329  0115: 57               MOV D,A             ; D = байт (GLOOK портит B)
  330  0116: 0F               RRC
  331  0117: 0F               RRC
  332  0118: 0F               RRC
  333  0119: 0F               RRC
  334  011A: E6 0F            ANI 0Fh             ; старшая тетрада
  335  011C: CD BC 00         CALL GLOOK
  336  011F: 32 F6 FF         STA DIGIMG1
  337  0122: 7A               MOV A,D
  338  0123: E6 0F            ANI 0Fh             ; младшая тетрада
  339  0125: CD BC 00         CALL GLOOK
