  395            ; ---- главный цикл: скан 4 колонок, без нажатий - слот регенерации ----
  396  01BF: 1E 00    SCAN:   MVI E,0             ; E = индекс колонки 0..3
  397  01C1: 16 01            MVI D,01h           ; D = бит колонки
