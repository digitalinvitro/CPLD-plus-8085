  364            ; ---- главный цикл: скан 4 колонок, без нажатий - слот регенерации ----
  365  0190: 1E 00    SCAN:   MVI E,0             ; E = индекс колонки 0..3
  366  0192: 16 01            MVI D,01h           ; D = бит колонки
  367  0194: 7A       SC1:    MOV A,D
  368  0195: D3 02            OUT KBCOLP
  369  0197: CD 2B 00         CALL SETTLE
  370  019A: DB 03            IN KBROWP
  371  019C: E6 1F            ANI 1Fh
  372  019E: C2 B0 01         JNZ HIT
  373  01A1: 7A               MOV A,D
  374  01A2: 07               RLC
  375  01A3: 57               MOV D,A
  376  01A4: 1C               INR E
  377  01A5: FE 10            CPI 10h
  378  01A7: C2 94 01         JNZ SC1
  379  01AA: CD 52 00         CALL REFRESH        ; нажатий нет - слот дисплея
  380  01AD: C3 90 01         JMP SCAN
  381            
  382            ; ---- нажатие поймано: A = ряды, E = индекс колонки ----
  383  01B0: F5       HIT:    PUSH PSW
  384  01B1: AF               XRA A
  385  01B2: D3 02            OUT KBCOLP          ; колонки off (фиксируем факт нажатия)
  386  01B4: F1               POP PSW
  387  01B5: 16 00            MVI D,0             ; D = номер строки
  388  01B7: 0F       H1:     RRC
  389  01B8: DA BF 01         JC H2
  390  01BB: 14               INR D
  391  01BC: C3 B7 01         JMP H1
  392  01BF: 7A       H2:     MOV A,D             ; D = строка, E = колонка; код = KEYTBL[row*4+col]
  393  01C0: 07               RLC
  394  01C1: 07               RLC                 ; A = row*4
  395  01C2: 4F               MOV C,A
  396  01C3: 7B               MOV A,E
  397  01C4: B1               ORA C               ; | col
  398  01C5: 4F               MOV C,A
  399  01C6: 06 00            MVI B,0
  400  01C8: 21 17 00         LXI H,KEYTBL
  401  01CB: 09               DAD B
  402  01CC: 7E               MOV A,M
  403  01CD: FE FF            CPI 0FFh
  404  01CF: CA D5 01         JZ NKEY             ; пустая позиция матрицы
  405  01D2: CD F2 01         CALL DISPATCH
  406  01D5: CD 35 00 NKEY:   CALL SCANALL        ; ожидание отпускания + дебаунс
  407  01D8: E6 1F            ANI 1Fh
  408  01DA: CA E3 01         JZ WDN
  409  01DD: CD 52 00         CALL REFRESH
  410  01E0: C3 D5 01         JMP NKEY
  411  01E3: 11 02 00 WDN:    LXI D,SET_MS        ; счётчик В DE (QUNIT->REFRESH портит HL)
  412  01E6: CD 9E 00 ST1:    CALL QUNIT
  413  01E9: 1B               DCX D
  414  01EA: 7A               MOV A,D
  415  01EB: B3               ORA E
  416  01EC: C2 E6 01         JNZ ST1
  417  01EF: C3 90 01         JMP SCAN
