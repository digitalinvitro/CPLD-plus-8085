  559  0303: AF       KGO:    XRA A
  560  0304: D3 00            OUT SEGP            ; сегменты 0
  561  0306: D3 01            OUT DIGP            ; разряды 0, SND 0
  562  0308: D3 02            OUT KBCOLP          ; колонки off
  563  030A: F3               DI
  564  030B: 31 E8 FF         LXI SP,SP0
