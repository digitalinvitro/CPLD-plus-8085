  566  0311: E5               PUSH H              ; адрес возврата в монитор
  567  0312: 3A EA FF         LDA ADDRH
  568  0315: 67               MOV H,A
  569  0316: 3A EB FF         LDA ADDRL
  570  0319: 6F               MOV L,A             ; HL = адрес запуска
  571  031A: AF               XRA A
