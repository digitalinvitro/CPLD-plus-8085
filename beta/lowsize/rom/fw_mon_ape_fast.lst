  481  0261: FE 10            CPI K_ENT
  482  0263: CA 97 02         JZ AENT
  483  0266: FE 10            CPI 10h
  484  0268: DA 6C 02         JC ADIG             ; 00h..0Fh - тетрада адреса
  485  026B: C9               RET
  486  026C: 79       ADIG:   MOV A,C             ; A = тетрада
  487  026D: 47               MOV B,A             ; B = тетрада
  488  026E: 3A EE FF         LDA AF2
  489  0271: 32 ED FF         STA AF3
  490  0274: 3A EF FF         LDA AF1
  491  0277: 32 EE FF         STA AF2
