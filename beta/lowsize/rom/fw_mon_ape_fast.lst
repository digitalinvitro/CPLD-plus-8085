  419            ; ---------------------------------------------------------------------
  420            ; DISPATCH: обработка кода клавиши (A). F1 - глобально в меню.
  421            ; Смены состояния подтверждаются тиком; K_IGN - молча.
  422            ; ---------------------------------------------------------------------
  423  01F2: 4F       DISPATCH: MOV C,A           ; C = КОД КЛАВИШИ (LDA STATE затирает A!)
  424  01F3: FE 11            CPI K_F1
  425  01F5: CA F8 02         JZ K_F1E
  426  01F8: 3A E9 FF         LDA STATE
  427  01FB: B7               ORA A
  428  01FC: CA C7 02         JZ DSM
  429  01FF: FE 01            CPI 01h
  430  0201: CA 60 02         JZ DSA
