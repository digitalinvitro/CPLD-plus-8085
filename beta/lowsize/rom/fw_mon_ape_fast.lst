  432  0204: 79               MOV A,C             ; вернули код клавиши
  433  0205: FE 10            CPI K_ENT
  434  0207: CA 2F 02         JZ PENT
  435  020A: FE 10            CPI 10h
  436  020C: DA 10 02         JC PDIG             ; 00h..0Fh - тетрада байта
  437  020F: C9               RET                 ; F2 и пр. - игнор
  438  0210: 79       PDIG:   MOV A,C             ; A = тетрада
  439  0211: 47               MOV B,A             ; B = тетрада (C больше не нужен)
  440  0212: 3A F3 FF         LDA BF0
  441  0215: 32 F2 FF         STA BF1             ; сдвиг: BF1 = BF0
  442  0218: 78               MOV A,B
  443  0219: 32 F3 FF         STA BF0             ; BF0 = новая тетрада
  444  021C: 3A F1 FF         LDA BDCNT
  445  021F: FE 02            CPI 02h
  446  0221: D2 28 02         JNC PDS
  447  0224: 3C               INR A
  448  0225: 32 F1 FF         STA BDCNT
  449  0228: CD AB 00 PDS:    CALL TICKON
  450  022B: CD C5 00         CALL REDRAW
  451  022E: C9               RET
  452  022F: 3A F1 FF PENT:   LDA BDCNT
  453  0232: B7               ORA A
  454  0233: CA 5F 02         JZ PIGN             ; пусто - игнор (без записи)
  455  0236: 3A F2 FF         LDA BF1
  456  0239: 07               RLC
  457  023A: 07               RLC
  458  023B: 07               RLC
  459  023C: 07               RLC
  460  023D: 4F               MOV C,A
  461  023E: 3A F3 FF         LDA BF0
  462  0241: B1               ORA C               ; C = байт
  463  0242: 4F               MOV C,A
  464  0243: 3A EA FF         LDA ADDRH
  465  0246: 67               MOV H,A
  466  0247: 3A EB FF         LDA ADDRL
  467  024A: 6F               MOV L,A
  468  024B: 71               MOV M,C             ; [ADDR] = байт (A15=0 железо отбросит)
  469  024C: 23               INX H               ; ADDR++
  470  024D: 7C               MOV A,H
  471  024E: 32 EA FF         STA ADDRH
  472  0251: 7D               MOV A,L
  473  0252: 32 EB FF         STA ADDRL
  474  0255: AF               XRA A
  475  0256: 32 F1 FF         STA BDCNT           ; поле гасится - ждём следующий байт
  476  0259: CD AB 00         CALL TICKON
  477  025C: CD C5 00         CALL REDRAW
  478  025F: C9       PIGN:   RET
