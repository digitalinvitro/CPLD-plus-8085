    1            ; =====================================================================
    2            ; beta/lowsize/rom -- fw_mon_ape: МОНИТОР дисплея и клавиатуры (меню APE)
    3            ;
    4            ; Плата: retro_PCLD_board V2, CPLD = beta/lowsize v3.9.1/v3.9.2
    5            ; (транзиты kbcol/kbrow/seg/dig/SND идентичны v3.2...v3.9.x).
    6            ; Прошивается в flash A29040B с offset 0 (это и есть fw_mon: тест-прошивки
    7            ; fw_test_disp/fw_text_kbd после приёмки 10-30 больше не нужны).
    8            ;
    9            ; Сборка (asm85.py, исходник CP1251):
   10            ;   python3 asm85.py fw_mon_ape.asm -o fw_mon_ape.hex -l fw_mon_ape.lst
   11            ;   быстрый вариант для стендовой симуляции:
   12            ;   python3 asm85.py fw_mon_ape.asm -o fw_mon_ape_fast.hex -D FAST=1
   13            ;
   14            ; МАТРИЦА (PORTS_MAP.md §10): 4 колонки - ВЫХОДЫ порт 02h (D0..D3, 1 =
   15            ; заведена; после сброса 0000), 5 рядов - ВХОДЫ порт 03h (D0..D4,
   16            ; подтяжки 10к на GND, покой = 0, нажатие = 1). Клавиша (row,col) =
   17            ; SW_{row*4+col+1}. КАРТА КЛАВИШ (в скобках - что показывал тест
   18            ; клавиатуры fw_text_kbd, "строка__колонка"):
   19            ;
   20            ;            col0        col1        col2        col3
   21            ;   row0     A (0__0)    B (0__1)    C (0__2)    D (0__3)
   22            ;   row1     7 (1__0)    8 (1__1)    9 (1__2)    E (1__3)
   23            ;   row2     4 (2__0)    5 (2__1)    6 (2__2)    F (2__3)
   24            ;   row3     1 (3__0)    2 (3__1)    3 (3__2)    Enter (3__3)
   25            ;   row4     0 (4__0)    F1 (4__1)   F2 (4__2)   (нет: SW20 = RESET)
   26            ;
   27            ; РЕЖИМЫ (по ТЗ владельца, клк10-69):
   28            ;   F1 (4__1)  - системное меню "APE_" (работает из ЛЮБОГО режима);
   29            ;   A (0__0)   - из меню: ввод адреса, 4 знака; цифры 0-F вдвигаются
   30            ;                справа (как на калькуляторе: 8 -> "___8", 80 -> "__80"),
   31            ;                лишние (5-й и дальше) выталкивают старшие;
   32            ;   Enter      - завершает ввод адреса (при 0 знаков - игнор);
   33            ;   B (0__1)   - из меню: ВВОД ПРОГРАММЫ (= клавиша "P": физической P на
   34            ;                матрице НЕТ, назначена соседка A; переставить - один байт
   35            ;                в KEYTBL). Байт в КОДАХ 8085 - 2 тетрады в ПРАВЫХ
   36            ;                разрядах, слева пусто ("__C3"); Enter - записать байт
   37            ;                в [ADDR], ADDR++, поле гасится; Enter при пустом поле -
   38            ;                игнор; F1 - конец ввода, возврат в меню;
   39            ;   E (1__3)   - из меню: запуск программы с введённого адреса (по
   40            ;                умолчанию 8000h); дисплей гасится, DI, регистры 0,
   41            ;                SP = FFE8h, в стеке - адрес возврата в монитор;
   42            ;   ВЫХОД из пользовательской программы: RET (C9) - вернёт в меню "APE_"
   43            ;   (ждёт отпускания клавиш + дебаунс 30 мс); аварийный выход - RESET.
   44            ;   В меню остальные клавиши (0-9,C,D,F,F2,Enter) игнорируются.
   45            ;
   46            ; ПАМЯТЬ (MEMORY_MAP.md): ROM 0000h-7FFFh (запись невозможна - железо
   47            ; отбрасывает), RAM 8000h-FFFFh. Служебные монитора: FFE8h-FFF8h
   48            ; (переменные, см. ниже), стек с FFE7h вниз. ПОЛЬЗОВАТЕЛЬСКАЯ ОБЛАСТЬ:
   49            ; 8000h-FFE7h. Пример: A -> 8000 -> Enter -> B -> C3 Enter 0E Enter ->
   50            ; (RAM 8000=C3 8001=0E = JMP 000Eh... для пробы введите C9 - RET).
   51            ;
   52            ; ДИСПЛЕЙ: динамическая регенерация 4 разрядов, порядок ГАШЕНИЕ ->
   53            ; РАЗРЯД -> ГЛИФ (клк10-67, послесвечения нет - проверено на плате
   54            ; 10-30). Слот = один проход скана матрицы (~290 мкс: 4 колонки по
   55            ; ~180 T + REFRESH ~300 T) -> полный цикл дисплея ~1,16 мс (~860 Гц),
   56            ; скважность 1/4. Короткий ТИК ~31 мс (~500 Гц) на нажатую клавишу;
   57            ; бит SND (D4) едет в записи DIGP внутри REFRESH - дисплей при тике
   58            ; НЕ гаснет.
   59            ;
   60            ; ТАЙМИНГ (CPU 3,571 МГц, T = 280 нс):
   61            ;   SETTLE ~25 мкс (89 T); единица BUNIT/QUNIT ~1,05 мс (K_MS=144);
   62            ;   тик клавиши = TICK_MS единиц (полный 30 ~ 31 мс, FAST 4);
   63            ;   дебаунс отпускания = SET_MS единиц (полный 30 ~ 31 мс, FAST 2);
   64            ;   задержка реакции на нажатие < 1,2 мс (скан непрерывный).
   65            ; Ожидаемый тон тика по замеру на симуляции: ~500 Гц (полупериод ~1 мс).
   66            ; =====================================================================
   67            
   68            ; ---- константы (переопределяются через -D) ----
   69            FAST    EQU 0               ; 1 = укороченные паузы (для симуляции)
   70            IF FAST
   71            TICK_MS EQU 4               ; тик клавиши, единиц ~1 мс (быстро)
   72            SET_MS  EQU 2               ; дебаунс после отпускания
   73            ELSE
   74            TICK_MS EQU 30              ; 30 x ~1,05 мс = ~31 мс тик
   75            SET_MS  EQU 30              ; 30 x ~1,05 мс = ~31 мс дебаунс
   76            ENDIF
   77            
   78            K_MS    EQU 144             ; внутренний счётчик единицы ~1 мс
   79            
   80            ; ---- порты CPLD (декод по A2-A0, зеркала mod 8) ----
   81            SEGP    EQU 00h             ; сегменты: D0=a..D6=g, D7=dp; 1 = горит
   82            DIGP    EQU 01h             ; D3-D0 разряды, D4 = SND
   83            KBCOLP  EQU 02h             ; D3-D0 колонки (1 = заведена)
   84            KBROWP  EQU 03h             ; D4-D0 ряды (1 = нажата в активной колонке)
   85            
   86            ; ---- коды клавиш (после KEYTBL) ----
   87            ; 00h..0Fh = тетрады 0..F; далее:
   88            K_ENT   EQU 10h             ; Enter  (row3/col3, SW16)
   89            K_F1    EQU 11h             ; F1     (row4/col1, SW18) - меню
   90            K_F2    EQU 12h             ; F2     (row4/col2, SW19) - резерв
   91            K_NONE  EQU 0FFh            ; пустая позиция матрицы
   92            
   93            ; ---- состояния ----
   94            ST_MENU EQU 00h             ; меню "APE_"
   95            ST_ADDR EQU 01h             ; ввод адреса
   96            ST_PROG EQU 02h             ; ввод программы
   97            
   98            ; ---- ОЗУ (служебные монитора, FFE8h-FFF8h; стек с FFE7h вниз) ----
   99            SP0     EQU 0FFE8h          ; SP монитора
  100            SNDST   EQU 0FFE8h          ; состояние тона 0/1
  101            STATE   EQU 0FFE9h          ; 0=меню, 1=адрес, 2=программа
  102            ADDRH   EQU 0FFEAh          ; текущий адрес (старший)
  103            ADDRL   EQU 0FFEBh          ; текущий адрес (младший)
  104            ADCNT   EQU 0FFECh          ; введено тетрад адреса (0..4)
  105            AF3     EQU 0FFEDh          ; тетрады адреса (AF3 - старшая...)
  106            AF2     EQU 0FFEEh
  107            AF1     EQU 0FFEFh
  108            AF0     EQU 0FFF0h
  109            BDCNT   EQU 0FFF1h          ; введено тетрад байта (0..2)
  110            BF1     EQU 0FFF2h          ; старшая тетрада байта
  111            BF0     EQU 0FFF3h          ; младшая тетрада байта
  112            DPIDX   EQU 0FFF4h          ; фаза регенерации 0..3 (0 = DIG0)
  113            DIGIMG  EQU 0FFF5h          ; глифы разрядов DIG0..DIG3 (4 байта)
  114            DIGIMG0 EQU 0FFF5h          ;   правый (DIG0)
  115            DIGIMG1 EQU 0FFF6h
  116            DIGIMG2 EQU 0FFF7h
  117            DIGIMG3 EQU 0FFF8h          ;   левый (DIG3)
  118            
  119            ; =====================================================================
  120  0000: -                ORG 0000h
  121  0000: C3 6A 01         JMP MAIN
  122            
  123            ; ---- глифы '0'..'F' (a,b,c,d,e,f,g = D0..D6) ----
  124  0003: 3F       GTBL:   DB 3Fh              ; '0'
  125  0004: 06               DB 06h              ; '1'
  126  0005: 5B               DB 5Bh              ; '2'
  127  0006: 4F               DB 4Fh              ; '3'
  128  0007: 66               DB 66h              ; '4'
  129  0008: 6D               DB 6Dh              ; '5'
  130  0009: 7D               DB 7Dh              ; '6'
  131  000A: 07               DB 07h              ; '7'
  132  000B: 7F               DB 7Fh              ; '8'
  133  000C: 6F               DB 6Fh              ; '9'
  134  000D: 77               DB 77h              ; 'A'
  135  000E: 7C               DB 7Ch              ; 'b'
  136  000F: 39               DB 39h              ; 'C'
  137  0010: 5E               DB 5Eh              ; 'd'
  138  0011: 79               DB 79h              ; 'E'
  139  0012: 71               DB 71h              ; 'F'
  140            
  141            ; ---- биты разрядов (индекс = DPIDX: 0=DIG0 правый ... 3=DIG3 левый) ----
  142  0013: 01 02 04 08 BITTBL: DB 01h,02h,04h,08h
  143            
  144            ; ---- КАРТА КЛАВИШ: KEYTBL[row*4+col] ----
  145  0017: 0A 0B 0C 0D KEYTBL: DB 0Ah,0Bh,0Ch,0Dh  ; row0: A  B  C  D
  146  001B: 07 08 09 0E         DB 07h,08h,09h,0Eh  ; row1: 7  8  9  E
  147  001F: 04 05 06 0F         DB 04h,05h,06h,0Fh  ; row2: 4  5  6  F
  148  0023: 01 02 03 10         DB 01h,02h,03h,10h  ; row3: 1  2  3  Enter
  149  0027: 00 11 12 FF         DB 00h,11h,12h,0FFh ; row4: 0  F1 F2 (нет)
  150            
  151            ; ---------------------------------------------------------------------
  152            ; SETTLE: пауза ~25 мкс (установка рядов после заведения колонки)
  153            ; ---------------------------------------------------------------------
  154  002B: 01 03 00 SETTLE: LXI B,3
  155  002E: 0B       STL:    DCX B
  156  002F: 78               MOV A,B
  157  0030: B1               ORA C
  158  0031: C2 2E 00         JNZ STL
  159  0034: C9               RET
  160            
  161            ; ---------------------------------------------------------------------
  162            ; SCANALL: опрос всех 4 колонок; A = ИЛИ рядов (0 = нажатий нет);
  163            ; колонки на выходе погашены. Портит A/B/C/D/E.
  164            ; ---------------------------------------------------------------------
  165  0035: AF       SCANALL: XRA A
  166  0036: 5F               MOV E,A             ; E = накопитель
  167  0037: 16 01            MVI D,01h           ; D = бит колонки
  168  0039: 7A       SAL1:   MOV A,D
  169  003A: D3 02            OUT KBCOLP
  170  003C: CD 2B 00         CALL SETTLE
  171  003F: DB 03            IN KBROWP
  172  0041: E6 1F            ANI 1Fh
  173  0043: B3               ORA E
  174  0044: 5F               MOV E,A
  175  0045: 7A               MOV A,D
  176  0046: 07               RLC
  177  0047: 57               MOV D,A
  178  0048: FE 10            CPI 10h
  179  004A: C2 39 00         JNZ SAL1
  180  004D: AF               XRA A
  181  004E: D3 02            OUT KBCOLP
  182  0050: 7B               MOV A,E
  183  0051: C9               RET
  184            
  185            ; ---------------------------------------------------------------------
  186            ; REFRESH: один слот регенерации. ГАШЕНИЕ -> РАЗРЯД -> ГЛИФ
  187            ; (клк10-67, без послесвечения). DIGIMG[DPIDX] на разряд DPIDX.
  188            ; Бит D4 (SND) уносится записью DIGP - дисплей при тоне не гаснет.
  189            ; Портит A/B/C/H/L (D/E - бит колонки и индекс скана - НЕ трогает).
  190            ; ---------------------------------------------------------------------
  191  0052: 3A F4 FF REFRESH: LDA DPIDX
  192  0055: 4F               MOV C,A             ; C = индекс 0..3
  193  0056: 06 00            MVI B,0
  194  0058: 21 13 00         LXI H,BITTBL
  195  005B: 09               DAD B
  196  005C: 46               MOV B,M             ; B = бит разряда (01,02,04,08)
  197  005D: 21 F5 FF         LXI H,DIGIMG        ; HL = DIGIMG + DPIDX (цикл вместо ADD)
  198  0060: 79       RFIL:   MOV A,C
  199  0061: B7               ORA A
  200  0062: CA 6A 00         JZ RFGD
  201  0065: 2C               INR L
  202  0066: 0D               DCR C
  203  0067: C3 60 00         JMP RFIL
  204  006A: 4E       RFGD:   MOV C,M             ; C = глиф разряда
  205  006B: 3A E8 FF         LDA SNDST
  206  006E: B7               ORA A
  207  006F: CA 76 00         JZ RFN
  208  0072: 78               MOV A,B
  209  0073: F6 10            ORI 10h
  210  0075: 47               MOV B,A             ; B |= SND
  211  0076: AF       RFN:    XRA A
  212  0077: D3 00            OUT SEGP            ; (1) гашение: старый разряд погас
  213  0079: 78               MOV A,B
  214  007A: D3 01            OUT DIGP            ; (2) разряд переключён (сегменты пусты)
  215  007C: 79               MOV A,C
  216  007D: D3 00            OUT SEGP            ; (3) зажгли глиф нового разряда
  217  007F: 3A F4 FF         LDA DPIDX
  218  0082: 3C               INR A
  219  0083: E6 03            ANI 03h
  220  0085: 32 F4 FF         STA DPIDX
  221  0088: C9               RET
  222            
  223            ; ---------------------------------------------------------------------
  224            ; BUNIT: единица ~1 мс + тоггл SNDST + регенерация дисплея
  225            ; QUNIT: единица ~1 мс без звука, дисплей живёт
  226            ; ---------------------------------------------------------------------
  227  0089: 01 90 00 BUNIT:  LXI B,K_MS
  228  008C: 0B       BUL:    DCX B
  229  008D: 78               MOV A,B
  230  008E: B1               ORA C
  231  008F: C2 8C 00         JNZ BUL
  232  0092: 3A E8 FF         LDA SNDST
  233  0095: EE 01            XRI 01h
  234  0097: 32 E8 FF         STA SNDST
  235  009A: CD 52 00         CALL REFRESH
  236  009D: C9               RET
  237            
  238  009E: 01 90 00 QUNIT:  LXI B,K_MS
  239  00A1: 0B       QUL:    DCX B
  240  00A2: 78               MOV A,B
  241  00A3: B1               ORA C
  242  00A4: C2 A1 00         JNZ QUL
  243  00A7: CD 52 00         CALL REFRESH
  244  00AA: C9               RET
  245            
  246            ; ---------------------------------------------------------------------
  247            ; TICKON: короткий тик подтверждения клавиши (TICK_MS единиц ~1 мс,
  248            ; тон ~500 Гц). Дисплей живёт (SND едет в записи DIGP внутри REFRESH).
  249            ; Счётчик - В DE: REFRESH портит HL, но гарантирует D/E.
  250            ; ---------------------------------------------------------------------
  251  00AB: 11 04 00 TICKON: LXI D,TICK_MS
  252  00AE: CD 89 00 TK1:    CALL BUNIT
  253  00B1: 1B               DCX D
  254  00B2: 7A               MOV A,D
  255  00B3: B3               ORA E
  256  00B4: C2 AE 00         JNZ TK1
  257  00B7: AF               XRA A
  258  00B8: 32 E8 FF         STA SNDST           ; тон гарантированно погашен
  259  00BB: C9               RET
  260            
  261            ; ---------------------------------------------------------------------
  262            ; GLOOK: A = тетрада 0..F -> A = глиф (GTBL). Портит A/B/C/H/L.
  263            ; ---------------------------------------------------------------------
  264  00BC: 4F       GLOOK:  MOV C,A
  265  00BD: 06 00            MVI B,0
  266  00BF: 21 03 00         LXI H,GTBL
  267  00C2: 09               DAD B
  268  00C3: 7E               MOV A,M
  269  00C4: C9               RET
  270            
  271            ; ---------------------------------------------------------------------
  272            ; REDRAW: пересобрать DIGIMG[0..3] по состоянию.
  273            ;   меню : DIG3='A'(77) DIG2='P'(73) DIG1='E'(79) DIG0=пусто
  274            ;   адрес: 4 тетрады вдвигаются СПРАВА (новая - в AF0/DIG0, старые
  275            ;          уходят влево), показаны последние ADCNT, пустые старшие
  276            ;          гаснут; 5-я тетрада вытесняет старшую
  277            ;   прогр.: DIG3/DIG2 пусто, DIG1 = BF1 (при BDCNT>=2), DIG0 = BF0
  278            ;          (при BDCNT>=1) - вид "__C3"
  279            ; ---------------------------------------------------------------------
  280  00C5: 3A E9 FF REDRAW: LDA STATE           ; пересборка глифов по состоянию
  281  00C8: B7               ORA A
  282  00C9: CA 02 01         JZ RDM
  283  00CC: FE 01            CPI 01h
  284  00CE: CA 18 01         JZ RDA
  285                    ; ---- ST_PROG ----
  286  00D1: AF               XRA A
  287  00D2: 32 F8 FF         STA DIGIMG3
  288  00D5: 32 F7 FF         STA DIGIMG2
  289  00D8: 32 F6 FF         STA DIGIMG1
  290  00DB: 32 F5 FF         STA DIGIMG0
  291  00DE: 3A F1 FF         LDA BDCNT
  292  00E1: FE 02            CPI 02h
  293  00E3: DA EF 00         JC RDPR0            ; <2 - старшая тетрада пуста
  294  00E6: 3A F2 FF         LDA BF1
  295  00E9: CD BC 00         CALL GLOOK
  296  00EC: 32 F6 FF         STA DIGIMG1
  297  00EF: 3A F1 FF RDPR0:  LDA BDCNT
  298  00F2: B7               ORA A
  299  00F3: CA 69 01         JZ RDRE             ; 0 - младшая тоже пуста
  300  00F6: 3A F3 FF         LDA BF0
  301  00F9: CD BC 00         CALL GLOOK
  302  00FC: 32 F5 FF         STA DIGIMG0
  303  00FF: C3 69 01         JMP RDRE
  304  0102: 3E 77    RDM:    MVI A,77h           ; 'A'
  305  0104: 32 F8 FF         STA DIGIMG3
  306  0107: 3E 73            MVI A,73h           ; 'P'
  307  0109: 32 F7 FF         STA DIGIMG2
  308  010C: 3E 79            MVI A,79h           ; 'E'
  309  010E: 32 F6 FF         STA DIGIMG1
  310  0111: AF               XRA A
  311  0112: 32 F5 FF         STA DIGIMG0
  312  0115: C3 69 01         JMP RDRE
  313  0118: AF       RDA:    XRA A               ; ---- ST_ADDR: последняя тетрада справа ----
  314  0119: 32 F8 FF         STA DIGIMG3         ; (заполняем от DIG0 к DIG3 - ранний выход
  315  011C: 32 F7 FF         STA DIGIMG2         ; по счётчику тетрад)
  316  011F: 32 F6 FF         STA DIGIMG1
  317  0122: 32 F5 FF         STA DIGIMG0
  318  0125: 3A EC FF         LDA ADCNT
  319  0128: FE 01            CPI 01h             ; 0 тетрад - всё пусто
  320  012A: DA 69 01         JC RDRE
  321  012D: 3A F0 FF         LDA AF0             ; DIG0 = AF0 (последний ввод)
  322  0130: CD BC 00         CALL GLOOK
  323  0133: 32 F5 FF         STA DIGIMG0
  324  0136: 3A EC FF         LDA ADCNT
  325  0139: FE 02            CPI 02h
  326  013B: DA 69 01         JC RDRE
  327  013E: 3A EF FF         LDA AF1             ; DIG1 = AF1
  328  0141: CD BC 00         CALL GLOOK
  329  0144: 32 F6 FF         STA DIGIMG1
  330  0147: 3A EC FF         LDA ADCNT
  331  014A: FE 03            CPI 03h
  332  014C: DA 69 01         JC RDRE
  333  014F: 3A EE FF         LDA AF2             ; DIG2 = AF2
  334  0152: CD BC 00         CALL GLOOK
  335  0155: 32 F7 FF         STA DIGIMG2
  336  0158: 3A EC FF         LDA ADCNT
  337  015B: FE 04            CPI 04h
  338  015D: DA 69 01         JC RDRE
  339  0160: 3A ED FF         LDA AF3             ; DIG3 = AF3 (старшая)
  340  0163: CD BC 00         CALL GLOOK
  341  0166: 32 F8 FF         STA DIGIMG3
  342  0169: C9       RDRE:   RET
  343            
  344            ; ---------------------------------------------------------------------
  345            ; MAIN / MAIN2
  346            ; ---------------------------------------------------------------------
  347  016A: F3       MAIN:   DI
  348  016B: 31 E8 FF         LXI SP,SP0
  349  016E: 3E 80            MVI A,80h           ; адрес по умолчанию 8000h (начало ОЗУ)
  350  0170: 32 EA FF         STA ADDRH
  351  0173: AF               XRA A
  352  0174: 32 EB FF         STA ADDRL
  353  0177: AF       MAIN2:  XRA A
  354  0178: D3 00            OUT SEGP            ; дисплей погашен (после сброса горело "8.")
  355  017A: D3 01            OUT DIGP            ; разряды off, SND off
  356  017C: D3 02            OUT KBCOLP          ; колонки off (безопасный INIT)
