    1            ; =====================================================================
    2            ; beta/lowsize/rom -- fw_text_kbd: ТЕСТ КЛАВИАТУРЫ (строка/колонка + бип)
    3            ;
    4            ; Плата: retro_PCLD_board V2, CPLD = beta/lowsize v3.9.1/v3.9.2
    5            ; (транзиты kbcol/kbrow/seg/dig/SND идентичны v3.2...v3.9.x).
    6            ; Прошивается в flash A29040B с offset 0 (ЗАМЕНЯЕТ fw_mon на время теста).
    7            ;
    8            ; Сборка (asm85.py, исходник CP1251):
    9            ;   python3 asm85.py fw_text_kbd.asm -o fw_text_kbd.hex -l fw_text_kbd.lst
   10            ;   быстрый вариант для стендовой симуляции:
   11            ;   python3 asm85.py fw_text_kbd.asm -o fw_text_kbd_fast.hex -D FAST=1
   12            ;
   13            ; МАТРИЦА (Task 34): 4 колонки - зарегистрированные ВЫХОДЫ порт 02h
   14            ; (D0..D3 = col0..col3, 1 = колонка заведена; после сброса 0000),
   15            ; 5 рядов - ВХОДЫ порт 03h (D0..D4 = row0..row4; подтяжки R21-R25 10к
   16            ; на GND, покой = 0; нажатие в активной колонке = 1). Читается ТОЛЬКО
   17            ; порт 03h (остальные порты CPLD не драйвит).
   18            ;
   19            ; ЧТО ДЕЛАЕТ (по ТЗ владельца):
   20            ;   1) Непрерывно сканирует матрицу (колонка -> пауза ~25 мкс -> ряды).
   21            ;   2) НАЖАТИЕ КНОПКИ СОПРОВОЖДАЕТСЯ ЗВУКОВЫМ СИГНАЛОМ: бип ~0,2 с
   22            ;      (тон ~500 Гц, SND тогглится каждый ~1 мс).
   23            ;   3) НА ДИСПЛЕЙ ВЫВОДИТСЯ: СЛЕВА (DIG3) - НОМЕР СТРОКИ, СПРАВА (DIG0) -
   24            ;      НОМЕР КОЛОНКИ нажатой кнопки. Нумерация АППАРАТНАЯ, с нуля:
   25            ;      строки 0..4 (row0..row4, биты D0..D4 порта 03h), колонки 0..3
   26            ;      (col0..col3, биты D0..D3 порта 02h). Средние разряды погашены.
   27            ;      До первого нажатия на дисплее "--" (два прочерка).
   28            ;   4) После отпускания - пауза-дебаунс ~30 мс, затем скан продолжается
   29            ;      (можно нажимать следующую кнопку; дисплей показывает ПОСЛЕДНЮЮ).
   30            ;
   31            ; ПРИМЕРЫ: SW1 (row0/col0) -> дисплей "0 0"; SW11 (row2/col2) -> "2 2";
   32            ;   SW16 (row3/col3) -> "3 3"; SW17 (row4/col0) -> "4 0".
   33            ;   (расположение кнопок - PORTS_MAP.md §10: col0=SW1/SW5/SW9/SW13/SW17,
   34            ;   col1=SW2/SW6/SW10/SW14/SW18, col2=SW3/SW7/SW11/SW15/SW19,
   35            ;   col3=SW4/SW8/SW12/SW16; ряды - по R25..R21 сверху вниз).
   36            ;
   37            ; ТАЙМИНГ (CPU 3,571 МГц, T-состояние 280 нс):
   38            ;   SETTLE ~25 мкс (LXI 10 + 2x24 + 21 + RET = 89 T);
   39            ;   BEEP_UNIT ~1 мс (внутр. цикл 3463 T + тоггл SNDST 33 + CALL REFRESH
   40            ;     ~200 T) -> бип 200 ед. ~ 0,20-0,21 с, тон ~480-500 Гц;
   41            ;   регенерация дисплея: разряд переключается на каждом проходе скана
   42            ;     (4 колонки x ~75 мкс ~ 0,3 мс) -> ~1,7 кГц попеременно, скважность
   43            ;     1/1 - мерцания нет;
   44            ;   дебаунс нажатия: первая ловля - мгновенно (скан активен всегда),
   45            ;     ложные дребезги ПОСЛЕ отпускания гасятся паузой ~30 мс.
   46            ;
   47            ; ОЖИДАЕМОЕ ПОВЕДЕНИЕ / ИНТЕРПРЕТАЦИЯ:
   48            ;   - бип есть, номер не тот -> перепутаны ряды/колонки ( разводка/CPLD);
   49            ;   - бипа нет, номер есть -> тракт SND;
   50            ;   - бип без нажатия (самозвон) -> ряд висит в 1: подтяжка R21-R25,
   51            ;     замыкание ряда на колонку;
   52            ;   - двойные срабатывания с одного нажатия -> дребезг контактов
   53            ;     (пауза 30 мс гасит штатно; если чаще - деградация контакта);
   54            ;   - "--" горит, на нажатия реакции нет -> тракт KBROW/разъём.
   55            ; =====================================================================
   56            
   57            ; ---- константы (переопределяются через -D) ----
   58            FAST    EQU 0               ; 1 = укороченные паузы (для симуляции)
   59            IF FAST
   60            BEEP_MS EQU 4               ; единиц ~1 мс в бипе (быстро)
   61            SET_MS  EQU 2               ; дебаунс после отпускания
   62            ELSE
   63            BEEP_MS EQU 200             ; 200 x ~1,05 мс = ~0,21 с
   64            SET_MS  EQU 30              ; 30 x ~1,04 мс = ~31 мс
   65            ENDIF
   66            
   67            K_MS    EQU 144             ; внутренний счётчик ~1 мс
   68            
   69            ; ---- порты CPLD (декод по A2-A0, зеркала mod 8) ----
   70            SEGP    EQU 00h             ; сегменты: D0=a..D6=g, D7=dp; 1 = горит
   71            DIGP    EQU 01h             ; D3-D0 разряды, D4 = SND
   72            KBCOLP  EQU 02h             ; D3-D0 колонки (1 = заведена)
   73            KBROWP  EQU 03h             ; D4-D0 ряды (1 = нажата в активной колонке)
   74            
   75            ; ---- ОЗУ ----
   76            ROWNUM  EQU 8000h           ; номер строки 0..4
   77            COLNUM  EQU 8001h           ; номер колонки 0..3
   78            DPH     EQU 8002h           ; фаза регенерации: 08h = левый (строка), 01h = правый
   79            SNDST   EQU 8003h           ; состояние тона 0/1
   80            ROWIMG  EQU 8004h           ; глиф строки (DIG3)
   81            COLIMG  EQU 8005h           ; глиф колонки (DIG0)
   82            
   83            ; =====================================================================
   84  0000: -                ORG 0000h
   85  0000: C3 8D 00         JMP MAIN
   86            
   87            ; ---- глифы '0'..'5' (a,b,c,d,e,f = D0..D5) ----
   88  0003: 3F       GTBL:   DB 3Fh              ; '0'
   89  0004: 06               DB 06h              ; '1'
   90  0005: 5B               DB 5Bh              ; '2'
   91  0006: 4F               DB 4Fh              ; '3'
   92  0007: 66               DB 66h              ; '4'
   93  0008: 6D               DB 6Dh              ; '5' (запас)
   94            
   95            
   96            ; ---------------------------------------------------------------------
   97            ; SETTLE: пауза ~25 мкс (установка ряда после заведения колонки)
   98            ; ---------------------------------------------------------------------
   99  0009: 01 03 00 SETTLE: LXI B,3
  100  000C: 0B       STL:    DCX B
  101  000D: 78               MOV A,B
  102  000E: B1               ORA C
  103  000F: C2 0C 00         JNZ STL
  104  0012: C9               RET
  105            
  106            ; ---------------------------------------------------------------------
  107            ; REFRESH: вывести глиф активного разряда (с битом SND), переключить фазу
  108            ;   DPH=08h -> левый разряд (ROWIMG, строка); DPH=01h -> правый (COLIMG)
  109            ; ---------------------------------------------------------------------
  110  0013: 3A 02 80 REFRESH: LDA DPH
  111  0016: FE 08            CPI 08h
  112  0018: CA 21 00         JZ RF_L
  113  001B: 3A 05 80         LDA COLIMG
  114  001E: C3 24 00         JMP RF_S
  115  0021: 3A 04 80 RF_L:   LDA ROWIMG
  116  0024: D3 00    RF_S:   OUT SEGP
  117  0026: 3A 02 80         LDA DPH
  118  0029: 47               MOV B,A
  119  002A: 3A 03 80         LDA SNDST
  120  002D: B7               ORA A               ; тон включён?
  121  002E: CA 37 00         JZ RF_N
  122  0031: 78               MOV A,B
  123  0032: F6 10            ORI 10h
  124  0034: C3 38 00         JMP RF_O
  125  0037: 78       RF_N:   MOV A,B
  126  0038: D3 01    RF_O:   OUT DIGP
  127  003A: 3A 02 80         LDA DPH
  128  003D: FE 08            CPI 08h
  129  003F: CA 48 00         JZ RF_T
  130  0042: 3E 08            MVI A,08h           ; был правый -> левый
  131  0044: 32 02 80         STA DPH
  132  0047: C9               RET
  133  0048: 3E 01    RF_T:   MVI A,01h           ; был левый -> правый
  134  004A: 32 02 80         STA DPH
  135  004D: C9               RET
  136            
  137            ; ---------------------------------------------------------------------
  138            ; BEEP_UNIT: ~1 мс + тоггл SNDST + регенерация дисплея
  139            ; ---------------------------------------------------------------------
  140  004E: 01 90 00 BEEP_UNIT: LXI B,K_MS
  141  0051: 0B       BUL:    DCX B
  142  0052: 78               MOV A,B
  143  0053: B1               ORA C
  144  0054: C2 51 00         JNZ BUL
  145  0057: 3A 03 80         LDA SNDST
  146  005A: EE 01            XRI 01h
  147  005C: 32 03 80         STA SNDST
  148  005F: CD 13 00         CALL REFRESH        ; OUT DIGP уносит актуальный бит SND
  149  0062: C9               RET
  150            
  151            ; ---------------------------------------------------------------------
  152            ; QUIET_UNIT: ~1 мс без звука, дисплей живёт
  153            ; ---------------------------------------------------------------------
  154  0063: 01 90 00 QUIET_UNIT: LXI B,K_MS
  155  0066: 0B       QUL:    DCX B
  156  0067: 78               MOV A,B
  157  0068: B1               ORA C
  158  0069: C2 66 00         JNZ QUL
  159  006C: CD 13 00         CALL REFRESH
  160  006F: C9               RET
  161            
  162            ; ---------------------------------------------------------------------
  163            ; SCANALL: опрос всех 4 колонок; A = ИЛИ рядов (0 = нажатий нет);
  164            ; колонки на выходе погашены
  165            ; ---------------------------------------------------------------------
  166  0070: AF       SCANALL: XRA A
  167  0071: 5F               MOV E,A             ; E = накопитель (SETTLE трогает только A/B/C)
  168  0072: 16 01            MVI D,01h           ; D = бит колонки
  169  0074: 7A       SAL1:   MOV A,D
  170  0075: D3 02            OUT KBCOLP
  171  0077: CD 09 00         CALL SETTLE
  172  007A: DB 03            IN KBROWP
  173  007C: E6 1F            ANI 1Fh
  174  007E: B3               ORA E
  175  007F: 5F               MOV E,A
  176  0080: 7A               MOV A,D
  177  0081: 07               RLC
  178  0082: 57               MOV D,A
  179  0083: FE 10            CPI 10h
  180  0085: C2 74 00         JNZ SAL1
  181  0088: AF               XRA A
  182  0089: D3 02            OUT KBCOLP
  183  008B: 7B               MOV A,E
  184  008C: C9               RET
  185            
  186            ; ---------------------------------------------------------------------
  187            ; MAIN
  188            ; ---------------------------------------------------------------------
  189  008D: 31 00 84 MAIN:   LXI SP,8400h
  190  0090: AF               XRA A
  191  0091: D3 00            OUT SEGP            ; дисплей погашен
  192  0093: D3 01            OUT DIGP
  193  0095: D3 02            OUT KBCOLP          ; колонки off (безопасный INIT)
  194  0097: 3E 40            MVI A,40h           ; глиф '-' (сегмент g)
  195  0099: 32 04 80         STA ROWIMG
  196  009C: 32 05 80         STA COLIMG          ; до первого нажатия: "--"
  197  009F: 3E 01            MVI A,01h
  198  00A1: 32 02 80         STA DPH             ; старт регенерации с правого
  199  00A4: AF               XRA A
  200  00A5: 32 03 80         STA SNDST
  201            
  202                    ; ВНИМАНИЕ (нашлено симуляцией verify_fw.py): SETTLE/SCANALL/
  203                    ; BEEP_UNIT затирают A/B/C - бит колонки живёт в D, индекс в E.
  204  00A8: 1E 00    SCAN:   MVI E,0             ; индекс колонки 0..3
  205  00AA: 16 01            MVI D,01h           ; бит колонки
  206  00AC: 7A       SC1:    MOV A,D
  207  00AD: D3 02            OUT KBCOLP
  208  00AF: CD 09 00         CALL SETTLE
  209  00B2: DB 03            IN KBROWP
  210  00B4: E6 1F            ANI 1Fh
  211  00B6: C2 C8 00         JNZ HIT
  212  00B9: 7A               MOV A,D
  213  00BA: 07               RLC
  214  00BB: 57               MOV D,A
  215  00BC: 1C               INR E               ; следующий индекс колонки
  216  00BD: FE 10            CPI 10h
  217  00BF: C2 AC 00         JNZ SC1
  218  00C2: CD 13 00         CALL REFRESH        ; нажатий нет - шаг регенерации
  219  00C5: C3 A8 00         JMP SCAN
  220            
  221  00C8: F5       HIT:    PUSH PSW            ; A = ряды (один бит)
  222  00C9: AF               XRA A
  223  00CA: D3 02            OUT KBCOLP          ; колонки off (фиксируем факт нажатия)
  224  00CC: F1               POP PSW
  225  00CD: 16 00            MVI D,0             ; D = номер строки
  226  00CF: 0F       H1:     RRC
  227  00D0: DA D7 00         JC H2
  228  00D3: 14               INR D
  229  00D4: C3 CF 00         JMP H1
  230  00D7: 7A       H2:     MOV A,D
  231  00D8: 32 00 80         STA ROWNUM
  232  00DB: 7B               MOV A,E
  233  00DC: 32 01 80         STA COLNUM
  234                    ; глифы: COLIMG = GTBL[col], ROWIMG = GTBL[row]
  235  00DF: 3A 01 80         LDA COLNUM
  236  00E2: 5F               MOV E,A
  237  00E3: 16 00            MVI D,0
  238  00E5: 21 03 00         LXI H,GTBL
  239  00E8: 19               DAD D
  240  00E9: 7E               MOV A,M
  241  00EA: 32 05 80         STA COLIMG
  242  00ED: 3A 00 80         LDA ROWNUM
  243  00F0: 5F               MOV E,A
  244  00F1: 16 00            MVI D,0
  245  00F3: 21 03 00         LXI H,GTBL
  246  00F6: 19               DAD D
  247  00F7: 7E               MOV A,M
  248  00F8: 32 04 80         STA ROWIMG
  249                    ; ---- БИП ~0,2 с (дисплей живёт, глифы уже новые) ----
  250  00FB: 21 04 00         LXI H,BEEP_MS
  251  00FE: CD 4E 00 BP1:    CALL BEEP_UNIT
  252  0101: 2B               DCX H
  253  0102: 7C               MOV A,H
  254  0103: B5               ORA L
  255  0104: C2 FE 00         JNZ BP1
  256  0107: AF               XRA A
  257  0108: 32 03 80         STA SNDST           ; тон гарантированно погашен
  258                    ; ---- ожидание отпускания ----
  259  010B: CD 70 00 WREL:   CALL SCANALL
  260  010E: E6 1F            ANI 1Fh
  261  0110: CA 19 01         JZ WDN
  262  0113: CD 13 00         CALL REFRESH
  263  0116: C3 0B 01         JMP WREL
  264  0119: 21 02 00 WDN:    LXI H,SET_MS        ; дебаунс после отпускания
  265  011C: CD 63 00 ST1:    CALL QUIET_UNIT
  266  011F: 2B               DCX H
  267  0120: 7C               MOV A,H
  268  0121: B5               ORA L
  269  0122: C2 1C 01         JNZ ST1
  270  0125: C3 A8 00         JMP SCAN
  271            
  272  0128: -                END
