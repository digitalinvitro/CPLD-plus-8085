    1            ; =====================================================================
    2            ; beta/lowsize/rom -- fw_test_disp: ТЕСТ ДИСПЛЕЯ (сегменты + разряды + тон)
    3            ;
    4            ; Плата: retro_PCLD_board V2, CPLD = beta/lowsize v3.9.1/v3.9.2
    5            ; (порты/дисплей/звук идентичны v3.2...v3.9.x - транзиты seg/dig/SND).
    6            ; Прошивается в flash A29040B с offset 0 (ЗАМЕНЯЕТ fw_mon на время теста;
    7            ; вернуть монитор - перешить его образ). Терминал не используется.
    8            ;
    9            ; Сборка (asm85.py, исходник CP1251):
   10            ;   python3 asm85.py fw_test_disp.asm -o fw_test_disp.hex -l fw_test_disp.lst
   11            ;   быстрый вариант для стендовой симуляции/прогонки:
   12            ;   python3 asm85.py fw_test_disp.asm -o fw_test_disp_fast.hex -D FAST=1
   13            ;
   14            ; ЧТО ДЕЛАЕТ (по ТЗ владельца):
   15            ;   1) Зажигает ВСЕ сегменты индикатора ПО ПОРЯДКУ, от ПЕРВОГО разряда
   16            ;      до последнего: разряды 0 -> 1 -> 2 -> 3 (нумерация платы DIG0..DIG3),
   17            ;      внутри разряда сегменты a -> b -> c -> d -> e -> f -> g -> dp
   18            ;      (биты D0..D7 порта 00h). В каждый момент горит РОВНО ОДИН сегмент
   19            ;      одного разряда - по каждому сегменту видно и зажигание, и гашение.
   20            ;   2) Каждый сегмент горит ~0,9 с (в диапазоне 0,8..1,0 с по ТЗ) и
   21            ;      СОПРОВОЖДАЕТСЯ ЗВУКОМ - непрерывный тон ~500 Гц всю выдержку
   22            ;      (пассивный зуммер: SND тогглится каждый ~1 мс).
   23            ;   3) Между сегментами - тёмная пауза ~60 мс (тон погашен).
   24            ;   4) После последнего сегмента (dp разряда 3) выводит "tE5t" как
   25            ;      завершение: динамическая индикация 4 разрядов (t E 5 t слева
   26            ;      направо), без тона, до сброса/выключения. Регенерация с БЛЭНКИНГОМ
   27            ;      (гашение -> разряд -> глиф) - послесвечения чужого глифа нет.
   28            ;   Итого: 4 x 8 x (0,9 + 0,06) = ~30,6 с, затем "tE5t".
   29            ;
   30            ; ТАЙМИНГ (CPU 3,571 МГц, T-состояние 280 нс, машинный цикл 1,4 мкс):
   31            ;   внутренний цикл dcx/mov/ora/jnz: 6+4+4+10 = 24 T (последний 21);
   32            ;   MS_UNIT (1 ед. ~1 мс + тоггл SND): LXI 10 + 24x(K-1) + 21 + тоггл 43
   33            ;     + RET 10 = 24x144 + 60 = 3516 T = 984,5 мкс; с CALL и счётчиком
   34            ;     цикла: 18 + 3516 + 6+4+4+10 = 3558 T = 996,2 мкс на единицу;
   35            ;   выдержка сегмента = 900 x 996,2 мкс = 896,6 мс (0,8-1,0 с: ПАСС);
   36            ;   полупериод тона ~1 мс -> ~502 Гц;
   37            ;   пауза = 60 x 984 мкс = 59 мс (без тона);
   38            ;   tE5t: фаза = 222-цикл + блэнкинг = 5354 T = 1499 мкс на разряд, цикл 4 фаз =
   39            ;     6,0 мс -> частота регенерации ~167 Гц (мерцания нет).
   40            ;
   41            ; ОЖИДАЕМОЕ ПОВЕДЕНИЕ / ИНТЕРПРЕТАЦИЯ:
   42            ;   - горит ЛИШНИЙ сегмент/разряд -> замыкание сегментов/драйвера VT;
   43            ;   - сегмент НЕ горит -> обрыв сегмента, мёртвый светодиод, CPLD-пин;
   44            ;   - тон не меняется/нет -> тракт SND (бит D4 порта 01h);
   45            ;   - "8." хаос до старта -> норма (INIT CPLD seg=FF/dig=F до первого OUT);
   46            ;   - по завершении устойчивое "tE5t" = ТЕСТ ПРОЙДЕН.
   47            ; =====================================================================
   48            
   49            ; ---- константы (переопределяются через -D) ----
   50            FAST    EQU 0               ; 1 = укороченные выдержки (для симуляции)
   51            IF FAST
   52            SEG_MS  EQU 3               ; единиц ~1 мс на сегмент (быстро)
   53            GAP_MS  EQU 2               ; пауза между сегментами
   54            ELSE
   55            SEG_MS  EQU 900             ; 900 x 996 мкс = 896,6 мс (0,8..1,0 с)
   56            GAP_MS  EQU 60              ; 60 x 984 мкс = 59 мс
   57            ENDIF
   58            
   59            K_MS    EQU 144             ; внутренний счётчик ~1 мс (24x144+60 = 3516 T)
   60            K_15    EQU 222             ; счётчик фазы tE5t ~1,5 мс (5335 T = 1494 мкс)
   61            
   62            ; ---- порты CPLD (декод по A2-A0, зеркала mod 8) ----
   63            SEGP    EQU 00h             ; сегменты: D0=a..D6=g, D7=dp; 1 = горит
   64            DIGP    EQU 01h             ; D3-D0 разряды (1 = вкл), D4 = SND (1 = тон)
   65            
   66            ; ---- ОЗУ ----
   67            DIGIMG  EQU 8000h           ; образ порта 01h (разряд + SND)
   68            SEGCTR  EQU 8001h           ; счётчик сегментов в разряде (8..1)
   69            
   70            ; =====================================================================
   71  0000: -                ORG 0000h
   72  0000: C3 25 00         JMP MAIN
   73            
   74            ; ---- глифы "tE5t" (слева направо: DIG3,DIG2,DIG1,DIG0; d,e,f,g / a,d,e,f,g / a,f,g,c,d / t) ----
   75  0003: 78       GTE5T:  DB 78h              ; 't'
   76  0004: 79               DB 79h              ; 'E'
   77  0005: 6D               DB 6Dh              ; '5'
   78  0006: 78               DB 78h              ; 't'
   79            
   80            
   81            ; ---------------------------------------------------------------------
   82            ; MS_UNIT: ~1 мс + тоггл SND (непрерывный тон, пока вызывается в цикле)
   83            ; ---------------------------------------------------------------------
   84  0007: 01 90 00 MS_UNIT: LXI B,K_MS
   85  000A: 0B       MUL:    DCX B
   86  000B: 78               MOV A,B
   87  000C: B1               ORA C
   88  000D: C2 0A 00         JNZ MUL
   89  0010: 3A 00 80         LDA DIGIMG
   90  0013: EE 10            XRI 10h             ; тоггл SND
   91  0015: 32 00 80         STA DIGIMG
   92  0018: D3 01            OUT DIGP
   93  001A: C9               RET
   94            
   95            ; ---------------------------------------------------------------------
   96            ; MS_QUIET: ~1 мс без звука
   97            ; ---------------------------------------------------------------------
   98  001B: 01 90 00 MS_QUIET: LXI B,K_MS
   99  001E: 0B       MQL:    DCX B
  100  001F: 78               MOV A,B
  101  0020: B1               ORA C
  102  0021: C2 1E 00         JNZ MQL
  103  0024: C9               RET
  104            
  105            ; ---------------------------------------------------------------------
  106            ; MAIN
  107            ; ---------------------------------------------------------------------
  108  0025: 31 00 84 MAIN:   LXI SP,8400h
  109  0028: AF               XRA A
  110  0029: D3 00            OUT SEGP            ; сегменты погашены (INIT CPLD "8." гасим сразу)
  111  002B: D3 01            OUT DIGP            ; разряды off, SND off
  112  002D: 32 00 80         STA DIGIMG
  113            
  114                    ; ВНИМАНИЕ (нашлено симуляцией verify_fw.py): MS_UNIT/MS_QUIET
  115                    ; затирают A/B/C - биты разряда и сегмента живут в D и E
  116                    ; (подпрограммами не трогаются), счётчик сегментов - в ОЗУ.
  117  0030: 16 01            MVI D,01h           ; бит разряда: первый = DIG0
  118  0032: 1E 01    DIGL:   MVI E,01h           ; бит сегмента: 'a'
  119  0034: 3E 08            MVI A,8
  120  0036: 32 01 80         STA SEGCTR          ; 8 сегментов
  121  0039: 7B       SEGL:   MOV A,E
  122  003A: D3 00            OUT SEGP            ; показать сегмент
  123  003C: 7A               MOV A,D
  124  003D: F6 10            ORI 10h             ; разряд + SND=1 (стартовая фаза тона)
  125  003F: 32 00 80         STA DIGIMG
  126  0042: D3 01            OUT DIGP
  127  0044: 21 84 03         LXI H,SEG_MS        ; выдержка ~0,9 с с тоном
  128  0047: CD 07 00 IVL:    CALL MS_UNIT
  129  004A: 2B               DCX H
  130  004B: 7C               MOV A,H
  131  004C: B5               ORA L
  132  004D: C2 47 00         JNZ IVL
  133  0050: 7A               MOV A,D             ; пауза: тон погасить, разряд ещё горит
  134  0051: 32 00 80         STA DIGIMG
  135  0054: D3 01            OUT DIGP
  136  0056: 3E 00            MVI A,00h
  137  0058: D3 00            OUT SEGP            ; сегмент погашен (тёмная пауза)
  138  005A: 21 3C 00         LXI H,GAP_MS
  139  005D: CD 1B 00 GAPL:   CALL MS_QUIET
  140  0060: 2B               DCX H
  141  0061: 7C               MOV A,H
  142  0062: B5               ORA L
  143  0063: C2 5D 00         JNZ GAPL
  144  0066: 7B               MOV A,E
  145  0067: 07               RLC                 ; следующий сегмент a->b->...->dp
  146  0068: 5F               MOV E,A
  147  0069: 3A 01 80         LDA SEGCTR
  148  006C: 3D               DCR A
  149  006D: 32 01 80         STA SEGCTR
  150  0070: C2 39 00         JNZ SEGL
  151  0073: 7A               MOV A,D
  152  0074: 07               RLC                 ; следующий разряд DIG0->DIG1->DIG2->DIG3
  153  0075: 57               MOV D,A
  154  0076: FE 10            CPI 10h             ; после DIG3 (08h) - конец обхода
  155  0078: C2 32 00         JNZ DIGL
  156            
  157                    ; ---- завершение: "tE5t" (динамика, без тона), навсегда ----
  158            ;   Блэнкинг против послесвечения (клк10-67): ГАШЕНИЕ -> РАЗРЯД -> ГЛИФ;
  159            ;   наивный "глиф -> разряд" светил бы ЧУЖОЙ глиф на старом разряде
  160            ;   (~4 мкс каждый переход: сквозь 't' просвечивал 'E' и т.п.).
  161  007B: 0E 04    TE5T:   MVI C,4             ; 4 фазы
  162  007D: 06 08            MVI B,08h           ; старт с DIG3 (левый)
  163  007F: 21 03 00         LXI H,GTE5T
  164  0082: 56       TPH:    MOV D,M             ; D = глиф текущей фазы (D/E тут свободны)
  165  0083: AF               XRA A
  166  0084: D3 00            OUT SEGP            ; (1) гашение: старый разряд гаснет со своим глифом
  167  0086: 78               MOV A,B
  168  0087: D3 01            OUT DIGP            ; (2) разряд переключён при пустых сегментах
  169  0089: 7A               MOV A,D
  170  008A: D3 00            OUT SEGP            ; (3) новый разряд зажёгся СВОИМ глифом
  171  008C: 11 DE 00         LXI D,K_15          ; ~1,5 мс на фазу
  172  008F: 1B       TDL:    DCX D
  173  0090: 7A               MOV A,D
  174  0091: B3               ORA E
  175  0092: C2 8F 00         JNZ TDL
  176  0095: 78               MOV A,B
  177  0096: 0F               RRC                 ; DIG3->DIG2->DIG1->DIG0
  178  0097: 47               MOV B,A
  179  0098: 23               INX H
  180  0099: 0D               DCR C
  181  009A: C2 82 00         JNZ TPH
  182  009D: C3 7B 00         JMP TE5T
  183            
  184  00A0: -                END
