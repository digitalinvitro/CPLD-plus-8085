    1            ; =====================================================================
    2            ; beta/lowsize/rom -- fw_test_disp: ТЕСТ ДИСПЛЕЯ (сегменты + разряды + тон)
    3            ;
    4            ; Плата: retro_PCLD_board V2, CPLD = beta/lowsize v3.9.1/v3.9.2
    5            ; (порты/дисплей/звук идентичны v3.2...v3.9.x - транзиты seg/dig/SND).
    6            ; Прошивается в flash A29040B с offset 0 (ЗАМЕНЯЕТ fw_mon на время теста;
    7            ; вернуть монитор - перешить его образ). Терминал не используется.
    8            ;
    9            ; Сборка (asm85.py, исходник CP1251):
   10            ;   python3 asm85.py fw_test_disp.asm -o fw_test_disp.hex -l fw_test_disp.lst
   11            ;   быстрый вариант для стендовой симуляции/прогонки:
   12            ;   python3 asm85.py fw_test_disp.asm -o fw_test_disp_fast.hex -D FAST=1
   13            ;
   14            ; ЧТО ДЕЛАЕТ (по ТЗ владельца):
   15            ;   1) Зажигает ВСЕ сегменты индикатора ПО ПОРЯДКУ, от ПЕРВОГО разряда
   16            ;      до последнего: разряды 0 -> 1 -> 2 -> 3 (нумерация платы DIG0..DIG3),
   17            ;      внутри разряда сегменты a -> b -> c -> d -> e -> f -> g -> dp
   18            ;      (биты D0..D7 порта 00h). В каждый момент горит РОВНО ОДИН сегмент
   19            ;      одного разряда - по каждому сегменту видно и зажигание, и гашение.
   20            ;   2) Каждый сегмент горит ~0,9 с (в диапазоне 0,8..1,0 с по ТЗ) и
   21            ;      СОПРОВОЖДАЕТСЯ ЗВУКОМ - непрерывный тон ~500 Гц всю выдержку
   22            ;      (пассивный зуммер: SND тогглится каждый ~1 мс).
   23            ;   3) Между сегментами - тёмная пауза ~60 мс (тон погашен).
   24            ;   4) После последнего сегмента (dp разряда 3) выводит "tE5t" как
   25            ;      завершение: динамическая индикация 4 разрядов (t E 5 t слева
   26            ;      направо), без тона, до сброса/выключения.
   27            ;   Итого: 4 x 8 x (0,9 + 0,06) = ~30,6 с, затем "tE5t".
   28            ;
   29            ; ТАЙМИНГ (CPU 3,571 МГц, T-состояние 280 нс, машинный цикл 1,4 мкс):
   30            ;   внутренний цикл dcx/mov/ora/jnz: 6+4+4+10 = 24 T (последний 21);
   31            ;   MS_UNIT (1 ед. ~1 мс + тоггл SND): LXI 10 + 24x(K-1) + 21 + тоггл 43
   32            ;     + RET 10 = 24x144 + 60 = 3516 T = 984,5 мкс; с CALL и счётчиком
   33            ;     цикла: 18 + 3516 + 6+4+4+10 = 3558 T = 996,2 мкс на единицу;
   34            ;   выдержка сегмента = 900 x 996,2 мкс = 896,6 мс (0,8-1,0 с: ПАСС);
   35            ;   полупериод тона ~1 мс -> ~502 Гц;
   36            ;   пауза = 60 x 984 мкс = 59 мс (без тона);
   37            ;   tE5t: фаза = 222-цикл = 5335 T = 1494 мкс на разряд, цикл 4 фаз =
   38            ;     5,98 мс -> частота регенерации ~167 Гц (мерцания нет).
   39            ;
   40            ; ОЖИДАЕМОЕ ПОВЕДЕНИЕ / ИНТЕРПРЕТАЦИЯ:
   41            ;   - горит ЛИШНИЙ сегмент/разряд -> замыкание сегментов/драйвера VT;
   42            ;   - сегмент НЕ горит -> обрыв сегмента, мёртвый светодиод, CPLD-пин;
   43            ;   - тон не меняется/нет -> тракт SND (бит D4 порта 01h);
   44            ;   - "8." хаос до старта -> норма (INIT CPLD seg=FF/dig=F до первого OUT);
   45            ;   - по завершении устойчивое "tE5t" = ТЕСТ ПРОЙДЕН.
   46            ; =====================================================================
   47            
   48            ; ---- константы (переопределяются через -D) ----
   49            FAST    EQU 0               ; 1 = укороченные выдержки (для симуляции)
   50            IF FAST
   51            SEG_MS  EQU 3               ; единиц ~1 мс на сегмент (быстро)
   52            GAP_MS  EQU 2               ; пауза между сегментами
   53            ELSE
   54            SEG_MS  EQU 900             ; 900 x 996 мкс = 896,6 мс (0,8..1,0 с)
   55            GAP_MS  EQU 60              ; 60 x 984 мкс = 59 мс
   56            ENDIF
   57            
   58            K_MS    EQU 144             ; внутренний счётчик ~1 мс (24x144+60 = 3516 T)
   59            K_15    EQU 222             ; счётчик фазы tE5t ~1,5 мс (5335 T = 1494 мкс)
   60            
   61            ; ---- порты CPLD (декод по A2-A0, зеркала mod 8) ----
   62            SEGP    EQU 00h             ; сегменты: D0=a..D6=g, D7=dp; 1 = горит
   63            DIGP    EQU 01h             ; D3-D0 разряды (1 = вкл), D4 = SND (1 = тон)
   64            
   65            ; ---- ОЗУ ----
   66            DIGIMG  EQU 8000h           ; образ порта 01h (разряд + SND)
   67            SEGCTR  EQU 8001h           ; счётчик сегментов в разряде (8..1)
   68            
   69            ; =====================================================================
   70  0000: -                ORG 0000h
   71  0000: C3 25 00         JMP MAIN
   72            
   73            ; ---- глифы "tE5t" (слева направо: DIG3,DIG2,DIG1,DIG0; d,e,f,g / a,d,e,f,g / a,f,g,c,d / t) ----
   74  0003: 78       GTE5T:  DB 78h              ; 't'
   75  0004: 79               DB 79h              ; 'E'
   76  0005: 6D               DB 6Dh              ; '5'
   77  0006: 78               DB 78h              ; 't'
   78            
   79            
   80            ; ---------------------------------------------------------------------
   81            ; MS_UNIT: ~1 мс + тоггл SND (непрерывный тон, пока вызывается в цикле)
   82            ; ---------------------------------------------------------------------
   83  0007: 01 90 00 MS_UNIT: LXI B,K_MS
   84  000A: 0B       MUL:    DCX B
   85  000B: 78               MOV A,B
   86  000C: B1               ORA C
   87  000D: C2 0A 00         JNZ MUL
   88  0010: 3A 00 80         LDA DIGIMG
   89  0013: EE 10            XRI 10h             ; тоггл SND
   90  0015: 32 00 80         STA DIGIMG
   91  0018: D3 01            OUT DIGP
   92  001A: C9               RET
   93            
   94            ; ---------------------------------------------------------------------
   95            ; MS_QUIET: ~1 мс без звука
   96            ; ---------------------------------------------------------------------
   97  001B: 01 90 00 MS_QUIET: LXI B,K_MS
   98  001E: 0B       MQL:    DCX B
   99  001F: 78               MOV A,B
  100  0020: B1               ORA C
  101  0021: C2 1E 00         JNZ MQL
  102  0024: C9               RET
  103            
  104            ; ---------------------------------------------------------------------
  105            ; MAIN
  106            ; ---------------------------------------------------------------------
  107  0025: 31 00 84 MAIN:   LXI SP,8400h
  108  0028: AF               XRA A
  109  0029: D3 00            OUT SEGP            ; сегменты погашены (INIT CPLD "8." гасим сразу)
  110  002B: D3 01            OUT DIGP            ; разряды off, SND off
  111  002D: 32 00 80         STA DIGIMG
  112            
  113                    ; ВНИМАНИЕ (нашлено симуляцией verify_fw.py): MS_UNIT/MS_QUIET
  114                    ; затирают A/B/C - биты разряда и сегмента живут в D и E
  115                    ; (подпрограммами не трогаются), счётчик сегментов - в ОЗУ.
  116  0030: 16 01            MVI D,01h           ; бит разряда: первый = DIG0
  117  0032: 1E 01    DIGL:   MVI E,01h           ; бит сегмента: 'a'
  118  0034: 3E 08            MVI A,8
  119  0036: 32 01 80         STA SEGCTR          ; 8 сегментов
  120  0039: 7B       SEGL:   MOV A,E
  121  003A: D3 00            OUT SEGP            ; показать сегмент
  122  003C: 7A               MOV A,D
  123  003D: F6 10            ORI 10h             ; разряд + SND=1 (стартовая фаза тона)
  124  003F: 32 00 80         STA DIGIMG
  125  0042: D3 01            OUT DIGP
  126  0044: 21 03 00         LXI H,SEG_MS        ; выдержка ~0,9 с с тоном
  127  0047: CD 07 00 IVL:    CALL MS_UNIT
  128  004A: 2B               DCX H
  129  004B: 7C               MOV A,H
  130  004C: B5               ORA L
  131  004D: C2 47 00         JNZ IVL
  132  0050: 7A               MOV A,D             ; пауза: тон погасить, разряд ещё горит
  133  0051: 32 00 80         STA DIGIMG
  134  0054: D3 01            OUT DIGP
  135  0056: 3E 00            MVI A,00h
  136  0058: D3 00            OUT SEGP            ; сегмент погашен (тёмная пауза)
  137  005A: 21 02 00         LXI H,GAP_MS
  138  005D: CD 1B 00 GAPL:   CALL MS_QUIET
  139  0060: 2B               DCX H
  140  0061: 7C               MOV A,H
  141  0062: B5               ORA L
  142  0063: C2 5D 00         JNZ GAPL
  143  0066: 7B               MOV A,E
  144  0067: 07               RLC                 ; следующий сегмент a->b->...->dp
  145  0068: 5F               MOV E,A
  146  0069: 3A 01 80         LDA SEGCTR
  147  006C: 3D               DCR A
  148  006D: 32 01 80         STA SEGCTR
  149  0070: C2 39 00         JNZ SEGL
  150  0073: 7A               MOV A,D
  151  0074: 07               RLC                 ; следующий разряд DIG0->DIG1->DIG2->DIG3
  152  0075: 57               MOV D,A
  153  0076: FE 10            CPI 10h             ; после DIG3 (08h) - конец обхода
  154  0078: C2 32 00         JNZ DIGL
  155            
  156                    ; ---- завершение: "tE5t" (динамика, без тона), навсегда ----
  157  007B: 0E 04    TE5T:   MVI C,4             ; 4 фазы
  158  007D: 06 08            MVI B,08h           ; старт с DIG3 (левый)
  159  007F: 21 03 00         LXI H,GTE5T
  160  0082: 7E       TPH:    MOV A,M
  161  0083: D3 00            OUT SEGP            ; глиф
  162  0085: 78               MOV A,B
  163  0086: D3 01            OUT DIGP            ; только текущий разряд
  164  0088: 11 DE 00         LXI D,K_15          ; ~1,5 мс на фазу
  165  008B: 1B       TDL:    DCX D
  166  008C: 7A               MOV A,D
  167  008D: B3               ORA E
  168  008E: C2 8B 00         JNZ TDL
  169  0091: 78               MOV A,B
  170  0092: 0F               RRC                 ; DIG3->DIG2->DIG1->DIG0
  171  0093: 47               MOV B,A
  172  0094: 23               INX H
  173  0095: 0D               DCR C
  174  0096: C2 82 00         JNZ TPH
  175  0099: C3 7B 00         JMP TE5T
  176            
  177  009C: -                END
