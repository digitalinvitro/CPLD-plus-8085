	OR (A(0).PIN AND $OpTx$FX_DC$137));

FDCPE_col1: FDCPE port map (col1,col1_D,clk,RST,'0');
col1_D <= ((col1 AND NOT $OpTx$FX_DC$137)
	OR (A(1).PIN AND $OpTx$FX_DC$137));

FDCPE_col2: FDCPE port map (col2,col2_D,clk,RST,'0');
col2_D <= ((col2 AND NOT $OpTx$FX_DC$137)
	OR (A(2).PIN AND $OpTx$FX_DC$137));

