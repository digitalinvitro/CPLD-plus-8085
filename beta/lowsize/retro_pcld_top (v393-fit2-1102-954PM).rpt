col3_D <= ((col3 AND NOT $OpTx$FX_DC$137)
	OR (A(3).PIN AND $OpTx$FX_DC$137));

FDCPE_dig0: FDCPE port map (dig(0),dig_D(0),clk,RST,'0');
dig_D(0) <= ((NOT A(0).PIN AND $OpTx$FX_DC$136)
	OR (dig(0) AND NOT $OpTx$FX_DC$136));

FDCPE_dig1: FDCPE port map (dig(1),dig_D(1),clk,RST,'0');
dig_D(1) <= ((NOT A(1).PIN AND $OpTx$FX_DC$136)
	OR (dig(1) AND NOT $OpTx$FX_DC$136));

FDCPE_dig2: FDCPE port map (dig(2),dig_D(2),clk,RST,'0');
dig_D(2) <= ((NOT A(2).PIN AND $OpTx$FX_DC$136)
	OR (dig(2) AND NOT $OpTx$FX_DC$136));

FDCPE_dig3: FDCPE port map (dig(3),dig_D(3),clk,RST,'0');
dig_D(3) <= ((NOT A(3).PIN AND $OpTx$FX_DC$136)
	OR (dig(3) AND NOT $OpTx$FX_DC$136));


io_rd_kb/io_rd_kb_D2 <= (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM);

FDCPE_por_run: FDCPE port map (por_run,por_sh(0),clk,'0','0');

FDCPE_por_sh0: FDCPE port map (por_sh(0),por_sh_D(0),clk,'0','0');
por_sh_D(0) <= ((por_sh(0) AND NOT $OpTx$FX_DC$449)
	OR (por_sh(1) AND $OpTx$FX_DC$452));

FDCPE_por_sh1: FDCPE port map (por_sh(1),por_sh_D(1),clk,'0','0');
por_sh_D(1) <= ((por_sh(1) AND NOT $OpTx$FX_DC$449)
	OR (por_sh(2) AND $OpTx$FX_DC$452));

FDCPE_por_sh2: FDCPE port map (por_sh(2),por_sh_D(2),clk,'0','0');
por_sh_D(2) <= ((por_sh(2) AND NOT $OpTx$FX_DC$449)
	OR (por_sh(3) AND $OpTx$FX_DC$452));

FDCPE_por_sh3: FDCPE port map (por_sh(3),por_sh_D(3),clk,'0','0');
por_sh_D(3) <= ((por_sh(3) AND NOT $OpTx$FX_DC$449)
	OR (por_sh(4) AND $OpTx$FX_DC$452));

FDCPE_por_sh4: FDCPE port map (por_sh(4),por_sh_D(4),clk,'0','0');
por_sh_D(4) <= ((por_sh(4) AND NOT $OpTx$FX_DC$449)
	OR (por_sh(5) AND $OpTx$FX_DC$452));

FDCPE_por_sh5: FDCPE port map (por_sh(5),por_sh_D(5),clk,'0','0');
por_sh_D(5) <= ((por_sh(5) AND NOT $OpTx$FX_DC$449)
	OR (por_sh(6) AND $OpTx$FX_DC$452));

FDCPE_por_sh6: FDCPE port map (por_sh(6),por_sh_D(6),clk,'0','0');
por_sh_D(6) <= ((por_sh(6) AND NOT $OpTx$FX_DC$449)
	OR (por_sh(7) AND $OpTx$FX_DC$449));

FDCPE_por_sh7: FDCPE port map (por_sh(7),por_sh_D(7),clk,'0','0');
por_sh_D(7) <= (por_sh(7) AND NOT $OpTx$FX_DC$449);


rd_drive/rd_drive_D2 <= (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	rd_seen AND NOT ALE AND NOT RDn);

FDCPE_rd_seen: FDCPE port map (rd_seen,rd_seen_D,clk,RST,'0');
rd_seen_D <= ((NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	wr_seen AND WRn AND NOT RDn)
	OR (state_FSM_FFd3 AND rd_seen)
	OR (NOT state_FSM_FFd2 AND rd_seen)
	OR (NOT state_FSM_FFd1 AND rd_seen)
	OR (rd_seen AND wr_seen AND WRn)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT ALE AND NOT RDn));

