*******************************  Equations  ********************************

********** Mapped Logic **********


$OpTx$FX_SC$197 <= ((NOT IOM AND state_FSM_FFd1 AND NOT state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND NOT tx_byte_FSM_FFd1 AND ALE)
	OR (NOT IOM AND state_FSM_FFd1 AND NOT state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND NOT tx_byte_FSM_FFd2 AND ALE)
	OR (NOT IOM AND state_FSM_FFd1 AND NOT state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND NOT adv_q AND ALE)
	OR (NOT IOM AND NOT bit_cnt(2) AND state_FSM_FFd1 AND 
	NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND NOT bit_cnt(1) AND NOT bit_cnt(3) AND ALE));


$OpTx$FX_SC$204 <= ((tx_byte_FSM_FFd1)
	OR (NOT tx_byte_FSM_FFd2)
	OR (NOT adv_q)
	OR (NOT bit_cnt(2) AND NOT bit_cnt(1) AND NOT bit_cnt(3))
	OR (state_FSM_FFd1 AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	ALE));


$OpTx$FX_SC$205 <= ((NOT tx_byte_FSM_FFd1)
	OR (NOT tx_byte_FSM_FFd2)
	OR (NOT adv_q)
	OR (state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	NOT WRn)
	OR (NOT bit_cnt(2) AND NOT bit_cnt(1) AND NOT bit_cnt(3)));


A_I(0) <= ((D(0) AND addr_latch(2) AND rd_drive/rd_drive_D2)
	OR (IOM AND addr_latch(0) AND addr_latch(1) AND 
	NOT addr_latch(2) AND row0)
	OR (addr_latch(0) AND NOT rd_drive/rd_drive_D2)
	OR (D(0) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (D(0) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (D(0) AND NOT addr_latch(1) AND rd_drive/rd_drive_D2));
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(1) <= ((D(1) AND addr_latch(2) AND rd_drive/rd_drive_D2)
	OR (IOM AND addr_latch(0) AND addr_latch(1) AND 
	NOT addr_latch(2) AND row1)
	OR (addr_latch(1) AND NOT rd_drive/rd_drive_D2)
	OR (D(1) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (D(1) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (D(1) AND NOT addr_latch(1) AND rd_drive/rd_drive_D2));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
A_OE(1) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(2) <= ((IOM AND addr_latch(0) AND addr_latch(1) AND 
	NOT addr_latch(2) AND row2 AND rd_drive/rd_drive_D2)
