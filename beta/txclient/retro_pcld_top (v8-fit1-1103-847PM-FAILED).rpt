D(7) <= ((state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	NOT WRn AND A(7).PIN)
	OR (D(7) AND NOT bus_reg_and0001/bus_reg_and0001_D2)
	OR (D(7).PIN AND $OpTx$FX_SC$197));
D(7) <= D_I(7) when D_OE(7) = '1' else 'Z';
D_OE(7) <= bus_reg(7)/bus_reg(7)_TRST;





FDCPE_HOLD: FDCPE port map (HOLD,HOLD_D,clk,RST,'0');
HOLD_D <= ((HOLD AND tx_byte_FSM_FFd1 AND NOT ld_q)
	OR (HOLD AND NOT tx_byte_FSM_FFd1 AND NOT hlda_q)
	OR (NOT IOM AND A15 AND state_FSM_FFd1 AND NOT state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND ALE AND S0 AND NOT S1 AND NOT AH14 AND NOT por_run)
	OR (HOLD AND cap_run)
	OR (HOLD AND tx_byte_FSM_FFd2)
	OR (HOLD AND state_FSM_FFd1 AND NOT tx_byte_FSM_FFd1)
	OR (HOLD AND state_FSM_FFd2 AND NOT tx_byte_FSM_FFd1)
	OR (HOLD AND state_FSM_FFd3 AND NOT tx_byte_FSM_FFd1));


OE_n <= NOT ((NOT IOM AND A15 AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	FC_0_.OUT));


OEr_n <= NOT ((NOT IOM AND NOT A15 AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	FC_0_.OUT));


READY <= '1';


RESET_IN <= (NOT RST AND NOT por_run);


SID <= RX;

FDCPE_SND: FDCPE port map (SND,SND_D,clk,RST,'0');
SND_D <= ((SND AND NOT dig_q_or0000/dig_q_or0000_D2)
	OR (A(4).PIN AND dig_q_or0000/dig_q_or0000_D2));


TX <= NOT (FC_2_.OUT);


WE_n <= ((NOT state_FSM_FFd3)
	OR (state_FSM_FFd1 AND NOT state_FSM_FFd2));


X1 <= NOT ((NOT cnt(0) AND NOT cnt(1) AND NOT cnt(2))
	 XOR 
X1 <= NOT (x1_n);


X2 <= (NOT cnt(0) AND NOT cnt(1) AND NOT cnt(2))
	 XOR 
X2 <= x1_n;

FDCPE_addr_latch0: FDCPE port map (addr_latch(0),addr_latch_D(0),clk,RST,'0');
addr_latch_D(0) <= ((addr_latch(0) AND NOT $OpTx$FX_SC$200)
	OR (addr_latch(1) AND NOT $OpTx$FX_SC$204)
	OR (ALE AND A(0).PIN AND FC_1_.OUT));

FDCPE_addr_latch1: FDCPE port map (addr_latch(1),addr_latch_D(1),clk,RST,'0');
addr_latch_D(1) <= ((addr_latch(1) AND NOT $OpTx$FX_SC$200)
	OR (addr_latch(2) AND NOT $OpTx$FX_SC$204)
	OR (ALE AND A(1).PIN AND FC_1_.OUT));

FDCPE_addr_latch2: FDCPE port map (addr_latch(2),addr_latch_D(2),clk,RST,'0');
addr_latch_D(2) <= ((addr_latch(2) AND NOT $OpTx$FX_SC$200)
	OR (addr_latch(3) AND NOT $OpTx$FX_SC$204)
	OR (ALE AND A(2).PIN AND FC_1_.OUT));

FDCPE_addr_latch3: FDCPE port map (addr_latch(3),addr_latch_D(3),clk,RST,'0');
addr_latch_D(3) <= ((addr_latch(3) AND NOT $OpTx$FX_SC$200)
	OR (addr_latch(4) AND NOT $OpTx$FX_SC$204)
	OR (ALE AND A(3).PIN AND FC_1_.OUT));

FDCPE_addr_latch4: FDCPE port map (addr_latch(4),addr_latch_D(4),clk,RST,'0');
addr_latch_D(4) <= ((addr_latch(4) AND NOT $OpTx$FX_SC$200)
	OR (addr_latch(5) AND NOT $OpTx$FX_SC$204)
	OR (state_FSM_FFd1 AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	ALE AND A(4).PIN));

FDCPE_addr_latch5: FDCPE port map (addr_latch(5),addr_latch_D(5),clk,RST,'0');
addr_latch_D(5) <= ((addr_latch(5) AND NOT $OpTx$FX_SC$200)
	OR (addr_latch(6) AND NOT $OpTx$FX_SC$204)
	OR (ALE AND A(5).PIN AND FC_1_.OUT));

FDCPE_addr_latch6: FDCPE port map (addr_latch(6),addr_latch_D(6),clk,RST,'0');
addr_latch_D(6) <= ((addr_latch(6) AND NOT $OpTx$FX_SC$200)
	OR (addr_latch(7) AND NOT $OpTx$FX_SC$204)
	OR (ALE AND A(6).PIN AND FC_1_.OUT));

FDCPE_addr_latch7: FDCPE port map (addr_latch(7),addr_latch_D(7),clk,RST,'0');
addr_latch_D(7) <= ((addr_latch(7) AND NOT $OpTx$FX_SC$200)
	OR (state_FSM_FFd1 AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	ALE AND A(7).PIN));

FDCPE_adv_q: FDCPE port map (adv_q,adv_q_D,clk,RST,'0');
adv_q_D <= ((tx_byte_FSM_FFd1 AND NOT baud_cnt(0) AND NOT baud_cnt(1) AND 
	baud_cnt(2) AND baud_cnt(3))
	OR (tx_byte_FSM_FFd2 AND NOT baud_cnt(0) AND NOT baud_cnt(1) AND 
	baud_cnt(2) AND baud_cnt(3)));

FDCPE_baud_cnt0: FDCPE port map (baud_cnt(0),baud_cnt_D(0),clk,RST,'0');
baud_cnt_D(0) <= ((NOT baud_cnt(0) AND baud_cnt(1))
	OR (NOT baud_cnt(0) AND NOT baud_cnt(2))
	OR (NOT baud_cnt(0) AND NOT baud_cnt(3))
	OR (NOT bit_cnt(2) AND cap_run AND NOT bit_cnt(1) AND NOT bit_cnt(0) AND 
	bit_cnt(3)));

FDCPE_baud_cnt1: FDCPE port map (baud_cnt(1),baud_cnt_D(1),clk,RST,'0');
baud_cnt_D(1) <= ((baud_cnt(0) AND baud_cnt(1))
	OR (NOT baud_cnt(0) AND NOT baud_cnt(1))
	OR (NOT bit_cnt(2) AND cap_run AND NOT bit_cnt(1) AND NOT bit_cnt(0) AND 
	bit_cnt(3)));

FDCPE_baud_cnt2: FDCPE port map (baud_cnt(2),baud_cnt_D(2),clk,RST,'0');
baud_cnt_D(2) <= ((NOT baud_cnt(0) AND NOT baud_cnt(2))
	OR (NOT baud_cnt(1) AND NOT baud_cnt(2))
	OR (baud_cnt(0) AND baud_cnt(1) AND baud_cnt(2))
	OR (NOT baud_cnt(0) AND NOT baud_cnt(1) AND baud_cnt(3))
	OR (NOT bit_cnt(2) AND cap_run AND NOT bit_cnt(1) AND NOT bit_cnt(0) AND 
	bit_cnt(3)));

FDCPE_baud_cnt3: FDCPE port map (baud_cnt(3),baud_cnt_D(3),clk,RST,'0');
baud_cnt_D(3) <= ((NOT bit_cnt(2) AND cap_run AND NOT bit_cnt(1) AND NOT bit_cnt(0) AND 
	bit_cnt(3))
	OR (NOT baud_cnt(0) AND NOT baud_cnt(3))
	OR (NOT baud_cnt(1) AND NOT baud_cnt(3))
	OR (NOT baud_cnt(2) AND NOT baud_cnt(3))
	OR (NOT baud_cnt(0) AND NOT baud_cnt(1) AND baud_cnt(2))
	OR (baud_cnt(0) AND baud_cnt(1) AND baud_cnt(2) AND 
	baud_cnt(3)));

FTCPE_bit_cnt0: FTCPE port map (bit_cnt(0),bit_cnt_T(0),clk,RST,'0');
bit_cnt_T(0) <= ((NOT cap_run AND NOT tx_byte_FSM_FFd1 AND NOT tx_byte_FSM_FFd2)
	OR (NOT cap_run AND NOT bit_cnt(0) AND ld_q)
	OR (NOT cap_run AND NOT adv_q AND NOT ld_q)
	OR (NOT bit_cnt(2) AND cap_run AND NOT bit_cnt(1) AND NOT bit_cnt(0) AND 
	bit_cnt(3)));

FTCPE_bit_cnt1: FTCPE port map (bit_cnt(1),bit_cnt_T(1),clk,RST,'0');
bit_cnt_T(1) <= ((cap_run AND NOT bit_cnt(0))
	OR (NOT bit_cnt(0) AND NOT ld_q)
	OR (NOT cap_run AND NOT tx_byte_FSM_FFd1 AND NOT tx_byte_FSM_FFd2)
	OR (NOT cap_run AND NOT bit_cnt(1) AND ld_q)
	OR (NOT cap_run AND NOT adv_q AND NOT ld_q));

FTCPE_bit_cnt2: FTCPE port map (bit_cnt(2),bit_cnt_T(2),clk,RST,'0');
bit_cnt_T(2) <= ((cap_run AND bit_cnt(1) AND bit_cnt(0))
	OR (bit_cnt(2) AND NOT cap_run AND tx_byte_FSM_FFd1 AND ld_q)
	OR (bit_cnt(2) AND NOT cap_run AND tx_byte_FSM_FFd2 AND ld_q)
	OR (tx_byte_FSM_FFd1 AND bit_cnt(1) AND bit_cnt(0) AND 
	adv_q AND NOT ld_q)
	OR (bit_cnt(1) AND tx_byte_FSM_FFd2 AND bit_cnt(0) AND 
	adv_q AND NOT ld_q));

FTCPE_bit_cnt3: FTCPE port map (bit_cnt(3),bit_cnt_T(3),clk,RST,'0');
bit_cnt_T(3) <= ((bit_cnt(2) AND cap_run AND bit_cnt(1) AND bit_cnt(0))
	OR (NOT cap_run AND tx_byte_FSM_FFd1 AND bit_cnt(3) AND ld_q)
	OR (NOT cap_run AND tx_byte_FSM_FFd2 AND bit_cnt(3) AND ld_q)
	OR (NOT bit_cnt(2) AND cap_run AND NOT bit_cnt(1) AND NOT bit_cnt(0) AND 
	bit_cnt(3))
	OR (bit_cnt(2) AND tx_byte_FSM_FFd1 AND bit_cnt(1) AND 
	bit_cnt(0) AND adv_q AND NOT ld_q)
	OR (bit_cnt(2) AND bit_cnt(1) AND tx_byte_FSM_FFd2 AND 
	bit_cnt(0) AND adv_q AND NOT ld_q));


bus_reg(7)/bus_reg(7)_TRST <= ((state_FSM_FFd3)
	OR (NOT state_FSM_FFd1 AND state_FSM_FFd2));

FTCPE_cap_run: FTCPE port map (cap_run,cap_run_T,clk,RST,'0');
cap_run_T <= ((NOT bit_cnt(2) AND cap_run AND NOT bit_cnt(1) AND NOT bit_cnt(0) AND 
	bit_cnt(3))
	OR (HOLD AND NOT cap_run AND state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT state_FSM_FFd3 AND NOT tx_byte_FSM_FFd1 AND 
	NOT tx_byte_FSM_FFd2 AND NOT WRn));

FTCPE_cnt0: FTCPE port map (cnt(0),cnt_T(0),clk,'0','0');
cnt_T(0) <= (NOT cnt(0) AND cnt(1) AND cnt(2));

FTCPE_cnt1: FTCPE port map (cnt(1),cnt_T(1),clk,'0','0');
cnt_T(1) <= ((NOT cnt(0) AND NOT cnt(1))
	OR (NOT cnt(0) AND NOT cnt(2)));

FDCPE_cnt2: FDCPE port map (cnt(2),cnt_D(2),clk,'0','0');
cnt_D(2) <= ((NOT cnt(1) AND cnt(2))
	OR (cnt(0) AND cnt(1) AND NOT cnt(2)));

FDCPE_col0: FDCPE port map (col0,col0_D,clk,RST,'0');
col0_D <= ((col0 AND NOT kbcol_q_or0000/kbcol_q_or0000_D2)
	OR (A(0).PIN AND kbcol_q_or0000/kbcol_q_or0000_D2));

FDCPE_col1: FDCPE port map (col1,col1_D,clk,RST,'0');
col1_D <= ((col1 AND NOT kbcol_q_or0000/kbcol_q_or0000_D2)
	OR (A(1).PIN AND kbcol_q_or0000/kbcol_q_or0000_D2));

FDCPE_col2: FDCPE port map (col2,col2_D,clk,RST,'0');
col2_D <= ((col2 AND NOT kbcol_q_or0000/kbcol_q_or0000_D2)
	OR (A(2).PIN AND kbcol_q_or0000/kbcol_q_or0000_D2));

FDCPE_col3: FDCPE port map (col3,col3_D,clk,RST,'0');
col3_D <= ((col3 AND NOT kbcol_q_or0000/kbcol_q_or0000_D2)
	OR (A(3).PIN AND kbcol_q_or0000/kbcol_q_or0000_D2));

FDCPE_dig0: FDCPE port map (dig(0),dig_D(0),clk,RST,'0');
dig_D(0) <= ((NOT A(0).PIN AND dig_q_or0000/dig_q_or0000_D2)
	OR (dig(0) AND NOT dig_q_or0000/dig_q_or0000_D2));

FDCPE_dig1: FDCPE port map (dig(1),dig_D(1),clk,RST,'0');
dig_D(1) <= ((NOT A(1).PIN AND dig_q_or0000/dig_q_or0000_D2)
	OR (dig(1) AND NOT dig_q_or0000/dig_q_or0000_D2));

FDCPE_dig2: FDCPE port map (dig(2),dig_D(2),clk,RST,'0');
dig_D(2) <= ((NOT A(2).PIN AND dig_q_or0000/dig_q_or0000_D2)
	OR (dig(2) AND NOT dig_q_or0000/dig_q_or0000_D2));

FDCPE_dig3: FDCPE port map (dig(3),dig_D(3),clk,RST,'0');
dig_D(3) <= ((NOT A(3).PIN AND dig_q_or0000/dig_q_or0000_D2)
	OR (dig(3) AND NOT dig_q_or0000/dig_q_or0000_D2));


dig_q_or0000/dig_q_or0000_D2 <= (IOM AND state_FSM_FFd1 AND state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND addr_latch(0) AND NOT addr_latch(1) AND NOT addr_latch(2) AND 
	NOT WRn);

FDCPE_hlda_q: FDCPE port map (hlda_q,HLDA,clk,RST,'0');


kbcol_q_or0000/kbcol_q_or0000_D2 <= (IOM AND state_FSM_FFd1 AND state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND NOT addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	NOT WRn);

FDCPE_ld_q: FDCPE port map (ld_q,ld_q_D,clk,RST,'0');
ld_q_D <= ((NOT bit_cnt(2) AND tx_byte_FSM_FFd1 AND NOT bit_cnt(1) AND 
	bit_cnt(0) AND bit_cnt(3) AND NOT baud_cnt(0) AND NOT baud_cnt(1) AND 
	baud_cnt(2) AND baud_cnt(3))
	OR (NOT bit_cnt(2) AND NOT bit_cnt(1) AND tx_byte_FSM_FFd2 AND 
	bit_cnt(0) AND bit_cnt(3) AND NOT baud_cnt(0) AND NOT baud_cnt(1) AND 
	baud_cnt(2) AND baud_cnt(3)));

FDCPE_por_run: FDCPE port map (por_run,por_sh(0),clk,'0','0');

FDCPE_por_sh0: FDCPE port map (por_sh(0),por_sh_D(0),clk,'0','0');
por_sh_D(0) <= ((x1_n AND por_sh(1))
	OR (NOT x1_n AND por_sh(0)));

FDCPE_por_sh1: FDCPE port map (por_sh(1),por_sh_D(1),clk,'0','0');
por_sh_D(1) <= ((x1_n AND por_sh(2))
	OR (NOT x1_n AND por_sh(1)));

FDCPE_por_sh2: FDCPE port map (por_sh(2),por_sh_D(2),clk,'0','0');
por_sh_D(2) <= ((x1_n AND por_sh(3))
	OR (NOT x1_n AND por_sh(2)));

FDCPE_por_sh3: FDCPE port map (por_sh(3),por_sh_D(3),clk,'0','0');
por_sh_D(3) <= (NOT x1_n AND por_sh(3));


rd_drive/rd_drive_D2 <= (state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	rd_seen AND NOT ALE AND NOT RDn);

FDCPE_rd_seen: FDCPE port map (rd_seen,rd_seen_D,clk,RST,'0');
rd_seen_D <= ((state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	wr_seen AND WRn AND NOT RDn)
	OR (NOT state_FSM_FFd1 AND rd_seen)
	OR (NOT state_FSM_FFd2 AND rd_seen)
	OR (state_FSM_FFd3 AND rd_seen)
	OR (rd_seen AND wr_seen AND WRn)
	OR (state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	NOT ALE AND NOT RDn));

FDCPE_seg0: FDCPE port map (seg(0),seg_D(0),clk,RST,'0');
seg_D(0) <= ((NOT A(0).PIN AND seg_q_or0000/seg_q_or0000_D2)
	OR (seg(0) AND NOT seg_q_or0000/seg_q_or0000_D2));

FDCPE_seg1: FDCPE port map (seg(1),seg_D(1),clk,RST,'0');
seg_D(1) <= ((NOT A(1).PIN AND seg_q_or0000/seg_q_or0000_D2)
	OR (seg(1) AND NOT seg_q_or0000/seg_q_or0000_D2));

FDCPE_seg2: FDCPE port map (seg(2),seg_D(2),clk,RST,'0');
seg_D(2) <= ((NOT A(2).PIN AND seg_q_or0000/seg_q_or0000_D2)
	OR (seg(2) AND NOT seg_q_or0000/seg_q_or0000_D2));

FDCPE_seg3: FDCPE port map (seg(3),seg_D(3),clk,RST,'0');
seg_D(3) <= ((NOT A(3).PIN AND seg_q_or0000/seg_q_or0000_D2)
	OR (seg(3) AND NOT seg_q_or0000/seg_q_or0000_D2));

FDCPE_seg4: FDCPE port map (seg(4),seg_D(4),clk,RST,'0');
seg_D(4) <= ((NOT A(4).PIN AND seg_q_or0000/seg_q_or0000_D2)
	OR (seg(4) AND NOT seg_q_or0000/seg_q_or0000_D2));

FDCPE_seg5: FDCPE port map (seg(5),seg_D(5),clk,RST,'0');
seg_D(5) <= ((NOT A(5).PIN AND seg_q_or0000/seg_q_or0000_D2)
	OR (seg(5) AND NOT seg_q_or0000/seg_q_or0000_D2));

FDCPE_seg6: FDCPE port map (seg(6),seg_D(6),clk,RST,'0');
seg_D(6) <= ((NOT A(6).PIN AND seg_q_or0000/seg_q_or0000_D2)
	OR (seg(6) AND NOT seg_q_or0000/seg_q_or0000_D2));

FDCPE_seg7: FDCPE port map (seg(7),seg_D(7),clk,RST,'0');
seg_D(7) <= ((NOT A(7).PIN AND seg_q_or0000/seg_q_or0000_D2)
	OR (seg(7) AND NOT seg_q_or0000/seg_q_or0000_D2));


seg_q_or0000/seg_q_or0000_D2 <= (IOM AND state_FSM_FFd1 AND state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND NOT addr_latch(0) AND NOT addr_latch(1) AND NOT addr_latch(2) AND 
	NOT WRn);

FDCPE_shreg0: FDCPE port map (shreg(0),shreg_D(0),clk,'0',RST);
shreg_D(0) <= ((shreg(0) AND shreg_and0000/shreg_and0000_D2)
	OR (shreg(1) AND NOT shreg_and0000/shreg_and0000_D2));

FDCPE_shreg1: FDCPE port map (shreg(1),shreg_D(1),clk,'0',RST);
shreg_D(1) <= ((shreg(1) AND shreg_and0000/shreg_and0000_D2)
	OR (shreg(2) AND NOT shreg_and0000/shreg_and0000_D2));

FDCPE_shreg2: FDCPE port map (shreg(2),shreg_D(2),clk,'0',RST);
shreg_D(2) <= ((shreg(2) AND shreg_and0000/shreg_and0000_D2)
	OR (shreg(3) AND NOT shreg_and0000/shreg_and0000_D2));

FDCPE_shreg3: FDCPE port map (shreg(3),shreg_D(3),clk,'0',RST);
shreg_D(3) <= ((shreg(3) AND shreg_and0000/shreg_and0000_D2)
	OR (shreg(4) AND NOT shreg_and0000/shreg_and0000_D2));

FDCPE_shreg4: FDCPE port map (shreg(4),shreg_D(4),clk,'0',RST);
shreg_D(4) <= ((shreg(4) AND shreg_and0000/shreg_and0000_D2)
	OR (shreg(5) AND NOT shreg_and0000/shreg_and0000_D2));

FDCPE_shreg5: FDCPE port map (shreg(5),shreg_D(5),clk,'0',RST);
shreg_D(5) <= ((shreg(5) AND shreg_and0000/shreg_and0000_D2)
	OR (shreg(6) AND NOT shreg_and0000/shreg_and0000_D2));

FDCPE_shreg6: FDCPE port map (shreg(6),shreg_D(6),clk,'0',RST);
shreg_D(6) <= ((shreg(6) AND shreg_and0000/shreg_and0000_D2)
	OR (shreg(7) AND NOT shreg_and0000/shreg_and0000_D2));

FDCPE_shreg7: FDCPE port map (shreg(7),shreg_D(7),clk,'0',RST);
shreg_D(7) <= ((shreg(7) AND shreg_and0000/shreg_and0000_D2)
	OR (shreg(8) AND NOT shreg_and0000/shreg_and0000_D2));


shreg_and0000/shreg_and0000_D2 <= ((NOT cap_run AND NOT adv_q)
	OR (NOT cap_run AND NOT tx_byte_FSM_FFd1 AND NOT tx_byte_FSM_FFd2));

FDCPE_state_FSM_FFd1: FDCPE port map (state_FSM_FFd1,state_FSM_FFd1_D,clk,RST,'0');
state_FSM_FFd1_D <= ((state_FSM_FFd1 AND NOT state_FSM_FFd3 AND NOT rd_seen AND NOT ALE AND 
	NOT wr_seen)
	OR (state_FSM_FFd1 AND NOT state_FSM_FFd3 AND NOT rd_seen AND NOT ALE AND 
	NOT WRn)
	OR (NOT IOM AND A15 AND state_FSM_FFd1 AND NOT state_FSM_FFd3 AND 
	wr_seen AND WRn AND NOT por_run)
	OR (state_FSM_FFd1 AND NOT state_FSM_FFd2)
	OR (NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND ALE)
	OR (state_FSM_FFd1 AND NOT state_FSM_FFd3 AND NOT ALE AND NOT wr_seen AND 
	NOT RDn)
	OR (state_FSM_FFd1 AND NOT state_FSM_FFd3 AND NOT ALE AND NOT WRn AND 
	NOT RDn));

FDCPE_state_FSM_FFd2: FDCPE port map (state_FSM_FFd2,state_FSM_FFd2_D,clk,RST,'0');
state_FSM_FFd2_D <= ((NOT state_FSM_FFd1 AND NOT state_FSM_FFd3)
	OR (NOT state_FSM_FFd3 AND ALE)
	OR (state_FSM_FFd1 AND state_FSM_FFd2 AND state_FSM_FFd3)
	OR (state_FSM_FFd2 AND NOT state_FSM_FFd3 AND rd_seen AND RDn)
	OR (state_FSM_FFd2 AND NOT state_FSM_FFd3 AND wr_seen AND WRn));

FTCPE_state_FSM_FFd3: FTCPE port map (state_FSM_FFd3,state_FSM_FFd3_T,clk,RST,'0');
state_FSM_FFd3_T <= ((NOT state_FSM_FFd1 AND NOT state_FSM_FFd2 AND state_FSM_FFd3)
	OR (NOT IOM AND A15 AND state_FSM_FFd1 AND state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND wr_seen AND WRn AND NOT por_run));

FTCPE_tx_byte_FSM_FFd1: FTCPE port map (tx_byte_FSM_FFd1,tx_byte_FSM_FFd1_T,clk,RST,'0');
tx_byte_FSM_FFd1_T <= ((NOT cap_run AND tx_byte_FSM_FFd1 AND NOT tx_byte_FSM_FFd2 AND 
	ld_q)
	OR (NOT cap_run AND NOT tx_byte_FSM_FFd1 AND tx_byte_FSM_FFd2 AND 
	ld_q)
	OR (NOT bit_cnt(2) AND cap_run AND tx_byte_FSM_FFd1 AND 
	NOT bit_cnt(1) AND NOT bit_cnt(0) AND bit_cnt(3)));

FTCPE_tx_byte_FSM_FFd2: FTCPE port map (tx_byte_FSM_FFd2,tx_byte_FSM_FFd2_T,clk,RST,'0');
