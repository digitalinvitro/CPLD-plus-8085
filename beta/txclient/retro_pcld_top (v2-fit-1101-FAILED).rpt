	FC_11_.OUT);


$OpTx$FX_SC$161 <= ((NOT baud_cnt(3) AND NOT por_run AND NOT RST)
	OR (NOT tx_byte_FSM_FFd1 AND NOT tx_byte_FSM_FFd2 AND NOT por_run AND 
	NOT RST)
	OR (bit_cnt(0) AND NOT bit_cnt(1) AND NOT bit_cnt(2) AND 
