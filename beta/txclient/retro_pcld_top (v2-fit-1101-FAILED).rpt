********** Mapped Logic **********


$OpTx$FX_DC$1504 <= (NOT por_run AND NOT RST);


$OpTx$FX_DC$1515 <= FC_17_.OUT;


$OpTx$FX_DC$1517.LFBK <= (NOT baud_cnt(0) AND NOT baud_cnt(1) AND baud_cnt(2) AND 
	baud_cnt(3));


$OpTx$FX_DC$192 <= ((por_run)
	OR (NOT WRn AND HOLD AND NOT tx_byte_FSM_FFd1 AND 
	NOT tx_byte_FSM_FFd2 AND state_FSM_FFd1 AND FC_10_.OUT)
	OR (tx_byte_FSM_FFd1 AND NOT baud_cnt(0) AND NOT baud_cnt(1) AND 
