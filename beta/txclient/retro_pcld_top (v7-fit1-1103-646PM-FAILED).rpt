FDCPE_wr_seen: FDCPE port map (wr_seen,wr_seen_D,clk,RST,'0');
wr_seen_D <= ((NOT state_FSM_FFd1 AND wr_seen)
	OR (NOT state_FSM_FFd2 AND wr_seen)
	OR (state_FSM_FFd3 AND wr_seen)
	OR (state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	NOT ALE AND NOT WRn)
