*******************************  Equations  ********************************

********** Mapped Logic **********


$OpTx$FX_SC$200 <= ((state_FSM_FFd1 AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	ALE)
	OR (NOT tx_byte_FSM_FFd1 AND tx_byte_FSM_FFd2 AND bit_cnt(3) AND 
	adv_q)
	OR (NOT tx_byte_FSM_FFd1 AND tx_byte_FSM_FFd2 AND adv_q AND 
	NOT FC_8_.OUT));


$OpTx$FX_SC$204 <= ((tx_byte_FSM_FFd1)
	OR (NOT tx_byte_FSM_FFd2)
	OR (NOT adv_q)
	OR (NOT bit_cnt(3) AND FC_8_.OUT)
	OR (state_FSM_FFd1 AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	ALE));


$OpTx$FX_SC$205 <= ((NOT FC_3_.OUT)
	OR (FC_4_.OUT)
	OR (state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	NOT WRn));


A_I(0) <= ((D(0) AND addr_latch(2) AND rd_drive/rd_drive_D2)
	OR (IOM AND addr_latch(0) AND addr_latch(1) AND 
	NOT addr_latch(2) AND row0)
	OR (addr_latch(0) AND NOT rd_drive/rd_drive_D2)
	OR (D(0) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (D(0) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (D(0) AND NOT addr_latch(1) AND rd_drive/rd_drive_D2));
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(1) <= ((D(1) AND addr_latch(2) AND rd_drive/rd_drive_D2)
	OR (IOM AND addr_latch(0) AND addr_latch(1) AND 
	NOT addr_latch(2) AND row1)
	OR (addr_latch(1) AND NOT rd_drive/rd_drive_D2)
	OR (D(1) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (D(1) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (D(1) AND NOT addr_latch(1) AND rd_drive/rd_drive_D2));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
A_OE(1) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(2) <= ((IOM AND addr_latch(0) AND addr_latch(1) AND 
	NOT addr_latch(2) AND row2 AND rd_drive/rd_drive_D2)
	OR (D(2) AND addr_latch(2))
	OR (addr_latch(2) AND NOT rd_drive/rd_drive_D2)
	OR (D(2) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (D(2) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (D(2) AND NOT addr_latch(1) AND rd_drive/rd_drive_D2));
A(2) <= A_I(2) when A_OE(2) = '1' else 'Z';
A_OE(2) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(3) <= ((D(3) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (D(3) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (D(3) AND NOT addr_latch(1) AND rd_drive/rd_drive_D2)
	OR (IOM AND addr_latch(0) AND addr_latch(1) AND 
	NOT addr_latch(2) AND row3 AND rd_drive/rd_drive_D2)
	OR (addr_latch(3) AND NOT rd_drive/rd_drive_D2)
	OR (D(3) AND addr_latch(2) AND rd_drive/rd_drive_D2));
A(3) <= A_I(3) when A_OE(3) = '1' else 'Z';
A_OE(3) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(4) <= ((D(4) AND NOT addr_latch(1) AND rd_drive/rd_drive_D2)
	OR (IOM AND addr_latch(0) AND addr_latch(1) AND 
	NOT addr_latch(2) AND row4 AND rd_drive/rd_drive_D2)
	OR (addr_latch(4) AND NOT rd_drive/rd_drive_D2)
	OR (D(4) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (D(4) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (D(4) AND addr_latch(2) AND rd_drive/rd_drive_D2));
A(4) <= A_I(4) when A_OE(4) = '1' else 'Z';
A_OE(4) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(5) <= NOT (((NOT D(5) AND rd_drive/rd_drive_D2)
	OR (NOT addr_latch(5) AND NOT rd_drive/rd_drive_D2)
	OR (IOM AND addr_latch(0) AND addr_latch(1) AND 
	NOT addr_latch(2) AND rd_drive/rd_drive_D2)));
A(5) <= A_I(5) when A_OE(5) = '1' else 'Z';
A_OE(5) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(6) <= NOT (((NOT D(6) AND rd_drive/rd_drive_D2)
	OR (NOT addr_latch(6) AND NOT rd_drive/rd_drive_D2)
	OR (IOM AND addr_latch(0) AND addr_latch(1) AND 
	NOT addr_latch(2) AND rd_drive/rd_drive_D2)));
A(6) <= A_I(6) when A_OE(6) = '1' else 'Z';
A_OE(6) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(7) <= NOT (((NOT D(7) AND rd_drive/rd_drive_D2)
	OR (NOT addr_latch(7) AND NOT rd_drive/rd_drive_D2)
	OR (IOM AND addr_latch(0) AND addr_latch(1) AND 
	NOT addr_latch(2) AND rd_drive/rd_drive_D2)));
A(7) <= A_I(7) when A_OE(7) = '1' else 'Z';
A_OE(7) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_7_IOBUFE/A_7_IOBUFE_TRST <= (NOT bus_reg(7)/bus_reg(7)_TRST AND NOT rd_drive/rd_drive_D2);


CS1 <= '1';


CS_n <= NOT (((bus_reg(7)/bus_reg(7)_TRST)
	OR (NOT IOM AND A15 AND FC_0_.OUT)));


CSr_n <= NOT ((NOT IOM AND NOT A15 AND FC_0_.OUT));


D_I(0) <= D(0)_BUFR;
D(0) <= D_I(0) when D_OE(0) = '1' else 'Z';
D_OE(0) <= bus_reg(7)/bus_reg(7)_TRST;


D_I(1) <= D(1)_BUFR;
D(1) <= D_I(1) when D_OE(1) = '1' else 'Z';
D_OE(1) <= bus_reg(7)/bus_reg(7)_TRST;


D_I(2) <= D(2)_BUFR;
D(2) <= D_I(2) when D_OE(2) = '1' else 'Z';
D_OE(2) <= bus_reg(7)/bus_reg(7)_TRST;


D_I(3) <= D(3)_BUFR;
D(3) <= D_I(3) when D_OE(3) = '1' else 'Z';
D_OE(3) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D4_BUFR: FDCPE port map (D(4)_BUFR,D_D(4)_BUFR,clk,RST,'0');
D_D(4)_BUFR <= ((FC_10_.OUT)
	OR (FC_11_.OUT)
