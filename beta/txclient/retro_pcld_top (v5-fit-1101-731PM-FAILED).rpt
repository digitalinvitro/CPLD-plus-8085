*******************************  Equations  ********************************

********** Mapped Logic **********


$OpTx$FX_DC$1713.LFBK <= ((D(2) AND NOT bit_cnt(1) AND tx_byte_FSM_FFd1)
	OR (D(4) AND bit_cnt(1) AND tx_byte_FSM_FFd1)
	OR (bit_cnt(1) AND NOT tx_byte_FSM_FFd1 AND addr_latch(4))
	OR (NOT bit_cnt(1) AND NOT tx_byte_FSM_FFd1 AND addr_latch(2)));


$OpTx$FX_DC$1716 <= ((D(1) AND tx_byte_FSM_FFd1)
	OR (NOT tx_byte_FSM_FFd1 AND tx_byte_FSM_FFd2 AND 
	addr_latch(1)));


$OpTx$FX_DC$1717.LFBK <= ((D(5) AND tx_byte_FSM_FFd1)
	OR (NOT tx_byte_FSM_FFd1 AND tx_byte_FSM_FFd2 AND 
	addr_latch(5)));


$OpTx$FX_DC$1719 <= ((D(7) AND tx_byte_FSM_FFd1)
	OR (NOT tx_byte_FSM_FFd1 AND tx_byte_FSM_FFd2 AND 
	addr_latch(7)));


$OpTx$FX_DC$1723.LFBK <= ((bit_cnt(1) AND bit_cnt(2) AND AH13)
	OR (bit_cnt(1) AND NOT bit_cnt(2) AND AH9)
	OR (NOT bit_cnt(1) AND bit_cnt(2) AND AH11));


A_I(0) <= ((addr_latch(0) AND RDn)
	OR (addr_latch(0) AND bus_reg(7)/bus_reg(7)_TRST)
	OR (D(0) AND addr_latch(0) AND NOT addr_latch(1))
	OR (D(0) AND addr_latch(0) AND addr_latch(2))
	OR (IOM AND addr_latch(0) AND addr_latch(1) AND 
	NOT addr_latch(2) AND row0)
	OR (ALE AND addr_latch(0))
	OR (NOT state_FSM_FFd2 AND addr_latch(0))
	OR (addr_latch(0) AND NOT rd_seen)
	OR (D(0) AND NOT IOM AND addr_latch(0))
	OR (D(0) AND NOT ALE AND state_FSM_FFd2 AND NOT addr_latch(0) AND 
	rd_seen AND NOT RDn AND NOT bus_reg(7)/bus_reg(7)_TRST));
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(1) <= ((D(1) AND NOT addr_latch(0) AND addr_latch(1))
	OR (D(1) AND addr_latch(1) AND addr_latch(2))
	OR (IOM AND addr_latch(0) AND addr_latch(1) AND 
	NOT addr_latch(2) AND row1)
	OR (ALE AND addr_latch(1))
	OR (addr_latch(1) AND RDn)
	OR (addr_latch(1) AND bus_reg(7)/bus_reg(7)_TRST)
	OR (NOT state_FSM_FFd2 AND addr_latch(1))
	OR (addr_latch(1) AND NOT rd_seen)
	OR (D(1) AND NOT IOM AND addr_latch(1))
	OR (D(1) AND NOT ALE AND state_FSM_FFd2 AND NOT addr_latch(1) AND 
	rd_seen AND NOT RDn AND NOT bus_reg(7)/bus_reg(7)_TRST));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
A_OE(1) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(2) <= (($OpTx$FX_DC$1719.EXP)
	OR (ALE AND addr_latch(2))
	OR (addr_latch(2) AND RDn)
	OR (addr_latch(2) AND bus_reg(7)/bus_reg(7)_TRST)
	OR (D(2) AND NOT IOM AND NOT ALE AND state_FSM_FFd2 AND rd_seen AND 
	NOT RDn AND NOT bus_reg(7)/bus_reg(7)_TRST)
	OR (D(2) AND NOT ALE AND state_FSM_FFd2 AND NOT addr_latch(0) AND 
	rd_seen AND NOT RDn AND NOT bus_reg(7)/bus_reg(7)_TRST)
	OR (D(2) AND addr_latch(2))
	OR (NOT state_FSM_FFd2 AND addr_latch(2))
	OR (addr_latch(2) AND NOT rd_seen));
A(2) <= A_I(2) when A_OE(2) = '1' else 'Z';
A_OE(2) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(3) <= A(3)_BUFR;
A(3) <= A_I(3) when A_OE(3) = '1' else 'Z';
A_OE(3) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(4) <= A(4)_BUFR;
A(4) <= A_I(4) when A_OE(4) = '1' else 'Z';
A_OE(4) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(5) <= NOT (((NOT addr_latch(5) AND RDn)
	OR (NOT addr_latch(5) AND bus_reg(7)/bus_reg(7)_TRST)
	OR (NOT D(5) AND NOT ALE AND state_FSM_FFd2 AND rd_seen AND NOT RDn AND 
	NOT bus_reg(7)/bus_reg(7)_TRST)
	OR (IOM AND NOT ALE AND state_FSM_FFd2 AND addr_latch(0) AND 
	addr_latch(1) AND NOT addr_latch(2) AND rd_seen AND NOT RDn AND 
	NOT bus_reg(7)/bus_reg(7)_TRST)
	OR (ALE AND NOT addr_latch(5))
	OR (NOT state_FSM_FFd2 AND NOT addr_latch(5))
	OR (NOT addr_latch(5) AND NOT rd_seen)));
A(5) <= A_I(5) when A_OE(5) = '1' else 'Z';
A_OE(5) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(6) <= NOT (((NOT addr_latch(6) AND bus_reg(7)/bus_reg(7)_TRST)
	OR (NOT D(6) AND NOT ALE AND state_FSM_FFd2 AND rd_seen AND NOT RDn AND 
	NOT bus_reg(7)/bus_reg(7)_TRST)
	OR (IOM AND NOT ALE AND state_FSM_FFd2 AND addr_latch(0) AND 
	addr_latch(1) AND NOT addr_latch(2) AND rd_seen AND NOT RDn AND 
	NOT bus_reg(7)/bus_reg(7)_TRST)
	OR (ALE AND NOT addr_latch(6))
	OR (NOT state_FSM_FFd2 AND NOT addr_latch(6))
	OR (NOT addr_latch(6) AND NOT rd_seen)
	OR (NOT addr_latch(6) AND RDn)));
A(6) <= A_I(6) when A_OE(6) = '1' else 'Z';
A_OE(6) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(7) <= NOT (((NOT addr_latch(7) AND RDn)
	OR (NOT addr_latch(7) AND bus_reg(7)/bus_reg(7)_TRST)
	OR (NOT D(7) AND NOT ALE AND state_FSM_FFd2 AND rd_seen AND NOT RDn AND 
	NOT bus_reg(7)/bus_reg(7)_TRST)
	OR (IOM AND NOT ALE AND state_FSM_FFd2 AND addr_latch(0) AND 
	addr_latch(1) AND NOT addr_latch(2) AND rd_seen AND NOT RDn AND 
	NOT bus_reg(7)/bus_reg(7)_TRST)
	OR (ALE AND NOT addr_latch(7))
	OR (NOT state_FSM_FFd2 AND NOT addr_latch(7))
	OR (NOT addr_latch(7) AND NOT rd_seen)));
A(7) <= A_I(7) when A_OE(7) = '1' else 'Z';
A_OE(7) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_7_IOBUFE/A_7_IOBUFE_TRST <= ((bus_reg(7)/bus_reg(7)_TRST)
	OR (NOT ALE AND state_FSM_FFd2 AND rd_seen AND NOT RDn));


CS1 <= '1';


CS_n <= NOT (((bus_reg(7)/bus_reg(7)_TRST)
	OR (NOT IOM AND A15 AND FC_0_.OUT)));


CSr_n <= NOT ((NOT IOM AND NOT A15 AND FC_0_.OUT));

FTCPE_D0: FTCPE port map (D_I(0),D_T(0),clk,'0','0');
D_T(0) <= ((NOT D(0) AND NOT WRn AND state_FSM_FFd1 AND state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND A(0).PIN AND NOT por_run AND NOT RST)
	OR (NOT D(0) AND NOT IOM AND ALE AND state_FSM_FFd1 AND 
	NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND D(0).PIN AND NOT por_run AND NOT RST)
	OR (D(0) AND por_run)
	OR (D(0) AND RST)
