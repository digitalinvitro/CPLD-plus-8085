    1            ; =====================================================================
    2            ; beta/01_timer -- ТЕСТ-ПРОШИВКА ПЗУ: проверка интервального таймера
    3            ; (CPLD beta v3.3b3, порт 04h -> RST 7.5) звуком и миганием сегмента.
    4            ;
    5            ; Файл в кодировке CP1251 (как все исходники проекта, кроме asm85.py).
    6            ;
    7            ; Сборка (из этой папки):
    8            ;   python3 asm85.py timer_test.asm -o timer_test_tone.hex  -l timer_test_tone.lst
    9            ;   python3 asm85.py timer_test.asm -o timer_test_blink.hex -l timer_test_blink.lst -D TONE=0
   10            ;
   11            ; Железо: retro_PCLD_board V2 + CPLD beta/01_timer v3.3b3 (фит 10-22 22:04).
   12            ; Прошивается ВМЕСТО монитора fw_mon, с нулевого смещения flash A29040B
   13            ; (видимое окно 0000h-7FFFh). После теста вернуть монитор.
   14            ;
   15            ; ИСТОРИЯ: v2 (текущая) -- из ISR убраны PUSH B/POP B. В v1 они каждую
   16            ;   квитанцию восстанавливали исходные KB:KA, счётчик мигания B:C не жил
   17            ;   между прерываниями и никогда не досчитывал до нуля -> 'g' не мигал
   18            ;   (горели постоянные g+dp), а тон работал (ветка тона B:C не трогает).
   19            ;
   20            ; ЧТО ДЕЛАЕТ (см. подробную таблицу диагностики в beta/01_timer/README.md):
   21            ;   N = 20: период прерываний = 20 x 51,2 мкс = 1,024 мс (+ ~40 мкс
   22            ;   накладных на вход в ISR и ре-арм -- это нормально и учтено в расчёте).
   23            ;   TONE=1: каждое прерывание инвертирует бит D4 (SND) порта 01h -> зуммер
   24            ;   даёт тон около 470 Гц (идеальные 488 Гц минус накладные ISR).
   25            ;   BLINK=1: каждые 464 прерывания инвертируется сегмент 'g' (D6) -> мигание
   26            ;   раз в ~0,5 с (полный цикл ~1 с); dp горит постоянно как маячок дисплея.
   27            ;
   28            ; ОТВЕТ НА ВОПРОС "ЗВУК ИЛИ СЕГМЕНТ": звук -- показательнее (сотни
   29            ;   прерываний/с, любой сбой слышен мгновенно, кратность кванта видна по
   30            ;   высоте тона), мигание -- удобнее как фоновый визуальный контроль.
   31            ;   Основной hex делает ОБА; тихий вариант: -D TONE=0.
   32            ;
   33            ; ДИАГНОСТИКА:
   34            ;   тон + мигание ~1 Гц      -> таймер, RST 7.5, ре-арм: ПАСС
   35            ;   тишина, но мигает        -> таймер ОК; смотреть цепь SND/излучатель
   36            ;   тон вдвое ниже (~230 Гц) -> квант 102,4 мкс вместо 51,2 (дефект HDL)
   37            ;   тон есть, горят g+dp,
   38            ;   мигания НЕТ (v1)         -> PUSH B/POP B затирали счётчик мигания;
   39            ;                               исправлено в v2 -- перепрошить заново
   40            ;   тишина и горит "8."      -> программа не стартует (ПЗУ/шина/CPLD)
   41            ; =====================================================================
   42            
   43            ; ---- параметры (можно переопределить ключами -D) ----
   44            TMR_N   EQU 20              ; период: 20 x 51,2 мкс = 1,024 мс (1..255)
   45            TONE    EQU 1               ; 1 = зуммер тикает каждое прерывание
   46            BLINK   EQU 1               ; 1 = мигание 'g' каждые KA*KB прерываний
   47            
   48            ; ---- порты и переменные ----
   49            SEGP    EQU 00h             ; порт SEG:  D0=a..D6=g, D7=dp (1 = горит в регистре)
   50            DIGP    EQU 01h             ; порт DIG/SND: D3-D0 разряды, D4=SND (меандр!)
   51            TMRP    EQU 04h             ; порт таймера: запись N (T = N x 51,2 мкс)
   52            SIMW    EQU 1Bh             ; SIM: MSE=1 -- маскировать 5.5/6.5, РАЗРЕШИТЬ 7.5;
   53                                        ; R7.5=1 -- латч СБРОШЕН (гасим возможный фронт от
   54                                        ; INIT-пробега FFh->0 за ~13 мс; до EI ложных
   55                                        ; фронтов и так нет -- инициализация много быстрее)
   56            KA      EQU 116             ; мигание: 116 x 4 = 464 прерывания ~ 0,5 с
   57            KB      EQU 4
   58            SEGST   EQU 8000h           ; ОЗУ: копия регистра SEG (для инверсии битов)
   59            DIGST   EQU 8001h           ; ОЗУ: копия регистра DIG/SND
   60            
   61            ; ---- векторы ----
   62  0000: -                ORG 0000h
   63  0000: C3 80 00         JMP MAIN            ; сброс: переход на инициализацию
   64  003C: -                ORG 003Ch
   65  003C: C3 40 00         JMP ISR             ; вектор RST 7.5 = 003Ch
   66            
   67            ; ---- ISR: тон + мигание + РЕ-АРМ (обязателен! автоперезагрузки нет) ----
   68            ; ВАЖНО (урок v2): B:C НЕ сохраняем! Счётчик мигания ОБЯЗАН жить между
   69            ; прерываниями, а PUSH B/POP B в v1 возвращали ему исходные KB:KA.
   70            ; Вложенных прерываний нет: 8085 запрещает IE на входе в ISR, EI только
   71            ; в конце. ISR портит только A и флаги -> сохраняем один PSW.
   72  0040: -                ORG 0040h
   73  0040: F5       ISR:    PUSH PSW
   74                    IF TONE
   75                    LDA DIGST           ; инверсия D4 (SND) в копии и в порту:
   76                    XRI 10h             ; меандр с полупериодом = периоду прерываний
   77                    STA DIGST
   78                    OUT DIGP
   79                    ENDIF
   80                    IF BLINK
   81  0041: 0D               DCR C               ; каскадный счётчик мигания B:C (B=KB, C=KA)
   82  0042: C2 57 00         JNZ TMRGO
   83  0045: 0E 74            MVI C,KA
   84  0047: 05               DCR B
   85  0048: C2 57 00         JNZ TMRGO
   86  004B: 06 04            MVI B,KB
   87  004D: 3A 00 80         LDA SEGST           ; инверсия сегмента 'g' (D6) в копии и в порту
   88  0050: EE 40            XRI 40h
   89  0052: 32 00 80         STA SEGST
   90  0055: D3 00            OUT SEGP
   91                    ENDIF
   92  0057: 3E 14    TMRGO:  MVI A,TMR_N         ; РЕ-АРМ: счётчик стоит в нуле, загружаем N заново
   93  0059: D3 04            OUT TMRP
   94  005B: F1               POP PSW
   95  005C: FB               EI
   96  005D: C9               RET
   97            
   98            ; ---- MAIN: инициализация и сон до прерываний ----
   99  0080: -                ORG 0080h
  100  0080: 31 FF FF MAIN:   LXI SP,0FFFFh       ; стек -- верх ОЗУ (8000h-FFFFh)
  101  0083: 3E C0            MVI A,0C0h          ; сегменты: 'g' + dp (мигает 'g', dp -- маячок)
  102  0085: 32 00 80         STA SEGST
  103  0088: D3 00            OUT SEGP
  104  008A: 3E 0F            MVI A,0Fh           ; все 4 разряда статически; нагрузка меньше INIT "8."
  105  008C: 32 01 80         STA DIGST           ; (SND=0 -- тишина до первого прерывания)
  106  008F: D3 01            OUT DIGP
  107  0091: 01 74 04         LXI B,KB*256+KA     ; счётчик мигания: B=KB=4, C=KA=116
  108  0094: 3E 14            MVI A,TMR_N
  109  0096: D3 04            OUT TMRP            ; загрузить N и запустить (1-е прерывание ~1 мс)
  110  0098: 3E 1B            MVI A,SIMW
  111  009A: 30               SIM                 ; RST 7.5 разрешён, 5.5/6.5 маскированы, латч сброшен
  112  009B: FB               EI
  113  009C: 76       HLTLP:  HLT                 ; спим: таймер будит процессор каждые ~1,07 мс
  114  009D: C3 9C 00         JMP HLTLP
  115  00A0: -                END
