    1            ; =====================================================================
    2            ; beta/01_timer -- ТЕСТ-ПРОШИВКА ПЗУ: проверка интервального таймера
    3            ; (CPLD beta v3.3b3, порт 04h -> RST 7.5) звуком и миганием сегмента.
    4            ;
    5            ; Файл в кодировке CP1251 (как все исходники проекта, кроме asm85.py).
    6            ;
    7            ; Сборка (из этой папки):
    8            ;   python3 asm85.py timer_test.asm -o timer_test_tone.hex  -l timer_test_tone.lst
    9            ;   python3 asm85.py timer_test.asm -o timer_test_blink.hex -l timer_test_blink.lst -D TONE=0
   10            ;
   11            ; Железо: retro_PCLD_board V2 + CPLD beta/01_timer v3.3b3 (фит 10-22 22:04).
   12            ; Прошивается ВМЕСТО монитора fw_mon, с нулевого смещения flash A29040B
   13            ; (видимое окно 0000h-7FFFh). После теста вернуть монитор.
   14            ;
   15            ; ИСТОРИЯ: v2 (текущая) -- из ISR убраны PUSH B/POP B. В v1 они каждую
   16            ;   квитанцию восстанавливали исходные KB:KA, счётчик мигания B:C не жил
   17            ;   между прерываниями и никогда не досчитывал до нуля -> 'g' не мигал
   18            ;   (горели постоянные g+dp), а тон работал (ветка тона B:C не трогает).
   19            ;
   20            ; ЧТО ДЕЛАЕТ (см. подробную таблицу диагностики в beta/01_timer/README.md):
   21            ;   N = 20: период прерываний = 20 x 51,2 мкс = 1,024 мс (+ ~40 мкс
   22            ;   накладных на вход в ISR и ре-арм -- это нормально и учтено в расчёте).
   23            ;   TONE=1: каждое прерывание инвертирует бит D4 (SND) порта 01h -> зуммер
   24            ;   даёт тон около 470 Гц (идеальные 488 Гц минус накладные ISR).
   25            ;   BLINK=1: каждые 464 прерывания инвертируется сегмент 'g' (D6) -> мигание
   26            ;   раз в ~0,5 с (полный цикл ~1 с); dp горит постоянно как маячок дисплея.
   27            ;
   28            ; ОТВЕТ НА ВОПРОС "ЗВУК ИЛИ СЕГМЕНТ": звук -- показательнее (сотни
   29            ;   прерываний/с, любой сбой слышен мгновенно, кратность кванта видна по
   30            ;   высоте тона), мигание -- удобнее как фоновый визуальный контроль.
   31            ;   Основной hex делает ОБА; тихий вариант: -D TONE=0.
   32            ;
   33            ; ДИАГНОСТИКА:
   34            ;   тон + мигание ~1 Гц      -> таймер, RST 7.5, ре-арм: ПАСС
   35            ;   тишина, но мигает        -> таймер ОК; смотреть цепь SND/излучатель
   36            ;   тон вдвое ниже (~230 Гц) -> квант 102,4 мкс вместо 51,2 (дефект HDL)
   37            ;   тон есть, горят g+dp,
   38            ;   мигания НЕТ (v1)         -> PUSH B/POP B затирали счётчик мигания;
   39            ;                               исправлено в v2 -- перепрошить заново
   40            ;   тишина и горит "8."      -> программа не стартует (ПЗУ/шина/CPLD)
   41            ; =====================================================================
   42            
   43            ; ---- параметры (можно переопределить ключами -D) ----
   44            TMR_N   EQU 20              ; период: 20 x 51,2 мкс = 1,024 мс (1..255)
   45            TONE    EQU 1               ; 1 = зуммер тикает каждое прерывание
   46            BLINK   EQU 1               ; 1 = мигание 'g' каждые KA*KB прерываний
   47            
   48            ; ---- порты и переменные ----
   49            SEGP    EQU 00h             ; порт SEG:  D0=a..D6=g, D7=dp (1 = горит в регистре)
   50            DIGP    EQU 01h             ; порт DIG/SND: D3-D0 разряды, D4=SND (меандр!)
   51            TMRP    EQU 04h             ; порт таймера: запись N (T = N x 51,2 мкс)
   52            SIMW    EQU 1Bh             ; SIM: маскировать 5.5/6.5, РАЗРЕШИТЬ 7.5 (бит R7.5=0:
   53                                        ; латч не трогаем -- ложных фронтов до EI нет)
   54            KA      EQU 116             ; мигание: 116 x 4 = 464 прерывания ~ 0,5 с
   55            KB      EQU 4
   56            SEGST   EQU 8000h           ; ОЗУ: копия регистра SEG (для инверсии битов)
   57            DIGST   EQU 8001h           ; ОЗУ: копия регистра DIG/SND
   58            
   59            ; ---- векторы ----
   60  0000: -                ORG 0000h
   61  0000: C3 80 00         JMP MAIN            ; сброс: переход на инициализацию
   62  003C: -                ORG 003Ch
   63  003C: C3 40 00         JMP ISR             ; вектор RST 7.5 = 003Ch
   64            
   65            ; ---- ISR: тон + мигание + РЕ-АРМ (обязателен! автоперезагрузки нет) ----
   66            ; ВАЖНО (урок v2): B:C НЕ сохраняем! Счётчик мигания ОБЯЗАН жить между
   67            ; прерываниями, а PUSH B/POP B в v1 возвращали ему исходные KB:KA.
   68            ; Вложенных прерываний нет: 8085 запрещает IE на входе в ISR, EI только
   69            ; в конце. ISR портит только A и флаги -> сохраняем один PSW.
   70  0040: -                ORG 0040h
   71  0040: F5       ISR:    PUSH PSW
   72                    IF TONE
   73                    LDA DIGST           ; инверсия D4 (SND) в копии и в порту:
   74                    XRI 10h             ; меандр с полупериодом = периоду прерываний
   75                    STA DIGST
   76                    OUT DIGP
   77                    ENDIF
   78                    IF BLINK
   79  0041: 0D               DCR C               ; каскадный счётчик мигания B:C (B=KB, C=KA)
   80  0042: C2 57 00         JNZ TMRGO
   81  0045: 0E 74            MVI C,KA
   82  0047: 05               DCR B
   83  0048: C2 57 00         JNZ TMRGO
   84  004B: 06 04            MVI B,KB
   85  004D: 3A 00 80         LDA SEGST           ; инверсия сегмента 'g' (D6) в копии и в порту
   86  0050: EE 40            XRI 40h
   87  0052: 32 00 80         STA SEGST
   88  0055: D3 00            OUT SEGP
   89                    ENDIF
   90  0057: 3E 14    TMRGO:  MVI A,TMR_N         ; РЕ-АРМ: счётчик стоит в нуле, загружаем N заново
   91  0059: D3 04            OUT TMRP
   92  005B: F1               POP PSW
   93  005C: FB               EI
   94  005D: C9               RET
   95            
   96            ; ---- MAIN: инициализация и сон до прерываний ----
   97  0080: -                ORG 0080h
   98  0080: 31 FF FF MAIN:   LXI SP,0FFFFh       ; стек -- верх ОЗУ (8000h-FFFFh)
   99  0083: 3E C0            MVI A,0C0h          ; сегменты: 'g' + dp (мигает 'g', dp -- маячок)
  100  0085: 32 00 80         STA SEGST
  101  0088: D3 00            OUT SEGP
  102  008A: 3E 0F            MVI A,0Fh           ; все 4 разряда статически; нагрузка меньше INIT "8."
  103  008C: 32 01 80         STA DIGST           ; (SND=0 -- тишина до первого прерывания)
  104  008F: D3 01            OUT DIGP
  105  0091: 01 74 04         LXI B,KB*256+KA     ; счётчик мигания: B=KB=4, C=KA=116
  106  0094: 3E 14            MVI A,TMR_N
  107  0096: D3 04            OUT TMRP            ; загрузить N и запустить (1-е прерывание ~1 мс)
  108  0098: 3E 1B            MVI A,SIMW
  109  009A: 30               SIM                 ; RST 7.5 разрешён, 5.5/6.5 маскированы, латч не тронут
  110  009B: FB               EI
  111  009C: 76       HLTLP:  HLT                 ; спим: таймер будит процессор каждые ~1,07 мс
  112  009D: C3 9C 00         JMP HLTLP
  113  00A0: -                END
