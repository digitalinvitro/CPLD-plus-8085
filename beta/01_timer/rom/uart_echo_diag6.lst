    1            ; =====================================================================
    2            ; beta/01_timer -- ДИАГНОСТИКА ВЕРСИЯ 6: «МОНИТОР SID»
    3            ; (последний дискриминатор после ПАССА diag5, cont-echo-16).
    4            ; Интервальный таймер CPLD (beta v3.3b3, порт 04h -> RST 7.5),
    5            ; 2400 бод (TMR_N=8), 8N1.
    6            ;
    7            ; ПОСТАНОВКА. Результат diag5 на железе 26-10: поток '>' каждые
    8            ; ~70-150 мс + счётчик кадров на DIG0 -- исход N1 из таблицы:
    9            ; TX-тракт ЦЕЛ (8085 SIM/SOD -> CPLD P72/P39 -> CH340G -> терминал).
   10            ; Остался ровно один неизвестный: УРОВЕНЬ НА SID (RX-вход, U3.5,
   11            ; CPLD P73 <- транзит RX P38 <- провод «TX» CH340G.TXD).
   12            ; Факт diag4: при SID=0 цикл POLL ловит «старт-бит» на каждом
   13            ; проходе, 12 выборок дают L=00, и эхо-автомат выстреливает
   14            ; 00 00 00 (~170 Б/с -- совпало со счётчиком 149 на скрине
   15            ; терминала). При SID=1 diag4 молчит (0000 на дисплее).
   16            ; diag6 показывает уровень SID ЖИВЬЁМ на дисплее -- без приборов:
   17            ;
   18            ;   1) ISR (0000h-00FFh) = diag4/diag5 БАЙТ-В-БАЙТ (ре-арм,
   19            ;      TX-автомат; RX-ветвь мертва: E=0 навсегда);
   20            ;   2) init MAIN (0100h-0129h) = diag4/diag5 БАЙТ-В-БАЙТ: один
   21            ;      баннер '>' сразу после EI -- маркер «сброс прошёл, образ
   22            ;      исполняется» (больше TX молчит: C=FFh -> TXIDLE, SOD=1);
   23            ;   3) хвост MAIN -- ПЛОТНЫЙ цикл опроса (~25-50 мкс/проход:
   24            ;      старт-бит 0,42 мс ловится ГАРАНТИРОВАННО, 8+ выборок на
   25            ;      бит), DMUX вызывается на каждом проходе -- дисплей живёт;
   26            ;   4) DMUX/HSEG/SEGTAB (0170h-01DFh) = diag4/diag5 БАЙТ-В-БАЙТ,
   27            ;      ничего менять не пришлось: DIG0 уже читает B, DIG1 --
   28            ;      SSELF, DIG2/3 -- байт BYTE0 (мл./ст. ниббл в hex).
   29            ;
   30            ; ДИСПЛЕЙ (обновляется каждые ~25-50 мкс, числа hex):
   31            ;   DIG0 = живой уровень SID: '1' = idle (высокий), '0' = низкий;
   32            ;   DIG1 = счётчик нулевых выборок (mod 16): КРУТИТСЯ, пока линия
   33            ;          низкая; заморожен на 0, если SID всегда 1; ЛЮБАЯ
   34            ;          активность с линии НАВСЕГДА уводит его из нуля --
   35            ;          «датчик движения» на RX;
   36            ;   DIG2/3 = сырое A после RIM (hex): A7=SID, A6=латч RST7.5,
   37            ;          A5/A6.5/A5.5-pending, A3=IE, A2/A1/A0=маски M7.5/M6.5/M5.5.
   38            ;
   39            ; ТАБЛИЦА ИСХОДОВ (терминал 2400 8N1 открыть ДО RESET):
   40            ;   1. [1][0][8B] + один '>' при сбросе
   41            ;      -> SID=1, IE=1, маски верны: тракт RX до CPU ИСПРАВЕН.
   42            ;         Флуд 00 в diag4 = линия была низкой ТОГДА (контакт/провод):
   43            ;         перетыкнуть провод CH340G.TXD->P38, вернуть diag4, тест эха.
   44            ;   2. [0][крутится][0B]
   45            ;      -> SID=0 ПОСТОЯННО: линия прижата. Мультиметр на проводе
   46            ;         «TX» (CH340G.TXD) и на P38: ожидание ~3,3-5 В при открытом
   47            ;         терминале. Проверить: тот ли пин CH340G (TXD, не RTS/DTR),
   48            ;         питание CH340G, пайка P38, нет ли КЗ на корпус.
   49            ;   3. [1][0][83] -> IE=0: прерывания выключены -- НЕ должно
   50            ;      (diag5 с тем же init работал); разбираться отдельно.
   51            ;   4. Набор символов в терминале: DIG0 мигает на '0', DIG1
   52            ;      прибавляет -> линия ЖИВАЯ и доходит до CPU: RX-путь цел,
   53            ;      можно возвращаться к diag4 (эхо) или main-прошивке.
   54            ;   5. DIG3 = 'C' (RIM=CBh) -> латч RST7.5 поймался на чтении --
   55            ;      редкая норма (бит сбросится на следующем ISR).
   56            ;
   57            ; ГОНКИ (разобрано): ISR в покое (E=0, C=FFh) трогает ТОЛЬКО A и
   58            ; флаги -- HSEG/DMUX/HL и B не задеваются; флаги перед JNZ SIDOK
   59            ; может испортить только «залетевший» между MOV B,A и JNZ ISR --
   60            ; вред одном экрану на один проход (ложный счёт/пропуск), следующий
   61            ; проход исправляет; MUXI хранится до ветвления -- состояние не
   62            ; теряется. Очередь QCNT=8007h навсегда 0 -> TXDONE всегда.
   63            ;
   64            ; Сборка (из этой папки):
   65            ;   python3 asm85.py uart_echo_diag6.asm -o uart_echo_diag6.hex -l uart_echo_diag6.lst
   66            ; UTF-8 мастер: scripts/uart/uart_echo_diag6.utf8.asm
   67            ; Прошивается ВМЕСТО монитора fw_mon с нулевого смещения flash A29040B.
   68            ; =====================================================================
   69            
   70            ; ---- параметры (можно переопределить ключами -D) ----
   71            TMR_N   EQU 8               ; бит = N x Q: 8 -> ~2460 бод (цель 2400)
   72            RXN1    EQU TMR_N//2        ; (в diag6 не используется -- RX отключён)
   73            SIMW    EQU 1Bh             ; SIM: MSE=1 -- 5.5/6.5 маскировать,
   74                                        ; 7.5 разрешить; R7.5=1 -- латч сброшен
   75            SIMLR   EQU 08h             ; (в diag6 не используется -- RX отключён)
   76            
   77            ; ---- порты ----
   78            SEGP    EQU 00h             ; SEG: D0=a..D6=g, D7=dp (1 = горит)
   79            DIGP    EQU 01h             ; DIG: D3-D0 разряды (D4 = SND -- не трогаем)
   80            TMRP    EQU 04h             ; таймер: запись N (период = N x Q)
   81            
   82            ; ---- ОЗУ (SRAM с 8000h, стек на FFFF -- конфликтов нет) ----
   83            MUXI    EQU 8000h           ; индекс разряда дисплея 0..3
   84            BYTE0   EQU 8001h           ; ДИАГ: сырое A после RIM -> DIG2/DIG3
   85            TSB     EQU 8002h           ; (в diag6 всегда 0)
   86            QBUF    EQU 8004h           ; (в diag6 всегда 0)
   87            SSELF   EQU 8006h           ; ДИАГ: счётчик нулевых выборок SID -> DIG1
   88            QCNT    EQU 8007h           ; счётчик очереди эха -- навсегда 0
   89            
   90            ; ---- векторы ----
   91  0000: -                ORG 0000h
   92  0000: C3 00 01         JMP MAIN            ; сброс
   93            ; Вектор 003Ch занят ре-армом ЦЕЛИКОМ (MVI+OUT = 003Ch-003Fh); ре-арм
   94            ; ПЕРВЫМ действием: период = ровно N тиков, длина ISR в сетку не входит.
   95  003C: -                ORG 003Ch
   96  003C: 3E 08            MVI A,TMR_N         ; РЕ-АРМ СЕТКИ (7 тактов)
   97  003E: D3 04            OUT TMRP            ; (10 тактов) -- 8 квантов = 1 бит
   98            
   99            ; ---- ISR: вентиль RX -> TX-автомат -> RX-автомат ----
  100  0040: -                ORG 0040h
  101  0040: 7B               MOV A,E             ; вентиль: RX активен (E>0)?
  102  0041: B7               ORA A
  103  0042: CA 48 00         JZ TXRUN
  104  0045: C3 A1 00         JMP RX              ; RX активен: TX НЕ двигаем (SOD держит уровень)
  105  0048: 79       TXRUN:  MOV A,C             ; --- TX-автомат ---
  106  0049: FE FF            CPI 0FFh            ; 0FFh = покой?
  107  004B: CA 9E 00         JZ TXIDLE
  108  004E: 0D               DCR C               ; следующая фаза
  109  004F: 79               MOV A,C
  110  0050: FE 0A            CPI 0Ah             ; 0Ah = старт-бит
  111  0052: CA 6D 00         JZ TXST
  112  0055: FE 0B            CPI 0Bh             ; 0Bh = холостой бит (урок v4): SOD=1
  113  0057: CA 73 00         JZ TXIDLBIT
  114  005A: FE 01            CPI 1               ; 01h = стоп-бит
  115  005C: CA 79 00         JZ TXSP
  116            ; --- фаза данных (d0..d7): байт в D ---
  117  005F: 7A               MOV A,D
  118  0060: 0F               RRC                 ; A7 <- D0
  119  0061: E6 80            ANI 80h
  120  0063: F6 40            ORI 40h             ; SDE=1; MSE=0 -- маски не трогаем
  121  0065: 30               SIM                 ; SOD <- бит
  122  0066: 37               STC                 ; единицы едут сверху
  123  0067: 7A               MOV A,D
  124  0068: 1F               RAR                 ; D >>= 1
  125  0069: 57               MOV D,A
  126  006A: C3 A1 00         JMP RX
  127  006D: 3E 40    TXST:   MVI A,40h           ; SOD=0 -- старт-бит (D заряжен заранее)
  128  006F: 30               SIM
  129  0070: C3 A1 00         JMP RX
  130  0073: 3E C0    TXIDLBIT: MVI A,0C0h        ; холостой бит: SOD=1 (C уже 0Bh ->
  131  0075: 30               SIM                 ;   следующий DCR даст 0Ah = старт)
  132  0076: C3 A1 00         JMP RX
  133  0079: 3E C0    TXSP:   MVI A,0C0h          ; SOD=1 -- стоп-бит
  134  007B: 30               SIM
  135  007C: 3A 07 80         LDA QCNT            ; очередь таймлайна?
  136  007F: B7               ORA A
  137  0080: CA 99 00         JZ TXDONE
  138  0083: 3D               DCR A
  139  0084: 32 07 80         STA QCNT            ; следующий байт очереди:
  140  0087: 57               MOV D,A             ;   было 2 -> QBUF, было 1 -> QBUF+1
  141  0088: FE 01            CPI 1
  142  008A: 2E 04            MVI L,QBUF & 0FFh
  143  008C: CA 90 00         JZ TXSP1
  144  008F: 2C               INR L
  145  0090: 26 80    TXSP1:  MVI H,QBUF//256
  146  0092: 7E               MOV A,M
  147  0093: 57               MOV D,A
  148  0094: 0E 0C            MVI C,0Ch           ; холостой бит, затем старт очередного
  149  0096: C3 A1 00         JMP RX
  150  0099: 0E FF    TXDONE: MVI C,0FFh          ; очередь пуста -- покой
  151  009B: C3 A1 00         JMP RX
  152  009E: 3E C0    TXIDLE: MVI A,0C0h          ; покой: SOD=1
  153  00A0: 30               SIM
  154            ; --- RX-автомат: каждая выборка -> бит таймлайна TSB; данные ещё и в L ---
  155  00A1: 7B       RX:     MOV A,E
  156  00A2: B7               ORA A
  157  00A3: CA F1 00         JZ RXE              ; E=0 -- приём не активен (в diag6 ВСЕГДА)
  158  00A6: FE 0C            CPI 12              ; 1-й интервал = старт-верификация (мимо L)
  159  00A8: CA BB 00         JZ RXBIT
  160  00AB: FE 04            CPI 4               ; E=3..1 -- хвост (мимо L)
  161  00AD: FA BB 00         JM RXBIT
  162  00B0: 20               RIM                 ; SID -> A7 (транзит RX->SID в CPLD)
  163  00B1: E6 80            ANI 80h
  164  00B3: 07               RLC                 ; v4: CY <- БИТ ЛИНИИ (в v3 был RAR: SID
  165  00B4: 7D               MOV A,L             ;   уезжал в A6, в CY попадал 0!)
  166  00B5: 1F               RAR                 ; L = (L>>1) | бит -- d0..d7, LSB-first
  167  00B6: 6F               MOV L,A
  168  00B7: 07               RLC                 ; v4: CY <- бит снова (A7 сдвинутого байта)
  169  00B8: C3 BF 00         JMP RXPACK
  170  00BB: 20       RXBIT:  RIM                 ; старт/хвост: только в таймлайн
  171  00BC: E6 80            ANI 80h
  172  00BE: 07               RLC                 ; v4: CY <- бит линии
  173  00BF: E5       RXPACK: PUSH H              ; v4: L = накопитель байта -- LHLD TSB
  174  00C0: 2A 02 80         LHLD TSB            ;   его затирает; HL спасаем на упаковку
  175  00C3: 7C               MOV A,H
  176  00C4: 17               RAL
  177  00C5: 67               MOV H,A
  178  00C6: 7D               MOV A,L
  179  00C7: 17               RAL
  180  00C8: 6F               MOV L,A
  181  00C9: 22 02 80         SHLD TSB
  182  00CC: E1               POP H               ; v4: байт возвращён в L
  183  00CD: 1D               DCR E               ; интервал отработан
  184  00CE: 7B               MOV A,E
  185  00CF: B7               ORA A
  186  00D0: C2 F1 00         JNZ RXE             ; кадр не кончился
  187                    ; --- РЕЛИЗ: 12 выборок собраны (E=0), L = байт, HL = TSB ---
  188  00D3: 79               MOV A,C             ; TX свободен?
  189  00D4: FE FF            CPI 0FFh
  190  00D6: C2 F1 00         JNZ RXE             ; занят -- байт отбрасываем (v1, без очереди)
  191  00D9: 7D               MOV A,L             ; принятый байт
  192  00DA: 32 01 80         STA BYTE0           ; ДИАГ: байт на дисплей
  193  00DD: 57               MOV D,A             ; эхо, кадр 1 = байт
  194  00DE: 3A 02 80         LDA TSB             ; v4: в ОЗУ 8002h = tl-hi, 8003h = tl-lo
  195  00E1: 32 04 80         STA QBUF            ;   (так ложится H-first цепочка RAL);
  196  00E4: 3A 03 80         LDA TSB+1           ;   LHLD в релизе переворачивал пару ->
  197  00E7: 32 05 80         STA QBUF+1          ;   эхо шло [tl-lo][tl-hi]. Теперь прямо:
  198  00EA: 3E 02            MVI A,2             ;   [байт][tl-hi][tl-lo] по протоколу
  199  00EC: 32 07 80         STA QCNT
  200  00EF: 0E 0B            MVI C,0Bh           ; следующий фронт = старт-байт эха
  201  00F1: FB       RXE:    EI
  202  00F2: C9               RET
  203            
  204            ; ---- MAIN ----
  205  0100: -                ORG 0100h
  206  0100: 31 FF FF MAIN:   LXI SP,0FFFFh       ; стек -- верх ОЗУ (конвенция v2)
  207  0103: 3E C0            MVI A,0C0h          ; SOD=1 (idle) -- гасим возможный BREAK
  208  0105: 30               SIM                 ; после сброса SOD=0; TX-маска CPLD и так
  209                                        ; держит '1' 51,2 мкс, но не полагаемся
  210  0106: 3E 00            MVI A,0             ; ДИАГ: ОЗУ -- с нуля
  211  0108: 32 00 80         STA MUXI
  212  010B: 32 01 80         STA BYTE0
  213  010E: 32 02 80         STA TSB
  214  0111: 32 03 80         STA TSB+1
  215  0114: 32 06 80         STA SSELF
  216  0117: 32 07 80         STA QCNT
  217  011A: 06 00            MVI B,0             ; DIG0 -- станет уровнем SID на 1-м RIM
  218  011C: 1E 00            MVI E,0             ; RX ПОЛНОСТЬЮ ОТКЛЮЧЁН (вентиль ISR навсегда TX)
  219  011E: 3E 1B            MVI A,SIMW
  220  0120: 30               SIM                 ; маски: 5.5/6.5 закрыты, 7.5 разрешён
  221  0121: 16 3E            MVI D,'>'           ; маркер-баннер (ОДИН кадр после EI)
  222  0123: 0E 0B            MVI C,0Bh           ; фаза: следующий фронт = старт '>'
  223  0125: 3E 08            MVI A,TMR_N
  224  0127: D3 04            OUT TMRP            ; пуск таймера
  225  0129: FB               EI
  226            ; --- diag6: ПЛОТНЫЙ цикл монитора SID (~25-50 мкс/проход) ---
  227  012A: 20       SIDLP:  RIM                 ; A = {SID,латчи,IE,маски}
  228  012B: 32 01 80         STA BYTE0           ; сырой байт -> DIG2/DIG3 (hex)
  229  012E: 07               RLC                 ; SID (A7) -> бит0 (и в CY)
  230  012F: E6 01            ANI 01h
  231  0131: 47               MOV B,A             ; DIG0 = '0'/'1' -- живой уровень линии
  232  0132: C2 3C 01         JNZ SIDOK
  233  0135: 3A 06 80         LDA SSELF           ; SID=0: счётчик активности ++ (крутится,
  234  0138: 3C               INR A               ; пока линия низкая; любая активность с
  235  0139: 32 06 80         STA SSELF           ; линии навсегда уводит его из нуля)
  236  013C: CD 70 01 SIDOK:  CALL DMUX           ; дисплей (ISR в покое трогает только A/флаги)
  237  013F: C3 2A 01         JMP SIDLP
  238            
  239            ; ---- ДИАГНОСТИКА: мультиплексия дисплея (по разряду за вызов) ----
  240            ; DIG0 = B (уровень SID 0/1), DIG1 = SSELF (активность на линии),
  241            ; DIG2/DIG3 = BYTE0 = сырое RIM (мл./ст. ниббл, hex). ПОРТИТ ТОЛЬКО
  242            ; A/флаги (HL через PUSH/POP).
  243  0170: -                ORG 0170h
  244  0170: 3A 00 80 DMUX:   LDA MUXI
  245  0173: 3C               INR A
  246  0174: E6 03            ANI 3
  247  0176: 32 00 80         STA MUXI
  248  0179: FE 01            CPI 1
  249  017B: CA 93 01         JZ DMX1
  250  017E: FE 02            CPI 2
  251  0180: CA A0 01         JZ DMX2
  252  0183: FE 03            CPI 3
  253  0185: CA AD 01         JZ DMX3
  254  0188: 78               MOV A,B             ; индекс 0: уровень SID
  255  0189: E6 0F            ANI 0Fh
  256  018B: CD BE 01         CALL HSEG
  257  018E: 3E 01            MVI A,01h
  258  0190: D3 01            OUT DIGP
  259  0192: C9               RET
  260  0193: 3A 06 80 DMX1:   LDA SSELF           ; индекс 1: активность на линии
  261  0196: E6 0F            ANI 0Fh
  262  0198: CD BE 01         CALL HSEG
  263  019B: 3E 02            MVI A,02h
  264  019D: D3 01            OUT DIGP
  265  019F: C9               RET
  266  01A0: 3A 01 80 DMX2:   LDA BYTE0           ; индекс 2: мл. ниббл RIM
  267  01A3: E6 0F            ANI 0Fh
  268  01A5: CD BE 01         CALL HSEG
  269  01A8: 3E 04            MVI A,04h
  270  01AA: D3 01            OUT DIGP
  271  01AC: C9               RET
  272  01AD: 3A 01 80 DMX3:   LDA BYTE0           ; индекс 3: ст. ниббл RIM
  273  01B0: 0F               RRC
  274  01B1: 0F               RRC
  275  01B2: 0F               RRC
  276  01B3: 0F               RRC
  277  01B4: E6 0F            ANI 0Fh
  278  01B6: CD BE 01         CALL HSEG
  279  01B9: 3E 08            MVI A,08h
  280  01BB: D3 01            OUT DIGP
  281  01BD: C9               RET
  282  01BE: E5       HSEG:   PUSH H              ; A = ниббл -> OUT SEGP = паттерн; HL цел
  283  01BF: 67               MOV H,A
  284  01C0: 2E D0            MVI L,SEGTAB & 0FFh
  285  01C2: 85               ADD L               ; lo + ниббл: переноса нет (lo=D0h)
  286  01C3: 6F               MOV L,A
  287  01C4: 26 01            MVI H,SEGTAB//256
  288  01C6: 7E               MOV A,M
  289  01C7: E1               POP H
  290  01C8: D3 00            OUT SEGP
  291  01CA: C9               RET
  292            
  293  01D0: -                ORG 01D0h           ; lo = D0h: D0h+0Fh без переноса -- ADD L точен
  294  01D0: 3F 06 5B 4F 66 6D 7D 07 SEGTAB: DB 3Fh,06h,5Bh,4Fh,66h,6Dh,7Dh,07h  ; '0'-'7' (a..g, dp=0)
  295  01D8: 7F 6F 77 7C 39 5E 79 71         DB 7Fh,6Fh,77h,7Ch,39h,5Eh,79h,71h  ; '8'-'F'
  296  01E0: -                END
