    1            ; =====================================================================
    2            ; beta/01_timer -- ТЕСТ-ПРОШИВКА ПЗУ: ПОЛНОЦЕННЫЙ UART (ПРИЁМ-ПЕРЕДАЧА,
    3            ; ЭХО) + ДИАГНОСТИКА ПРИЁМА НА ДИСПЛЕЕ. Интервальный таймер CPLD
    4            ; (beta v3.3b3, порт 04h -> RST 7.5), 2400 бод (TMR_N=8), 8N1.
    5            ;
    6            ; ЭТО ДИАГНОСТИЧЕСКИЙ ВАРИАНТ uart_echo_test.asm (v1, 229 байт).
    7            ; ЛОГИКА ЭХА НЕ ТРОНУТА. Отличия по листингу: +4 байта в релизе ISR
    8            ; (копия байта), +CALL DMUX и INR B в MAIN, блок DMUX с 00F0h,
    9            ; таблица SEGTAB с 0150h.
   10            ;
   11            ; Файл в кодировке CP1251 (как все исходники проекта, кроме asm85.py).
   12            ;
   13            ; Сборка (из этой папки):
   14            ;   python3 asm85.py uart_echo_diag.asm -o uart_echo_diag.hex -l uart_echo_diag.lst
   15            ;
   16            ; Железо: retro_PCLD_board V2 + CPLD beta v3.3b3 + USB-мост CH340G (U6).
   17            ; CPLD НЕ МЕНЯЛСЯ (транзиты уже в фите v3.3b3, проверено по .rpt:
   18            ; SID <= RX, RX=вход P38, SID=выход P73):
   19            ;   приём:   CH340G.TXD (U6.2, цепь платы «TX») -> P38 -> P73 -> CPU.SID (U3.5, RIM 20h);
   20            ;   передача: CPU.SOD (U3.4) -> P72 -> P39 -> CH340G.RXD (U6.3, цепь «RX»).
   21            ; Прошивается ВМЕСТО монитора fw_mon с нулевого смещения flash A29040B
   22            ; (видимое окно 0000h-7FFFh). После теста вернуть монитор.
   23            ;
   24            ; ЗАЧЕМ ДИАГНОСТИКА: TX-тракт доказан (баннер '>' приходит), а приём
   25            ; PC->плата упражняется ВПЕРВЫЕ. Дисплей показывает, ДОКАНЬ ли доходит
   26            ; ввод: 4 разряда = [счётчик пойманных старт-битов][последний байт].
   27            ;
   28            ; ЧТО ДОБАВЛЕНО:
   29            ;   B     -- счётчик ПОЙМАННЫХ старт-битов (фронтов 1->0 на SID,
   30            ;            ловит MAIN; hex, mod 256);
   31            ;   BYTE0 (ОЗУ 8001h) -- последний ПРИНЯТЫЙ байт (пишет ISR в релизе,
   32            ;            даже если эхо уронено по занятости TX);
   33            ;   MUXI  (ОЗУ 8000h) -- индекс разряда мультиплексии 0..3;
   34            ;   дисплей, шаг мультиплексии на каждый цикл опроса (4 фазы):
   35            ;     DIG0 = мл. ниббл B,  DIG1 = ст. ниббл B   -- счётчик стартов;
   36            ;     DIG2 = мл. ниббл байта, DIG3 = ст. ниббл  -- принятый байт.
   37            ;   После RESET: «0.0.0.0.» (маячок «стартовала»; отличим от «8.8.8.8.»
   38            ;   эха v1 и от «....» TX-теста v4).
   39            ;
   40            ; КАК ЧИТАТЬ (вводить ПО ОДНОМУ символу; paste -- норма v1 без очереди):
   41            ;   '>' есть, счётчик НЕ тикает, байт 00 -- приём мёртв ДО автоматики:
   42            ;       (а) flow control в терминале (RTS/CTS или XON/XOFF) --
   43            ;           ВЫКЛЮЧИТЬ: модемные линии CH340G (U6.9-15) на плате не
   44            ;           разведены, CTS терминал не дождётся никогда и молча
   45            ;           придержит ввод; баннер при этом приходит как ни в чём
   46            ;           не бывало -- симптом в точности наш;
   47            ;       (б) обрыв/непайка CH340G.TXD (U6.2) -> P38;
   48            ;       (в) контакт ножки 5 (SID) в ZIF U3 или дефект 1821ВМ85 по SID.
   49            ;       Осциллограф: при вводе смотреть P38 и U3.5 (есть ли кадры).
   50            ;   счётчик ТИКАЕТ, байт неверный (FFh/мусор), эха нет или мусор --
   51            ;       старт ловится, биты читаются мимо сетки: проверить 2400 8N1
   52            ;       в терминале; осциллографом форму P38 (задержка/дрожь фронтов
   53            ;       CH340G на 2400 ничтожна -- подозревать нечего, но глянуть).
   54            ;   счётчик ТИКАЕТ, байт ВЕРНЫЙ, эха НЕТ -- приём исправен целиком
   55            ;       (цепь до RIM и сетка выборки), вопрос к релизу эха (малореально:
   56            ;       логика релиза не менялась) -- сообщать владельцу код дисплея.
   57            ;   счётчик МЧИТСЯ сам, байт 00, без ввода -- линия RX прижата к 0
   58            ;       (КЗ/мёртвый CH340G): MAIN ловит «старты» непрерывно и гонит
   59            ;       в эхо нули.
   60            ;
   61            ; ТАЙМИНГ ПРИЁМА (не менялся, подробности в uart_echo_test.asm):
   62            ;   MAIN опрашивает SID (RIM) в цикле с DI; поймав старт-фронт:
   63            ;   OUT TMRP <- RXN1 (1,5 бита, 12 при N=8) -> SIM 08h (сброс латча
   64            ;   RST 7.5 ПОСЛЕ загрузки -- залетевший фронт выброшен атомарно)
   65            ;   -> INR B -> L=0, H=11, EI. Сетка ISR: ре-арм в векторе 003Ch;
   66            ;   кадр = 12Q (d0) + 8x8Q (d1..d7) + 3x8Q (хвост -- урок v4: эхо-старт
   67            ;   ПОСЛЕ конца кадра приёмника ПК). Мультиплексия дисплея ВЫНЕДЕНА
   68            ;   из критического пути: CALL DMUX стоит ДО DI (с включёнными
   69            ;   прерываниями); DMUX портит ТОЛЬКО A/флаги (HSEG сохраняет HL
   70            ;   через PUSH/POP, B..E не трогает; ISR в покое тоже трогает только
   71            ;   A/флаги) -- взаимных порчей нет. Цена: ~55 мкс к латентности
   72            ;   ловли старта (окно выборки d0 ±208 мкс, запас остаётся >150 мкс).
   73            ;
   74            ; РЕГИСТРЫ: C -- фаза TX (0Bh заряжен, 0Ah старт, 09h..02h данные,
   75            ;   01h стоп, 0FFh покой); D -- сдвиговый TX (LSB-first, единицы
   76            ;   сверху); H -- счётчик интервалов RX (11..4 выборки, 3..1 хвост,
   77            ;   0 покой); L -- накопитель байта; B -- счётчик старт-битов (ДИАГ,
   78            ;   ISR не трогает); A/флаги -- рабочие; E свободен. Между символами
   79            ;   MAIN (DMUX) держит: C=0FFh, D -- любое (перезаряжается релизом/
   80            ;   баннером), H=0, L -- любое, B -- счётчик. Вложенных прерываний нет.
   81            ; =====================================================================
   82            
   83            ; ---- параметры (можно переопределить ключами -D) ----
   84            TMR_N   EQU 8               ; бит = N x Q: 8 -> ~2460 бод (цель 2400)
   85            RXN1    EQU TMR_N + TMR_N//2 ; 1-й зазор приёма = 1,5 бита (12 при N=8)
   86            SIMW    EQU 1Bh             ; SIM: MSE=1 -- маски применить: 5.5/6.5
   87                                        ; маскировать, 7.5 РАЗРЕШИТЬ; R7.5=1 -- латч
   88                                        ; сброшен (гасим возможный мусор до EI)
   89            SIMLR   EQU 08h             ; SIM: R7.5=1, MSE=0, SDE=0 -- ТОЛЬКО сброс
   90                                        ; латча RST 7.5 (маски и SOD не трогаем)
   91            
   92            ; ---- порты ----
   93            SEGP    EQU 00h             ; SEG: D0=a..D6=g, D7=dp (1 = горит в регистре)
   94            DIGP    EQU 01h             ; DIG: D3-D0 разряды (D4 = SND -- не трогаем)
   95            TMRP    EQU 04h             ; таймер: запись N (период = N x Q)
   96            
   97            ; ---- диагностика: ОЗУ (SRAM с 8000h, стек на FFFF -- конфликтов нет) ----
   98            MUXI    EQU 8000h           ; индекс разряда дисплея 0..3
   99            BYTE0   EQU 8001h           ; последний принятый байт (пишет ISR)
  100            
  101            ; ---- векторы ----
  102  0000: -                ORG 0000h
  103  0000: C3 A0 00         JMP MAIN            ; сброс
  104            ; ВАЖНО: вектор 003Ch занят ре-армом ЦЕЛИКОМ (MVI+OUT = 003Ch-003Fh),
  105            ; JMP не нужен -- автомат продолжается с 0040h. Ре-арм ПЕРВЫМ действием:
  106            ; период = N тикам ровно (сетка не зависит от длины ISR).
  107  003C: -                ORG 003Ch
  108  003C: 3E 08            MVI A,TMR_N         ; РЕ-АРМ СЕТКИ (7 тактов)
  109  003E: D3 04            OUT TMRP            ; (10 тактов) -- 8 квантов = 1 бит
  110            
  111            ; ---- ISR: вентиль TX -> TX-автомат -> RX-автомат ----
  112  0040: -                ORG 0040h
  113  0040: 7C               MOV A,H             ; вентиль: RX активен (H>0)?
  114  0041: B7               ORA A
  115  0042: CA 48 00         JZ TXRUN
  116  0045: C3 79 00         JMP RX              ; RX активен: TX НЕ двигаем (заморозка кадра,
  117                                        ;   SOD держит текущий уровень)
  118  0048: 79       TXRUN:  MOV A,C             ; --- TX-автомат (фазы как в v4) ---
  119  0049: FE FF            CPI 0FFh            ; 0FFh = покой?
  120  004B: CA 76 00         JZ TXIDLE
  121  004E: 0D               DCR C               ; следующая фаза
  122  004F: 79               MOV A,C
  123  0050: FE 0A            CPI 0Ah             ; 0Ah = старт-бит
  124  0052: CA 68 00         JZ TXST
  125  0055: FE 01            CPI 1               ; 01h = стоп-бит
  126  0057: CA 6E 00         JZ TXSP
  127            ; --- фаза данных (d0..d7): как в v4, байт уже в D ---
  128  005A: 7A               MOV A,D
  129  005B: 0F               RRC                 ; A7 <- D0 (очередной бит данных)
  130  005C: E6 80            ANI 80h
  131  005E: F6 40            ORI 40h             ; SSE=1; MSE=0 -- маски НЕ трогаем
  132  0060: 30               SIM                 ; SOD <- бит
  133  0061: 37               STC                 ; единицы едут сверху: после d7 в D уже '1'
  134  0062: 7A               MOV A,D
  135  0063: 1F               RAR                 ; D >>= 1 (D7 <- 1)
  136  0064: 57               MOV D,A
  137  0065: C3 79 00         JMP RX
  138  0068: 3E 40    TXST:   MVI A,40h           ; SOD=0 -- старт-бит (D загружен ЗАРАНЕЕ:
  139  006A: 30               SIM                 ;   из релиза приёма или из MAIN)
  140  006B: C3 79 00         JMP RX
  141  006E: 3E C0    TXSP:   MVI A,0C0h          ; SOD=1 -- стоп-бит
  142  0070: 30               SIM
  143  0071: 0E FF            MVI C,0FFh          ; однобайтовый режим: сразу в покой (кадры
  144  0073: C3 79 00         JMP RX              ;   редкие -- 2-й стоп-бит не нужен)
  145  0076: 3E C0    TXIDLE: MVI A,0C0h          ; покой: SOD=1 (каждый тик подтверждаем)
  146  0078: 30               SIM
  147            ; --- RX-автомат: интервалы кадра в H, байт копится в L ---
  148  0079: 7C       RX:     MOV A,H
  149  007A: B7               ORA A
  150  007B: CA 9D 00         JZ RXE              ; H=0 -- приём не активен
  151  007E: FE 04            CPI 4               ; H>=4 (H=11..4) -- фаза данных d0..d7;
  152  0080: FA 8A 00         JM RXT              ; H=3..1 -- хвост (без выборки)
  153  0083: 20               RIM                 ; SID -> A7 (транзит RX->SID в CPLD)
  154  0084: E6 80            ANI 80h
  155  0086: 1F               RAR                 ; CY <- SID
  156  0087: 7D               MOV A,L
  157  0088: 1F               RAR                 ; L = (L>>1) | SID<<7 -- LSB-first
  158  0089: 6F               MOV L,A
  159  008A: 25       RXT:    DCR H               ; интервал отработан
  160  008B: 7C               MOV A,H
  161  008C: B7               ORA A
  162  008D: C2 9D 00         JNZ RXE             ; кадр приёма не кончился
  163  0090: 7D               MOV A,L             ; ДИАГ: копия принятого байта на дисплей
  164  0091: 32 01 80         STA BYTE0           ;   (даже если эхо ниже будет уронено)
  165  0094: 79               MOV A,C             ; --- РЕЛИЗ: кадр кончился (H=0) ---
  166  0095: FE FF            CPI 0FFh            ; TX свободен?
  167  0097: C2 9D 00         JNZ RXE             ; занят -- байт отбрасываем (v1, без очереди)
  168  009A: 55               MOV D,L             ; эхо: сдвиговый TX <- принятый байт
  169  009B: 0E 0B            MVI C,0Bh           ; следующий фронт = старт-бит эха
  170  009D: FB       RXE:    EI
  171  009E: C9               RET
  172            
  173            ; ---- MAIN ----
  174  00A0: -                ORG 00A0h
  175  00A0: 31 FF FF MAIN:   LXI SP,0FFFFh       ; стек -- верх ОЗУ (конвенция v2)
  176  00A3: 3E C0            MVI A,0C0h          ; SOD=1 (idle) -- ПЕРВЫМ делом гасим возможный
  177  00A5: 30               SIM                 ; BREAK: после сброса SOD=0; TX-маска CPLD и так
  178                                        ; держит '1' 51,2 мкс, но не полагаемся на неё
  179  00A6: 3E 00            MVI A,0             ; ДИАГ: MUXI=0, BYTE0=0 -- дисплей «0.0.0.0.»
  180  00A8: 32 00 80         STA MUXI
  181  00AB: 32 01 80         STA BYTE0
  182  00AE: 06 00            MVI B,0             ; ДИАГ: счётчик старт-битов -- с нуля
  183  00B0: 3E 1B            MVI A,SIMW
  184  00B2: 30               SIM                 ; маски: 5.5/6.5 закрыты, 7.5 разрешён, латч сброшен
  185  00B3: 16 3E            MVI D,'>'           ; баннер-символ (один; кадр уйдёт сами собой)
  186  00B5: 0E 0B            MVI C,0Bh           ; фаза: следующий фронт = старт-бит '>'
  187  00B7: 3E 08            MVI A,TMR_N
  188  00B9: D3 04            OUT TMRP            ; пуск таймера: 1-й фронт через N тиков
  189  00BB: 26 00            MVI H,0             ; RX покой
  190  00BD: 2E 00            MVI L,0
  191  00BF: FB               EI
  192  00C0: 79       BAN:    MOV A,C             ; ждём конца баннера (C -> 0FFh на стоп-фазе)
  193  00C1: FE FF            CPI 0FFh
  194  00C3: C2 C0 00         JNZ BAN
  195            ; --- главный цикл: опрос SID (приём) + эхо + мультиплексия дисплея ---
  196  00C6: CD F0 00 POLL:   CALL DMUX           ; ДИАГ: шаг мультиплексии (EI включён; портит
  197  00C9: F3               DI                  ;   только A/флаги -- критично, см. шапку);
  198                                        ;   далее опрос КАК В v1
  199  00CA: 20               RIM                 ; «залетевший» фронт сетки не обслужится,
  200  00CB: E6 80            ANI 80h             ; латч ловится -- выбросим ниже
  201  00CD: C2 C6 00         JNZ POLL            ; 1 = idle (покой линии)
  202                    ; --- старт-бит пойман (SID=0) ---
  203  00D0: 3E 0C            MVI A,RXN1          ; 1-й зазор = 1,5 бита: загрузка ДО сброса
  204  00D2: D3 04            OUT TMRP            ; латча! Любой залетевший фронт старого
  205  00D4: 3E 08            MVI A,SIMLR         ; отсчёта мог сработать только ДО этой точки
  206  00D6: 30               SIM                 ; (после загрузки новый фронт >= 11 квантов):
  207                                        ; SIM 08h выбрасывает их АТОМАРНО, гонки нет
  208  00D7: 04               INR B               ; ДИАГ: +1 пойманный старт-бит (вне критичного
  209                                        ;   пути -- ПОСЛЕ арма, до EI)
  210  00D8: 2E 00            MVI L,0             ; накопитель байта -- с нуля
  211  00DA: 26 0B            MVI H,11            ; 11 интервалов: 12Q (d0) + 8x8Q (d1..d7)
  212  00DC: FB               EI                  ;              + 3x8Q (хвост -- урок v4)
  213  00DD: 7C       RWAIT:  MOV A,H             ; ждём конца приёма (H -> 0 в релизе)
  214  00DE: B7               ORA A
  215  00DF: C2 DD 00         JNZ RWAIT
  216  00E2: 79       EWAIT:  MOV A,C             ; ждём конца эха (C -> 0FFh на стоп-фазе)
  217  00E3: FE FF            CPI 0FFh
  218  00E5: C2 E2 00         JNZ EWAIT
  219  00E8: C3 C6 00         JMP POLL
  220            
  221            ; ---- ДИАГНОСТИКА: мультиплексия дисплея (по одному разряду за вызов) ----
  222            ; DIG0=B.мл, DIG1=B.ст, DIG2=BYTE0.мл, DIG3=BYTE0.ст (hex).
  223            ; ПОРТИТ ТОЛЬКО A/флаги (HSEG сохраняет HL через PUSH/POP; B/C/D/E
  224            ; не трогает) -- безопасно при EI: ISR в покое тоже портит лишь A.
  225            ; Сегменты пишем ДО разряда (SEGP -> DIGP) -- без призраков.
  226  00F0: -                ORG 00F0h
  227  00F0: 3A 00 80 DMUX:   LDA MUXI
  228  00F3: 3C               INR A
  229  00F4: E6 03            ANI 3
  230  00F6: 32 00 80         STA MUXI            ; A = новый индекс 0..3
  231  00F9: FE 01            CPI 1
  232  00FB: CA 13 01         JZ DMX1
  233  00FE: FE 02            CPI 2
  234  0100: CA 22 01         JZ DMX2
  235  0103: FE 03            CPI 3
  236  0105: CA 2F 01         JZ DMX3
  237  0108: 78               MOV A,B             ; индекс 0: мл. ниббл счётчика
  238  0109: E6 0F            ANI 0Fh
  239  010B: CD 40 01         CALL HSEG
  240  010E: 3E 01            MVI A,01h
  241  0110: D3 01            OUT DIGP
  242  0112: C9               RET
  243  0113: 78       DMX1:   MOV A,B             ; индекс 1: ст. ниббл счётчика
  244  0114: 0F               RRC
  245  0115: 0F               RRC
  246  0116: 0F               RRC
  247  0117: 0F               RRC
  248  0118: E6 0F            ANI 0Fh
  249  011A: CD 40 01         CALL HSEG
  250  011D: 3E 02            MVI A,02h
  251  011F: D3 01            OUT DIGP
  252  0121: C9               RET
  253  0122: 3A 01 80 DMX2:   LDA BYTE0           ; индекс 2: мл. ниббл байта
  254  0125: E6 0F            ANI 0Fh
  255  0127: CD 40 01         CALL HSEG
  256  012A: 3E 04            MVI A,04h
  257  012C: D3 01            OUT DIGP
  258  012E: C9               RET
  259  012F: 3A 01 80 DMX3:   LDA BYTE0           ; индекс 3: ст. ниббл байта
  260  0132: 0F               RRC
  261  0133: 0F               RRC
  262  0134: 0F               RRC
  263  0135: 0F               RRC
  264  0136: E6 0F            ANI 0Fh
  265  0138: CD 40 01         CALL HSEG
  266  013B: 3E 08            MVI A,08h
  267  013D: D3 01            OUT DIGP
  268  013F: C9               RET
  269  0140: E5       HSEG:   PUSH H              ; A = ниббл -> OUT SEGP = паттерн; HL целы
  270  0141: 67               MOV H,A
  271  0142: 2E 50            MVI L,SEGTAB & 0FFh
  272  0144: 85               ADD L               ; lo + ниббл: переноса нет (lo=50h, см. ниже)
  273  0145: 6F               MOV L,A
  274  0146: 26 01            MVI H,SEGTAB//256
  275  0148: 7E               MOV A,M
  276  0149: E1               POP H
  277  014A: D3 00            OUT SEGP
  278  014C: C9               RET
  279            
  280  0150: -                ORG 0150h           ; lo = 50h: 50h+0Fh без переноса -- ADD L точен
