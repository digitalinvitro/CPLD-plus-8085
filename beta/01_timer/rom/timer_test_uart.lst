    1            ; =====================================================================
    2            ; beta/01_timer -- ТЕСТ-ПРОШИВКА ПЗУ: ВЫВОД В UART, ТАКТИРУЕМЫЙ
    3            ; ИНТЕРВАЛЬНЫМ ТАЙМЕРОМ (CPLD beta v3.3b3, порт 04h -> RST 7.5).
    4            ;
    5            ; Файл в кодировке CP1251 (как все исходники проекта, кроме asm85.py).
    6            ;
    7            ; Сборка (из этой папки):
    8            ;   python3 asm85.py timer_test_uart.asm -o timer_test_uart.hex -l timer_test_uart.lst
    9            ;   другие скорости: -D TMR_N=2 (9600) / -D TMR_N=4 (4800) / -D TMR_N=16 (1200)
   10            ;
   11            ; Железо: retro_PCLD_board V2 + CPLD beta v3.3b3 + USB-мост CH340G (U6).
   12            ; Тракт передачи: CPU.SOD (SIM) -> CPLD P72 -> P39 (прозрачный транзит;
   13            ; после сброса TX-маска держит '1' 51,2 мкс -- BREAK невозможен)
   14            ; -> CH340G.RXD -> виртуальный COM-порт ПК.
   15            ; Терминал: 2400 8N1 (по умолчанию), без управления потоком.
   16            ; Прошивается ВМЕСТО монитора fw_mon с нулевого смещения flash A29040B
   17            ; (видимое окно 0000h-7FFFh). После теста вернуть монитор.
   18            ;
   19            ; ИДЕЯ (задание владельца): битовые интервалы формирует ИНТЕРВАЛЬНЫЙ
   20            ; ТАЙМЕР, а не калиброванные программные циклы. ОДНО прерывание
   21            ; RST 7.5 = ОДИН бит. Референс "полностью софтверного" варианта --
   22            ; uart_sw_test.asm (тот же текст на экране, задержки -- счётчиком
   23            ; тактов); таблица сравнения -- в beta/01_timer/README.md.
   24            ;
   25            ; ТАЙМИНГ. Квант Q = 256 x 5 тактов clk = 1280/clk:
   26            ;   clk = 25,000 МГц -> Q = 51,20 мкс;
   27            ;   факт: по тону v2 (493 Гц при N=20; период фронтов = РОВНО N тиков --
   28            ;   в HDL декремент только по тикам, загрузка приоритетнее, тик при
   29            ;   ре-арме раньше следующего тика не теряется) -> Q ~ 50,7 мкс
   30            ;   (clk ~ 25,2 МГц, «сверчок» LTC6905 идёт на ~+1% от номинала).
   31            ; Ре-арм -- ПЕРВОЕ действие ISR (003Ch: MVI A,N / OUT 04h, ~13 мкс от
   32            ; фронта), укладывается в квант, поэтому:
   33            ;   период прерываний = РОВНО N x Q; накладные ISR в период НЕ входят
   34            ;   (сетка тиков свободно-бежящая). Длина ISR влияет только на добавку
   35            ;   фронта SOD от фронта тика: старт/стоп ~+23 мкс, данные ~+35 мкс
   36            ;   (ширина бита гуляет в пределах ~13 мкс = 3% бита на 2400 -- приёмник
   37            ;   выборкой в середине бита это прощает, запас > 90 мкс, см. README).
   38            ; Бит = N x Q (при Q = 50,6..51,2 мкс):
   39            ;   N=2  -> 9770-9870 бод (цель 9600, ошибка +1,8..+2,8%)
   40            ;   N=4  -> 4883-4936      (4800)
   41            ;   N=8  -> 2441-2468      (2400)  <- по умолчанию
   42            ;   N=16 -> 1221-1234      (1200)
   43            ; Ошибка +1,7..+2,8% -- в допуске UART: дрейф за 9,5 бит ~26% бита при
   44            ; лимите ~50%, запас по выборке середины бита > 23% на любой скорости.
   45            ; Если терминал показывает мусор -- снизить скорость (TMR_N=16, 1200).
   46            ;
   47            ; ЧТО ДЕЛАЕТ: бесконечно шлёт строку MSG:
   48            ;   "TIMER-UART OK" + CR LF, пауза ~14 бит, повтор.
   49            ;   Кадры идут ВПЛОТНУЮ (стоп-фаза сама подгружает следующий байт --
   50            ;   холостых бит между символами нет, 10 бит на символ).
   51            ; Дисплей: dp на всех 4 разрядах («....») -- маячок «программа жива»
   52            ; (отличим от v2-тона: там 'g'+dp; «8.» -- не стартовала).
   53            ;
   54            ; РЕГИСТРЫ ISR (MAIN живёт в HLT и их не трогает -- сохранять нечего):
   55            ;   C  -- фаза кадра: 0Bh=кадр загружен (D готов), 0Ah=старт,
   56            ;         09h..02h=данные d0..d7, 01h=стоп (+подготовка следующего
   57            ;         байта), 0FFh=покой. Фаза 00h не возникает: стоп-фаза
   58            ;         перезаряжает счётчик сама.
   59            ;   D  -- сдвиговый регистр данных (LSB-first, единицы втягиваются
   60            ;         сверху -- после d7 линия уже '1'); грузится ЗАРАНЕЕ (в MAIN,
   61            ;         в стоп-фазе или при выходе из паузы)
   62            ;   E  -- счётчик паузы (GAPN бит)
   63            ;   HL -- указатель очередного символа MSG
   64            ;   A/флаги -- рабочие; B не используется. Вложенных прерываний нет
   65            ;   (8085 запрещает IE на входе в ISR), EI только в конце.
   66            ;
   67            ; ДИАГНОСТИКА:
   68            ;   в терминале повторяется "TIMER-UART OK" -> ПАСС: таймер, RST 7.5,
   69            ;       ре-арм, автомат, SOD, CH340G, COM-порт
   70            ;   дисплей «....», в терминале мусор  -> скорость не совпала: выставить
   71            ;       2400; если мусор и на 2400 -- прошить -D TMR_N=16 (1200)
   72            ;   дисплей «....», терминал молчит   -> тракт TX: осциллограф на SOD
   73            ;       (U3.4, нога 4 CPU) и TX (P39 CPLD); проверить COM/драйвер CH340G
   74            ;   дисплей «8.» или пуст             -> программа не стартует (ПЗУ/шина)
   75            ;   обрывы/склейки строк              -> потеря прерываний (латч/маска/EI)
   76            ; =====================================================================
   77            
   78            ; ---- параметры (можно переопределить ключами -D) ----
   79            TMR_N   EQU 8               ; бит = N x Q: 8 -> ~2460 бод (цель 2400)
   80            GAPN    EQU 13              ; пауза между посылками, бит (~5,3-5,4 мс)
   81            
   82            ; ---- порты ----
   83            SEGP    EQU 00h             ; SEG: D0=a..D6=g, D7=dp (1 = горит в регистре)
   84            DIGP    EQU 01h             ; DIG/SND: D3-D0 разряды (SND не используется)
   85            TMRP    EQU 04h             ; таймер: запись N (период = N x Q)
   86            SIMW    EQU 1Bh             ; SIM: MSE=1 -- маски применить: 5.5/6.5
   87                                        ; маскировать, 7.5 РАЗРЕШИТЬ; R7.5=1 -- латч
   88                                        ; сброшен (гасим возможный мусор до EI)
   89            
   90            ; ---- векторы ----
   91  0000: -                ORG 0000h
   92  0000: C3 A0 00         JMP MAIN            ; сброс
   93            ; ВАЖНО: вектор 003Ch занят ре-армом ЦЕЛИКОМ (MVI+OUT = ровно 003Ch-003Fh),
   94            ; JMP не нужен -- автомат продолжает с 0040h. Ре-арм ПЕРВЫМ действием:
   95            ; период = N тикам ровно, а выход SOD сдвинут на постоянную добавку
   96            ; от фронта тика (приёмник синхронизируется по фронту старт-бита).
   97  003C: -                ORG 003Ch
   98  003C: 3E 08            MVI A,TMR_N         ; РЕ-АРМ (7 тактов)
   99  003E: D3 04            OUT TMRP            ; (10 тактов) -- от фронта до загрузки ~13 мкс
  100            
  101            ; ---- автомат передатчика: 1 прерывание = 1 бит ----
  102  0040: -                ORG 0040h
  103  0040: 79               MOV A,C             ; фаза в C
  104  0041: FE FF            CPI 0FFh            ; 0FFh = покой (пауза между посылками)?
  105  0043: CA 7C 00         JZ IDLE
  106  0046: 0D               DCR C               ; следующая фаза
  107  0047: 79               MOV A,C
  108  0048: FE 0A            CPI 0Ah             ; 0Ah = старт-бит
  109  004A: CA 60 00         JZ START
  110  004D: FE 01            CPI 1               ; 01h = стоп-бит (+подготовка следующего)
  111  004F: CA 66 00         JZ STOPB
  112            ; --- фаза данных (09h..02h): выдать D0, сдвинуть вправо с единицей ---
  113  0052: 7A               MOV A,D
  114  0053: 0F               RRC                 ; A7 <- D0 (очередной бит данных)
  115  0054: E6 80            ANI 80h
  116  0056: F6 40            ORI 40h             ; SSE=1; MSE=0 -- маски НЕ трогаем (см. SIM)
  117  0058: 30               SIM                 ; SOD <- бит
  118  0059: 37               STC                 ; единицы едут сверху: после d7 в D уже '1'
  119  005A: 7A               MOV A,D
  120  005B: 1F               RAR                 ; D >>= 1 (D7 <- 1)
  121  005C: 57               MOV D,A
  122  005D: C3 8A 00         JMP IRET
  123  0060: 3E 40    START:  MVI A,40h           ; SOD=0 -- старт-бит (D уже загружен заранее)
  124  0062: 30               SIM
  125  0063: C3 8A 00         JMP IRET
  126  0066: 3E C0    STOPB:  MVI A,0C0h          ; SOD=1 -- стоп-бит
  127  0068: 30               SIM
  128  0069: 23               INX H               ; -- подготовка следующего байта (кадры
  129  006A: 7E               MOV A,M             ;    идут вплотную, холостых бит нет):
  130  006B: B7               ORA A               ;    00h = конец строки
  131  006C: CA 75 00         JZ ESTR
  132  006F: 57               MOV D,A             ;    байт -> сдвиговый заранее
  133  0070: 0E 0B            MVI C,0Bh           ;    перезарядить фазу (00h не возникает)
  134  0072: C3 8A 00         JMP IRET
  135  0075: 0E FF    ESTR:   MVI C,0FFh          ; строка кончилась -- покой
  136  0077: 1E 0D            MVI E,GAPN          ; пауза GAPN бит
  137  0079: C3 8A 00         JMP IRET
  138  007C: 3E C0    IDLE:   MVI A,0C0h          ; покой: SOD=1 (каждый тик подтверждаем)
  139  007E: 30               SIM
  140  007F: 1D               DCR E
  141  0080: C2 8A 00         JNZ IRET
  142  0083: 21 C1 00         LXI H,MSG           ; пауза кончилась -- заново (с preload D)
  143  0086: 7E               MOV A,M
  144  0087: 57               MOV D,A
  145  0088: 0E 0B            MVI C,0Bh
  146  008A: FB       IRET:   EI
  147  008B: C9               RET
  148            
  149            ; ---- MAIN ----
  150  00A0: -                ORG 00A0h
  151  00A0: 31 FF FF MAIN:   LXI SP,0FFFFh       ; стек -- верх ОЗУ (конвенция v2; на случай
  152                                        ; расширения MAIN -- CALL уже обеспечен SP)
  153  00A3: 3E C0            MVI A,0C0h          ; SOD=1 (idle) -- ПЕРВЫМ делом гасим возможный
  154  00A5: 30               SIM                 ; BREAK: после сброса SOD=0; TX-маска CPLD и так
  155                                        ; держит '1' 51,2 мкс, но не полагаемся на неё
  156  00A6: 3E 80            MVI A,80h           ; дисплей: только dp на всех разрядах («....»)
  157  00A8: D3 00            OUT SEGP
  158  00AA: 3E 0F            MVI A,0Fh           ; все 4 разряда статически (нагрузка << INIT «8.»)
  159  00AC: D3 01            OUT DIGP
  160  00AE: 3E 08            MVI A,TMR_N
  161  00B0: D3 04            OUT TMRP            ; пуск таймера: 1-й фронт через N тик (~0,41 мс)
  162  00B2: 3E 1B            MVI A,SIMW
  163  00B4: 30               SIM                 ; маски: 5.5/6.5 закрыты, 7.5 разрешён, латч сброшен
  164  00B5: 21 C1 00         LXI H,MSG           ; первый байт -- заранее в сдвиговый регистр
  165  00B8: 7E               MOV A,M
  166  00B9: 57               MOV D,A
  167  00BA: 0E 0B            MVI C,0Bh           ; фаза: следующий тик = старт-бит
  168  00BC: FB               EI
  169  00BD: 76       HLTLP:  HLT                 ; спим: вся передача -- в ISR (~10% CPU)
  170  00BE: C3 BD 00         JMP HLTLP
  171            
  172            ; ---- сообщение: строка + CR LF + терминатор 00h ----
  173  00C1: 54 49 4D 45 52 2D 55 41 52 54 20 4F 4B 0D 0A 00 MSG:    DB 'TIMER-UART OK',0Dh,0Ah,00h
  174  00D1: -                END
