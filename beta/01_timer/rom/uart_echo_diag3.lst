  315  01D0: 3F 06 5B 4F 66 6D 7D 07 SEGTAB: DB 3Fh,06h,5Bh,4Fh,66h,6Dh,7Dh,07h  ; '0'-'7' (a..g, dp=0)
  316  01D8: 7F 6F 77 7C 39 5E 79 71         DB 7Fh,6Fh,77h,7Ch,39h,5Eh,79h,71h  ; '8'-'F'
