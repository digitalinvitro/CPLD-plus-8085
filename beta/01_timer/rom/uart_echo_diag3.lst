    1            ; =====================================================================
    2            ; beta/01_timer -- ТЕСТ-ПРОШИВКА ПЗУ: ПОЛНОЦЕННЫЙ UART (ПРИЁМ-ПЕРЕДАЧА,
    3            ; ЭХО) + ДИАГНОСТИКА ВЕРСИЯ 3: ПОЛНЫЙ ТАЙМЛАЙН КАДРА.
    4            ; Интервальный таймер CPLD (beta v3.3b3, порт 04h -> RST 7.5),
    5            ; 2400 бод (TMR_N=8), 8N1.
    6            ;
    7            ; ЭТО diag v2 + ПОЛНЫЙ СРЕЗ ЛИНИИ: кадр приёма = 12 выборок
    8            ; [старт-верификация (~0,5 бита), d0..d7 (1,5..8,5 бита), хвост x3].
    9            ; РЕЗУЛЬТАТ ВИДЕН В HEX-ТЕРМИНАЛЕ: на каждый принятый кадр плата шлёт
   10            ; ТРИ байта: [принятый байт][таймлайн hi][таймлайн lo].
   11            ;
   12            ; Файл в кодировке CP1251 (как все исходники проекта, кроме asm85.py).
   13            ;
   14            ; Сборка (из этой папки):
   15            ;   python3 asm85.py uart_echo_diag3.asm -o uart_echo_diag3.hex -l uart_echo_diag3.lst
   16            ;
   17            ; Железо: retro_PCLD_board V2 + CPLD beta v3.3b3 + USB-мост CH340G (U6).
   18            ; CPLD НЕ МЕНЯЛСЯ (транзит SID <= RX безусловен, фит проверен по .rpt:
   19            ; RX = вход P38, SID = выход P73, SOD = вход P72, TX = выход P39).
   20            ; Прошивается ВМЕСТО монитора fw_mon с нулевого смещения flash A29040B.
   21            ;
   22            ; МОТИВАЦИЯ (diag v1/v2 на железе): счётчик стартов тикает на каждое
   23            ; нажатие, эхо-байты в hex-терминале = 00 на ВСЁ (в т.ч. paste 46
   24            ; символов -> 21 байт 00), терминал 2400 8N1 подтверждён. При честных
   25            ; 2400 приём не может дать 00 (sim_rx_signature: 1000/1000) => нужно
   26            ; увидеть САМу линию глазами платы. diag3 показывает все 12 выборок.
   27            ;
   28            ; КАК ЧИТАТЬ ЭХО (hex-терминал, вводить по ОДНОМУ символу):
   29            ;   [байт][tl-hi][tl-lo], таймлайн = 12 бит MSB-first:
   30            ;   tl-hi = 0000 s d0 d1 d2, tl-lo = d3 d4 d5 d6 d7 t1 t2 t3,
   31            ;   где s = выборка старта (~0,5 бита; должна быть 0), t1..t3 = хвост
   32            ;   (стоп/idle; должны быть 1,1,1).
   33            ;   ОЖИДАНИЕ при 2400:  'a' -> 61 04 37;  'o' -> 6F 07 77;
   34            ;                       Enter -> 0D 00 77;  '3' -> 33 03 77.
   35            ;   00 00 00  -- линия НИЗКАЯ ВО ВСЕХ 12 точках (в т.ч. на старте!)
   36            ;                кадр "съеден" целиком: линию прижимает на ~5 мс;
   37            ;   s=1 (tl-hi >= 08h) -- пойманный "старт" вернулся в 1 (глитч/чужой
   38            ;                кадр), данные читались из единиц;
   39            ;   хвост 0 (tl-lo & 07 != 07) -- сетка уползла к концу кадра;
   40            ;   сдвиг узора при верном старте -- сетка/скорость источника не 2400.
   41            ; ДИСПЛЕЙ: [B = счётчик чистых стартов mod 16]
   42            ;          [S = счётчик ЗАХВАТОВ ВО ВРЕМЯ СВОЕГО ЭХА mod 16 (S>0 =
   43            ;           плата ловит собственную передачу -- петля/самозапуск!)]
   44            ;          [байт lo][байт hi].  После RESET: «0.0.0.0.».
   45            ;
   46            ; ТАЙМИНГ ПРИЁМА (сетка d0..d7 НЕ ИЗМЕНИЛАСЬ): MAIN ловит старт (RIM,
   47            ; DI), OUT TMRP <- RXN1 = N/2 = 4 кванта (0,5 бита) -> SIM 08h (атомарный
   48            ; выброс латча) -> MVI E,12 -> EI. Первый фронт через (3..4) кванта:
   49            ; выборка s на ~0,43-0,55 бита (середина старта). Далее ре-арм в векторе
   50            ; 003Ch = ровно 8Q: d0 на 1,5 бита КАК РАНЬШЕ, d7 на 8,5 бита, хвост
   51            ; 9,5/10,5/11,5 бита. Кадр = 12 интервалов, релиз при E=0.
   52            ; Каждая выборка пакуется в TSB (ОЗУ 8002h/8003h, MSB-first):
   53            ; LHLD/RAL/RAL/SHLD, ~30 мкс на интервал (период 8Q = 405 мкс -- запас).
   54            ;
   55            ; ЭХО: TX-автомат v4 однобайтовый + ОЧЕРЕДЬ 2 байта таймлайна в ОЗУ
   56            ; (QCNT 8007h): на стоп-фазе, если очередь не пуста, D <- следующий
   57            ; байт, фаза 0Ch = ХОЛОСТОЙ БИТ (урок v4: кадры не вплотную). Порядок
   58            ; эха: байт, tl-hi, tl-lo. Приоритет RX над TX сохранён (вентиль E>0:
   59            ; TX замирает, SOD держит уровень; очередь ждёт в ОЗУ).
   60            ;
   61            ; РЕГИСТРЫ: C -- фаза TX; D -- сдвиговый TX; E -- интервалы RX (12..1,
   62            ;   0 = покой; вентиль RX-приоритета); L -- накопитель байта (d0..d7); B -- счётчик чистых стартов;
   63            ;   A/флаги -- рабочие. DMUX (MAIN) портит только A/флаги (HL через
   64            ;   PUSH/POP). Вложенных прерываний нет.
   65            ;
   66            ; ОЗУ (SRAM с 8000h): 8000h MUXI, 8001h BYTE0, 8002h-03h TSB (таймлайн),
   67            ; 8004h-05h QBUF (очередь эха), 8006h SSELF, 8007h QCNT. Стек на FFFF.
   68            ; =====================================================================
   69            
   70            ; ---- параметры (можно переопределить ключами -D) ----
   71            TMR_N   EQU 8               ; бит = N x Q: 8 -> ~2460 бод (цель 2400)
   72            RXN1    EQU TMR_N//2        ; 1-й зазор = 0,5 бита (выборка СТАРТА)
   73            SIMW    EQU 1Bh             ; SIM: MSE=1 -- 5.5/6.5 маскировать,
   74                                        ; 7.5 разрешить; R7.5=1 -- латч сброшен
   75            SIMLR   EQU 08h             ; SIM: R7.5=1, MSE=0, SDE=0 -- только сброс
   76                                        ; латча RST 7.5
   77            
   78            ; ---- порты ----
   79            SEGP    EQU 00h             ; SEG: D0=a..D6=g, D7=dp (1 = горит)
   80            DIGP    EQU 01h             ; DIG: D3-D0 разряды (D4 = SND -- не трогаем)
   81            TMRP    EQU 04h             ; таймер: запись N (период = N x Q)
   82            
   83            ; ---- ОЗУ (SRAM с 8000h, стек на FFFF -- конфликтов нет) ----
   84            MUXI    EQU 8000h           ; индекс разряда дисплея 0..3
   85            BYTE0   EQU 8001h           ; последний принятый байт (для дисплея)
   86            TSB     EQU 8002h           ; таймлайн 12 бит (hi=8002h, lo=8003h)
   87            QBUF    EQU 8004h           ; очередь эха: 8004h = tl-hi, 8005h = tl-lo
   88            SSELF   EQU 8006h           ; счётчик захватов во время своего эха
   89            QCNT    EQU 8007h           ; счётчик очереди эха 0..2
   90            
   91            ; ---- векторы ----
   92  0000: -                ORG 0000h
   93  0000: C3 00 01         JMP MAIN            ; сброс
   94            ; Вектор 003Ch занят ре-армом ЦЕЛИКОМ (MVI+OUT = 003Ch-003Fh); ре-арм
   95            ; ПЕРВЫМ действием: период = ровно N тиков, длина ISR в сетку не входит.
   96  003C: -                ORG 003Ch
   97  003C: 3E 08            MVI A,TMR_N         ; РЕ-АРМ СЕТКИ (7 тактов)
   98  003E: D3 04            OUT TMRP            ; (10 тактов) -- 8 квантов = 1 бит
   99            
  100            ; ---- ISR: вентиль RX -> TX-автомат -> RX-автомат ----
  101  0040: -                ORG 0040h
  102  0040: 7B               MOV A,E             ; вентиль: RX активен (E>0)?
  103  0041: B7               ORA A
  104  0042: CA 48 00         JZ TXRUN
  105  0045: C3 A1 00         JMP RX              ; RX активен: TX НЕ двигаем (SOD держит уровень)
  106  0048: 79       TXRUN:  MOV A,C             ; --- TX-автомат ---
  107  0049: FE FF            CPI 0FFh            ; 0FFh = покой?
  108  004B: CA 9E 00         JZ TXIDLE
  109  004E: 0D               DCR C               ; следующая фаза
  110  004F: 79               MOV A,C
  111  0050: FE 0A            CPI 0Ah             ; 0Ah = старт-бит
  112  0052: CA 6D 00         JZ TXST
  113  0055: FE 0B            CPI 0Bh             ; 0Bh = холостой бит (урок v4): SOD=1
  114  0057: CA 73 00         JZ TXIDLBIT
  115  005A: FE 01            CPI 1               ; 01h = стоп-бит
  116  005C: CA 79 00         JZ TXSP
  117            ; --- фаза данных (d0..d7): байт в D ---
  118  005F: 7A               MOV A,D
  119  0060: 0F               RRC                 ; A7 <- D0
  120  0061: E6 80            ANI 80h
  121  0063: F6 40            ORI 40h             ; SSE=1; MSE=0 -- маски не трогаем
  122  0065: 30               SIM                 ; SOD <- бит
  123  0066: 37               STC                 ; единицы едут сверху
  124  0067: 7A               MOV A,D
  125  0068: 1F               RAR                 ; D >>= 1
  126  0069: 57               MOV D,A
  127  006A: C3 A1 00         JMP RX
  128  006D: 3E 40    TXST:   MVI A,40h           ; SOD=0 -- старт-бит (D заряжен заранее)
  129  006F: 30               SIM
  130  0070: C3 A1 00         JMP RX
  131  0073: 3E C0    TXIDLBIT: MVI A,0C0h        ; холостой бит: SOD=1 (C уже 0Bh ->
  132  0075: 30               SIM                 ;   следующий DCR даст 0Ah = старт)
  133  0076: C3 A1 00         JMP RX
  134  0079: 3E C0    TXSP:   MVI A,0C0h          ; SOD=1 -- стоп-бит
  135  007B: 30               SIM
  136  007C: 3A 07 80         LDA QCNT            ; очередь таймлайна?
  137  007F: B7               ORA A
  138  0080: CA 99 00         JZ TXDONE
  139  0083: 3D               DCR A
  140  0084: 32 07 80         STA QCNT            ; следующий байт очереди:
  141  0087: 57               MOV D,A             ;   было 2 -> QBUF, было 1 -> QBUF+1
  142  0088: FE 01            CPI 1
  143  008A: 2E 04            MVI L,QBUF & 0FFh
  144  008C: CA 90 00         JZ TXSP1
  145  008F: 2C               INR L
  146  0090: 26 80    TXSP1:  MVI H,QBUF//256
  147  0092: 7E               MOV A,M
  148  0093: 57               MOV D,A
  149  0094: 0E 0C            MVI C,0Ch           ; холостой бит, затем старт очередного
  150  0096: C3 A1 00         JMP RX
  151  0099: 0E FF    TXDONE: MVI C,0FFh          ; очередь пуста -- покой
  152  009B: C3 A1 00         JMP RX
  153  009E: 3E C0    TXIDLE: MVI A,0C0h          ; покой: SOD=1
  154  00A0: 30               SIM
  155            ; --- RX-автомат: каждая выборка -> бит таймлайна TSB; данные ещё и в L ---
  156  00A1: 7B       RX:     MOV A,E
  157  00A2: B7               ORA A
  158  00A3: CA ED 00         JZ RXE              ; E=0 -- приём не активен
  159  00A6: FE 0C            CPI 12              ; 1-й интервал = старт-верификация (мимо L)
  160  00A8: CA BA 00         JZ RXBIT
  161  00AB: FE 04            CPI 4               ; E=3..1 -- хвост (мимо L)
  162  00AD: FA BA 00         JM RXBIT
  163  00B0: 20               RIM                 ; SID -> A7 (транзит RX->SID в CPLD)
  164  00B1: E6 80            ANI 80h
  165  00B3: 1F               RAR                 ; CY <- бит линии
  166  00B4: 7D               MOV A,L
  167  00B5: 1F               RAR                 ; L = (L>>1) | бит -- d0..d7, LSB-first
  168  00B6: 6F               MOV L,A
  169  00B7: C3 BE 00         JMP RXPACK
  170  00BA: 20       RXBIT:  RIM                 ; старт/хвост: только в таймлайн
  171  00BB: E6 80            ANI 80h
  172  00BD: 1F               RAR
  173  00BE: 2A 02 80 RXPACK: LHLD TSB            ; TSB = (TSB<<1) | бит  (MSB-first)
  174  00C1: 7C               MOV A,H
  175  00C2: 17               RAL
  176  00C3: 67               MOV H,A
  177  00C4: 7D               MOV A,L
  178  00C5: 17               RAL
  179  00C6: 6F               MOV L,A
  180  00C7: 22 02 80         SHLD TSB
  181  00CA: 1D               DCR E               ; интервал отработан
  182  00CB: 7B               MOV A,E
  183  00CC: B7               ORA A
  184  00CD: C2 ED 00         JNZ RXE             ; кадр не кончился
  185                    ; --- РЕЛИЗ: 12 выборок собраны (E=0), L = байт, HL = TSB ---
  186  00D0: 79               MOV A,C             ; TX свободен?
  187  00D1: FE FF            CPI 0FFh
  188  00D3: C2 ED 00         JNZ RXE             ; занят -- байт отбрасываем (v1, без очереди)
  189  00D6: 7D               MOV A,L             ; принятый байт
  190  00D7: 32 01 80         STA BYTE0           ; ДИАГ: байт на дисплей
  191  00DA: 57               MOV D,A             ; эхо, кадр 1 = байт
  192  00DB: 2A 02 80         LHLD TSB            ; очередь: tl-hi, tl-lo (из таймлайна)
  193  00DE: 7C               MOV A,H
  194  00DF: 32 04 80         STA QBUF
  195  00E2: 7D               MOV A,L
  196  00E3: 32 05 80         STA QBUF+1
  197  00E6: 3E 02            MVI A,2
  198  00E8: 32 07 80         STA QCNT
  199  00EB: 0E 0B            MVI C,0Bh           ; следующий фронт = старт-бит эха
  200  00ED: FB       RXE:    EI
  201  00EE: C9               RET
  202            
  203            ; ---- MAIN ----
  204  0100: -                ORG 0100h
  205  0100: 31 FF FF MAIN:   LXI SP,0FFFFh       ; стек -- верх ОЗУ (конвенция v2)
  206  0103: 3E C0            MVI A,0C0h          ; SOD=1 (idle) -- гасим возможный BREAK
  207  0105: 30               SIM                 ; после сброса SOD=0; TX-маска CPLD и так
  208                                        ; держит '1' 51,2 мкс, но не полагаемся
  209  0106: 3E 00            MVI A,0             ; ДИАГ: ОЗУ -- с нуля (дисплей «0.0.0.0.»)
  210  0108: 32 00 80         STA MUXI
  211  010B: 32 01 80         STA BYTE0
  212  010E: 32 02 80         STA TSB
  213  0111: 32 03 80         STA TSB+1
  214  0114: 32 06 80         STA SSELF
  215  0117: 32 07 80         STA QCNT
  216  011A: 06 00            MVI B,0             ; счётчик чистых стартов
  217  011C: 1E 00            MVI E,0             ; RX покой
  218  011E: 3E 1B            MVI A,SIMW
  219  0120: 30               SIM                 ; маски: 5.5/6.5 закрыты, 7.5 разрешён
  220  0121: 16 3E            MVI D,'>'           ; баннер-символ (один)
  221  0123: 0E 0B            MVI C,0Bh           ; фаза: следующий фронт = старт '>'
  222  0125: 3E 08            MVI A,TMR_N
  223  0127: D3 04            OUT TMRP            ; пуск таймера
  224  0129: FB               EI
  225  012A: 79       BAN:    MOV A,C             ; ждём конца баннера (C -> 0FFh)
  226  012B: FE FF            CPI 0FFh
  227  012D: C2 2A 01         JNZ BAN
  228            ; --- главный цикл: опрос SID (приём) + эхо + мультиплексия дисплея ---
  229  0130: CD 70 01 POLL:   CALL DMUX           ; шаг дисплея (EI включён; портит A/флаги)
  230  0133: F3               DI                  ; опрос БЕЗ ISR: «залетевший» фронт не
  231  0134: 20               RIM                 ; обслужится, латч ловится -- выбросим ниже
  232  0135: E6 80            ANI 80h
  233  0137: C2 30 01         JNZ POLL            ; 1 = idle
  234                    ; --- старт-бит пойман (SID=0) ---
  235  013A: 3E 04            MVI A,RXN1          ; 0,5 бита: загрузка ДО сброса латча --
  236  013C: D3 04            OUT TMRP            ; залетевший фронт мог быть только ДО неё
  237  013E: 3E 08            MVI A,SIMLR
  238  0140: 30               SIM                 ; атомарный выброс латча, гонки нет
  239  0141: 79               MOV A,C             ; ДИАГ: ЧТО поймали? свой эхо-кадр?
  240  0142: FE FF            CPI 0FFh            ; (TX занят = ловим во время СВОЕЙ передачи)
  241  0144: CA 51 01         JZ CATCHN
  242  0147: 3A 06 80         LDA SSELF           ; свой кадр: SSELF++ (признак петли!)
  243  014A: 3C               INR A
  244  014B: 32 06 80         STA SSELF
  245  014E: C3 52 01         JMP ARMED
  246  0151: 04       CATCHN: INR B               ; чистый старт: B++
  247  0152: AF       ARMED:  XRA A               ; таймлайн -- с нуля
  248  0153: 32 02 80         STA TSB
  249  0156: 32 03 80         STA TSB+1
  250  0159: 2E 00            MVI L,0             ; накопитель байта -- с нуля
  251  015B: 1E 0C            MVI E,12            ; 12 интервалов: 4Q (старт) + 11x8Q
  252  015D: FB               EI
  253  015E: 7B       RWAIT:  MOV A,E             ; ждём конца приёма (E -> 0 в релизе)
  254  015F: B7               ORA A
  255  0160: C2 5E 01         JNZ RWAIT
  256  0163: 79       EWAIT:  MOV A,C             ; ждём конца эха (C -> 0FFh, вся очередь)
  257  0164: FE FF            CPI 0FFh
  258  0166: C2 63 01         JNZ EWAIT
  259  0169: C3 30 01         JMP POLL
  260            
  261            ; ---- ДИАГНОСТИКА: мультиплексия дисплея (по разряду за вызов) ----
  262            ; DIG0 = B mod 16 (чистые старты), DIG1 = SSELF mod 16 (захваты своего
  263            ; эха), DIG2/DIG3 = принятый байт (lo/hi). ПОРТИТ ТОЛЬКО A/флаги.
  264  0170: -                ORG 0170h           ; v3: сдвинут (ISR/MAIN занимают до 016Ah)
  265  0170: 3A 00 80 DMUX:   LDA MUXI
  266  0173: 3C               INR A
  267  0174: E6 03            ANI 3
  268  0176: 32 00 80         STA MUXI
  269  0179: FE 01            CPI 1
  270  017B: CA 93 01         JZ DMX1
  271  017E: FE 02            CPI 2
  272  0180: CA A0 01         JZ DMX2
  273  0183: FE 03            CPI 3
  274  0185: CA AD 01         JZ DMX3
  275  0188: 78               MOV A,B             ; индекс 0: чистые старты
  276  0189: E6 0F            ANI 0Fh
  277  018B: CD BE 01         CALL HSEG
  278  018E: 3E 01            MVI A,01h
  279  0190: D3 01            OUT DIGP
  280  0192: C9               RET
  281  0193: 3A 06 80 DMX1:   LDA SSELF           ; индекс 1: захваты своего эха (ждём 0!)
  282  0196: E6 0F            ANI 0Fh
  283  0198: CD BE 01         CALL HSEG
  284  019B: 3E 02            MVI A,02h
  285  019D: D3 01            OUT DIGP
  286  019F: C9               RET
  287  01A0: 3A 01 80 DMX2:   LDA BYTE0           ; индекс 2: мл. ниббл байта
  288  01A3: E6 0F            ANI 0Fh
  289  01A5: CD BE 01         CALL HSEG
  290  01A8: 3E 04            MVI A,04h
  291  01AA: D3 01            OUT DIGP
  292  01AC: C9               RET
  293  01AD: 3A 01 80 DMX3:   LDA BYTE0           ; индекс 3: ст. ниббл байта
  294  01B0: 0F               RRC
  295  01B1: 0F               RRC
  296  01B2: 0F               RRC
  297  01B3: 0F               RRC
  298  01B4: E6 0F            ANI 0Fh
  299  01B6: CD BE 01         CALL HSEG
  300  01B9: 3E 08            MVI A,08h
  301  01BB: D3 01            OUT DIGP
  302  01BD: C9               RET
  303  01BE: E5       HSEG:   PUSH H              ; A = ниббл -> OUT SEGP = паттерн; HL целы
  304  01BF: 67               MOV H,A
  305  01C0: 2E D0            MVI L,SEGTAB & 0FFh
  306  01C2: 85               ADD L               ; lo + ниббл: переноса нет (lo=D0h)
  307  01C3: 6F               MOV L,A
  308  01C4: 26 01            MVI H,SEGTAB//256
  309  01C6: 7E               MOV A,M
  310  01C7: E1               POP H
  311  01C8: D3 00            OUT SEGP
