    1            ; =====================================================================
    2            ; beta/01_timer -- ТЕСТ-ПРОШИВКА ПЗУ: ПОЛНОЦЕННЫЙ UART (ПРИЁМ-ПЕРЕДАЧА,
    3            ; ЭХО) + ДИАГНОСТИКА ВЕРСИЯ 4: v3 + ИСПРАВЛЕННЫЙ ВВОД.
    4            ; Интервальный таймер CPLD (beta v3.3b3, порт 04h -> RST 7.5),
    5            ; 2400 бод (TMR_N=8), 8N1.
    6            ;
    7            ; ЭТО diag v3 БЕЗ ИЗМЕНЕНИЯ ПРОТОКОЛА, НО С ИСПРАВЛЕННЫМ ПРИЁМОМ.
    8            ; Дамп ПЗУ владельца (10-24) подтвердил: образ = diag3, а поведение --
    9            ; эхо [00][00][00] на ЛЮБОЙ ввод, BYTE0 = 00 всегда. Причина найдена
   10            ; в коде выборки, две ошибки:
   11            ;
   12            ;   БАГ 1 (фатальный): в обеих ветвях выборки стоял RAR с комментарием
   13            ;   "CY <- бит линии". RAR кладёт в CY бит A0 (=0), а SID (A7) уезжает
   14            ;   в A6 и уничтожается следующим MOV A,L / LHLD TSB. В CY попадал
   15            ;   ноль => TSB паковал нули, L не получал бит ниоткуда => ЛЮБОЙ кадр
   16            ;   декодировался как 00. Исправлено: RLC (CY <- A7 = SID).
   17            ;
   18            ;   БАГ 2 (скрытый): LHLD TSB в RXPACK каждый тик ПЕРЕЗАПИСЫВАЕТ L из
   19            ;   ОЗУ (8003h) -- накопитель байта в L не доживал бы до релиза даже с
   20            ;   рабочей выборкой (на релизе вышел бы tl-lo, а не байт). Исправлено:
   21            ;   PUSH H перед упаковкой таймлайна, POP H после SHLD.
   22            ;
   23            ;   БАГ 3 (порядок эха, пойман instruction-level симуляцией): упаковка
   24            ;   TSB идёт цепочкой RAL "H-первым" (MOV A,H/RAL/MOV H,A/MOV A,L/RAL/
   25            ;   MOV L,A) -- это (V<<1)|бит для пары V=(L:H), поэтому в ОЗУ лежит
   26            ;   8002h = tl-hi, 8003h = tl-lo (как и задокументировано). Но релиз
   27            ;   копировал пару через LHLD TSB / MOV A,H / MOV A,L: LHLD даёт
   28            ;   L=8002h=tl-hi, H=8003h=tl-lo, а в очередь уходил H (tl-lo) ПЕРВЫМ
   29            ;   -> эхо [байт][tl-lo][tl-hi] ('a' дала бы 61 37 04 вместо 61 04 37).
   30            ;   Исправлено: прямые LDA/STA в порядке ОЗУ: LDA TSB (tl-hi) -> QBUF,
   31            ;   LDA TSB+1 (tl-lo) -> QBUF+1.
   32            ;
   33            ;   ПРИМЕЧАНИЕ: TX-часть (SIM 40h = старт, C0h = единица/mark, т.е.
   34            ;   SDE=A6, SOD-data=A7) НЕ ТРОНУТА -- раскладка подтверждена
   35            ;   аппаратно (баннер timer_test_uart v4 и эхо 'ю' доходили).
   36            ;
   37            ; РЕЗУЛЬТАТ ВИДЕН В HEX-ТЕРМИНАЛЕ: на каждый принятый кадр плата шлёт
   38            ; ТРИ байта: [принятый байт][таймлайн hi][таймлайн lo].
   39            ;
   40            ; Файл в кодировке CP1251 (как все исходники проекта, кроме asm85.py).
   41            ; UTF-8 мастер: scripts/uart/uart_echo_diag4.utf8.asm
   42            ;
   43            ; Сборка (из этой папки):
   44            ;   python3 asm85.py uart_echo_diag4.asm -o uart_echo_diag4.hex -l uart_echo_diag4.lst
   45            ;
   46            ; Железо: retro_PCLD_board V2 + CPLD beta v3.3b3 + USB-мост CH340G (U6).
   47            ; CPLD НЕ МЕНЯЛСЯ (транзит SID <= RX безусловен, фит проверен по .rpt:
   48            ; RX = вход P38, SID = выход P73, SOD = вход P72, TX = выход P39).
   49            ; Прошивается ВМЕСТО монитора fw_mon с нулевого смещения flash A29040B.
   50            ;
   51            ; КАК ЧИТАТЬ ЭХО (hex-терминал, вводить по ОДНОМУ символу):
   52            ;   [байт][tl-hi][tl-lo], таймлайн = 12 бит MSB-first:
   53            ;   tl-hi = 0000 s d0 d1 d2, tl-lo = d3 d4 d5 d6 d7 t1 t2 t3,
   54            ;   где s = выборка старта (~0,5 бита; должна быть 0), t1..t3 = хвост
   55            ;   (стоп/idle; должны быть 1,1,1).
   56            ;   ОЖИДАНИЯ при 2400 (теперь достижимы; проверены instruction-level
   57            ;   симуляцией sim_diag4_isr.py):
   58            ;                       'a' -> 61 04 37;  'o' -> 6F 07 B7;
   59            ;                       Enter -> 0D 05 87;  '3' -> 33 06 67.
   60            ;   00 00 00  -- линия НИЗКАЯ ВО ВСЕХ 12 точках (в т.ч. на старте!)
   61            ;                кадр "съеден" целиком: линию прижимает на ~5 мс;
   62            ;   s=1 (tl-hi >= 08h) -- пойманный "старт" вернулся в 1 (глитч/чужой
   63            ;                кадр), данные читались из единиц;
   64            ;   хвост 0 (tl-lo & 07 != 07) -- сетка уползла к концу кадра;
   65            ;   сдвиг узора при верном старте -- сетка/скорость источника не 2400.
   66            ; ДИСПЛЕЙ: [B = счётчик чистых стартов mod 16]
   67            ;          [S = счётчик ЗАХВАТОВ ВО ВРЕМЯ СВОЕГО ЭХА mod 16 (S>0 =
   68            ;           плата ловит собственную передачу -- петля/самозапуск!)]
   69            ;          [байт lo][байт hi].  После RESET: «0.0.0.0.».
   70            ;
   71            ; ТАЙМИНГ ПРИЁМА (сетка d0..d7 НЕ ИЗМЕНИЛАСЬ): MAIN ловит старт (RIM,
   72            ; DI), OUT TMRP <- RXN1 = N/2 = 4 кванта (0,5 бита) -> SIM 08h (атомарный
   73            ; выброс латча) -> MVI E,12 -> EI. Первый фронт через (3..4) кванта:
   74            ; выборка s на ~0,43-0,55 бита (середина старта). Далее ре-арм в векторе
   75            ; 003Ch = ровно 8Q: d0 на 1,5 бита КАК РАНЬШЕ, d7 на 8,5 бита, хвост
   76            ; 9,5/10,5/11,5 бита. Кадр = 12 интервалов, релиз при E=0.
   77            ; Каждая выборка пакуется в TSB (ОЗУ 8002h/8003h, MSB-first) и в
   78            ; накопитель L (LSB-first): RLC -> RAR в L -> RLC -> PUSH H / LHLD /
   79            ; RAL / RAL / SHLD / POP H, ~35 мкс на интервал (период 8Q = 405 мкс --
   80            ; запас).
   81            ;
   82            ; ЭХО: TX-автомат v4 однобайтовый + ОЧЕРЕДЬ 2 байта таймлайна в ОЗУ
   83            ; (QCNT 8007h): на стоп-фазе, если очередь не пуста, D <- следующий
   84            ; байт, фаза 0Ch = ХОЛОСТОЙ БИТ (урок v4: кадры не вплотную). Порядок
   85            ; эха: байт, tl-hi, tl-lo. Приоритет RX над TX сохранён (вентиль E>0:
   86            ; TX замирает, SOD держит уровень; очередь ждёт в ОЗУ).
   87            ;
   88            ; РЕГИСТРЫ: C -- фаза TX; D -- сдвиговый TX; E -- интервалы RX (12..1,
   89            ;   0 = покой; вентиль RX-приоритета); L -- накопитель байта (d0..d7,
   90            ;   в v4 доживает до релиза); B -- счётчик чистых стартов;
   91            ;   A/флаги -- рабочие. DMUX (MAIN) портит только A/флаги (HL через
   92            ;   PUSH/POP). Вложенных прерываний нет.
   93            ;
   94            ; ОЗУ (SRAM с 8000h): 8000h MUXI, 8001h BYTE0, 8002h-03h TSB (таймлайн),
   95            ; 8004h-05h QBUF (очередь эха), 8006h SSELF, 8007h QCNT. Стек на FFFF.
   96            ; =====================================================================
   97            
   98            ; ---- параметры (можно переопределить ключами -D) ----
   99            TMR_N   EQU 8               ; бит = N x Q: 8 -> ~2460 бод (цель 2400)
  100            RXN1    EQU TMR_N//2        ; 1-й зазор = 0,5 бита (выборка СТАРТА)
  101            SIMW    EQU 1Bh             ; SIM: MSE=1 -- 5.5/6.5 маскировать,
  102                                        ; 7.5 разрешить; R7.5=1 -- латч сброшен
  103            SIMLR   EQU 08h             ; SIM: R7.5=1, MSE=0, SDE=0 -- только сброс
  104                                        ; латча RST 7.5
  105            
  106            ; ---- порты ----
  107            SEGP    EQU 00h             ; SEG: D0=a..D6=g, D7=dp (1 = горит)
  108            DIGP    EQU 01h             ; DIG: D3-D0 разряды (D4 = SND -- не трогаем)
  109            TMRP    EQU 04h             ; таймер: запись N (период = N x Q)
  110            
  111            ; ---- ОЗУ (SRAM с 8000h, стек на FFFF -- конфликтов нет) ----
  112            MUXI    EQU 8000h           ; индекс разряда дисплея 0..3
  113            BYTE0   EQU 8001h           ; последний принятый байт (для дисплея)
  114            TSB     EQU 8002h           ; таймлайн 12 бит (hi=8002h, lo=8003h)
  115            QBUF    EQU 8004h           ; очередь эха: 8004h = tl-hi, 8005h = tl-lo
  116            SSELF   EQU 8006h           ; счётчик захватов во время своего эха
  117            QCNT    EQU 8007h           ; счётчик очереди эха 0..2
  118            
  119            ; ---- векторы ----
  120  0000: -                ORG 0000h
  121  0000: C3 00 01         JMP MAIN            ; сброс
  122            ; Вектор 003Ch занят ре-армом ЦЕЛИКОМ (MVI+OUT = 003Ch-003Fh); ре-арм
  123            ; ПЕРВЫМ действием: период = ровно N тиков, длина ISR в сетку не входит.
  124  003C: -                ORG 003Ch
  125  003C: 3E 08            MVI A,TMR_N         ; РЕ-АРМ СЕТКИ (7 тактов)
  126  003E: D3 04            OUT TMRP            ; (10 тактов) -- 8 квантов = 1 бит
  127            
  128            ; ---- ISR: вентиль RX -> TX-автомат -> RX-автомат ----
  129  0040: -                ORG 0040h
  130  0040: 7B               MOV A,E             ; вентиль: RX активен (E>0)?
  131  0041: B7               ORA A
  132  0042: CA 48 00         JZ TXRUN
  133  0045: C3 A1 00         JMP RX              ; RX активен: TX НЕ двигаем (SOD держит уровень)
  134  0048: 79       TXRUN:  MOV A,C             ; --- TX-автомат ---
  135  0049: FE FF            CPI 0FFh            ; 0FFh = покой?
  136  004B: CA 9E 00         JZ TXIDLE
  137  004E: 0D               DCR C               ; следующая фаза
  138  004F: 79               MOV A,C
  139  0050: FE 0A            CPI 0Ah             ; 0Ah = старт-бит
  140  0052: CA 6D 00         JZ TXST
  141  0055: FE 0B            CPI 0Bh             ; 0Bh = холостой бит (урок v4): SOD=1
  142  0057: CA 73 00         JZ TXIDLBIT
  143  005A: FE 01            CPI 1               ; 01h = стоп-бит
  144  005C: CA 79 00         JZ TXSP
  145            ; --- фаза данных (d0..d7): байт в D ---
  146  005F: 7A               MOV A,D
  147  0060: 0F               RRC                 ; A7 <- D0
  148  0061: E6 80            ANI 80h
  149  0063: F6 40            ORI 40h             ; SDE=1; MSE=0 -- маски не трогаем
  150  0065: 30               SIM                 ; SOD <- бит
  151  0066: 37               STC                 ; единицы едут сверху
  152  0067: 7A               MOV A,D
  153  0068: 1F               RAR                 ; D >>= 1
  154  0069: 57               MOV D,A
  155  006A: C3 A1 00         JMP RX
  156  006D: 3E 40    TXST:   MVI A,40h           ; SOD=0 -- старт-бит (D заряжен заранее)
  157  006F: 30               SIM
  158  0070: C3 A1 00         JMP RX
  159  0073: 3E C0    TXIDLBIT: MVI A,0C0h        ; холостой бит: SOD=1 (C уже 0Bh ->
  160  0075: 30               SIM                 ;   следующий DCR даст 0Ah = старт)
  161  0076: C3 A1 00         JMP RX
  162  0079: 3E C0    TXSP:   MVI A,0C0h          ; SOD=1 -- стоп-бит
  163  007B: 30               SIM
  164  007C: 3A 07 80         LDA QCNT            ; очередь таймлайна?
  165  007F: B7               ORA A
  166  0080: CA 99 00         JZ TXDONE
  167  0083: 3D               DCR A
  168  0084: 32 07 80         STA QCNT            ; следующий байт очереди:
  169  0087: 57               MOV D,A             ;   было 2 -> QBUF, было 1 -> QBUF+1
  170  0088: FE 01            CPI 1
  171  008A: 2E 04            MVI L,QBUF & 0FFh
  172  008C: CA 90 00         JZ TXSP1
  173  008F: 2C               INR L
  174  0090: 26 80    TXSP1:  MVI H,QBUF//256
  175  0092: 7E               MOV A,M
  176  0093: 57               MOV D,A
  177  0094: 0E 0C            MVI C,0Ch           ; холостой бит, затем старт очередного
  178  0096: C3 A1 00         JMP RX
  179  0099: 0E FF    TXDONE: MVI C,0FFh          ; очередь пуста -- покой
  180  009B: C3 A1 00         JMP RX
  181  009E: 3E C0    TXIDLE: MVI A,0C0h          ; покой: SOD=1
  182  00A0: 30               SIM
  183            ; --- RX-автомат: каждая выборка -> бит таймлайна TSB; данные ещё и в L ---
  184  00A1: 7B       RX:     MOV A,E
  185  00A2: B7               ORA A
  186  00A3: CA F1 00         JZ RXE              ; E=0 -- приём не активен
  187  00A6: FE 0C            CPI 12              ; 1-й интервал = старт-верификация (мимо L)
  188  00A8: CA BB 00         JZ RXBIT
  189  00AB: FE 04            CPI 4               ; E=3..1 -- хвост (мимо L)
  190  00AD: FA BB 00         JM RXBIT
  191  00B0: 20               RIM                 ; SID -> A7 (транзит RX->SID в CPLD)
  192  00B1: E6 80            ANI 80h
  193  00B3: 07               RLC                 ; v4: CY <- БИТ ЛИНИИ (в v3 был RAR: SID
  194  00B4: 7D               MOV A,L             ;   уезжал в A6, в CY попадал 0!)
  195  00B5: 1F               RAR                 ; L = (L>>1) | бит -- d0..d7, LSB-first
  196  00B6: 6F               MOV L,A
  197  00B7: 07               RLC                 ; v4: CY <- бит снова (A7 сдвинутого байта)
  198  00B8: C3 BF 00         JMP RXPACK
  199  00BB: 20       RXBIT:  RIM                 ; старт/хвост: только в таймлайн
  200  00BC: E6 80            ANI 80h
  201  00BE: 07               RLC                 ; v4: CY <- бит линии
  202  00BF: E5       RXPACK: PUSH H              ; v4: L = накопитель байта -- LHLD TSB
  203  00C0: 2A 02 80         LHLD TSB            ;   его затирает; HL спасаем на упаковку
  204  00C3: 7C               MOV A,H
  205  00C4: 17               RAL
  206  00C5: 67               MOV H,A
  207  00C6: 7D               MOV A,L
  208  00C7: 17               RAL
  209  00C8: 6F               MOV L,A
  210  00C9: 22 02 80         SHLD TSB
  211  00CC: E1               POP H               ; v4: байт возвращён в L
  212  00CD: 1D               DCR E               ; интервал отработан
  213  00CE: 7B               MOV A,E
  214  00CF: B7               ORA A
  215  00D0: C2 F1 00         JNZ RXE             ; кадр не кончился
  216                    ; --- РЕЛИЗ: 12 выборок собраны (E=0), L = байт, HL = TSB ---
  217  00D3: 79               MOV A,C             ; TX свободен?
  218  00D4: FE FF            CPI 0FFh
  219  00D6: C2 F1 00         JNZ RXE             ; занят -- байт отбрасываем (v1, без очереди)
  220  00D9: 7D               MOV A,L             ; принятый байт
  221  00DA: 32 01 80         STA BYTE0           ; ДИАГ: байт на дисплей
  222  00DD: 57               MOV D,A             ; эхо, кадр 1 = байт
  223  00DE: 3A 02 80         LDA TSB             ; v4: в ОЗУ 8002h = tl-hi, 8003h = tl-lo
  224  00E1: 32 04 80         STA QBUF            ;   (так ложится H-first цепочка RAL);
  225  00E4: 3A 03 80         LDA TSB+1           ;   LHLD в релизе переворачивал пару ->
  226  00E7: 32 05 80         STA QBUF+1          ;   эхо шло [tl-lo][tl-hi]. Теперь прямо:
  227  00EA: 3E 02            MVI A,2             ;   [байт][tl-hi][tl-lo] по протоколу
  228  00EC: 32 07 80         STA QCNT
  229  00EF: 0E 0B            MVI C,0Bh           ; следующий фронт = старт-байт эха
  230  00F1: FB       RXE:    EI
  231  00F2: C9               RET
  232            
  233            ; ---- MAIN ----
  234  0100: -                ORG 0100h
  235  0100: 31 FF FF MAIN:   LXI SP,0FFFFh       ; стек -- верх ОЗУ (конвенция v2)
  236  0103: 3E C0            MVI A,0C0h          ; SOD=1 (idle) -- гасим возможный BREAK
  237  0105: 30               SIM                 ; после сброса SOD=0; TX-маска CPLD и так
  238                                        ; держит '1' 51,2 мкс, но не полагаемся
  239  0106: 3E 00            MVI A,0             ; ДИАГ: ОЗУ -- с нуля (дисплей «0.0.0.0.»)
  240  0108: 32 00 80         STA MUXI
  241  010B: 32 01 80         STA BYTE0
  242  010E: 32 02 80         STA TSB
  243  0111: 32 03 80         STA TSB+1
  244  0114: 32 06 80         STA SSELF
  245  0117: 32 07 80         STA QCNT
  246  011A: 06 00            MVI B,0             ; счётчик чистых стартов
  247  011C: 1E 00            MVI E,0             ; RX покой
  248  011E: 3E 1B            MVI A,SIMW
  249  0120: 30               SIM                 ; маски: 5.5/6.5 закрыты, 7.5 разрешён
  250  0121: 16 3E            MVI D,'>'           ; баннер-символ (один)
  251  0123: 0E 0B            MVI C,0Bh           ; фаза: следующий фронт = старт '>'
  252  0125: 3E 08            MVI A,TMR_N
  253  0127: D3 04            OUT TMRP            ; пуск таймера
  254  0129: FB               EI
  255  012A: 79       BAN:    MOV A,C             ; ждём конца баннера (C -> 0FFh)
  256  012B: FE FF            CPI 0FFh
  257  012D: C2 2A 01         JNZ BAN
  258            ; --- главный цикл: опрос SID (приём) + эхо + мультиплексия дисплея ---
  259  0130: CD 70 01 POLL:   CALL DMUX           ; шаг дисплея (EI включён; портит A/флаги)
  260  0133: F3               DI                  ; опрос БЕЗ ISR: «залетевший» фронт не
  261  0134: 20               RIM                 ; обслужится, латч ловится -- выбросим ниже
  262  0135: E6 80            ANI 80h
  263  0137: C2 30 01         JNZ POLL            ; 1 = idle
  264                    ; --- старт-бит пойман (SID=0) ---
  265  013A: 3E 04            MVI A,RXN1          ; 0,5 бита: загрузка ДО сброса латча --
  266  013C: D3 04            OUT TMRP            ; залетевший фронт мог быть только ДО неё
  267  013E: 3E 08            MVI A,SIMLR
  268  0140: 30               SIM                 ; атомарный выброс латча, гонки нет
  269  0141: 79               MOV A,C             ; ДИАГ: ЧТО поймали? свой эхо-кадр?
  270  0142: FE FF            CPI 0FFh            ; (TX занят = ловим во время СВОЕЙ передачи)
  271  0144: CA 51 01         JZ CATCHN
  272  0147: 3A 06 80         LDA SSELF           ; свой кадр: SSELF++ (признак петли!)
  273  014A: 3C               INR A
  274  014B: 32 06 80         STA SSELF
  275  014E: C3 52 01         JMP ARMED
  276  0151: 04       CATCHN: INR B               ; чистый старт: B++
  277  0152: AF       ARMED:  XRA A               ; таймлайн -- с нуля
  278  0153: 32 02 80         STA TSB
  279  0156: 32 03 80         STA TSB+1
  280  0159: 2E 00            MVI L,0             ; накопитель байта -- с нуля
  281  015B: 1E 0C            MVI E,12            ; 12 интервалов: 4Q (старт) + 11x8Q
  282  015D: FB               EI
  283  015E: 7B       RWAIT:  MOV A,E             ; ждём конца приёма (E -> 0 в релизе)
  284  015F: B7               ORA A
  285  0160: C2 5E 01         JNZ RWAIT
  286  0163: 79       EWAIT:  MOV A,C             ; ждём конца эха (C -> 0FFh, вся очередь)
  287  0164: FE FF            CPI 0FFh
  288  0166: C2 63 01         JNZ EWAIT
  289  0169: C3 30 01         JMP POLL
  290            
  291            ; ---- ДИАГНОСТИКА: мультиплексия дисплея (по разряду за вызов) ----
  292            ; DIG0 = B mod 16 (чистые старты), DIG1 = SSELF mod 16 (захваты своего
  293            ; эха), DIG2/DIG3 = принятый байт (lo/hi). ПОРТИТ ТОЛЬКО A/флаги.
  294  0170: -                ORG 0170h           ; v3: сдвинут (ISR/MAIN занимают до 016Ah)
  295  0170: 3A 00 80 DMUX:   LDA MUXI
  296  0173: 3C               INR A
  297  0174: E6 03            ANI 3
  298  0176: 32 00 80         STA MUXI
  299  0179: FE 01            CPI 1
  300  017B: CA 93 01         JZ DMX1
  301  017E: FE 02            CPI 2
  302  0180: CA A0 01         JZ DMX2
  303  0183: FE 03            CPI 3
  304  0185: CA AD 01         JZ DMX3
  305  0188: 78               MOV A,B             ; индекс 0: чистые старты
  306  0189: E6 0F            ANI 0Fh
  307  018B: CD BE 01         CALL HSEG
  308  018E: 3E 01            MVI A,01h
  309  0190: D3 01            OUT DIGP
  310  0192: C9               RET
  311  0193: 3A 06 80 DMX1:   LDA SSELF           ; индекс 1: захваты своего эха (ждём 0!)
  312  0196: E6 0F            ANI 0Fh
  313  0198: CD BE 01         CALL HSEG
  314  019B: 3E 02            MVI A,02h
  315  019D: D3 01            OUT DIGP
  316  019F: C9               RET
  317  01A0: 3A 01 80 DMX2:   LDA BYTE0           ; индекс 2: мл. ниббл байта
  318  01A3: E6 0F            ANI 0Fh
  319  01A5: CD BE 01         CALL HSEG
  320  01A8: 3E 04            MVI A,04h
  321  01AA: D3 01            OUT DIGP
  322  01AC: C9               RET
  323  01AD: 3A 01 80 DMX3:   LDA BYTE0           ; индекс 3: ст. ниббл байта
  324  01B0: 0F               RRC
  325  01B1: 0F               RRC
  326  01B2: 0F               RRC
  327  01B3: 0F               RRC
  328  01B4: E6 0F            ANI 0Fh
  329  01B6: CD BE 01         CALL HSEG
  330  01B9: 3E 08            MVI A,08h
  331  01BB: D3 01            OUT DIGP
  332  01BD: C9               RET
  333  01BE: E5       HSEG:   PUSH H              ; A = ниббл -> OUT SEGP = паттерн; HL цел
  334  01BF: 67               MOV H,A
  335  01C0: 2E D0            MVI L,SEGTAB & 0FFh
  336  01C2: 85               ADD L               ; lo + ниббл: переноса нет (lo=D0h)
  337  01C3: 6F               MOV L,A
  338  01C4: 26 01            MVI H,SEGTAB//256
  339  01C6: 7E               MOV A,M
  340  01C7: E1               POP H
  341  01C8: D3 00            OUT SEGP
  342  01CA: C9               RET
  343            
  344  01D0: -                ORG 01D0h           ; lo = D0h: D0h+0Fh без переноса -- ADD L точен
  345  01D0: 3F 06 5B 4F 66 6D 7D 07 SEGTAB: DB 3Fh,06h,5Bh,4Fh,66h,6Dh,7Dh,07h  ; '0'-'7' (a..g, dp=0)
  346  01D8: 7F 6F 77 7C 39 5E 79 71         DB 7Fh,6Fh,77h,7Ch,39h,5Eh,79h,71h  ; '8'-'F'
  347  01E0: -                END
