    1            ; =====================================================================
    2            ; beta/01_timer -- РЕФЕРЕНС: ПОЛНОСТЬЮ СОФТВЕРНЫЙ UART (задержки --
    3            ; счёт тактов), для сравнения с timer_test_uart.asm (таймерный вариант).
    4            ; Тот же текст на экране, тот же дисплей «....».
    5            ;
    6            ; Файл в кодировке CP1251. Прошивается так же: offset 0 ВМЕСТО fw_mon;
    7            ; после теста вернуть монитор. Прошивать НЕ ОБЯЗАТЕЛЬНО -- это эталон
    8            ; для таблицы сравнения «таймер против софт-делеев» в README.
    9            ;
   10            ; Сборка (из этой папки):
   11            ;   python3 asm85.py uart_sw_test.asm -o uart_sw_test.hex -l uart_sw_test.lst
   12            ;
   13            ; ТЕХНОЛОГИЯ. Бит = 1042 такта CPU (2400 бод при 2,5 МГц:
   14            ; 1/2400 = 416,67 мкс = 1041,7 такта). Баланс тактов в цикле бита:
   15            ;   выдать бит        26 (MOV A,E + ANI + RRC + ORI + SIM)
   16            ;   сдвинуть DE >> 1  24 (2 x MOV/RAR/MOV, 16-битный сдвиг)
   17            ;   пауза            978 (LXI H,40 + 2 NOP + 40 x {DCX H,MOV A,H,ORA L,JNZ})
   18            ;   DCR B + JNZ       14
   19            ;   ИТОГО           1042 такта = 416,8 мкс -> 2399,2 бода (погрешность 0,03%)
   20            ; Последний бит кадра (стоп) на 3 такта короче (JNZ не переходит) --
   21            ; 0,7% бита, приёмнику безразлично. Кадр: старт(0), d0..d7 (LSB-first),
   22            ; стоп(1) -- 10 бит в паре DE (см. TXBYTE).
   23            ;
   24            ; ЦЕНА ПОДХОДА (почему за таймером -- будущее, см. сравнение в README):
   25            ;   - калибровка РУЧНАЯ и хрупкая: вставка любой инструкции в цикл бита
   26            ;     или смена тактовой частоты сдвигает ВСЕ биты -- пересчитывай LXI;
   27            ;   - CPU занят 100% всё время строки (~68 мс), прерывания запрещены;
   28            ;   - смена скорости -- пересчёт констант задержки, а не один байт N.
   29            ;
   30            ; Терминал: 2400 8N1. Прерывания не используются (EI нет; RST 7.5
   31            ; замаскирован + латч сброшен; таймер не запускался -- INIT-пробег
   32            ; счётчика FFh->0 после сброса никакого фронта в CPU не даёт).
   33            ;
   34            ; ВНИМАНИЕ: фактический clk ~25,2 МГц («сверчок», см. README) -> CPU
   35            ; ~2,52 МГц -> фактический бит 413,4 мкс -> 2419 бод (+0,8%) -- в допуске.
   36            ; В этом преимущество и ловушка софт-делеев: скорость следует за клоком,
   37            ; но калибровка привязана к ЧИСЛУ тактов, а не к кванту таймера.
   38            ; =====================================================================
   39            
   40            SEGP    EQU 00h             ; SEG: D0=a..D6=g, D7=dp
   41            DIGP    EQU 01h             ; DIG/SND: D3-D0 разряды
   42            
   43  0000: -                ORG 0000h
   44  0000: C3 06 00         JMP MAIN
   45            ; ---- MAIN ----
   46  0006: -                ORG 0006h
   47  0006: F3       MAIN:   DI                  ; прерывания не нужны (и не включаются)
   48  0007: 3E C0            MVI A,0C0h          ; SOD=1 (idle) -- гасим возможный BREAK
   49  0009: 30               SIM
   50  000A: 3E 1F            MVI A,1Fh           ; подстраховка: маскировать ВСЁ (5.5/6.5/7.5)
   51  000C: 30               SIM                 ; и сбросить латч RST 7.5 (таймер не пущен)
   52  000D: 3E 80            MVI A,80h           ; дисплей: dp на всех разрядах («....»)
   53  000F: D3 00            OUT SEGP
   54  0011: 3E 0F            MVI A,0Fh           ; все 4 разряда статически
   55  0013: D3 01            OUT DIGP
   56  0015: 31 FF FF         LXI SP,0FFFFh       ; стек для CALL/RET
   57            ; ---- передача строки, повтор бесконечно ----
   58  0018: 21 62 00 SWLP:   LXI H,MSG
   59  001B: 7E       SWNXT:  MOV A,M
   60  001C: B7               ORA A               ; 00h = конец строки
   61  001D: CA 28 00         JZ SWGAP
   62  0020: 4F               MOV C,A
   63  0021: CD 2E 00         CALL TXBYTE         ; блокирующая передача 1 символа (~4,17 мс)
   64  0024: 23               INX H
   65  0025: C3 1B 00         JMP SWNXT
   66  0028: CD 58 00 SWGAP:  CALL DLGAP          ; пауза ~5,4 мс
   67  002B: C3 18 00         JMP SWLP
   68            ; ---- TXBYTE: C = байт, 2400 бод 8N1, кадр в паре DE (LSB-first) ----
   69            ; Раскладка кадра: E0=старт(0), E1..E7=d0..d6, D0=d7, D1=стоп(1).
   70  002E: 79       TXBYTE: MOV A,C
   71  002F: 87               ADD A               ; CY=d7, A=(d<<1): бит0=0 -- старт-бит
   72  0030: 5F               MOV E,A
   73  0031: 3E 02            MVI A,2             ; старший байт: бит1=1 -- стоп (+d7 в бите 0)
   74  0033: D2 38 00         JNC TXB1
   75  0036: F6 01            ORI 1               ; d7 = 1 -- вписать в кадр
   76  0038: 57       TXB1:   MOV D,A
   77  0039: 06 0A            MVI B,10            ; 10 бит кадра
   78  003B: 7B       TXLP:   MOV A,E             ; -- выдать бит (26 тактов) --
   79  003C: E6 01            ANI 1
   80  003E: 0F               RRC                 ; A7 <- E0
   81  003F: F6 40            ORI 40h             ; SSE=1; MSE=0 -- маски НЕ трогаем
   82  0041: 30               SIM
   83  0042: 7A               MOV A,D             ; -- сдвиг DE вправо (24 такта, 0 сверху) --
   84  0043: 1F               RAR
   85  0044: 57               MOV D,A
   86  0045: 7B               MOV A,E
   87  0046: 1F               RAR
   88  0047: 5F               MOV E,A
   89  0048: 21 28 00         LXI H,40            ; -- пауза до конца бита (978 тактов) --
   90  004B: 00               NOP
   91  004C: 00               NOP
   92  004D: 2B       DLB:    DCX H
   93  004E: 7C               MOV A,H
   94  004F: B5               ORA L
   95  0050: C2 4D 00         JNZ DLB
   96  0053: 05               DCR B               ; -- следующий бит (14 тактов) --
   97  0054: C2 3B 00         JNZ TXLP
   98  0057: C9               RET
   99            ; ---- DLGAP: пауза между посылками ~5,4 мс (13532 такта) ----
  100  0058: 01 32 02 DLGAP:  LXI B,562           ; 562 x 24 такта + накладные CALL/LXI/RET
  101  005B: 0B       DGL:    DCX B
  102  005C: 78               MOV A,B
  103  005D: B1               ORA C
  104  005E: C2 5B 00         JNZ DGL
  105  0061: C9               RET
  106  0062: 54 49 4D 45 52 2D 55 41 52 54 20 4F 4B 0D 0A 00 MSG:    DB 'TIMER-UART OK',0Dh,0Ah,00h
  107  0072: -                END
