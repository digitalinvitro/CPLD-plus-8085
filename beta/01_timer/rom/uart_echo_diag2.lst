    1            ; =====================================================================
    2            ; beta/01_timer -- ТЕСТ-ПРОШИВКА ПЗУ: ПОЛНОЦЕННЫЙ UART (ПРИЁМ-ПЕРЕДАЧА,
    3            ; ЭХО) + ДИАГНОСТИКА ПРИЁМА НА ДИСПЛЕЕ, ВЕРСИЯ 2 (БИТЫ ХВОСТА).
    4            ; Интервальный таймер CPLD (beta v3.3b3, порт 04h -> RST 7.5),
    5            ; 2400 бод (TMR_N=8), 8N1.
    6            ;
    7            ; ЭТО diag v1 (uart_echo_diag.asm) + ЗАПИСЬ БИТОВ ХВОСТА В E.
    8            ; ЛОГИКА ЭХА И СЕТКА ВЫБОРКИ НЕ ТРОНУТЫ (ре-арм в векторе 003Ch,
    9            ; выборки данных d0..d7 -- те же инструкции на тех же адресах).
   10            ;
   11            ; Файл в кодировке CP1251 (как все исходники проекта, кроме asm85.py).
   12            ;
   13            ; Сборка (из этой папки):
   14            ;   python3 asm85.py uart_echo_diag2.asm -o uart_echo_diag2.hex -l uart_echo_diag2.lst
   15            ;
   16            ; Железо: retro_PCLD_board V2 + CPLD beta v3.3b3 + USB-мост CH340G (U6).
   17            ; CPLD НЕ МЕНЯЛСЯ (транзит SID <= RX безусловен, по .rpt: RX = вход P38,
   18            ; SID = выход P73). Прошивается ВМЕСТО монитора fw_mon с нулевого
   19            ; смещения flash A29040B. После теста вернуть монитор.
   20            ;
   21            ; ЗАЧЕМ ВЕРСИЯ 2: отчёт владельца по diag v1 -- счётчик старт-битов
   22            ; ТИКАЕТ на каждое нажатие, эхо в терминале почти всегда НЕВИДИМО,
   23            ; изредка выходит буква 'ю' (CP1251, байт 0FEh). Сигнатурная модель
   24            ; (scripts/uart/sim_rx_signature.py) показывает: при ЧЕСТНЫХ 2400 бод
   25            ; приём даёт байт = коду клавиши на ЛЮБОЙ фазе/латентности (1000/1000
   26            ; прогонов) -- мусор невозможен. А вот терминал, шлющий ВДВОЕ МЕДЛЕННЕЕ
   27            ; (~1200 бод), даёт ИМЕННО наблюдаемое: 'a'->06 (невидимый), 'b'->18,
   28            ; SP->00, а клавиши 'o'/'?' -> 0FEh = 'ю' в CP1251 (единичные случаи).
   29            ; Диагноз нужен В ЖЕЛЕЗЕ -- версия 2 добавляет биты хвоста.
   30            ;
   31            ; ЧТО ДОБАВЛЕНО (v2):
   32            ;   E -- биты ХВОСТА кадра (3 интервала после d7, H=3..1): ISR пишет
   33            ;        линию SID в E, MSB-first: E = t1<<2 | t2<<1 | t3.
   34            ;        При правильной сетке хвост ложится на стоп/idle = все 1 =>
   35            ;        E = 7. E < 7 -- сетка уползла (биты хвоста поймали данные).
   36            ;   Дисплей: [DIG0 = счётчик старт-битов B mod 16]
   37            ;            [DIG1 = E, 0..7 (7 = хвост чист)]
   38            ;            [DIG2-3 = принятый байт]
   39            ;   После RESET: «0.0.0.0.» (маячок старта, как в diag v1).
   40            ;
   41            ; ЧТЕНИЕ (вводить по одному символу; опорные точки -- 'a' и Enter):
   42            ;   байт = коду клавиши ('a'->61), E = 7  -- приём исправен на 2400:
   43            ;       терминал ДЕЙСТВИТЕЛЬНО шлёт 2400 8N1, эхо обязано быть видимым;
   44            ;   'a'->06, E=0..4 (или 'o'->FE, т.е. 'ю' в терминале) -- терминал
   45            ;       шлёт ВДВОЕ медленнее (~1200): ВЫСТАВИТЬ 2400 8N1. ВНИМАНИЕ:
   46            ;       монитор fw_mon v5 работает на 4800 8N1, старый v1 -- на 2400;
   47            ;       профиль терминала мог остаться от монитора;
   48            ;   байт F8..FF ('я'/'ю'/мусор из р-я) на ЛЮБОЙ клавише -- терминал
   49            ;       шлёт ~4800 (профиль монитора v5): ВЫСТАВИТЬ 2400 8N1;
   50            ;   байт верный, E < 7 -- сетка уползает к концу кадра (сообщить код E);
   51            ;   счётчик тикает, байт 00, E = 0, без ввода -- линия прижата к 0.
   52            ;
   53            ; ТАЙМИНГ ПРИЁМА (не менялся, подробности в uart_echo_test.asm):
   54            ;   MAIN опрашивает SID (RIM) в цикле с DI; поймав старт-фронт:
   55            ;   OUT TMRP <- RXN1 (1,5 бита, 12 при N=8) -> SIM 08h (сброс латча
   56            ;   RST 7.5 ПОСЛЕ загрузки -- залетевший фронт выброшен атомарно)
   57            ;   -> INR B -> L=0, E=0, H=11, EI. Сетка ISR: ре-арм в векторе 003Ch;
   58            ;   кадр = 12Q (d0) + 8x8Q (d1..d7) + 3x8Q (хвост -- урок v4: эхо-старт
   59            ;   ПОСЛЕ конца кадра приёмника ПКА). В v2 хвост, как и данные, читает
   60            ;   линию (RIM) -- цена ~7 байт и ~3 мкс в НЕкритичных интервалах:
   61            ;   ре-арм в векторе, период = N тикам ровно, длина ISR в сетку не
   62            ;   входит; выборки d0..d7 -- побайтно те же инструкции.
   63            ;
   64            ; РЕГИСТРЫ: C -- фаза TX (0Bh заряжен, 0Ah старт, 09h..02h данные,
   65            ;   01h стоп, 0FFh покой); D -- сдвиговый TX; H -- интервалы RX
   66            ;   (11..4 выборки, 3..1 хвост-с-записью-E, 0 покой); L -- накопитель
   67            ;   байта; E -- биты хвоста (ДИАГ, MSB-first, 0..7); B -- счётчик
   68            ;   старт-битов (ДИАГ, ISR не трогает); A/флаги -- рабочие.
   69            ;   Вложенных прерываний нет.
   70            ; =====================================================================
   71            
   72            ; ---- параметры (можно переопределить ключами -D) ----
   73            TMR_N   EQU 8               ; бит = N x Q: 8 -> ~2460 бод (цель 2400)
   74            RXN1    EQU TMR_N + TMR_N//2 ; 1-й зазор приёма = 1,5 бита (12 при N=8)
   75            SIMW    EQU 1Bh             ; SIM: MSE=1 -- маски применить: 5.5/6.5
   76                                        ; маскировать, 7.5 РАЗРЕШИТЬ; R7.5=1 -- латч
   77                                        ; сброшен (гасим возможный мусор до EI)
   78            SIMLR   EQU 08h             ; SIM: R7.5=1, MSE=0, SDE=0 -- ТОЛЬКО сброс
   79                                        ; латча RST 7.5 (маски и SOD не трогаем)
   80            
   81            ; ---- порты ----
   82            SEGP    EQU 00h             ; SEG: D0=a..D6=g, D7=dp (1 = горит в регистре)
   83            DIGP    EQU 01h             ; DIG: D3-D0 разряды (D4 = SND -- не трогаем)
   84            TMRP    EQU 04h             ; таймер: запись N (период = N x Q)
   85            
   86            ; ---- диагностика: ОЗУ (SRAM с 8000h, стек на FFFF -- конфликтов нет) ----
   87            MUXI    EQU 8000h           ; индекс разряда дисплея 0..3
   88            BYTE0   EQU 8001h           ; последний принятый байт (пишет ISR)
   89            
   90            ; ---- векторы ----
   91  0000: -                ORG 0000h
   92  0000: C3 B0 00         JMP MAIN            ; сброс
   93            ; ВАЖНО: вектор 003Ch занят ре-армом ЦЕЛИКОМ (MVI+OUT = 003Ch-003Fh),
   94            ; JMP не нужен -- автомат продолжается с 0040h. Ре-арм ПЕРВЫМ действием:
   95            ; период = N тикам ровно (сетка не зависит от длины ISR).
   96  003C: -                ORG 003Ch
   97  003C: 3E 08            MVI A,TMR_N         ; РЕ-АРМ СЕТКИ (7 тактов)
   98  003E: D3 04            OUT TMRP            ; (10 тактов) -- 8 квантов = 1 бит
   99            
  100            ; ---- ISR: вентиль TX -> TX-автомат -> RX-автомат ----
  101  0040: -                ORG 0040h
  102  0040: 7C               MOV A,H             ; вентиль: RX активен (H>0)?
  103  0041: B7               ORA A
  104  0042: CA 48 00         JZ TXRUN
  105  0045: C3 79 00         JMP RX              ; RX активен: TX НЕ двигаем (заморозка кадра,
  106                                        ;   SOD держит текущий уровень)
  107  0048: 79       TXRUN:  MOV A,C             ; --- TX-автомат (фазы как в v4) ---
  108  0049: FE FF            CPI 0FFh            ; 0FFh = покой?
  109  004B: CA 76 00         JZ TXIDLE
  110  004E: 0D               DCR C               ; следующая фаза
  111  004F: 79               MOV A,C
  112  0050: FE 0A            CPI 0Ah             ; 0Ah = старт-бит
  113  0052: CA 68 00         JZ TXST
  114  0055: FE 01            CPI 1               ; 01h = стоп-бит
  115  0057: CA 6E 00         JZ TXSP
  116            ; --- фаза данных (d0..d7): как в v4, байт уже в D ---
  117  005A: 7A               MOV A,D
  118  005B: 0F               RRC                 ; A7 <- D0 (очередной бит данных)
  119  005C: E6 80            ANI 80h
  120  005E: F6 40            ORI 40h             ; SSE=1; MSE=0 -- маски НЕ трогаем
  121  0060: 30               SIM                 ; SOD <- бит
  122  0061: 37               STC                 ; единицы едут сверху: после d7 в D уже '1'
  123  0062: 7A               MOV A,D
  124  0063: 1F               RAR                 ; D >>= 1 (D7 <- 1)
  125  0064: 57               MOV D,A
  126  0065: C3 79 00         JMP RX
  127  0068: 3E 40    TXST:   MVI A,40h           ; SOD=0 -- старт-бит (D загружен ЗАРАНЕЕ:
  128  006A: 30               SIM                 ;   из релиза приёма или из MAIN)
  129  006B: C3 79 00         JMP RX
  130  006E: 3E C0    TXSP:   MVI A,0C0h          ; SOD=1 -- стоп-бит
  131  0070: 30               SIM
  132  0071: 0E FF            MVI C,0FFh          ; однобайтовый режим: сразу в покой (кадры
  133  0073: C3 79 00         JMP RX              ;   редкие -- 2-й стоп-бит не нужен)
  134  0076: 3E C0    TXIDLE: MVI A,0C0h          ; покой: SOD=1 (каждый тик подтверждаем)
  135  0078: 30               SIM
  136            ; --- RX-автомат: интервалы кадра в H, байт копится в L ---
  137  0079: 7C       RX:     MOV A,H
  138  007A: B7               ORA A
  139  007B: CA A7 00         JZ RXE              ; H=0 -- приём не активен
  140  007E: FE 04            CPI 4               ; H>=4 (H=11..4) -- фаза данных d0..d7;
  141  0080: FA 8D 00         JM RXTAIL           ; H=3..1 -- хвост (с записью E в v2)
  142  0083: 20               RIM                 ; SID -> A7 (транзит RX->SID в CPLD)
  143  0084: E6 80            ANI 80h
  144  0086: 1F               RAR                 ; CY <- SID
  145  0087: 7D               MOV A,L
  146  0088: 1F               RAR                 ; L = (L>>1) | SID<<7 -- LSB-first
  147  0089: 6F               MOV L,A
  148  008A: C3 94 00         JMP RXDCR           ; v2: обход записи хвоста (данные уже взяты)
  149  008D: 20       RXTAIL: RIM                 ; v2 ДИАГ: бит линии хвоста -> E, MSB-first:
  150  008E: E6 80            ANI 80h             ;   t1 -> бит 2, t2 -> бит 1, t3 -> бит 0;
  151  0090: 1F               RAR                 ;   при чистой сетке E = 7 (стоп + idle)
  152  0091: 7B               MOV A,E
  153  0092: 17               RAL                 ; E = (E<<1) | SID
  154  0093: 5F               MOV E,A
  155  0094: 25       RXDCR:  DCR H               ; интервал отработан
  156  0095: 7C               MOV A,H
  157  0096: B7               ORA A
  158  0097: C2 A7 00         JNZ RXE             ; кадр приёма не кончился
  159  009A: 7D               MOV A,L             ; ДИАГ: копия принятого байта на дисплей
  160  009B: 32 01 80         STA BYTE0           ;   (даже если эхо ниже будет уронено)
  161  009E: 79               MOV A,C             ; --- РЕЛИЗ: кадр кончился (H=0) ---
  162  009F: FE FF            CPI 0FFh            ; TX свободен?
  163  00A1: C2 A7 00         JNZ RXE             ; занят -- байт отбрасываем (v1, без очереди)
  164  00A4: 55               MOV D,L             ; эхо: сдвиговый TX <- принятый байт
  165  00A5: 0E 0B            MVI C,0Bh           ; следующий фронт = старт-бит эха
  166  00A7: FB       RXE:    EI
  167  00A8: C9               RET
  168            
  169            ; ---- MAIN ----
  170  00B0: -                ORG 00B0h           ; v2: сдвинут с 00A0h (+10 байт в ISR)
  171  00B0: 31 FF FF MAIN:   LXI SP,0FFFFh       ; стек -- верх ОЗУ (конвенция v2)
  172  00B3: 3E C0            MVI A,0C0h          ; SOD=1 (idle) -- ПЕРВЫМ делом гасим возможный
  173  00B5: 30               SIM                 ; BREAK: после сброса SOD=0; TX-маска CPLD и так
  174                                        ; держит '1' 51,2 мкс, но не полагаемся на неё
  175  00B6: 3E 00            MVI A,0             ; ДИАГ: MUXI=0, BYTE0=0 -- дисплей «0.0.0.0.»
  176  00B8: 32 00 80         STA MUXI
  177  00BB: 32 01 80         STA BYTE0
  178  00BE: 06 00            MVI B,0             ; ДИАГ: счётчик старт-битов -- с нуля
  179  00C0: 1E 00            MVI E,0             ; ДИАГ: биты хвоста -- с нуля
  180  00C2: 3E 1B            MVI A,SIMW
  181  00C4: 30               SIM                 ; маски: 5.5/6.5 закрыты, 7.5 разрешён, латч сброшен
  182  00C5: 16 3E            MVI D,'>'           ; баннер-символ (один; кадр уйдёт сами собой)
  183  00C7: 0E 0B            MVI C,0Bh           ; фаза: следующий фронт = старт-бит '>'
  184  00C9: 3E 08            MVI A,TMR_N
  185  00CB: D3 04            OUT TMRP            ; пуск таймера: 1-й фронт через N тиков
  186  00CD: 26 00            MVI H,0             ; RX покой
  187  00CF: 2E 00            MVI L,0
  188  00D1: FB               EI
  189  00D2: 79       BAN:    MOV A,C             ; ждём конца баннера (C -> 0FFh на стоп-фазе)
  190  00D3: FE FF            CPI 0FFh
  191  00D5: C2 D2 00         JNZ BAN
  192            ; --- главный цикл: опрос SID (приём) + эхо + мультиплексия дисплея ---
  193  00D8: CD 00 01 POLL:   CALL DMUX           ; ДИАГ: шаг мультиплексии (EI включён; портит
  194  00DB: F3               DI                  ;   только A/флаги -- критично, см. шапку);
  195                                        ;   далее опрос КАК В v1
  196  00DC: 20               RIM                 ; «залетевший» фронт сетки не обслужится,
  197  00DD: E6 80            ANI 80h             ; латч ловится -- выбросим ниже
  198  00DF: C2 D8 00         JNZ POLL            ; 1 = idle (покой линии)
  199                    ; --- старт-бит пойман (SID=0) ---
  200  00E2: 3E 0C            MVI A,RXN1          ; 1-й зазор = 1,5 бита: загрузка ДО сброса
  201  00E4: D3 04            OUT TMRP            ; латча! Любой залетевший фронт старого
  202  00E6: 3E 08            MVI A,SIMLR         ; отсчёта мог сработать только ДО этой точки
  203  00E8: 30               SIM                 ; (после загрузки новый фронт >= 11 квантов):
  204                                        ; SIM 08h выбрасывает их АТОМАРНО, гонки нет
  205  00E9: 04               INR B               ; ДИАГ: +1 пойманный старт-бит (вне критичного
  206                                        ;   пути -- ПОСЛЕ арма, до EI)
  207  00EA: 2E 00            MVI L,0             ; накопитель байта -- с нуля
  208  00EC: 1E 00            MVI E,0             ; ДИАГ: биты хвоста -- с нуля
  209  00EE: 26 0B            MVI H,11            ; 11 интервалов: 12Q (d0) + 8x8Q (d1..d7)
  210  00F0: FB               EI                  ;              + 3x8Q (хвост -- урок v4)
  211  00F1: 7C       RWAIT:  MOV A,H             ; ждём конца приёма (H -> 0 в релизе)
  212  00F2: B7               ORA A
  213  00F3: C2 F1 00         JNZ RWAIT
  214  00F6: 79       EWAIT:  MOV A,C             ; ждём конца эха (C -> 0FFh на стоп-фазе)
  215  00F7: FE FF            CPI 0FFh
  216  00F9: C2 F6 00         JNZ EWAIT
  217  00FC: C3 D8 00         JMP POLL
  218            
  219            ; ---- ДИАГНОСТИКА: мультиплексия дисплея (по одному разряду за вызов) ----
  220            ; DIG0=B mod 16, DIG1=E (0..7), DIG2=байт.мл, DIG3=байт.ст (hex).
  221            ; ПОРТИТ ТОЛЬКО A/флаги (HSEG сохраняет HL через PUSH/POP; B/C/D/E
  222            ; не трогает) -- безопасно при EI: ISR в покое тоже трогает лишь A.
  223            ; Сегменты пишем ДО разряда (SEGP -> DIGP) -- без призраков.
  224  0100: -                ORG 0100h           ; v2: сдвинут с 00F0h (ISR +10 байт, MAIN с 00B0h)
  225  0100: 3A 00 80 DMUX:   LDA MUXI
  226  0103: 3C               INR A
  227  0104: E6 03            ANI 3
  228  0106: 32 00 80         STA MUXI            ; A = новый индекс 0..3
  229  0109: FE 01            CPI 1
  230  010B: CA 23 01         JZ DMX1
  231  010E: FE 02            CPI 2
  232  0110: CA 2E 01         JZ DMX2
  233  0113: FE 03            CPI 3
  234  0115: CA 3B 01         JZ DMX3
  235  0118: 78               MOV A,B             ; индекс 0: счётчик стартов, мл. ниббл
  236  0119: E6 0F            ANI 0Fh
  237  011B: CD 4C 01         CALL HSEG
  238  011E: 3E 01            MVI A,01h
  239  0120: D3 01            OUT DIGP
  240  0122: C9               RET
  241  0123: 7B       DMX1:   MOV A,E             ; индекс 1 (v2): биты хвоста 0..7 (ждём 7)
  242  0124: E6 07            ANI 07h
  243  0126: CD 4C 01         CALL HSEG
  244  0129: 3E 02            MVI A,02h
  245  012B: D3 01            OUT DIGP
  246  012D: C9               RET
  247  012E: 3A 01 80 DMX2:   LDA BYTE0           ; индекс 2: мл. ниббл байта
  248  0131: E6 0F            ANI 0Fh
  249  0133: CD 4C 01         CALL HSEG
  250  0136: 3E 04            MVI A,04h
  251  0138: D3 01            OUT DIGP
  252  013A: C9               RET
  253  013B: 3A 01 80 DMX3:   LDA BYTE0           ; индекс 3: ст. ниббл байта
  254  013E: 0F               RRC
  255  013F: 0F               RRC
  256  0140: 0F               RRC
  257  0141: 0F               RRC
  258  0142: E6 0F            ANI 0Fh
  259  0144: CD 4C 01         CALL HSEG
  260  0147: 3E 08            MVI A,08h
  261  0149: D3 01            OUT DIGP
  262  014B: C9               RET
  263  014C: E5       HSEG:   PUSH H              ; A = ниббл -> OUT SEGP = паттерн; HL целы
  264  014D: 67               MOV H,A
  265  014E: 2E 60            MVI L,SEGTAB & 0FFh
  266  0150: 85               ADD L               ; lo + ниббл: переноса нет (lo=60h, см. ниже)
  267  0151: 6F               MOV L,A
  268  0152: 26 01            MVI H,SEGTAB//256
  269  0154: 7E               MOV A,M
  270  0155: E1               POP H
  271  0156: D3 00            OUT SEGP
  272  0158: C9               RET
  273            
  274  0160: -                ORG 0160h           ; lo = 60h: 60h+0Fh без переноса -- ADD L точен
  275  0160: 3F 06 5B 4F 66 6D 7D 07 SEGTAB: DB 3Fh,06h,5Bh,4Fh,66h,6Dh,7Dh,07h  ; '0'-'7' (a..g, dp=0)
  276  0168: 7F 6F 77 7C 39 5E 79 71         DB 7Fh,6Fh,77h,7Ch,39h,5Eh,79h,71h  ; '8'-'F'
  277  0170: -                END
