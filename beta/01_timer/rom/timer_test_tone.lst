    1            ; =====================================================================
    2            ; beta/01_timer -- ТЕСТ-ПРОШИВКА ПЗУ: проверка интервального таймера
    3            ; (CPLD beta v3.3b3, порт 04h -> RST 7.5) звуком и миганием сегмента.
    4            ;
    5            ; Файл в кодировке CP1251 (как все исходники проекта, кроме asm85.py).
    6            ;
    7            ; Сборка (из этой папки):
    8            ;   python3 asm85.py timer_test.asm -o timer_test_tone.hex  -l timer_test_tone.lst
    9            ;   python3 asm85.py timer_test.asm -o timer_test_blink.hex -l timer_test_blink.lst -D TONE=0
   10            ;
   11            ; Железо: retro_PCLD_board V2 + CPLD beta/01_timer v3.3b3 (фит 10-22 22:04).
   12            ; Прошивается ВМЕСТО монитора fw_mon, с нулевого смещения flash A29040B
   13            ; (видимое окно 0000h-7FFFh). После теста вернуть монитор.
   14            ;
   15            ; ЧТО ДЕЛАЕТ (см. подробную таблицу диагностики в beta/01_timer/README.md):
   16            ;   N = 20: период прерываний = 20 x 51,2 мкс = 1,024 мс (+ 50...60 мкс
   17            ;   накладных на вход в ISR и ре-арм -- это нормально и учтено в расчёте).
   18            ;   TONE=1: каждое прерывание инвертирует бит D4 (SND) порта 01h -> зуммер
   19            ;   даёт тон около 460...470 Гц (идеальные 488 Гц минус накладные ISR).
   20            ;   BLINK=1: каждые 464 прерывания инвертируется сегмент 'g' (D6) -> мигание
   21            ;   раз в ~0,5 с (полный цикл ~1 с); dp горит постоянно как маячок дисплея.
   22            ;
   23            ; ОТВЕТ НА ВОПРОС "ЗВУК ИЛИ СЕГМЕНТ": звук -- показательнее (сотни
   24            ;   прерываний/с, любой сбой слышен мгновенно, кратность кванта видна по
   25            ;   высоте тона), мигание -- удобнее как фоновый визуальный контроль.
   26            ;   Основной hex делает ОБА; тихий вариант: -D TONE=0.
   27            ;
   28            ; ДИАГНОСТИКА:
   29            ;   тон + мигание ~1 Гц      -> таймер, RST 7.5, ре-арм: ПАСС
   30            ;   тишина, но мигает        -> таймер ОК; смотреть цепь SND/излучатель
   31            ;   тон вдвое ниже (~230 Гц) -> квант 102,4 мкс вместо 51,2 (дефект HDL)
   32            ;   тишина и горит "8."      -> программа не стартует (ПЗУ/шина/CPLD)
   33            ; =====================================================================
   34            
   35            ; ---- параметры (можно переопределить ключами -D) ----
   36            TMR_N   EQU 20              ; период: 20 x 51,2 мкс = 1,024 мс (1..255)
   37            TONE    EQU 1               ; 1 = зуммер тикает каждое прерывание
   38            BLINK   EQU 1               ; 1 = мигание 'g' каждые KA*KB прерываний
   39            
   40            ; ---- порты и переменные ----
   41            SEGP    EQU 00h             ; порт SEG:  D0=a..D6=g, D7=dp (1 = горит в регистре)
   42            DIGP    EQU 01h             ; порт DIG/SND: D3-D0 разряды, D4=SND (меандр!)
   43            TMRP    EQU 04h             ; порт таймера: запись N (T = N x 51,2 мкс)
   44            SIMW    EQU 1Bh             ; SIM: маскировать 5.5/6.5, РАЗРЕШИТЬ 7.5, сброс латча
   45            KA      EQU 116             ; мигание: 116 x 4 = 464 прерывания ~ 0,5 с
   46            KB      EQU 4
   47            SEGST   EQU 8000h           ; ОЗУ: копия регистра SEG (для инверсии битов)
   48            DIGST   EQU 8001h           ; ОЗУ: копия регистра DIG/SND
   49            
   50            ; ---- векторы ----
   51  0000: -                ORG 0000h
   52  0000: C3 80 00         JMP MAIN            ; сброс: переход на инициализацию
   53  003C: -                ORG 003Ch
   54  003C: C3 40 00         JMP ISR             ; вектор RST 7.5 = 003Ch
   55            
   56            ; ---- ISR: тон + мигание + РЕ-АРМ (обязателен! автоперезагрузки нет) ----
   57  0040: -                ORG 0040h
   58  0040: F5       ISR:    PUSH PSW
   59  0041: C5               PUSH B
   60                    IF TONE
   61  0042: 3A 01 80         LDA DIGST           ; инверсия D4 (SND) в копии и в порту:
   62  0045: EE 10            XRI 10h             ; меандр с полупериодом = периоду прерываний
   63  0047: 32 01 80         STA DIGST
   64  004A: D3 01            OUT DIGP
   65                    ENDIF
   66                    IF BLINK
   67  004C: 0D               DCR C               ; каскадный счётчик мигания B:C (B=KB, C=KA)
   68  004D: C2 62 00         JNZ TMRGO
   69  0050: 0E 74            MVI C,KA
   70  0052: 05               DCR B
   71  0053: C2 62 00         JNZ TMRGO
   72  0056: 06 04            MVI B,KB
   73  0058: 3A 00 80         LDA SEGST           ; инверсия сегмента 'g' (D6) в копии и в порту
   74  005B: EE 40            XRI 40h
   75  005D: 32 00 80         STA SEGST
   76  0060: D3 00            OUT SEGP
   77                    ENDIF
   78  0062: 3E 14    TMRGO:  MVI A,TMR_N         ; РЕ-АРМ: счётчик стоит в нуле, загружаем N заново
   79  0064: D3 04            OUT TMRP
   80  0066: C1               POP B
   81  0067: F1               POP PSW
   82  0068: FB               EI
   83  0069: C9               RET
   84            
   85            ; ---- MAIN: инициализация и сон до прерываний ----
   86  0080: -                ORG 0080h
   87  0080: 31 FF FF MAIN:   LXI SP,0FFFFh       ; стек -- верх ОЗУ (8000h-FFFFh)
   88  0083: 3E C0            MVI A,0C0h          ; сегменты: 'g' + dp (мигает 'g', dp -- маячок)
   89  0085: 32 00 80         STA SEGST
   90  0088: D3 00            OUT SEGP
   91  008A: 3E 0F            MVI A,0Fh           ; все 4 разряда статически; нагрузка меньше INIT "8."
   92  008C: 32 01 80         STA DIGST           ; (SND=0 -- тишина до первого прерывания)
   93  008F: D3 01            OUT DIGP
   94  0091: 01 74 04         LXI B,KB*256+KA     ; счётчик мигания: B=KB=4, C=KA=116
   95  0094: 3E 14            MVI A,TMR_N
   96  0096: D3 04            OUT TMRP            ; загрузить N и запустить (1-е прерывание ~1 мс)
   97  0098: 3E 1B            MVI A,SIMW
   98  009A: 30               SIM                 ; RST 7.5 разрешён, латч сброшен, 5.5/6.5 маскированы
   99  009B: FB               EI
  100  009C: 76       HLTLP:  HLT                 ; спим: таймер будит процессор каждые ~1,07 мс
  101  009D: C3 9C 00         JMP HLTLP
  102  00A0: -                END
