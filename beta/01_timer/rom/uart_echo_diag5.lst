    1            ; =====================================================================
    2            ; beta/01_timer -- ДИАГНОСТИКА ВЕРСИЯ 5: «КРИЧАЩИЙ БАННЕР»
    3            ; (дискриминатор «одиночный кадр vs тракт» после находки cont-echo-14/15).
    4            ; Интервальный таймер CPLD (beta v3.3b3, порт 04h -> RST 7.5),
    5            ; 2400 бод (TMR_N=8), 8N1.
    6            ;
    7            ; ПОСТАНОВКА. 10-24: баннер '>' ДОХОДИЛ до терминала (uart_echo_test v1,
    8            ; diag1-3 -- баннер жив во всех отчётах), TX-тракт закрыт ПАССОМ
    9            ; timer_test_uart v4. С 10-25: вместо '>' в терминал приходит 00, при
   10            ; этом (проверено ридбеками 26-10): файл корректен, в чипе diag4
   11            ; байт-в-байт, исполнение идёт (дисплей 8.8.8.8 -> 0000 = кадр прошёл
   12            ; все фазы). Дифференциальный факт владельца 26-10: timer_test_uart
   13            ; (НЕПРЕРЫВНЫЙ поток кадров) работает, diag4 (ОДИН кадр ~0,6 мс после
   14            ; отпускания RESET, сам сброс по осциллограмме ADS00003.BMP ~125 мс)
   15            ; -- нет. Единственное терминально-видимое отличие пары --
   16            ; ОДНОКРАТНОСТЬ кадра. diag5 превращает баннер в ПОТОК, не трогая
   17            ; ни байта TX-автомата:
   18            ;
   19            ;   1) ISR (0000h-00FFh) = diag4 БАЙТ-В-БАЙТ (ре-арм, вентиль E,
   20            ;      TX-автомат, RX-автомат);
   21            ;   2) init MAIN (0100h-0129h) = diag4 БАЙТ-В-БАЙТ;
   22            ;   3) хвост MAIN заменён: баннер '>' повторяется ВЕЧНО с паузой
   23            ;      ~1024 прохода DMUX (~70-140 мс, зависит от такта CPU);
   24            ;   4) RX ПОЛНОСТЬЮ ОТКЛЮЧЁН: E=0 навсегда -> вентиль ISR никогда
   25            ;      не пускает RX-ветвь, RIM не исполняется, эхо не собирается --
   26            ;      тест ЧИСТО про TX;
   27            ;   5) DMUX/SEGTAB (0170h-01DFh) = diag4 БАЙТ-В-БАЙТ.
   28            ;
   29            ; ЧТО НАБЛЮДАТЬ (терминал 2400 8N1, HEX-режим, порт открыть ДО RESET):
   30            ;   1. Поток '3E' каждые ~70-150 мс, дисплей считает [кадры][0][0][0]
   31            ;      -> TX-тракт ЦЕЛ. Вывод: в diag4 одиночный кадр терялся, пока
   32            ;      порт/драйвер/терминал не готовы после RESET; вопрос закрыт,
   33            ;      дальше вернуться к эху на повторяющемся баннере.
   34            ;   2. Периодические '00' БЕЗ '3E' -> на проводе РЕАЛЬНЫЙ ноль с
   35            ;      периодом кадров: кадр выходит из SOD битым (смотреть U3.4
   36            ;      осциллографом; противоречит рабочему timer_test_uart ->
   37            ;      перепроверить COM/кабель/точку подключения).
   38            ;   3. Терминал молчит, дисплей СЧИТАЕТ -> кадр не доходит до моста:
   39            ;      осциллограф P39/U6.2 (разрыв после CPLD).
   40            ;   4. Терминал молчит, дисплей «0.0.0.0.» застыл -> образ не
   41            ;      исполняется: ридбек/перепрошивка.
   42            ;   5. Дисплей «8.8.8.8» навсегда -> MAIN не стартовал (ПЗУ/шина/сброс).
   43            ;
   44            ; Дисплей: DIG0 = B = счётчик отправленных кадров mod 16 (считает
   45            ; ~7-13 раз/с); DIG1..3 = 0. Во время кадра подсвечен последний разряд.
   46            ;
   47            ; ОСЦИЛЛОГРАФ: на 100 мс/дел линия TX (P39/U6.2) покажет периодические
   48            ; пачки активности каждые ~0,7-1,5 деления -- не пропустит даже
   49            ; медленный одиночник; на 1-2 мс/дел виден целый кадр (старт 0,42 мс,
   50            ; d1..d5 ~2,1 мс, d6/d7+стоп). Эталон кадра '3E' @2400:
   51            ;   LOW 0,83 мс | HIGH 2,08 мс | LOW 0,83 мс | HIGH (стоп/idle).
   52            ;
   53            ; ГОНКИ (разобрано): ISR не сохраняет PSW; падение флагов на границах
   54            ; циклов ожидания здесь НЕОПАСНО: перезарядка D/C идёт только после
   55            ; длинной паузы, когда любой «недобитый» кадр давно дошёл до C=FFh.
   56            ; Очередь QCNT=8007h навсегда 0 -> каждый стоп-фаза даёт TXDONE.
   57            ;
   58            ; Сборка (из этой папки):
   59            ;   python3 asm85.py uart_echo_diag5.asm -o uart_echo_diag5.hex -l uart_echo_diag5.lst
   60            ; UTF-8 мастер: scripts/uart/uart_echo_diag5.utf8.asm
   61            ; Прошивается ВМЕСТО монитора fw_mon с нулевого смещения flash A29040B.
   62            ; =====================================================================
   63            
   64            ; ---- параметры (можно переопределить ключами -D) ----
   65            TMR_N   EQU 8               ; бит = N x Q: 8 -> ~2460 бод (цель 2400)
   66            RXN1    EQU TMR_N//2        ; (в diag5 не используется -- RX отключён)
   67            SIMW    EQU 1Bh             ; SIM: MSE=1 -- 5.5/6.5 маскировать,
   68                                        ; 7.5 разрешить; R7.5=1 -- латч сброшен
   69            SIMLR   EQU 08h             ; (в diag5 не используется -- RX отключён)
   70            
   71            ; ---- порты ----
   72            SEGP    EQU 00h             ; SEG: D0=a..D6=g, D7=dp (1 = горит)
   73            DIGP    EQU 01h             ; DIG: D3-D0 разряды (D4 = SND -- не трогаем)
   74            TMRP    EQU 04h             ; таймер: запись N (период = N x Q)
   75            
   76            ; ---- ОЗУ (SRAM с 8000h, стек на FFFF -- конфликтов нет) ----
   77            MUXI    EQU 8000h           ; индекс разряда дисплея 0..3
   78            BYTE0   EQU 8001h           ; (в diag5 всегда 0)
   79            TSB     EQU 8002h           ; (в diag5 всегда 0)
   80            QBUF    EQU 8004h           ; (в diag5 всегда 0)
   81            SSELF   EQU 8006h           ; (в diag5 всегда 0)
   82            QCNT    EQU 8007h           ; счётчик очереди эха -- навсегда 0
   83            
   84            ; ---- векторы ----
   85  0000: -                ORG 0000h
   86  0000: C3 00 01         JMP MAIN            ; сброс
   87            ; Вектор 003Ch занят ре-армом ЦЕЛИКОМ (MVI+OUT = 003Ch-003Fh); ре-арм
   88            ; ПЕРВЫМ действием: период = ровно N тиков, длина ISR в сетку не входит.
   89  003C: -                ORG 003Ch
   90  003C: 3E 08            MVI A,TMR_N         ; РЕ-АРМ СЕТКИ (7 тактов)
   91  003E: D3 04            OUT TMRP            ; (10 тактов) -- 8 квантов = 1 бит
   92            
   93            ; ---- ISR: вентиль RX -> TX-автомат -> RX-автомат ----
   94  0040: -                ORG 0040h
   95  0040: 7B               MOV A,E             ; вентиль: RX активен (E>0)?
   96  0041: B7               ORA A
   97  0042: CA 48 00         JZ TXRUN
   98  0045: C3 A1 00         JMP RX              ; RX активен: TX НЕ двигаем (SOD держит уровень)
   99  0048: 79       TXRUN:  MOV A,C             ; --- TX-автомат ---
  100  0049: FE FF            CPI 0FFh            ; 0FFh = покой?
  101  004B: CA 9E 00         JZ TXIDLE
  102  004E: 0D               DCR C               ; следующая фаза
  103  004F: 79               MOV A,C
  104  0050: FE 0A            CPI 0Ah             ; 0Ah = старт-бит
  105  0052: CA 6D 00         JZ TXST
  106  0055: FE 0B            CPI 0Bh             ; 0Bh = холостой бит (урок v4): SOD=1
  107  0057: CA 73 00         JZ TXIDLBIT
  108  005A: FE 01            CPI 1               ; 01h = стоп-бит
  109  005C: CA 79 00         JZ TXSP
  110            ; --- фаза данных (d0..d7): байт в D ---
  111  005F: 7A               MOV A,D
  112  0060: 0F               RRC                 ; A7 <- D0
  113  0061: E6 80            ANI 80h
  114  0063: F6 40            ORI 40h             ; SDE=1; MSE=0 -- маски не трогаем
  115  0065: 30               SIM                 ; SOD <- бит
  116  0066: 37               STC                 ; единицы едут сверху
  117  0067: 7A               MOV A,D
  118  0068: 1F               RAR                 ; D >>= 1
  119  0069: 57               MOV D,A
  120  006A: C3 A1 00         JMP RX
  121  006D: 3E 40    TXST:   MVI A,40h           ; SOD=0 -- старт-бит (D заряжен заранее)
  122  006F: 30               SIM
  123  0070: C3 A1 00         JMP RX
  124  0073: 3E C0    TXIDLBIT: MVI A,0C0h        ; холостой бит: SOD=1 (C уже 0Bh ->
  125  0075: 30               SIM                 ;   следующий DCR даст 0Ah = старт)
  126  0076: C3 A1 00         JMP RX
  127  0079: 3E C0    TXSP:   MVI A,0C0h          ; SOD=1 -- стоп-бит
  128  007B: 30               SIM
  129  007C: 3A 07 80         LDA QCNT            ; очередь таймлайна?
  130  007F: B7               ORA A
  131  0080: CA 99 00         JZ TXDONE
  132  0083: 3D               DCR A
  133  0084: 32 07 80         STA QCNT            ; следующий байт очереди:
  134  0087: 57               MOV D,A             ;   было 2 -> QBUF, было 1 -> QBUF+1
  135  0088: FE 01            CPI 1
  136  008A: 2E 04            MVI L,QBUF & 0FFh
  137  008C: CA 90 00         JZ TXSP1
  138  008F: 2C               INR L
  139  0090: 26 80    TXSP1:  MVI H,QBUF//256
  140  0092: 7E               MOV A,M
  141  0093: 57               MOV D,A
  142  0094: 0E 0C            MVI C,0Ch           ; холостой бит, затем старт очередного
  143  0096: C3 A1 00         JMP RX
  144  0099: 0E FF    TXDONE: MVI C,0FFh          ; очередь пуста -- покой
  145  009B: C3 A1 00         JMP RX
  146  009E: 3E C0    TXIDLE: MVI A,0C0h          ; покой: SOD=1
  147  00A0: 30               SIM
  148            ; --- RX-автомат: каждая выборка -> бит таймлайна TSB; данные ещё и в L ---
  149  00A1: 7B       RX:     MOV A,E
  150  00A2: B7               ORA A
  151  00A3: CA F1 00         JZ RXE              ; E=0 -- приём не активен
  152  00A6: FE 0C            CPI 12              ; 1-й интервал = старт-верификация (мимо L)
  153  00A8: CA BB 00         JZ RXBIT
  154  00AB: FE 04            CPI 4               ; E=3..1 -- хвост (мимо L)
  155  00AD: FA BB 00         JM RXBIT
  156  00B0: 20               RIM                 ; SID -> A7 (транзит RX->SID в CPLD)
  157  00B1: E6 80            ANI 80h
  158  00B3: 07               RLC                 ; v4: CY <- БИТ ЛИНИИ (в v3 был RAR: SID
  159  00B4: 7D               MOV A,L             ;   уезжал в A6, в CY попадал 0!)
  160  00B5: 1F               RAR                 ; L = (L>>1) | бит -- d0..d7, LSB-first
  161  00B6: 6F               MOV L,A
  162  00B7: 07               RLC                 ; v4: CY <- бит снова (A7 сдвинутого байта)
  163  00B8: C3 BF 00         JMP RXPACK
  164  00BB: 20       RXBIT:  RIM                 ; старт/хвост: только в таймлайн
  165  00BC: E6 80            ANI 80h
  166  00BE: 07               RLC                 ; v4: CY <- бит линии
  167  00BF: E5       RXPACK: PUSH H              ; v4: L = накопитель байта -- LHLD TSB
  168  00C0: 2A 02 80         LHLD TSB            ;   его затирает; HL спасаем на упаковку
  169  00C3: 7C               MOV A,H
  170  00C4: 17               RAL
  171  00C5: 67               MOV H,A
  172  00C6: 7D               MOV A,L
  173  00C7: 17               RAL
  174  00C8: 6F               MOV L,A
  175  00C9: 22 02 80         SHLD TSB
  176  00CC: E1               POP H               ; v4: байт возвращён в L
  177  00CD: 1D               DCR E               ; интервал отработан
  178  00CE: 7B               MOV A,E
  179  00CF: B7               ORA A
  180  00D0: C2 F1 00         JNZ RXE             ; кадр не кончился
  181                    ; --- РЕЛИЗ: 12 выборок собраны (E=0), L = байт, HL = TSB ---
  182  00D3: 79               MOV A,C             ; TX свободен?
  183  00D4: FE FF            CPI 0FFh
  184  00D6: C2 F1 00         JNZ RXE             ; занят -- байт отбрасываем (v1, без очереди)
  185  00D9: 7D               MOV A,L             ; принятый байт
  186  00DA: 32 01 80         STA BYTE0           ; ДИАГ: байт на дисплей
  187  00DD: 57               MOV D,A             ; эхо, кадр 1 = байт
  188  00DE: 3A 02 80         LDA TSB             ; v4: в ОЗУ 8002h = tl-hi, 8003h = tl-lo
  189  00E1: 32 04 80         STA QBUF            ;   (так ложится H-first цепочка RAL);
  190  00E4: 3A 03 80         LDA TSB+1           ;   LHLD в релизе переворачивал пару ->
  191  00E7: 32 05 80         STA QBUF+1          ;   эхо шло [tl-lo][tl-hi]. Теперь прямо:
  192  00EA: 3E 02            MVI A,2             ;   [байт][tl-hi][tl-lo] по протоколу
  193  00EC: 32 07 80         STA QCNT
  194  00EF: 0E 0B            MVI C,0Bh           ; следующий фронт = старт-байт эха
  195  00F1: FB       RXE:    EI
  196  00F2: C9               RET
  197            
  198            ; ---- MAIN ----
  199  0100: -                ORG 0100h
  200  0100: 31 FF FF MAIN:   LXI SP,0FFFFh       ; стек -- верх ОЗУ (конвенция v2)
  201  0103: 3E C0            MVI A,0C0h          ; SOD=1 (idle) -- гасим возможный BREAK
  202  0105: 30               SIM                 ; после сброса SOD=0; TX-маска CPLD и так
  203                                        ; держит '1' 51,2 мкс, но не полагаемся
  204  0106: 3E 00            MVI A,0             ; ДИАГ: ОЗУ -- с нуля (дисплей «0.0.0.0.»)
  205  0108: 32 00 80         STA MUXI
  206  010B: 32 01 80         STA BYTE0
  207  010E: 32 02 80         STA TSB
  208  0111: 32 03 80         STA TSB+1
  209  0114: 32 06 80         STA SSELF
  210  0117: 32 07 80         STA QCNT
  211  011A: 06 00            MVI B,0             ; счётчик отправленных кадров
  212  011C: 1E 00            MVI E,0             ; RX ПОЛНОСТЬЮ ОТКЛЮЧЁН (вентиль ISR навсегда TX)
  213  011E: 3E 1B            MVI A,SIMW
  214  0120: 30               SIM                 ; маски: 5.5/6.5 закрыты, 7.5 разрешён
  215  0121: 16 3E            MVI D,'>'           ; баннер-символ (один)
  216  0123: 0E 0B            MVI C,0Bh           ; фаза: следующий фронт = старт '>'
  217  0125: 3E 08            MVI A,TMR_N
  218  0127: D3 04            OUT TMRP            ; пуск таймера
  219  0129: FB               EI
  220  012A: 79       BAN:    MOV A,C             ; ждём конца кадра (C -> 0FFh): голый спин,
  221  012B: FE FF            CPI 0FFh            ; как в diag4 -- шина во время кадра молчит
  222  012D: C2 2A 01         JNZ BAN
  223            ; --- diag5: пауза ~1024 прохода DMUX (~70-140 мс), баннер повторяется ---
  224  0130: 21 00 04 REARM:  LXI H,0400h         ; счётчик паузы
  225  0133: CD 70 01 DLAY:   CALL DMUX           ; дисплей живёт в паузе (C=FFh, ISR спокоен)
  226  0136: 2B               DCX H
  227  0137: 7D               MOV A,L
  228  0138: B4               ORA H
  229  0139: C2 33 01         JNZ DLAY
  230  013C: 04               INR B               ; кадр отправлен: счётчик -> DIG0 дисплея
  231  013D: 16 3E            MVI D,'>'           ; баннер-символ снова
  232  013F: 0E 0B            MVI C,0Bh           ; следующий фронт = старт
  233  0141: C3 2A 01         JMP BAN
  234            
  235            ; ---- ДИАГНОСТИКА: мультиплексия дисплея (по разряду за вызов) ----
  236            ; DIG0 = B mod 16 (отправленные кадры), DIG1 = SSELF (=0), DIG2/DIG3 =
  237            ; BYTE0 (=0). ПОРТИТ ТОЛЬКО A/флаги (HL через PUSH/POP).
  238  0170: -                ORG 0170h
  239  0170: 3A 00 80 DMUX:   LDA MUXI
  240  0173: 3C               INR A
  241  0174: E6 03            ANI 3
  242  0176: 32 00 80         STA MUXI
  243  0179: FE 01            CPI 1
  244  017B: CA 93 01         JZ DMX1
  245  017E: FE 02            CPI 2
  246  0180: CA A0 01         JZ DMX2
  247  0183: FE 03            CPI 3
  248  0185: CA AD 01         JZ DMX3
  249  0188: 78               MOV A,B             ; индекс 0: счётчик кадров
  250  0189: E6 0F            ANI 0Fh
  251  018B: CD BE 01         CALL HSEG
  252  018E: 3E 01            MVI A,01h
  253  0190: D3 01            OUT DIGP
  254  0192: C9               RET
  255  0193: 3A 06 80 DMX1:   LDA SSELF           ; индекс 1: (в diag5 всегда 0)
  256  0196: E6 0F            ANI 0Fh
  257  0198: CD BE 01         CALL HSEG
  258  019B: 3E 02            MVI A,02h
  259  019D: D3 01            OUT DIGP
  260  019F: C9               RET
  261  01A0: 3A 01 80 DMX2:   LDA BYTE0           ; индекс 2: мл. ниббл байта (=0)
  262  01A3: E6 0F            ANI 0Fh
  263  01A5: CD BE 01         CALL HSEG
  264  01A8: 3E 04            MVI A,04h
  265  01AA: D3 01            OUT DIGP
  266  01AC: C9               RET
  267  01AD: 3A 01 80 DMX3:   LDA BYTE0           ; индекс 3: ст. ниббл байта (=0)
  268  01B0: 0F               RRC
  269  01B1: 0F               RRC
  270  01B2: 0F               RRC
  271  01B3: 0F               RRC
  272  01B4: E6 0F            ANI 0Fh
  273  01B6: CD BE 01         CALL HSEG
  274  01B9: 3E 08            MVI A,08h
  275  01BB: D3 01            OUT DIGP
  276  01BD: C9               RET
  277  01BE: E5       HSEG:   PUSH H              ; A = ниббл -> OUT SEGP = паттерн; HL цел
  278  01BF: 67               MOV H,A
  279  01C0: 2E D0            MVI L,SEGTAB & 0FFh
  280  01C2: 85               ADD L               ; lo + ниббл: переноса нет (lo=D0h)
  281  01C3: 6F               MOV L,A
  282  01C4: 26 01            MVI H,SEGTAB//256
  283  01C6: 7E               MOV A,M
  284  01C7: E1               POP H
  285  01C8: D3 00            OUT SEGP
  286  01CA: C9               RET
  287            
  288  01D0: -                ORG 01D0h           ; lo = D0h: D0h+0Fh без переноса -- ADD L точен
  289  01D0: 3F 06 5B 4F 66 6D 7D 07 SEGTAB: DB 3Fh,06h,5Bh,4Fh,66h,6Dh,7Dh,07h  ; '0'-'7' (a..g, dp=0)
  290  01D8: 7F 6F 77 7C 39 5E 79 71         DB 7Fh,6Fh,77h,7Ch,39h,5Eh,79h,71h  ; '8'-'F'
  291  01E0: -                END
