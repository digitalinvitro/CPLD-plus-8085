  733            ; =====================================================================
  734            ;                     XSTREAM v1: ЭКРАН -> UART
  735            ; =====================================================================
  736            ; ---------------------------------------------------------------------
  737            ; XSINIT (из MAIN, только холодный старт): демо-экран в B000h,
  738            ; SEQ/PASS = 0. В HW-варианте: делитель, запуск таймера, маска SIM
  739            ; (M7.5 = НЕ маскировать, 6.5/5.5 маскированы), EI.
  740            ; Мониторные переменные не трогаются; B000-B7CF - пользовательская
  741            ; область: ЛЮБАЯ программа может рисовать туда свой текст/графику.
  742            ; ---------------------------------------------------------------------
  743  0447: CD 6C 04 XSINIT: CALL XBLANK
  744  044A: 21 02 07         LXI H,XTBL
  745  044D: 5E       XSI1:   MOV E,M             ; DE = адрес назначения
  746  044E: 23               INX H
  747  044F: 56               MOV D,M
  748  0450: 23               INX H               ; HL -> src_lo
  749  0451: 7A               MOV A,D             ; конец таблицы (dst == 0000)?
  750  0452: B3               ORA E
  751  0453: CA 64 04         JZ XSI3
  752  0456: 4E               MOV C,M             ; BC = адрес строки (источник)
  753  0457: 23               INX H
  754  0458: 46               MOV B,M
  755  0459: 23               INX H               ; HL -> следующая запись
  756  045A: E5               PUSH H              ; указатель следующей записи -> стек
  757  045B: 60               MOV H,B
  758  045C: 69               MOV L,C
  759  045D: CD 7D 04         CALL XCPY           ; ASCIZ [HL] -> [DE], 0 = конец
  760  0460: E1               POP H
  761  0461: C3 4D 04         JMP XSI1
  762  0464: AF       XSI3:   XRA A
  763  0465: 32 FA FF         STA XSSEQ
  764  0468: 32 FB FF         STA XSPASS
  765                    IF TMR_HW
  766                    MVI A,XS_DIVN
  767                    STA XSDIV
  768                    MVI A,TMR_N
  769                    OUT TMRP            ; запустить таймер: 1-й фронт через ~12 мс
  770                    MVI A,00011000b     ; SIM: MSE=1, M7.5=0 (НЕ маскировать), 6.5/5.5 маскированы
  771                    SIM
  772                    EI
  773                    ENDIF
  774  046B: C9               RET
