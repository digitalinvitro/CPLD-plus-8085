  970            ; XUPDCTR: живой счётчик SEQ (hex, 2 цифры) в демо-экран, строка 22:
  971            ;   'SEQ:xx ...' - x на B6E4/B6E5. Доказательство живого потока.
  972            ; ---------------------------------------------------------------------
  973  054D: E5       XUPDCTR: PUSH H
  974  054E: 3A FA FF         LDA XSSEQ
  975  0551: 4F               MOV C,A
  976  0552: 0F               RRC
  977  0553: 0F               RRC
  978  0554: 0F               RRC
  979  0555: 0F               RRC
  980  0556: E6 0F            ANI 0Fh
  981  0558: CD 69 05         CALL XHEX
  982  055B: 32 E4 B6         STA XSCNT
  983  055E: 79               MOV A,C
  984  055F: E6 0F            ANI 0Fh
  985  0561: CD 69 05         CALL XHEX
  986  0564: 32 E5 B6         STA XSCNT+1
  987  0567: E1               POP H
  988  0568: C9               RET
