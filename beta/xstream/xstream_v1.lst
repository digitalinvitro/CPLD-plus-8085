    1            ; =====================================================================
    2            ; beta/xstream -- XSTREAM v1: ПРЕРЫВАНИЯ/ТИК -> ВЕСЬ ЭКРАН В UART
    3            ; (патч монитора fw_mon "ACdE", владелец: "8085 прерывая выдает в UART
    4            ; весь экран, потом идет работать по своим делам в монитор")
    5            ;
    6            ; ИДЕЯ РЕЖИМА (ТЗ владельца, 11-12):
    7            ;   - экран = ФИКСИРОВАННЫЙ буфер ОЗУ B000h..B7CFh (80x25 = 2000 Б,
    8            ;     row-major; любой код байтов, у ПК-клиента трактуется как CP1251);
    9            ;   - по тику (прерыванию) ЦП выдаёт ВЕСЬ экран в UART аппаратным TX
   10            ;     (CPLD v2.3, 1 000 000 бод 8N1, OUT 04h) и возвращается в монитор;
   11            ;   - частота тика = из условия ЦП <= 50% на выдачу, FPS 20-25
   12            ;     (расчёт: scripts/xstream_calc.py; посылка 22.9 мс => потолок
   13            ;     21.3 FPS при 48.8% ЦП; 22 FPS уже 50.2% -> по ТЗ FPS снижается);
   14            ;   - фолбэк 10 FPS = 22.9% ЦП (константы XS_TH/TMR_N).
   15            ;
   16            ; ДВА ВАРИАНТА ТИКА (ключ TMR_HW, сборка -D TMR_HW=1):
   17            ;   TMR_HW=0 (по умолчанию, для ТЕКУЩЕГО образа CPLD txuart v2.3:
   18            ;     источника прерываний нет - RST 7.5 заземлён) - ПРОГРАММНЫЙ ТИК:
   19            ;     накопитель слотов скана XSPASS, каждые XS_TH слотов (~0.33 мс
   20            ;     слот скана монитора) CALL XSEND. Кадр ~47.4 мс = 21.1 FPS,
   21            ;     48.2% ЦП. Тик живёт в контексте монитора: во время
   22            ;     пользовательской программы (E) поток останавливается.
   23            ;   TMR_HW=1 (для будущего фит-а CPLD v24 = txuart + таймер -> RST 7.5,
   24            ;     порт 06h = N, тик 51.2 мкс): ВЕКТОР 003Ch уже прошит, ISR
   25            ;     ре-армит таймер (T = N x 51.2 мкс), делитель XS_DIVN=3 ->
   26            ;     кадр 46.9 мс = 21.3 FPS, 48.8% ЦП. ISR выбивает из монитора:
   27            ;     поток идёт и ВО ВРЕМЯ пользовательской программы (пока та не DI).
   28            ;     Смета v24: база v3.9.8-clear 94 + TX-ядро 18 - узел -7 = 103/108,
   29            ;     остров таймера ~18 МЦ (прескалер 8 + счётчик 8 + строб 1 + P75 1)
   30            ;     => 121/108 - НЕ ЛОЖИТСЯ в XC95108 (документировано в README).
   31            ;
   32            ; ФОРМАТ ПРОВОДА (2003 Б/кадр):
   33            ;   A5 5A [SEQ] + 2000 Б экрана. SEQ++ mod 256 в каждом кадре.
   34            ;   Ресинк клиента по A5 5A; хвост кадра = ровно 2000 Б, без добивки.
   35            ;
   36            ; ПОСЫЛКА (сим xstream_calc + sim_xstream_v1):
   37            ;   РАВНОМЕРНЫЙ пейсинг 35T/Б (УРОК SPRINT: пачки развёртки 23T ->
   38            ;   отбросы: TX принимает 1 Б за 31.25T, запись в busy ОТБРАСЫВАЕТСЯ;
   39            ;   мин. цикл из ОЗУ MOV+OUT+INX = 23T + 3 NOP = 35T >= 31.25T - ноль
   40            ;   отбросов; прецедент p04: равномерные 32T железно);
   41            ;   слот дисплея XDIG (~180T с CALL) каждые 200 Б: регенерация 7-сегмент-
   42            ;   ника не замирает (цикл 4 разрядов ~9.4 мс = ~106 Гц, заполнение 25% -
   43            ;   как в паузе монитора, без мерцания; тон бипа идёт через SND в XDIG);
   44            ;   v1.2: XDIG сама вычисляет разряд из фазы глифа E - ранее бит жил в C,
   45            ;   который съедал счётчик подгруппы, и дисплей гас/циклил на посылке
   46            ;   (урок 11-12-2, «дрожание» на живой плате);
   47            ;   итого ~37.7T/Б => посылка ~24.2 мс; провод (чистый эфир) 20.03 мс.
   48            ;
   49            ; ПАМЯТЬ (MEMORY_MAP.md): ROM 0000-7FFF (вектор RST 7.5 = 003Ch прошит
   50            ;   JMP XISR, код после таблиц смещён на ORG 0040h), RAM 8000-FFFF.
   51            ;   Монитор: переменные FFE8-FFF9, стек с FFE7 вниз. XSTREAM:
   52            ;   XBUF B000-B7CF (пользовательская область), XSSEQ/XSPASS/XSDIV =
   53            ;   FFFA-FFFC (свободно выше PREVST FFF9, стек до них не доходит).
   54            ;
   55            ; ПОРТЫ: 00h сегменты, 01h разряды+SND, 02h колонки, 03h ряды (монитор);
   56            ;   04h TXDATA, 05h TXRDY (не используется), 06h - в v24 загрузка N
   57            ;   (на v2.3 записи игнорируются - безопасно в обоих образах CPLD).
   58            ;
   59            ; СОБРАКА (asm85.py из beta/lowsize/rom; регрессия: fw_mon.hex md5
   60            ;   f9ad5c6deb3bf0618018fd630b1d25aa воспроизводится байт-в-байт):
   61            ;   python3 asm85.py xstream_v1.asm -o xstream_v1.hex -l xstream_v1.lst
   62            ;   HW-вариант:  ... -D TMR_HW=1 -o xstream_v1_hw.hex
   63            ;   (исходник-канон CP1251 = xstream_v1.asm; близнец UTF-8 = xstream_v1_utf8.asm)
   64            ;
   65            ; СИМ: beta/xstream/scripts/sim_xstream_v1.py - исполнение РЕАЛЬНОГО hex,
   66            ;   период кадра, 0 отбросов, побайтовая сверка экрана, нажатие клавиши.
   67            ; =====================================================================
   68            
   69            ; ---- константы монитора (fw_mon, без изменений; переопределяются -D) ----
   70            FAST    EQU 0               ; 1 = укороченные паузы (для симуляции)
   71            IF FAST
   72            TICK_MS EQU 4               ; тик клавиши, единиц ~1 мс (быстро)
   73            SET_MS  EQU 2               ; дебаунс после отпускания
   74            ELSE
   75            TICK_MS EQU 30              ; 30 x ~1.2 мс = ~36 мс тик (на CPU 3.125 МГц)
   76            SET_MS  EQU 30              ; 30 x ~1.2 мс = ~36 мс дебаунс
   77            ENDIF
   78            
   79            K_MS    EQU 144             ; внутренний счётчик единицы ~1 мс
   80            
   81            ; ---- порты CPLD (декод по A2-A0, зеркала mod 8) ----
   82            SEGP    EQU 00h             ; сегменты: D0=a..D6=g, D7=dp; 1 = горит
   83            DIGP    EQU 01h             ; D3-D0 разряды, D4 = SND
   84            KBCOLP  EQU 02h             ; D3-D0 колонки (1 = заведена)
   85            KBROWP  EQU 03h             ; D4-D0 ряды (1 = нажата в активной колонке)
   86            
   87            ; ---- XSTREAM v1 ----
   88            TMR_HW  EQU 0               ; 0 = SW-тик (CPLD txuart v2.3); 1 = таймер->RST 7.5 (v24)
   89            TXPORT  EQU 04h             ; TXDATA ядра TX v2.3 (запись при busy отбрасывается)
   90            TMRP    EQU 06h             ; v24: загрузка N таймера (на v2.3 запись игнорируется)
   91            XBUF    EQU 0B000h          ; ЭКРАН 80x25 = 2000 Б (B000h..B7CFh)
   92            XSSEQ   EQU 0FFFAh          ; SEQ кадра mod 256
   93            XSPASS  EQU 0FFFBh          ; накопитель слотов скана между кадрами (SW-тик)
   94            XSDIV   EQU 0FFFCh          ; делитель ISR (только TMR_HW=1)
   95            XS_TH   EQU 71              ; слотов скана между кадрами (сим-калибровка; ~49.8 мс)
   96            XS_QINC EQU 4               ; добавка за единицу QUNIT/BUNIT (~1.2 мс = 3.7 слота)
   97            TMR_N   EQU 250             ; v24: N тиков по 51.2 мкс = 12.80 мс
   98            XS_DIVN EQU 2               ; v24: ISR на кадр; период = посылка + 2x12.80 = 49.7 мс
   99            XSCNT   EQU XBUF+06E4h      ; живой счётчик SEQ в демо-экране (строка 22, кол. 4-5)
  100            
  101            ; ---- коды клавиш ----
  102            K_ENT   EQU 10h             ; Enter  (row3/col3, SW16)
  103            K_F1    EQU 11h             ; F1     (row4/col1, SW18) - меню
  104            K_F2    EQU 12h             ; F2     (row4/col2, SW19) - показ адреса
  105            K_NONE  EQU 0FFh            ; пустая позиция матрицы
  106            
  107            ; ---- состояния ----
  108            ST_MENU EQU 00h             ; меню "ACDE"
  109            ST_ADDR EQU 01h             ; ввод адреса
  110            ST_PROG EQU 02h             ; ввод кода (Code)
  111            ST_VIEW EQU 03h             ; просмотр кода
  112            ST_SHOW EQU 04h             ; показ адреса операций (F2)
  113            
  114            ; ---- ОЗУ монитора (FFE8h-FFF9h; стек с FFE7 вниз) ----
  115            SP0     EQU 0FFE8h          ; SP монитора
  116            SNDST   EQU 0FFE8h          ; состояние тона 0/1
  117            STATE   EQU 0FFE9h          ; 0=меню, 1=адрес, 2=код, 3=просмотр
  118            ADDRH   EQU 0FFEAh          ; текущий адрес (старший)
  119            ADDRL   EQU 0FFEBh          ; текущий адрес (младший)
  120            ADCNT   EQU 0FFECh          ; введено тетрад адреса (0..4)
  121            AF3     EQU 0FFEDh          ; тетрады адреса (AF3 - старшая...)
  122            AF2     EQU 0FFEEh
  123            AF1     EQU 0FFEFh
  124            AF0     EQU 0FFF0h
  125            BDCNT   EQU 0FFF1h          ; введено тетрад байта (0..2)
  126            BF1     EQU 0FFF2h          ; старшая тетрада байта
  127            BF0     EQU 0FFF3h          ; младшая тетрада байта
  128            DPIDX   EQU 0FFF4h          ; фаза регенерации 0..3 (0 = DIG0)
  129            DIGIMG  EQU 0FFF5h          ; глифы разрядов DIG0..DIG3 (4 байта)
  130            DIGIMG0 EQU 0FFF5h          ;   правый (DIG0)
  131            DIGIMG1 EQU 0FFF6h
  132            DIGIMG2 EQU 0FFF7h
  133            DIGIMG3 EQU 0FFF8h          ;   левый (DIG3)
  134            PREVST  EQU 0FFF9h          ; прежний режим для F2
  135            
  136            ; =====================================================================
  137            ;                    СБРОС, ТАБЛИЦЫ, ВЕКТОР RST 7.5
  138            ; =====================================================================
  139  0000: -                ORG 0000h
  140  0000: C3 ED 01         JMP MAIN
  141            
  142            ; ---- глифы '0'..'F' (a,b,c,d,e,f,g = D0..D6) ----
  143  0003: 3F       GTBL:   DB 3Fh              ; '0'
  144  0004: 06               DB 06h              ; '1'
  145  0005: 5B               DB 5Bh              ; '2'
  146  0006: 4F               DB 4Fh              ; '3'
  147  0007: 66               DB 66h              ; '4'
  148  0008: 6D               DB 6Dh              ; '5'
  149  0009: 7D               DB 7Dh              ; '6'
  150  000A: 07               DB 07h              ; '7'
  151  000B: 7F               DB 7Fh              ; '8'
  152  000C: 6F               DB 6Fh              ; '9'
  153  000D: 77               DB 77h              ; 'A'
  154  000E: 7C               DB 7Ch              ; 'b'
  155  000F: 39               DB 39h              ; 'C'
  156  0010: 5E               DB 5Eh              ; 'd'
  157  0011: 79               DB 79h              ; 'E'
  158  0012: 71               DB 71h              ; 'F'
  159            
  160            ; ---- биты разрядов (индекс = DPIDX: 0=DIG0 правый ... 3=DIG3 левый) ----
  161  0013: 01 02 04 08 BITTBL: DB 01h,02h,04h,08h
  162            
  163            ; ---- таблица клавиш: KEYTBL[row*4+col] ----
  164  0017: 0A 0B 0C 0D KEYTBL: DB 0Ah,0Bh,0Ch,0Dh  ; row0: A  B  C  D
  165  001B: 07 08 09 0E         DB 07h,08h,09h,0Eh  ; row1: 7  8  9  E
  166  001F: 04 05 06 0F         DB 04h,05h,06h,0Fh  ; row2: 4  5  6  F
  167  0023: 01 02 03 10         DB 01h,02h,03h,10h  ; row3: 1  2  3  Enter
  168  0027: 00 11 12 FF         DB 00h,11h,12h,0FFh ; row4: 0  F1 F2 (нет)
  169            
  170            ; ---- ВЕКТОР RST 7.5 (003Ch) - XSTREAM ----
  171            ;   TMR_HW=1: обработчик кадра по таймеру CPLD (v24);
  172            ;   TMR_HW=0: на CPLD v2.3 линия заземлена - вход невозможен.
  173  003C: -                ORG 003Ch
  174  003C: C3 73 05         JMP XISR
  175            
  176  0040: -                ORG 0040h           ; код монитора смещён вектором (3 Б из 003Ch)
  177            
  178            ; ---------------------------------------------------------------------
  179            ; SETTLE: пауза ~25 мкс (успокоение колонки клавиатуры)
  180            ; ---------------------------------------------------------------------
  181  0040: 01 03 00 SETTLE: LXI B,3
  182  0043: 0B       STL:    DCX B
  183  0044: 78               MOV A,B
  184  0045: B1               ORA C
  185  0046: C2 43 00         JNZ STL
  186  0049: C9               RET
  187            
  188            ; ---------------------------------------------------------------------
  189            ; SCANALL: опрос всех 4 колонок; A = ИЛИ рядов (0 = нажатий нет);
  190            ; колонки на выходе погашены. Портит A/B/C/D/E.
  191            ; ---------------------------------------------------------------------
  192  004A: AF       SCANALL: XRA A
  193  004B: 5F               MOV E,A             ; E = накопитель
  194  004C: 16 01            MVI D,01h           ; D = бит колонки
  195  004E: 7A       SAL1:   MOV A,D
  196  004F: D3 02            OUT KBCOLP
  197  0051: CD 40 00         CALL SETTLE
  198  0054: DB 03            IN KBROWP
  199  0056: E6 1F            ANI 1Fh
  200  0058: B3               ORA E
  201  0059: 5F               MOV E,A
  202  005A: 7A               MOV A,D
  203  005B: 07               RLC
  204  005C: 57               MOV D,A
  205  005D: FE 10            CPI 10h
  206  005F: C2 4E 00         JNZ SAL1
  207  0062: AF               XRA A
  208  0063: D3 02            OUT KBCOLP
  209  0065: 7B               MOV A,E
  210  0066: C9               RET
  211            
  212            ; ---------------------------------------------------------------------
  213            ; REFRESH: один слот регенерации. ГАШЕНИЕ -> РАЗРЯД -> ГЛИФ.
  214            ; DIGIMG[DPIDX] на разряд DPIDX. Бит D4 (SND) уносится записью DIGP -
  215            ; дисплей при тоне не гаснет. Портит A/B/C/H/L.
  216            ; ---------------------------------------------------------------------
  217  0067: 3A F4 FF REFRESH: LDA DPIDX
  218  006A: 4F               MOV C,A             ; C = индекс 0..3
  219  006B: 06 00            MVI B,0
  220  006D: 21 13 00         LXI H,BITTBL
  221  0070: 09               DAD B
  222  0071: 46               MOV B,M             ; B = бит разряда (01,02,04,08)
  223  0072: 21 F5 FF         LXI H,DIGIMG        ; HL = DIGIMG + DPIDX
  224  0075: 79       RFIL:   MOV A,C
  225  0076: B7               ORA A
  226  0077: CA 7F 00         JZ RFGD
  227  007A: 2C               INR L
  228  007B: 0D               DCR C
  229  007C: C3 75 00         JMP RFIL
  230  007F: 4E       RFGD:   MOV C,M             ; C = глиф разряда
  231  0080: 3A E8 FF         LDA SNDST
  232  0083: B7               ORA A
  233  0084: CA 8B 00         JZ RFN
  234  0087: 78               MOV A,B
  235  0088: F6 10            ORI 10h
  236  008A: 47               MOV B,A             ; B |= SND
  237  008B: AF       RFN:    XRA A
  238  008C: D3 00            OUT SEGP            ; (1) гашение: старый разряд погас
  239  008E: 78               MOV A,B
  240  008F: D3 01            OUT DIGP            ; (2) разряд переключён (сегменты пусты)
  241  0091: 79               MOV A,C
  242  0092: D3 00            OUT SEGP            ; (3) зажгли глиф нового разряда
  243  0094: 3A F4 FF         LDA DPIDX
  244  0097: 3C               INR A
  245  0098: E6 03            ANI 03h
  246  009A: 32 F4 FF         STA DPIDX
  247  009D: C9               RET
  248            
  249            ; ---------------------------------------------------------------------
  250            ; BUNIT: единица ~1 мс + тоггл SNDST + регенерация дисплея
  251            ;         + XSTREAM SW-тик (кадр не останавливается на тоне/дебаунсе)
  252            ; QUNIT: единица ~1 мс без звука, дисплей живёт
  253            ; ---------------------------------------------------------------------
  254  009E: 01 90 00 BUNIT:  LXI B,K_MS
  255  00A1: 0B       BUL:    DCX B
  256  00A2: 78               MOV A,B
  257  00A3: B1               ORA C
  258  00A4: C2 A1 00         JNZ BUL
  259  00A7: 3A E8 FF         LDA SNDST
  260  00AA: EE 01            XRI 01h
  261  00AC: 32 E8 FF         STA SNDST
  262  00AF: CD 67 00         CALL REFRESH
  263  00B2: 3E 04            MVI A,XS_QINC
  264  00B4: CD 86 04         CALL XSCHK          ; XSTREAM: тик кадра
  265  00B7: C9               RET
  266            
  267  00B8: 01 90 00 QUNIT:  LXI B,K_MS
  268  00BB: 0B       QUL:    DCX B
  269  00BC: 78               MOV A,B
  270  00BD: B1               ORA C
  271  00BE: C2 BB 00         JNZ QUL
  272  00C1: CD 67 00         CALL REFRESH
  273  00C4: C9               RET
  274            
  275            ; ---------------------------------------------------------------------
  276            ; TICKON: короткий тик подтверждения клавиши (TICK_MS единиц ~1 мс,
  277            ; тон ~415 Гц на CPU 3.125 МГц). Счётчик - В DE.
  278            ; ---------------------------------------------------------------------
  279  00C5: 11 1E 00 TICKON: LXI D,TICK_MS
  280  00C8: CD 9E 00 TK1:    CALL BUNIT
  281  00CB: 1B               DCX D
  282  00CC: 7A               MOV A,D
  283  00CD: B3               ORA E
  284  00CE: C2 C8 00         JNZ TK1
  285  00D1: AF               XRA A
  286  00D2: 32 E8 FF         STA SNDST           ; тон гарантированно погашен
  287  00D5: C9               RET
  288            
  289            ; ---------------------------------------------------------------------
  290            ; GLOOK: A = тетрада 0..F -> A = глиф (GTBL). Портит A/B/C/H/L.
  291            ; ---------------------------------------------------------------------
  292  00D6: 4F       GLOOK:  MOV C,A
  293  00D7: 06 00            MVI B,0
  294  00D9: 21 03 00         LXI H,GTBL
  295  00DC: 09               DAD B
  296  00DD: 7E               MOV A,M
  297  00DE: C9               RET
  298            
  299            ; ---------------------------------------------------------------------
  300            ; REDRAW: пересобрать DIGIMG[0..3] по состоянию (меню/адрес/код/...)
  301            ; ---------------------------------------------------------------------
  302  00DF: 3A E9 FF REDRAW: LDA STATE
  303  00E2: B7               ORA A
  304  00E3: CA 84 01         JZ RDM
  305  00E6: FE 01            CPI 01h
  306  00E8: CA 9B 01         JZ RDA
  307  00EB: FE 03            CPI 03h
  308  00ED: CA 26 01         JZ RDV
  309  00F0: FE 04            CPI 04h
  310  00F2: CA 4F 01         JZ RDW
  311                    ; ---- ST_PROG ----
  312  00F5: AF               XRA A
  313  00F6: 32 F8 FF         STA DIGIMG3
  314  00F9: 32 F7 FF         STA DIGIMG2
  315  00FC: 32 F6 FF         STA DIGIMG1
  316  00FF: 32 F5 FF         STA DIGIMG0
  317  0102: 3A F1 FF         LDA BDCNT
  318  0105: FE 02            CPI 02h
  319  0107: DA 13 01         JC RDPR0            ; <2 - старшая тетрада пуста
  320  010A: 3A F2 FF         LDA BF1
  321  010D: CD D6 00         CALL GLOOK
  322  0110: 32 F6 FF         STA DIGIMG1
  323  0113: 3A F1 FF RDPR0:  LDA BDCNT
  324  0116: B7               ORA A
  325  0117: CA EC 01         JZ RDRE             ; 0 - младшая тоже пуста
  326  011A: 3A F3 FF         LDA BF0
  327  011D: CD D6 00         CALL GLOOK
  328  0120: 32 F5 FF         STA DIGIMG0
  329  0123: C3 EC 01         JMP RDRE
  330  0126: 3A EA FF RDV:    LDA ADDRH           ; ---- ST_VIEW: [ADDR] в правых разрядах ----
  331  0129: 67               MOV H,A
  332  012A: 3A EB FF         LDA ADDRL
  333  012D: 6F               MOV L,A             ; HL = ADDR
  334  012E: 7E               MOV A,M             ; A = [ADDR] (HL>=8000h - ОЗУ)
  335  012F: 57               MOV D,A             ; D = байт (GLOOK портит B)
  336  0130: 0F               RRC
  337  0131: 0F               RRC
  338  0132: 0F               RRC
  339  0133: 0F               RRC
