  795            ; ---------------------------------------------------------------------
  796            ; XSCHK: SW-тик кадра. A = добавка слотов (1 = слот скана ~0.37 мс,
  797            ; XS_QINC = единица QUNIT/BUNIT ~1.2 мс). Накопитель XSPASS;
  798            ; порог XS_TH -> XSEND (~24.3 мс) и сброс. Портит A/C; D/E/B целы.
  799            ; В HW-варианте тело выключено (кадр ведёт ISR) - вызов = RET.
  800            ; ---------------------------------------------------------------------
  801                    IF TMR_HW
  802            XSCHK:  RET                 ; HW: кадр ведёт ISR по таймеру; SW-тик отключён
  803                    ELSE
  804  0486: 4F       XSCHK:  MOV C,A
  805  0487: 3A FB FF         LDA XSPASS
  806  048A: 81               ADD C
  807  048B: 32 FB FF         STA XSPASS
  808  048E: FE 47            CPI XS_TH
  809  0490: DA 9A 04         JC XSKR             ; < порога - выход
  810  0493: CD 9B 04         CALL XSEND          ; КАДР -> UART (~24.3 мс)
  811  0496: AF               XRA A
  812  0497: 32 FB FF         STA XSPASS          ; счётчик заново
  813  049A: C9       XSKR:   RET
  814                    ENDIF
  815            
  816            ; ---------------------------------------------------------------------
  817            ; XSEND: кадр XSTREAM в UART: A5 5A [SEQ] + 2000 Б из XBUF.
  818            ;   Сохраняет PSW/B/D/H. РАВНОМЕРНЫЙ пейсинг 35T/Б (7+10+6+3x4 >= 31.25T,
  819            ;   ноль отбросов TX, прецедент p04); каждые 80 Б - слот дисплея XDIG
  820            ;   (DE/C - фаза дисплея после inner, B - внешний счётчик групп).
  821            ; ---------------------------------------------------------------------
  822  049B: F5       XSEND:  PUSH PSW
  823  049C: C5               PUSH B
  824  049D: D5               PUSH D
  825  049E: E5               PUSH H
  826  049F: CD 46 05         CALL XUPDCTR        ; живой счётчик SEQ в демо-экран
  827  04A2: 3E A5            MVI A,0A5h
  828  04A4: D3 04            OUT TXPORT          ; шапка: равномерный пейсинг 33T (4 NOP)
  829  04A6: 00               NOP
  830  04A7: 00               NOP
  831  04A8: 00               NOP
  832  04A9: 00               NOP
  833  04AA: 3E 5A            MVI A,05Ah
  834  04AC: D3 04            OUT TXPORT
  835  04AE: 00               NOP
  836  04AF: 00               NOP
  837  04B0: 00               NOP
  838  04B1: 00               NOP
  839  04B2: 3A FA FF         LDA XSSEQ
  840  04B5: D3 04            OUT TXPORT
  841  04B7: 00               NOP
  842  04B8: 00               NOP
  843  04B9: 00               NOP
  844  04BA: 00               NOP
  845  04BB: 3C               INR A
  846  04BC: 32 FA FF         STA XSSEQ           ; SEQ++ mod 256
  847  04BF: 3A F4 FF         LDA DPIDX           ; фаза дисплея: DE = 0FFF5+idx (глиф), C = бит разряда
  848  04C2: 4F               MOV C,A
  849  04C3: C6 F5            ADI 0F5h
  850  04C5: 5F               MOV E,A             ; E = 0F5h..0F8h (младший байт указателя глифа)
  851  04C6: 16 FF            MVI D,0FFh          ; D = 0FFh -> DE = 0FFF5h..0FFF8h (DIGIMG0..3)
  852  04C8: 79               MOV A,C
  853  04C9: 06 00            MVI B,0
  854  04CB: 21 13 00         LXI H,BITTBL
  855  04CE: 09               DAD B
  856  04CF: 7E               MOV A,M
  857  04D0: 4F               MOV C,A             ; C = бит разряда 01/02/04/08 (свободен вне inner)
  858  04D1: 21 00 B0         LXI H,XBUF          ; HL = экран
  859  04D4: 06 0A            MVI B,10            ; внешний: 10 групп по 200 Б (слот дисплея)
  860  04D6: 0E 19    XSOUT:  MVI C,25            ; внутренний: 25 подгрупп по 8 Б
  861  04D8: 7E       XSL:    MOV A,M
  862  04D9: D3 04            OUT TXPORT          ; равномерный пейсинг: гэп OUT->OUT = 23T+пад >= 31.25T
  863  04DB: 23               INX H
  864  04DC: 00               NOP
  865  04DD: 00               NOP
  866  04DE: 00               NOP
  867  04DF: 7E               MOV A,M
  868  04E0: D3 04            OUT TXPORT
