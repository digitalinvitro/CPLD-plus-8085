  831  04A2: 3E A5            MVI A,0A5h
  832  04A4: D3 04            OUT TXPORT          ; шапка: равномерный пейсинг 33T (4 NOP)
  833  04A6: 00               NOP
  834  04A7: 00               NOP
  835  04A8: 00               NOP
  836  04A9: 00               NOP
  837  04AA: 3E 5A            MVI A,05Ah
  838  04AC: D3 04            OUT TXPORT
  839  04AE: 00               NOP
  840  04AF: 00               NOP
  841  04B0: 00               NOP
  842  04B1: 00               NOP
  843  04B2: 3A FA FF         LDA XSSEQ
  844  04B5: D3 04            OUT TXPORT
  845  04B7: 00               NOP
  846  04B8: 00               NOP
  847  04B9: 00               NOP
  848  04BA: 00               NOP
  849  04BB: 3C               INR A
  850  04BC: 32 FA FF         STA XSSEQ           ; SEQ++ mod 256
  851  04BF: 3A F4 FF         LDA DPIDX           ; фаза дисплея: DE = 0FFF5+idx (глиф), C = бит разряда
  852  04C2: 4F               MOV C,A
  853  04C3: C6 F5            ADI 0F5h
  854  04C5: 5F               MOV E,A             ; E = 0F5h..0F8h (младший байт указателя глифа)
  855  04C6: 16 FF            MVI D,0FFh          ; D = 0FFh -> DE = 0FFF5h..0FFF8h (DIGIMG0..3)
  856  04C8: 79               MOV A,C
  857  04C9: 06 00            MVI B,0
  858  04CB: 21 13 00         LXI H,BITTBL
  859  04CE: 09               DAD B
  860  04CF: 7E               MOV A,M
  861  04D0: 4F               MOV C,A             ; C = бит разряда 01/02/04/08 (свободен вне inner)
  862  04D1: 21 00 B0         LXI H,XBUF          ; HL = экран
  863  04D4: 06 0A            MVI B,10            ; внешний: 10 групп по 200 Б (слот дисплея)
  864  04D6: 0E 19    XSOUT:  MVI C,25            ; внутренний: 25 подгрупп по 8 Б
  865  04D8: 7E       XSL:    MOV A,M
  866  04D9: D3 04            OUT TXPORT          ; равномерный пейсинг: гэп OUT->OUT = 23T+пад >= 31.25T
  867  04DB: 23               INX H
