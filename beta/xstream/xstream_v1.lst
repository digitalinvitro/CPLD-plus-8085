    1            ; =====================================================================
    2            ; beta/xstream -- XSTREAM v1: ПРЕРЫВАНИЯ/ТИК -> ВЕСЬ ЭКРАН В UART
    3            ; (патч монитора fw_mon "ACdE", владелец: "8085 прерывая выдает в UART
    4            ; весь экран, потом идет работать по своим делам в монитор")
    5            ;
    6            ; ИДЕЯ РЕЖИМА (ТЗ владельца, 11-12):
    7            ;   - экран = ФИКСИРОВАННЫЙ буфер ОЗУ B000h..B7CFh (80x25 = 2000 Б,
    8            ;     row-major; любой код байтов, у ПК-клиента трактуется как CP1251);
    9            ;   - по тику (прерыванию) ЦП выдаёт ВЕСЬ экран в UART аппаратным TX
   10            ;     (CPLD v2.3, 1 000 000 бод 8N1, OUT 04h) и возвращается в монитор;
   11            ;   - частота тика = из условия ЦП <= 50% на выдачу, FPS 20-25
   12            ;     (расчёт: scripts/xstream_calc.py; посылка 22.9 мс => потолок
   13            ;     21.3 FPS при 48.8% ЦП; 22 FPS уже 50.2% -> по ТЗ FPS снижается);
   14            ;   - фолбэк 10 FPS = 22.9% ЦП (константы XS_TH/TMR_N).
   15            ;
   16            ; ДВА ВАРИАНТА ТИКА (ключ TMR_HW, сборка -D TMR_HW=1):
   17            ;   TMR_HW=0 (по умолчанию, для ТЕКУЩЕГО образа CPLD txuart v2.3:
   18            ;     источника прерываний нет - RST 7.5 заземлён) - ПРОГРАММНЫЙ ТИК:
   19            ;     накопитель слотов скана XSPASS, каждые XS_TH слотов (~0.33 мс
   20            ;     слот скана монитора) CALL XSEND. Кадр ~47.4 мс = 21.1 FPS,
   21            ;     48.2% ЦП. Тик живёт в контексте монитора: во время
   22            ;     пользовательской программы (E) поток останавливается.
   23            ;   TMR_HW=1 (для будущего фит-а CPLD v24 = txuart + таймер -> RST 7.5,
   24            ;     порт 06h = N, тик 51.2 мкс): ВЕКТОР 003Ch уже прошит, ISR
   25            ;     ре-армит таймер (T = N x 51.2 мкс), делитель XS_DIVN=3 ->
   26            ;     кадр 46.9 мс = 21.3 FPS, 48.8% ЦП. ISR выбивает из монитора:
   27            ;     поток идёт и ВО ВРЕМЯ пользовательской программы (пока та не DI).
   28            ;     Смета v24: база v3.9.8-clear 94 + TX-ядро 18 - узел -7 = 103/108,
   29            ;     остров таймера ~18 МЦ (прескалер 8 + счётчик 8 + строб 1 + P75 1)
   30            ;     => 121/108 - НЕ ЛОЖИТСЯ в XC95108 (документировано в README).
   31            ;
   32            ; ФОРМАТ ПРОВОДА (2003 Б/кадр):
   33            ;   A5 5A [SEQ] + 2000 Б экрана. SEQ++ mod 256 в каждом кадре.
   34            ;   Ресинк клиента по A5 5A; хвост кадра = ровно 2000 Б, без добивки.
   35            ;
   36            ; ПОСЫЛКА (сим xstream_calc + sim_xstream_v1):
   37            ;   РАВНОМЕРНЫЙ пейсинг 35T/Б (УРОК SPRINT: пачки развёртки 23T ->
   38            ;   отбросы: TX принимает 1 Б за 31.25T, запись в busy ОТБРАСЫВАЕТСЯ;
   39            ;   мин. цикл из ОЗУ MOV+OUT+INX = 23T + 3 NOP = 35T >= 31.25T - ноль
   40            ;   отбросов; прецедент p04: равномерные 32T железно);
   41            ;   слот дисплея XDIG (~147T с CALL) каждые 200 Б: регенерация 7-сегмент-
   42            ;   ника не замирает (цикл разряда ~4.8 мс, ~207 Гц - без мерцания; тон
   43            ;   бипа идёт через SND в XDIG);
   44            ;   итого ~37.7T/Б => посылка ~24.2 мс; провод (чистый эфир) 20.03 мс.
   45            ;
   46            ; ПАМЯТЬ (MEMORY_MAP.md): ROM 0000-7FFF (вектор RST 7.5 = 003Ch прошит
   47            ;   JMP XISR, код после таблиц смещён на ORG 0040h), RAM 8000-FFFF.
   48            ;   Монитор: переменные FFE8-FFF9, стек с FFE7 вниз. XSTREAM:
   49            ;   XBUF B000-B7CF (пользовательская область), XSSEQ/XSPASS/XSDIV =
   50            ;   FFFA-FFFC (свободно выше PREVST FFF9, стек до них не доходит).
   51            ;
   52            ; ПОРТЫ: 00h сегменты, 01h разряды+SND, 02h колонки, 03h ряды (монитор);
   53            ;   04h TXDATA, 05h TXRDY (не используется), 06h - в v24 загрузка N
   54            ;   (на v2.3 записи игнорируются - безопасно в обоих образах CPLD).
   55            ;
   56            ; СОБРАКА (asm85.py из beta/lowsize/rom; регрессия: fw_mon.hex md5
   57            ;   f9ad5c6deb3bf0618018fd630b1d25aa воспроизводится байт-в-байт):
   58            ;   python3 asm85.py xstream_v1.asm -o xstream_v1.hex -l xstream_v1.lst
   59            ;   HW-вариант:  ... -D TMR_HW=1 -o xstream_v1_hw.hex
   60            ;   (исходник-канон CP1251 = xstream_v1.asm; близнец UTF-8 = xstream_v1_utf8.asm)
   61            ;
   62            ; СИМ: beta/xstream/scripts/sim_xstream_v1.py - исполнение РЕАЛЬНОГО hex,
   63            ;   период кадра, 0 отбросов, побайтовая сверка экрана, нажатие клавиши.
   64            ; =====================================================================
   65            
   66            ; ---- константы монитора (fw_mon, без изменений; переопределяются -D) ----
   67            FAST    EQU 0               ; 1 = укороченные паузы (для симуляции)
   68            IF FAST
   69            TICK_MS EQU 4               ; тик клавиши, единиц ~1 мс (быстро)
   70            SET_MS  EQU 2               ; дебаунс после отпускания
   71            ELSE
   72            TICK_MS EQU 30              ; 30 x ~1.2 мс = ~36 мс тик (на CPU 3.125 МГц)
   73            SET_MS  EQU 30              ; 30 x ~1.2 мс = ~36 мс дебаунс
   74            ENDIF
   75            
   76            K_MS    EQU 144             ; внутренний счётчик единицы ~1 мс
   77            
   78            ; ---- порты CPLD (декод по A2-A0, зеркала mod 8) ----
   79            SEGP    EQU 00h             ; сегменты: D0=a..D6=g, D7=dp; 1 = горит
   80            DIGP    EQU 01h             ; D3-D0 разряды, D4 = SND
   81            KBCOLP  EQU 02h             ; D3-D0 колонки (1 = заведена)
   82            KBROWP  EQU 03h             ; D4-D0 ряды (1 = нажата в активной колонке)
   83            
   84            ; ---- XSTREAM v1 ----
   85            TMR_HW  EQU 0               ; 0 = SW-тик (CPLD txuart v2.3); 1 = таймер->RST 7.5 (v24)
   86            TXPORT  EQU 04h             ; TXDATA ядра TX v2.3 (запись при busy отбрасывается)
   87            TMRP    EQU 06h             ; v24: загрузка N таймера (на v2.3 запись игнорируется)
   88            XBUF    EQU 0B000h          ; ЭКРАН 80x25 = 2000 Б (B000h..B7CFh)
   89            XSSEQ   EQU 0FFFAh          ; SEQ кадра mod 256
   90            XSPASS  EQU 0FFFBh          ; накопитель слотов скана между кадрами (SW-тик)
   91            XSDIV   EQU 0FFFCh          ; делитель ISR (только TMR_HW=1)
   92            XS_TH   EQU 71              ; слотов скана между кадрами (сим-калибровка; ~49.8 мс)
   93            XS_QINC EQU 4               ; добавка за единицу QUNIT/BUNIT (~1.2 мс = 3.7 слота)
   94            TMR_N   EQU 250             ; v24: N тиков по 51.2 мкс = 12.80 мс
   95            XS_DIVN EQU 2               ; v24: ISR на кадр; период = посылка + 2x12.80 = 49.7 мс
   96            XSCNT   EQU XBUF+06E4h      ; живой счётчик SEQ в демо-экране (строка 22, кол. 4-5)
   97            
   98            ; ---- коды клавиш ----
   99            K_ENT   EQU 10h             ; Enter  (row3/col3, SW16)
  100            K_F1    EQU 11h             ; F1     (row4/col1, SW18) - меню
  101            K_F2    EQU 12h             ; F2     (row4/col2, SW19) - показ адреса
  102            K_NONE  EQU 0FFh            ; пустая позиция матрицы
  103            
  104            ; ---- состояния ----
  105            ST_MENU EQU 00h             ; меню "ACDE"
  106            ST_ADDR EQU 01h             ; ввод адреса
  107            ST_PROG EQU 02h             ; ввод кода (Code)
  108            ST_VIEW EQU 03h             ; просмотр кода
  109            ST_SHOW EQU 04h             ; показ адреса операций (F2)
  110            
  111            ; ---- ОЗУ монитора (FFE8h-FFF9h; стек с FFE7 вниз) ----
  112            SP0     EQU 0FFE8h          ; SP монитора
  113            SNDST   EQU 0FFE8h          ; состояние тона 0/1
  114            STATE   EQU 0FFE9h          ; 0=меню, 1=адрес, 2=код, 3=просмотр
  115            ADDRH   EQU 0FFEAh          ; текущий адрес (старший)
  116            ADDRL   EQU 0FFEBh          ; текущий адрес (младший)
  117            ADCNT   EQU 0FFECh          ; введено тетрад адреса (0..4)
  118            AF3     EQU 0FFEDh          ; тетрады адреса (AF3 - старшая...)
  119            AF2     EQU 0FFEEh
  120            AF1     EQU 0FFEFh
  121            AF0     EQU 0FFF0h
  122            BDCNT   EQU 0FFF1h          ; введено тетрад байта (0..2)
  123            BF1     EQU 0FFF2h          ; старшая тетрада байта
  124            BF0     EQU 0FFF3h          ; младшая тетрада байта
  125            DPIDX   EQU 0FFF4h          ; фаза регенерации 0..3 (0 = DIG0)
  126            DIGIMG  EQU 0FFF5h          ; глифы разрядов DIG0..DIG3 (4 байта)
  127            DIGIMG0 EQU 0FFF5h          ;   правый (DIG0)
  128            DIGIMG1 EQU 0FFF6h
  129            DIGIMG2 EQU 0FFF7h
  130            DIGIMG3 EQU 0FFF8h          ;   левый (DIG3)
  131            PREVST  EQU 0FFF9h          ; прежний режим для F2
  132            
  133            ; =====================================================================
  134            ;                    СБРОС, ТАБЛИЦЫ, ВЕКТОР RST 7.5
  135            ; =====================================================================
  136  0000: -                ORG 0000h
  137  0000: C3 ED 01         JMP MAIN
  138            
  139            ; ---- глифы '0'..'F' (a,b,c,d,e,f,g = D0..D6) ----
  140  0003: 3F       GTBL:   DB 3Fh              ; '0'
  141  0004: 06               DB 06h              ; '1'
  142  0005: 5B               DB 5Bh              ; '2'
  143  0006: 4F               DB 4Fh              ; '3'
  144  0007: 66               DB 66h              ; '4'
  145  0008: 6D               DB 6Dh              ; '5'
  146  0009: 7D               DB 7Dh              ; '6'
  147  000A: 07               DB 07h              ; '7'
  148  000B: 7F               DB 7Fh              ; '8'
  149  000C: 6F               DB 6Fh              ; '9'
  150  000D: 77               DB 77h              ; 'A'
  151  000E: 7C               DB 7Ch              ; 'b'
  152  000F: 39               DB 39h              ; 'C'
  153  0010: 5E               DB 5Eh              ; 'd'
  154  0011: 79               DB 79h              ; 'E'
  155  0012: 71               DB 71h              ; 'F'
  156            
  157            ; ---- биты разрядов (индекс = DPIDX: 0=DIG0 правый ... 3=DIG3 левый) ----
  158  0013: 01 02 04 08 BITTBL: DB 01h,02h,04h,08h
  159            
  160            ; ---- таблица клавиш: KEYTBL[row*4+col] ----
  161  0017: 0A 0B 0C 0D KEYTBL: DB 0Ah,0Bh,0Ch,0Dh  ; row0: A  B  C  D
  162  001B: 07 08 09 0E         DB 07h,08h,09h,0Eh  ; row1: 7  8  9  E
  163  001F: 04 05 06 0F         DB 04h,05h,06h,0Fh  ; row2: 4  5  6  F
  164  0023: 01 02 03 10         DB 01h,02h,03h,10h  ; row3: 1  2  3  Enter
  165  0027: 00 11 12 FF         DB 00h,11h,12h,0FFh ; row4: 0  F1 F2 (нет)
  166            
  167            ; ---- ВЕКТОР RST 7.5 (003Ch) - XSTREAM ----
  168            ;   TMR_HW=1: обработчик кадра по таймеру CPLD (v24);
  169            ;   TMR_HW=0: на CPLD v2.3 линия заземлена - вход невозможен.
  170  003C: -                ORG 003Ch
  171  003C: C3 6C 05         JMP XISR
  172            
  173  0040: -                ORG 0040h           ; код монитора смещён вектором (3 Б из 003Ch)
  174            
  175            ; ---------------------------------------------------------------------
  176            ; SETTLE: пауза ~25 мкс (успокоение колонки клавиатуры)
  177            ; ---------------------------------------------------------------------
  178  0040: 01 03 00 SETTLE: LXI B,3
  179  0043: 0B       STL:    DCX B
  180  0044: 78               MOV A,B
  181  0045: B1               ORA C
  182  0046: C2 43 00         JNZ STL
  183  0049: C9               RET
  184            
  185            ; ---------------------------------------------------------------------
  186            ; SCANALL: опрос всех 4 колонок; A = ИЛИ рядов (0 = нажатий нет);
  187            ; колонки на выходе погашены. Портит A/B/C/D/E.
  188            ; ---------------------------------------------------------------------
  189  004A: AF       SCANALL: XRA A
  190  004B: 5F               MOV E,A             ; E = накопитель
  191  004C: 16 01            MVI D,01h           ; D = бит колонки
  192  004E: 7A       SAL1:   MOV A,D
  193  004F: D3 02            OUT KBCOLP
  194  0051: CD 40 00         CALL SETTLE
  195  0054: DB 03            IN KBROWP
  196  0056: E6 1F            ANI 1Fh
  197  0058: B3               ORA E
  198  0059: 5F               MOV E,A
  199  005A: 7A               MOV A,D
  200  005B: 07               RLC
  201  005C: 57               MOV D,A
  202  005D: FE 10            CPI 10h
  203  005F: C2 4E 00         JNZ SAL1
  204  0062: AF               XRA A
  205  0063: D3 02            OUT KBCOLP
  206  0065: 7B               MOV A,E
  207  0066: C9               RET
  208            
  209            ; ---------------------------------------------------------------------
  210            ; REFRESH: один слот регенерации. ГАШЕНИЕ -> РАЗРЯД -> ГЛИФ.
  211            ; DIGIMG[DPIDX] на разряд DPIDX. Бит D4 (SND) уносится записью DIGP -
  212            ; дисплей при тоне не гаснет. Портит A/B/C/H/L.
  213            ; ---------------------------------------------------------------------
  214  0067: 3A F4 FF REFRESH: LDA DPIDX
  215  006A: 4F               MOV C,A             ; C = индекс 0..3
  216  006B: 06 00            MVI B,0
  217  006D: 21 13 00         LXI H,BITTBL
  218  0070: 09               DAD B
  219  0071: 46               MOV B,M             ; B = бит разряда (01,02,04,08)
  220  0072: 21 F5 FF         LXI H,DIGIMG        ; HL = DIGIMG + DPIDX
  221  0075: 79       RFIL:   MOV A,C
  222  0076: B7               ORA A
  223  0077: CA 7F 00         JZ RFGD
  224  007A: 2C               INR L
  225  007B: 0D               DCR C
  226  007C: C3 75 00         JMP RFIL
  227  007F: 4E       RFGD:   MOV C,M             ; C = глиф разряда
  228  0080: 3A E8 FF         LDA SNDST
  229  0083: B7               ORA A
  230  0084: CA 8B 00         JZ RFN
  231  0087: 78               MOV A,B
  232  0088: F6 10            ORI 10h
  233  008A: 47               MOV B,A             ; B |= SND
  234  008B: AF       RFN:    XRA A
  235  008C: D3 00            OUT SEGP            ; (1) гашение: старый разряд погас
  236  008E: 78               MOV A,B
  237  008F: D3 01            OUT DIGP            ; (2) разряд переключён (сегменты пусты)
  238  0091: 79               MOV A,C
  239  0092: D3 00            OUT SEGP            ; (3) зажгли глиф нового разряда
  240  0094: 3A F4 FF         LDA DPIDX
  241  0097: 3C               INR A
  242  0098: E6 03            ANI 03h
  243  009A: 32 F4 FF         STA DPIDX
  244  009D: C9               RET
  245            
  246            ; ---------------------------------------------------------------------
  247            ; BUNIT: единица ~1 мс + тоггл SNDST + регенерация дисплея
  248            ;         + XSTREAM SW-тик (кадр не останавливается на тоне/дебаунсе)
  249            ; QUNIT: единица ~1 мс без звука, дисплей живёт
  250            ; ---------------------------------------------------------------------
  251  009E: 01 90 00 BUNIT:  LXI B,K_MS
  252  00A1: 0B       BUL:    DCX B
  253  00A2: 78               MOV A,B
  254  00A3: B1               ORA C
  255  00A4: C2 A1 00         JNZ BUL
  256  00A7: 3A E8 FF         LDA SNDST
  257  00AA: EE 01            XRI 01h
  258  00AC: 32 E8 FF         STA SNDST
  259  00AF: CD 67 00         CALL REFRESH
  260  00B2: 3E 04            MVI A,XS_QINC
  261  00B4: CD 86 04         CALL XSCHK          ; XSTREAM: тик кадра
  262  00B7: C9               RET
  263            
  264  00B8: 01 90 00 QUNIT:  LXI B,K_MS
  265  00BB: 0B       QUL:    DCX B
  266  00BC: 78               MOV A,B
  267  00BD: B1               ORA C
  268  00BE: C2 BB 00         JNZ QUL
  269  00C1: CD 67 00         CALL REFRESH
  270  00C4: C9               RET
  271            
  272            ; ---------------------------------------------------------------------
  273            ; TICKON: короткий тик подтверждения клавиши (TICK_MS единиц ~1 мс,
  274            ; тон ~415 Гц на CPU 3.125 МГц). Счётчик - В DE.
  275            ; ---------------------------------------------------------------------
  276  00C5: 11 1E 00 TICKON: LXI D,TICK_MS
  277  00C8: CD 9E 00 TK1:    CALL BUNIT
  278  00CB: 1B               DCX D
  279  00CC: 7A               MOV A,D
  280  00CD: B3               ORA E
  281  00CE: C2 C8 00         JNZ TK1
  282  00D1: AF               XRA A
  283  00D2: 32 E8 FF         STA SNDST           ; тон гарантированно погашен
  284  00D5: C9               RET
  285            
  286            ; ---------------------------------------------------------------------
  287            ; GLOOK: A = тетрада 0..F -> A = глиф (GTBL). Портит A/B/C/H/L.
  288            ; ---------------------------------------------------------------------
  289  00D6: 4F       GLOOK:  MOV C,A
  290  00D7: 06 00            MVI B,0
  291  00D9: 21 03 00         LXI H,GTBL
  292  00DC: 09               DAD B
  293  00DD: 7E               MOV A,M
  294  00DE: C9               RET
  295            
  296            ; ---------------------------------------------------------------------
  297            ; REDRAW: пересобрать DIGIMG[0..3] по состоянию (меню/адрес/код/...)
  298            ; ---------------------------------------------------------------------
  299  00DF: 3A E9 FF REDRAW: LDA STATE
  300  00E2: B7               ORA A
  301  00E3: CA 84 01         JZ RDM
  302  00E6: FE 01            CPI 01h
  303  00E8: CA 9B 01         JZ RDA
  304  00EB: FE 03            CPI 03h
  305  00ED: CA 26 01         JZ RDV
  306  00F0: FE 04            CPI 04h
  307  00F2: CA 4F 01         JZ RDW
  308                    ; ---- ST_PROG ----
  309  00F5: AF               XRA A
  310  00F6: 32 F8 FF         STA DIGIMG3
  311  00F9: 32 F7 FF         STA DIGIMG2
  312  00FC: 32 F6 FF         STA DIGIMG1
  313  00FF: 32 F5 FF         STA DIGIMG0
  314  0102: 3A F1 FF         LDA BDCNT
  315  0105: FE 02            CPI 02h
  316  0107: DA 13 01         JC RDPR0            ; <2 - старшая тетрада пуста
  317  010A: 3A F2 FF         LDA BF1
  318  010D: CD D6 00         CALL GLOOK
  319  0110: 32 F6 FF         STA DIGIMG1
  320  0113: 3A F1 FF RDPR0:  LDA BDCNT
  321  0116: B7               ORA A
  322  0117: CA EC 01         JZ RDRE             ; 0 - младшая тоже пуста
  323  011A: 3A F3 FF         LDA BF0
  324  011D: CD D6 00         CALL GLOOK
  325  0120: 32 F5 FF         STA DIGIMG0
  326  0123: C3 EC 01         JMP RDRE
  327  0126: 3A EA FF RDV:    LDA ADDRH           ; ---- ST_VIEW: [ADDR] в правых разрядах ----
  328  0129: 67               MOV H,A
  329  012A: 3A EB FF         LDA ADDRL
  330  012D: 6F               MOV L,A             ; HL = ADDR
  331  012E: 7E               MOV A,M             ; A = [ADDR] (HL>=8000h - ОЗУ)
  332  012F: 57               MOV D,A             ; D = байт (GLOOK портит B)
  333  0130: 0F               RRC
  334  0131: 0F               RRC
  335  0132: 0F               RRC
  336  0133: 0F               RRC
  337  0134: E6 0F            ANI 0Fh             ; старшая тетрада
  338  0136: CD D6 00         CALL GLOOK
  339  0139: 32 F6 FF         STA DIGIMG1
  340  013C: 7A               MOV A,D
  341  013D: E6 0F            ANI 0Fh             ; младшая тетрада
  342  013F: CD D6 00         CALL GLOOK
  343  0142: 32 F5 FF         STA DIGIMG0
  344  0145: AF               XRA A
