  996            ; ---------------------------------------------------------------------
  997            ; XISR - обработчик RST 7.5 (вектор 003Ch).
  998            ;   HW: делитель XS_DIVN (период = посылка 22.9 мс + (XS_DIVN-1) x
  999            ;   T = N x 51.2 мкс; TMR_N=234, XS_DIVN=3 -> 46.9 мс = 21.3 FPS,
 1000            ;   48.8% ЦП); ре-арм ПОСЛЕ тела - таймер не истекает внутри ISR,
 1001            ;   каденция точная. ISR выбивает из монитора/программы пользователя.
 1002            ;   SW (v2.3): линия заземлена - вход невозможен; тихий выход.
 1003            ; ---------------------------------------------------------------------
 1004                    IF TMR_HW
 1005            XISR:   PUSH PSW
 1006                    PUSH B
 1007                    PUSH D
 1008                    PUSH H
 1009                    LDA XSDIV
 1010                    DCR A
 1011                    STA XSDIV
 1012                    JNZ XISR1
 1013                    MVI A,XS_DIVN
 1014                    STA XSDIV
 1015                    CALL XSEND          ; КАДР -> UART
 1016            XISR1:  MVI A,TMR_N
 1017                    OUT TMRP            ; ре-арм ПОСЛЕ тела: следующий фронт через N тиков
 1018                    POP H
 1019                    POP D
 1020                    POP B
 1021                    POP PSW
 1022                    EI
 1023                    RET
 1024                    ELSE
 1025  0573: F5       XISR:   PUSH PSW
 1026  0574: FB               EI                  ; страховка: маска не трогается, тихий выход
 1027  0575: C9               RET
 1028                    ENDIF
