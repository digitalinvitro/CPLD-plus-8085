  920            ; ---------------------------------------------------------------------
  921            ; XDIG: один слот регенерации дисплея ВО ВРЕМЯ посылки.
  922            ;   DE = 0FFF5h..0FFF8h (указатель глифа DIGIMG0..3), C = бит разряда -
  923            ;   своя фаза (DPIDX не трогает, к возврату монитор продолжит свою).
  924            ;   Тон: SNDST OR-ится в бит разряда (запись DIGP несет D4).
  925            ;   Порядок как в REFRESH: ГАШЕНИЕ -> РАЗРЯД -> ГЛИФ. Без стеша:
  926            ;   глиф читается последним (LDAX D -> OUT SEGP). A/флаги свободно.
  927            ;   УРОК 11-12 железа: DE - ПАРА (старший байт D=0FFh!); вариант
  928            ;   "D=0F5h, E=бит" читал мусор ОЗУ 0F5xx -> глифы-призраки L.L.L.1.
  929            ; ---------------------------------------------------------------------
  930  0520: AF       XDIG:   XRA A
  931  0521: D3 00            OUT SEGP            ; (1) гашение
  932  0523: 79               MOV A,C             ; бит разряда
  933  0524: 3A E8 FF         LDA SNDST
  934  0527: B7               ORA A
  935  0528: CA 2D 05         JZ XDG1
  936  052B: F6 10            ORI 10h             ; + SND
  937  052D: D3 01    XDG1:   OUT DIGP            ; (2) разряд (и тон) включён, сегменты пусты
  938  052F: 1A               LDAX D              ; A = глиф [0FFF5h..0FFF8h]
  939  0530: D3 00            OUT SEGP            ; (3) глиф горит
  940  0532: 13               INX D               ; следующий глиф (E: 0F5..0F8)
  941  0533: 7B               MOV A,E
  942  0534: FE F9            CPI 0F9h            ; за DIGIMG3?
  943  0536: DA 3B 05         JC XDG2
  944  0539: 1E F5            MVI E,0F5h          ; -> DIGIMG0
  945  053B: 79       XDG2:   MOV A,C
  946  053C: 07               RLC
  947  053D: E6 0F            ANI 0Fh             ; 08h -> 10h -> 00
  948  053F: C2 44 05         JNZ XDG3
  949  0542: 3E 01            MVI A,01h           ; после DIG3 -> DIG0
  950  0544: 4F       XDG3:   MOV C,A
  951  0545: C9               RET
  952            
  953            ; ---------------------------------------------------------------------
  954            ; XUPDCTR: живой счётчик SEQ (hex, 2 цифры) в демо-экран, строка 22:
  955            ;   'SEQ:xx ...' - x на B6E4/B6E5. Доказательство живого потока.
  956            ; ---------------------------------------------------------------------
  957  0546: E5       XUPDCTR: PUSH H
  958  0547: 3A FA FF         LDA XSSEQ
  959  054A: 4F               MOV C,A
  960  054B: 0F               RRC
  961  054C: 0F               RRC
  962  054D: 0F               RRC
  963  054E: 0F               RRC
  964  054F: E6 0F            ANI 0Fh
  965  0551: CD 62 05         CALL XHEX
  966  0554: 32 E4 B6         STA XSCNT
  967  0557: 79               MOV A,C
  968  0558: E6 0F            ANI 0Fh
  969  055A: CD 62 05         CALL XHEX
  970  055D: 32 E5 B6         STA XSCNT+1
  971  0560: E1               POP H
  972  0561: C9               RET
  973            
  974  0562: C6 30    XHEX:   ADI '0'
  975  0564: FE 3A            CPI 3Ah
  976  0566: DA 6B 05         JC XHX1
  977  0569: C6 07            ADI 07h
  978  056B: C9       XHX1:   RET
  979            
  980            ; ---------------------------------------------------------------------
  981            ; XISR - обработчик RST 7.5 (вектор 003Ch).
  982            ;   HW: делитель XS_DIVN (период = посылка 22.9 мс + (XS_DIVN-1) x
  983            ;   T = N x 51.2 мкс; TMR_N=234, XS_DIVN=3 -> 46.9 мс = 21.3 FPS,
  984            ;   48.8% ЦП); ре-арм ПОСЛЕ тела - таймер не истекает внутри ISR,
  985            ;   каденция точная. ISR выбивает из монитора/программы пользователя.
  986            ;   SW (v2.3): линия заземлена - вход невозможен; тихий выход.
  987            ; ---------------------------------------------------------------------
  988                    IF TMR_HW
  989            XISR:   PUSH PSW
  990                    PUSH B
  991                    PUSH D
  992                    PUSH H
  993                    LDA XSDIV
  994                    DCR A
  995                    STA XSDIV
  996                    JNZ XISR1
  997                    MVI A,XS_DIVN
  998                    STA XSDIV
  999                    CALL XSEND          ; КАДР -> UART
 1000            XISR1:  MVI A,TMR_N
 1001                    OUT TMRP            ; ре-арм ПОСЛЕ тела: следующий фронт через N тиков
 1002                    POP H
 1003                    POP D
 1004                    POP B
 1005                    POP PSW
 1006                    EI
 1007                    RET
 1008                    ELSE
 1009  056C: F5       XISR:   PUSH PSW
 1010  056D: FB               EI                  ; страховка: маска не трогается, тихий выход
 1011  056E: C9               RET
 1012                    ENDIF
