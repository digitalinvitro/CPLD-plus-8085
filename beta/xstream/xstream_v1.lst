  798            ; ---------------------------------------------------------------------
  799            ; XSCHK: SW-тик кадра. A = добавка слотов (1 = слот скана ~0.37 мс,
  800            ; XS_QINC = единица QUNIT/BUNIT ~1.2 мс). Накопитель XSPASS;
  801            ; порог XS_TH -> XSEND (~24.3 мс) и сброс. Портит A/C; D/E/B целы.
  802            ; В HW-варианте тело выключено (кадр ведёт ISR) - вызов = RET.
  803            ; ---------------------------------------------------------------------
  804                    IF TMR_HW
  805            XSCHK:  RET                 ; HW: кадр ведёт ISR по таймеру; SW-тик отключён
  806                    ELSE
  807  0486: 4F       XSCHK:  MOV C,A
  808  0487: 3A FB FF         LDA XSPASS
  809  048A: 81               ADD C
  810  048B: 32 FB FF         STA XSPASS
  811  048E: FE 47            CPI XS_TH
  812  0490: DA 9A 04         JC XSKR             ; < порога - выход
  813  0493: CD 9B 04         CALL XSEND          ; КАДР -> UART (~24.3 мс)
  814  0496: AF               XRA A
  815  0497: 32 FB FF         STA XSPASS          ; счётчик заново
  816  049A: C9       XSKR:   RET
  817                    ENDIF
