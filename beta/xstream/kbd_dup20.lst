    1            ; =====================================================================
    2            ; beta/xstream -- kbd_dup20: ДЕМО "КЛАВИША ПЛАТЫ -> 20 КОПИЙ СИМВОЛА
    3            ; В ОКНЕ ПК" (вопрос владельца 11-14; ввод по директиве C монитора ACdE)
    4            ;
    5            ; СЦЕНАРИЙ:
    6            ;   E -> программа крутит скан матрицы 4x5 (порты 02h/03h, как в
    7            ;   мониторе) и ЖДЁТ цифровую клавишу 0..F. Пока ждёт - поддерживает
    8            ;   регенерацию индикатора (CALL REFRESH) и SW-тик XSTREAM (CALL XSCHK,
    9            ;   A=1): окно ПК ПРОДОЛЖАЕТ обновляться, хотя монитор уже не крутится
   10            ;   ("8085 выдаёт экран и работает по своим делам" - прямо из E).
   11            ;   Поймав клавишу: row*4+col -> KEYTBL (ROM fw) -> код 00..0F ->
   12            ;   XHEX (ROM fw) -> ASCII '0'..'F' -> символ пишется 20 раз в строку
   13            ;   24 экрана (B780h..B793h), затем RET (C9) -> монитор. Ближайший кадр
   14            ;   XSTREAM (~50 мс) показывает 20 копий внизу окна ПК. Повторный пуск
   15            ;   (A 8000 Enter, E) с новой клавишей ПЕРЕзаписывает те же 20 ячеек.
   16            ;   Enter/F1/F2/пустая позиция (код >= 10h) - выход БЕЗ записи.
   17            ;
   18            ;   Ввод с клавиатуры ПК в v2.3 невозможен: CPLD TX-only (RX-ядра нет),
   19            ;   клиент xstream_view.ps1 только читает COM. Поэтому "клавиатура" -
   20            ;   матрица платы; "экран" - окно ПК (B000h..B7CFh).
   21            ;
   22            ; ROM-точки fw_mon ACdE + XSTREAM v1 (SW, md5 4175b2e80af125f562c969cfcedd7157):
   23            ;   SETTLE 0040h - пауза ~25 мкс; KEYTBL 0017h - таблица клавиш;
   24            ;   REFRESH 0067h - слот регенерации; XSCHK 0486h - SW-тик кадра;
   25            ;   XHEX 0569h - тетрада 0..15 -> ASCII '0'..'F'. Все - обычные
   26            ;   подпрограммы ROM, из пользовательской программы вызывать можно.
   27            ;
   28            ; ПАМЯТЬ: 8000h..8054h (85 Б), стек монитора, XBUF B000h..B7CFh.
   29            ; СБОРКА: python3 scripts/asm85.py kbd_dup20.asm -o kbd_dup20.hex -l kbd_dup20.lst
   30            ; СИМ:    scripts/sim_kbd_dup20.py (нажатие '7'/'F'/Enter, сверка буфера и кадров)
   31            ; =====================================================================
   32            
   33  8000: -                ORG 8000h
   34            
   35            ; ---- ROM fw_mon ACdE + XSTREAM v1 (SW) ----
   36            KBCOLP  EQU 02h             ; колонки матрицы (D3-D0, 1 = заведена)
   37            KBROWP  EQU 03h             ; ряды матрицы (D4-D0, 1 = нажата)
   38            SETTLE  EQU 0040h           ; ROM fw: пауза ~25 мкс
   39            KEYTBL  EQU 0017h           ; ROM fw: таблица клавиш KEYTBL[row*4+col]
   40            REFRESH EQU 0067h           ; ROM fw: слот регенерации 7-сегм. индикатора
   41            XSCHK   EQU 0486h           ; ROM fw: SW-тик XSTREAM (A = добавка слотов)
   42            XHEX    EQU 0569h           ; ROM fw: тетрада 0..15 -> ASCII '0'..'F'
   43            XROW24  EQU 0B780h          ; строка 24 экрана: B000h + 24*80
   44            
   45            ; ---- программа ----
   46  8000: 16 01    START:  MVI  D,01h          ; D = бит колонки 01h..08h
   47  8002: 1E 00            MVI  E,00h          ; E = номер колонки 0..3
   48  8004: 7A       SCAN:   MOV  A,D
   49  8005: D3 02            OUT  KBCOLP         ; завели колонку
   50  8007: CD 40 00         CALL SETTLE         ; успокоение матрицы (~25 мкс, ROM)
   51  800A: DB 03            IN   KBROWP         ; ряды
   52  800C: E6 1F            ANI  1Fh
   53  800E: C2 25 80         JNZ  FOUND          ; есть нажатие в этой колонке
   54  8011: 7A               MOV  A,D
   55  8012: 07               RLC
   56  8013: 57               MOV  D,A
   57  8014: 1C               INR  E
   58  8015: FE 10            CPI  10h            ; 4 колонки отсканированы?
   59  8017: C2 04 80         JNZ  SCAN
   60  801A: CD 67 00         CALL REFRESH        ; нажатий нет: слот индикатора (ROM)
   61  801D: 3E 01            MVI  A,01h
   62  801F: CD 86 04         CALL XSCHK          ; SW-тик: кадр в UART идёт и в ожидании (ROM)
   63  8022: C3 00 80         JMP  START
   64            ; ---- нажатие поймано: A = биты рядов, E = колонка ----
   65  8025: F5       FOUND:  PUSH PSW
   66  8026: AF               XRA  A
   67  8027: D3 02            OUT  KBCOLP         ; колонки off - фиксируем нажатие (как HIT в fw)
   68  8029: F1               POP  PSW
   69  802A: 0E 00            MVI  C,00h          ; C = номер ряда (индекс младшего единичного бита)
   70  802C: 0F       RL:     RRC
   71  802D: DA 34 80         JC   GOT
   72  8030: 0C               INR  C
   73  8031: C3 2C 80         JMP  RL
   74  8034: 79       GOT:    MOV  A,C
   75  8035: 07               RLC
   76  8036: 07               RLC                 ; A = row*4
   77  8037: 83               ADD  E              ; A = row*4 + col
   78  8038: 4F               MOV  C,A
   79  8039: 06 00            MVI  B,00h
   80  803B: 21 17 00         LXI  H,KEYTBL       ; HL = KEYTBL + index (ROM fw)
   81  803E: 09               DAD  B
   82  803F: 7E               MOV  A,M            ; A = код клавиши 00..0F (цифры), 10..12/FF
   83  8040: FE 10            CPI  10h
   84  8042: D2 54 80         JNC  EXIT           ; Enter/F1/F2/пусто - выход БЕЗ записи
   85  8045: CD 69 05         CALL XHEX           ; A = ASCII '0'..'F' (ROM fw)
   86  8048: 4F               MOV  C,A            ; C = символ
   87  8049: 21 80 B7         LXI  H,XROW24       ; HL = B780h: строка 24, колонка 0
   88  804C: 06 14            MVI  B,14h          ; 20 копий (14h = 20)
   89  804E: 71       PUT:    MOV  M,C
   90  804F: 23               INX  H
   91  8050: 05               DCR  B
   92  8051: C2 4E 80         JNZ  PUT
   93  8054: C9       EXIT:   RET                 ; C9 -> монитор; кадр с новиной уйдёт через ~50 мс
   94            
   95  8055: -                END
