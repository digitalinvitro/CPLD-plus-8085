  910  0509: 00               NOP
  911  050A: 00               NOP
  912  050B: 00               NOP
  913  050C: 0D               DCR C               ; подгруппа = 7x35T + 49T = 294T (36.75T/Б)
  914  050D: C2 D4 04         JNZ XSL
  915  0510: CD 1C 05         CALL XDIG           ; слот дисплея (регенерация не замирает)
  916  0513: 05               DCR B
  917  0514: C2 D2 04         JNZ XSOUT
  918  0517: E1               POP H
