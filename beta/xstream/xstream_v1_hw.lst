  798            ; ---------------------------------------------------------------------
  799            ; XSCHK: SW-тик кадра. A = добавка слотов (1 = слот скана ~0.37 мс,
  800            ; XS_QINC = единица QUNIT/BUNIT ~1.2 мс). Накопитель XSPASS;
  801            ; порог XS_TH -> XSEND (~24.3 мс) и сброс. Портит A/C; D/E/B целы.
  802            ; В HW-варианте тело выключено (кадр ведёт ISR) - вызов = RET.
  803            ; ---------------------------------------------------------------------
  804                    IF TMR_HW
  805  0496: C9       XSCHK:  RET                 ; HW: кадр ведёт ISR по таймеру; SW-тик отключён
  806                    ELSE
  807            XSCHK:  MOV C,A
  808                    LDA XSPASS
  809                    ADD C
  810                    STA XSPASS
  811                    CPI XS_TH
  812                    JC XSKR             ; < порога - выход
  813                    CALL XSEND          ; КАДР -> UART (~24.3 мс)
  814                    XRA A
  815                    STA XSPASS          ; счётчик заново
  816            XSKR:   RET
  817                    ENDIF
