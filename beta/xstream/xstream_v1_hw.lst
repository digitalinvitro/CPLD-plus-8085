  819            ; ---------------------------------------------------------------------
  820            ; XSEND: кадр XSTREAM в UART: A5 5A [SEQ] + 2000 Б из XBUF.
  821            ;   Сохраняет PSW/B/D/H. РАВНОМЕРНЫЙ пейсинг 35T/Б (7+10+6+3x4 >= 31.25T,
  822            ;   ноль отбросов TX, прецедент p04); каждые 200 Б - слот дисплея XDIG
  823            ;   (DE - фаза глифа через группы, XDIG портит только A/C: C - счётчик
  824            ;   подгруппы, перезагружается MVI C,25; B - внешний счётчик групп).
  825            ; ---------------------------------------------------------------------
  826  0497: F5       XSEND:  PUSH PSW
  827  0498: C5               PUSH B
  828  0499: D5               PUSH D
  829  049A: E5               PUSH H
  830  049B: CD 49 05         CALL XUPDCTR        ; живой счётчик SEQ в демо-экран
  831  049E: 3E A5            MVI A,0A5h
  832  04A0: D3 04            OUT TXPORT          ; шапка: равномерный пейсинг 33T (4 NOP)
  833  04A2: 00               NOP
  834  04A3: 00               NOP
  835  04A4: 00               NOP
  836  04A5: 00               NOP
  837  04A6: 3E 5A            MVI A,05Ah
  838  04A8: D3 04            OUT TXPORT
  839  04AA: 00               NOP
  840  04AB: 00               NOP
  841  04AC: 00               NOP
  842  04AD: 00               NOP
  843  04AE: 3A FA FF         LDA XSSEQ
  844  04B1: D3 04            OUT TXPORT
  845  04B3: 00               NOP
  846  04B4: 00               NOP
  847  04B5: 00               NOP
  848  04B6: 00               NOP
  849  04B7: 3C               INR A
  850  04B8: 32 FA FF         STA XSSEQ           ; SEQ++ mod 256
  851  04BB: 3A F4 FF         LDA DPIDX           ; фаза дисплея: DE = 0FFF5+idx (глиф), C = бит разряда
  852  04BE: 4F               MOV C,A
  853  04BF: C6 F5            ADI 0F5h
  854  04C1: 5F               MOV E,A             ; E = 0F5h..0F8h (младший байт указателя глифа)
  855  04C2: 16 FF            MVI D,0FFh          ; D = 0FFh -> DE = 0FFF5h..0FFF8h (DIGIMG0..3)
  856  04C4: 79               MOV A,C
  857  04C5: 06 00            MVI B,0
  858  04C7: 21 13 00         LXI H,BITTBL
  859  04CA: 09               DAD B
  860  04CB: 7E               MOV A,M
  861  04CC: 4F               MOV C,A             ; C = бит разряда 01/02/04/08 (свободен вне inner)
  862  04CD: 21 00 B0         LXI H,XBUF          ; HL = экран
  863  04D0: 06 0A            MVI B,10            ; внешний: 10 групп по 200 Б (слот дисплея)
  864  04D2: 0E 19    XSOUT:  MVI C,25            ; внутренний: 25 подгрупп по 8 Б
  865  04D4: 7E       XSL:    MOV A,M
  866  04D5: D3 04            OUT TXPORT          ; равномерный пейсинг: гэп OUT->OUT = 23T+пад >= 31.25T
  867  04D7: 23               INX H
  868  04D8: 00               NOP
  869  04D9: 00               NOP
  870  04DA: 00               NOP
  871  04DB: 7E               MOV A,M
  872  04DC: D3 04            OUT TXPORT
  873  04DE: 23               INX H
  874  04DF: 00               NOP
  875  04E0: 00               NOP
  876  04E1: 00               NOP
  877  04E2: 7E               MOV A,M
  878  04E3: D3 04            OUT TXPORT
  879  04E5: 23               INX H
  880  04E6: 00               NOP
  881  04E7: 00               NOP
  882  04E8: 00               NOP
  883  04E9: 7E               MOV A,M
  884  04EA: D3 04            OUT TXPORT
  885  04EC: 23               INX H
  886  04ED: 00               NOP
  887  04EE: 00               NOP
  888  04EF: 00               NOP
  889  04F0: 7E               MOV A,M
  890  04F1: D3 04            OUT TXPORT
  891  04F3: 23               INX H
  892  04F4: 00               NOP
  893  04F5: 00               NOP
  894  04F6: 00               NOP
  895  04F7: 7E               MOV A,M
  896  04F8: D3 04            OUT TXPORT
  897  04FA: 23               INX H
  898  04FB: 00               NOP
  899  04FC: 00               NOP
  900  04FD: 00               NOP
  901  04FE: 7E               MOV A,M
  902  04FF: D3 04            OUT TXPORT
  903  0501: 23               INX H
  904  0502: 00               NOP
  905  0503: 00               NOP
  906  0504: 00               NOP
  907  0505: 7E               MOV A,M
  908  0506: D3 04            OUT TXPORT
