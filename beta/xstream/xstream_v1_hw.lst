  996            ; ---------------------------------------------------------------------
  997            ; XISR - обработчик RST 7.5 (вектор 003Ch).
  998            ;   HW: делитель XS_DIVN (период = посылка 22.9 мс + (XS_DIVN-1) x
  999            ;   T = N x 51.2 мкс; TMR_N=234, XS_DIVN=3 -> 46.9 мс = 21.3 FPS,
 1000            ;   48.8% ЦП); ре-арм ПОСЛЕ тела - таймер не истекает внутри ISR,
 1001            ;   каденция точная. ISR выбивает из монитора/программы пользователя.
 1002            ;   SW (v2.3): линия заземлена - вход невозможен; тихий выход.
 1003            ; ---------------------------------------------------------------------
 1004                    IF TMR_HW
 1005  056F: F5       XISR:   PUSH PSW
 1006  0570: C5               PUSH B
 1007  0571: D5               PUSH D
 1008  0572: E5               PUSH H
 1009  0573: 3A FC FF         LDA XSDIV
 1010  0576: 3D               DCR A
 1011  0577: 32 FC FF         STA XSDIV
 1012  057A: C2 85 05         JNZ XISR1
 1013  057D: 3E 02            MVI A,XS_DIVN
 1014  057F: 32 FC FF         STA XSDIV
 1015  0582: CD 97 04         CALL XSEND          ; КАДР -> UART
 1016  0585: 3E FA    XISR1:  MVI A,TMR_N
 1017  0587: D3 06            OUT TMRP            ; ре-арм ПОСЛЕ тела: следующий фронт через N тиков
 1018  0589: E1               POP H
 1019  058A: D1               POP D
 1020  058B: C1               POP B
 1021  058C: F1               POP PSW
 1022  058D: FB               EI
 1023  058E: C9               RET
 1024                    ELSE
 1025            XISR:   PUSH PSW
 1026                    EI                  ; страховка: маска не трогается, тихий выход
 1027                    RET
 1028                    ENDIF
