  924            ; ---------------------------------------------------------------------
  925            ; XDIG: один слот регенерации дисплея ВО ВРЕМЯ посылки.
  926            ;   САМОДОСТАТОЧНАЯ (v1.2): бит разряда вычисляется из фазы глифа E
  927            ;   (E = 0F5h+idx -> idx = (E+3)&3 -> бит = 01h RLC idx раз) и живёт
  928            ;   в C ПЕРЕЖИВ LDA SNDST (как в REFRESH бит живёт в B) - иначе LDA
  929            ;   снова затирает его в A (недо-фикс v1.2-rc1: трасса сима поймала
  930            ;   OUT DIGP=00). Тон - из SNDST (0/1) как в REFRESH. DPIDX не трогает;
  931            ;   портит ТОЛЬКО A/C (C - счётчик подгруппы, перезагружается MVI C,25
  932            ;   в XSOUT; B/D/E/H целы - HL несёт указатель экрана, B - счётчик групп).
  933            ;   Порядок как в REFRESH: ГАШЕНИЕ -> РАЗРЯД -> ГЛИФ.
  934            ;   УРОК 11-12 железа (1): DE - ПАРА (старший байт D=0FFh!); вариант
  935            ;   "D=0F5h, E=бит" читал мусор ОЗУ 0F5xx -> глифы-призраки L.L.L.1.
  936            ;   УРОК 11-12 железа (2): v1.1 брала бит разряда из C, но к вызову
  937            ;   C = 0 (съеден счётчиком подгруппы MVI C,25), и LDA SNDST затирал
  938            ;   его в A -> OUT DIGP = SNDST (0/1): при 0 дисплей гас на ВСЮ посылку,
  939            ;   при 1 все 4 глифа циклом на DIG0 -> «дрожание» на живой плате.
  940            ;   Сим не ловил: модель проверяла ЧУЖИЕ глифы, но не выбор РАЗРЯДА.
  941            ; ---------------------------------------------------------------------
  942  051C: AF       XDIG:   XRA A
  943  051D: D3 00            OUT SEGP            ; (1) гашение
  944  051F: 7B               MOV A,E             ; E = 0F5h..0F8h (DIGIMG0..3)
  945  0520: C6 03            ADI 03h
  946  0522: E6 03            ANI 03h             ; A = idx разряда 0..3 (Z от ANI)
  947  0524: 4F               MOV C,A
  948  0525: 3E 01            MVI A,01h
  949  0527: CA 2F 05         JZ XDMK             ; idx=0 -> бит уже 01h
  950  052A: 07       XDSH:   RLC                 ; 01h -> 02h -> 04h -> 08h
  951  052B: 0D               DCR C
  952  052C: C2 2A 05         JNZ XDSH
  953  052F: 4F       XDMK:   MOV C,A             ; C = бит разряда - ПЕРЕЖИВЁТ LDA (как B в REFRESH)
  954  0530: 3A E8 FF         LDA SNDST           ; 0/1 - состояние тона (тоггл в BUNIT)
  955  0533: B7               ORA A
  956  0534: 79               MOV A,C             ; A = бит (LDA затёр - восстановить из C)
  957  0535: CA 3A 05         JZ XDG1
  958  0538: F6 10            ORI 10h             ; + SND
  959  053A: D3 01    XDG1:   OUT DIGP            ; (2) разряд (и тон) включён, сегменты пусты
  960  053C: 1A               LDAX D              ; A = глиф [0FFF5h..0FFF8h]
  961  053D: D3 00            OUT SEGP            ; (3) глиф горит
  962  053F: 13               INX D               ; следующий глиф (E: 0F5..0F8)
  963  0540: 7B               MOV A,E
  964  0541: FE F9            CPI 0F9h            ; за DIGIMG3?
  965  0543: DA 48 05         JC XDG2
  966  0546: 1E F5            MVI E,0F5h          ; -> DIGIMG0
  967  0548: C9       XDG2:   RET
  968            
  969            ; ---------------------------------------------------------------------
  970            ; XUPDCTR: живой счётчик SEQ (hex, 2 цифры) в демо-экран, строка 22:
  971            ;   'SEQ:xx ...' - x на B6E4/B6E5. Доказательство живого потока.
  972            ; ---------------------------------------------------------------------
  973  0549: E5       XUPDCTR: PUSH H
  974  054A: 3A FA FF         LDA XSSEQ
  975  054D: 4F               MOV C,A
  976  054E: 0F               RRC
  977  054F: 0F               RRC
  978  0550: 0F               RRC
  979  0551: 0F               RRC
  980  0552: E6 0F            ANI 0Fh
  981  0554: CD 65 05         CALL XHEX
  982  0557: 32 E4 B6         STA XSCNT
  983  055A: 79               MOV A,C
  984  055B: E6 0F            ANI 0Fh
  985  055D: CD 65 05         CALL XHEX
  986  0560: 32 E5 B6         STA XSCNT+1
  987  0563: E1               POP H
  988  0564: C9               RET
  989            
  990  0565: C6 30    XHEX:   ADI '0'
  991  0567: FE 3A            CPI 3Ah
  992  0569: DA 6E 05         JC XHX1
  993  056C: C6 07            ADI 07h
  994  056E: C9       XHX1:   RET
