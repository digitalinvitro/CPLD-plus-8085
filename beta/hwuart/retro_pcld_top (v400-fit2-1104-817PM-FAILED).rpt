FDCPE_dig3: FDCPE port map (dig(3),dig_D(3),clk,RST,'0');
dig_D(3) <= ((NOT A(3).PIN AND dig_q_or0000/dig_q_or0000_D2)
	OR (dig(3) AND NOT dig_q_or0000/dig_q_or0000_D2));


dig_q_or0000/dig_q_or0000_D2 <= (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND addr_latch(0) AND 
	state_FSM_FFd1 AND NOT addr_latch(1) AND NOT addr_latch(2) AND IOM AND NOT WRn);


kbcol_q_or0000/kbcol_q_or0000_D2 <= (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND NOT addr_latch(0) AND 
	state_FSM_FFd1 AND addr_latch(1) AND NOT addr_latch(2) AND IOM AND NOT WRn);

FDCPE_por_run: FDCPE port map (por_run,por_sh(0),clk,'0','0');

FTCPE_por_sh0: FTCPE port map (por_sh(0),por_sh_T(0),clk,'0','0');
por_sh_T(0) <= ((cnt(0) AND NOT cnt(1) AND NOT cnt(2) AND NOT por_sh(0) AND 
