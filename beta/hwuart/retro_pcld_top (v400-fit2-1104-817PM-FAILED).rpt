	addr_latch_and0000/addr_latch_and0000_D2));


addr_latch_and0000/addr_latch_and0000_D2 <= (NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	ALE);

FDCPE_adv_q: FDCPE port map (adv_q,adv_q_D,clk,RST,'0');
adv_q_D <= (NOT baud_cnt(0) AND NOT baud_cnt(1) AND baud_cnt(2) AND 
	baud_cnt(3) AND NOT FC_4_.OUT);

FDCPE_baud_cnt0: FDCPE port map (baud_cnt(0),baud_cnt_D(0),clk,RST,'0');
baud_cnt_D(0) <= ((NOT baud_cnt(0) AND NOT $OpTx$FX_SC$155)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND NOT addr_latch(0) AND 
	NOT rx_run AND state_FSM_FFd1 AND NOT addr_latch(1) AND addr_latch(2) AND 
	NOT rx_s1 AND NOT tx_run AND IOM AND NOT WRn AND NOT por_run)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND NOT addr_latch(0) AND 
	NOT rx_run AND state_FSM_FFd1 AND NOT addr_latch(1) AND addr_latch(2) AND 
	rx_s0 AND NOT tx_run AND IOM AND NOT WRn AND NOT por_run));

FDCPE_baud_cnt1: FDCPE port map (baud_cnt(1),baud_cnt_D(1),clk,RST,'0');
baud_cnt_D(1) <= ((baud_cnt(0) AND NOT baud_cnt(1) AND NOT $OpTx$FX_SC$155)
	OR (NOT baud_cnt(0) AND baud_cnt(1) AND NOT $OpTx$FX_SC$155)
	OR (NOT rx_run AND rx_s1 AND NOT rx_s0 AND NOT tx_run));

FTCPE_baud_cnt3: FTCPE port map (baud_cnt(3),baud_cnt_T(3),clk,RST,'0');
baud_cnt_T(3) <= ((baud_cnt(3) AND $OpTx$FX_SC$155)
	OR (baud_cnt(0) AND baud_cnt(1) AND baud_cnt(2) AND 
	NOT $OpTx$FX_SC$155));

FTCPE_bit_cnt0: FTCPE port map (bit_cnt(0),bit_cnt_T(0),clk,RST,'0');
bit_cnt_T(0) <= ((rx_run AND NOT bit_cnt(3) AND adv_q AND bit_cnt(1))
	OR (rx_run AND NOT bit_cnt(3) AND adv_q AND bit_cnt(2))
	OR (rx_run AND bit_cnt(3) AND adv_q AND NOT bit_cnt(1) AND 
	NOT bit_cnt(2))
	OR (NOT rx_run AND bit_cnt(0) AND rx_s1 AND NOT rx_s0 AND NOT tx_run)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND NOT addr_latch(0) AND 
	NOT rx_run AND state_FSM_FFd1 AND NOT addr_latch(1) AND addr_latch(2) AND 
	bit_cnt(0) AND NOT tx_run AND IOM AND NOT WRn AND NOT por_run)
	OR (rx_run AND bit_cnt(0) AND adv_q)
	OR (NOT rx_run AND adv_q AND tx_run)
	OR (rx_run AND NOT bit_cnt(3) AND adv_q AND NOT rx_s1));

FTCPE_bit_cnt1: FTCPE port map (bit_cnt(1),bit_cnt_T(1),clk,RST,'0');
bit_cnt_T(1) <= ((NOT rx_run AND bit_cnt(0) AND adv_q AND bit_cnt(2) AND 
	tx_run)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND NOT addr_latch(0) AND 
	NOT rx_run AND state_FSM_FFd1 AND NOT addr_latch(1) AND addr_latch(2) AND 
	bit_cnt(1) AND NOT tx_run AND IOM AND NOT WRn AND NOT por_run)
	OR (rx_run AND bit_cnt(3) AND adv_q AND bit_cnt(1))
	OR (rx_run AND NOT bit_cnt(3) AND bit_cnt(0) AND adv_q)
	OR (NOT bit_cnt(3) AND bit_cnt(0) AND adv_q AND tx_run)
	OR (NOT rx_run AND bit_cnt(0) AND adv_q AND bit_cnt(1) AND 
	tx_run)
	OR (NOT rx_run AND bit_cnt(1) AND rx_s1 AND NOT rx_s0 AND NOT tx_run));

FTCPE_bit_cnt2: FTCPE port map (bit_cnt(2),bit_cnt_T(2),clk,RST,'0');
bit_cnt_T(2) <= ((rx_run AND NOT bit_cnt(3) AND bit_cnt(0) AND adv_q AND 
	bit_cnt(1))
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND NOT addr_latch(0) AND 
	NOT rx_run AND state_FSM_FFd1 AND NOT addr_latch(1) AND addr_latch(2) AND 
	bit_cnt(2) AND NOT tx_run AND IOM AND NOT WRn AND NOT por_run)
	OR (rx_run AND bit_cnt(3) AND adv_q AND bit_cnt(2))
	OR (NOT rx_run AND bit_cnt(0) AND adv_q AND bit_cnt(1) AND 
	tx_run)
	OR (NOT rx_run AND bit_cnt(2) AND rx_s1 AND NOT rx_s0 AND NOT tx_run));

FTCPE_bit_cnt3: FTCPE port map (bit_cnt(3),bit_cnt_T(3),clk,RST,'0');
bit_cnt_T(3) <= ((rx_run AND bit_cnt(0) AND adv_q AND bit_cnt(1) AND 
	bit_cnt(2))
	OR (bit_cnt(3) AND bit_cnt(0) AND adv_q AND NOT bit_cnt(1) AND 
	NOT bit_cnt(2) AND tx_run)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND NOT addr_latch(0) AND 
	NOT rx_run AND state_FSM_FFd1 AND NOT addr_latch(1) AND addr_latch(2) AND 
	bit_cnt(3) AND NOT tx_run AND IOM AND NOT WRn AND NOT por_run)
	OR (rx_run AND bit_cnt(3) AND bit_cnt(0) AND adv_q)
	OR (rx_run AND bit_cnt(3) AND adv_q AND bit_cnt(1))
	OR (rx_run AND bit_cnt(3) AND adv_q AND bit_cnt(2))
	OR (NOT rx_run AND bit_cnt(3) AND rx_s1 AND NOT rx_s0 AND NOT tx_run)
	OR (bit_cnt(0) AND adv_q AND bit_cnt(1) AND bit_cnt(2) AND 
	tx_run));


bus_reg(7)/bus_reg(7)_TRST <= ((state_FSM_FFd3)
	OR (state_FSM_FFd2 AND NOT state_FSM_FFd1));


bus_reg_and0001/bus_reg_and0001_D2 <= ((NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT WRn)
	OR (NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	ALE AND NOT IOM));

FTCPE_cnt0: FTCPE port map (cnt(0),cnt_T(0),clk,'0','0');
cnt_T(0) <= (NOT cnt(0) AND cnt(1) AND cnt(2));

FTCPE_cnt1: FTCPE port map (cnt(1),cnt_T(1),clk,'0','0');
cnt_T(1) <= ((NOT cnt(0) AND NOT cnt(1))
	OR (NOT cnt(0) AND NOT cnt(2)));

FDCPE_cnt2: FDCPE port map (cnt(2),cnt_D(2),clk,'0','0');
cnt_D(2) <= ((NOT cnt(1) AND cnt(2))
	OR (cnt(0) AND cnt(1) AND NOT cnt(2)));

FDCPE_col0: FDCPE port map (col0,col0_D,clk,RST,'0');
col0_D <= ((col0 AND NOT kbcol_q_or0000/kbcol_q_or0000_D2)
