FTCPE_por_sh2: FTCPE port map (por_sh(2),por_sh_T(2),clk,'0','0');
por_sh_T(2) <= ((cnt(0) AND NOT cnt(1) AND NOT cnt(2) AND NOT por_sh(2) AND 
	por_sh(3))
	OR (NOT cnt(0) AND cnt(1) AND cnt(2) AND NOT por_sh(2) AND 
	por_sh(3))
	OR (cnt(0) AND NOT cnt(1) AND NOT cnt(2) AND por_sh(2) AND 
	NOT por_sh(3))
	OR (NOT cnt(0) AND cnt(1) AND cnt(2) AND por_sh(2) AND 
	NOT por_sh(3)));

FTCPE_por_sh3: FTCPE port map (por_sh(3),por_sh_T(3),clk,'0','0');
por_sh_T(3) <= ((cnt(0) AND NOT cnt(1) AND NOT cnt(2) AND por_sh(3) AND 
	NOT por_sh(4))
	OR (cnt(0) AND NOT cnt(1) AND NOT cnt(2) AND NOT por_sh(3) AND 
