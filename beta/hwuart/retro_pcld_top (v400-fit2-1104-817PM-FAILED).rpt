FTCPE_por_sh7: FTCPE port map (por_sh(7),por_sh_T(7),clk,'0','0');
por_sh_T(7) <= ((cnt(0) AND NOT cnt(1) AND NOT cnt(2) AND por_sh(7))
	OR (NOT cnt(0) AND cnt(1) AND cnt(2) AND por_sh(7)));


rd_drive/rd_drive_D2 <= (NOT ALE AND NOT RDn AND FC_0_.OUT);

FDCPE_rd_seen: FDCPE port map (rd_seen,rd_seen_D,clk,RST,'0');
rd_seen_D <= ((NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	wr_seen AND WRn AND NOT RDn)
	OR (state_FSM_FFd3 AND rd_seen)
	OR (NOT state_FSM_FFd2 AND rd_seen)
	OR (NOT state_FSM_FFd1 AND rd_seen)
	OR (rd_seen AND wr_seen AND WRn)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT ALE AND NOT RDn));

FDCPE_rx_int: FDCPE port map (rx_int,rx_int_D,clk,RST,'0');
rx_int_D <= ((NOT rx_int AND NOT rx_run)
	OR (NOT rx_int AND NOT bit_cnt(3))
	OR (NOT rx_int AND NOT adv_q)
	OR (NOT rx_int AND NOT bit_cnt(0) AND NOT bit_cnt(1) AND NOT bit_cnt(2))
	OR (NOT addr_latch(0) AND NOT addr_latch(1) AND addr_latch(2) AND 
	IOM));

FTCPE_rx_run: FTCPE port map (rx_run,rx_run_T,clk,RST,'0');
rx_run_T <= ((NOT rx_run AND rx_s1 AND NOT rx_s0 AND NOT tx_run)
