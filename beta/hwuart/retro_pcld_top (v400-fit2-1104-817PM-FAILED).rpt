FTCPE_por_sh4: FTCPE port map (por_sh(4),por_sh_T(4),clk,'0','0');
por_sh_T(4) <= ((cnt(0) AND NOT cnt(1) AND NOT cnt(2) AND NOT por_sh(4) AND 
