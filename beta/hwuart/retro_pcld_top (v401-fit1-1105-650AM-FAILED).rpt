********** Mapped Logic **********


$OpTx$FX_DC$1202 <= (NOT addr_latch(1).LFBK AND IOM);


$OpTx$FX_DC$1218 <= (NOT addr_latch(0).LFBK AND NOT addr_latch(1).LFBK AND 
	addr_latch(2).LFBK AND IOM);


$OpTx$FX_SC$1234 <= (NOT addr_latch(0) AND NOT rx_run AND NOT addr_latch(1) AND 
	addr_latch(2) AND NOT tx_run AND IOM AND NOT WRn AND NOT FC_2_.OUT AND FC_6_.OUT);


$OpTx$FX_SC$155.LFBK <= ((NOT baud_cnt(0) AND FC_3_.OUT)
	OR (FC_1_.OUT AND FC_2_.OUT)
	OR (state_FSM_FFd2 AND NOT WRn AND NOT por_run AND 
	$OpTx$FX_DC$1218.LFBK AND FC_0_.OUT AND FC_1_.OUT));


A(0)_BUFR <= ((D(0) AND NOT addr_latch(0) AND addr_latch(1) AND 
	rd_drive/rd_drive_D2)
	OR (D(0) AND addr_latch(1) AND addr_latch(2) AND 
	rd_drive/rd_drive_D2)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND row0)
	OR (addr_latch(0) AND NOT rd_drive/rd_drive_D2)
	OR (D(0) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (D(0) AND NOT addr_latch(1) AND NOT addr_latch(2) AND 
	rd_drive/rd_drive_D2)
	OR (rx_int AND addr_latch(0) AND NOT addr_latch(1) AND 
	addr_latch(2) AND IOM)
	OR (NOT addr_latch(0) AND NOT addr_latch(1) AND addr_latch(2) AND 
	shreg(1) AND IOM AND rd_drive/rd_drive_D2));


A_I(0) <= A(0)_BUFR;
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A(1)_BUFR <= ((D(1) AND NOT addr_latch(0) AND addr_latch(1))
	OR (D(1) AND addr_latch(1) AND addr_latch(2))
	OR (D(1) AND addr_latch(1) AND NOT IOM)
