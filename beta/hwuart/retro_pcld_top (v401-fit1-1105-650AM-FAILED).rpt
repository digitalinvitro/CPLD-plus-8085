FDCPE_D0: FDCPE port map (D_I(0),D(0),clk,RST,'0');
D(0) <= ((D(0) AND NOT bus_reg_and0001/bus_reg_and0001_D2)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT WRn AND A(0).PIN)
	OR (NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	ALE AND NOT IOM AND D(0).PIN));
D(0) <= D_I(0) when D_OE(0) = '1' else 'Z';
D_OE(0) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D1: FDCPE port map (D_I(1),D(1),clk,RST,'0');
D(1) <= ((D(1) AND NOT bus_reg_and0001/bus_reg_and0001_D2)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT WRn AND A(1).PIN)
	OR (NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	ALE AND NOT IOM AND D(1).PIN));
D(1) <= D_I(1) when D_OE(1) = '1' else 'Z';
D_OE(1) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D2: FDCPE port map (D_I(2),D(2),clk,RST,'0');
D(2) <= ((D(2) AND NOT bus_reg_and0001/bus_reg_and0001_D2)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT WRn AND A(2).PIN)
	OR (NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	ALE AND NOT IOM AND D(2).PIN));
D(2) <= D_I(2) when D_OE(2) = '1' else 'Z';
D_OE(2) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D3: FDCPE port map (D_I(3),D(3),clk,RST,'0');
D(3) <= ((D(3) AND NOT bus_reg_and0001/bus_reg_and0001_D2)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT WRn AND A(3).PIN)
	OR (NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	ALE AND NOT IOM AND D(3).PIN));
D(3) <= D_I(3) when D_OE(3) = '1' else 'Z';
D_OE(3) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D4: FDCPE port map (D_I(4),D(4),clk,RST,'0');
D(4) <= ((D(4) AND NOT bus_reg_and0001/bus_reg_and0001_D2)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT WRn AND A(4).PIN)
	OR (NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	ALE AND NOT IOM AND D(4).PIN));
D(4) <= D_I(4) when D_OE(4) = '1' else 'Z';
D_OE(4) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D5: FDCPE port map (D_I(5),D(5),clk,RST,'0');
D(5) <= ((D(5) AND NOT bus_reg_and0001/bus_reg_and0001_D2)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT WRn AND A(5).PIN)
	OR (NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	ALE AND NOT IOM AND D(5).PIN));
D(5) <= D_I(5) when D_OE(5) = '1' else 'Z';
D_OE(5) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D6: FDCPE port map (D_I(6),D(6),clk,RST,'0');
D(6) <= ((D(6) AND NOT bus_reg_and0001/bus_reg_and0001_D2)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT WRn AND A(6).PIN)
	OR (NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	ALE AND NOT IOM AND D(6).PIN));
D(6) <= D_I(6) when D_OE(6) = '1' else 'Z';
D_OE(6) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D7: FDCPE port map (D_I(7),D(7),clk,RST,'0');
D(7) <= ((D(7) AND NOT bus_reg_and0001/bus_reg_and0001_D2)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT WRn AND A(7).PIN)
	OR (NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	ALE AND NOT IOM AND D(7).PIN));
D(7) <= D_I(7) when D_OE(7) = '1' else 'Z';
D_OE(7) <= bus_reg(7)/bus_reg(7)_TRST;










N1/N1_D2 <= ((rx_run AND NOT bit_cnt(3) AND NOT bit_cnt(0) AND 
	$OpTx$FX_DC$1210)
	OR (rx_run AND bit_cnt(3) AND NOT $OpTx$FX_DC$1210)
	OR (bit_cnt(3) AND bit_cnt(0) AND $OpTx$FX_DC$1210));


N59/N59_D2 <= ((NOT addr_latch(0) AND NOT rx_run AND NOT addr_latch(1) AND 
	addr_latch(2) AND NOT tx_run AND IOM AND NOT WRn AND FC_6_.OUT)
	OR (NOT rx_run AND NOT tx_run AND FC_2_.OUT));


OE_n <= NOT ((NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND NOT IOM AND A15));


OEr_n <= NOT ((NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND NOT IOM AND NOT A15));


READY <= '1';


RESET_IN <= (NOT RST AND NOT por_run);


SID <= RX;

FDCPE_SND: FDCPE port map (SND,SND_D,clk,RST,'0');
SND_D <= ((SND AND NOT dig_q_or0000/dig_q_or0000_D2)
	OR (A(4).PIN AND dig_q_or0000/dig_q_or0000_D2));


TX <= TX_BUFR;

FDCPE_TX_BUFR: FDCPE port map (TX_BUFR,TX_BUFR_D,clk,'0',RST);
TX_BUFR_D <= ((NOT rx_run AND adv_q AND shreg(1) AND tx_run)
	OR (rx_run AND NOT bit_cnt(3) AND bit_cnt(0) AND adv_q AND 
	shreg(1))
	OR (rx_run AND NOT bit_cnt(3) AND adv_q AND shreg(1) AND 
	NOT $OpTx$FX_DC$1210)
	OR (rx_run AND bit_cnt(3) AND NOT bit_cnt(0) AND adv_q AND 
	shreg(1) AND $OpTx$FX_DC$1210)
	OR (TX_BUFR AND NOT shreg_or0002/shreg_or0002_D2.LFBK));


WE_n <= ((NOT state_FSM_FFd3)
	OR (NOT state_FSM_FFd2 AND NOT state_FSM_FFd1));


X1 <= NOT ((NOT cnt(0) AND NOT cnt(1) AND NOT cnt(2))
	 XOR 
X1 <= NOT (x1_n);


X2 <= (NOT cnt(0) AND NOT cnt(1) AND NOT cnt(2))
	 XOR 
X2 <= x1_n;

FTCPE_addr_latch0: FTCPE port map (addr_latch(0),addr_latch_T(0),clk,RST,'0');
addr_latch_T(0) <= ((NOT state_FSM_FFd2 AND addr_latch(0).LFBK AND ALE AND 
	NOT A(0).PIN AND FC_0_.OUT)
	OR (NOT state_FSM_FFd2 AND NOT addr_latch(0).LFBK AND ALE AND 
	A(0).PIN AND FC_0_.OUT));

FTCPE_addr_latch1: FTCPE port map (addr_latch(1),addr_latch_T(1),clk,RST,'0');
addr_latch_T(1) <= ((NOT state_FSM_FFd2 AND addr_latch(1).LFBK AND ALE AND 
	NOT A(1).PIN AND FC_0_.OUT)
	OR (NOT state_FSM_FFd2 AND NOT addr_latch(1).LFBK AND ALE AND 
	A(1).PIN AND FC_0_.OUT));

FTCPE_addr_latch2: FTCPE port map (addr_latch(2),addr_latch_T(2),clk,RST,'0');
addr_latch_T(2) <= ((NOT state_FSM_FFd2 AND addr_latch(2).LFBK AND ALE AND 
	NOT A(2).PIN AND FC_0_.OUT)
	OR (NOT state_FSM_FFd2 AND NOT addr_latch(2).LFBK AND ALE AND 
	A(2).PIN AND FC_0_.OUT));

FTCPE_addr_latch3: FTCPE port map (addr_latch(3),addr_latch_T(3),clk,RST,'0');
addr_latch_T(3) <= ((NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	addr_latch(3) AND ALE AND NOT A(3).PIN)
	OR (NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT addr_latch(3) AND ALE AND A(3).PIN));

FTCPE_addr_latch4: FTCPE port map (addr_latch(4),addr_latch_T(4),clk,RST,'0');
addr_latch_T(4) <= ((NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	addr_latch(4) AND ALE AND NOT A(4).PIN)
	OR (NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT addr_latch(4) AND ALE AND A(4).PIN));

FTCPE_addr_latch5: FTCPE port map (addr_latch(5),addr_latch_T(5),clk,RST,'0');
addr_latch_T(5) <= ((NOT state_FSM_FFd2 AND addr_latch(5) AND ALE AND NOT A(5).PIN AND 
	FC_0_.OUT)
	OR (NOT state_FSM_FFd2 AND NOT addr_latch(5) AND ALE AND A(5).PIN AND 
	FC_0_.OUT));

FTCPE_addr_latch6: FTCPE port map (addr_latch(6),addr_latch_T(6),clk,RST,'0');
addr_latch_T(6) <= ((NOT state_FSM_FFd2 AND addr_latch(6) AND ALE AND NOT A(6).PIN AND 
	FC_0_.OUT)
	OR (NOT state_FSM_FFd2 AND NOT addr_latch(6) AND ALE AND A(6).PIN AND 
	FC_0_.OUT));

FTCPE_addr_latch7: FTCPE port map (addr_latch(7),addr_latch_T(7),clk,RST,'0');
addr_latch_T(7) <= ((NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	addr_latch(7) AND ALE AND NOT A(7).PIN)
	OR (NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT addr_latch(7) AND ALE AND A(7).PIN));

FDCPE_adv_q: FDCPE port map (adv_q,adv_q_D,clk,RST,'0');
adv_q_D <= ((rx_run AND NOT baud_cnt(0) AND NOT baud_cnt(1) AND 
	baud_cnt(2) AND baud_cnt(3))
	OR (NOT baud_cnt(0) AND NOT baud_cnt(1) AND baud_cnt(2) AND 
	tx_run AND baud_cnt(3)));

FDCPE_baud_cnt0: FDCPE port map (baud_cnt(0),baud_cnt_D(0),clk,RST,'0');
baud_cnt_D(0) <= ((NOT baud_cnt(0) AND NOT $OpTx$FX_SC$155.LFBK)
	OR (state_FSM_FFd2 AND NOT addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND addr_latch(2).LFBK AND IOM AND NOT WRn AND NOT por_run AND 
	FC_0_.OUT AND FC_1_.OUT AND NOT FC_2_.OUT));

FDCPE_baud_cnt1: FDCPE port map (baud_cnt(1),baud_cnt_D(1),clk,RST,'0');
baud_cnt_D(1) <= ((NOT baud_cnt(0) AND NOT baud_cnt(1) AND NOT FC_2_.OUT)
	OR (NOT rx_run AND NOT tx_run AND NOT WRn AND $OpTx$FX_DC$1218 AND 
	NOT FC_2_.OUT AND FC_6_.OUT)
	OR (rx_run AND baud_cnt(0) AND baud_cnt(1))
	OR (rx_run AND NOT baud_cnt(0) AND NOT baud_cnt(1))
	OR (baud_cnt(0) AND baud_cnt(1) AND tx_run)
	OR (baud_cnt(0) AND baud_cnt(1) AND NOT FC_2_.OUT)
	OR (NOT baud_cnt(0) AND NOT baud_cnt(1) AND tx_run));

FTCPE_baud_cnt2: FTCPE port map (baud_cnt(2),baud_cnt_T(2),clk,RST,'0');
baud_cnt_T(2) <= ((NOT baud_cnt(0) AND NOT baud_cnt(1) AND baud_cnt(2) AND 
	tx_run AND baud_cnt(3))
	OR (NOT baud_cnt(0) AND NOT baud_cnt(1) AND baud_cnt(2) AND 
	baud_cnt(3) AND NOT FC_2_.OUT)
	OR (NOT rx_run AND baud_cnt(2) AND NOT tx_run AND NOT WRn AND 
	$OpTx$FX_DC$1218 AND NOT FC_2_.OUT AND FC_6_.OUT)
	OR (baud_cnt(0) AND baud_cnt(1) AND NOT baud_cnt(2) AND 
	NOT $OpTx$FX_DC$1218)
	OR (baud_cnt(0) AND baud_cnt(1) AND NOT baud_cnt(2) AND 
	NOT FC_6_.OUT)
	OR (rx_run AND NOT baud_cnt(0) AND NOT baud_cnt(1) AND 
	baud_cnt(2) AND baud_cnt(3))
	OR (rx_run AND baud_cnt(0) AND baud_cnt(1))
	OR (baud_cnt(0) AND baud_cnt(1) AND tx_run)
	OR (NOT rx_run AND NOT baud_cnt(2) AND NOT tx_run AND FC_2_.OUT)
	OR (baud_cnt(0) AND baud_cnt(1) AND baud_cnt(2) AND 
	NOT FC_2_.OUT)
	OR (baud_cnt(0) AND baud_cnt(1) AND NOT baud_cnt(2) AND WRn));

FDCPE_baud_cnt3: FDCPE port map (baud_cnt(3),baud_cnt_D(3),clk,RST,'0');
baud_cnt_D(3) <= ((NOT rx_run AND NOT tx_run AND FC_2_.OUT)
	OR (NOT baud_cnt(0) AND NOT baud_cnt(1) AND baud_cnt(2))
	OR (baud_cnt(0) AND baud_cnt(1) AND baud_cnt(2) AND 
	baud_cnt(3))
	OR (NOT rx_run AND NOT tx_run AND NOT WRn AND $OpTx$FX_DC$1218 AND 
	FC_6_.OUT)
	OR (NOT baud_cnt(0) AND NOT baud_cnt(3))
	OR (NOT baud_cnt(1) AND NOT baud_cnt(3))
	OR (NOT baud_cnt(2) AND NOT baud_cnt(3)));

FDCPE_bit_cnt0: FDCPE port map (bit_cnt(0),bit_cnt_D(0),clk,RST,'0');
bit_cnt_D(0) <= ((rx_run AND bit_cnt(3) AND NOT bit_cnt(0) AND adv_q AND 
	$OpTx$FX_DC$1210)
	OR (rx_run AND NOT bit_cnt(3) AND NOT bit_cnt(0) AND adv_q AND 
	NOT $OpTx$FX_DC$1210)
	OR (rx_run AND NOT bit_cnt(3) AND NOT bit_cnt(0) AND adv_q AND 
	NOT rx_s1 AND NOT N59/N59_D2)
	OR (bit_cnt(0) AND NOT adv_q AND NOT N59/N59_D2)
	OR (NOT rx_run AND bit_cnt(0) AND NOT tx_run AND NOT N59/N59_D2)
	OR (NOT rx_run AND NOT bit_cnt(0) AND adv_q AND tx_run));


bus_reg(7)/bus_reg(7)_TRST <= ((state_FSM_FFd3)
	OR (state_FSM_FFd2 AND NOT state_FSM_FFd1));


bus_reg_and0001/bus_reg_and0001_D2 <= ((NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT WRn)
	OR (NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	ALE AND NOT IOM));

FTCPE_cnt1: FTCPE port map (cnt(1),cnt_T(1),clk,'0','0');
cnt_T(1) <= ((NOT cnt(0) AND NOT cnt(1))
	OR (NOT cnt(0) AND NOT cnt(2)));

FDCPE_cnt2: FDCPE port map (cnt(2),cnt_D(2),clk,'0','0');
cnt_D(2) <= ((NOT cnt(1) AND cnt(2))
	OR (cnt(0) AND cnt(1) AND NOT cnt(2)));

FDCPE_col0: FDCPE port map (col0,col0_D,clk,RST,'0');
col0_D <= ((col0 AND NOT kbcol_q_or0000/kbcol_q_or0000_D2)
	OR (A(0).PIN AND kbcol_q_or0000/kbcol_q_or0000_D2));

FDCPE_col1: FDCPE port map (col1,col1_D,clk,RST,'0');
col1_D <= ((col1 AND NOT kbcol_q_or0000/kbcol_q_or0000_D2)
	OR (A(1).PIN AND kbcol_q_or0000/kbcol_q_or0000_D2));

FDCPE_col2: FDCPE port map (col2,col2_D,clk,RST,'0');
col2_D <= ((col2 AND NOT kbcol_q_or0000/kbcol_q_or0000_D2)
	OR (A(2).PIN AND kbcol_q_or0000/kbcol_q_or0000_D2));

FDCPE_col3: FDCPE port map (col3,col3_D,clk,RST,'0');
col3_D <= ((col3 AND NOT kbcol_q_or0000/kbcol_q_or0000_D2)
	OR (A(3).PIN AND kbcol_q_or0000/kbcol_q_or0000_D2));

FDCPE_dig0: FDCPE port map (dig(0),dig_D(0),clk,RST,'0');
dig_D(0) <= ((NOT A(0).PIN AND dig_q_or0000/dig_q_or0000_D2)
	OR (dig(0) AND NOT dig_q_or0000/dig_q_or0000_D2));

FDCPE_dig1: FDCPE port map (dig(1),dig_D(1),clk,RST,'0');
dig_D(1) <= ((NOT A(1).PIN AND dig_q_or0000/dig_q_or0000_D2)
	OR (dig(1) AND NOT dig_q_or0000/dig_q_or0000_D2));

FDCPE_dig2: FDCPE port map (dig(2),dig_D(2),clk,RST,'0');
dig_D(2) <= ((NOT A(2).PIN AND dig_q_or0000/dig_q_or0000_D2)
	OR (dig(2) AND NOT dig_q_or0000/dig_q_or0000_D2));

FDCPE_dig3: FDCPE port map (dig(3),dig_D(3),clk,RST,'0');
dig_D(3) <= ((NOT A(3).PIN AND dig_q_or0000/dig_q_or0000_D2)
	OR (dig(3) AND NOT dig_q_or0000/dig_q_or0000_D2));


dig_q_or0000/dig_q_or0000_D2 <= (state_FSM_FFd2 AND addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND IOM AND NOT WRn AND FC_0_.OUT);


kbcol_q_or0000/kbcol_q_or0000_D2 <= (state_FSM_FFd2 AND NOT addr_latch(0).LFBK AND 
	addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND IOM AND NOT WRn AND FC_0_.OUT);

FDCPE_por_run: FDCPE port map (por_run,por_sh(0),clk,'0','0');

FDCPE_por_sh0: FDCPE port map (por_sh(0),por_sh_D(0),clk,'0','0');
por_sh_D(0) <= ((x1_n AND por_sh(1))
	OR (NOT x1_n AND por_sh(0)));

FDCPE_por_sh1: FDCPE port map (por_sh(1),por_sh_D(1),clk,'0','0');
por_sh_D(1) <= ((x1_n AND por_sh(2))
	OR (NOT x1_n AND por_sh(1)));


rd_drive/rd_drive_D2 <= (state_FSM_FFd2 AND rd_seen AND NOT ALE AND NOT RDn AND 
	NOT bus_reg(7)/bus_reg(7)_TRST);

FDCPE_rd_seen: FDCPE port map (rd_seen,rd_seen_D,clk,RST,'0');
rd_seen_D <= ((NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	wr_seen AND WRn AND NOT RDn)
	OR (state_FSM_FFd3 AND rd_seen)
	OR (NOT state_FSM_FFd2 AND rd_seen)
	OR (NOT state_FSM_FFd1 AND rd_seen)
	OR (rd_seen AND wr_seen AND WRn)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT ALE AND NOT RDn));

FDCPE_rx_int: FDCPE port map (rx_int,rx_int_D,clk,RST,'0');
rx_int_D <= ((rx_int AND NOT $OpTx$FX_DC$1218)
	OR (rx_run AND bit_cnt(3) AND NOT $OpTx$FX_DC$1218 AND 
	FC_5_.OUT));

FTCPE_rx_run: FTCPE port map (rx_run,rx_run_T,clk,RST,'0');
rx_run_T <= ((rx_run AND bit_cnt(3) AND adv_q AND NOT $OpTx$FX_DC$1210)
	OR (NOT rx_run AND rx_s1 AND NOT rx_s0 AND NOT tx_run)
	OR (rx_run AND NOT bit_cnt(3) AND NOT bit_cnt(0) AND adv_q AND 
	rx_s1 AND $OpTx$FX_DC$1210)
	OR (rx_run AND bit_cnt(3) AND bit_cnt(0) AND adv_q));

FDCPE_rx_s1: FDCPE port map (rx_s1,rx_s0,clk,'0',RST);

FDCPE_seg0: FDCPE port map (seg(0),seg_D(0),clk,RST,'0');
seg_D(0) <= ((NOT A(0).PIN AND seg_q_or0000/seg_q_or0000_D2)
	OR (seg(0) AND NOT seg_q_or0000/seg_q_or0000_D2));

FDCPE_seg1: FDCPE port map (seg(1),seg_D(1),clk,RST,'0');
seg_D(1) <= ((NOT A(1).PIN AND seg_q_or0000/seg_q_or0000_D2)
	OR (seg(1) AND NOT seg_q_or0000/seg_q_or0000_D2));

FDCPE_seg2: FDCPE port map (seg(2),seg_D(2),clk,RST,'0');
seg_D(2) <= ((NOT A(2).PIN AND seg_q_or0000/seg_q_or0000_D2)
	OR (seg(2) AND NOT seg_q_or0000/seg_q_or0000_D2));

FDCPE_seg3: FDCPE port map (seg(3),seg_D(3),clk,RST,'0');
seg_D(3) <= ((NOT A(3).PIN AND seg_q_or0000/seg_q_or0000_D2)
	OR (seg(3) AND NOT seg_q_or0000/seg_q_or0000_D2));

FDCPE_seg4: FDCPE port map (seg(4),seg_D(4),clk,RST,'0');
seg_D(4) <= ((NOT A(4).PIN AND seg_q_or0000/seg_q_or0000_D2)
	OR (seg(4) AND NOT seg_q_or0000/seg_q_or0000_D2));

FDCPE_seg5: FDCPE port map (seg(5),seg_D(5),clk,RST,'0');
seg_D(5) <= ((NOT A(5).PIN AND seg_q_or0000/seg_q_or0000_D2)
	OR (seg(5) AND NOT seg_q_or0000/seg_q_or0000_D2));

FDCPE_seg6: FDCPE port map (seg(6),seg_D(6),clk,RST,'0');
seg_D(6) <= ((NOT A(6).PIN AND seg_q_or0000/seg_q_or0000_D2)
	OR (seg(6) AND NOT seg_q_or0000/seg_q_or0000_D2));

FDCPE_seg7: FDCPE port map (seg(7),seg_D(7),clk,RST,'0');
seg_D(7) <= ((NOT A(7).PIN AND seg_q_or0000/seg_q_or0000_D2)
	OR (seg(7) AND NOT seg_q_or0000/seg_q_or0000_D2));


seg_q_or0000/seg_q_or0000_D2 <= (state_FSM_FFd2 AND NOT addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND IOM AND NOT WRn AND FC_0_.OUT);

FDCPE_shreg1: FDCPE port map (shreg(1),shreg_D(1),clk,'0',RST);
shreg_D(1) <= ((rx_run AND NOT bit_cnt(3) AND adv_q AND shreg(2) AND 
	NOT $OpTx$FX_DC$1210)
	OR (rx_run AND bit_cnt(3) AND NOT bit_cnt(0) AND adv_q AND 
	shreg(2) AND $OpTx$FX_DC$1210)
	OR (shreg(1) AND NOT shreg_or0002/shreg_or0002_D2.LFBK)
	OR (A(0).PIN AND $OpTx$FX_SC$1234)
	OR (NOT rx_run AND adv_q AND shreg(2) AND tx_run)
	OR (rx_run AND NOT bit_cnt(3) AND bit_cnt(0) AND adv_q AND 
	shreg(2)));

FDCPE_shreg2: FDCPE port map (shreg(2),shreg_D(2),clk,'0',RST);
shreg_D(2) <= ((rx_run AND bit_cnt(3) AND NOT bit_cnt(0) AND adv_q AND 
	shreg(3) AND $OpTx$FX_DC$1210)
	OR (shreg(2) AND NOT shreg_or0002/shreg_or0002_D2.LFBK)
	OR (A(1).PIN AND $OpTx$FX_SC$1234)
	OR (NOT rx_run AND adv_q AND shreg(3) AND tx_run)
	OR (rx_run AND NOT bit_cnt(3) AND bit_cnt(0) AND adv_q AND 
	shreg(3))
	OR (rx_run AND NOT bit_cnt(3) AND adv_q AND shreg(3) AND 
	NOT $OpTx$FX_DC$1210));

FDCPE_shreg3: FDCPE port map (shreg(3),shreg_D(3),clk,'0',RST);
shreg_D(3) <= ((rx_run AND bit_cnt(3) AND NOT bit_cnt(0) AND adv_q AND 
	shreg(4) AND $OpTx$FX_DC$1210)
	OR (shreg(3) AND NOT shreg_or0002/shreg_or0002_D2.LFBK)
	OR (A(2).PIN AND $OpTx$FX_SC$1234)
	OR (NOT rx_run AND adv_q AND shreg(4) AND tx_run)
	OR (rx_run AND NOT bit_cnt(3) AND bit_cnt(0) AND adv_q AND 
	shreg(4))
	OR (rx_run AND NOT bit_cnt(3) AND adv_q AND shreg(4) AND 
	NOT $OpTx$FX_DC$1210));

FDCPE_shreg4: FDCPE port map (shreg(4),shreg_D(4),clk,'0',RST);
shreg_D(4) <= ((rx_run AND NOT bit_cnt(3) AND adv_q AND shreg(5) AND 
	NOT $OpTx$FX_DC$1210)
	OR (rx_run AND bit_cnt(3) AND NOT bit_cnt(0) AND adv_q AND 
	shreg(5) AND $OpTx$FX_DC$1210)
	OR (shreg(4) AND NOT shreg_or0002/shreg_or0002_D2.LFBK)
	OR (A(3).PIN AND $OpTx$FX_SC$1234)
	OR (NOT rx_run AND adv_q AND shreg(5) AND tx_run)
	OR (rx_run AND NOT bit_cnt(3) AND bit_cnt(0) AND adv_q AND 
	shreg(5)));

FDCPE_shreg5: FDCPE port map (shreg(5),shreg_D(5),clk,'0',RST);
shreg_D(5) <= ((rx_run AND NOT bit_cnt(3) AND bit_cnt(0) AND adv_q AND 
	shreg(6))
	OR (rx_run AND NOT bit_cnt(3) AND adv_q AND shreg(6) AND 
	NOT $OpTx$FX_DC$1210)
	OR (rx_run AND bit_cnt(3) AND NOT bit_cnt(0) AND adv_q AND 
	shreg(6) AND $OpTx$FX_DC$1210)
	OR (shreg(5) AND NOT shreg_or0002/shreg_or0002_D2.LFBK)
	OR (A(4).PIN AND $OpTx$FX_SC$1234)
	OR (NOT rx_run AND adv_q AND shreg(6) AND tx_run));

FDCPE_shreg6: FDCPE port map (shreg(6),shreg_D(6),clk,'0',RST);
shreg_D(6) <= ((rx_run AND bit_cnt(3) AND NOT bit_cnt(0) AND adv_q AND 
	shreg(7) AND $OpTx$FX_DC$1210)
	OR (shreg(6) AND NOT shreg_or0002/shreg_or0002_D2.LFBK)
	OR (A(5).PIN AND $OpTx$FX_SC$1234)
	OR (NOT rx_run AND adv_q AND shreg(7) AND tx_run)
	OR (rx_run AND NOT bit_cnt(3) AND bit_cnt(0) AND adv_q AND 
	shreg(7))
	OR (rx_run AND NOT bit_cnt(3) AND adv_q AND shreg(7) AND 
	NOT $OpTx$FX_DC$1210));

FDCPE_shreg7: FDCPE port map (shreg(7),shreg_D(7),clk,'0',RST);
shreg_D(7) <= ((rx_run AND NOT bit_cnt(3) AND adv_q AND shreg(8) AND 
	NOT $OpTx$FX_DC$1210)
	OR (rx_run AND bit_cnt(3) AND NOT bit_cnt(0) AND adv_q AND 
	shreg(8) AND $OpTx$FX_DC$1210)
	OR (shreg(7) AND NOT shreg_or0002/shreg_or0002_D2.LFBK)
	OR (A(6).PIN AND $OpTx$FX_SC$1234)
	OR (NOT rx_run AND adv_q AND shreg(8) AND tx_run)
	OR (rx_run AND NOT bit_cnt(3) AND bit_cnt(0) AND adv_q AND 
	shreg(8)));

FDCPE_shreg8: FDCPE port map (shreg(8),shreg_D(8),clk,'0',RST);
shreg_D(8) <= ((rx_run AND NOT bit_cnt(3) AND bit_cnt(0) AND adv_q AND 
	rx_s1)
	OR (rx_run AND NOT bit_cnt(3) AND adv_q AND rx_s1 AND 
	NOT $OpTx$FX_DC$1210)
	OR (rx_run AND bit_cnt(3) AND NOT bit_cnt(0) AND adv_q AND 
	rx_s1 AND $OpTx$FX_DC$1210)
	OR (shreg(8) AND NOT shreg_or0002/shreg_or0002_D2.LFBK)
	OR (A(7).PIN AND $OpTx$FX_SC$1234)
	OR (NOT rx_run AND adv_q AND tx_run));


shreg_or0002/shreg_or0002_D2.LFBK <= ((rx_run AND NOT bit_cnt(3) AND adv_q AND NOT $OpTx$FX_DC$1210)
	OR (rx_run AND bit_cnt(3) AND NOT bit_cnt(0) AND adv_q AND 
	$OpTx$FX_DC$1210)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND NOT rx_run AND 
	state_FSM_FFd1 AND NOT rx_s1 AND NOT tx_run AND NOT WRn AND NOT por_run AND FC_4_.OUT)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND NOT rx_run AND 
	state_FSM_FFd1 AND rx_s0 AND NOT tx_run AND NOT WRn AND NOT por_run AND FC_4_.OUT)
	OR (NOT rx_run AND adv_q AND tx_run)
	OR (rx_run AND NOT bit_cnt(3) AND bit_cnt(0) AND adv_q));

FDCPE_state_FSM_FFd1: FDCPE port map (state_FSM_FFd1,state_FSM_FFd1_D,clk,RST,'0');
state_FSM_FFd1_D <= ((state_FSM_FFd2 AND state_FSM_FFd1 AND rd_seen AND RDn)
	OR (state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1)
	OR (state_FSM_FFd3 AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd1)
	OR (state_FSM_FFd2 AND state_FSM_FFd1 AND ALE)
	OR (NOT state_FSM_FFd2 AND NOT state_FSM_FFd1 AND NOT ALE)
	OR (state_FSM_FFd2 AND state_FSM_FFd1 AND wr_seen AND WRn));

FDCPE_state_FSM_FFd2: FDCPE port map (state_FSM_FFd2,state_FSM_FFd2_D,clk,RST,'0');
state_FSM_FFd2_D <= ((state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	wr_seen AND NOT IOM AND WRn AND A15 AND NOT por_run)
	OR (NOT state_FSM_FFd2 AND state_FSM_FFd1 AND NOT ALE)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd1 AND NOT rd_seen AND 
	NOT wr_seen AND NOT ALE)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd1 AND NOT rd_seen AND NOT ALE AND 
	NOT WRn)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd1 AND NOT wr_seen AND NOT ALE AND 
	NOT RDn)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd1 AND NOT ALE AND NOT WRn AND 
	NOT RDn));

FDCPE_state_FSM_FFd3: FDCPE port map (state_FSM_FFd3,state_FSM_FFd3_D,clk,RST,'0');
state_FSM_FFd3_D <= ((state_FSM_FFd3 AND state_FSM_FFd1)
	OR (state_FSM_FFd2 AND NOT state_FSM_FFd1));

FTCPE_tx_run: FTCPE port map (tx_run,tx_run_T,clk,RST,'0');
tx_run_T <= ((NOT rx_run AND tx_run AND FC_5_.OUT)
	OR (NOT addr_latch(0) AND NOT rx_run AND NOT addr_latch(1) AND 
	addr_latch(2) AND NOT tx_run AND IOM AND NOT WRn AND NOT FC_2_.OUT AND FC_6_.OUT));

FDCPE_wr_seen: FDCPE port map (wr_seen,wr_seen_D,clk,RST,'0');
wr_seen_D <= ((state_FSM_FFd3 AND wr_seen)
	OR (NOT state_FSM_FFd2 AND wr_seen)
	OR (NOT state_FSM_FFd1 AND wr_seen)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT ALE AND NOT WRn)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	rd_seen AND NOT WRn AND RDn));

FTCPE_x1_n: FTCPE port map (x1_n,x1_n_T,NOT clk,'0','0');
x1_n_T <= ((x1_n AND NOT cnt(0) AND NOT cnt(1) AND cnt(2))
	OR (NOT x1_n AND cnt(0) AND cnt(1) AND NOT cnt(2)));

********** UnMapped Logic **********

** Buried Nodes **

FDCPE_bit_cnt1: FDCPE port map (bit_cnt(1),bit_cnt_D(1),clk,RST,'0');
bit_cnt_D(1) <= ((NOT adv_q AND bit_cnt(1) AND NOT N59/N59_D2)
	OR (NOT rx_run AND bit_cnt(1) AND NOT tx_run AND NOT N59/N59_D2)
	OR (rx_run AND NOT bit_cnt(3) AND NOT bit_cnt(0) AND adv_q AND 
	bit_cnt(1))
	OR (NOT rx_run AND NOT bit_cnt(0) AND adv_q AND bit_cnt(1) AND 
	tx_run)
	OR (rx_run AND NOT bit_cnt(3) AND bit_cnt(0) AND adv_q AND 
	NOT bit_cnt(1))
	OR (NOT bit_cnt(3) AND bit_cnt(0) AND adv_q AND NOT bit_cnt(1) AND 
	tx_run)
	OR (NOT rx_run AND bit_cnt(0) AND adv_q AND NOT bit_cnt(1) AND 
	bit_cnt(2) AND tx_run));

FTCPE_bit_cnt2: FTCPE port map (bit_cnt(2),bit_cnt_T(2),clk,RST,'0');
bit_cnt_T(2) <= ((NOT rx_run AND bit_cnt(0) AND adv_q AND bit_cnt(1) AND 
	tx_run)
	OR (rx_run AND NOT bit_cnt(3) AND bit_cnt(0) AND adv_q AND 
	bit_cnt(1))
	OR (rx_run AND bit_cnt(3) AND adv_q AND bit_cnt(2))
	OR (bit_cnt(2) AND N59/N59_D2));

FTCPE_bit_cnt3: FTCPE port map (bit_cnt(3),bit_cnt_T(3),clk,RST,'0');
bit_cnt_T(3) <= ((rx_run AND bit_cnt(0) AND adv_q AND bit_cnt(1) AND 
	bit_cnt(2))
	OR (bit_cnt(0) AND adv_q AND bit_cnt(1) AND bit_cnt(2) AND 
	tx_run)
	OR (bit_cnt(3) AND N59/N59_D2)
	OR (rx_run AND bit_cnt(3) AND bit_cnt(0) AND adv_q)
	OR (bit_cnt(3) AND bit_cnt(0) AND adv_q AND NOT bit_cnt(1) AND 
	NOT bit_cnt(2) AND tx_run)
	OR (rx_run AND bit_cnt(3) AND adv_q AND bit_cnt(2))
	OR (rx_run AND bit_cnt(3) AND adv_q AND bit_cnt(1)));

FTCPE_cnt0: FTCPE port map (cnt(0),cnt_T(0),clk,'0','0');
cnt_T(0) <= (NOT cnt(0) AND cnt(1) AND cnt(2));

FDCPE_por_sh2: FDCPE port map (por_sh(2),por_sh_D(2),clk,'0','0');
por_sh_D(2) <= ((NOT x1_n AND por_sh(2))
	OR (x1_n AND por_sh(3)));

FDCPE_por_sh3: FDCPE port map (por_sh(3),por_sh_D(3),clk,'0','0');
por_sh_D(3) <= (NOT x1_n AND por_sh(3));

FDCPE_rx_s0: FDCPE port map (rx_s0,RX,clk,'0',RST);

Register Legend:
 FDCPE (Q,D,C,CLR,PRE); 
 FTCPE (Q,D,C,CLR,PRE); 
 LDCP  (Q,D,G,CLR,PRE); 

