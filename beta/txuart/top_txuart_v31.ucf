# =====================================================================
# top_txuart_v31.ucf - XC95108-15PQ100C, дизайн top_txuart_por6_v31_utf8.v
# v3.1 (11-17, Шаг-9 = хвост п.в "диеты"): пины/LOC БЕЗ ИЗМЕНЕНИЙ 1-в-1 с v29
# (v3.0 UCF не создавался); X2 -> ВХОД (x2_q СНЯТ, нога Hi-Z, X2 = open -
# Н-8 ниже; О-6/Р-7 реализовано). Кодировки: только UTF-8 (Д-12).
# переписаны с нуля и синхронизированы с RTL v2.8.9).
#
# ИСТОРИЯ КОДИРОВОК (Д-12): файлы .ucf/.v этой линии - CP1251; правки 2.8.x
# дописывались в UTF-8 поверх -> смесь, часть русских комментариев потеряна
# необратимо. Правило дальше: ТОЛЬКО UTF-8, CP1251-версии RTL не редактировать.
#
# ПРОВЕРКА ПРИНАДЛЕЖНОСТЕЙ (ревью §0): 49 имён портов RTL <-> 73 NET...LOC,
# 0 расхождений, 0 дублей пинов; 73 назначенных + 8 PGND = 81 user I/O PQ100.
#
# ---------------------------------------------------------------------
# ТАКТ И СБРОС
# ---------------------------------------------------------------------
NET "clk"  LOC = "P29";   # GCK3, такт логики: 25 МГц (H1 С ШУНТОМ - DIV=/4
                          # генератора U7; БЕЗ шунта 50 МГц ЗАПРЕЩЕНО -
                          # CPU 6,25 МГц = 1,75x разгона, п.23/34 шапки RTL)
NET "RST"  LOC = "P1";    # SW20 (кнопка сброса). ВНИМАНИЕ (ревью Д-1):
                          # направление подтяжки и полярность нажатия нигде
                          # не зафиксированы; UCF-запись «SW20.1->RST,
                          # SW20.3/4->GND» при стандартной паровке ног 1-2/3-4
                          # даёт «нажатие = 0», а RTL/старый комментарий
                          # требуют «покой = 0, нажатие = 1 (Task 25)».
                          # СВЕРИТЬ мультиметром до Р-1 (слияние POR+кнопка);
                          # при висящем пине bus-hold удерживает последнее
                          # значение - сброс может залипнуть.

# ---------------------------------------------------------------------
# ШИНА i8085 (входы автомата) - активные уровни: ALE=1, WR#/RD#=0, IOM: 1=IO
# ---------------------------------------------------------------------
NET "ALE"  LOC = "P93";   # cpu1 (нога 30)
NET "WRn"  LOC = "P92";   # cpu2 (нога 31), активный 0
NET "RDn"  LOC = "P91";   # cpu3 (нога 32), активный 0
NET "IOM"  LOC = "P88";   # cpu5 (нога 34): 1=IO, 0=память
NET "A15"  LOC = "P97";   # декод памяти: 1=SRAM 8000h-FFFFh, 0=flash 0000h-7FFFh

# ---------------------------------------------------------------------
# МУЛЬТИПЛЕКСИРОВАННАЯ ШИНА AD0-AD7 = сети A0..A7 (bidir, IO-MC)
# ---------------------------------------------------------------------
NET "A<0>" LOC = "P26";
NET "A<1>" LOC = "P21";
NET "A<2>" LOC = "P19";
NET "A<3>" LOC = "P17";
NET "A<4>" LOC = "P15";
NET "A<5>" LOC = "P13";
NET "A<6>" LOC = "P11";
NET "A<7>" LOC = "P9";

# ---------------------------------------------------------------------
# ШИНА ДАННЫХ ПАМЯТИ D0-D7 (bidir, IO-MC)
# ---------------------------------------------------------------------
NET "D<0>" LOC = "P30";
NET "D<1>" LOC = "P32";
NET "D<2>" LOC = "P35";
NET "D<3>" LOC = "P36";
NET "D<4>" LOC = "P34";
NET "D<5>" LOC = "P31";
NET "D<6>" LOC = "P27";
NET "D<7>" LOC = "P22";

# ---------------------------------------------------------------------
# УПРАВЛЕНИЕ ПАМЯТЬЮ (активные 0). Запись ОЗУ - ТОЛЬКО writeback
# (после WR#(вверх), отложенный импульс /WE 40..200 нс - п.4 шапки RTL);
# у flash /WE не подключён - запись в ПЗУ отбрасывается.
# РЕВЬЮ О-5: защита адреса/данных покрывает только A0..A7; старший адрес
# A8..A14 идёт от CPU напрямую - сверить осциллографом WR#(вверх) ->
# смена A8..A14 vs окно /WE (пункт Б-4 чек-листа).
# ---------------------------------------------------------------------
NET "CSr_n" LOC = "P20";  # flash U10 /CE (U10.22): CSr_n = A15 | IOM
NET "OEr_n" LOC = "P16";  # flash U10 /OE (U10.24): OEr_n = CSr_n | wr_phase
NET "CS_n"  LOC = "P25";  # SRAM U4 /CE (U4.22): CS_n = in_wb ? 0 : (!A15 | IOM)
NET "OE_n"  LOC = "P37";  # SRAM U4 /OE (U4.24): OE_n = CS_n | wr_phase
NET "WE_n"  LOC = "P24";  # SRAM U4 /WE (U4.29): только writeback
NET "CS1"   LOC = "P99";  # SRAM U4 CE2 (U4.30), константа '1'

# ---------------------------------------------------------------------
# ПОДДЕРЖКА ПРОЦЕССОРА
# ---------------------------------------------------------------------
NET "X1"        LOC = "P68";  # cpu21 (нога 1): x1_q, 6,25 МГц = 25/4,
                              # период ровно 160 нс, duty 1/2 (80/80 нс,
                              # v2.4+; НЕ duty 1/4 - кольцо s0..s3 удалено);
                              # внутренний /2 ВМ85А -> CPU 3,125 МГц
NET "READY"     LOC = "P87";  # cpu6 (нога 35): константа '1' (wait-state
                              # запрещены; путь «READY=0 на запись» - v3/Р-10)
NET "RESET_IN"  LOC = "P84";  # cpu7 (нога 36): регистр reset_q, активный 0;
                              # низ 1320 нс от конфигурации (Н-4: 8 стробов
                              # x 160 + регистры por_run/reset_q + фаза
                              # первого por_ce; норма 960 нс, запас 1,375x)
NET "RST75"     LOC = "P75";  # cpu15 (U3.7 = CPU RST 7.5, edge-защёлка,
                              # маскируемая, вектор 003Ch): выход RST75_r
                              # таймера. С v2.8 = УРОВЕНЬ до следующей
                              # загрузки (П-5: импульс 40 нс не ловился
                              # тактом CPU 320 нс). УДЕРЖАННЫЙ УРОВЕНЬ =
                              # РОВНО ОДИН запрос (Д-9). P75 БОЛЬШЕ НЕ PGND
                              # (Н-8: чек-лист RTL п.c обновлён)

# ---------------------------------------------------------------------
# SOFT-UART ТРАНЗИТЫ + АППАРАТНЫЙ ПЕРЕДАТЧИК TXUART
# ---------------------------------------------------------------------
NET "RX"  LOC = "P38";    # CH340G.TXD -> транзит в SID (приём RIM 20h).
                          # НЕ ЗАЗЕМЛЯТЬ (выход CH340G)
NET "TX"  LOC = "P39";    # shreg[0] -> CH340G.RXD. АППАРАТНЫЙ ПЕРЕДАТЧИК
                          # 8N1 **1 000 000** бод (Н-6: было «1 562 500» -
                          # мёртвый комментарий v2.2-эпохи, BAUD_DIV=25;
                          # 1 562 500 в сетке CH340G не существует, урок 11-9).
                          # Терминал/клиент: 1 000 000 8N1
NET "SOD" LOC = "P72";    # CPU.SOD - наблюдатель БЕЗ нагрузки (keep обязателен:
                          # без него Xst:3005 + "Ground on Unused IOs"
                          # заземлит выход CPU - класс Task 68-f).
                          # НЕ ЗАЗЕМЛЯТЬ
NET "SID" LOC = "P73";    # CPU.SID - ВЫХОД CPLD (транзит RX), Task 70-a

# ---------------------------------------------------------------------
# УЗЕЛ ЧАСЫ / НАБЛЮДАТЕЛИ («мёртвые» пины = Hi-Z входы, keep обязателен)
# Н-8 п.d/п.e: v3.1 (Шаг-9, 11-17, "Делай" владельца) - О-6/Р-7 РЕАЛИЗОВАНО:
# X2 - ВХОД (CPLD не управляет ногой, Hi-Z); x2_q СНЯТ - делитель /4 стал
# 2 ФФ (t0_q/x1_q). Даташит CA80C85B: при внешнем такте X1 X2 = open
# допустим, GND/нуль ЗАПРЕЩЕНЫ. Баг T1 v28.1 (X2 = константа 0 убил
# генератор при живом X1) не воспроизводится: нуля на ноге нет; keep-порт
# в RTL + Keep Unused Inputs ON в фиттере сохраняют P69 входом (как
# CLKOUT/наблюдатели выше: «мёртвые» пины = Hi-Z входы).
# История: v2.6-v2.8.9 - ВЫХОД x2_q (регистровая ~X1, T = t0_q);
# Ревью Д-4 закрыто.
NET "X2"     LOC = "P69";  # cpu20 (нога 2): ВХОД v3.1, X2 ОТКРЫТ. GND/нуль ЗАПРЕЩЕНЫ
NET "RSTOUT" LOC = "P70";  # cpu19 (нога 3): CPU RESET OUT
NET "INTAn"  LOC = "P80";  # cpu11 (нога 11)
NET "HLDA"   LOC = "P82";  # cpu9 (нога 38)
NET "CLKOUT" LOC = "P83";  # cpu8 (нога 37): 3,125 МГц - контроль генератора
                           # после любых экспериментов с X2 (Б-3)
NET "S0"     LOC = "P94";  # cpu0 (нога 29)
NET "S1"     LOC = "P89";  # cpu4 (нога 33)
NET "AH8"    LOC = "P10";  # цепь A8 (нога 21) - старший адрес: вход-наблюдатель
NET "AH9"    LOC = "P12";  # цепь A9 (нога 22); НЕ защищены на writeback - О-5
NET "AH10"   LOC = "P18";  # цепь A10 (нога 23)
NET "AH11"   LOC = "P14";  # цепь A11 (нога 24)
NET "AH12"   LOC = "P4";   # цепь A12 (нога 25)
NET "AH13"   LOC = "P8";   # цепь A13 (нога 26)
NET "AH14"   LOC = "P3";   # цепь A14 (нога 27)

# ---------------------------------------------------------------------
# КЛАВИАТУРА 4x5 (Task 34): колонки активны '1' (kbcol_q, INIT 0000),
# строки row0..4. v2.9 ШАГ-1: колонки = СТАРШИЙ НИББЛ A[7:4] записи порта
# 06h (был отдельный порт 02h - декод удалён); КЛАВИАТУРА РАБОТАЕТ ТОЛЬКО
# С fw v1.2 (v1.0/v1.1 несовместимы: v1.0 пишет 02h - колонки не заведутся;
# v1.1 опрашивает статус 05h - Шаг-2 перенёс TXRDY в бит 7 чтения 03h).
# РЕВЬЮ Д-2: направление
# подтяжек R21..R25 НЕ ЗАФИКСИРОВАНО НИГДЕ - при pull-up к +5 В строки
# всегда '1', матрица нечитаема (второй подозреваемый iron-бага клавиатуры
# v28.7 наряду с RST75); при pull-down к GND схема работает (нажатая
# клавиша подтягивает строку к активной колонке). СВЕРИТЬ ПО СХЕМЕ/
# мультиметром ДО рефита v2.9 (пункт Б-6: rows при поочерёдно активных
# колонках дают 0/1)
# ---------------------------------------------------------------------
NET "col0" LOC = "P44";   # SW1/SW5/SW9/SW13/SW17
NET "col1" LOC = "P43";   # SW2/SW6/SW10/SW14/SW18
NET "col2" LOC = "P42";   # SW3/SW7/SW11/SW15/SW19
NET "col3" LOC = "P41";   # SW4/SW8/SW12/SW16 (SW20 вне матрицы - это RST)
NET "row0" LOC = "P56";   # подтяжка R25, SW1..SW4
NET "row1" LOC = "P55";   # подтяжка R24, SW5..SW8
NET "row2" LOC = "P54";   # подтяжка R23, SW9..SW12
NET "row3" LOC = "P52";   # подтяжка R22, SW13..SW16
NET "row4" LOC = "P51";   # подтяжка R21, SW17..SW19

# ---------------------------------------------------------------------
# ИНДИКАЦИЯ (ОБЩИЙ АНОД: сегменты и разряды - АКТИВНЫЙ 0) И ЗВУК
# О-1 (v2.8.9): seg[7] = dp = '1' = ПОГАС навсегда (было '0' = ГОРЕЛ);
# ЖЕЛЕЗО-ПРОВЕРКА: до первой записи в порт 00h - «----» (dp не светится).
# О-2 + САМОТЕСТ «----» (правка владельца 11-16): dig INIT/сброс = F
# (все 4 разряда) + seg_q INIT = 40h (только сегмент g) -> при включении
# и после кнопки RESET тире в КАЖДОМ разряде до первой записи fw в порты.
# ЦЕНА (осознана владельцем): ~68 мА стока через 4 базы PNP (по ~17 мА
# при 240 Ом) в окне до инициализации fw - это была цена О-2; сегментная
# нагрузка в 7 раз легче «8888» (4 сегмента вместо 28). Альтернатива с
# нулевым окном - самотест силами fw - не применена (fw не меняется).
# РЕВЬЮ Д-3: сегментные резисторы в UCF не перечислены (только R5/R10/
# R11/R12 = 240 Ом в разрядах) - наличие ограничителей сегментов сверить
# по схеме; 240 Ом в базе PNP - в 4-10 раз меньше типового (О-2)
# ---------------------------------------------------------------------
NET "seg<0>" LOC = "P45";  # сегмент a (LD1.11)
NET "seg<1>" LOC = "P62";  # сегмент b (LD1.7)
NET "seg<2>" LOC = "P61";  # сегмент c (LD1.4)
NET "seg<3>" LOC = "P57";  # сегмент d (LD1.2)
NET "seg<4>" LOC = "P58";  # сегмент e (LD1.1)
NET "seg<5>" LOC = "P66";  # сегмент f (LD1.10)
NET "seg<6>" LOC = "P5";   # сегмент g (LD1.5)
NET "seg<7>" LOC = "P60";  # dp (LD1.3): константа '1' = погас (О-1)
NET "dig<0>" LOC = "P6";   # R5 240 -> VT1 -> CA0 (LD1.6)
NET "dig<1>" LOC = "P63";  # R10 240 -> VT2 -> CA1 (LD1.8)
NET "dig<2>" LOC = "P65";  # R11 240 -> VT3 -> CA2 (LD1.9)
NET "dig<3>" LOC = "P48";  # R12 240 -> VT4 -> CA3 (LD1.12)
NET "SND"    LOC = "P67";  # BUZZER1.1 (пассивный), BUZZER1.2 -> R4 -> GND

# ---------------------------------------------------------------------
# PGND (Unused IO Ground), 8 шт - Н-8 п.c: {P74,P76,P78,P79,P81,P95,
# P96,P98}. P74 = TRAP (снят в v2.8), P76 = RST6.5, P78 = RST5.5,
# P79 = INTR, P81 = HOLD, P95/P96/P98 = A16/A17/A18. P73 (SID) и P75
# (RST75) - ВЫХОДЫ, в PGND БЫТЬ НЕ ДОЛЖНЫ. 73 назначенных + 8 = 81.
# Чек-лист RTL п.c теперь требует те же 8.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# ОГРАНИЧЕНИЯ (Д-11, ревью): для CPLD-флоу TIMESPEC декларативен; pin-to-
# pin/OFFSET/SLEW тулчейн для 5В XC9500 не проверяет (SLEW непрограммируем
# на 5В-семействе) - электрические окна закрываются ТОЛЬКО осциллограф-
# чек-листом Б (ревью, приложение Б): dp/ток POR, X2/CLKOUT, WR#(вверх) ->
# ALE(вверх) и -> смена A8..A14, RST-кнопка, rows при активных колонках
# ---------------------------------------------------------------------
NET "clk" TNM_NET = clk;
TIMESPEC TS_clk = PERIOD "clk" 25 MHz HIGH 50%;
