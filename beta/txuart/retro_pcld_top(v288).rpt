FDCPE_shreg2: FDCPE port map (shreg(2),shreg_D(2),clk,'0',NOT wr_seen/wr_seen_RSTF__$INT);
shreg_D(2) <= ((ld_tx_q AND A(1).PIN)
	OR (NOT ld_tx_q AND baud_tick AND shreg(3))
	OR (NOT ld_tx_q AND NOT baud_tick AND shreg(2)));

FDCPE_shreg3: FDCPE port map (shreg(3),shreg_D(3),clk,'0',NOT wr_seen/wr_seen_RSTF__$INT);
shreg_D(3) <= ((ld_tx_q AND A(2).PIN)
	OR (NOT ld_tx_q AND baud_tick AND shreg(4))
	OR (NOT ld_tx_q AND NOT baud_tick AND shreg(3)));

FDCPE_shreg4: FDCPE port map (shreg(4),shreg_D(4),clk,'0',NOT wr_seen/wr_seen_RSTF__$INT);
shreg_D(4) <= ((ld_tx_q AND A(3).PIN)
	OR (NOT ld_tx_q AND baud_tick AND shreg(5))
	OR (NOT ld_tx_q AND NOT baud_tick AND shreg(4)));

FDCPE_shreg5: FDCPE port map (shreg(5),shreg_D(5),clk,'0',NOT wr_seen/wr_seen_RSTF__$INT);
shreg_D(5) <= ((ld_tx_q AND A(4).PIN)
	OR (NOT ld_tx_q AND baud_tick AND shreg(6))
	OR (NOT ld_tx_q AND NOT baud_tick AND shreg(5)));

FDCPE_shreg6: FDCPE port map (shreg(6),shreg_D(6),clk,'0',NOT wr_seen/wr_seen_RSTF__$INT);
shreg_D(6) <= ((ld_tx_q AND A(5).PIN)
	OR (NOT ld_tx_q AND baud_tick AND shreg(7))
	OR (NOT ld_tx_q AND NOT baud_tick AND shreg(6)));

FDCPE_shreg7: FDCPE port map (shreg(7),shreg_D(7),clk,'0',NOT wr_seen/wr_seen_RSTF__$INT);
shreg_D(7) <= ((ld_tx_q AND A(6).PIN)
	OR (NOT ld_tx_q AND baud_tick AND shreg(8))
	OR (NOT ld_tx_q AND NOT baud_tick AND shreg(7)));

FDCPE_shreg8: FDCPE port map (shreg(8),shreg_D(8),clk,'0',NOT wr_seen/wr_seen_RSTF__$INT);
shreg_D(8) <= ((ld_tx_q AND NOT A(7).PIN)
	OR (NOT ld_tx_q AND NOT baud_tick AND NOT shreg(8)));

FDCPE_state_FSM_FFd1: FDCPE port map (state_FSM_FFd1,state_FSM_FFd1_D,clk,NOT wr_seen/wr_seen_RSTF__$INT,'0');
state_FSM_FFd1_D <= ((WRn AND state_FSM_FFd2 AND state_FSM_FFd1 AND wr_seen)
	OR (state_FSM_FFd2 AND state_FSM_FFd1 AND rd_seen AND RDn)
	OR (state_FSM_FFd2 AND state_FSM_FFd3 AND state_FSM_FFd1)
	OR (state_FSM_FFd2 AND state_FSM_FFd1 AND ALE)
	OR (NOT state_FSM_FFd2 AND state_FSM_FFd3 AND NOT state_FSM_FFd1)
	OR (NOT state_FSM_FFd2 AND NOT state_FSM_FFd1 AND NOT ALE));

FDCPE_state_FSM_FFd3: FDCPE port map (state_FSM_FFd3,state_FSM_FFd3_D,clk,NOT wr_seen/wr_seen_RSTF__$INT,'0');
state_FSM_FFd3_D <= ((state_FSM_FFd2 AND NOT state_FSM_FFd1)
	OR (state_FSM_FFd3 AND state_FSM_FFd1));

FTCPE_t0_q: FTCPE port map (t0_q,'1',clk,'0','0');

FTCPE_tmr_cnt0: FTCPE port map (tmr_cnt(0),tmr_cnt_T(0),clk,'0','0');
tmr_cnt_T(0) <= ((NOT tmr_cnt(0) AND NOT wr_seen/wr_seen_RSTF__$INT)
	OR (tmr_wr06 AND NOT tmr_cnt(0) AND A(0).PIN)
	OR (tmr_wr06 AND tmr_cnt(0) AND NOT A(0).PIN AND 
	wr_seen/wr_seen_RSTF__$INT)
	OR (baud_tick AND NOT RST75 AND NOT X1 AND NOT tmr_wr06 AND NOT t0_q AND 
	wr_seen/wr_seen_RSTF__$INT));

FTCPE_tmr_cnt1: FTCPE port map (tmr_cnt(1),tmr_cnt_T(1),clk,'0','0');
tmr_cnt_T(1) <= ((NOT tmr_cnt(1) AND NOT wr_seen/wr_seen_RSTF__$INT)
	OR (tmr_wr06 AND NOT tmr_cnt(1) AND A(1).PIN)
	OR (tmr_wr06 AND tmr_cnt(1) AND NOT A(1).PIN AND 
	wr_seen/wr_seen_RSTF__$INT)
	OR (baud_tick AND NOT RST75 AND NOT X1 AND NOT tmr_wr06 AND NOT t0_q AND 
	NOT tmr_cnt(0) AND wr_seen/wr_seen_RSTF__$INT));

FTCPE_tmr_cnt2: FTCPE port map (tmr_cnt(2),tmr_cnt_T(2),clk,'0','0');
tmr_cnt_T(2) <= ((NOT tmr_cnt(2) AND NOT wr_seen/wr_seen_RSTF__$INT)
	OR (tmr_wr06 AND NOT tmr_cnt(2) AND A(2).PIN)
	OR (tmr_wr06 AND tmr_cnt(2) AND NOT A(2).PIN AND 
	wr_seen/wr_seen_RSTF__$INT)
	OR (baud_tick AND NOT RST75 AND NOT X1 AND NOT tmr_wr06 AND NOT t0_q AND 
	NOT tmr_cnt(0) AND NOT tmr_cnt(1) AND wr_seen/wr_seen_RSTF__$INT));

FTCPE_tmr_cnt3: FTCPE port map (tmr_cnt(3),tmr_cnt_T(3),clk,'0','0');
tmr_cnt_T(3) <= ((NOT tmr_cnt(3) AND NOT wr_seen/wr_seen_RSTF__$INT)
	OR (tmr_wr06 AND NOT tmr_cnt(3) AND A(3).PIN)
	OR (tmr_wr06 AND tmr_cnt(3) AND NOT A(3).PIN AND 
	wr_seen/wr_seen_RSTF__$INT)
	OR (baud_tick AND NOT RST75 AND NOT X1 AND NOT tmr_wr06 AND NOT t0_q AND 
	NOT tmr_cnt(0) AND NOT tmr_cnt(1) AND NOT tmr_cnt(2) AND 
	wr_seen/wr_seen_RSTF__$INT));


tmr_wr06 <= (IOM AND NOT WRn AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND NOT addr_latch(0) AND addr_latch(1) AND addr_latch(2));

FDCPE_wr_seen: FDCPE port map (wr_seen,wr_seen_D,clk,NOT wr_seen/wr_seen_RSTF__$INT,'0');
wr_seen_D <= ((NOT WRn AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND NOT ALE)
	OR (NOT WRn AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1 AND rd_seen AND RDn)
	OR (NOT state_FSM_FFd2 AND wr_seen)
	OR (state_FSM_FFd3 AND wr_seen)
	OR (NOT state_FSM_FFd1 AND wr_seen));

********** UnMapped Logic **********

** Buried Nodes **

FDCPE_state_FSM_FFd2: FDCPE port map (state_FSM_FFd2,state_FSM_FFd2_D,clk,NOT wr_seen/wr_seen_RSTF__$INT,'0');
state_FSM_FFd2_D <= ((NOT state_FSM_FFd2 AND state_FSM_FFd3 AND state_FSM_FFd1)
	OR (NOT state_FSM_FFd2 AND state_FSM_FFd1 AND NOT ALE)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd1 AND NOT wr_seen AND NOT ALE AND 
	NOT RDn)
	OR (NOT WRn AND NOT state_FSM_FFd3 AND state_FSM_FFd1 AND NOT ALE AND 
	NOT RDn)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd1 AND NOT wr_seen AND 
	NOT rd_seen AND NOT ALE)
	OR (NOT WRn AND NOT state_FSM_FFd3 AND state_FSM_FFd1 AND NOT rd_seen AND 
	NOT ALE)
	OR (NOT IOM AND WRn AND A15 AND state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND state_FSM_FFd1 AND wr_seen AND 
	wr_seen/wr_seen_RSTF__$INT));

