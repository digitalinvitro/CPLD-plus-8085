#=====================================================================
# top_txuart.ucf — цоколевка U1 (XC95108-15PQ100C, PQFP-100) для retro_PCLD_board
# Вариант TXUART v2.2 - ИСКЛЮЧИТЕЛЬНО АППАРАТНЫЙ ПЕРЕДАТЧИК UART (директивы
# владельца 11-8/11-8веч и 11-9 «уйти на более простой делитель тактовой»:
# узел /4 на 25 МГц, beta/txuart); НОГИ НЕ МЕНЯЛИСЬ (всё как в v2.0/v2.1);
# ноги =
# hdl/top_suart.ucf 1-в-1 (TX P39 / SOD P72 / SID P73 / RX P38, PGND 9 -
# rx_int НЕТ, P75 = PGND). XC95144 PQ100 попиново 1-в-1 к XC95108 PQ100
# (вердикт миграции 11-8: BSDL-дифф 0 разногласий, даташиты DS066/DS067) -
# UCF БЕЗ ПРАВОК НОГ; в ISE-проекте Device = xc95108-15pq100c (v2.2).
# Источник фактов: SCHEMATIC.md §5 (проверено по нетлисту 126/126 цепей);
# CPU.SID = cpu17 = U1.73 (нога 5), CPU.SOD = cpu18 = U1.72 (нога 4).
# Имена сигналов = имена из hdl/top_suart.v (модуль retro_pcld_top);
# цепи платы — в комментариях.
#
# КАК ПОДКЛЮЧИТЬ (Task 69/70-a): ISE -> Add Source -> этот .ucf; он
# автоматически ассоциируется с топ-модулем retro_pcld_top (Associated
# Source). В Process: Implement Design -> Translate: Keep User Location
# Constraints = ON; в Place & Route: Ground on Unused IOs = ON; в XST:
# Keep Unused Inputs = ON.
#
# Дисциплина (ARCHITECTURE.md §3, решение владельца + Task 69/70-a):
#  - ДЕВЯТЬ держателей '0' (TRAP, RST7.5/6.5/5.5, INTR, HOLD, A16, A17,
#    A18) в HDL NET: их пины (P74, P75, P76, P78, P79, P81, P95, P96,
#    P98) фиттер заземлит опцией "Ground on Unused IOs" = ON — это
#    ЕДИНСТВЕННЫЕ пины, которым разрешено стать PGND (все — входы
#    CPU/flash). P73 (SID) С Task 70-a ВЫХОД CPLD — в PGND БЫТЬ НЕ
#    ДОЛЖНА!
#  - 14 остальных «мёртвых» пинов объявлены ВХОДАМИ в HDL ((* keep *)),
#    чтобы опция их НЕ заземлила: там выходы CPU, X2 (GND запрещён
#    даташитом). В cpldfit также включить "Keep Unused Inputs: ON"
#    (следить за Xst:3005 в логе XST).
#  - RX (P38) - РЕАЛЬНЫЙ вход с нагрузкой (транзит SID, Task 70-a).
#    SOD (P72) - вход-НАБЛЮДАТЕЛЬ БЕЗ нагрузки (транзит SOD->TX выпилен,
#    п.27 шапки): keep обязателен. ЗАЗЕМЛЯТЬ НЕЛЬЗЯ: P38/P72 — выходы
#    CH340G/CPU соответственно.
#  - READY (P87), CS1 (P99) — выходы константы '1' в HDL (авто-VCC у
#    фиттера нет, но константные выходы он реализует НОГОЙ — доказано
#    фитами: заземление = CPU в вечном wait / ОЗУ отвалится);
#  - чек-лист .rpt: PGND == ровно {P74,P75,P76,P78,P79,P81,P95,P96,P98}
#    (9 шт!); входы на местах (INP), включая SOD P72 (наблюдатель) и
#    RX P38; Keep User Location Constraints: ON; GCK3 = P29, GSR = P1;
#    GSR : 1 или fallback (класс п.25); MC 111-113/144 (прогноз п.31
#    шапки TXUART v2.0; УСТРОЙСТВО xc95144-15pq100c!); кольцо r0..r6 в
#    FB - п.32d чек-листа.
#=====================================================================

#---- такт и сброс ----
NET "clk"  LOC = "P29";    # GCK3, цепь clk: 25 МГц (v2.2, H1 С ШУНТОМ - DIV=/4 генератора U7; ОБЯЗАТЕЛЕН - БЕЗ шунта 50 МГц ЗАПРЕЩЕНО) -> кольцо s0..s3 -> X1 = 6,25 МГц (duty 1/4) -> CPU 3,125 МГц
NET "RST"  LOC = "P1";     # GSTR, цепь RST: SW20; покой = 0, нажатие = 1 (актив.1 — доказано платой, Task 25; противоречие с нетлистом — см. SCHEMATIC.md §6)
# ПРИМЕЧАНИЕ GSR (v2.0 = база v3.9.8-clear п.18/20/21): сброс ЛОГИКИ и
# ЯДРА TXUART - асинхронный по cpu_rst = rst_press | por_run через СЕТЬ
# GSR (ожидаются «GSR : 1» или fallback PT-сбросов - класс п.25, на
# разбор); сырой RST (P1) входит ТОЛЬКО в синхронизатор rst_meta.
# Проверить в отчёте фиттера (Task 25/68-f, чек-лист п.32c шапки RTL).

#---- шина i8085: управление (ZIF-сокет U3, цепи cpuN) ----
NET "ALE"  LOC = "P93";    # cpu1, ALE(30)
NET "WRn"  LOC = "P92";    # cpu2, WR#(31)
NET "RDn"  LOC = "P91";    # cpu3, RD#(32)
NET "IOM"  LOC = "P88";    # cpu5, IO/M#(34)
NET "A15"  LOC = "P97";    # цепь A15 (декод памяти)

#---- мультиплексированная шина AD0-AD7 (цепи A0..A7, bidir) ----
NET "A<0>" LOC = "P26";    # цепь A0
NET "A<1>" LOC = "P21";    # цепь A1
NET "A<2>" LOC = "P19";    # цепь A2
NET "A<3>" LOC = "P17";    # цепь A3
NET "A<4>" LOC = "P15";    # цепь A4
NET "A<5>" LOC = "P13";    # цепь A5
NET "A<6>" LOC = "P11";    # цепь A6
NET "A<7>" LOC = "P9";     # цепь A7

#---- шина данных памяти (цепи D0..D7, bidir) ----
NET "D<0>" LOC = "P30";    # цепь D0
NET "D<1>" LOC = "P32";    # цепь D1
NET "D<2>" LOC = "P35";    # цепь D2
NET "D<3>" LOC = "P36";    # цепь D3
NET "D<4>" LOC = "P34";    # цепь D4
NET "D<5>" LOC = "P31";    # цепь D5
NET "D<6>" LOC = "P27";    # цепь D6
NET "D<7>" LOC = "P22";    # цепь D7

#---- управление памятью ----
NET "CSr_n" LOC = "P20";   # цепь #CSr  -> U10.22 (flash /CE)
NET "OEr_n" LOC = "P16";   # цепь #OEr  -> U10.24 (flash /OE)
NET "CS_n"  LOC = "P25";   # цепь #CS   -> U4.22  (SRAM /CE)
NET "OE_n"  LOC = "P37";   # цепь #OE   -> U4.24  (SRAM /OE)
NET "WE_n"  LOC = "P24";   # цепь #WE   -> U4.29  (SRAM /WE, только writeback)
NET "CS1"   LOC = "P99";   # цепь CS    -> U4.30  (SRAM CE2, константа '1')

#---- поддержка процессора ----
NET "X1"         LOC = "P68";  # cpu21, X1(1), 6,25 МГц = 25/4 (v2.2: КОЛЬЦО one-hot s0..s3 на clk 25, X1 = s0, duty 1/4); CPU = 3,125 МГц
NET "READY"      LOC = "P87";  # cpu6,  READY(35) = '1' — КРИТИЧНО, иначе вечные wait
NET "RESET_IN"   LOC = "P84";  # cpu7,  RESET IN#(36) = регистр reset_q (п.21d базы: INIT=0 - CPU в сбросе с t=0; снятие чистым фронтом), активный 0 по даташиту 8085A (Task 25)

#---- UART: RX-транзит + TXUART (Task 70-a; v2.0 п.27) ----
NET "RX"  LOC = "P38";     # вход: U1.38 <- цепь платы «TX» (CH340G.TXD); транзит в SID; ЗАЗЕМЛЯТЬ НЕЛЬЗЯ (выход CH340G)!
NET "TX"  LOC = "P39";     # выход: U1.39 -> цепь платы «RX» (CH340G.RXD); TX = shreg[0] (ядро TXUART: OUT 04h, 1 562 500 8N1)
NET "SOD" LOC = "P72";     # вход: cpu18, SOD(4) — CPU.SOD; транзит УДАЛЁН (п.27) - наблюдатель БЕЗ нагрузки, keep обязателен; ЗАЗЕМЛЯТЬ НЕЛЬЗЯ (выход CPU)!
NET "SID" LOC = "P73";     # выход: cpu17, SID(5) — CPU.SID; транзит RX; РАНЕЕ PGND (до Task 70-a) — теперь ВЫХОД CPLD!

#---- входы-наблюдатели: CPU-выходы и X2 (объявлены входами, НЕ заземлять!) ----
NET "X2"     LOC = "P69";  # cpu20, X2(2): второй вывод генератора — GND запрещён даташитом
NET "RSTOUT" LOC = "P70";  # cpu19, RESET OUT(3)
NET "INTAn"  LOC = "P80";  # cpu11, INTA#(11)
NET "HLDA"   LOC = "P82";  # cpu9,  HLDA(38)
NET "CLKOUT" LOC = "P83";  # cpu8,  CLK OUT(37)
NET "S0"     LOC = "P94";  # cpu0,  S0(29)
NET "S1"     LOC = "P89";  # cpu4,  S1(33)
NET "AH8"    LOC = "P10";  # цепь A8,  нога 21 — адрес памяти, наблюдатель
NET "AH9"    LOC = "P12";  # цепь A9,  нога 22
NET "AH10"   LOC = "P18";  # цепь A10, нога 23
NET "AH11"   LOC = "P14";  # цепь A11, нога 24
NET "AH12"   LOC = "P4";   # цепь A12, нога 25
NET "AH13"   LOC = "P8";   # цепь A13, нога 26
NET "AH14"   LOC = "P3";   # цепь A14, нога 27

#---- клавиатура (наблюдатели; этап 2 задействует в сканировании) ----
NET "col0" LOC = "P44";   # SW1/SW5/SW9/SW13/SW17
NET "col1" LOC = "P43";   # SW2/SW6/SW10/SW14/SW18
NET "col2" LOC = "P42";   # SW3/SW7/SW11/SW15/SW19
NET "col3" LOC = "P41";   # SW4/SW8/SW12/SW16 (SW20 вне матрицы: SW20.1->RST, SW20.3/4->GND)
NET "row0" LOC = "P56";   # R25 подтяжка, SW1
NET "row1" LOC = "P55";   # R24, SW5
NET "row2" LOC = "P54";   # R23, SW9
NET "row3" LOC = "P52";   # R22, SW13
NET "row4" LOC = "P51";   # R21, SW17

#---- индикация и звук ----
NET "seg<0>" LOC = "P45";  # цепь a    -> LD1.11
NET "seg<1>" LOC = "P62";  # цепь b    -> LD1.7
NET "seg<2>" LOC = "P61";  # цепь c    -> LD1.4
NET "seg<3>" LOC = "P57";  # цепь d    -> LD1.2
NET "seg<4>" LOC = "P58";  # цепь e    -> LD1.1
NET "seg<5>" LOC = "P66";  # цепь f    -> LD1.10
NET "seg<6>" LOC = "P5";   # цепь g    -> LD1.5
NET "seg<7>" LOC = "P60";  # цепь dp56 -> LD1.3
NET "dig<0>" LOC = "P6";   # цепь dig0 -> R5  240 -> VT1 -> CA0 (LD1.6)
NET "dig<1>" LOC = "P63";  # цепь dig1 -> R10 240 -> VT2 -> CA1 (LD1.8)
NET "dig<2>" LOC = "P65";  # цепь dig2 -> R11 240 -> VT3 -> CA2 (LD1.9)
NET "dig<3>" LOC = "P48";  # цепь dig3 -> R12 240 -> VT4 -> CA3 (LD1.12)
NET "SND"    LOC = "P67";  # цепь SND  -> BUZZER1.1 (пассивный); BUZZER1.2 -> R4 -> GND

#---- тайминг-констрейнт (v2.2: вход 25 МГц, H1 С ШУНТОМ) ----
# 25 МГц на входе CPLD (H1 С ШУНТОМ, DIV=/4 U7; ОБЯЗАТЕЛЬНО - БЕЗ шунта
# 25,00 МГц - Task 29-d); HIGH 50% - запас по duty входного такта;
# логика - ОДИН домен clk 25 МГц (v2.2, п.23/34); для CPLD TIMESPEC
# информационный - f_max считает фиттер (чек-лист п.32g: логика 25 МГц
# должна закрыться)
#Created by Constraints Editor (xc95108-pq100-15) - 2026/10/21; v2.2: период 25 МГц, устройство xc95108
NET "clk" TNM_NET = clk;
TIMESPEC TS_clk = PERIOD "clk" 25 MHz HIGH 50%;
