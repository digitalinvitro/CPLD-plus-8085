    1            ; =====================================================================
    2            ; beta/txuart/rom -- monitor27: монитор для платы v2.7 (beta/txuart)
    3            ;
    4            ; База: fw_mon v5 (beta/lowsize/rom, клавиатурный монитор "ACDE").
    5            ; Отличия от v5 (платформа v2.7, CPLD top_txuart_por6_v27):
    6            ;   1. ВЕКТОРА 0008h-003Fh = глушилки EI;RET. На v2.7 CPLD выдаёт на
    7            ;      ногу TRAP (P74) квадрат 128 мкс (64/64) = 7,8125 кГц (tick_q).
    8            ;      TRAP немаскируем: DI не помогает. Без обработчика первый же фронт
    9            ;      уводит CPU на 0024h, где у v5 лежала таблица GTBL -> "8.8.8.8.".
   10            ;      EI в глушилке ОБЯЗАТЕЛЕН: после приёма TRAP новые TRAP блокируются
   11            ;      до EI (п.36 даташита; без EI тик-система глохнет после 1-го тика).
   12            ;      Пользовательские программы защищены автоматически: глушилки в ROM.
   13            ;   2. Таблицы перенесены с 0003h на 0044h (освобождена векторная зона).
   14            ;   3. Тайминг под 2,5 МГц (T = 400 нс; lowsize был 3,571 МГц):
   15            ;      K_MS = 104 (~1,0 мс/единица; итерация DCX/MOV/ORA/JNZ = 24T).
   16            ;   4. NEW: приём по SID 4800 8N1 (RIM, транзит RX->SID в CPLD) -
   17            ;      Intel HEX загрузчик (клавиша B в меню). Код RXD = мануал
   18            ;      (programming manual, фрагменты 5/7): PAUSE 6 мкс/итер, полбита
   19            ;      N=15, бит N=30 - числа железо-проверены эхо-прошивками.
   20            ;   5. NEW: передача через CPLD OUT 04h @ 1 000 000 8N1 (сериализатор
   21            ;      v2.7; TXRDY = IN 05h бит A1, остальные биты 0). Баннер при
   22            ;      старте. ВНИМАНИЕ: мост CH340G = ОДНА скорость на оба направления;
   23            ;      терминал 4800 -> загрузка HEX работает, баннер = короткий мусор
   24            ;      (~8 байт); терминал 1M -> баннер читается, вставка HEX не ловится
   25            ;      (приём программный, 2,5 МГц CPU не успевает за 1 мкс/бит).
   26            ;   6. NEW: RAM-тест 8000h-FFE7h (клавиша F в меню), 4 паттерна.
   27            ;   7. SOD (SIM) НЕ используется: на v2.7 транзит SOD->TX выпилен
   28            ;      (TX = только сериализатор CPLD); RIM - только для приёма SID.
   29            ;
   30            ; СБОРКА (asm85.py, кодировка CP1251):
   31            ;   python3 asm85.py monitor27.asm -o monitor27.hex -l monitor27.lst
   32            ;   (asm85.py лежит в beta/lowsize/rom; из этого каталога:
   33            ;    python3 ../../lowsize/rom/asm85.py monitor27.asm -o monitor27.hex -l monitor27.lst)
   34            ; Прошивка: flash A29040B, offset 0000h (ROM-окно 0000h-7FFFh).
   35            ;
   36            ; КЛАВИАТУРА (как v5): тетрады 0-F + Enter + F1(меню) + F2(показ адреса);
   37            ; ДОБАВЛЕНО в меню: B (0Bh) = загрузчик Intel HEX через SID 4800,
   38            ; F (0Fh) = RAM-тест. Дисплей в режимах B/F - статический (скан остановлен,
   39            ; все 4 разряда = один глиф: LLLL / 0000 / FFFF / 5555 / AAAA / EEEE).
   40            ; Выход из залипшего режима - RESET (SW20), как в v5.
   41            ;
   42            ; ОЗУ: переменные FFE8h-FFFFh, стек с FFE7h вниз (SP0 = FFE8h).
   43            ; Новые переменные загрузчика: FFFAh-FFFFh; адрес записи - в ADDRH/L
   44            ; (на дисплее после загрузки - последний адрес записи).
   45            ; =====================================================================
   46            
   47            ; ---- порты CPLD (декод по A2-A0, зеркала mod 8) ----
   48            SEGP    EQU 00h             ; сегменты: D0=a..D6=g, D7=dp; 1 = горит
   49            DIGP    EQU 01h             ; D3-D0 разряды, D4 = SND
   50            KBCOLP  EQU 02h             ; D3-D0 колонки (1 = заведена)
   51            KBROWP  EQU 03h             ; D4-D0 ряды (1 = нажата в активной колонке)
   52            TXP     EQU 04h             ; OUT: TXDATA -> сериализатор CPLD (1M 8N1)
   53            STP     EQU 05h             ; IN: статус, бит A1 = TXRDY (1 = готов)
   54            
   55            ; ---- константы тайминга (CPU 2,5 МГц, T = 400 нс) ----
   56            K_MS    EQU 104             ; единица ~1,0 мс (104 x 24T x 400 нс)
   57            TICK_MS EQU 15              ; тик клавиши ~15 мс (v5: 30 @3,57 МГц)
   58            SET_MS  EQU 15              ; дебаунс отпускания ~15 мс (v5: 30)
   59            RXHB    EQU 15              ; полбита 4800 (PAUSE-итераций, ~103 мкс)
   60            RXFB    EQU 30              ; бит приёма 4800 (PAUSE-итераций, ~211 мкс)
   61            
   62            ; ---- коды клавиш ----
   63            K_ENT   EQU 10h             ; Enter  (row3/col3, SW16)
   64            K_F1    EQU 11h             ; F1     (row4/col1, SW18) - меню
   65            K_F2    EQU 12h             ; F2     (row4/col2, SW19) - показ адреса
   66            K_NONE  EQU 0FFh            ; пустая позиция матрицы
   67            
   68            ; ---- состояния ----
   69            ST_MENU EQU 00h             ; меню "ACDE" (B = загрузчик, F = RAM-тест)
   70            ST_ADDR EQU 01h             ; ввод адреса
   71            ST_PROG EQU 02h             ; ввод кода (Code)
   72            ST_VIEW EQU 03h             ; просмотр кода
   73            ST_SHOW EQU 04h             ; показ адреса операций (F2)
   74            
   75            ; ---- ОЗУ монитора ----
   76            SP0     EQU 0FFE8h          ; SP монитора
   77            SNDST   EQU 0FFE8h          ; состояние тона 0/1
   78            STATE   EQU 0FFE9h          ; 0=меню, 1=адрес, 2=код, 3=просмотр, 4=показ
   79            ADDRH   EQU 0FFEAh          ; текущий адрес (старший); в загрузчике = адрес записи
   80            ADDRL   EQU 0FFEBh          ; текущий адрес (младший)
   81            ADCNT   EQU 0FFECh          ; тетрады адреса (0..4); в загрузчике = счётчик байт данных
   82            AF3     EQU 0FFEDh          ; тетрады адреса
   83            AF2     EQU 0FFEEh
   84            AF1     EQU 0FFEFh
   85            AF0     EQU 0FFF0h
   86            BDCNT   EQU 0FFF1h          ; введено тетрад байта (0..2)
   87            BF1     EQU 0FFF2h
   88            BF0     EQU 0FFF3h
   89            DPIDX   EQU 0FFF4h          ; фаза регенерации 0..3
   90            DIGIMG  EQU 0FFF5h          ; глифы разрядов DIG0..DIG3
   91            DIGIMG0 EQU 0FFF5h
   92            DIGIMG1 EQU 0FFF6h
   93            DIGIMG2 EQU 0FFF7h
   94            DIGIMG3 EQU 0FFF8h
   95            PREVST  EQU 0FFF9h          ; прежний режим для F2
   96            ; --- новые: парсер Intel HEX (загрузчик B) ---
   97            LST     EQU 0FFFAh          ; состояние: 0=ждём ':' 1=count 2=addr 3=type 4=data 5=chk
   98            LNIB    EQU 0FFFBh          ; осталось тетрад в текущем байте поля (1..2)
   99            LBPC    EQU 0FFFCh          ; осталось байт в текущем поле
  100            LACC    EQU 0FFFDh          ; накопитель тетрад текущего байта
  101            LSUM    EQU 0FFFEh          ; сумма байт записи (mod 256) для контроля
  102            LTY     EQU 0FFFFh          ; тип последней записи (00 = данные, 01 = конец)
  103            
  104            ; =====================================================================
  105  0000: -                ORG 0000h
  106  0000: C3 DD 04         JMP START
  107            
  108            ; ---- векторная зона: глушилки EI;RET -------------------------------
  109            ; RST 1..7, TRAP (0024h), RST 5.5/6.5/7.5. EI обязателен в каждой:
  110            ; снимает блокировку TRAP после приёма. Маскируемые (5.5/6.5/7.5/INTR)
  111            ; железно=0 (PGND), EI для них безопасен. Формат: F3 C9.
  112  0008: -                ORG 0008h           ; RST 1
  113  0008: FB               EI
  114  0009: C9               RET
  115  0010: -                ORG 0010h           ; RST 2
  116  0010: FB               EI
  117  0011: C9               RET
  118  0018: -                ORG 0018h           ; RST 3
  119  0018: FB               EI
  120  0019: C9               RET
  121  0020: -                ORG 0020h           ; RST 4
  122  0020: FB               EI
  123  0021: C9               RET
  124  0024: -                ORG 0024h           ; TRAP - ГЛАВНАЯ глушилка (тик CPLD 7,8125 кГц)
  125  0024: FB               EI
  126  0025: C9               RET
  127  0028: -                ORG 0028h           ; RST 5
  128  0028: FB               EI
  129  0029: C9               RET
  130  002C: -                ORG 002Ch           ; RST 5.5
  131  002C: FB               EI
  132  002D: C9               RET
  133  0030: -                ORG 0030h           ; RST 6
  134  0030: FB               EI
  135  0031: C9               RET
  136  0034: -                ORG 0034h           ; RST 6.5
  137  0034: FB               EI
  138  0035: C9               RET
  139  0038: -                ORG 0038h           ; RST 7
  140  0038: FB               EI
  141  0039: C9               RET
  142  003C: -                ORG 003Ch           ; RST 7.5
  143  003C: FB               EI
  144  003D: C9               RET
  145            
  146            ; =====================================================================
  147            ; Таблицы (ORG 0044h - векторная зона выше освобождена)
  148            ; =====================================================================
  149  0044: -                ORG 0044h
  150            ; ---- глифы '0'..'F' (a,b,c,d,e,f,g = D0..D6) ----
  151  0044: 3F       GTBL:   DB 3Fh              ; '0'
  152  0045: 06               DB 06h              ; '1'
  153  0046: 5B               DB 5Bh              ; '2'
  154  0047: 4F               DB 4Fh              ; '3'
  155  0048: 66               DB 66h              ; '4'
  156  0049: 6D               DB 6Dh              ; '5'
  157  004A: 7D               DB 7Dh              ; '6'
  158  004B: 07               DB 07h              ; '7'
  159  004C: 7F               DB 7Fh              ; '8'
  160  004D: 6F               DB 6Fh              ; '9'
  161  004E: 77               DB 77h              ; 'A'
  162  004F: 7C               DB 7Ch              ; 'b'
  163  0050: 39               DB 39h              ; 'C'
  164  0051: 5E               DB 5Eh              ; 'd'
  165  0052: 79               DB 79h              ; 'E'
  166  0053: 71               DB 71h              ; 'F'
  167            
  168            ; ---- биты разрядов (индекс = DPIDX: 0=DIG0 правый ... 3=DIG3 левый) ----
  169  0054: 01 02 04 08 BITTBL: DB 01h,02h,04h,08h
  170            
  171            ; ---- КАРТА КЛАВИШ: KEYTBL[row*4+col] ----
  172  0058: 0A 0B 0C 0D KEYTBL: DB 0Ah,0Bh,0Ch,0Dh  ; row0: A  B  C  D
  173  005C: 07 08 09 0E         DB 07h,08h,09h,0Eh  ; row1: 7  8  9  E
  174  0060: 04 05 06 0F         DB 04h,05h,06h,0Fh  ; row2: 4  5  6  F
  175  0064: 01 02 03 10         DB 01h,02h,03h,10h  ; row3: 1  2  3  Enter
  176  0068: 00 11 12 FF         DB 00h,11h,12h,0FFh ; row4: 0  F1 F2 (нет)
  177            
  178            ; ---- баннер TX @1M (на терминале 4800 = короткая мусорная строка) ----
  179  006C: 4D 4F 4E 32 37 0D 0A 00 TXBAN:  DB 4Dh,4Fh,4Eh,32h,37h,0Dh,0Ah,00h   ; "MON27\r\n"
  180            
  181            ; ---- паттерны RAM-теста: значение + глиф для статического дисплея ----
  182  0074: 00 3F    RAMPAT: DB 00h,3Fh          ; 00h -> "0000"
  183  0076: FF 71            DB 0FFh,71h         ; FFh -> "FFFF"
  184  0078: 55 6D            DB 55h,6Dh          ; 55h -> "5555"
  185  007A: AA 77            DB 0AAh,77h         ; AAh -> "AAAA"
  186            
  187            ; =====================================================================
  188            ; Системные процедуры (перенос из fw_mon v5, константы под 2,5 МГц)
  189            ; =====================================================================
  190  0100: -                ORG 0100h
  191            
  192            ; ---------------------------------------------------------------------
  193            ; SETTLE: пауза ~36 мкс (LXI+3 итерации 24T @400 нс; установка рядов
  194            ; после заведения колонки). Портит A/B/C.
  195            ; ---------------------------------------------------------------------
  196  0100: 01 03 00 SETTLE: LXI B,3
  197  0103: 0B       STL:    DCX B
  198  0104: 78               MOV A,B
  199  0105: B1               ORA C
  200  0106: C2 03 01         JNZ STL
  201  0109: C9               RET
  202            
  203            ; ---------------------------------------------------------------------
  204            ; SCANALL: опрос всех 4 колонок; A = ИЛИ рядов (0 = нажатий нет);
  205            ; колонки на выходе погашены. Портит A/B/C/D/E.
  206            ; ---------------------------------------------------------------------
  207  010A: AF       SCANALL: XRA A
  208  010B: 5F               MOV E,A             ; E = накопитель
  209  010C: 16 01            MVI D,01h           ; D = бит колонки
  210  010E: 7A       SAL1:   MOV A,D
  211  010F: D3 02            OUT KBCOLP
  212  0111: CD 00 01         CALL SETTLE
  213  0114: DB 03            IN KBROWP
  214  0116: E6 1F            ANI 1Fh
  215  0118: B3               ORA E
  216  0119: 5F               MOV E,A
  217  011A: 7A               MOV A,D
  218  011B: 07               RLC
  219  011C: 57               MOV D,A
  220  011D: FE 10            CPI 10h
  221  011F: C2 0E 01         JNZ SAL1
  222  0122: AF               XRA A
  223  0123: D3 02            OUT KBCOLP
  224  0125: 7B               MOV A,E
  225  0126: C9               RET
  226            
  227            ; ---------------------------------------------------------------------
  228            ; REFRESH: один слот регенерации. ГАШЕНИЕ -> РАЗРЯД -> ГЛИФ (как v5,
  229            ; без послесвечения). DIGIMG[DPIDX] на разряд DPIDX. Бит D4 (SND)
  230            ; уносится записью DIGP - дисплей при тоне не гаснет.
  231            ; Портит A/B/C/H/L (D/E - бит колонки и индекс скана - НЕ трогает).
  232            ; ---------------------------------------------------------------------
  233  0127: 3A F4 FF REFRESH: LDA DPIDX
  234  012A: 4F               MOV C,A             ; C = индекс 0..3
  235  012B: 06 00            MVI B,0
  236  012D: 21 54 00         LXI H,BITTBL
  237  0130: 09               DAD B
  238  0131: 46               MOV B,M             ; B = бит разряда (01,02,04,08)
  239  0132: 21 F5 FF         LXI H,DIGIMG        ; HL = DIGIMG + DPIDX (цикл вместо ADD)
  240  0135: 79       RFIL:   MOV A,C
  241  0136: B7               ORA A
  242  0137: CA 3F 01         JZ RFGD
  243  013A: 2C               INR L
  244  013B: 0D               DCR C
  245  013C: C3 35 01         JMP RFIL
  246  013F: 4E       RFGD:   MOV C,M             ; C = глиф разряда
  247  0140: 3A E8 FF         LDA SNDST
  248  0143: B7               ORA A
  249  0144: CA 4B 01         JZ RFN
  250  0147: 78               MOV A,B
  251  0148: F6 10            ORI 10h
  252  014A: 47               MOV B,A             ; B |= SND
  253  014B: AF       RFN:    XRA A
  254  014C: D3 00            OUT SEGP            ; (1) гашение: старый разряд погас
  255  014E: 78               MOV A,B
  256  014F: D3 01            OUT DIGP            ; (2) разряд переключён (сегменты пусты)
  257  0151: 79               MOV A,C
  258  0152: D3 00            OUT SEGP            ; (3) зажгли глиф нового разряда
  259  0154: 3A F4 FF         LDA DPIDX
  260  0157: 3C               INR A
  261  0158: E6 03            ANI 03h
  262  015A: 32 F4 FF         STA DPIDX
  263  015D: C9               RET
  264            
  265            ; ---------------------------------------------------------------------
  266            ; BUNIT: единица ~1,03 мс (104 итерации 24T) + тоггл SNDST + регенерация
  267            ; QUNIT: единица ~1,03 мс без звука, дисплей живёт
  268            ; ---------------------------------------------------------------------
  269  015E: 01 68 00 BUNIT:  LXI B,K_MS
  270  0161: 0B       BUL:    DCX B
  271  0162: 78               MOV A,B
  272  0163: B1               ORA C
  273  0164: C2 61 01         JNZ BUL
  274  0167: 3A E8 FF         LDA SNDST
  275  016A: EE 01            XRI 01h
  276  016C: 32 E8 FF         STA SNDST
  277  016F: CD 27 01         CALL REFRESH
  278  0172: C9               RET
  279            
  280  0173: 01 68 00 QUNIT:  LXI B,K_MS
  281  0176: 0B       QUL:    DCX B
  282  0177: 78               MOV A,B
  283  0178: B1               ORA C
  284  0179: C2 76 01         JNZ QUL
  285  017C: CD 27 01         CALL REFRESH
  286  017F: C9               RET
  287            
  288            ; ---------------------------------------------------------------------
  289            ; TICKON: короткий тик подтверждения клавиши (TICK_MS единиц ~1 мс,
  290            ; тон ~500 Гц). Счётчик - В DE: REFRESH портит HL, но гарантирует D/E.
  291            ; ---------------------------------------------------------------------
  292  0180: 11 0F 00 TICKON: LXI D,TICK_MS       ; тик клавиши (единицы ~1,03 мс)
  293  0183: CD 5E 01 TK1:    CALL BUNIT
  294  0186: 1B               DCX D
  295  0187: 7A               MOV A,D
  296  0188: B3               ORA E
  297  0189: C2 83 01         JNZ TK1
  298  018C: AF               XRA A
  299  018D: 32 E8 FF         STA SNDST           ; тон гарантированно погашен
  300  0190: C9               RET
  301            
  302            ; ---------------------------------------------------------------------
  303            ; GLOOK: A = тетрада 0..F -> A = глиф (GTBL). Портит A/B/C/H/L.
  304            ; ---------------------------------------------------------------------
  305  0191: 4F       GLOOK:  MOV C,A
  306  0192: 06 00            MVI B,0
  307  0194: 21 44 00         LXI H,GTBL
  308  0197: 09               DAD B
  309  0198: 7E               MOV A,M
  310  0199: C9               RET
  311            
  312            ; ---------------------------------------------------------------------
  313            ; REDRAW: пересобрать DIGIMG[0..3] по состоянию (как v5).
  314            ;   меню : "ACDE"; адрес: тетрады вдвигаются справа; код "__C3";
  315            ;   просмотр: [ADDR] в правых разрядах; показ(F2): ADDR на 4 разрядах.
  316            ; ---------------------------------------------------------------------
  317  019A: 3A E9 FF REDRAW: LDA STATE
  318  019D: B7               ORA A
  319  019E: CA 3F 02         JZ RDM
  320  01A1: FE 01            CPI 01h
  321  01A3: CA 56 02         JZ RDA
  322  01A6: FE 03            CPI 03h
  323  01A8: CA E1 01         JZ RDV
  324  01AB: FE 04            CPI 04h
  325  01AD: CA 0A 02         JZ RDW
  326                    ; ---- ST_PROG ----
  327  01B0: AF               XRA A
  328  01B1: 32 F8 FF         STA DIGIMG3
  329  01B4: 32 F7 FF         STA DIGIMG2
  330  01B7: 32 F6 FF         STA DIGIMG1
  331  01BA: 32 F5 FF         STA DIGIMG0
  332  01BD: 3A F1 FF         LDA BDCNT
  333  01C0: FE 02            CPI 02h
  334  01C2: DA CE 01         JC RDPR0            ; <2 - старшая тетрада пуста
  335  01C5: 3A F2 FF         LDA BF1
  336  01C8: CD 91 01         CALL GLOOK
  337  01CB: 32 F6 FF         STA DIGIMG1
  338  01CE: 3A F1 FF RDPR0:  LDA BDCNT
  339  01D1: B7               ORA A
  340  01D2: CA A7 02         JZ RDRE             ; 0 - младшая тоже пуста
  341  01D5: 3A F3 FF         LDA BF0
  342  01D8: CD 91 01         CALL GLOOK
  343  01DB: 32 F5 FF         STA DIGIMG0
  344  01DE: C3 A7 02         JMP RDRE
  345  01E1: 3A EA FF RDV:    LDA ADDRH           ; ---- ST_VIEW: [ADDR] в правых разрядах ----
  346  01E4: 67               MOV H,A
  347  01E5: 3A EB FF         LDA ADDRL
  348  01E8: 6F               MOV L,A             ; HL = ADDR
  349  01E9: 7E               MOV A,M             ; A = [ADDR] (HL>=8000h - ОЗУ)
  350  01EA: 57               MOV D,A             ; D = байт (GLOOK портит B)
  351  01EB: 0F               RRC
  352  01EC: 0F               RRC
  353  01ED: 0F               RRC
  354  01EE: 0F               RRC
  355  01EF: E6 0F            ANI 0Fh             ; старшая тетрада
  356  01F1: CD 91 01         CALL GLOOK
  357  01F4: 32 F6 FF         STA DIGIMG1
  358  01F7: 7A               MOV A,D
  359  01F8: E6 0F            ANI 0Fh             ; младшая тетрада
  360  01FA: CD 91 01         CALL GLOOK
  361  01FD: 32 F5 FF         STA DIGIMG0
  362  0200: AF               XRA A
  363  0201: 32 F8 FF         STA DIGIMG3
  364  0204: 32 F7 FF         STA DIGIMG2
  365  0207: C3 A7 02         JMP RDRE
  366  020A: 3A EA FF RDW:    LDA ADDRH           ; ---- ST_SHOW: ADDR на 4 разрядах ----
  367  020D: 57               MOV D,A             ; D = старший байт (GLOOK портит B)
  368  020E: 0F               RRC
  369  020F: 0F               RRC
  370  0210: 0F               RRC
  371  0211: 0F               RRC
  372  0212: E6 0F            ANI 0Fh
  373  0214: CD 91 01         CALL GLOOK
  374  0217: 32 F8 FF         STA DIGIMG3
  375  021A: 7A               MOV A,D
  376  021B: E6 0F            ANI 0Fh
  377  021D: CD 91 01         CALL GLOOK
  378  0220: 32 F7 FF         STA DIGIMG2
  379  0223: 3A EB FF         LDA ADDRL
  380  0226: 57               MOV D,A
  381  0227: 0F               RRC
  382  0228: 0F               RRC
  383  0229: 0F               RRC
  384  022A: 0F               RRC
  385  022B: E6 0F            ANI 0Fh
  386  022D: CD 91 01         CALL GLOOK
  387  0230: 32 F6 FF         STA DIGIMG1
  388  0233: 7A               MOV A,D
  389  0234: E6 0F            ANI 0Fh
  390  0236: CD 91 01         CALL GLOOK
  391  0239: 32 F5 FF         STA DIGIMG0
  392  023C: C3 A7 02         JMP RDRE
  393  023F: 3E 77    RDM:    MVI A,77h           ; 'A'
  394  0241: 32 F8 FF         STA DIGIMG3
  395  0244: 3E 39            MVI A,39h           ; 'C'
  396  0246: 32 F7 FF         STA DIGIMG2
  397  0249: 3E 5E            MVI A,5Eh           ; 'd' (D)
  398  024B: 32 F6 FF         STA DIGIMG1
  399  024E: 3E 79            MVI A,79h           ; 'E'
  400  0250: 32 F5 FF         STA DIGIMG0
  401  0253: C3 A7 02         JMP RDRE
  402  0256: AF       RDA:    XRA A               ; ---- ST_ADDR: последняя тетрада справа ----
  403  0257: 32 F8 FF         STA DIGIMG3
  404  025A: 32 F7 FF         STA DIGIMG2
  405  025D: 32 F6 FF         STA DIGIMG1
  406  0260: 32 F5 FF         STA DIGIMG0
  407  0263: 3A EC FF         LDA ADCNT
  408  0266: FE 01            CPI 01h
  409  0268: DA A7 02         JC RDRE             ; 0 тетрад - всё пусто
  410  026B: 3A F0 FF         LDA AF0
  411  026E: CD 91 01         CALL GLOOK
  412  0271: 32 F5 FF         STA DIGIMG0
  413  0274: 3A EC FF         LDA ADCNT
  414  0277: FE 02            CPI 02h
  415  0279: DA A7 02         JC RDRE
  416  027C: 3A EF FF         LDA AF1
  417  027F: CD 91 01         CALL GLOOK
  418  0282: 32 F6 FF         STA DIGIMG1
  419  0285: 3A EC FF         LDA ADCNT
  420  0288: FE 03            CPI 03h
  421  028A: DA A7 02         JC RDRE
  422  028D: 3A EE FF         LDA AF2
  423  0290: CD 91 01         CALL GLOOK
  424  0293: 32 F7 FF         STA DIGIMG2
  425  0296: 3A EC FF         LDA ADCNT
  426  0299: FE 04            CPI 04h
  427  029B: DA A7 02         JC RDRE
  428  029E: 3A ED FF         LDA AF3
  429  02A1: CD 91 01         CALL GLOOK
  430  02A4: 32 F8 FF         STA DIGIMG3
  431  02A7: C9       RDRE:   RET
  432            
  433            ; =====================================================================
  434            ; UART-канал v2.7: передача OUT 04h @1M (TXRDY = IN 05h бит A1),
  435            ; приём RIM/SID @4800 (мануал, фрагменты 5/7)
  436            ; =====================================================================
  437            
  438            ; ---------------------------------------------------------------------
  439            ; TXBYTE: A = байт -> сериализатор CPLD (1 000 000 8N1). Ожидает TXRDY
  440            ; (запись при busy аппаратно отбрасывается). Портит A.
  441            ; ---------------------------------------------------------------------
  442  02A8: F5       TXBYTE: PUSH PSW
  443  02A9: DB 05    TXB1:   IN STP
  444  02AB: E6 02            ANI 02h             ; бит A1 = TXRDY (tx_idle = ~|bit_cnt)
  445  02AD: CA A9 02         JZ TXB1
  446  02B0: F1               POP PSW
  447  02B1: D3 04            OUT TXP
  448  02B3: C9               RET
  449            
  450            ; ---------------------------------------------------------------------
  451            ; TXSTR: HL = строка с нулевым завершителем -> TX. Портит A/HL.
  452            ; ---------------------------------------------------------------------
  453  02B4: 7E       TXSTR:  MOV A,M
  454  02B5: B7               ORA A
  455  02B6: C8               RZ
  456  02B7: CD A8 02         CALL TXBYTE
  457  02BA: 23               INX H
  458  02BB: C3 B4 02         JMP TXSTR
  459            
  460            ; ---------------------------------------------------------------------
  461            ; PAUSE: пауза D итераций по 6 мкс (DCR+JNZ = 15T @2,5 МГц).
  462            ; ---------------------------------------------------------------------
  463  02BE: 15       PAUSE:  DCR D
  464  02BF: C2 BE 02         JNZ PAUSE
  465  02C2: C9               RET
  466            
  467            ; ---------------------------------------------------------------------
  468            ; RXD: приём байта SID 4800 8N1 (мануал, фрагмент 7 + стоп-бит).
  469            ; Выход: C = байт, CY = 0 ОК / CY = 1 обрыв кадра (стоп-бит = 0).
  470            ; Портит A/B/C/D. Цикл строгий - прерываний не звать (TRAP-глушилка
  471            ; добавляет 5,6 мкс джиттера раз в 127 мкс - при 208 мкс/бит не опасно).
  472            ; ---------------------------------------------------------------------
  473  02C3: 06 08    RXD:    MVI B,08h
  474  02C5: 20       RXW:    RIM                 ; A7 = SID
  475  02C6: B7               ORA A
  476  02C7: FA C5 02         JM RXW              ; '1' (покой) - ждать старт-бит
  477  02CA: 16 0F            MVI D,RXHB          ; полбита - в середину старт-бита
  478  02CC: CD BE 02         CALL PAUSE
  479  02CF: 20               RIM                 ; подтвердить старт-бит
  480  02D0: B7               ORA A
  481  02D1: FA C5 02         JM RXW              ; '1' - ложный старт, ждать заново
  482  02D4: 0E 00            MVI C,00h
  483  02D6: 16 1E            MVI D,RXFB          ; бит - в середину D0
  484  02D8: CD BE 02         CALL PAUSE
  485  02DB: 20       RXL:    RIM                 ; A7 = SID - центр очередного бита
  486  02DC: E6 80            ANI 80h
  487  02DE: 1F               RAR                 ; бит -> CY
  488  02DF: 79               MOV A,C
  489  02E0: 1F               RAR                 ; вставить сверху (LSB-first)
  490  02E1: 4F               MOV C,A
  491  02E2: 16 1E            MVI D,RXFB
  492  02E4: CD BE 02         CALL PAUSE
  493  02E7: 05               DCR B
  494  02E8: C2 DB 02         JNZ RXL
  495                    ; после последней итерации RXL (выборка d7 + бит задержки)
  496                    ; линия = середина стоп-бита
  497  02EB: 20               RIM
  498  02EC: E6 80            ANI 80h             ; CY = 0 (ANI сбрасывает перенос)
  499  02EE: CA F3 02         JZ RXBAD            ; стоп-бит = 0 - обрыв кадра
  500  02F1: B7               ORA A               ; CY = 0
  501  02F2: C9               RET                 ; C = байт, CY = 0
  502  02F3: 37       RXBAD:  STC
  503  02F4: C9               RET                 ; CY = 1
  504            
  505            ; ---------------------------------------------------------------------
  506            ; NIB: A = ASCII-символ -> CY = 1 и A = тетрада 0-F ('0'-'9','A'-'F',
  507            ; 'a'-'f'), иначе CY = 0. Портит A.
  508            ; ---------------------------------------------------------------------
  509  02F5: D6 30    NIB:    SUI 30h             ; '0'..'9' -> 0..9
  510  02F7: DA 15 03         JC NIBX             ; < '0'
  511  02FA: FE 0A            CPI 0Ah
  512  02FC: DA 13 03         JC NIBOK            ; цифра 0..9
  513  02FF: D6 07            SUI 07h             ; 'A'..'F' -> 10..15
  514  0301: FE 10            CPI 10h
  515  0303: D2 09 03         JNC NIB2            ; > 'F' - попробовать строчные a..f
  516  0306: C3 13 03         JMP NIBOK
  517  0309: D6 20    NIB2:   SUI 20h             ; ('a'-'0')-07h-20h = 10..15
  518  030B: FE 10            CPI 10h
  519  030D: D2 15 03         JNC NIBX
  520  0310: C3 13 03         JMP NIBOK
  521  0313: 37       NIBOK:  STC
  522  0314: C9               RET
  523  0315: B7       NIBX:   ORA A               ; CY = 0
  524  0316: C9               RET
  525            
  526            ; ---------------------------------------------------------------------
  527            ; LSTAT: A = глиф -> статический дисплей (все 4 разряда, скан стоит).
  528            ; Для режимов загрузчика/RAM-теста, где главный цикл не крутится.
  529            ; ---------------------------------------------------------------------
  530  0317: C5       LSTAT:  PUSH B
  531  0318: 47               MOV B,A
  532  0319: AF               XRA A
  533  031A: D3 00            OUT SEGP            ; гашение на время переключения
  534  031C: 3E 0F            MVI A,0Fh
  535  031E: D3 01            OUT DIGP            ; все 4 разряда, SND = 0
  536  0320: 78               MOV A,B
  537  0321: D3 00            OUT SEGP            ; глиф на все разряды
  538  0323: C1               POP B
  539  0324: C9               RET
  540            
  541            ; ---------------------------------------------------------------------
  542            ; DLMS: пауза ~1,03 мс (K_MS итераций 24T). Портит A/B/C.
  543            ; ---------------------------------------------------------------------
  544  0325: 01 68 00 DLMS:   LXI B,K_MS
  545  0328: 0B       DLS1:   DCX B
  546  0329: 78               MOV A,B
  547  032A: B1               ORA C
  548  032B: C2 28 03         JNZ DLS1
  549  032E: C9               RET
  550            
  551            ; ---------------------------------------------------------------------
  552            ; LDSUM: LSUM += B (mod 256). Портит A.
  553            ; ---------------------------------------------------------------------
  554  032F: F5       LDSUM:  PUSH PSW
  555  0330: 3A FE FF         LDA LSUM
  556  0333: 80               ADD B
  557  0334: 32 FE FF         STA LSUM
  558  0337: F1               POP PSW
  559  0338: C9               RET
  560            
  561            ; ---------------------------------------------------------------------
  562            ; LDBEEP: длинный сигнал ~0,3 с (тон ~500 Гц, дисплей не трогает -
  563            ; только бит D4 в DIGP). Портит A/D.
  564            ; ---------------------------------------------------------------------
  565  0339: 16 96    LDBEEP: MVI D,150
  566  033B: 3E 1F    LDB1:   MVI A,1Fh           ; SND = 1, разряды on
  567  033D: D3 01            OUT DIGP
  568  033F: CD 25 03         CALL DLMS
  569  0342: 3E 0F            MVI A,0Fh           ; SND = 0
  570  0344: D3 01            OUT DIGP
  571  0346: CD 25 03         CALL DLMS
  572  0349: 15               DCR D
  573  034A: C2 3B 03         JNZ LDB1
  574  034D: C9               RET
  575            
  576            ; =====================================================================
  577            ; LOADM: Intel HEX загрузчик (клавиша B). Приём SID 4800 8N1.
  578            ; Формат записи: :nnaaaatt[dd...]cc, cc = (-сумма байт) mod 256.
  579            ; Статический дисплей LLLL; адрес каждой записи живёт в ADDRH/L.
  580            ; Запись только в ОЗУ (A15=1): попадание в ROM-окно = ошибка EEEE.
  581            ; Выход: EOF-запись (type 01) -> тик и меню; ошибка -> EEEE + сигнал.
  582            ; Выход из зависшего приёма - RESET (SW20).
  583            ; ---------------------------------------------------------------------
  584  034E: AF       LOADM:  XRA A
  585  034F: 32 FA FF         STA LST             ; ждем ':'
  586  0352: 3E 38            MVI A,38h           ; 'L'
  587  0354: CD 17 03         CALL LSTAT
  588  0357: CD C3 02 LDLP:   CALL RXD            ; C = байт, CY = ошибка кадра
  589  035A: DA 88 04         JC LDERR
  590  035D: 79               MOV A,C
  591  035E: FE 3A            CPI ':'
  592  0360: CA 73 04         JZ LDNEW            ; начало записи
  593  0363: CD F5 02         CALL NIB            ; тетрада?
  594  0366: D2 57 03         JNC LDLP            ; прочее (\r\n и т.п.) - пропустить
  595  0369: 5F               MOV E,A             ; E = тетрада
  596  036A: 3A FD FF         LDA LACC
  597  036D: 07               RLC
  598  036E: 07               RLC
  599  036F: 07               RLC
  600  0370: 07               RLC                 ; накопитель << 4
  601  0371: B3               ORA E
  602  0372: 32 FD FF         STA LACC
  603  0375: 3A FB FF         LDA LNIB
  604  0378: 3D               DCR A
  605  0379: 32 FB FF         STA LNIB
  606  037C: C2 57 03         JNZ LDLP            ; байт поля ещё не собран
  607                    ; --- байт поля собран - применить по состоянию ---
  608  037F: 3A FD FF         LDA LACC
  609  0382: 47               MOV B,A             ; B = байт
  610  0383: AF               XRA A
  611  0384: 32 FD FF         STA LACC            ; накопитель очищен к следующему байту
  612  0387: 3A FA FF         LDA LST
  613  038A: B7               ORA A
  614  038B: CA 57 03         JZ LDLP             ; байт вне записи - игнор
  615  038E: 3D               DCR A
  616  038F: CA A1 03         JZ LDCNT            ; 1 = count
  617  0392: 3D               DCR A
  618  0393: CA B6 03         JZ LDADR            ; 2 = addr
  619  0396: 3D               DCR A
  620  0397: CA EE 03         JZ LDTYP            ; 3 = type
  621  039A: 3D               DCR A
  622  039B: CA 21 04         JZ LDDAT            ; 4 = data
  623  039E: C3 5D 04         JMP LDCHK           ; 5 = checksum
  624  03A1: 78       LDCNT:  MOV A,B
  625  03A2: 32 EC FF         STA ADCNT           ; сколько байт данных в записи
  626  03A5: CD 2F 03         CALL LDSUM
  627  03A8: 3E 02            MVI A,02h           ; поле addr: 4 тетрады = 2 байта
  628  03AA: 32 FA FF         STA LST
  629  03AD: 32 FC FF         STA LBPC
  630  03B0: 32 FB FF         STA LNIB
  631  03B3: C3 57 03         JMP LDLP
  632  03B6: 78       LDADR:  MOV A,B
  633  03B7: 32 FF FF         STA LTY             ; временно: тип ещё не читался
  634  03BA: 3A FC FF         LDA LBPC
  635  03BD: FE 02            CPI 02h
  636  03BF: C2 D3 03         JNZ LDAD1
  637  03C2: 3A FF FF         LDA LTY
  638  03C5: 32 EA FF         STA ADDRH           ; старший байт адреса (big-endian)
  639  03C8: 3E 01            MVI A,01h
  640  03CA: 32 FC FF         STA LBPC
  641  03CD: CD 2F 03         CALL LDSUM
  642  03D0: C3 57 03         JMP LDLP
  643  03D3: 3A FF FF LDAD1:  LDA LTY
  644  03D6: 32 EB FF         STA ADDRL           ; младший байт адреса
  645  03D9: CD 2F 03         CALL LDSUM
  646  03DC: 3E 03            MVI A,03h
  647  03DE: 32 FA FF         STA LST             ; type
  648  03E1: 3E 01            MVI A,01h
  649  03E3: 32 FC FF         STA LBPC
  650  03E6: 3E 02            MVI A,02h
  651  03E8: 32 FB FF         STA LNIB
  652  03EB: C3 57 03         JMP LDLP
  653  03EE: 78       LDTYP:  MOV A,B
  654  03EF: 32 FF FF         STA LTY
  655  03F2: CD 2F 03         CALL LDSUM
  656  03F5: 3A FF FF         LDA LTY
  657  03F8: FE 01            CPI 01h
  658  03FA: CA 10 04         JZ LDTYP1
  659  03FD: 3A EC FF         LDA ADCNT           ; type 00: данные
  660  0400: 32 FC FF         STA LBPC
  661  0403: 3E 04            MVI A,04h
  662  0405: 32 FA FF         STA LST
  663  0408: 3E 02            MVI A,02h
  664  040A: 32 FB FF         STA LNIB
  665  040D: C3 57 03         JMP LDLP
  666  0410: AF       LDTYP1: XRA A               ; type 01 (EOF): данных нет
  667  0411: 32 FC FF         STA LBPC
  668  0414: 3E 05            MVI A,05h
  669  0416: 32 FA FF         STA LST
  670  0419: 3E 02            MVI A,02h
  671  041B: 32 FB FF         STA LNIB
  672  041E: C3 57 03         JMP LDLP
  673  0421: 3A EA FF LDDAT:  LDA ADDRH
  674  0424: E6 80            ANI 80h             ; запись разрешена только в ОЗУ
  675  0426: CA 88 04         JZ LDERR            ; ROM-окно - ошибка
  676  0429: 3A EA FF         LDA ADDRH
  677  042C: 67               MOV H,A
  678  042D: 3A EB FF         LDA ADDRL
  679  0430: 6F               MOV L,A
  680  0431: 70               MOV M,B             ; [ADDR] = байт (writeback CPLD)
  681  0432: 23               INX H
  682  0433: 7C               MOV A,H
  683  0434: 32 EA FF         STA ADDRH
  684  0437: 7D               MOV A,L
  685  0438: 32 EB FF         STA ADDRL
  686  043B: CD 2F 03         CALL LDSUM
  687  043E: 3A FC FF         LDA LBPC
  688  0441: 3D               DCR A
  689  0442: 32 FC FF         STA LBPC
  690  0445: C2 55 04         JNZ LDDAT2
  691  0448: 3E 05            MVI A,05h           ; данные кончились - ждать checksum
  692  044A: 32 FA FF         STA LST
  693  044D: 3E 02            MVI A,02h
  694  044F: 32 FB FF         STA LNIB
  695  0452: C3 57 03         JMP LDLP
  696  0455: 3E 02    LDDAT2: MVI A,02h
  697  0457: 32 FB FF         STA LNIB
  698  045A: C3 57 03         JMP LDLP
  699  045D: 3A FE FF LDCHK:  LDA LSUM            ; контрольная сумма записи
  700  0460: 80               ADD B               ; сумма всех байт + cc = 0 mod 256?
  701  0461: C2 88 04         JNZ LDERR
  702  0464: 3A FF FF         LDA LTY
  703  0467: FE 01            CPI 01h
  704  0469: CA 84 04         JZ LDDONE           ; EOF - конец загрузки
  705  046C: AF               XRA A
  706  046D: 32 FA FF         STA LST             ; ждем ':' следующей записи
  707  0470: C3 57 03         JMP LDLP
  708  0473: 3E 01    LDNEW:  MVI A,01h           ; ':' - новая запись
  709  0475: 32 FA FF         STA LST
  710  0478: 3E 02            MVI A,02h
  711  047A: 32 FB FF         STA LNIB
  712  047D: AF               XRA A
  713  047E: 32 FE FF         STA LSUM
  714  0481: C3 57 03         JMP LDLP
  715  0484: CD 80 01 LDDONE: CALL TICKON         ; подтверждение успешной загрузки
  716  0487: C9               RET
  717  0488: 3E 79    LDERR:  MVI A,79h           ; 'E' -> дисплей EEEE
  718  048A: CD 17 03         CALL LSTAT
  719  048D: CD 39 03         CALL LDBEEP         ; длинный сигнал
  720  0490: C9               RET                 ; в меню (ADDRH/L = адрес сбоя, D = просмотр)
  721            
  722            ; =====================================================================
  723            ; RAMT: RAM-тест 8000h-FFE7h (клавиша F). 4 паттерна 00/FF/55/AA:
  724            ; заполнение + контроль побайтно. Статический дисплей = глиф паттерна
  725            ; ("0000"/"FFFF"/"5555"/"AAAA"). Сбой: ADDRH/L = адрес сбоя, EEEE +
  726            ; длинный сигнал. Успех: короткий тик. Стек не трогается: запись до
  727            ; FFE7h, SP = FFE8h, pushes TRAP-глушилки (FFDE/FFDF) вне диапазона
  728            ; контроля не портят паттерн (pop восстанавливает, ранняя запись
  729            ; перекрывается заполнением позже).
  730            ; Портит всё.
  731            ; ---------------------------------------------------------------------
  732  0491: 21 74 00 RAMT:   LXI H,RAMPAT        ; HL = текущая пара (value+glyph)
  733  0494: 0E 04            MVI C,04h           ; 4 паттерна
  734  0496: 7E       RMT0:   MOV A,M             ; A = значение паттерна
  735  0497: 5F               MOV E,A
  736  0498: E5               PUSH H              ; указатель пары - на стек (HL уйдёт под заполнение)
  737  0499: 23               INX H
  738  049A: 7E               MOV A,M             ; глиф паттерна
  739  049B: CD 17 03         CALL LSTAT          ; статический дисплей ("0000" и т.д.)
  740  049E: 7B               MOV A,E
  741  049F: 21 00 80         LXI H,8000h
  742  04A2: 77       RMF:    MOV M,A             ; заполнение
  743  04A3: 23               INX H
  744  04A4: 7C               MOV A,H
  745  04A5: FE FE            CPI 0FEh            ; до FFE7h включительно
  746  04A7: C2 A2 04         JNZ RMF
  747  04AA: 7D               MOV A,L
  748  04AB: FE E8            CPI 0E8h
  749  04AD: C2 A2 04         JNZ RMF
  750  04B0: 21 00 80         LXI H,8000h
  751  04B3: 7E       RMV:    MOV A,M             ; контроль
  752  04B4: BB               CMP E
  753  04B5: C2 D0 04         JNZ RMBAD
  754  04B8: 23               INX H
  755  04B9: 7C               MOV A,H
  756  04BA: FE FE            CPI 0FEh
  757  04BC: C2 B3 04         JNZ RMV
  758  04BF: 7D               MOV A,L
  759  04C0: FE E8            CPI 0E8h
  760  04C2: C2 B3 04         JNZ RMV
  761  04C5: E1               POP H               ; HL = пара паттерна
  762  04C6: 23               INX H
  763  04C7: 23               INX H               ; следующая пара
  764  04C8: 0D               DCR C
  765  04C9: C2 96 04         JNZ RMT0
  766  04CC: CD 80 01         CALL TICKON         ; ОК
  767  04CF: C9               RET
  768  04D0: 22 EB FF RMBAD:  SHLD ADDRL          ; ADDRH/L = адрес сбоя (HL из RMV, до POP!)
