    1            ; =====================================================================
    2            ; beta/txuart/rom -- monitor27: монитор для платы v2.7 (beta/txuart)
    3            ;
    4            ; База: fw_mon v5 (beta/lowsize/rom, клавиатурный монитор "ACDE").
    5            ; Отличия от v5 (платформа v2.7, CPLD top_txuart_por6_v27):
    6            ;   1. ВЕКТОРА 0008h-003Fh = глушилки EI;RET. На v2.7 CPLD выдаёт на
    7            ;      ногу TRAP (P74) квадрат 128 мкс (64/64) = 7,8125 кГц (tick_q).
    8            ;      TRAP немаскируем: DI не помогает. Без обработчика первый же фронт
    9            ;      уводит CPU на 0024h, где у v5 лежала таблица GTBL -> "8.8.8.8.".
   10            ;      EI в глушилке ОБЯЗАТЕЛЕН: после приёма TRAP новые TRAP блокируются
   11            ;      до EI (п.36 даташита; без EI тик-система глохнет после 1-го тика).
   12            ;      Пользовательские программы защищены автоматически: глушилки в ROM.
   13            ;   2. Таблицы перенесены с 0003h на 0044h (освобождена векторная зона).
   14            ;   3. Тайминг под 2,5 МГц (T = 400 нс; lowsize был 3,571 МГц):
   15            ;      K_MS = 104 (~1,0 мс/единица; итерация DCX/MOV/ORA/JNZ = 24T).
   16            ;   4. NEW: приём по SID 4800 8N1 (RIM, транзит RX->SID в CPLD) -
   17            ;      Intel HEX загрузчик (клавиша B в меню). Код RXD = мануал
   18            ;      (programming manual, фрагменты 5/7): PAUSE 6 мкс/итер, полбита
   19            ;      N=15, бит N=30 - числа железо-проверены эхо-прошивками.
   20            ;   5. NEW: передача через CPLD OUT 04h @ 1 000 000 8N1 (сериализатор
   21            ;      v2.7; TXRDY = IN 05h бит A1, остальные биты 0). Баннер при
   22            ;      старте. ВНИМАНИЕ: мост CH340G = ОДНА скорость на оба направления;
   23            ;      терминал 4800 -> загрузка HEX работает, баннер = короткий мусор
   24            ;      (~8 байт); терминал 1M -> баннер читается, вставка HEX не ловится
   25            ;      (приём программный, 2,5 МГц CPU не успевает за 1 мкс/бит).
   26            ;   6. NEW: RAM-тест 8000h-FFE7h (клавиша F в меню), 4 паттерна.
   27            ;   7. SOD (SIM) НЕ используется: на v2.7 транзит SOD->TX выпилен
   28            ;      (TX = только сериализатор CPLD); RIM - только для приёма SID.
   29            ;   8. XSTREAM v1 (порт из beta/xstream/xstream_v1, SW-вариант): фон-выдача
   30            ;      экрана 80x25 из ОЗУ B000h-B7CFh в UART @1M кадрами A5 5A [SEQ]+2000Б,
   31            ;      ~17 FPS @ ~50% ЦП на 2,5 МГц (на v24-плате 3,125 МГц было ~20 FPS).
   32            ;      Тик кадра = слоты скана монитора (XSPASS, БЕЗ прерываний - на v2.7
   33            ;      таймера CPLD нет, TRAP-тик 128 мкс поглощается глушилкой). Клиент
   34            ;      xstream_view.ps1 v1.2.2 (COM @ 1000000 8N1) - БЕЗ ИЗМЕНЕНИЙ.
   35            ;      Во время B (загрузка) и F (RAM-тест) кадры стоят: клиент фиксирует
   36            ;      паузу и продолжает по правилу рестарта (dt>250 мс + скачок SEQ).
   37            ;      XSSEQ/XSPASS живут в FFFAh/FFFBh совместно с LST/LNIB загрузчика:
   38            ;      режимы B и скан-выдача во времени не пересекаются, LOADM чистит.
   39            ;
   40            ; СБОРКА (asm85.py, кодировка CP1251):
   41            ;   python3 asm85.py monitor27.asm -o monitor27.hex -l monitor27.lst
   42            ;   (asm85.py лежит в beta/lowsize/rom; из этого каталога:
   43            ;    python3 ../../lowsize/rom/asm85.py monitor27.asm -o monitor27.hex -l monitor27.lst)
   44            ; Прошивка: flash A29040B, offset 0000h (ROM-окно 0000h-7FFFh).
   45            ;
   46            ; КЛАВИАТУРА (как v5): тетрады 0-F + Enter + F1(меню) + F2(показ адреса);
   47            ; ДОБАВЛЕНО в меню: B (0Bh) = загрузчик Intel HEX через SID 4800,
   48            ; F (0Fh) = RAM-тест. Дисплей в режимах B/F - статический (скан остановлен,
   49            ; все 4 разряда = один глиф: LLLL / 0000 / FFFF / 5555 / AAAA / EEEE).
   50            ; Выход из залипшего режима - RESET (SW20), как в v5.
   51            ;
   52            ; ОЗУ: переменные FFE8h-FFFFh, стек с FFE7h вниз (SP0 = FFE8h).
   53            ; Новые переменные загрузчика: FFFAh-FFFFh; адрес записи - в ADDRH/L
   54            ; (на дисплее после загрузки - последний адрес записи).
   55            ; =====================================================================
   56            
   57            ; ---- порты CPLD (декод по A2-A0, зеркала mod 8) ----
   58            SEGP    EQU 00h             ; сегменты: D0=a..D6=g, D7=dp; 1 = горит
   59            DIGP    EQU 01h             ; D3-D0 разряды, D4 = SND
   60            KBCOLP  EQU 02h             ; D3-D0 колонки (1 = заведена)
   61            KBROWP  EQU 03h             ; D4-D0 ряды (1 = нажата в активной колонке)
   62            TXP     EQU 04h             ; OUT: TXDATA -> сериализатор CPLD (1M 8N1)
   63            STP     EQU 05h             ; IN: статус, бит A1 = TXRDY (1 = готов)
   64            
   65            ; ---- константы тайминга (CPU 2,5 МГц, T = 400 нс) ----
   66            K_MS    EQU 104             ; единица ~1,0 мс (104 x 24T x 400 нс)
   67            TICK_MS EQU 15              ; тик клавиши ~15 мс (v5: 30 @3,57 МГц)
   68            SET_MS  EQU 15              ; дебаунс отпускания ~15 мс (v5: 30)
   69            RXHB    EQU 15              ; полбита 4800 (PAUSE-итераций, ~103 мкс)
   70            RXFB    EQU 30              ; бит приёма 4800 (PAUSE-итераций, ~211 мкс)
   71            
   72            ; ---- коды клавиш ----
   73            K_ENT   EQU 10h             ; Enter  (row3/col3, SW16)
   74            K_F1    EQU 11h             ; F1     (row4/col1, SW18) - меню
   75            K_F2    EQU 12h             ; F2     (row4/col2, SW19) - показ адреса
   76            K_NONE  EQU 0FFh            ; пустая позиция матрицы
   77            
   78            ; ---- состояния ----
   79            ST_MENU EQU 00h             ; меню "ACDE" (B = загрузчик, F = RAM-тест)
   80            ST_ADDR EQU 01h             ; ввод адреса
   81            ST_PROG EQU 02h             ; ввод кода (Code)
   82            ST_VIEW EQU 03h             ; просмотр кода
   83            ST_SHOW EQU 04h             ; показ адреса операций (F2)
   84            
   85            ; ---- ОЗУ монитора ----
   86            SP0     EQU 0FFE8h          ; SP монитора
   87            SNDST   EQU 0FFE8h          ; состояние тона 0/1
   88            STATE   EQU 0FFE9h          ; 0=меню, 1=адрес, 2=код, 3=просмотр, 4=показ
   89            ADDRH   EQU 0FFEAh          ; текущий адрес (старший); в загрузчике = адрес записи
   90            ADDRL   EQU 0FFEBh          ; текущий адрес (младший)
   91            ADCNT   EQU 0FFECh          ; тетрады адреса (0..4); в загрузчике = счётчик байт данных
   92            AF3     EQU 0FFEDh          ; тетрады адреса
   93            AF2     EQU 0FFEEh
   94            AF1     EQU 0FFEFh
   95            AF0     EQU 0FFF0h
   96            BDCNT   EQU 0FFF1h          ; введено тетрад байта (0..2)
   97            BF1     EQU 0FFF2h
   98            BF0     EQU 0FFF3h
   99            DPIDX   EQU 0FFF4h          ; фаза регенерации 0..3
  100            DIGIMG  EQU 0FFF5h          ; глифы разрядов DIG0..DIG3
  101            DIGIMG0 EQU 0FFF5h
  102            DIGIMG1 EQU 0FFF6h
  103            DIGIMG2 EQU 0FFF7h
  104            DIGIMG3 EQU 0FFF8h
  105            PREVST  EQU 0FFF9h          ; прежний режим для F2
  106            ; --- новые: парсер Intel HEX (загрузчик B) ---
  107            LST     EQU 0FFFAh          ; состояние: 0=ждём ':' 1=count 2=addr 3=type 4=data 5=chk
  108            LNIB    EQU 0FFFBh          ; осталось тетрад в текущем байте поля (1..2)
  109            LBPC    EQU 0FFFCh          ; осталось байт в текущем поле
  110            LACC    EQU 0FFFDh          ; накопитель тетрад текущего байта
  111            LSUM    EQU 0FFFEh          ; сумма байт записи (mod 256) для контроля
  112            LTY     EQU 0FFFFh          ; тип последней записи (00 = данные, 01 = конец)
  113            
  114            ; --- XSTREAM v1: экран -> UART (SW-тик, без прерываний) ---
  115            TXPORT  EQU TXP             ; TXDATA (04h) - синоним для xstream-кода
  116            XBUF    EQU 0B000h          ; ЭКРАН 80x25 = 2000 Б (B000h..B7CFh)
  117            XSSEQ   EQU 0FFFAh          ; SEQ кадра mod 256 (ячейка LST - см. шапку п.8)
  118            XSPASS  EQU 0FFFBh          ; накопитель слотов скана (ячейка LNIB)
  119            XS_TH   EQU 71              ; слотов скана между кадрами: слот ~0,41 мс на
  120                                        ; 2,5 МГц -> пауза ~29,4 мс + посылка ~29,9 мс
  121                                        ; = ~59,3 мс = ~17 FPS @ ~50% ЦП (ТЗ: <=50%)
  122            XS_QINC EQU 2               ; слот-эквивалентов за единицу BUNIT/QUNIT
  123                                        ; (~1,03 мс = ~2,5 слота на 2,5 МГц, вниз)
  124            XSCNT   EQU XBUF+06E4h      ; живой счётчик SEQ в демо-экране (строка 22, кол. 4-5)
  125            
  126            ; =====================================================================
  127  0000: -                ORG 0000h
  128  0000: C3 DD 07         JMP START
  129            
  130            ; ---- векторная зона: глушилки EI;RET -------------------------------
  131            ; RST 1..7, TRAP (0024h), RST 5.5/6.5/7.5. EI обязателен в каждой:
  132            ; снимает блокировку TRAP после приёма. Маскируемые (5.5/6.5/7.5/INTR)
  133            ; железно=0 (PGND), EI для них безопасен. Формат: F3 C9.
  134  0008: -                ORG 0008h           ; RST 1
  135  0008: FB               EI
  136  0009: C9               RET
  137  0010: -                ORG 0010h           ; RST 2
  138  0010: FB               EI
  139  0011: C9               RET
  140  0018: -                ORG 0018h           ; RST 3
  141  0018: FB               EI
  142  0019: C9               RET
  143  0020: -                ORG 0020h           ; RST 4
  144  0020: FB               EI
  145  0021: C9               RET
  146  0024: -                ORG 0024h           ; TRAP - ГЛАВНАЯ глушилка (тик CPLD 7,8125 кГц)
  147  0024: FB               EI
  148  0025: C9               RET
  149  0028: -                ORG 0028h           ; RST 5
  150  0028: FB               EI
  151  0029: C9               RET
  152  002C: -                ORG 002Ch           ; RST 5.5
  153  002C: FB               EI
  154  002D: C9               RET
  155  0030: -                ORG 0030h           ; RST 6
  156  0030: FB               EI
  157  0031: C9               RET
  158  0034: -                ORG 0034h           ; RST 6.5
  159  0034: FB               EI
  160  0035: C9               RET
  161  0038: -                ORG 0038h           ; RST 7
  162  0038: FB               EI
  163  0039: C9               RET
  164  003C: -                ORG 003Ch           ; RST 7.5
  165  003C: FB               EI
  166  003D: C9               RET
  167            
  168            ; =====================================================================
  169            ; Таблицы (ORG 0044h - векторная зона выше освобождена)
  170            ; =====================================================================
  171  0044: -                ORG 0044h
  172            ; ---- глифы '0'..'F' (a,b,c,d,e,f,g = D0..D6) ----
  173  0044: 3F       GTBL:   DB 3Fh              ; '0'
  174  0045: 06               DB 06h              ; '1'
  175  0046: 5B               DB 5Bh              ; '2'
  176  0047: 4F               DB 4Fh              ; '3'
  177  0048: 66               DB 66h              ; '4'
  178  0049: 6D               DB 6Dh              ; '5'
  179  004A: 7D               DB 7Dh              ; '6'
  180  004B: 07               DB 07h              ; '7'
  181  004C: 7F               DB 7Fh              ; '8'
  182  004D: 6F               DB 6Fh              ; '9'
  183  004E: 77               DB 77h              ; 'A'
  184  004F: 7C               DB 7Ch              ; 'b'
  185  0050: 39               DB 39h              ; 'C'
  186  0051: 5E               DB 5Eh              ; 'd'
  187  0052: 79               DB 79h              ; 'E'
  188  0053: 71               DB 71h              ; 'F'
  189            
  190            ; ---- биты разрядов (индекс = DPIDX: 0=DIG0 правый ... 3=DIG3 левый) ----
  191  0054: 01 02 04 08 BITTBL: DB 01h,02h,04h,08h
  192            
  193            ; ---- КАРТА КЛАВИШ: KEYTBL[row*4+col] ----
  194  0058: 0A 0B 0C 0D KEYTBL: DB 0Ah,0Bh,0Ch,0Dh  ; row0: A  B  C  D
  195  005C: 07 08 09 0E         DB 07h,08h,09h,0Eh  ; row1: 7  8  9  E
  196  0060: 04 05 06 0F         DB 04h,05h,06h,0Fh  ; row2: 4  5  6  F
  197  0064: 01 02 03 10         DB 01h,02h,03h,10h  ; row3: 1  2  3  Enter
  198  0068: 00 11 12 FF         DB 00h,11h,12h,0FFh ; row4: 0  F1 F2 (нет)
  199            
  200            ; ---- баннер TX @1M (на терминале 4800 = короткая мусорная строка) ----
  201  006C: 4D 4F 4E 32 37 0D 0A 00 TXBAN:  DB 4Dh,4Fh,4Eh,32h,37h,0Dh,0Ah,00h   ; "MON27\r\n"
  202            
  203            ; ---- паттерны RAM-теста: значение + глиф для статического дисплея ----
  204  0074: 00 3F    RAMPAT: DB 00h,3Fh          ; 00h -> "0000"
  205  0076: FF 71            DB 0FFh,71h         ; FFh -> "FFFF"
  206  0078: 55 6D            DB 55h,6Dh          ; 55h -> "5555"
  207  007A: AA 77            DB 0AAh,77h         ; AAh -> "AAAA"
  208            
  209            ; =====================================================================
  210            ; Системные процедуры (перенос из fw_mon v5, константы под 2,5 МГц)
  211            ; =====================================================================
  212  0100: -                ORG 0100h
  213            
  214            ; ---------------------------------------------------------------------
  215            ; SETTLE: пауза ~36 мкс (LXI+3 итерации 24T @400 нс; установка рядов
  216            ; после заведения колонки). Портит A/B/C.
  217            ; ---------------------------------------------------------------------
  218  0100: 01 03 00 SETTLE: LXI B,3
  219  0103: 0B       STL:    DCX B
  220  0104: 78               MOV A,B
  221  0105: B1               ORA C
  222  0106: C2 03 01         JNZ STL
  223  0109: C9               RET
  224            
  225            ; ---------------------------------------------------------------------
  226            ; SCANALL: опрос всех 4 колонок; A = ИЛИ рядов (0 = нажатий нет);
  227            ; колонки на выходе погашены. Портит A/B/C/D/E.
  228            ; ---------------------------------------------------------------------
  229  010A: AF       SCANALL: XRA A
  230  010B: 5F               MOV E,A             ; E = накопитель
  231  010C: 16 01            MVI D,01h           ; D = бит колонки
  232  010E: 7A       SAL1:   MOV A,D
  233  010F: D3 02            OUT KBCOLP
  234  0111: CD 00 01         CALL SETTLE
  235  0114: DB 03            IN KBROWP
  236  0116: E6 1F            ANI 1Fh
  237  0118: B3               ORA E
  238  0119: 5F               MOV E,A
  239  011A: 7A               MOV A,D
  240  011B: 07               RLC
  241  011C: 57               MOV D,A
  242  011D: FE 10            CPI 10h
  243  011F: C2 0E 01         JNZ SAL1
  244  0122: AF               XRA A
  245  0123: D3 02            OUT KBCOLP
  246  0125: 7B               MOV A,E
  247  0126: C9               RET
  248            
  249            ; ---------------------------------------------------------------------
  250            ; REFRESH: один слот регенерации. ГАШЕНИЕ -> РАЗРЯД -> ГЛИФ (как v5,
  251            ; без послесвечения). DIGIMG[DPIDX] на разряд DPIDX. Бит D4 (SND)
  252            ; уносится записью DIGP - дисплей при тоне не гаснет.
  253            ; Портит A/B/C/H/L (D/E - бит колонки и индекс скана - НЕ трогает).
  254            ; ---------------------------------------------------------------------
  255  0127: 3A F4 FF REFRESH: LDA DPIDX
  256  012A: 4F               MOV C,A             ; C = индекс 0..3
  257  012B: 06 00            MVI B,0
  258  012D: 21 54 00         LXI H,BITTBL
  259  0130: 09               DAD B
  260  0131: 46               MOV B,M             ; B = бит разряда (01,02,04,08)
  261  0132: 21 F5 FF         LXI H,DIGIMG        ; HL = DIGIMG + DPIDX (цикл вместо ADD)
  262  0135: 79       RFIL:   MOV A,C
  263  0136: B7               ORA A
  264  0137: CA 3F 01         JZ RFGD
  265  013A: 2C               INR L
  266  013B: 0D               DCR C
  267  013C: C3 35 01         JMP RFIL
  268  013F: 4E       RFGD:   MOV C,M             ; C = глиф разряда
  269  0140: 3A E8 FF         LDA SNDST
  270  0143: B7               ORA A
  271  0144: CA 4B 01         JZ RFN
  272  0147: 78               MOV A,B
  273  0148: F6 10            ORI 10h
  274  014A: 47               MOV B,A             ; B |= SND
  275  014B: AF       RFN:    XRA A
  276  014C: D3 00            OUT SEGP            ; (1) гашение: старый разряд погас
  277  014E: 78               MOV A,B
  278  014F: D3 01            OUT DIGP            ; (2) разряд переключён (сегменты пусты)
  279  0151: 79               MOV A,C
  280  0152: D3 00            OUT SEGP            ; (3) зажгли глиф нового разряда
  281  0154: 3A F4 FF         LDA DPIDX
  282  0157: 3C               INR A
  283  0158: E6 03            ANI 03h
  284  015A: 32 F4 FF         STA DPIDX
  285  015D: C9               RET
  286            
  287            ; ---------------------------------------------------------------------
  288            ; BUNIT: единица ~1,03 мс (104 итерации 24T) + тоггл SNDST + регенерация
  289            ; QUNIT: единица ~1,03 мс без звука, дисплей живёт
  290            ; ---------------------------------------------------------------------
  291  015E: 01 68 00 BUNIT:  LXI B,K_MS
  292  0161: 0B       BUL:    DCX B
  293  0162: 78               MOV A,B
  294  0163: B1               ORA C
  295  0164: C2 61 01         JNZ BUL
  296  0167: 3A E8 FF         LDA SNDST
  297  016A: EE 01            XRI 01h
  298  016C: 32 E8 FF         STA SNDST
  299  016F: CD 27 01         CALL REFRESH
  300  0172: 3E 02            MVI A,XS_QINC       ; XSTREAM: тик кадра за единицу паузы
  301  0174: CD 32 05         CALL XSCHK
  302  0177: C9               RET
  303            
  304  0178: 01 68 00 QUNIT:  LXI B,K_MS
  305  017B: 0B       QUL:    DCX B
  306  017C: 78               MOV A,B
  307  017D: B1               ORA C
  308  017E: C2 7B 01         JNZ QUL
  309  0181: CD 27 01         CALL REFRESH
  310  0184: C9               RET
  311            
  312            ; ---------------------------------------------------------------------
  313            ; TICKON: короткий тик подтверждения клавиши (TICK_MS единиц ~1 мс,
  314            ; тон ~500 Гц). Счётчик - В DE: REFRESH портит HL, но гарантирует D/E.
  315            ; ---------------------------------------------------------------------
  316  0185: 11 0F 00 TICKON: LXI D,TICK_MS       ; тик клавиши (единицы ~1,03 мс)
  317  0188: CD 5E 01 TK1:    CALL BUNIT
  318  018B: 1B               DCX D
  319  018C: 7A               MOV A,D
  320  018D: B3               ORA E
  321  018E: C2 88 01         JNZ TK1
  322  0191: AF               XRA A
  323  0192: 32 E8 FF         STA SNDST           ; тон гарантированно погашен
  324  0195: C9               RET
  325            
  326            ; ---------------------------------------------------------------------
  327            ; GLOOK: A = тетрада 0..F -> A = глиф (GTBL). Портит A/B/C/H/L.
  328            ; ---------------------------------------------------------------------
  329  0196: 4F       GLOOK:  MOV C,A
  330  0197: 06 00            MVI B,0
  331  0199: 21 44 00         LXI H,GTBL
  332  019C: 09               DAD B
  333  019D: 7E               MOV A,M
  334  019E: C9               RET
  335            
  336            ; ---------------------------------------------------------------------
  337            ; REDRAW: пересобрать DIGIMG[0..3] по состоянию (как v5).
  338            ;   меню : "ACDE"; адрес: тетрады вдвигаются справа; код "__C3";
  339            ;   просмотр: [ADDR] в правых разрядах; показ(F2): ADDR на 4 разрядах.
  340            ; ---------------------------------------------------------------------
  341  019F: 3A E9 FF REDRAW: LDA STATE
  342  01A2: B7               ORA A
  343  01A3: CA 44 02         JZ RDM
  344  01A6: FE 01            CPI 01h
  345  01A8: CA 5B 02         JZ RDA
  346  01AB: FE 03            CPI 03h
  347  01AD: CA E6 01         JZ RDV
  348  01B0: FE 04            CPI 04h
  349  01B2: CA 0F 02         JZ RDW
  350                    ; ---- ST_PROG ----
  351  01B5: AF               XRA A
  352  01B6: 32 F8 FF         STA DIGIMG3
  353  01B9: 32 F7 FF         STA DIGIMG2
  354  01BC: 32 F6 FF         STA DIGIMG1
  355  01BF: 32 F5 FF         STA DIGIMG0
  356  01C2: 3A F1 FF         LDA BDCNT
  357  01C5: FE 02            CPI 02h
  358  01C7: DA D3 01         JC RDPR0            ; <2 - старшая тетрада пуста
  359  01CA: 3A F2 FF         LDA BF1
  360  01CD: CD 96 01         CALL GLOOK
  361  01D0: 32 F6 FF         STA DIGIMG1
  362  01D3: 3A F1 FF RDPR0:  LDA BDCNT
  363  01D6: B7               ORA A
  364  01D7: CA AC 02         JZ RDRE             ; 0 - младшая тоже пуста
  365  01DA: 3A F3 FF         LDA BF0
  366  01DD: CD 96 01         CALL GLOOK
  367  01E0: 32 F5 FF         STA DIGIMG0
  368  01E3: C3 AC 02         JMP RDRE
  369  01E6: 3A EA FF RDV:    LDA ADDRH           ; ---- ST_VIEW: [ADDR] в правых разрядах ----
  370  01E9: 67               MOV H,A
  371  01EA: 3A EB FF         LDA ADDRL
  372  01ED: 6F               MOV L,A             ; HL = ADDR
  373  01EE: 7E               MOV A,M             ; A = [ADDR] (HL>=8000h - ОЗУ)
  374  01EF: 57               MOV D,A             ; D = байт (GLOOK портит B)
  375  01F0: 0F               RRC
  376  01F1: 0F               RRC
  377  01F2: 0F               RRC
  378  01F3: 0F               RRC
  379  01F4: E6 0F            ANI 0Fh             ; старшая тетрада
  380  01F6: CD 96 01         CALL GLOOK
  381  01F9: 32 F6 FF         STA DIGIMG1
  382  01FC: 7A               MOV A,D
  383  01FD: E6 0F            ANI 0Fh             ; младшая тетрада
  384  01FF: CD 96 01         CALL GLOOK
  385  0202: 32 F5 FF         STA DIGIMG0
  386  0205: AF               XRA A
  387  0206: 32 F8 FF         STA DIGIMG3
  388  0209: 32 F7 FF         STA DIGIMG2
  389  020C: C3 AC 02         JMP RDRE
  390  020F: 3A EA FF RDW:    LDA ADDRH           ; ---- ST_SHOW: ADDR на 4 разрядах ----
  391  0212: 57               MOV D,A             ; D = старший байт (GLOOK портит B)
  392  0213: 0F               RRC
  393  0214: 0F               RRC
  394  0215: 0F               RRC
  395  0216: 0F               RRC
  396  0217: E6 0F            ANI 0Fh
  397  0219: CD 96 01         CALL GLOOK
  398  021C: 32 F8 FF         STA DIGIMG3
  399  021F: 7A               MOV A,D
  400  0220: E6 0F            ANI 0Fh
  401  0222: CD 96 01         CALL GLOOK
  402  0225: 32 F7 FF         STA DIGIMG2
  403  0228: 3A EB FF         LDA ADDRL
  404  022B: 57               MOV D,A
  405  022C: 0F               RRC
  406  022D: 0F               RRC
  407  022E: 0F               RRC
  408  022F: 0F               RRC
  409  0230: E6 0F            ANI 0Fh
  410  0232: CD 96 01         CALL GLOOK
  411  0235: 32 F6 FF         STA DIGIMG1
  412  0238: 7A               MOV A,D
  413  0239: E6 0F            ANI 0Fh
  414  023B: CD 96 01         CALL GLOOK
  415  023E: 32 F5 FF         STA DIGIMG0
  416  0241: C3 AC 02         JMP RDRE
  417  0244: 3E 77    RDM:    MVI A,77h           ; 'A'
  418  0246: 32 F8 FF         STA DIGIMG3
  419  0249: 3E 39            MVI A,39h           ; 'C'
  420  024B: 32 F7 FF         STA DIGIMG2
  421  024E: 3E 5E            MVI A,5Eh           ; 'd' (D)
  422  0250: 32 F6 FF         STA DIGIMG1
  423  0253: 3E 79            MVI A,79h           ; 'E'
  424  0255: 32 F5 FF         STA DIGIMG0
  425  0258: C3 AC 02         JMP RDRE
  426  025B: AF       RDA:    XRA A               ; ---- ST_ADDR: последняя тетрада справа ----
  427  025C: 32 F8 FF         STA DIGIMG3
  428  025F: 32 F7 FF         STA DIGIMG2
  429  0262: 32 F6 FF         STA DIGIMG1
  430  0265: 32 F5 FF         STA DIGIMG0
  431  0268: 3A EC FF         LDA ADCNT
  432  026B: FE 01            CPI 01h
  433  026D: DA AC 02         JC RDRE             ; 0 тетрад - всё пусто
  434  0270: 3A F0 FF         LDA AF0
  435  0273: CD 96 01         CALL GLOOK
  436  0276: 32 F5 FF         STA DIGIMG0
  437  0279: 3A EC FF         LDA ADCNT
  438  027C: FE 02            CPI 02h
  439  027E: DA AC 02         JC RDRE
  440  0281: 3A EF FF         LDA AF1
  441  0284: CD 96 01         CALL GLOOK
  442  0287: 32 F6 FF         STA DIGIMG1
  443  028A: 3A EC FF         LDA ADCNT
  444  028D: FE 03            CPI 03h
  445  028F: DA AC 02         JC RDRE
  446  0292: 3A EE FF         LDA AF2
  447  0295: CD 96 01         CALL GLOOK
  448  0298: 32 F7 FF         STA DIGIMG2
  449  029B: 3A EC FF         LDA ADCNT
  450  029E: FE 04            CPI 04h
  451  02A0: DA AC 02         JC RDRE
  452  02A3: 3A ED FF         LDA AF3
  453  02A6: CD 96 01         CALL GLOOK
  454  02A9: 32 F8 FF         STA DIGIMG3
  455  02AC: C9       RDRE:   RET
  456            
  457            ; =====================================================================
  458            ; UART-канал v2.7: передача OUT 04h @1M (TXRDY = IN 05h бит A1),
  459            ; приём RIM/SID @4800 (мануал, фрагменты 5/7)
  460            ; =====================================================================
  461            
  462            ; ---------------------------------------------------------------------
  463            ; TXBYTE: A = байт -> сериализатор CPLD (1 000 000 8N1). Ожидает TXRDY
  464            ; (запись при busy аппаратно отбрасывается). Портит A.
  465            ; ---------------------------------------------------------------------
  466  02AD: F5       TXBYTE: PUSH PSW
  467  02AE: DB 05    TXB1:   IN STP
  468  02B0: E6 02            ANI 02h             ; бит A1 = TXRDY (tx_idle = ~|bit_cnt)
  469  02B2: CA AE 02         JZ TXB1
  470  02B5: F1               POP PSW
  471  02B6: D3 04            OUT TXP
  472  02B8: C9               RET
  473            
  474            ; ---------------------------------------------------------------------
  475            ; TXSTR: HL = строка с нулевым завершителем -> TX. Портит A/HL.
  476            ; ---------------------------------------------------------------------
  477  02B9: 7E       TXSTR:  MOV A,M
  478  02BA: B7               ORA A
  479  02BB: C8               RZ
  480  02BC: CD AD 02         CALL TXBYTE
  481  02BF: 23               INX H
  482  02C0: C3 B9 02         JMP TXSTR
  483            
  484            ; ---------------------------------------------------------------------
  485            ; PAUSE: пауза D итераций по 6 мкс (DCR+JNZ = 15T @2,5 МГц).
  486            ; ---------------------------------------------------------------------
  487  02C3: 15       PAUSE:  DCR D
  488  02C4: C2 C3 02         JNZ PAUSE
  489  02C7: C9               RET
  490            
  491            ; ---------------------------------------------------------------------
  492            ; RXD: приём байта SID 4800 8N1 (мануал, фрагмент 7 + стоп-бит).
  493            ; Выход: C = байт, CY = 0 ОК / CY = 1 обрыв кадра (стоп-бит = 0).
  494            ; Портит A/B/C/D. Цикл строгий - прерываний не звать (TRAP-глушилка
  495            ; добавляет 5,6 мкс джиттера раз в 127 мкс - при 208 мкс/бит не опасно).
  496            ; ---------------------------------------------------------------------
  497  02C8: 06 08    RXD:    MVI B,08h
  498  02CA: 20       RXW:    RIM                 ; A7 = SID
  499  02CB: B7               ORA A
  500  02CC: FA CA 02         JM RXW              ; '1' (покой) - ждать старт-бит
  501  02CF: 16 0F            MVI D,RXHB          ; полбита - в середину старт-бита
  502  02D1: CD C3 02         CALL PAUSE
  503  02D4: 20               RIM                 ; подтвердить старт-бит
  504  02D5: B7               ORA A
  505  02D6: FA CA 02         JM RXW              ; '1' - ложный старт, ждать заново
  506  02D9: 0E 00            MVI C,00h
  507  02DB: 16 1E            MVI D,RXFB          ; бит - в середину D0
  508  02DD: CD C3 02         CALL PAUSE
  509  02E0: 20       RXL:    RIM                 ; A7 = SID - центр очередного бита
  510  02E1: E6 80            ANI 80h
  511  02E3: 1F               RAR                 ; бит -> CY
  512  02E4: 79               MOV A,C
  513  02E5: 1F               RAR                 ; вставить сверху (LSB-first)
  514  02E6: 4F               MOV C,A
  515  02E7: 16 1E            MVI D,RXFB
  516  02E9: CD C3 02         CALL PAUSE
  517  02EC: 05               DCR B
  518  02ED: C2 E0 02         JNZ RXL
  519                    ; после последней итерации RXL (выборка d7 + бит задержки)
  520                    ; линия = середина стоп-бита
  521  02F0: 20               RIM
  522  02F1: E6 80            ANI 80h             ; CY = 0 (ANI сбрасывает перенос)
  523  02F3: CA F8 02         JZ RXBAD            ; стоп-бит = 0 - обрыв кадра
  524  02F6: B7               ORA A               ; CY = 0
  525  02F7: C9               RET                 ; C = байт, CY = 0
  526  02F8: 37       RXBAD:  STC
  527  02F9: C9               RET                 ; CY = 1
  528            
  529            ; ---------------------------------------------------------------------
  530            ; NIB: A = ASCII-символ -> CY = 1 и A = тетрада 0-F ('0'-'9','A'-'F',
  531            ; 'a'-'f'), иначе CY = 0. Портит A.
  532            ; ---------------------------------------------------------------------
  533  02FA: D6 30    NIB:    SUI 30h             ; '0'..'9' -> 0..9
  534  02FC: DA 1A 03         JC NIBX             ; < '0'
  535  02FF: FE 0A            CPI 0Ah
  536  0301: DA 18 03         JC NIBOK            ; цифра 0..9
  537  0304: D6 07            SUI 07h             ; 'A'..'F' -> 10..15
  538  0306: FE 10            CPI 10h
  539  0308: D2 0E 03         JNC NIB2            ; > 'F' - попробовать строчные a..f
  540  030B: C3 18 03         JMP NIBOK
  541  030E: D6 20    NIB2:   SUI 20h             ; ('a'-'0')-07h-20h = 10..15
  542  0310: FE 10            CPI 10h
  543  0312: D2 1A 03         JNC NIBX
  544  0315: C3 18 03         JMP NIBOK
  545  0318: 37       NIBOK:  STC
  546  0319: C9               RET
  547  031A: B7       NIBX:   ORA A               ; CY = 0
  548  031B: C9               RET
  549            
  550            ; ---------------------------------------------------------------------
  551            ; LSTAT: A = глиф -> статический дисплей (все 4 разряда, скан стоит).
  552            ; Для режимов загрузчика/RAM-теста, где главный цикл не крутится.
  553            ; ---------------------------------------------------------------------
  554  031C: C5       LSTAT:  PUSH B
  555  031D: 47               MOV B,A
  556  031E: AF               XRA A
  557  031F: D3 00            OUT SEGP            ; гашение на время переключения
  558  0321: 3E 0F            MVI A,0Fh
  559  0323: D3 01            OUT DIGP            ; все 4 разряда, SND = 0
  560  0325: 78               MOV A,B
  561  0326: D3 00            OUT SEGP            ; глиф на все разряды
  562  0328: C1               POP B
  563  0329: C9               RET
  564            
  565            ; ---------------------------------------------------------------------
  566            ; DLMS: пауза ~1,03 мс (K_MS итераций 24T). Портит A/B/C.
  567            ; ---------------------------------------------------------------------
  568  032A: 01 68 00 DLMS:   LXI B,K_MS
  569  032D: 0B       DLS1:   DCX B
  570  032E: 78               MOV A,B
  571  032F: B1               ORA C
  572  0330: C2 2D 03         JNZ DLS1
  573  0333: C9               RET
  574            
  575            ; ---------------------------------------------------------------------
  576            ; LDSUM: LSUM += B (mod 256). Портит A.
  577            ; ---------------------------------------------------------------------
  578  0334: F5       LDSUM:  PUSH PSW
  579  0335: 3A FE FF         LDA LSUM
  580  0338: 80               ADD B
  581  0339: 32 FE FF         STA LSUM
  582  033C: F1               POP PSW
  583  033D: C9               RET
  584            
  585            ; ---------------------------------------------------------------------
  586            ; LDBEEP: длинный сигнал ~0,3 с (тон ~500 Гц, дисплей не трогает -
  587            ; только бит D4 в DIGP). Портит A/D.
  588            ; ---------------------------------------------------------------------
  589  033E: 16 96    LDBEEP: MVI D,150
  590  0340: 3E 1F    LDB1:   MVI A,1Fh           ; SND = 1, разряды on
  591  0342: D3 01            OUT DIGP
  592  0344: CD 2A 03         CALL DLMS
  593  0347: 3E 0F            MVI A,0Fh           ; SND = 0
  594  0349: D3 01            OUT DIGP
  595  034B: CD 2A 03         CALL DLMS
  596  034E: 15               DCR D
  597  034F: C2 40 03         JNZ LDB1
  598  0352: C9               RET
  599            
  600            ; =====================================================================
  601            ; LOADM: Intel HEX загрузчик (клавиша B). Приём SID 4800 8N1.
  602            ; Формат записи: :nnaaaatt[dd...]cc, cc = (-сумма байт) mod 256.
  603            ; Статический дисплей LLLL; адрес каждой записи живёт в ADDRH/L.
  604            ; Запись только в ОЗУ (A15=1): попадание в ROM-окно = ошибка EEEE.
  605            ; Выход: EOF-запись (type 01) -> тик и меню; ошибка -> EEEE + сигнал.
  606            ; Выход из зависшего приёма - RESET (SW20).
  607            ; ---------------------------------------------------------------------
  608  0353: AF       LOADM:  XRA A
  609  0354: 32 FA FF         STA LST             ; ждем ':'
  610  0357: 32 FD FF         STA LACC            ; накопитель тетрад тоже с нуля (баг v1.0:
  611                                        ;  сталь ломала первый байт первой записи)
  612  035A: 3E 38            MVI A,38h           ; 'L'
  613  035C: CD 1C 03         CALL LSTAT
  614  035F: CD C8 02 LDLP:   CALL RXD            ; C = байт, CY = ошибка кадра
  615  0362: DA 97 04         JC LDERR
  616  0365: 79               MOV A,C
  617  0366: FE 3A            CPI ':'
  618  0368: CA 7B 04         JZ LDNEW            ; начало записи
  619  036B: CD FA 02         CALL NIB            ; тетрада?
  620  036E: D2 5F 03         JNC LDLP            ; прочее (\r\n и т.п.) - пропустить
  621  0371: 5F               MOV E,A             ; E = тетрада
  622  0372: 3A FD FF         LDA LACC
  623  0375: 07               RLC
  624  0376: 07               RLC
  625  0377: 07               RLC
  626  0378: 07               RLC                 ; накопитель << 4
  627  0379: B3               ORA E
  628  037A: 32 FD FF         STA LACC
  629  037D: 3A FB FF         LDA LNIB
  630  0380: 3D               DCR A
  631  0381: 32 FB FF         STA LNIB
  632  0384: C2 5F 03         JNZ LDLP            ; байт поля ещё не собран
  633                    ; --- байт поля собран - применить по состоянию ---
  634  0387: 3A FD FF         LDA LACC
  635  038A: 47               MOV B,A             ; B = байт
  636  038B: AF               XRA A
  637  038C: 32 FD FF         STA LACC            ; накопитель очищен к следующему байту
  638  038F: 3A FA FF         LDA LST
  639  0392: B7               ORA A
  640  0393: CA 5F 03         JZ LDLP             ; байт вне записи - игнор
  641  0396: 3D               DCR A
  642  0397: CA A9 03         JZ LDCNT            ; 1 = count
  643  039A: 3D               DCR A
  644  039B: CA BE 03         JZ LDADR            ; 2 = addr
  645  039E: 3D               DCR A
  646  039F: CA F6 03         JZ LDTYP            ; 3 = type
  647  03A2: 3D               DCR A
  648  03A3: CA 29 04         JZ LDDAT            ; 4 = data
  649  03A6: C3 65 04         JMP LDCHK           ; 5 = checksum
  650  03A9: 78       LDCNT:  MOV A,B
  651  03AA: 32 EC FF         STA ADCNT           ; сколько байт данных в записи
  652  03AD: CD 34 03         CALL LDSUM
  653  03B0: 3E 02            MVI A,02h           ; поле addr: 4 тетрады = 2 байта
  654  03B2: 32 FA FF         STA LST
  655  03B5: 32 FC FF         STA LBPC
  656  03B8: 32 FB FF         STA LNIB
  657  03BB: C3 5F 03         JMP LDLP
  658  03BE: 78       LDADR:  MOV A,B
  659  03BF: 32 FF FF         STA LTY             ; временно: тип ещё не читался
  660  03C2: 3A FC FF         LDA LBPC
  661  03C5: FE 02            CPI 02h
  662  03C7: C2 DB 03         JNZ LDAD1
  663  03CA: 3A FF FF         LDA LTY
  664  03CD: 32 EA FF         STA ADDRH           ; старший байт адреса (big-endian)
  665  03D0: 3E 01            MVI A,01h
  666  03D2: 32 FC FF         STA LBPC
  667  03D5: CD 34 03         CALL LDSUM
  668  03D8: C3 5F 03         JMP LDLP
  669  03DB: 3A FF FF LDAD1:  LDA LTY
  670  03DE: 32 EB FF         STA ADDRL           ; младший байт адреса
  671  03E1: CD 34 03         CALL LDSUM
  672  03E4: 3E 03            MVI A,03h
  673  03E6: 32 FA FF         STA LST             ; type
  674  03E9: 3E 01            MVI A,01h
  675  03EB: 32 FC FF         STA LBPC
  676  03EE: 3E 02            MVI A,02h
  677  03F0: 32 FB FF         STA LNIB
  678  03F3: C3 5F 03         JMP LDLP
  679  03F6: 78       LDTYP:  MOV A,B
  680  03F7: 32 FF FF         STA LTY
  681  03FA: CD 34 03         CALL LDSUM
  682  03FD: 3A FF FF         LDA LTY
  683  0400: FE 01            CPI 01h
  684  0402: CA 18 04         JZ LDTYP1
  685  0405: 3A EC FF         LDA ADCNT           ; type 00: данные
  686  0408: 32 FC FF         STA LBPC
  687  040B: 3E 04            MVI A,04h
  688  040D: 32 FA FF         STA LST
  689  0410: 3E 02            MVI A,02h
  690  0412: 32 FB FF         STA LNIB
  691  0415: C3 5F 03         JMP LDLP
  692  0418: AF       LDTYP1: XRA A               ; type 01 (EOF): данных нет
  693  0419: 32 FC FF         STA LBPC
  694  041C: 3E 05            MVI A,05h
  695  041E: 32 FA FF         STA LST
  696  0421: 3E 02            MVI A,02h
  697  0423: 32 FB FF         STA LNIB
  698  0426: C3 5F 03         JMP LDLP
  699  0429: 3A EA FF LDDAT:  LDA ADDRH
  700  042C: E6 80            ANI 80h             ; запись разрешена только в ОЗУ
  701  042E: CA 97 04         JZ LDERR            ; ROM-окно - ошибка
  702  0431: 3A EA FF         LDA ADDRH
  703  0434: 67               MOV H,A
  704  0435: 3A EB FF         LDA ADDRL
  705  0438: 6F               MOV L,A
  706  0439: 70               MOV M,B             ; [ADDR] = байт (writeback CPLD)
  707  043A: 23               INX H
  708  043B: 7C               MOV A,H
  709  043C: 32 EA FF         STA ADDRH
  710  043F: 7D               MOV A,L
  711  0440: 32 EB FF         STA ADDRL
  712  0443: CD 34 03         CALL LDSUM
  713  0446: 3A FC FF         LDA LBPC
  714  0449: 3D               DCR A
  715  044A: 32 FC FF         STA LBPC
  716  044D: C2 5D 04         JNZ LDDAT2
  717  0450: 3E 05            MVI A,05h           ; данные кончились - ждать checksum
  718  0452: 32 FA FF         STA LST
  719  0455: 3E 02            MVI A,02h
  720  0457: 32 FB FF         STA LNIB
  721  045A: C3 5F 03         JMP LDLP
  722  045D: 3E 02    LDDAT2: MVI A,02h
  723  045F: 32 FB FF         STA LNIB
  724  0462: C3 5F 03         JMP LDLP
  725  0465: 3A FE FF LDCHK:  LDA LSUM            ; контрольная сумма записи
  726  0468: 80               ADD B               ; сумма всех байт + cc = 0 mod 256?
  727  0469: C2 97 04         JNZ LDERR
  728  046C: 3A FF FF         LDA LTY
  729  046F: FE 01            CPI 01h
  730  0471: CA 8C 04         JZ LDDONE           ; EOF - конец загрузки
  731  0474: AF               XRA A
  732  0475: 32 FA FF         STA LST             ; ждем ':' следующей записи
  733  0478: C3 5F 03         JMP LDLP
  734  047B: 3E 01    LDNEW:  MVI A,01h           ; ':' - новая запись
  735  047D: 32 FA FF         STA LST
  736  0480: 3E 02            MVI A,02h
  737  0482: 32 FB FF         STA LNIB
  738  0485: AF               XRA A
  739  0486: 32 FE FF         STA LSUM
  740  0489: C3 5F 03         JMP LDLP
  741  048C: CD 85 01 LDDONE: CALL TICKON         ; подтверждение успешной загрузки
  742  048F: AF               XRA A               ; XSTREAM: почистить совместные FFFA/FFFB
  743  0490: 32 FA FF         STA LST             ; (= XSSEQ: SEQ с нуля - клиент логирует рестарт)
  744  0493: 32 FB FF         STA LNIB            ; (= XSPASS: следующий кадр через полный порог)
  745  0496: C9               RET
  746  0497: AF       LDERR:  XRA A               ; XSTREAM: та же чистка при ошибке
  747  0498: 32 FA FF         STA LST
  748  049B: 32 FB FF         STA LNIB
  749  049E: 3E 79            MVI A,79h           ; 'E' -> дисплей EEEE
  750  04A0: CD 1C 03         CALL LSTAT
  751  04A3: CD 3E 03         CALL LDBEEP         ; длинный сигнал
  752  04A6: C9               RET                 ; в меню (ADDRH/L = адрес сбоя, D = просмотр)
  753            
  754            ; =====================================================================
  755            ; RAMT: RAM-тест 8000h-FFE7h (клавиша F). 4 паттерна 00/FF/55/AA:
  756            ; заполнение + контроль побайтно. Статический дисплей = глиф паттерна
  757            ; ("0000"/"FFFF"/"5555"/"AAAA"). Сбой: ADDRH/L = адрес сбоя, EEEE +
  758            ; длинный сигнал. Успех: короткий тик. Стек не трогается: запись до
  759            ; FFE7h, SP = FFE8h, pushes TRAP-глушилки (FFDE/FFDF) вне диапазона
  760            ; контроля не портят паттерн (pop восстанавливает, ранняя запись
  761            ; перекрывается заполнением позже).
  762            ; Портит всё.
  763            ; ---------------------------------------------------------------------
  764  04A7: 21 74 00 RAMT:   LXI H,RAMPAT        ; HL = текущая пара (value+glyph)
  765  04AA: 0E 04            MVI C,04h           ; 4 паттерна
  766  04AC: 7E       RMT0:   MOV A,M             ; A = значение паттерна
  767  04AD: 5F               MOV E,A
  768  04AE: E5               PUSH H              ; указатель пары - на стек (HL уйдёт под заполнение)
  769  04AF: 23               INX H
  770  04B0: 7E               MOV A,M             ; глиф паттерна
  771  04B1: CD 1C 03         CALL LSTAT          ; статический дисплей ("0000" и т.д.)
  772  04B4: 7B               MOV A,E
  773  04B5: 21 00 80         LXI H,8000h
  774  04B8: 77       RMF:    MOV M,A             ; заполнение
  775  04B9: 23               INX H
  776  04BA: 7C               MOV A,H
  777  04BB: FE FE            CPI 0FEh            ; до FFE7h включительно
  778  04BD: C2 B8 04         JNZ RMF
  779  04C0: 7D               MOV A,L
  780  04C1: FE E8            CPI 0E8h
  781  04C3: C2 B8 04         JNZ RMF
  782  04C6: 21 00 80         LXI H,8000h
  783  04C9: 7E       RMV:    MOV A,M             ; контроль
  784  04CA: BB               CMP E
  785  04CB: C2 E6 04         JNZ RMBAD
  786  04CE: 23               INX H
  787  04CF: 7C               MOV A,H
  788  04D0: FE FE            CPI 0FEh
  789  04D2: C2 C9 04         JNZ RMV
  790  04D5: 7D               MOV A,L
  791  04D6: FE E8            CPI 0E8h
  792  04D8: C2 C9 04         JNZ RMV
  793  04DB: E1               POP H               ; HL = пара паттерна
  794  04DC: 23               INX H
  795  04DD: 23               INX H               ; следующая пара
  796  04DE: 0D               DCR C
  797  04DF: C2 AC 04         JNZ RMT0
  798  04E2: CD 85 01         CALL TICKON         ; ОК
  799  04E5: C9               RET
  800  04E6: 22 EB FF RMBAD:  SHLD ADDRL          ; ADDRH/L = адрес сбоя (HL из RMV, до POP!)
  801  04E9: E1               POP H               ; снять указатель пары (баланс стека)
  802  04EA: 3E 79            MVI A,79h           ; 'E' -> EEEE
  803  04EC: CD 1C 03         CALL LSTAT
  804  04EF: CD 3E 03         CALL LDBEEP
  805  04F2: C9               RET                 ; в меню; D = просмотр байта по адресу сбоя
  806            
  807            ; =====================================================================
  808            ;                    XSTREAM v1: ЭКРАН -> UART (порт из beta/xstream,
  809            ;                    SW-вариант: тик от слотов скана, без прерываний)
  810            ; =====================================================================
  811            ; ---------------------------------------------------------------------
  812            ; XSINIT (из START, только холодный старт): демо-экран в B000h,
  813            ; SEQ/PASS = 0. Мониторные переменные не трогаются; B000-B7CF -
  814            ; пользовательская область: ЛЮБАЯ программа может рисовать туда
  815            ; свой текст/графику, клиент xstream_view.ps1 покажет окном.
  816            ; ---------------------------------------------------------------------
  817  04F3: CD 18 05 XSINIT: CALL XBLANK
  818  04F6: 21 C1 07         LXI H,XTBL
  819  04F9: 5E       XSI1:   MOV E,M             ; DE = адрес назначения
  820  04FA: 23               INX H
  821  04FB: 56               MOV D,M
  822  04FC: 23               INX H               ; HL -> src_lo
  823  04FD: 7A               MOV A,D             ; конец таблицы (dst == 0000)?
  824  04FE: B3               ORA E
  825  04FF: CA 10 05         JZ XSI3
  826  0502: 4E               MOV C,M             ; BC = адрес строки (источник)
  827  0503: 23               INX H
  828  0504: 46               MOV B,M
  829  0505: 23               INX H               ; HL -> следующая запись
  830  0506: E5               PUSH H              ; указатель следующей записи -> стек
  831  0507: 60               MOV H,B
  832  0508: 69               MOV L,C
  833  0509: CD 29 05         CALL XCPY           ; ASCIZ [HL] -> [DE], 0 = конец
  834  050C: E1               POP H
  835  050D: C3 F9 04         JMP XSI1
  836  0510: AF       XSI3:   XRA A
  837  0511: 32 FA FF         STA XSSEQ
  838  0514: 32 FB FF         STA XSPASS
  839  0517: C9               RET
  840            
  841  0518: 21 00 B0 XBLANK: LXI H,XBUF          ; 2000 пробелов
  842  051B: 01 D0 07         LXI B,2000
  843  051E: 3E 20    XB1:    MVI A,20h
  844  0520: 77               MOV M,A
  845  0521: 23               INX H
  846  0522: 0B               DCX B
  847  0523: 78               MOV A,B
  848  0524: B1               ORA C
  849  0525: C2 1E 05         JNZ XB1
  850  0528: C9               RET
  851            
  852  0529: 7E       XCPY:   MOV A,M             ; ASCIZ: [HL]->[DE], 0 = конец (A/флаги)
  853  052A: B7               ORA A
  854  052B: C8               RZ
  855  052C: 12               STAX D
  856  052D: 23               INX H
  857  052E: 13               INX D
  858  052F: C3 29 05         JMP XCPY
  859            
  860            ; ---------------------------------------------------------------------
  861            ; XSCHK: SW-тик кадра. A = добавка слотов (1 = слот скана ~0,41 мс на
  862            ; 2,5 МГц, XS_QINC = единица QUNIT/BUNIT ~1,03 мс). Накопитель XSPASS;
  863            ; порог XS_TH -> XSEND (~29,9 мс) и сброс. Портит A/C; D/E/B целы.
  864            ; ---------------------------------------------------------------------
  865  0532: 4F       XSCHK:  MOV C,A
  866  0533: 3A FB FF         LDA XSPASS
  867  0536: 81               ADD C
  868  0537: 32 FB FF         STA XSPASS
  869  053A: FE 47            CPI XS_TH
  870  053C: DA 46 05         JC XSKR             ; < порога - выход
  871  053F: CD 47 05         CALL XSEND          ; КАДР -> UART (~29,9 мс на 2,5 МГц)
  872  0542: AF               XRA A
  873  0543: 32 FB FF         STA XSPASS          ; счётчик заново
  874  0546: C9       XSKR:   RET
  875            
  876            ; ---------------------------------------------------------------------
  877            ; XSEND: кадр XSTREAM в UART: A5 5A [SEQ] + 2000 Б из XBUF.
  878            ;   Сохраняет PSW/B/D/H. РАВНОМЕРНЫЙ пейсинг 35T/Б без опроса TXRDY:
  879            ;   на 2,5 МГц 35T = 14 мкс >= 10 мкс байта 1M - ноль отбросов TX
  880            ;   (запись при busy аппаратно отбрасывается, пейсинг не даёт попасть).
  881            ;   Каждые 200 Б - слот дисплея XDIG (регенерация не замирает, урок 9).
  882            ; ---------------------------------------------------------------------
  883  0547: F5       XSEND:  PUSH PSW
  884  0548: C5               PUSH B
  885  0549: D5               PUSH D
  886  054A: E5               PUSH H
  887  054B: CD F9 05         CALL XUPDCTR        ; живой счётчик SEQ в демо-экран
  888  054E: 3E A5            MVI A,0A5h
  889  0550: D3 04            OUT TXPORT          ; шапка: равномерный пейсинг 33T (4 NOP)
  890  0552: 00               NOP
  891  0553: 00               NOP
  892  0554: 00               NOP
  893  0555: 00               NOP
  894  0556: 3E 5A            MVI A,05Ah
  895  0558: D3 04            OUT TXPORT
  896  055A: 00               NOP
  897  055B: 00               NOP
  898  055C: 00               NOP
  899  055D: 00               NOP
  900  055E: 3A FA FF         LDA XSSEQ
  901  0561: D3 04            OUT TXPORT
  902  0563: 00               NOP
  903  0564: 00               NOP
  904  0565: 00               NOP
  905  0566: 00               NOP
  906  0567: 3C               INR A
  907  0568: 32 FA FF         STA XSSEQ           ; SEQ++ mod 256
  908  056B: 3A F4 FF         LDA DPIDX           ; фаза дисплея: DE = 0FFF5+idx (глиф), C = бит разряда
  909  056E: 4F               MOV C,A
  910  056F: C6 F5            ADI 0F5h
  911  0571: 5F               MOV E,A             ; E = 0F5h..0F8h (младший байт указателя глифа)
  912  0572: 16 FF            MVI D,0FFh          ; D = 0FFh -> DE = 0FFF5h..0FFF8h (DIGIMG0..3)
  913  0574: 79               MOV A,C
  914  0575: 06 00            MVI B,0
  915  0577: 21 54 00         LXI H,BITTBL
  916  057A: 09               DAD B
  917  057B: 7E               MOV A,M
  918  057C: 4F               MOV C,A             ; C = бит разряда 01/02/04/08 (свободен вне inner)
  919  057D: 21 00 B0         LXI H,XBUF          ; HL = экран
  920  0580: 06 0A            MVI B,10            ; внешний: 10 групп по 200 Б (слот дисплея)
  921  0582: 0E 19    XSOUT:  MVI C,25            ; внутренний: 25 подгрупп по 8 Б
  922  0584: 7E       XSL:    MOV A,M
  923  0585: D3 04            OUT TXPORT          ; равномерный пейсинг: гэп OUT->OUT >= 25T байта
  924  0587: 23               INX H
  925  0588: 00               NOP
  926  0589: 00               NOP
  927  058A: 00               NOP
  928  058B: 7E               MOV A,M
  929  058C: D3 04            OUT TXPORT
  930  058E: 23               INX H
  931  058F: 00               NOP
  932  0590: 00               NOP
  933  0591: 00               NOP
  934  0592: 7E               MOV A,M
  935  0593: D3 04            OUT TXPORT
  936  0595: 23               INX H
  937  0596: 00               NOP
  938  0597: 00               NOP
  939  0598: 00               NOP
  940  0599: 7E               MOV A,M
  941  059A: D3 04            OUT TXPORT
  942  059C: 23               INX H
  943  059D: 00               NOP
  944  059E: 00               NOP
  945  059F: 00               NOP
  946  05A0: 7E               MOV A,M
  947  05A1: D3 04            OUT TXPORT
  948  05A3: 23               INX H
  949  05A4: 00               NOP
  950  05A5: 00               NOP
  951  05A6: 00               NOP
  952  05A7: 7E               MOV A,M
  953  05A8: D3 04            OUT TXPORT
  954  05AA: 23               INX H
  955  05AB: 00               NOP
  956  05AC: 00               NOP
  957  05AD: 00               NOP
  958  05AE: 7E               MOV A,M
  959  05AF: D3 04            OUT TXPORT
  960  05B1: 23               INX H
  961  05B2: 00               NOP
  962  05B3: 00               NOP
  963  05B4: 00               NOP
  964  05B5: 7E               MOV A,M
  965  05B6: D3 04            OUT TXPORT
  966  05B8: 23               INX H
  967  05B9: 00               NOP
  968  05BA: 00               NOP
  969  05BB: 00               NOP
  970  05BC: 0D               DCR C               ; подгруппа = 7x35T + 15T = 294T (36.75T/Б)
  971  05BD: C2 84 05         JNZ XSL
  972  05C0: CD CC 05         CALL XDIG           ; слот дисплея (регенерация не замирает)
  973  05C3: 05               DCR B
  974  05C4: C2 82 05         JNZ XSOUT
  975  05C7: E1               POP H
  976  05C8: D1               POP D
  977  05C9: C1               POP B
  978  05CA: F1               POP PSW
  979  05CB: C9               RET
  980            
  981            ; ---------------------------------------------------------------------
  982            ; XDIG: один слот регенерации дисплея ВО ВРЕМЯ посылки.
  983            ;   САМОДОСТАТОЧНАЯ (урок 9 железа v1.2): бит разряда вычисляется из
  984            ;   фазы глифа E (E = 0F5h+idx -> idx = (E+3)&3 -> бит = 01h RLC idx раз)
  985            ;   и живёт в C ПЕРЕЖИВ LDA SNDST (как в REFRESH бит живёт в B) - иначе
  986            ;   LDA снова затирал его в A -> OUT DIGP = 0: дисплей гас на ВСЮ посылку
  987            ;   = 20 Гц «дрожание» на живой плате. DE - ПАРА (урок 11-12 (1): вариант
  988            ;   "D=0F5h, E=бит" читал мусор ОЗУ 0F5xx -> глифы-призраки L.L.L.1).
  989            ;   DPIDX не трогает; портит ТОЛЬКО A/C (C - счётчик подгруппы,
  990            ;   перезагружается MVI C,25 в XSOUT; B/D/E/H целы - HL несёт указатель
  991            ;   экрана, B - счётчик групп). Порядок как в REFRESH:
  992            ;   ГАШЕНИЕ -> РАЗРЯД -> ГЛИФ.
  993            ; ---------------------------------------------------------------------
  994  05CC: AF       XDIG:   XRA A
  995  05CD: D3 00            OUT SEGP            ; (1) гашение
  996  05CF: 7B               MOV A,E             ; E = 0F5h..0F8h (DIGIMG0..3)
  997  05D0: C6 03            ADI 03h
  998  05D2: E6 03            ANI 03h             ; A = idx разряда 0..3 (Z от ANI)
  999  05D4: 4F               MOV C,A
 1000  05D5: 3E 01            MVI A,01h
 1001  05D7: CA DF 05         JZ XDMK             ; idx=0 -> бит уже 01h
 1002  05DA: 07       XDSH:   RLC                 ; 01h -> 02h -> 04h -> 08h
 1003  05DB: 0D               DCR C
 1004  05DC: C2 DA 05         JNZ XDSH
 1005  05DF: 4F       XDMK:   MOV C,A             ; C = бит разряда - ПЕРЕЖИВЁТ LDA (как B в REFRESH)
 1006  05E0: 3A E8 FF         LDA SNDST           ; 0/1 - состояние тона (тоггл в BUNIT)
 1007  05E3: B7               ORA A
 1008  05E4: 79               MOV A,C             ; A = бит (LDA затёр - восстановить из C)
 1009  05E5: CA EA 05         JZ XDG1
 1010  05E8: F6 10            ORI 10h             ; + SND
 1011  05EA: D3 01    XDG1:   OUT DIGP            ; (2) разряд (и тон) включён, сегменты пусты
 1012  05EC: 1A               LDAX D              ; A = глиф [0FFF5h..0FFF8h]
 1013  05ED: D3 00            OUT SEGP            ; (3) глиф горит
 1014  05EF: 13               INX D               ; следующий глиф (E: 0F5..0F8)
 1015  05F0: 7B               MOV A,E
 1016  05F1: FE F9            CPI 0F9h            ; за DIGIMG3?
 1017  05F3: DA F8 05         JC XDG2
 1018  05F6: 1E F5            MVI E,0F5h          ; -> DIGIMG0
 1019  05F8: C9       XDG2:   RET
 1020            
 1021            ; ---------------------------------------------------------------------
 1022            ; XUPDCTR: живой счётчик SEQ (hex, 2 цифры) в демо-экран, строка 22,
 1023            ; колонки 4-5 - доказательство живого потока в клиенте.
 1024            ; ---------------------------------------------------------------------
 1025  05F9: E5       XUPDCTR: PUSH H
 1026  05FA: 3A FA FF         LDA XSSEQ
 1027  05FD: 4F               MOV C,A
 1028  05FE: 0F               RRC
 1029  05FF: 0F               RRC
 1030  0600: 0F               RRC
 1031  0601: 0F               RRC
 1032  0602: E6 0F            ANI 0Fh
 1033  0604: CD 15 06         CALL XHEX
 1034  0607: 32 E4 B6         STA XSCNT
 1035  060A: 79               MOV A,C
 1036  060B: E6 0F            ANI 0Fh
 1037  060D: CD 15 06         CALL XHEX
 1038  0610: 32 E5 B6         STA XSCNT+1
 1039  0613: E1               POP H
 1040  0614: C9               RET
 1041            
 1042  0615: C6 30    XHEX:   ADI '0'
 1043  0617: FE 3A            CPI 3Ah
 1044  0619: DA 1E 06         JC XHX1
 1045  061C: C6 07            ADI 07h
 1046  061E: C9       XHX1:   RET
 1047            
 1048            ; ---- демо-экран (ASCII; NUL-конец; <= 80 символов на строку) ----
 1049  061F: 58 53 54 52 45 41 4D 20 76 31 2E 30 20 2D 20 38 30 78 32 35 20 54 45 58 54 20 53 43 52 45 45 4E 20 42 55 46 46 45 52 20 42 30 30 30 68 2D 42 37 43 46 68 20 2D 3E 20 55 41 52 54 20 31 30 30 30 30 30 30 20 38 4E 31 00 S_T0:   DB 'XSTREAM v1.0 - 80x25 TEXT SCREEN BUFFER B000h-B7CFh -> UART 1000000 8N1',0
 1050  0667: 46 52 41 4D 45 3A 20 41 35 20 35 41 20 5B 53 45 51 5D 20 2B 20 32 30 30 30 20 42 59 54 45 53 20 28 52 4F 57 2D 4D 41 4A 4F 52 20 38 30 78 32 35 20 2F 20 43 50 31 32 35 31 20 41 54 20 50 43 20 43 4C 49 45 4E 54 29 00 S_T1:   DB 'FRAME: A5 5A [SEQ] + 2000 BYTES (ROW-MAJOR 80x25 / CP1251 AT PC CLIENT)',0
 1051  06AF: 46 57 3A 20 6D 6F 6E 69 74 6F 72 32 37 20 2B 20 58 53 54 52 45 41 4D 20 2D 20 53 57 2D 54 49 43 4B 20 7E 31 37 20 46 50 53 20 40 20 35 30 25 20 43 50 55 20 41 54 20 32 2E 35 20 4D 48 5A 20 28 43 50 4C 44 20 76 32 37 29 00 S_T2:   DB 'FW: monitor27 + XSTREAM - SW-TICK ~17 FPS @ 50% CPU AT 2.5 MHZ (CPLD v27)',0
 1052  06F9: 4D 4F 4E 49 54 4F 52 3A 20 41 3D 41 44 44 52 20 20 43 3D 43 4F 44 45 20 20 44 3D 56 49 45 57 20 20 45 3D 52 55 4E 20 20 42 3D 48 45 58 20 4C 4F 41 44 20 20 46 3D 52 41 4D 20 54 45 53 54 20 20 46 31 3D 4D 45 4E 55 00 S_T3:   DB 'MONITOR: A=ADDR  C=CODE  D=VIEW  E=RUN  B=HEX LOAD  F=RAM TEST  F1=MENU',0
 1053  0741: 57 52 49 54 45 20 59 4F 55 52 20 54 45 58 54 20 49 4E 54 4F 20 42 30 30 30 68 2E 2E 42 37 43 46 68 20 2D 20 54 48 49 53 20 57 49 4E 44 4F 57 20 49 53 20 54 48 45 20 50 43 20 53 43 52 45 45 4E 00 S_T4:   DB 'WRITE YOUR TEXT INTO B000h..B7CFh - THIS WINDOW IS THE PC SCREEN',0
 1054  0782: 53 45 51 3A 5F 5F 20 53 45 4E 44 20 32 39 2E 39 20 4D 53 20 4F 46 20 35 39 2E 33 20 4D 53 20 3D 20 35 30 25 20 43 50 55 20 7C 20 4C 49 4E 45 20 34 30 25 20 41 54 20 31 4D 20 42 41 55 44 00 S_T5:   DB 'SEQ:__ SEND 29.9 MS OF 59.3 MS = 50% CPU | LINE 40% AT 1M BAUD',0
 1055  07C1: 00 B0 1F 06 XTBL:   DW XBUF, S_T0       ; строка 0
 1056  07C5: A0 B0 67 06         DW XBUF+00A0h, S_T1 ; строка 2
 1057  07C9: F0 B0 AF 06         DW XBUF+00F0h, S_T2 ; строка 3
 1058  07CD: 80 B2 F9 06         DW XBUF+0280h, S_T3 ; строка 5
 1059  07D1: 20 B3 41 07         DW XBUF+0320h, S_T4 ; строка 6
 1060  07D5: E0 B6 82 07         DW XBUF+06E0h, S_T5 ; строка 22 (счётчик SEQ живой, кол. 4-5)
 1061  07D9: 00 00 00 00         DW 0000h, 0000h     ; конец таблицы
 1062            
 1063            ; =====================================================================
 1064            ; MAIN: как v5 (константы под 2,5 МГц) + баннер TX @1M
 1065            ; =====================================================================
 1066  07DD: F3       START:  DI
 1067  07DE: 31 E8 FF         LXI SP,SP0
 1068  07E1: 3E 80            MVI A,80h           ; адрес по умолчанию 8000h (начало ОЗУ)
 1069  07E3: 32 EA FF         STA ADDRH
 1070  07E6: AF               XRA A
 1071  07E7: 32 EB FF         STA ADDRL
 1072  07EA: CD F3 04         CALL XSINIT         ; XSTREAM: демо-экран B000h, SEQ/PASS=0
 1073  07ED: AF       MAIN2:  XRA A
 1074  07EE: D3 00            OUT SEGP            ; дисплей погашен (после сброса горело "8.")
 1075  07F0: D3 01            OUT DIGP            ; разряды off, SND off
 1076  07F2: D3 02            OUT KBCOLP          ; колонки off (безопасный INIT)
 1077  07F4: 32 E8 FF         STA SNDST
 1078  07F7: 32 EC FF         STA ADCNT
 1079  07FA: 32 F1 FF         STA BDCNT
 1080  07FD: 32 F4 FF         STA DPIDX
 1081  0800: 32 E9 FF         STA STATE           ; ST_MENU
 1082  0803: 32 F9 FF         STA PREVST
 1083  0806: 32 FB FF         STA XSPASS          ; накопитель кадров заново (после MONRET тоже)
 1084  0809: CD 9F 01         CALL REDRAW         ; "ACdE"
 1085  080C: 21 6C 00         LXI H,TXBAN         ; баннер: терминал 1M читает, 4800 = мусор
 1086  080F: CD B9 02         CALL TXSTR
 1087            
