  906            ; =====================================================================
  907            ;                    XSTREAM: ЭКРАН -> UART (п.5: непрерывный поток,
  908            ;                    тик кадра = сама скорость канала, регенерацию
  909            ;                    ведёт TMISR - XDIG-паузы внутри посылки удалены)
  910            ; =====================================================================
  911            ; ---------------------------------------------------------------------
  912            ; XSINIT (из START, только холодный старт): демо-экран в B000h,
  913            ; SEQ = 0. Мониторные переменные не трогаются; B000-B7CF -
  914            ; пользовательская область: ЛЮБАЯ программа может рисовать туда
  915            ; свой текст/графику, клиент xstream_view.ps1 покажет окном.
  916            ; ---------------------------------------------------------------------
  917  0527: CD 49 05 XSINIT: CALL XBLANK
  918  052A: 21 AA 07         LXI H,XTBL
  919  052D: 5E       XSI1:   MOV E,M             ; DE = адрес назначения
  920  052E: 23               INX H
  921  052F: 56               MOV D,M
  922  0530: 23               INX H               ; HL -> src_lo
  923  0531: 7A               MOV A,D             ; конец таблицы (dst == 0000)?
  924  0532: B3               ORA E
  925  0533: CA 44 05         JZ XSI3
  926  0536: 4E               MOV C,M             ; BC = адрес строки (источник)
  927  0537: 23               INX H
  928  0538: 46               MOV B,M
  929  0539: 23               INX H               ; HL -> следующая запись
  930  053A: E5               PUSH H              ; указатель следующей записи -> стек
  931  053B: 60               MOV H,B
  932  053C: 69               MOV L,C
  933  053D: CD 5A 05         CALL XCPY           ; ASCIZ [HL] -> [DE], 0 = конец
  934  0540: E1               POP H
  935  0541: C3 2D 05         JMP XSI1
  936  0544: AF       XSI3:   XRA A
  937  0545: 32 FA FF         STA XSSEQ
  938  0548: C9               RET
  939            
  940  0549: 21 00 B0 XBLANK: LXI H,XBUF          ; 2000 пробелов
  941  054C: 01 D0 07         LXI B,2000
  942  054F: 3E 20    XB1:    MVI A,20h
  943  0551: 77               MOV M,A
  944  0552: 23               INX H
  945  0553: 0B               DCX B
  946  0554: 78               MOV A,B
  947  0555: B1               ORA C
  948  0556: C2 4F 05         JNZ XB1
  949  0559: C9               RET
  950            
  951  055A: 7E       XCPY:   MOV A,M             ; ASCIZ: [HL]->[DE], 0 = конец (A/флаги)
  952  055B: B7               ORA A
  953  055C: C8               RZ
  954  055D: 12               STAX D
  955  055E: 23               INX H
  956  055F: 13               INX D
  957  0560: C3 5A 05         JMP XCPY
