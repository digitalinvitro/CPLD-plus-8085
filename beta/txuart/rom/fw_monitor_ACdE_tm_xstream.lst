  684            ; ---------------------------------------------------------------------
  685            ; LDBEEP: длинный сигнал ~0,3 с (тон ~700 Гц имитируем тогглом D4 DIGP
  686            ; вручную: в B/F таймер СТОП - ISR не пишет DIGP, конфликта нет).
  687            ; Портит A/B/C/D.
  688            ; ---------------------------------------------------------------------
  689  0380: 16 96    LDBEEP: MVI D,150
  690  0382: 3E 1F    LDB1:   MVI A,1Fh           ; SND = 1, разряды on
  691  0384: D3 01            OUT DIGP
  692  0386: CD 6C 03         CALL DLMS
  693  0389: 3E 0F            MVI A,0Fh           ; SND = 0
  694  038B: D3 01            OUT DIGP
  695  038D: CD 6C 03         CALL DLMS
  696  0390: 15               DCR D
  697  0391: C2 82 03         JNZ LDB1
  698  0394: C9               RET
