  851  04DA: C9               RET                 ; в меню (ADDRH/L = адрес сбоя, D = просмотр)
  852            
  853            ; =====================================================================
  854            ; RAMT: RAM-тест 8000h-FFE7h (клавиша F). 4 паттерна 00/FF/55/AA:
  855            ; заполнение + контроль побайтно. Статический дисплей = глиф паттерна
  856            ; ("0000"/"FFFF"/"5555"/"AAAA"). Сбой: ADDRH/L = адрес сбоя, EEEE +
  857            ; длинный сигнал. Успех: короткий тик. Вход через KRAM с TMOFF:
  858            ; таймер СТОП - ISR не толкает стек в диапазон теста (в v27 глушилка
  859            ; TRAP писала 2 Б в FFDE/FFDF - приходилось оговаривать; здесь тест
  860            ; КРИСТАЛЬНО чистый). Стек до FFD4h не доходит (RAMT без длинных push).
  861            ; Портит всё (кроме клеток монитора).
  862            ; ---------------------------------------------------------------------
  863  04DB: 21 76 00 RAMT:   LXI H,RAMPAT        ; HL = текущая пара (value+glyph)
  864  04DE: 0E 04            MVI C,04h           ; 4 паттерна
  865  04E0: 7E       RMT0:   MOV A,M             ; A = значение паттерна
  866  04E1: 5F               MOV E,A
  867  04E2: E5               PUSH H              ; указатель пары - на стек (HL уйдёт под заполнение)
  868  04E3: 23               INX H
  869  04E4: 7E               MOV A,M             ; глиф паттерна
  870  04E5: CD 5E 03         CALL LSTAT          ; статический дисплей ("0000" и т.д.)
  871  04E8: 7B               MOV A,E
  872  04E9: 21 00 80         LXI H,8000h
  873  04EC: 77       RMF:    MOV M,A             ; заполнение
  874  04ED: 23               INX H
  875  04EE: 7C               MOV A,H
  876  04EF: FE FE            CPI 0FEh            ; до FFE7h включительно
  877  04F1: C2 EC 04         JNZ RMF
  878  04F4: 7D               MOV A,L
  879  04F5: FE E8            CPI 0E8h
  880  04F7: C2 EC 04         JNZ RMF
  881  04FA: 21 00 80         LXI H,8000h
  882  04FD: 7E       RMV:    MOV A,M             ; контроль
  883  04FE: BB               CMP E
  884  04FF: C2 1A 05         JNZ RMBAD
  885  0502: 23               INX H
  886  0503: 7C               MOV A,H
  887  0504: FE FE            CPI 0FEh
  888  0506: C2 FD 04         JNZ RMV
  889  0509: 7D               MOV A,L
  890  050A: FE E8            CPI 0E8h
  891  050C: C2 FD 04         JNZ RMV
  892  050F: E1               POP H               ; HL = пара паттерна
  893  0510: 23               INX H
  894  0511: 23               INX H               ; следующая пара
  895  0512: 0D               DCR C
  896  0513: C2 E0 04         JNZ RMT0
  897  0516: CD BE 01         CALL TICKON         ; ОК
  898  0519: C9               RET
  899  051A: 22 EB FF RMBAD:  SHLD ADDRL          ; ADDRH/L = адрес сбоя (HL из RMV, до POP!)
  900  051D: E1               POP H               ; снять указатель пары (баланс стека)
  901  051E: 3E 79            MVI A,79h           ; 'E' -> EEEE
  902  0520: CD 5E 03         CALL LSTAT
  903  0523: CD 80 03         CALL LDBEEP
  904  0526: C9               RET                 ; в меню; D = просмотр байта по адресу сбоя
