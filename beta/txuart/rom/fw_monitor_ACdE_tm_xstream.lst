  700            ; =====================================================================
  701            ; LOADM: Intel HEX загрузчик (клавиша B). Приём SID 4800 8N1.
  702            ; Вход через KLD с TMOFF (таймер СТОП, DI) - как v27 по логике парсера.
  703            ; Формат записи: :nnaaaatt[dd...]cc, cc = (-сумма байт) mod 256.
  704            ; Статический дисплей LLLL; адрес каждой записи живёт в ADDRH/L.
  705            ; Запись только в ОЗУ (A15=1): попадание в ROM-окно = ошибка EEEE.
  706            ; Выход: EOF-запись (type 01) -> тик и меню; ошибка -> EEEE + сигнал.
  707            ; Выход из зависшего приёма - RESET (SW20).
  708            ; NOTE: LACC/LNIB/LBPC/LSUM/LTY = клетки FFFB-FFFF; в обычном режиме
  709            ; FFFC-FFFF заняты KRAW (ISR) - в B таймер СТОП, конфликта нет; TMON
  710            ; на выходе чистит KRAW. XSSEQ/LST = FFFA: на входе LST=0 (=SEQ 0 -
  711            ; клиент логирует рестарт потока), на выходе TMON -> новое SEQ с 0.
  712            ; ---------------------------------------------------------------------
  713  0395: AF       LOADM:  XRA A
  714  0396: 32 FA FF         STA LST             ; ждем ':' (и XSSEQ = 0 - рестарт потока клиента)
  715  0399: 32 FD FF         STA LACC            ; накопитель тетрад тоже с нуля (баг v1.0:
  716                                        ;  сталь ломала первый байт первой записи)
  717  039C: 3E 38            MVI A,38h           ; 'L'
  718  039E: CD 5E 03         CALL LSTAT
  719  03A1: CD 0A 03 LDLP:   CALL RXD            ; C = байт, CY = ошибка кадра
  720  03A4: DA D2 04         JC LDERR
  721  03A7: 79               MOV A,C
  722  03A8: FE 3A            CPI ':'
  723  03AA: CA BD 04         JZ LDNEW            ; начало записи
  724  03AD: CD 3C 03         CALL NIB            ; тетрада?
  725  03B0: D2 A1 03         JNC LDLP            ; прочее (\r\n и т.п.) - пропустить
  726  03B3: 5F               MOV E,A             ; E = тетрада (таймер СТОП - E свободен)
  727  03B4: 3A FD FF         LDA LACC
  728  03B7: 07               RLC
  729  03B8: 07               RLC
  730  03B9: 07               RLC
  731  03BA: 07               RLC                 ; накопитель << 4
  732  03BB: B3               ORA E
  733  03BC: 32 FD FF         STA LACC
  734  03BF: 3A FB FF         LDA LNIB
  735  03C2: 3D               DCR A
  736  03C3: 32 FB FF         STA LNIB
  737  03C6: C2 A1 03         JNZ LDLP            ; байт поля ещё не собран
  738                    ; --- байт поля собран - применить по состоянию ---
  739  03C9: 3A FD FF         LDA LACC
  740  03CC: 47               MOV B,A             ; B = байт
  741  03CD: AF               XRA A
  742  03CE: 32 FD FF         STA LACC            ; накопитель очищен к следующему байту
  743  03D1: 3A FA FF         LDA LST
  744  03D4: B7               ORA A
  745  03D5: CA A1 03         JZ LDLP             ; байт вне записи - игнор
  746  03D8: 3D               DCR A
  747  03D9: CA EB 03         JZ LDCNT            ; 1 = count
  748  03DC: 3D               DCR A
  749  03DD: CA 00 04         JZ LDADR            ; 2 = addr
  750  03E0: 3D               DCR A
  751  03E1: CA 38 04         JZ LDTYP            ; 3 = type
  752  03E4: 3D               DCR A
  753  03E5: CA 6B 04         JZ LDDAT            ; 4 = data
  754  03E8: C3 A7 04         JMP LDCHK           ; 5 = checksum
  755  03EB: 78       LDCNT:  MOV A,B
  756  03EC: 32 EC FF         STA ADCNT           ; сколько байт данных в записи
  757  03EF: CD 76 03         CALL LDSUM
  758  03F2: 3E 02            MVI A,02h           ; поле addr: 4 тетрады = 2 байта
  759  03F4: 32 FA FF         STA LST
  760  03F7: 32 FC FF         STA LBPC
  761  03FA: 32 FB FF         STA LNIB
  762  03FD: C3 A1 03         JMP LDLP
  763  0400: 78       LDADR:  MOV A,B
  764  0401: 32 FF FF         STA LTY             ; временно: тип ещё не читался
  765  0404: 3A FC FF         LDA LBPC
  766  0407: FE 02            CPI 02h
  767  0409: C2 1D 04         JNZ LDAD1
  768  040C: 3A FF FF         LDA LTY
  769  040F: 32 EA FF         STA ADDRH           ; старший байт адреса (big-endian)
  770  0412: 3E 01            MVI A,01h
  771  0414: 32 FC FF         STA LBPC
  772  0417: CD 76 03         CALL LDSUM
  773  041A: C3 A1 03         JMP LDLP
  774  041D: 3A FF FF LDAD1:  LDA LTY
  775  0420: 32 EB FF         STA ADDRL           ; младший байт адреса
  776  0423: CD 76 03         CALL LDSUM
  777  0426: 3E 03            MVI A,03h
  778  0428: 32 FA FF         STA LST             ; type
  779  042B: 3E 01            MVI A,01h
  780  042D: 32 FC FF         STA LBPC
  781  0430: 3E 02            MVI A,02h
  782  0432: 32 FB FF         STA LNIB
  783  0435: C3 A1 03         JMP LDLP
  784  0438: 78       LDTYP:  MOV A,B
  785  0439: 32 FF FF         STA LTY
  786  043C: CD 76 03         CALL LDSUM
  787  043F: 3A FF FF         LDA LTY
  788  0442: FE 01            CPI 01h
  789  0444: CA 5A 04         JZ LDTYP1
  790  0447: 3A EC FF         LDA ADCNT           ; type 00: данные
  791  044A: 32 FC FF         STA LBPC
  792  044D: 3E 04            MVI A,04h
  793  044F: 32 FA FF         STA LST
  794  0452: 3E 02            MVI A,02h
  795  0454: 32 FB FF         STA LNIB
  796  0457: C3 A1 03         JMP LDLP
  797  045A: AF       LDTYP1: XRA A               ; type 01 (EOF): данных нет
  798  045B: 32 FC FF         STA LBPC
  799  045E: 3E 05            MVI A,05h
  800  0460: 32 FA FF         STA LST
  801  0463: 3E 02            MVI A,02h
  802  0465: 32 FB FF         STA LNIB
  803  0468: C3 A1 03         JMP LDLP
  804  046B: 3A EA FF LDDAT:  LDA ADDRH
  805  046E: E6 80            ANI 80h             ; запись разрешена только в ОЗУ
  806  0470: CA D2 04         JZ LDERR            ; ROM-окно - ошибка
  807  0473: 3A EA FF         LDA ADDRH
  808  0476: 67               MOV H,A
  809  0477: 3A EB FF         LDA ADDRL
  810  047A: 6F               MOV L,A
  811  047B: 70               MOV M,B             ; [ADDR] = байт (writeback CPLD)
  812  047C: 23               INX H
  813  047D: 7C               MOV A,H
  814  047E: 32 EA FF         STA ADDRH
  815  0481: 7D               MOV A,L
  816  0482: 32 EB FF         STA ADDRL
  817  0485: CD 76 03         CALL LDSUM
  818  0488: 3A FC FF         LDA LBPC
  819  048B: 3D               DCR A
  820  048C: 32 FC FF         STA LBPC
  821  048F: C2 9F 04         JNZ LDDAT2
  822  0492: 3E 05            MVI A,05h           ; данные кончились - ждать checksum
  823  0494: 32 FA FF         STA LST
  824  0497: 3E 02            MVI A,02h
  825  0499: 32 FB FF         STA LNIB
  826  049C: C3 A1 03         JMP LDLP
  827  049F: 3E 02    LDDAT2: MVI A,02h
  828  04A1: 32 FB FF         STA LNIB
  829  04A4: C3 A1 03         JMP LDLP
  830  04A7: 3A FE FF LDCHK:  LDA LSUM            ; контрольная сумма записи
  831  04AA: 80               ADD B               ; сумма всех байт + cc = 0 mod 256?
  832  04AB: C2 D2 04         JNZ LDERR
  833  04AE: 3A FF FF         LDA LTY
  834  04B1: FE 01            CPI 01h
  835  04B3: CA CE 04         JZ LDDONE           ; EOF - конец загрузки
  836  04B6: AF               XRA A
  837  04B7: 32 FA FF         STA LST             ; ждем ':' следующей записи
  838  04BA: C3 A1 03         JMP LDLP
  839  04BD: 3E 01    LDNEW:  MVI A,01h           ; ':' - новая запись
  840  04BF: 32 FA FF         STA LST
  841  04C2: 3E 02            MVI A,02h
  842  04C4: 32 FB FF         STA LNIB
  843  04C7: AF               XRA A
  844  04C8: 32 FE FF         STA LSUM
  845  04CB: C3 A1 03         JMP LDLP
  846  04CE: CD BE 01 LDDONE: CALL TICKON         ; подтверждение успешной загрузки
  847  04D1: C9               RET
  848  04D2: 3E 79    LDERR:  MVI A,79h           ; 'E' -> дисплей EEEE
  849  04D4: CD 5E 03         CALL LSTAT
