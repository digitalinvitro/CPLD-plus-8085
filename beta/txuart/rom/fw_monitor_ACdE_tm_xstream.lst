  959            ; ---------------------------------------------------------------------
  960            ; XSEND: кадр XSTREAM в UART: A5 5A [SEQ] + 2000 Б из XBUF.
  961            ;   Сохраняет PSW/B/D/H. РАВНОМЕРНЫЙ пейсинг 35T/Б без опроса TXRDY:
  962            ;   на 2,5 МГц 35T = 14 мкс >= 10 мкс байта 1M; ISR-вставки только
  963            ;   УДЛИНЯЮТ гэпы (регенерация/скан в слоте) - ноль отбросов TX.
  964            ;   XDIG-паузы УДАЛЕНЫ против v27: регенерацию ведёт TMISR, поток
  965            ;   не замирает (урок 9 v1.2 закрыт архитектурно). E не трогает
  966            ;   (счётчик слотов ISR). Кадр ~56 мс @2,5 МГц (~18 FPS), ~42 мс
  967            ;   @3,125 МГц (~24 FPS).
  968            ; ---------------------------------------------------------------------
  969  0563: F5       XSEND:  PUSH PSW
  970  0564: C5               PUSH B
  971  0565: D5               PUSH D
  972  0566: E5               PUSH H
  973  0567: CD D3 05         CALL XUPDCTR        ; живой счётчик SEQ в демо-экран
  974  056A: 3E A5            MVI A,0A5h
  975  056C: D3 04            OUT TXPORT          ; шапка: равномерный пейсинг 33T (4 NOP)
  976  056E: 00               NOP
  977  056F: 00               NOP
  978  0570: 00               NOP
  979  0571: 00               NOP
  980  0572: 3E 5A            MVI A,05Ah
  981  0574: D3 04            OUT TXPORT
  982  0576: 00               NOP
  983  0577: 00               NOP
  984  0578: 00               NOP
  985  0579: 00               NOP
  986  057A: 3A FA FF         LDA XSSEQ
  987  057D: D3 04            OUT TXPORT
  988  057F: 00               NOP
  989  0580: 00               NOP
  990  0581: 00               NOP
  991  0582: 00               NOP
  992  0583: 3C               INR A
  993  0584: 32 FA FF         STA XSSEQ           ; SEQ++ mod 256
  994  0587: 21 00 B0         LXI H,XBUF          ; HL = экран
  995  058A: 06 0A            MVI B,10            ; внешний: 10 групп по 200 Б
  996  058C: 0E 19    XSOUT:  MVI C,25            ; внутренний: 25 подгрупп по 8 Б
  997  058E: 7E       XSL:    MOV A,M
  998  058F: D3 04            OUT TXPORT          ; равномерный пейсинг: гэп OUT->OUT >= 25T байта
  999  0591: 23               INX H
