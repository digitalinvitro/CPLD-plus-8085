  933            ; =====================================================================
  934            ;                    XSTREAM: ЭКРАН -> UART (п.8: непрерывный поток,
  935            ;                    тик кадра = сама скорость канала, регенерация/
  936            ;                    скан ведётся пульками TMIARM внутри посылки)
  937            ; =====================================================================
  938            ; ---------------------------------------------------------------------
  939            ; XSINIT (из START, только холодный старт): демо-экран в B000h,
  940            ; SEQ = 0. Мониторные переменные не трогаются; B000-B7CF -
  941            ; пользовательская область: ЛЮБАЯ программа может рисовать туда
  942            ; свой текст/графику, клиент xstream_view.ps1 покажет окном.
  943            ; ---------------------------------------------------------------------
  944  0529: CD 4B 05 XSINIT: CALL XBLANK
  945  052C: 21 AB 07         LXI H,XTBL
  946  052F: 5E       XSI1:   MOV E,M             ; DE = адрес назначения
  947  0530: 23               INX H
  948  0531: 56               MOV D,M
  949  0532: 23               INX H               ; HL -> src_lo
  950  0533: 7A               MOV A,D             ; конец таблицы (dst == 0000)?
  951  0534: B3               ORA E
  952  0535: CA 46 05         JZ XSI3
  953  0538: 4E               MOV C,M             ; BC = адрес строки (источник)
  954  0539: 23               INX H
  955  053A: 46               MOV B,M
  956  053B: 23               INX H               ; HL -> следующая запись
  957  053C: E5               PUSH H              ; указатель следующей записи -> стек
  958  053D: 60               MOV H,B
  959  053E: 69               MOV L,C
  960  053F: CD 5C 05         CALL XCPY           ; ASCIZ [HL] -> [DE], 0 = конец
  961  0542: E1               POP H
  962  0543: C3 2F 05         JMP XSI1
  963  0546: AF       XSI3:   XRA A
  964  0547: 32 FA FF         STA XSSEQ
  965  054A: C9               RET
  966            
  967  054B: 21 00 B0 XBLANK: LXI H,XBUF          ; 2000 пробелов
  968  054E: 01 D0 07         LXI B,2000
  969  0551: 3E 20    XB1:    MVI A,20h
  970  0553: 77               MOV M,A
  971  0554: 23               INX H
  972  0555: 0B               DCX B
  973  0556: 78               MOV A,B
  974  0557: B1               ORA C
  975  0558: C2 51 05         JNZ XB1
  976  055B: C9               RET
  977            
  978  055C: 7E       XCPY:   MOV A,M             ; ASCIZ: [HL]->[DE], 0 = конец (A/флаги)
  979  055D: B7               ORA A
  980  055E: C8               RZ
  981  055F: 12               STAX D
  982  0560: 23               INX H
  983  0561: 13               INX D
  984  0562: C3 5C 05         JMP XCPY
  985            
  986            ; ---------------------------------------------------------------------
  987            ; XSEND: кадр XSTREAM в UART: A5 5A [SEQ] + 2000 Б из XBUF.
  988            ;   Сохраняет PSW/B/D/H. РАВНОМЕРНЫЙ пейсинг 36,75T/Б без опроса TXRDY:
  989            ;   на 3,125 МГц 36,75T = 11,8 мкс >= 10 мкс байта 1M. ПУЛЬКА TMIARM в
  990            ;   шапке КАЖДОЙ 8-Б подгруппы (~94 мкс): ISR-вставки только УДЛИНЯЮТ
  991            ;   гэпы (мин. 25T соблюдён) - ноль отбросов TX; регенерация/скан идут
  992            ;   ВНУТРИ посылки (каденция слота ~0,7 мс, как у v1.2). E не трогает
  993            ;   (счётчик слотов ISR). Кадр ~37 мс с пульками (~27 FPS; v1.2: ~42).
  994            ; ---------------------------------------------------------------------
  995  0565: F5       XSEND:  PUSH PSW
  996  0566: C5               PUSH B
  997  0567: D5               PUSH D
  998  0568: E5               PUSH H
  999  0569: CD D8 05         CALL XUPDCTR        ; живой счётчик SEQ в демо-экран
 1000  056C: 3E A5            MVI A,0A5h
 1001  056E: D3 04            OUT TXPORT          ; шапка: равномерный пейсинг 33T (4 NOP)
 1002  0570: 00               NOP
 1003  0571: 00               NOP
 1004  0572: 00               NOP
 1005  0573: 00               NOP
 1006  0574: 3E 5A            MVI A,05Ah
 1007  0576: D3 04            OUT TXPORT
 1008  0578: 00               NOP
 1009  0579: 00               NOP
 1010  057A: 00               NOP
 1011  057B: 00               NOP
 1012  057C: 3A FA FF         LDA XSSEQ
 1013  057F: D3 04            OUT TXPORT
 1014  0581: 00               NOP
 1015  0582: 00               NOP
 1016  0583: 00               NOP
 1017  0584: 00               NOP
 1018  0585: 3C               INR A
 1019  0586: 32 FA FF         STA XSSEQ           ; SEQ++ mod 256
 1020  0589: 21 00 B0         LXI H,XBUF          ; HL = экран
 1021  058C: 06 0A            MVI B,10            ; внешний: 10 групп по 200 Б
 1022  058E: 0E 19    XSOUT:  MVI C,25            ; внутренний: 25 подгрупп по 8 Б
 1023  0590: CD 23 01 XSL:    CALL TMIARM         ; пулька слота на подгруппу (~94 мкс): ISR
 1024  0593: 7E               MOV A,M             ; удлиняет гэп, ноль отбросов TX (п.8)
