    1            ; =====================================================================
    2            ; beta/txuart/rom/uart_tx_test.asm -- железная проверка аппаратного
    3            ; передатчика UART v2.2 (beta/txuart, узел /4 на 25 МГц, шунт H1).
    4            ;
    5            ; Частоты (v2.2): вход CPLD 25 МГц (H1 С ШУНТОМ!), кольцо s0..s3 ->
    6            ;   X1 = 6,25 МГц (duty 1/4), /2 ВМ85А -> CPU 3,125 МГц, T = 320 нс.
    7            ; UART: 1 562 500 8N1 (25 МГц / 16), аппаратное ядро v2.1 (18 МЦ).
    8            ;   OUT 04h = TXDATA (запись при TXRDY=0 - байт ТИХО ОТБРАСЫВАЕТСЯ!)
    9            ;   IN  05h = статус: бит A1 = TXRDY (1 = ядро idle, можно стартовать)
   10            ;   Окно POR: запись 04h при por_run отбрасывается ядром (CPU в это
   11            ;   время в reset, до старта прошивки не доходит).
   12            ; Контракт: README beta/txuart ("Контракт (для прошивки)" п.1-4).
   13            ;
   14            ; Что делает прошивка:
   15            ;   1) Раз в ~200 мс шлёт строку "TXUART v2.2 OK N=xx" + CR LF,
   16            ;      xx = счётчик строк (hex, mod 256). Каждый байт - строго после
   17            ;      поллинга TXRDY=1 (IN 05h, ANI 02h).
   18            ;   2) Индикация: мультиплекс 7-сегм. 1 мс/разряд (250 Гц):
   19            ;      DIG3='t' (тест идёт), DIG2=DIG1='-', DIG0=мл. нибл счётчика.
   20            ;      OUT 00h = сегменты (1 = горит), OUT 01h = разряды (A3..A0),
   21            ;      бит A4 порта 01h = SND - держится 0 (звук молчит).
   22            ;   3) Прерывания запрещены (DI; линии INT заземлены PGND), стек
   23            ;      в ОЗУ 8000h-FFFFh на 0E000h.
   24            ;
   25            ; Проверка на ПК: терминал 1 562 500 8N1 (CH340G), ~5 строк/с,
   26            ;   счётчик N инкрементируется. Нет строк, но индикатор жив -> TX-путь
   27            ;   (CPLD P39 -> CH340G RXD) или терминал; нет и индикатора -> CPU/шина.
   28            ;
   29            ; Сборка: python3 beta/01_timer/rom/asm85.py
   30            ;           beta/txuart/rom/uart_tx_test.asm
   31            ;           -o beta/txuart/rom/uart_tx_test.hex
   32            ;           -l beta/txuart/rom/uart_tx_test.lst
   33            ; Симуляция: python3 beta/txuart/rom/sim_uart_tx_test.py
   34            ;            (интерпретатор 8085 по .hex + модель TXRDY/дисплея).
   35            ;
   36            ; Кодировка исходника: CP1251 (канон проекта); _utf8-двойник рядом.
   37            ; =====================================================================
   38            
   39            ; ---- порты CPLD (карта beta/txuart README + PORTS_MAP) --------------
   40            K_PSEG   EQU 00h            ; сегменты индикатора (регистр 1 = горит)
   41            K_PDIG   EQU 01h            ; разряды A3..A0 (1 = разряд горит); A4 = SND
   42            K_PTX    EQU 04h            ; TXDATA: старт кадра (только при TXRDY=1!)
   43            K_PST    EQU 05h            ; статус: A1 = TXRDY
   44            K_TXRDY  EQU 02h            ; маска TXRDY в статусе
   45            K_MS     EQU 200            ; пауза между строками, мс
   46            K_1MS    EQU 212            ; счётчик 1-мс среза: 3131 T ~ 1001,9 мкс
   47            K_SP     EQU 0E000h         ; стек в верхней половине ОЗУ
   48            
   49            K_PHTAB  EQU 02h            ; страница HTAB (таблица глифов, 0200h..020Fh)
   50            K_PDTAB  EQU 03h            ; страница DTAB (маски разрядов, 0300h..0303h)
   51            G_MINUS  EQU 40h            ; глиф '-' (сегмент g)
   52            G_T      EQU 78h            ; глиф 't' (сегменты d,e,f,g)
   53            
   54            ; ---------------------------------------------------------------------
   55  0000: -                 ORG  0000h
   56  0000: C3 00 01          JMP  START         ; вектор сброса; RST 08/10/... не используются
   57            
   58  0100: -                 ORG  0100h
   59  0100: F3       START:   DI                 ; прерываний нет и не будет (INT -> PGND)
   60  0101: 31 00 E0          LXI  SP,K_SP       ; стек
   61  0104: 0E 00             MVI  C,00h         ; счётчик строк N (показ на DIG0)
   62  0106: 1E 00             MVI  E,00h         ; фаза мультиплекса 0..3
   63            
   64            ; ---- главный цикл: строка -> пауза ----------------------------------
   65  0108: 21 C0 01 MAIN:    LXI  H,MSG
   66  010B: CD 50 01          CALL PUTS          ; "TXUART v2.2 OK N="
   67  010E: 79                MOV  A,C           ; старший hex-символ счётчика
   68  010F: 0F                RRC
   69  0110: 0F                RRC
   70  0111: 0F                RRC
   71  0112: 0F                RRC
   72  0113: E6 0F             ANI  0Fh
   73  0115: CD 41 01          CALL PUTH
   74  0118: 79                MOV  A,C           ; младший hex-символ счётчика
   75  0119: E6 0F             ANI  0Fh
   76  011B: CD 41 01          CALL PUTH
   77  011E: 3E 0D             MVI  A,0Dh         ; CR
   78  0120: CD 35 01          CALL PUTC
   79  0123: 3E 0A             MVI  A,0Ah         ; LF
   80  0125: CD 35 01          CALL PUTC
   81  0128: 0C                INR  C             ; N++ (mod 256)
   82  0129: 06 C8             MVI  B,K_MS        ; пауза K_MS мс с мультиплексом дисплея
   83  012B: CD 5A 01 DL1:     CALL SLICE         ; 1 мс + один шаг мультиплекса
   84  012E: 05                DCR  B
   85  012F: C2 2B 01          JNZ  DL1
   86  0132: C3 08 01          JMP  MAIN
   87            
   88            ; ---- PUTC: выдать байт ядру (A = байт) ------------------------------
   89            ; Поллинг TXRDY ДО каждого OUT 04h - контракт п.1: запись при busy
   90            ; тихо отбрасывается ядром, поэтому только так.
   91  0135: 47       PUTC:    MOV  B,A           ; сохранить байт (A пачкается в поллинге)
   92  0136: DB 05    PW1:     IN   K_PST         ; IN = 10 T; период опроса ~27 T
   93  0138: E6 02             ANI  K_TXRDY       ;   < 6,4 мкс кадра и < 20 T занятости,
   94  013A: CA 36 01          JZ   PW1           ;   TXRDY - уровень: промаха нет
   95  013D: 78                MOV  A,B
   96  013E: D3 04             OUT  K_PTX         ; старт кадра (8N1, 10 бит, 6,4 мкс)
   97  0140: C9                RET
   98            
   99            ; ---- PUTH: ASCII hex-цифра (A = 0..15) ------------------------------
  100            ; В UART идёт СИМВОЛ ('0'..'9','A'..'F'), а не глиф индикатора
  101            ; (HTAB - только для мультиплекса дисплея, урок первой симуляции).
  102  0141: FE 0A    PUTH:    CPI  0Ah
  103  0143: DA 4B 01          JC   PHD           ; 0..9 -> '0'..'9'
  104  0146: C6 37             ADI  37h           ; 0Ah..0Fh + 37h = 'A'..'F'
  105  0148: C3 35 01          JMP  PUTC
  106  014B: C6 30    PHD:     ADI  30h           ; + 30h = '0'..'9'
  107  014D: C3 35 01          JMP  PUTC          ; сквозной вызов в PUTC (без CALL)
  108            
  109            ; ---- PUTS: строка из (HL) до 00h ------------------------------------
  110  0150: 7E       PUTS:    MOV  A,M
  111  0151: B7                ORA  A
  112  0152: C8                RZ                 ; конец строки
  113  0153: CD 35 01          CALL PUTC
  114  0156: 23                INX  H
  115  0157: C3 50 01          JMP  PUTS
  116            
  117            ; ---- SLICE: пауза ~1 мс + один шаг мультиплекса ---------------------
  118            ; Внутренний цикл: MVI 7 + (DCR 4 + JNZ 10)*(K_1MS-1) + DCR 4 + JNZ 7
  119            ;   = 7 + 14*(K_1MS-1) + 11 = 2972 T; мультиплекс 109-117 T (по фазе);
  120            ;   CALL/RET 28 T. ИТОГО 3109..3117 T = 994,9..997,4 мкс (-0,3% к 1 мс;
  121            ;   не таймирует UART, только пауза между строками; точно меряет
  122            ;   симуляция sim_uart_tx_test.py: C4 медиана 3117 T).
  123  015A: 2E D4    SLICE:   MVI  L,K_1MS
  124  015C: 2D       SL1:     DCR  L
  125  015D: C2 5C 01          JNZ  SL1
  126  0160: 7B                MOV  A,E           ; выбор глифа по фазе E
  127  0161: FE 01             CPI  01h
  128  0163: DA 70 01          JC   M0            ; E=0 -> млад. нибл счётчика C
  129  0166: FE 03             CPI  03h
  130  0168: DA 7A 01          JC   M12           ; E=1..2 -> '-'
  131  016B: 3E 78             MVI  A,G_T         ; E=3 -> 't'
  132  016D: C3 7C 01          JMP  MW
  133  0170: 79       M0:      MOV  A,C
  134  0171: E6 0F             ANI  0Fh
  135  0173: 6F                MOV  L,A
  136  0174: 26 02             MVI  H,K_PHTAB     ; L уже = индекс глифа 0..F
  137  0176: 7E                MOV  A,M           ; глиф 0..F
  138  0177: C3 7C 01          JMP  MW
  139  017A: 3E 40    M12:     MVI  A,G_MINUS
  140  017C: D3 00    MW:      OUT  K_PSEG        ; сегменты (призрак чужого разряда < 2 мкс)
  141  017E: 7B                MOV  A,E
  142  017F: 6F                MOV  L,A
  143  0180: 26 03             MVI  H,K_PDTAB     ; страница таблицы разрядов (DTAB = 0300h+фаза)
  144  0182: 7E                MOV  A,M           ; маска разряда 01/02/04/08 (A4=0 - SND тих)
  145  0183: D3 01             OUT  K_PDIG
  146  0185: 1C                INR  E
  147  0186: 7B                MOV  A,E
  148  0187: E6 03             ANI  03h
  149  0189: 5F                MOV  E,A
  150  018A: C9                RET
  151            
  152            ; ---- данные (HTAB/DTAB на границах страниц: индекс = L) --------------
  153  01C0: -                 ORG  01C0h
  154  01C0: 54 58 55 41 52 54 20 76 32 2E 32 20 4F 4B 20 4E 3D MSG:     DB   'TXUART v2.2 OK N='
  155  01D1: 00                DB   00h
  156            
  157  0200: -                 ORG  0200h
  158  0200: 3F 06 5B 4F 66 6D 7D 07 HTAB:    DB   3Fh,06h,5Bh,4Fh,66h,6Dh,7Dh,07h   ; глифы 0-7 (1 = горит)
  159  0208: 7F 6F 77 7C 39 5E 79 71          DB   7Fh,6Fh,77h,7Ch,39h,5Eh,79h,71h   ; глифы 8-F
  160  0300: -                 ORG  0300h
  161  0300: 01 02 04 08 DTAB:    DB   01h,02h,04h,08h                   ; разряды DIG0..DIG3
  162            
  163  0304: -                 END
