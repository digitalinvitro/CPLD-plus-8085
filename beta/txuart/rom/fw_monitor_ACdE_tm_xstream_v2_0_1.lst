  579  02C2: DA F0 02         JC RDRE
  580  02C5: 3A EF FF         LDA AF1
  581  02C8: CD DA 01         CALL GLOOK
  582  02CB: 32 F6 FF         STA DIGIMG1
  583  02CE: 3A EC FF         LDA ADCNT
  584  02D1: FE 03            CPI 03h
  585  02D3: DA F0 02         JC RDRE
  586  02D6: 3A EE FF         LDA AF2
  587  02D9: CD DA 01         CALL GLOOK
  588  02DC: 32 F7 FF         STA DIGIMG2
  589  02DF: 3A EC FF         LDA ADCNT
  590  02E2: FE 04            CPI 04h
  591  02E4: DA F0 02         JC RDRE
  592  02E7: 3A ED FF         LDA AF3
  593  02EA: CD DA 01         CALL GLOOK
  594  02ED: 32 F8 FF         STA DIGIMG3
  595  02F0: C9       RDRE:   RET
  596            
  597            ; =====================================================================
  598            ; UART-канал: передача OUT 04h @1M (TXRDY = IN 03h бит 7, v1.2 Шаг-2),
  599            ; приём RIM/SID @4800 - как v27
  600            ; =====================================================================
  601            
  602            ; ---------------------------------------------------------------------
  603            ; TXBYTE: A = байт -> сериализатор CPLD (1 000 000 8N1). Ожидает TXRDY
  604            ; (запись при busy аппаратно отбрасывается). Используется баннером/строками.
  605            ; ---------------------------------------------------------------------
  606  02F1: F5       TXBYTE: PUSH PSW
  607  02F2: DB 03    TXB1:   IN KBROWP           ; TXRDY = бит 7
  608  02F4: E6 80            ANI 80h             ; tx_idle = ~|bit_cnt: 1 = готов принять байт
  609  02F6: CA F2 02         JZ TXB1
  610  02F9: F1               POP PSW
  611  02FA: D3 04            OUT TXP
  612  02FC: C9               RET
  613            
  614            ; ---------------------------------------------------------------------
  615            ; TXSTR: HL = строка с нулевым завершителем -> TX. Портит A/HL.
  616            ; ---------------------------------------------------------------------
  617  02FD: 7E       TXSTR:  MOV A,M
  618  02FE: B7               ORA A
  619  02FF: C8               RZ
  620  0300: CD F1 02         CALL TXBYTE
  621  0303: 23               INX H
  622  0304: C3 FD 02         JMP TXSTR
  623            
  624            ; ---------------------------------------------------------------------
  625            ; PAUSE: пауза D итераций по 4,5 мкс (DCR+JNZ = 14T @3,125 МГц;
  626            ; в v1.2 считали 15T @400 нс - значение пересчитано, см. EQU).
  627            ; ---------------------------------------------------------------------
  628  0307: 15       PAUSE:  DCR D
  629  0308: C2 07 03         JNZ PAUSE
  630  030B: C9               RET
  631            
  632            ; ---------------------------------------------------------------------
  633            ; RXD: приём байта SID 4800 8N1 (фрагмент 7 + стоп-бит). Выход:
  634            ; C = байт, CY = 0 ОК / CY = 1 обрыв кадра (стоп-бит = 0). Портит A/B/C/D.
  635            ; Цикл строгий - в режиме B таймер ЗАМАСКИРОВАН (TMOFF: DI + SIM 1Fh,
  636            ; маска РЕАЛЬНА с v2.0.1 - п.0 шапки) и пульки TMIARM запрещены -
  637            ; джиттера нет вообще.
  638            ; Константы v2.0: RXHB=19 (полбита ~103 мкс), RXFB=41 (бит ~208 мкс,
  639            ; расчёт в блоке EQU). v1.2: RXHB=15/RXFB=30 @2,5 МГц.
  640            ; ---------------------------------------------------------------------
  641  030C: 06 08    RXD:    MVI B,08h
  642  030E: 20       RXW:    RIM                 ; A7 = SID
  643  030F: B7               ORA A
  644  0310: FA 0E 03         JM RXW              ; '1' (покой) - ждать старт-бит
  645  0313: 16 13            MVI D,RXHB          ; полбита - в середину старт-бита
  646  0315: CD 07 03         CALL PAUSE
  647  0318: 20               RIM                 ; подтвердить старт-бит
  648  0319: B7               ORA A
  649  031A: FA 0E 03         JM RXW              ; '1' - ложный старт, ждать заново
  650  031D: 0E 00            MVI C,00h
  651  031F: 16 29            MVI D,RXFB          ; бит - в середину D0
  652  0321: CD 07 03         CALL PAUSE
  653  0324: 20       RXL:    RIM                 ; A7 = SID - центр очередного бита
  654  0325: E6 80            ANI 80h
  655  0327: 1F               RAR                 ; бит -> CY
  656  0328: 79               MOV A,C
  657  0329: 1F               RAR                 ; вставить сверху (LSB-first)
  658  032A: 4F               MOV C,A
  659  032B: 16 29            MVI D,RXFB
  660  032D: CD 07 03         CALL PAUSE
  661  0330: 05               DCR B
  662  0331: C2 24 03         JNZ RXL
  663                    ; после последней итерации RXL (выборка d7 + бит задержки)
  664                    ; линия = середина стоп-бита
  665  0334: 20               RIM
  666  0335: E6 80            ANI 80h             ; CY = 0 (ANI сбрасывает перенос)
  667  0337: CA 3C 03         JZ RXBAD            ; стоп-бит = 0 - обрыв кадра
  668  033A: B7               ORA A               ; CY = 0
  669  033B: C9               RET                 ; C = байт, CY = 0
  670  033C: 37       RXBAD:  STC
  671  033D: C9               RET                 ; CY = 1
  672            
  673            ; ---------------------------------------------------------------------
  674            ; NIB: A = ASCII-символ -> CY = 1 и A = тетрада 0-F ('0'-'9','A'-'F',
  675            ; 'a'-'f'), иначе CY = 0. Портит A.
  676            ; ---------------------------------------------------------------------
  677  033E: D6 30    NIB:    SUI 30h             ; '0'..'9' -> 0..9
  678  0340: DA 5E 03         JC NIBX             ; < '0'
  679  0343: FE 0A            CPI 0Ah
  680  0345: DA 5C 03         JC NIBOK            ; цифра 0..9
  681  0348: D6 07            SUI 07h             ; 'A'..'F' -> 10..15
  682  034A: FE 10            CPI 10h
  683  034C: D2 52 03         JNC NIB2            ; > 'F' - попробовать строчные a..f
  684  034F: C3 5C 03         JMP NIBOK
  685  0352: D6 20    NIB2:   SUI 20h             ; ('a'-'0')-07h-20h = 10..15
  686  0354: FE 10            CPI 10h
  687  0356: D2 5E 03         JNC NIBX
  688  0359: C3 5C 03         JMP NIBOK
  689  035C: 37       NIBOK:  STC
  690  035D: C9               RET
  691  035E: B7       NIBX:   ORA A               ; CY = 0
  692  035F: C9               RET
  693            
  694            ; ---------------------------------------------------------------------
  695            ; LSTAT: A = глиф -> статический дисплей (все 4 разряда, слот-система
  696            ; стоит). Для режимов загрузчика/RAM-теста, где ISR замаскирован (TMOFF).
  697            ; ---------------------------------------------------------------------
  698  0360: C5       LSTAT:  PUSH B
  699  0361: 47               MOV B,A
  700  0362: AF               XRA A
  701  0363: D3 00            OUT SEGP            ; гашение на время переключения
  702  0365: 3E 0F            MVI A,0Fh
  703  0367: D3 01            OUT DIGP            ; все 4 разряда, SND = 0
  704  0369: 78               MOV A,B
  705  036A: D3 00            OUT SEGP            ; глиф на все разряды
  706  036C: C1               POP B
  707  036D: C9               RET
  708            
  709            ; ---------------------------------------------------------------------
  710            ; DLMS: пауза ~1,02 мс (K_MS=130 итераций 24T @320 нс = 1,002 мс).
  711            ; Портит A/B/C. H/L целы. ВНИМАНИЕ (п.3): внутри DLMS пульки TMIARM
  712            ; нет - на время паузы слоты стоят (один разряд горит ~1 мс, яркость
  713            ; не страдает - скважность 1/4 как всегда; каденция возвращается на
  714            ; следующем TMIARM-вызове).
  715            ; ---------------------------------------------------------------------
  716  036E: 01 82 00 DLMS:   LXI B,K_MS
  717  0371: 0B       DLS1:   DCX B
  718  0372: 78               MOV A,B
  719  0373: B1               ORA C
  720  0374: C2 71 03         JNZ DLS1
  721  0377: C9               RET
  722            
  723            ; ---------------------------------------------------------------------
  724            ; LDSUM: LSUM += B (mod 256). Портит A.
  725            ; ---------------------------------------------------------------------
  726  0378: F5       LDSUM:  PUSH PSW
  727  0379: 3A FE FF         LDA LSUM
  728  037C: 80               ADD B
  729  037D: 32 FE FF         STA LSUM
  730  0380: F1               POP PSW
  731  0381: C9               RET
  732            
  733            ; ---------------------------------------------------------------------
  734            ; LDBEEP: длинный сигнал ~0,3 с (тоггл D4 DIGP вручную: в B/F 7.5
  735            ; замаскирован (TMOFF) - ISR не пишет DIGP, конфликта нет; пульки
  736            ; TMIARM здесь ЗАПРЕЩЕНЫ - см. п.2). Портит A/B/C/D.
  737            ; ---------------------------------------------------------------------
  738  0382: 16 96    LDBEEP: MVI D,150
  739  0384: 3E 1F    LDB1:   MVI A,1Fh           ; SND = 1, разряды on
  740  0386: D3 01            OUT DIGP
  741  0388: CD 6E 03         CALL DLMS
  742  038B: 3E 0F            MVI A,0Fh           ; SND = 0
  743  038D: D3 01            OUT DIGP
  744  038F: CD 6E 03         CALL DLMS
  745  0392: 15               DCR D
  746  0393: C2 84 03         JNZ LDB1
  747  0396: C9               RET
  748            
  749            ; =====================================================================
  750            ; LOADM: Intel HEX загрузчик (клавиша B). Приём SID 4800 8N1.
  751            ; Вход через KLD с TMOFF (7.5 замаскирован, DI) - как v27 по логике
  752            ; парсера. Формат записи: :nnaaaatt[dd...]cc, cc = (-сумма байт) mod 256.
  753            ; Статический дисплей LLLL; адрес каждой записи живёт в ADDRH/L.
  754            ; Запись только в ОЗУ (A15=1): попадание в ROM-окно = ошибка EEEE.
  755            ; Выход: EOF-запись (type 01) -> тик и меню; ошибка -> EEEE + сигнал.
  756            ; Выход из зависшего приёма - RESET (SW20).
  757            ; NOTE: LACC/LNIB/LBPC/LSUM/LTY = клетки FFFB-FFFF; в обычном режиме
  758            ; FFFC-FFFF заняты KRAW (ISR) - в B маски стоят (TMOFF), конфликта нет;
  759            ; TMON на выходе чистит KRAW. XSSEQ/LST = FFFA: на входе LST=0 (=SEQ 0 -
  760            ; клиент логирует рестарт потока), на выходе TMON -> новое SEQ с 0.
  761            ; ---------------------------------------------------------------------
  762  0397: AF       LOADM:  XRA A
  763  0398: 32 FA FF         STA LST             ; ждем ':' (и XSSEQ = 0 - рестарт потока клиента)
  764  039B: 32 FD FF         STA LACC            ; накопитель тетрад тоже с нуля (баг v1.0:
  765                                        ;  сталь ломала первый байт первой записи)
  766  039E: 3E 38            MVI A,38h           ; 'L'
  767  03A0: CD 60 03         CALL LSTAT
  768  03A3: CD 0C 03 LDLP:   CALL RXD            ; C = байт, CY = ошибка кадра
  769  03A6: DA D4 04         JC LDERR
  770  03A9: 79               MOV A,C
  771  03AA: FE 3A            CPI ':'
  772  03AC: CA BF 04         JZ LDNEW            ; начало записи
  773  03AF: CD 3E 03         CALL NIB            ; тетрада?
  774  03B2: D2 A3 03         JNC LDLP            ; прочее (\r\n и т.п.) - пропустить
  775  03B5: 5F               MOV E,A             ; E = тетрада (7.5 замаскирован - E свободен)
  776  03B6: 3A FD FF         LDA LACC
  777  03B9: 07               RLC
  778  03BA: 07               RLC
  779  03BB: 07               RLC
  780  03BC: 07               RLC                 ; накопитель << 4
  781  03BD: B3               ORA E
  782  03BE: 32 FD FF         STA LACC
  783  03C1: 3A FB FF         LDA LNIB
  784  03C4: 3D               DCR A
  785  03C5: 32 FB FF         STA LNIB
  786  03C8: C2 A3 03         JNZ LDLP            ; байт поля ещё не собран
  787                    ; --- байт поля собран - применить по состоянию ---
  788  03CB: 3A FD FF         LDA LACC
  789  03CE: 47               MOV B,A             ; B = байт
  790  03CF: AF               XRA A
  791  03D0: 32 FD FF         STA LACC            ; накопитель очищен к следующему байту
  792  03D3: 3A FA FF         LDA LST
  793  03D6: B7               ORA A
  794  03D7: CA A3 03         JZ LDLP             ; байт вне записи - игнор
  795  03DA: 3D               DCR A
  796  03DB: CA ED 03         JZ LDCNT            ; 1 = count
  797  03DE: 3D               DCR A
  798  03DF: CA 02 04         JZ LDADR            ; 2 = addr
  799  03E2: 3D               DCR A
  800  03E3: CA 3A 04         JZ LDTYP            ; 3 = type
  801  03E6: 3D               DCR A
  802  03E7: CA 6D 04         JZ LDDAT            ; 4 = data
  803  03EA: C3 A9 04         JMP LDCHK           ; 5 = checksum
  804  03ED: 78       LDCNT:  MOV A,B
  805  03EE: 32 EC FF         STA ADCNT           ; сколько байт данных в записи
  806  03F1: CD 78 03         CALL LDSUM
  807  03F4: 3E 02            MVI A,02h           ; поле addr: 4 тетрады = 2 байта
  808  03F6: 32 FA FF         STA LST
  809  03F9: 32 FC FF         STA LBPC
  810  03FC: 32 FB FF         STA LNIB
  811  03FF: C3 A3 03         JMP LDLP
  812  0402: 78       LDADR:  MOV A,B
  813  0403: 32 FF FF         STA LTY             ; временно: тип ещё не читался
  814  0406: 3A FC FF         LDA LBPC
  815  0409: FE 02            CPI 02h
  816  040B: C2 1F 04         JNZ LDAD1
  817  040E: 3A FF FF         LDA LTY
  818  0411: 32 EA FF         STA ADDRH           ; старший байт адреса (big-endian)
  819  0414: 3E 01            MVI A,01h
  820  0416: 32 FC FF         STA LBPC
  821  0419: CD 78 03         CALL LDSUM
  822  041C: C3 A3 03         JMP LDLP
  823  041F: 3A FF FF LDAD1:  LDA LTY
  824  0422: 32 EB FF         STA ADDRL           ; младший байт адреса
  825  0425: CD 78 03         CALL LDSUM
  826  0428: 3E 03            MVI A,03h
  827  042A: 32 FA FF         STA LST             ; type
  828  042D: 3E 01            MVI A,01h
  829  042F: 32 FC FF         STA LBPC
  830  0432: 3E 02            MVI A,02h
  831  0434: 32 FB FF         STA LNIB
  832  0437: C3 A3 03         JMP LDLP
  833  043A: 78       LDTYP:  MOV A,B
  834  043B: 32 FF FF         STA LTY
  835  043E: CD 78 03         CALL LDSUM
  836  0441: 3A FF FF         LDA LTY
  837  0444: FE 01            CPI 01h
  838  0446: CA 5C 04         JZ LDTYP1
  839  0449: 3A EC FF         LDA ADCNT           ; type 00: данные
  840  044C: 32 FC FF         STA LBPC
  841  044F: 3E 04            MVI A,04h
  842  0451: 32 FA FF         STA LST
  843  0454: 3E 02            MVI A,02h
  844  0456: 32 FB FF         STA LNIB
  845  0459: C3 A3 03         JMP LDLP
  846  045C: AF       LDTYP1: XRA A               ; type 01 (EOF): данных нет
  847  045D: 32 FC FF         STA LBPC
  848  0460: 3E 05            MVI A,05h
  849  0462: 32 FA FF         STA LST
  850  0465: 3E 02            MVI A,02h
  851  0467: 32 FB FF         STA LNIB
  852  046A: C3 A3 03         JMP LDLP
  853  046D: 3A EA FF LDDAT:  LDA ADDRH
  854  0470: E6 80            ANI 80h             ; запись разрешена только в ОЗУ
  855  0472: CA D4 04         JZ LDERR            ; ROM-окно - ошибка
  856  0475: 3A EA FF         LDA ADDRH
  857  0478: 67               MOV H,A
  858  0479: 3A EB FF         LDA ADDRL
  859  047C: 6F               MOV L,A
  860  047D: 70               MOV M,B             ; [ADDR] = байт (writeback CPLD)
  861  047E: 23               INX H
  862  047F: 7C               MOV A,H
  863  0480: 32 EA FF         STA ADDRH
  864  0483: 7D               MOV A,L
  865  0484: 32 EB FF         STA ADDRL
  866  0487: CD 78 03         CALL LDSUM
  867  048A: 3A FC FF         LDA LBPC
  868  048D: 3D               DCR A
  869  048E: 32 FC FF         STA LBPC
  870  0491: C2 A1 04         JNZ LDDAT2
  871  0494: 3E 05            MVI A,05h           ; данные кончились - ждать checksum
  872  0496: 32 FA FF         STA LST
  873  0499: 3E 02            MVI A,02h
  874  049B: 32 FB FF         STA LNIB
  875  049E: C3 A3 03         JMP LDLP
  876  04A1: 3E 02    LDDAT2: MVI A,02h
  877  04A3: 32 FB FF         STA LNIB
  878  04A6: C3 A3 03         JMP LDLP
  879  04A9: 3A FE FF LDCHK:  LDA LSUM            ; контрольная сумма записи
  880  04AC: 80               ADD B               ; сумма всех байт + cc = 0 mod 256?
  881  04AD: C2 D4 04         JNZ LDERR
  882  04B0: 3A FF FF         LDA LTY
  883  04B3: FE 01            CPI 01h
  884  04B5: CA D0 04         JZ LDDONE           ; EOF - конец загрузки
  885  04B8: AF               XRA A
  886  04B9: 32 FA FF         STA LST             ; ждем ':' следующей записи
  887  04BC: C3 A3 03         JMP LDLP
  888  04BF: 3E 01    LDNEW:  MVI A,01h           ; ':' - новая запись
  889  04C1: 32 FA FF         STA LST
  890  04C4: 3E 02            MVI A,02h
  891  04C6: 32 FB FF         STA LNIB
  892  04C9: AF               XRA A
  893  04CA: 32 FE FF         STA LSUM
  894  04CD: C3 A3 03         JMP LDLP
  895  04D0: CD B5 01 LDDONE: CALL TICKON         ; подтверждение успешной загрузки
  896  04D3: C9               RET
  897  04D4: 3E 79    LDERR:  MVI A,79h           ; 'E' -> дисплей EEEE
  898  04D6: CD 60 03         CALL LSTAT
  899  04D9: CD 82 03         CALL LDBEEP         ; длинный сигнал
  900  04DC: C9               RET                 ; в меню (ADDRH/L = адрес сбоя, D = просмотр)
  901            
  902            ; =====================================================================
  903            ; RAMT: RAM-тест 8000h-FFE7h (клавиша F). 4 паттерна 00/FF/55/AA:
  904            ; заполнение + контроль побайтно. Статический дисплей = глиф паттерна
  905            ; ("0000"/"FFFF"/"5555"/"AAAA"). Сбой: ADDRH/L = адрес сбоя, EEEE +
  906            ; длинный сигнал. Успех: короткий тик. Вход через KRAM с TMOFF:
  907            ; 7.5 замаскирован - ISR не толкает стек в диапазон теста, тест
  908            ; КРИСТАЛЬНО чистый. Стек до FFD4h не доходит (RAMT без длинных push).
  909            ; Портит всё (кроме клеток монитора).
  910            ; ---------------------------------------------------------------------
  911  04DD: 21 76 00 RAMT:   LXI H,RAMPAT        ; HL = текущая пара (value+glyph)
  912  04E0: 0E 04            MVI C,04h           ; 4 паттерна
  913  04E2: 7E       RMT0:   MOV A,M             ; A = значение паттерна
  914  04E3: 5F               MOV E,A
  915  04E4: E5               PUSH H              ; указатель пары - на стек (HL уйдёт под заполнение)
  916  04E5: 23               INX H
  917  04E6: 7E               MOV A,M             ; глиф паттерна
  918  04E7: CD 60 03         CALL LSTAT          ; статический дисплей ("0000" и т.д.)
  919  04EA: 7B               MOV A,E
  920  04EB: 21 00 80         LXI H,8000h
  921  04EE: 77       RMF:    MOV M,A             ; заполнение
  922  04EF: 23               INX H
  923  04F0: 7C               MOV A,H
  924  04F1: FE FE            CPI 0FEh            ; до FFE7h включительно
  925  04F3: C2 EE 04         JNZ RMF
  926  04F6: 7D               MOV A,L
  927  04F7: FE E8            CPI 0E8h
  928  04F9: C2 EE 04         JNZ RMF
  929  04FC: 21 00 80         LXI H,8000h
  930  04FF: 7E       RMV:    MOV A,M             ; контроль
  931  0500: BB               CMP E
  932  0501: C2 1C 05         JNZ RMBAD
  933  0504: 23               INX H
  934  0505: 7C               MOV A,H
  935  0506: FE FE            CPI 0FEh
  936  0508: C2 FF 04         JNZ RMV
  937  050B: 7D               MOV A,L
  938  050C: FE E8            CPI 0E8h
  939  050E: C2 FF 04         JNZ RMV
  940  0511: E1               POP H               ; HL = пара паттерна
  941  0512: 23               INX H
  942  0513: 23               INX H               ; следующая пара
  943  0514: 0D               DCR C
  944  0515: C2 E2 04         JNZ RMT0
  945  0518: CD B5 01         CALL TICKON         ; ОК
  946  051B: C9               RET
  947  051C: 22 EB FF RMBAD:  SHLD ADDRL          ; ADDRH/L = адрес сбоя (HL из RMV, до POP!)
  948  051F: E1               POP H               ; снять указатель пары (баланс стека)
  949  0520: 3E 79            MVI A,79h           ; 'E' -> EEEE
  950  0522: CD 60 03         CALL LSTAT
  951  0525: CD 82 03         CALL LDBEEP
  952  0528: C9               RET                 ; в меню; D = просмотр байта по адресу сбоя
  953            
  954            ; =====================================================================
  955            ;                    XSTREAM: ЭКРАН -> UART (п.8: непрерывный поток,
  956            ;                    тик кадра = сама скорость канала, регенерация/
  957            ;                    скан ведётся пульками TMIARM внутри посылки)
  958            ; =====================================================================
  959            ; ---------------------------------------------------------------------
  960            ; XSINIT (из START, только холодный старт): демо-экран в B000h,
  961            ; SEQ = 0. Мониторные переменные не трогаются; B000-B7CF -
  962            ; пользовательская область: ЛЮБАЯ программа может рисовать туда
  963            ; свой текст/графику, клиент xstream_view.ps1 покажет окном.
  964            ; ---------------------------------------------------------------------
  965  0529: CD 4B 05 XSINIT: CALL XBLANK
  966  052C: 21 AD 07         LXI H,XTBL
  967  052F: 5E       XSI1:   MOV E,M             ; DE = адрес назначения
  968  0530: 23               INX H
  969  0531: 56               MOV D,M
  970  0532: 23               INX H               ; HL -> src_lo
  971  0533: 7A               MOV A,D             ; конец таблицы (dst == 0000)?
  972  0534: B3               ORA E
  973  0535: CA 46 05         JZ XSI3
  974  0538: 4E               MOV C,M             ; BC = адрес строки (источник)
  975  0539: 23               INX H
  976  053A: 46               MOV B,M
  977  053B: 23               INX H               ; HL -> следующая запись
  978  053C: E5               PUSH H              ; указатель следующей записи -> стек
  979  053D: 60               MOV H,B
  980  053E: 69               MOV L,C
  981  053F: CD 5C 05         CALL XCPY           ; ASCIZ [HL] -> [DE], 0 = конец
  982  0542: E1               POP H
  983  0543: C3 2F 05         JMP XSI1
  984  0546: AF       XSI3:   XRA A
  985  0547: 32 FA FF         STA XSSEQ
  986  054A: C9               RET
  987            
  988  054B: 21 00 B0 XBLANK: LXI H,XBUF          ; 2000 пробелов
  989  054E: 01 D0 07         LXI B,2000
  990  0551: 3E 20    XB1:    MVI A,20h
  991  0553: 77               MOV M,A
  992  0554: 23               INX H
  993  0555: 0B               DCX B
  994  0556: 78               MOV A,B
  995  0557: B1               ORA C
  996  0558: C2 51 05         JNZ XB1
  997  055B: C9               RET
  998            
  999  055C: 7E       XCPY:   MOV A,M             ; ASCIZ: [HL]->[DE], 0 = конец (A/флаги)
 1000  055D: B7               ORA A
 1001  055E: C8               RZ
 1002  055F: 12               STAX D
 1003  0560: 23               INX H
 1004  0561: 13               INX D
 1005  0562: C3 5C 05         JMP XCPY
