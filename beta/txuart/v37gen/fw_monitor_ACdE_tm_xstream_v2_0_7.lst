 1218  0629: 77               MOV M,A
 1219  062A: 23               INX H
 1220  062B: 0B               DCX B
 1221  062C: 78               MOV A,B
 1222  062D: B1               ORA C
 1223  062E: C2 27 06         JNZ XB1
 1224  0631: C9               RET
