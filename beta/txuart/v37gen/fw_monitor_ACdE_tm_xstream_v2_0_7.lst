 1123            ; =====================================================================
 1124            ; RAMT: RAM-тест 8000h-FFD7h (клавиша F). 4 паттерна 00/FF/55/AA:
 1125            ; заполнение + контроль побайтно. Статический дисплей (DIG0) = глиф
 1126            ; паттерна ("0000"/"FFFF"/"5555"/"AAAA"). Сбой: ADDRH/L = адрес сбоя,
 1127            ; EEEE + длинный сигнал. Успех: короткий тик. Вход через KRAM с TMOFF:
 1128            ; 7.5 замаскирован - ISR не толкает стек в диапазон теста.
 1129            ; ГРАНИЦА: FFD8h-FFE7h НЕ тестируется (фикс v2.0.2/tw): там живёт стек
 1130            ; монитора - собственный адрес возврата RAMT лежит в FFE7h/FFE6h, и
 1131            ; заполнение до FFE7h затирало его -> после теста RET в мусор. Стек до
 1132            ; FFD4h не доходит (RAMT без длинных push). Портит всё, кроме клеток.
 1133            ; ФИКС v2.0.2 (tw): паттерн восстанавливается из E на каждом шаге
 1134            ; (MOV A,E): в v1.2-v2.0.1 MOV A,H после INX H затирал паттерн в A и
 1135            ; с 8001h писались МЛАДШИЕ БАЙТЫ АДРЕСА -> вечная "ошибка ОЗУ".
 1136            ; ---------------------------------------------------------------------
 1137  05B2: 21 76 00 RAMT:   LXI H,RAMPAT        ; HL = текущая пара (value+glyph)
 1138  05B5: 0E 04            MVI C,04h           ; 4 паттерна
 1139  05B7: 7E       RMT0:   MOV A,M             ; A = значение паттерна
 1140  05B8: 5F               MOV E,A
 1141  05B9: E5               PUSH H              ; указатель пары - на стек (HL уйдёт под заполнение)
 1142  05BA: 23               INX H
 1143  05BB: 7E               MOV A,M             ; глиф паттерна
 1144  05BC: CD 4F 03         CALL LSTAT          ; статический дисплей ("0000" и т.д.)
 1145  05BF: 7B               MOV A,E
 1146  05C0: 21 00 80         LXI H,8000h
 1147  05C3: 7B       RMF:    MOV A,E             ; паттерн из E на КАЖДОМ шаге (фикс v2.0.2)
 1148  05C4: 77               MOV M,A             ; заполнение
 1149  05C5: 23               INX H
 1150  05C6: 7C               MOV A,H
 1151  05C7: FE FD            CPI 0FDh
 1152  05C9: C2 C3 05         JNZ RMF
 1153  05CC: 7D               MOV A,L
 1154  05CD: FE D8            CPI 0D8h
 1155  05CF: C2 C3 05         JNZ RMF
 1156  05D2: 21 00 80         LXI H,8000h
 1157  05D5: 7E       RMV:    MOV A,M             ; контроль (8000h..FFD7h)
 1158  05D6: BB               CMP E
 1159  05D7: C2 F2 05         JNZ RMBAD
 1160  05DA: 23               INX H
 1161  05DB: 7C               MOV A,H
 1162  05DC: FE FD            CPI 0FDh
 1163  05DE: C2 D5 05         JNZ RMV
 1164  05E1: 7D               MOV A,L
 1165  05E2: FE D8            CPI 0D8h
 1166  05E4: C2 D5 05         JNZ RMV
 1167  05E7: E1               POP H               ; HL = пара паттерна
 1168  05E8: 23               INX H
 1169  05E9: 23               INX H               ; следующая пара
 1170  05EA: 0D               DCR C
 1171  05EB: C2 B7 05         JNZ RMT0
 1172  05EE: CD A0 01         CALL TICKON         ; ОК
 1173  05F1: C9               RET
 1174  05F2: 22 EB FF RMBAD:  SHLD ADDRL          ; ADDRH/L = адрес сбоя (HL из RMV, до POP!)
 1175  05F5: E1               POP H               ; снять указатель пары (баланс стека)
 1176  05F6: 3E 79            MVI A,79h           ; 'E' -> EEEE
 1177  05F8: CD 4F 03         CALL LSTAT
 1178  05FB: CD 71 03         CALL LDBEEP
 1179  05FE: C9               RET                 ; в меню; D = просмотр байта по адресу сбоя
