 1195  0606: 23               INX H
 1196  0607: 56               MOV D,M
 1197  0608: 23               INX H               ; HL -> src_lo
 1198  0609: 7A               MOV A,D             ; конец таблицы (dst == 0000)?
 1199  060A: B3               ORA E
 1200  060B: CA 1C 06         JZ XSI3
 1201  060E: 4E               MOV C,M             ; BC = адрес строки (источник)
 1202  060F: 23               INX H
 1203  0610: 46               MOV B,M
 1204  0611: 23               INX H               ; HL -> следующая запись
 1205  0612: E5               PUSH H              ; указатель следующей записи -> стек
 1206  0613: 60               MOV H,B
 1207  0614: 69               MOV L,C
 1208  0615: CD 32 06         CALL XCPY           ; ASCIZ [HL] -> [DE], 0 = конец
 1209  0618: E1               POP H
 1210  0619: C3 05 06         JMP XSI1
 1211  061C: AF       XSI3:   XRA A
 1212  061D: 32 FA FF         STA XSSEQ
 1213  0620: C9               RET
