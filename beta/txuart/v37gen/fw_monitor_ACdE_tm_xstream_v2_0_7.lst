  862                    ; --- байт поля собран - применить по состоянию ---
  863  03BD: 3A FD FF         LDA LACC
  864  03C0: 47               MOV B,A             ; B = байт
  865  03C1: AF               XRA A
  866  03C2: 32 FD FF         STA LACC            ; накопитель очищен к следующему байту
  867  03C5: 3A FA FF         LDA LST
  868  03C8: B7               ORA A
  869  03C9: CA 95 03         JZ LDLP             ; байт вне записи - игнор
  870  03CC: 3D               DCR A
  871  03CD: CA DF 03         JZ LDCNT            ; 1 = count
  872  03D0: 3D               DCR A
  873  03D1: CA F4 03         JZ LDADR            ; 2 = addr
  874  03D4: 3D               DCR A
  875  03D5: CA 31 04         JZ LDTYP            ; 3 = type
  876  03D8: 3D               DCR A
