 1023            ; ---- точка: тон 100 мс (EEEE горит) / пауза 100 мс ----
 1024  051C: 3E 1F    BPNT:   MVI A,1Fh           ; SND=1 + все 4 разряда
 1025  051E: D3 02            OUT DIGP
 1026  0520: 16 64            MVI D,100
 1027  0522: CD 48 05         CALL MSD
 1028  0525: 3E 0F            MVI A,0Fh           ; SND=0 (разряды горят)
 1029  0527: D3 02            OUT DIGP
 1030  0529: 16 64            MVI D,100
 1031  052B: CD 48 05         CALL MSD
 1032  052E: C9               RET
 1033            
 1034            ; ---- тире: тон 300 мс (3 x 100) / пауза 100 мс ----
 1035  052F: 3E 1F    BDASH:  MVI A,1Fh
 1036  0531: D3 02            OUT DIGP
 1037  0533: 1E 03            MVI E,3             ; 3 x 100 мс = 300 мс
 1038  0535: 16 64    BD1:    MVI D,100
 1039  0537: CD 48 05         CALL MSD
 1040  053A: 1D               DCR E
 1041  053B: C2 35 05         JNZ BD1
 1042  053E: 3E 0F            MVI A,0Fh
 1043  0540: D3 02            OUT DIGP
 1044  0542: 16 64            MVI D,100
 1045  0544: CD 48 05         CALL MSD
 1046  0547: C9               RET
