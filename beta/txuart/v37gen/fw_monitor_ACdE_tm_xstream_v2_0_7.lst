  977  04D2: C3 95 03         JMP LDLP
  978  04D5: CD A0 01 LDDONE: CALL TICKON         ; подтверждение успешной загрузки
  979  04D8: C9               RET
  980  04D9: 3E 79    LDERR:  MVI A,79h           ; 'E' в защёлке сегментов (глиф для всех разрядов)
  981  04DB: CD 4F 03         CALL LSTAT          ; DIG0 = 'E'; с этого момента EEEE/SOS до Enter
  982            
  983            ; ---------------------------------------------------------------------
  984            ; LDERR v2.0.6: ошибка загрузки -> EEEE горит ПОСТОЯННО + звук SOS до
  985            ; нажатия Enter. Точка ~100 мс, тире ~300 мс, пауза буквы 200 мс, пауза
  986            ; слова 800 мс. ISR стоит (TMOFF на входе B): тон ведём вручную через
  987            ; D4 DIGP (SND), разряды включены (1Fh на тоне, 0Fh в паузах) - EEEE не
  988            ; мигает; клавиатуру сканируем сами (SCAN1). Enter -> отпускание +
  989            ; дебаунс 15 мс -> RET (в меню через K_F1E: TMON+TICKON+REDRAW). Другие
  990            ; клавиши игнорируются. Портит A/B/C/D/H/L.
  991            ; ---------------------------------------------------------------------
  992  04DE: CD FE 04 SOSP:   CALL LET_S          ; S
  993  04E1: CD 99 05         CALL WAITENT
  994  04E4: CD 0D 05         CALL LET_O          ; O
  995  04E7: CD 99 05         CALL WAITENT
  996  04EA: CD FE 04         CALL LET_S          ; S
  997  04ED: 1E 04            MVI E,4             ; пауза слова ~0,8 с (4 x 200 мс; MVI - imm8)
  998  04EF: 16 C8    SOSW:   MVI D,200
  999  04F1: CD 48 05         CALL MSD
 1000  04F4: 1D               DCR E
 1001  04F5: C2 EF 04         JNZ SOSW
 1002  04F8: CD 99 05         CALL WAITENT
 1003  04FB: C3 DE 04         JMP SOSP
 1004            
 1005            ; ---- буква S: 3 точки + пауза буквы 200 мс ----
 1006  04FE: 16 03    LET_S:  MVI D,3
 1007  0500: CD 1C 05 LS1:    CALL BPNT
 1008  0503: 15               DCR D
 1009  0504: C2 00 05         JNZ LS1
 1010  0507: 16 C8            MVI D,200
 1011  0509: CD 48 05         CALL MSD
 1012  050C: C9               RET
 1013            
 1014            ; ---- буква O: 3 тире + пауза буквы 200 мс ----
 1015  050D: 16 03    LET_O:  MVI D,3
 1016  050F: CD 2F 05 LO1:    CALL BDASH
 1017  0512: 15               DCR D
 1018  0513: C2 0F 05         JNZ LO1
 1019  0516: 16 C8            MVI D,200
 1020  0518: CD 48 05         CALL MSD
 1021  051B: C9               RET
