  619  02AD: DA DB 02         JC RDRE
  620  02B0: 3A EF FF         LDA AF1
  621  02B3: CD C5 01         CALL GLOOK
  622  02B6: 32 F6 FF         STA DIGIMG1
  623  02B9: 3A EC FF         LDA ADCNT
  624  02BC: FE 03            CPI 03h
  625  02BE: DA DB 02         JC RDRE
  626  02C1: 3A EE FF         LDA AF2
  627  02C4: CD C5 01         CALL GLOOK
  628  02C7: 32 F7 FF         STA DIGIMG2
  629  02CA: 3A EC FF         LDA ADCNT
  630  02CD: FE 04            CPI 04h
  631  02CF: DA DB 02         JC RDRE
  632  02D2: 3A ED FF         LDA AF3
