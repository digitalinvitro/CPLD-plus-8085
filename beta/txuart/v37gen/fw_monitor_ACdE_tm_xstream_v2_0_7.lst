  637            ; =====================================================================
  638            ; UART-канал: передача OUT 04h @1M (TXRDY = IN 03h бит 7, v1.2 Шаг-2),
  639            ; приём RIM/SID @4800 - как v27
  640            ; =====================================================================
  641            
  642            ; ---------------------------------------------------------------------
  643            ; TXBYTE: A = байт -> сериализатор CPLD (1 000 000 8N1). Ожидает TXRDY
  644            ; (запись при busy аппаратно отбрасывается). Используется баннером/строками.
  645            ; ---------------------------------------------------------------------
  646  02DC: F5       TXBYTE: PUSH PSW
  647  02DD: DB 01    TXB1:   IN KBROWP           ; TXRDY = бит 7
  648  02DF: E6 80            ANI 80h             ; tx_idle = ~|bit_cnt: 1 = готов принять байт
  649  02E1: CA DD 02         JZ TXB1
  650  02E4: F1               POP PSW
  651  02E5: D3 04            OUT TXP
  652  02E7: C9               RET
  653            
  654            ; ---------------------------------------------------------------------
  655            ; TXSTR: HL = строка с нулевым завершителем -> TX. Портит A/HL.
  656            ; ---------------------------------------------------------------------
  657  02E8: 7E       TXSTR:  MOV A,M
  658  02E9: B7               ORA A
  659  02EA: C8               RZ
  660  02EB: CD DC 02         CALL TXBYTE
  661  02EE: 23               INX H
  662  02EF: C3 E8 02         JMP TXSTR
  663            
  664            ; ---------------------------------------------------------------------
  665            ; PAUSE: пауза D итераций (v2.0.5: DCR 5T + JNZ 10T/7T -> PAUSE(n) =
  666            ; 15n+24T c CALL/RET = 4,8n+7,7 мкс; модель 14T врала на ~7%).
  667            ; ---------------------------------------------------------------------
  668  02F2: 15       PAUSE:  DCR D
  669  02F3: C2 F2 02         JNZ PAUSE
  670  02F6: C9               RET
  671            
  672            ; ---------------------------------------------------------------------
  673            ; RXD: приём байта SID 4800 8N1 (фрагмент 7 + стоп-бит). Выход:
  674            ; C = байт, CY = 0 ОК / CY = 1 обрыв кадра (стоп-бит = 0). Портит A/B/C/D.
  675            ; Цикл строгий - в режиме B таймер ЗАМАСКИРОВАН (TMOFF: DI + SIM 1Fh)
  676            ; и пульки TMIARM запрещены - джиттера нет вообще.
  677            ; Константы v2.0.5: RXHB=17/RXFB=38, пересчёт по реальным тактам
  678            ; (scripts/rxd_cycles.py). Старые 19/41 (модель 14T) давали период бита
  679            ; 691-698T = 221-223 мкс вместо 208 -> d7 на 9,02-9,09 бита (СТОП-БИТ),
  680            ; стоп на 10,10-10,16 (idle): D7 всегда читалась как 1, ':' (3Ah) ->
  681            ; BAh, стоп высокий -> "успех" -> LOADM отбрасывал все ':' = вечный
  682            ; LLLL (diag_ph: 9F на любом символе - его d7 тоже уплывал в стоп).
  683            ; Новые: d0 1,45-1,47, d7 8,42-8,49, стоп 9,43-9,50 бита. v1.2: 15/30.
  684            ; ---------------------------------------------------------------------
  685  02F7: 06 08    RXD:    MVI B,08h
  686  02F9: 20       RXW:    RIM                 ; A7 = SID
  687  02FA: B7               ORA A
  688  02FB: FA F9 02         JM RXW              ; '1' (покой) - ждать старт-бит
  689  02FE: 16 12            MVI D,RXHB          ; полбита - в середину старт-бита
  690  0300: CD F2 02         CALL PAUSE
  691  0303: 20               RIM                 ; подтвердить старт-бит
  692  0304: B7               ORA A
  693  0305: FA F9 02         JM RXW              ; '1' - ложный старт, ждать заново
  694  0308: 0E 00            MVI C,00h
  695  030A: 16 29            MVI D,RXFB          ; бит - в середину D0
  696  030C: CD F2 02         CALL PAUSE
  697  030F: 20       RXL:    RIM                 ; A7 = SID - центр очередного бита
  698  0310: E6 80            ANI 80h
  699  0312: 07               RLC                 ; SID (A7) -> CY. ФИКС v2.0.5: было RAR(1F),
  700                                        ; но RAR берёт CY<-A0=0 и бит SID терялся;
  701                                        ; C собирался как 00h при любой линии                 ; бит -> CY
  702  0313: 79               MOV A,C
  703  0314: 1F               RAR                 ; вставить сверху (LSB-first)
  704  0315: 4F               MOV C,A
  705  0316: 16 29            MVI D,RXFB
  706  0318: CD F2 02         CALL PAUSE
  707  031B: 05               DCR B
  708  031C: C2 0F 03         JNZ RXL
  709                    ; после последней итерации RXL (выборка d7 + бит задержки)
  710                    ; линия = середина стоп-бита
  711  031F: 20               RIM
  712  0320: E6 80            ANI 80h             ; CY = 0 (ANI сбрасывает перенос)
  713  0322: CA 2B 03         JZ RXBAD            ; стоп-бит = 0 - обрыв кадра
  714            
  715  0325: 79               MOV A,C
  716  0326: E6 7F            ANI 7Fh             ; приводим принятый байт к чистому 7-битному ASCII (D7 = 0)
  717  0328: 4F               MOV C,A
  718            
  719  0329: B7               ORA A               ; CY = 0
  720  032A: C9               RET                 ; C = байт, CY = 0
  721                    ; СТАЛО (устойчивый приём стоп-бита на границе D7):
  722            ;        MVI B,15            ; окно ~100 мкс для дотягивания до стоп-бита
  723            ;RXST:   RIM
  724            ;        ANI 80h
  725            ;        JNZ RXOK            ; стоп-бит = 1 пойман!
  726            ;        DCR B
  727            ;        JNZ RXST
  728            ;        JMP RXBAD           ; линия застряла в 0 (реальный обрыв/Break)
  729            ;RXOK:   ORA A               ; CY = 0
  730            ;        RET                 ; C = байт, CY = 0
  731            
  732            
  733  032B: 37       RXBAD:  STC
  734  032C: C9               RET                 ; CY = 1
  735            
  736            ; ---------------------------------------------------------------------
  737            ; NIB: A = ASCII-символ -> CY = 1 и A = тетрада 0-F ('0'-'9','A'-'F',
  738            ; 'a'-'f'), иначе CY = 0. Портит A.
  739            ; ---------------------------------------------------------------------
  740  032D: D6 30    NIB:    SUI 30h             ; '0'..'9' -> 0..9
  741  032F: DA 4D 03         JC NIBX             ; < '0'
  742  0332: FE 0A            CPI 0Ah
  743  0334: DA 4B 03         JC NIBOK            ; цифра 0..9
  744  0337: D6 07            SUI 07h             ; 'A'..'F' -> 10..15
  745  0339: FE 10            CPI 10h
  746  033B: D2 41 03         JNC NIB2            ; > 'F' - попробовать строчные a..f
  747  033E: C3 4B 03         JMP NIBOK
  748  0341: D6 20    NIB2:   SUI 20h             ; ('a'-'0')-07h-20h = 10..15
  749  0343: FE 10            CPI 10h
  750  0345: D2 4D 03         JNC NIBX
  751  0348: C3 4B 03         JMP NIBOK
  752  034B: 37       NIBOK:  STC
  753  034C: C9               RET
  754  034D: B7       NIBX:   ORA A               ; CY = 0
  755  034E: C9               RET
  756            
  757            ; ---------------------------------------------------------------------
  758            ; LSTAT: A = глиф -> статический дисплей на РАЗРЯДЕ DIG0 (слот-система
  759            ; стоит). Для режимов загрузчика/RAM-теста, где ISR замаскирован (TMOFF).
  760            ; РЕШЕНИЕ ВЛАДЕЛЬЦА (11-22): один разряд вместо четырёх = минимальный
  761            ; ток дисплея во время теста ОЗУ/загрузки -> меньше просадка шины 5 В,
  762            ; чище тест ОЗУ. (В v1.2-v2.0.1 горели все 4 разряда - MVI A,0Fh.)
  763            ; ---------------------------------------------------------------------
  764  034F: C5       LSTAT:  PUSH B
  765  0350: 47               MOV B,A
  766  0351: AF               XRA A
  767  0352: D3 01            OUT SEGP            ; гашение на время переключения
  768  0354: 3E 01            MVI A,01h           ; только DIG0 - токи, см. шапку блока
  769  0356: D3 02            OUT DIGP            ; разряд активен, SND = 0
  770  0358: 78               MOV A,B
  771  0359: D3 01            OUT SEGP            ; глиф на активный разряд
  772  035B: C1               POP B
  773  035C: C9               RET
  774            
  775            ; ---------------------------------------------------------------------
  776            ; DLMS: пауза ~1,02 мс (K_MS=130 итераций 24T @320 нс = 1,002 мс).
  777            ; Портит A/B/C. H/L целы. ВНИМАНИЕ (п.3): внутри DLMS пульки TMIARM
  778            ; нет - на время паузы слоты стоят (один разряд горит ~1 мс, яркость
  779            ; не страдает - скважность 1/4 как всегда; каденция возвращается на
  780            ; следующем TMIARM-вызове).
  781            ; ---------------------------------------------------------------------
  782  035D: 01 82 00 DLMS:   LXI B,K_MS
  783  0360: 0B       DLS1:   DCX B
  784  0361: 78               MOV A,B
  785  0362: B1               ORA C
  786  0363: C2 60 03         JNZ DLS1
  787  0366: C9               RET
  788            
  789            ; ---------------------------------------------------------------------
  790            ; LDSUM: LSUM += B (mod 256). Портит A.
  791            ; ---------------------------------------------------------------------
  792  0367: F5       LDSUM:  PUSH PSW
  793  0368: 3A FE FF         LDA LSUM
  794  036B: 80               ADD B
  795  036C: 32 FE FF         STA LSUM
  796  036F: F1               POP PSW
  797  0370: C9               RET
  798            
  799            ; ---------------------------------------------------------------------
  800            ; LDBEEP: длинный сигнал ~0,3 с (тоггл D4 DIGP вручную: в B/F 7.5
  801            ; замаскирован (TMOFF) - ISR не пишет DIGP, конфликта нет; CALL
  802            ; TMIARM здесь не нужен (заглушка). Портит A/B/C/D.
  803            ; ---------------------------------------------------------------------
  804  0371: 16 96    LDBEEP: MVI D,150
  805  0373: 3E 1F    LDB1:   MVI A,1Fh           ; SND = 1, разряды on
  806  0375: D3 02            OUT DIGP
  807  0377: CD 5D 03         CALL DLMS
  808  037A: 3E 0F            MVI A,0Fh           ; SND = 0
  809  037C: D3 02            OUT DIGP
  810  037E: CD 5D 03         CALL DLMS
  811  0381: 15               DCR D
  812  0382: C2 73 03         JNZ LDB1
  813  0385: C9               RET
  814            
  815            ; =====================================================================
  816            ; LOADM: Intel HEX загрузчик (клавиша B). Приём SID 4800 8N1.
  817            ; Вход через KLD с TMOFF (7.5 замаскирован, DI) - как v27 по логике
  818            ; парсера. Формат записи: :nnaaaatt[dd...]cc, cc = (-сумма байт) mod 256.
  819            ; Статический дисплей 'L', после первой записи - счётчик записей mod 16
  820            ; на DIG0 (v2.0.6). Адрес каждой записи живёт в ADDRH/L.
  821            ; Запись только в ОЗУ (A15=1): попадание в ROM-окно = ошибка.
  822            ; Выход: EOF-запись (type 01) -> тик и меню; ошибка -> EEEE горит + звук
  823            ; SOS до нажатия Enter (v2.0.6), потом меню. Выход из зависшего приёма
  824            ; (тишина на SID) - RESET (SW20).
  825            ; NOTE: LACC/LNIB/LBPC/LSUM/LTY = клетки FFFB-FFFF; в обычном режиме
  826            ; FFFC-FFFF заняты KRAW (ISR) - в B маски стоят (TMOFF), конфликта нет;
  827            ; TMON на выходе чистит KRAW. XSSEQ/LST = FFFA: на входе LST=0 (=SEQ 0 -
  828            ; клиент логирует рестарт потока), на выходе TMON -> новое SEQ с 0.
  829            ; ---------------------------------------------------------------------
  830  0386: AF       LOADM:  XRA A
  831  0387: 32 FA FF         STA LST             ; ждем ':' (и XSSEQ = 0 - рестарт потока клиента)
  832  038A: 32 FD FF         STA LACC            ; накопитель тетрад тоже с нуля (баг v1.0:
  833                                        ;  сталь ломала первый байт первой записи)
  834  038D: 32 F5 FF         STA LDCTR           ; v2.0.6: счётчик записей = 0 ('L' до первой)
  835  0390: 3E 38            MVI A,38h           ; 'L'
  836  0392: CD 4F 03         CALL LSTAT
  837            
  838  0395: CD F7 02 LDLP:   CALL RXD
  839  0398: DA D9 04         JC LDERR            ; v2.0.6: приборация этапов парсера (v2.0.5G)
  840  039B: 79               MOV A,C             ;  удалена - байт в A и дальше по состоянию
  841  039C: FE 3A            CPI ':'
  842            
  843  039E: CA C4 04         JZ LDNEW            ; начало записи
  844            
  845            
  846            
  847            
  848  03A1: CD 2D 03         CALL NIB            ; тетрада?
  849  03A4: D2 95 03         JNC LDLP            ; прочее (\r\n и т.п.) - пропустить
  850  03A7: 5F               MOV E,A             ; E = тетрада (7.5 замаскирован - E свободен)
  851  03A8: 3A FD FF         LDA LACC
  852  03AB: 07               RLC
  853  03AC: 07               RLC
  854  03AD: 07               RLC
  855  03AE: 07               RLC                 ; накопитель << 4
  856  03AF: B3               ORA E
  857  03B0: 32 FD FF         STA LACC
