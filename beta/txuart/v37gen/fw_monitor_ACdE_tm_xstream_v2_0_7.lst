 1054            ; ---------------------------------------------------------------------
 1055            ; SCAN1: полный скан клавиатурной матрицы (вручную - в B/F ISR стоит).
 1056            ; Логика KSCOL, но все 4 колонки за проход. Возврат: A = код клавиши
 1057            ; (KEYTBL) первой нажатой (младший ряд первенствует, как в KDL) или
 1058            ; 0FFh. Портит A/B/C/D/H/L.
 1059            ; ---------------------------------------------------------------------
 1060  0550: 0E 00    SCAN1:  MVI C,0             ; колонка 0..3
 1061  0552: 06 00    SC1:    MVI B,0
 1062  0554: 21 54 00         LXI H,BITTBL
 1063  0557: 09               DAD B               ; HL = BITTBL + колонка (DAD B = +BC)
 1064  0558: 56               MOV D,M             ; D = бит колонки (01/02/04/08)
 1065  0559: 7A               MOV A,D
 1066  055A: 07               RLC
 1067  055B: 07               RLC
 1068  055C: 07               RLC
 1069  055D: 07               RLC                 ; бит колонки -> старший ниббл
 1070  055E: D3 08            OUT KBCOLP          ; колонка заведена (A[3:0] игнорируются)
 1071  0560: CD 56 01         CALL SETTLE
 1072  0563: DB 01            IN KBROWP
 1073  0565: E6 1F            ANI 1Fh             ; ряды (D7 TXRDY, D6-D5 фаза - маскируются)
 1074  0567: 47               MOV B,A             ; B = образ рядов
 1075  0568: AF               XRA A
 1076  0569: D3 08            OUT KBCOLP          ; колонка off
 1077  056B: 78               MOV A,B
 1078  056C: B7               ORA A
 1079  056D: CA 8C 05         JZ SCNC             ; колонка пуста
 1080  0570: 16 00            MVI D,0             ; D = номер ряда (младший установленный бит)
 1081  0572: 78       SC2:    MOV A,B
 1082  0573: 0F               RRC
 1083  0574: 47               MOV B,A
 1084  0575: DA 7C 05         JC SC3
 1085  0578: 14               INR D
 1086  0579: C3 72 05         JMP SC2
 1087  057C: 7A       SC3:    MOV A,D             ; код = KEYTBL[row*4+col]
 1088  057D: 07               RLC
 1089  057E: 07               RLC
 1090  057F: B1               ORA C
 1091  0580: 4F               MOV C,A
 1092  0581: 06 00            MVI B,0
 1093  0583: 21 58 00         LXI H,KEYTBL
 1094  0586: 09               DAD B
 1095  0587: 7E               MOV A,M
 1096  0588: FE FF            CPI 0FFh
 1097  058A: C8               RZ                  ; пустая позиция матрицы - клавиши нет
 1098  058B: C9               RET                 ; A = код клавиши
 1099  058C: 0C       SCNC:   INR C
 1100  058D: 79               MOV A,C
 1101  058E: FE 04            CPI 04h
 1102  0590: CA 96 05         JZ SCX
 1103  0593: C3 52 05         JMP SC1
 1104  0596: 3E FF    SCX:    MVI A,0FFh          ; весь скан чист - клавиш нет
 1105  0598: C9               RET
