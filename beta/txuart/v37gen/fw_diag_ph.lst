    1            ; =====================================================================
    2            ; beta/txuart/v37gen -- fw_diag_ph: ДИАГНОСТИКА RX v3 = НАБЛЮДАТЕЛЬ ФАЗ.
    3            ; Плата retro_pcld (CPLD v37G01), CPU 8085 @3,125 МГц.
    4            ;
    5            ;   ИСТОРИЯ: v1 (счёт фронтов) доказал - на SID приходят ЧИСТЫЕ кадры
    6            ;   (+3/+3 на символ). v2 (автобод+декод) показал: ширина старт-бита
    7            ;   ЧЕСТНАЯ 4800 (W=10h/0Fh), но байтовое поле НИКОГДА не обновляется.
    8            ;   Цикл-точная симуляция v2 говорит: декод ОБЯЗАН завершиться (стором
    9            ;   мусора или 'EE') - на железо это не доходит. ГДЕ рвётся - неясно.
   10            ;   v3 показывает это прямо на дисплее.
   11            ;
   12            ;   ДИСПЛЕЙ: DIG3-2 = W (ширина старт-бита, как v2), DIG1-0 = ФАЗА
   13            ;   последней попытки декода:
   14            ;       00 - попытка началась, но ни один масштаб задержки не подтвердил
   15            ;            старт-бит (все 4 подтверд reading HIGH - ложные старты)
   16            ;       01..04 - подтверждение ПРОШЛО на масштабе N (см. ниже)
   17            ;       9F     - выборки завершены, стоп-бит = 1 (успех - байт бы записан)
   18            ;       9E     - выборки завершены, стоп-бит = 0 (обрыв кадра, 'EE' в v2)
   19            ;   МАСШТАБЫ (idx 1..4): полубит-задержка = C>>idx, где C = полный бит
   20            ;   (4800 -> C=44 ед. DLAY): idx1 = DLAY(22) ~110 мкс (номинал),
   21            ;   idx2 = DLAY(11), idx3 = DLAY(5), idx4 = DLAY(2). Последовательность
   22            ;   22->11->5->2: первый масштаб, при котором контрольная выборка после
   23            ;   падения читает НИЗ, фиксируется в фазе. ЕСЛИ DLAY на железе работает
   24            ;   в 2 раза медленнее модели - idx1 промахнётся мимо бита, idx2
   25            ;   подтвердит -> фаза 02 укажет двукратный замедление. И т.д.
   26            ;   Выборки после подтверждения идут с полным битом = 2*(C>>idx) - тем
   27            ;   же масштабом. Поэтому 91..94 = цикл выборок ДОШЁЛ до конца.
   28            ;
   29            ;   КАК ТЕСТИРОВАТЬ: терминал 4800 8N1, набирать '5' или 'U' (0x35/0x55
   30            ;   - одиночные нулевые биты: D0=1, изолированные D1=0/D3=0 - чистый
   31            ;   тест). Писать в ответ ЧТО показала фаза.
   32            ;   Фильтр глитчей: ширина < 6 ед. (~70 мкс) игнорируется целиком и НЕ
   33            ;   портит MINW (в v2 короткий низ навсегда занижал минимум - "0600").
   34            ;
   35            ;   ПОРТЫ: 00h сегменты (D0=a..D6=g), 01h разряды D3-D0 + D4 SND.
   36            ;   RAM: PREV=FFE8, MINW=FFE9, WGLH=FFEA, WGLL=FFEB, PH=FFECh.
   37            ;   SP=FFE7. Прерываний нет. Выход - RESET, потом вернуть монитор.
   38            ; =====================================================================
   39            
   40            SEGP    EQU 00h
   41            DIGP    EQU 01h
   42            
   43            PREV    EQU 0FFE8h          ; предыдущий уровень SID (00h/80h)
   44            MINW    EQU 0FFE9h          ; ширина старт-бита (ед. ~11,8 мкс), FF = не мерили
   45            WGLH    EQU 0FFEAh          ; глиф старшей тетрады W
   46            WGLL    EQU 0FFEBh          ; глиф младшей тетрады W
   47            PH      EQU 0FFECh          ; фаза последней попытки декода
   48            
   49  0000: -                ORG 0000h
   50  0000: C3 40 00         JMP START
   51            
   52  0008: -                ORG 0008h
   53  0008: C9               RET
   54  0010: -                ORG 0010h
   55  0010: C9               RET
   56  0018: -                ORG 0018h
   57  0018: C9               RET
   58  0020: -                ORG 0020h
   59  0020: C9               RET
   60  0024: -                ORG 0024h
   61  0024: C9               RET
   62  0028: -                ORG 0028h
   63  0028: C9               RET
   64  0030: -                ORG 0030h
   65  0030: C9               RET
   66  0038: -                ORG 0038h
   67  0038: C9               RET
   68  003C: -                ORG 003Ch
   69  003C: C9               RET
   70            
   71            ; ---------------------------------------------------------------------
   72  0040: -                ORG 0040h
   73  0040: 31 E7 FF START:  LXI SP,0FFE7h
   74  0043: AF               XRA A
   75  0044: D3 00            OUT SEGP
   76  0046: D3 01            OUT DIGP
   77  0048: 32 EA FF         STA WGLH            ; W-глифы blank
   78  004B: 32 EB FF         STA WGLL
   79  004E: 32 EC FF         STA PH              ; фаза 00
   80  0051: 3E FF            MVI A,0FFh
   81  0053: 32 E9 FF         STA MINW            ; ширина не измерена
   82  0056: 20               RIM
   83  0057: E6 80            ANI 80h
   84  0059: 32 E8 FF         STA PREV            ; без фантомного фронта
   85            
   86            ; ---- развёртка 4 разрядов, в паузах - опрос SID ----
   87  005C: 3A EA FF MAIN:   LDA WGLH
   88  005F: 06 08            MVI B,08h           ; DIG3 = W старшая
   89  0061: CD 93 00         CALL SLOT
   90  0064: DA B7 00         JC  MEAS
   91  0067: 3A EB FF         LDA WGLL
   92  006A: 06 04            MVI B,04h           ; DIG2 = W младшая
   93  006C: CD 93 00         CALL SLOT
   94  006F: DA B7 00         JC  MEAS
   95  0072: 3A EC FF         LDA PH
   96  0075: 47               MOV B,A
   97  0076: CD 8F 01         CALL GNIBH
   98  0079: 06 02            MVI B,02h           ; DIG1 = фаза старшая
   99  007B: CD 93 00         CALL SLOT
  100  007E: DA B7 00         JC  MEAS
  101  0081: 3A EC FF         LDA PH
  102  0084: 47               MOV B,A
  103  0085: CD 99 01         CALL GNIBL
  104  0088: 06 01            MVI B,01h           ; DIG0 = фаза младшая
  105  008A: CD 93 00         CALL SLOT
  106  008D: DA B7 00         JC  MEAS
  107  0090: C3 5C 00         JMP MAIN
  108            
  109            ; ---------------------------------------------------------------------
  110            ; SLOT: глиф (A) на разряд (B) ~3 мс, всю паузу опрос SID (итерация
  111            ; 39T, PREV кэшируется в E). Падающий фронт -> CY=1, ранний выход.
  112  0093: D3 00    SLOT:   OUT SEGP
  113  0095: 78               MOV A,B
  114  0096: D3 01            OUT DIGP
  115  0098: 16 C8            MVI D,0C8h
  116  009A: 3A E8 FF         LDA PREV
  117  009D: 5F               MOV E,A
  118  009E: 20       SLOT1:  RIM
  119  009F: E6 80            ANI 80h
  120  00A1: 4F               MOV C,A
  121  00A2: 7B               MOV A,E
  122  00A3: B9               CMP C
  123  00A4: CA B1 00         JZ  SLOT2
  124  00A7: 79               MOV A,C
  125  00A8: 32 E8 FF         STA PREV
  126  00AB: 5F               MOV E,A
  127  00AC: DA B1 00         JC  SLOT2
  128  00AF: 37               STC
  129  00B0: C9               RET
  130  00B1: 15       SLOT2:  DCR D
  131  00B2: C2 9E 00         JNZ SLOT1
  132  00B5: AF               XRA A
  133  00B6: C9               RET
  134            
  135            ; ---------------------------------------------------------------------
  136            ; MEAS: ширина низа, фильтр глитчей, минимум, классификация, попытка.
  137  00B7: 0E 00    MEAS:   MVI C,00h
  138  00B9: 20       WLP:    RIM
  139  00BA: B7               ORA A
  140  00BB: FA C5 00         JM  WDONE
  141  00BE: 0C               INR C
  142  00BF: CA 82 01         JZ  WOVF
  143  00C2: C3 B9 00         JMP WLP
  144  00C5: 3E 80    WDONE:  MVI A,80h
  145  00C7: 32 E8 FF         STA PREV
  146  00CA: 79               MOV A,C             ; A = W
  147  00CB: FE 06            CPI 06h             ; < 6 ед. (~70 мкс) - глитч, НЕ трогать MINW
  148  00CD: DA 7F 01         JC  MEASX
  149  00D0: 3A E9 FF         LDA MINW
  150  00D3: B9               CMP C               ; MINW < W? - кадр шире минимума, фаза сомнительна
  151  00D4: DA 7F 01         JC  MEASX
  152  00D7: 79               MOV A,C
  153  00D8: 32 E9 FF         STA MINW
  154  00DB: 47               MOV B,A
  155  00DC: CD 8F 01         CALL GNIBH
  156  00DF: 32 EA FF         STA WGLH
  157  00E2: CD 99 01         CALL GNIBL
  158  00E5: 32 EB FF         STA WGLL
  159  00E8: 78               MOV A,B             ; классификация W
  160  00E9: FE 0E            CPI 0Eh             ; [6..13] - 9600
  161  00EB: DA 00 01         JC  SP9600
  162  00EE: FE 1C            CPI 1Ch             ; [14..27] - 4800
  163  00F0: DA 05 01         JC  SP4800
  164  00F3: FE 38            CPI 38h             ; [28..55] - 2400
  165  00F5: DA 0A 01         JC  SP2400
  166  00F8: FE 6F            CPI 6Fh             ; [56..110] - 1200
  167  00FA: DA 0F 01         JC  SP1200
  168  00FD: C3 7F 01         JMP MEASX
  169  0100: 0E 15    SP9600: MVI C,15h
  170  0102: C3 11 01         JMP RXD3
  171  0105: 0E 2C    SP4800: MVI C,2Ch
  172  0107: C3 11 01         JMP RXD3
  173  010A: 0E 5A    SP2400: MVI C,5Ah
  174  010C: C3 11 01         JMP RXD3
  175  010F: 0E B7    SP1200: MVI C,0B7h
  176            ; ---------------------------------------------------------------------
  177            ; RXD3: попытка декода с ПЕРЕБОРОМ МАСШТАБА полубита.
  178            ; C = полный бит (ед. DLAY). idx = 1..4: полубит = C>>idx.
  179  0111: AF       RXD3:   XRA A
  180  0112: 32 EC FF         STA PH              ; фаза 00 на время попытки
  181  0115: 26 00            MVI H,00h           ; idx-1
  182  0117: 20       IDLE3:  RIM                 ; дождаться idle-high
  183  0118: B7               ORA A
  184  0119: F2 17 01         JP  IDLE3
  185  011C: 06 08            MVI B,08h
  186  011E: 20       RXW3:   RIM                 ; ждать падение (старт-бит или фронт внутри кадра)
  187  011F: B7               ORA A
  188  0120: FA 1E 01         JM  RXW3
  189  0123: -        CONFSEQ:
  190  0123: 79               MOV A,C
  191  0124: 5F               MOV E,A             ; E = база (полный бит)
  192  0125: 24               INR H               ; H = idx (1..4)
  193  0126: 7C               MOV A,H
  194  0127: 47               MOV B,A             ; B = счётчик сдвигов
  195  0128: 7B       SHFLP:  MOV A,E
  196  0129: 0F               RRC
  197  012A: E6 7F            ANI 7Fh             ; RRC нечётных тянет A0 в A7 - маскировать
  198  012C: 5F               MOV E,A
  199  012D: 05               DCR B
  200  012E: C2 28 01         JNZ SHFLP           ; E = полубит масштаба idx
  201  0131: 7B               MOV A,E
  202  0132: 57               MOV D,A
  203  0133: CD 8A 01         CALL DLAY
  204  0136: 20               RIM                 ; контрольная выборка: старт ещё низкий?
  205  0137: B7               ORA A
  206  0138: FA 6F 01         JM  NXTDL           ; HIGH - ложный старт на этом масштабе
  207  013B: 7C               MOV A,H
  208  013C: 32 EC FF         STA PH              ; PH = idx - подтверждено на масштабе idx
  209  013F: 7B               MOV A,E
  210  0140: 87               ADD A               ; полный бит = 2 x полубит
  211  0141: 5F               MOV E,A
  212  0142: 06 08            MVI B,08h
  213  0144: 7B               MOV A,E
  214  0145: 57               MOV D,A
  215  0146: CD 8A 01         CALL DLAY           ; центр D0
  216  0149: 20       RXL3:   RIM
  217  014A: E6 80            ANI 80h
  218  014C: 1F               RAR
  219  014D: 7D               MOV A,L
  220  014E: 1F               RAR                 ; биты в L (не используется дальше - честный цикл)
  221  014F: 6F               MOV L,A
  222  0150: 7B               MOV A,E
  223  0151: 57               MOV D,A
  224  0152: CD 8A 01         CALL DLAY
  225  0155: 05               DCR B
  226  0156: C2 49 01         JNZ RXL3
  227  0159: 20               RIM                 ; центр стоп-бита
  228  015A: E6 80            ANI 80h
  229  015C: CA 67 01         JZ  PHBAD
  230  015F: 3E 9F            MVI A,9Fh           ; выборки + стоп=1: полный успех
  231  0161: 32 EC FF         STA PH
  232  0164: C3 7F 01         JMP MEASX
  233  0167: 3E 9E    PHBAD:  MVI A,9Eh           ; выборки + стоп=0: обрыв кадра
  234  0169: 32 EC FF         STA PH
  235  016C: C3 7F 01         JMP MEASX
  236  016F: 7C       NXTDL:  MOV A,H
  237  0170: FE 04            CPI 04h
  238  0172: CA 78 01         JZ  CONF0           ; все 4 масштаба дали HIGH
  239  0175: C3 23 01         JMP CONFSEQ
  240  0178: AF       CONF0:  XRA A
  241  0179: 32 EC FF         STA PH
  242  017C: C3 7F 01         JMP MEASX
  243  017F: C3 5C 00 MEASX:  JMP MAIN
  244            
  245  0182: 3E 80    WOVF:   MVI A,80h
  246  0184: 32 E8 FF         STA PREV
  247  0187: C3 7F 01         JMP MEASX
  248            
  249            ; ---------------------------------------------------------------------
  250            ; DLAY: (34 + 14*n)T = 10,9 + 4,48n мкс. Вход D = n (>=1).
  251  018A: 15       DLAY:   DCR D
  252  018B: C2 8A 01         JNZ DLAY
  253  018E: C9               RET
  254            
  255            ; GNIBH/GNIBL: байт в B -> A = глиф тетрады. Сохраняет B/C.
  256  018F: 78       GNIBH:  MOV A,B
  257  0190: 0F               RRC
  258  0191: 0F               RRC
  259  0192: 0F               RRC
  260  0193: 0F               RRC
  261  0194: E6 0F            ANI 0Fh
  262  0196: C3 9C 01         JMP GNIBC
  263  0199: 78       GNIBL:  MOV A,B
  264  019A: E6 0F            ANI 0Fh
  265  019C: 5F       GNIBC:  MOV E,A
  266  019D: 16 00            MVI D,00h
  267  019F: 21 A5 01         LXI H,GTBL
  268  01A2: 19               DAD D
  269  01A3: 7E               MOV A,M
  270  01A4: C9               RET
  271            
  272  01A5: 3F       GTBL:   DB 3Fh              ; '0'
  273  01A6: 06               DB 06h              ; '1'
  274  01A7: 5B               DB 5Bh              ; '2'
  275  01A8: 4F               DB 4Fh              ; '3'
  276  01A9: 66               DB 66h              ; '4'
  277  01AA: 6D               DB 6Dh              ; '5'
  278  01AB: 7D               DB 7Dh              ; '6'
  279  01AC: 07               DB 07h              ; '7'
  280  01AD: 7F               DB 7Fh              ; '8'
  281  01AE: 6F               DB 6Fh              ; '9'
  282  01AF: 77               DB 77h              ; 'A'
  283  01B0: 7C               DB 7Ch              ; 'b'
  284  01B1: 39               DB 39h              ; 'C'
  285  01B2: 5E               DB 5Eh              ; 'd'
  286  01B3: 79               DB 79h              ; 'E'
  287  01B4: 71               DB 71h              ; 'F'
