  735            ; ---------------------------------------------------------------------
  736            ; LSTAT: A = глиф -> статический дисплей на РАЗРЯДЕ DIG0 (слот-система
  737            ; стоит). Для режимов загрузчика/RAM-теста, где ISR замаскирован (TMOFF).
  738            ; РЕШЕНИЕ ВЛАДЕЛЬЦА (11-22): один разряд вместо четырёх = минимальный
  739            ; ток дисплея во время теста ОЗУ/загрузки -> меньше просадка шины 5 В,
  740            ; чище тест ОЗУ. (В v1.2-v2.0.1 горели все 4 разряда - MVI A,0Fh.)
  741            ; ---------------------------------------------------------------------
  742  034F: C5       LSTAT:  PUSH B
  743  0350: 47               MOV B,A
  744  0351: AF               XRA A
  745  0352: D3 00            OUT SEGP            ; гашение на время переключения
  746  0354: 3E 01            MVI A,01h           ; только DIG0 - токи, см. шапку блока
  747  0356: D3 01            OUT DIGP            ; разряд активен, SND = 0
  748  0358: 78               MOV A,B
  749  0359: D3 00            OUT SEGP            ; глиф на активный разряд
  750  035B: C1               POP B
  751  035C: C9               RET
