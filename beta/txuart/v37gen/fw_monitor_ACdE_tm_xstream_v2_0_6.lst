 1032            ; ---------------------------------------------------------------------
 1033            ; SCAN1: полный скан клавиатурной матрицы (вручную - в B/F ISR стоит).
 1034            ; Логика KSCOL, но все 4 колонки за проход. Возврат: A = код клавиши
 1035            ; (KEYTBL) первой нажатой (младший ряд первенствует, как в KDL) или
 1036            ; 0FFh. Портит A/B/C/D/H/L.
 1037            ; ---------------------------------------------------------------------
 1038  0550: 0E 00    SCAN1:  MVI C,0             ; колонка 0..3
 1039  0552: 06 00    SC1:    MVI B,0
 1040  0554: 21 54 00         LXI H,BITTBL
 1041  0557: 09               DAD B               ; HL = BITTBL + колонка (DAD B = +BC)
 1042  0558: 56               MOV D,M             ; D = бит колонки (01/02/04/08)
 1043  0559: 7A               MOV A,D
 1044  055A: 07               RLC
 1045  055B: 07               RLC
 1046  055C: 07               RLC
 1047  055D: 07               RLC                 ; бит колонки -> старший ниббл
 1048  055E: D3 06            OUT KBCOLP          ; колонка заведена (A[3:0]=0 - таймер не пишется)
 1049  0560: CD 56 01         CALL SETTLE
 1050  0563: DB 03            IN KBROWP
 1051  0565: E6 1F            ANI 1Fh             ; ряды (D7 TXRDY, D6-D5 фаза - маскируются)
 1052  0567: 47               MOV B,A             ; B = образ рядов
 1053  0568: AF               XRA A
 1054  0569: D3 06            OUT KBCOLP          ; колонка off
 1055  056B: 78               MOV A,B
 1056  056C: B7               ORA A
 1057  056D: CA 8C 05         JZ SCNC             ; колонка пуста
 1058  0570: 16 00            MVI D,0             ; D = номер ряда (младший установленный бит)
 1059  0572: 78       SC2:    MOV A,B
 1060  0573: 0F               RRC
 1061  0574: 47               MOV B,A
 1062  0575: DA 7C 05         JC SC3
 1063  0578: 14               INR D
 1064  0579: C3 72 05         JMP SC2
 1065  057C: 7A       SC3:    MOV A,D             ; код = KEYTBL[row*4+col]
 1066  057D: 07               RLC
 1067  057E: 07               RLC
 1068  057F: B1               ORA C
 1069  0580: 4F               MOV C,A
 1070  0581: 06 00            MVI B,0
 1071  0583: 21 58 00         LXI H,KEYTBL
 1072  0586: 09               DAD B
 1073  0587: 7E               MOV A,M
 1074  0588: FE FF            CPI 0FFh
 1075  058A: C8               RZ                  ; пустая позиция матрицы - клавиши нет
 1076  058B: C9               RET                 ; A = код клавиши
 1077  058C: 0C       SCNC:   INR C
 1078  058D: 79               MOV A,C
 1079  058E: FE 04            CPI 04h
 1080  0590: CA 96 05         JZ SCX
 1081  0593: C3 52 05         JMP SC1
 1082  0596: 3E FF    SCX:    MVI A,0FFh          ; весь скан чист - клавиш нет
 1083  0598: C9               RET
