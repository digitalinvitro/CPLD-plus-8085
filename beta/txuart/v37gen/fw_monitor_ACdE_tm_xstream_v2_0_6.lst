  700            ;        MVI B,15            ; окно ~100 мкс для дотягивания до стоп-бита
  701            ;RXST:   RIM
  702            ;        ANI 80h
  703            ;        JNZ RXOK            ; стоп-бит = 1 пойман!
  704            ;        DCR B
  705            ;        JNZ RXST
  706            ;        JMP RXBAD           ; линия застряла в 0 (реальный обрыв/Break)
