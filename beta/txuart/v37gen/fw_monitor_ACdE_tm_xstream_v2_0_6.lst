  714            ; ---------------------------------------------------------------------
  715            ; NIB: A = ASCII-символ -> CY = 1 и A = тетрада 0-F ('0'-'9','A'-'F',
  716            ; 'a'-'f'), иначе CY = 0. Портит A.
  717            ; ---------------------------------------------------------------------
