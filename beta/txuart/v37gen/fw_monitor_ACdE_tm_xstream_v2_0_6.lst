  753            ; ---------------------------------------------------------------------
  754            ; DLMS: пауза ~1,02 мс (K_MS=130 итераций 24T @320 нс = 1,002 мс).
  755            ; Портит A/B/C. H/L целы. ВНИМАНИЕ (п.3): внутри DLMS пульки TMIARM
  756            ; нет - на время паузы слоты стоят (один разряд горит ~1 мс, яркость
  757            ; не страдает - скважность 1/4 как всегда; каденция возвращается на
  758            ; следующем TMIARM-вызове).
  759            ; ---------------------------------------------------------------------
  760  035D: 01 82 00 DLMS:   LXI B,K_MS
  761  0360: 0B       DLS1:   DCX B
  762  0361: 78               MOV A,B
  763  0362: B1               ORA C
  764  0363: C2 60 03         JNZ DLS1
  765  0366: C9               RET
