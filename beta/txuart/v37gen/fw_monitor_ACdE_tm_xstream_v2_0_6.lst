 1212            ; ---------------------------------------------------------------------
 1213            ; XSEND: кадр XSTREAM в UART: A5 5A [SEQ] + 2000 Б из XBUF.
 1214            ;   Сохраняет PSW/B/D/H. РАВНОМЕРНЫЙ пейсинг 36,75T/Б без опроса TXRDY:
 1215            ;   на 3,125 МГц 36,75T = 11,8 мкс >= 10 мкс байта 1M. CALL TMIARM
 1216            ;   (заглушка RET) в шапке КАЖДОЙ 8-Б подгруппы (~94 мкс): слот
 1217            ;   приходит САМ раз в 4,096 мс, ISR-вставка ~170 мкс удлиняет текущий
 1218            ;   гэп (мин. 25T соблюдён) - ноль отбросов TX; регенерация/скан идут
 1219            ;   ВНУТРИ посылки. Кадр ~37 мс (~27 FPS; v1.2: ~42).
 1220            ; ---------------------------------------------------------------------
 1221  063B: F5       XSEND:  PUSH PSW
 1222  063C: C5               PUSH B
 1223  063D: D5               PUSH D
 1224  063E: E5               PUSH H
 1225  063F: CD AE 06         CALL XUPDCTR        ; живой счётчик SEQ в демо-экран
 1226  0642: 3E A5            MVI A,0A5h
 1227  0644: D3 04            OUT TXPORT          ; шапка: равномерный пейсинг 33T (4 NOP)
 1228  0646: 00               NOP
 1229  0647: 00               NOP
 1230  0648: 00               NOP
 1231  0649: 00               NOP
 1232  064A: 3E 5A            MVI A,05Ah
 1233  064C: D3 04            OUT TXPORT
 1234  064E: 00               NOP
 1235  064F: 00               NOP
 1236  0650: 00               NOP
 1237  0651: 00               NOP
 1238  0652: 3A FA FF         LDA XSSEQ
 1239  0655: D3 04            OUT TXPORT
 1240  0657: 00               NOP
 1241  0658: 00               NOP
 1242  0659: 00               NOP
 1243  065A: 00               NOP
 1244  065B: 3C               INR A
 1245  065C: 32 FA FF         STA XSSEQ           ; SEQ++ mod 256
 1246  065F: 21 00 B0         LXI H,XBUF          ; HL = экран
 1247  0662: 06 0A            MVI B,10            ; внешний: 10 групп по 200 Б
 1248  0664: 0E 19    XSOUT:  MVI C,25            ; внутренний: 25 подгрупп по 8 Б
 1249  0666: CD 21 01 XSL:    CALL TMIARM         ; заглушка RET; слот приходит сам (4,096 мс)
 1250  0669: 7E               MOV A,M             ; ISR вставляет ~170 мкс; гэп OUT->OUT >= 25T
 1251  066A: D3 04            OUT TXPORT          ; равномерный пейсинг: гэп OUT->OUT >= 25T байта
 1252  066C: 23               INX H
 1253  066D: 00               NOP
 1254  066E: 00               NOP
 1255  066F: 00               NOP
 1256  0670: 7E               MOV A,M
 1257  0671: D3 04            OUT TXPORT
