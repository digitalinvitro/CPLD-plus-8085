 1159            ; =====================================================================
 1160            ;                    XSTREAM: ЭКРАН -> UART (п.8: непрерывный поток,
 1161            ;                    тик кадра = сама скорость канала, регенерация/
 1162            ;                    скан ведётся пульками TMIARM внутри посылки)
 1163            ; =====================================================================
 1164            ; ---------------------------------------------------------------------
 1165            ; XSINIT (из START, только холодный старт): демо-экран в B000h,
 1166            ; SEQ = 0. Мониторные переменные не трогаются; B000-B7CF -
 1167            ; пользовательская область: ЛЮБАЯ программа может рисовать туда
 1168            ; свой текст/графику, клиент xstream_view.ps1 покажет окном.
 1169            ; ---------------------------------------------------------------------
 1170  05FF: CD 21 06 XSINIT: CALL XBLANK
 1171  0602: 21 83 08         LXI H,XTBL
 1172  0605: 5E       XSI1:   MOV E,M             ; DE = адрес назначения
 1173  0606: 23               INX H
 1174  0607: 56               MOV D,M
 1175  0608: 23               INX H               ; HL -> src_lo
 1176  0609: 7A               MOV A,D             ; конец таблицы (dst == 0000)?
 1177  060A: B3               ORA E
 1178  060B: CA 1C 06         JZ XSI3
 1179  060E: 4E               MOV C,M             ; BC = адрес строки (источник)
 1180  060F: 23               INX H
 1181  0610: 46               MOV B,M
 1182  0611: 23               INX H               ; HL -> следующая запись
 1183  0612: E5               PUSH H              ; указатель следующей записи -> стек
 1184  0613: 60               MOV H,B
 1185  0614: 69               MOV L,C
 1186  0615: CD 32 06         CALL XCPY           ; ASCIZ [HL] -> [DE], 0 = конец
 1187  0618: E1               POP H
 1188  0619: C3 05 06         JMP XSI1
 1189  061C: AF       XSI3:   XRA A
 1190  061D: 32 FA FF         STA XSSEQ
 1191  0620: C9               RET
 1192            
 1193  0621: 21 00 B0 XBLANK: LXI H,XBUF          ; 2000 пробелов
 1194  0624: 01 D0 07         LXI B,2000
 1195  0627: 3E 20    XB1:    MVI A,20h
 1196  0629: 77               MOV M,A
 1197  062A: 23               INX H
 1198  062B: 0B               DCX B
 1199  062C: 78               MOV A,B
 1200  062D: B1               ORA C
 1201  062E: C2 27 06         JNZ XB1
 1202  0631: C9               RET
 1203            
 1204  0632: 7E       XCPY:   MOV A,M             ; ASCIZ: [HL]->[DE], 0 = конец (A/флаги)
 1205  0633: B7               ORA A
 1206  0634: C8               RZ
 1207  0635: 12               STAX D
 1208  0636: 23               INX H
 1209  0637: 13               INX D
 1210  0638: C3 32 06         JMP XCPY
