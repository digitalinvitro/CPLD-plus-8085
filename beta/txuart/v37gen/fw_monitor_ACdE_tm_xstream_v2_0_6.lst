  720  0332: FE 0A            CPI 0Ah
  721  0334: DA 4B 03         JC NIBOK            ; цифра 0..9
  722  0337: D6 07            SUI 07h             ; 'A'..'F' -> 10..15
  723  0339: FE 10            CPI 10h
  724  033B: D2 41 03         JNC NIB2            ; > 'F' - попробовать строчные a..f
  725  033E: C3 4B 03         JMP NIBOK
  726  0341: D6 20    NIB2:   SUI 20h             ; ('a'-'0')-07h-20h = 10..15
  727  0343: FE 10            CPI 10h
  728  0345: D2 4D 03         JNC NIBX
  729  0348: C3 4B 03         JMP NIBOK
  730  034B: 37       NIBOK:  STC
  731  034C: C9               RET
  732  034D: B7       NIBX:   ORA A               ; CY = 0
  733  034E: C9               RET
