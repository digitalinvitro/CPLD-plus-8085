 1101            ; =====================================================================
 1102            ; RAMT: RAM-тест 8000h-FFD7h (клавиша F). 4 паттерна 00/FF/55/AA:
 1103            ; заполнение + контроль побайтно. Статический дисплей (DIG0) = глиф
 1104            ; паттерна ("0000"/"FFFF"/"5555"/"AAAA"). Сбой: ADDRH/L = адрес сбоя,
 1105            ; EEEE + длинный сигнал. Успех: короткий тик. Вход через KRAM с TMOFF:
 1106            ; 7.5 замаскирован - ISR не толкает стек в диапазон теста.
 1107            ; ГРАНИЦА: FFD8h-FFE7h НЕ тестируется (фикс v2.0.2/tw): там живёт стек
 1108            ; монитора - собственный адрес возврата RAMT лежит в FFE7h/FFE6h, и
 1109            ; заполнение до FFE7h затирало его -> после теста RET в мусор. Стек до
 1110            ; FFD4h не доходит (RAMT без длинных push). Портит всё, кроме клеток.
 1111            ; ФИКС v2.0.2 (tw): паттерн восстанавливается из E на каждом шаге
 1112            ; (MOV A,E): в v1.2-v2.0.1 MOV A,H после INX H затирал паттерн в A и
 1113            ; с 8001h писались МЛАДШИЕ БАЙТЫ АДРЕСА -> вечная "ошибка ОЗУ".
 1114            ; ---------------------------------------------------------------------
 1115  05B2: 21 76 00 RAMT:   LXI H,RAMPAT        ; HL = текущая пара (value+glyph)
 1116  05B5: 0E 04            MVI C,04h           ; 4 паттерна
 1117  05B7: 7E       RMT0:   MOV A,M             ; A = значение паттерна
 1118  05B8: 5F               MOV E,A
 1119  05B9: E5               PUSH H              ; указатель пары - на стек (HL уйдёт под заполнение)
 1120  05BA: 23               INX H
 1121  05BB: 7E               MOV A,M             ; глиф паттерна
 1122  05BC: CD 4F 03         CALL LSTAT          ; статический дисплей ("0000" и т.д.)
 1123  05BF: 7B               MOV A,E
 1124  05C0: 21 00 80         LXI H,8000h
 1125  05C3: 7B       RMF:    MOV A,E             ; паттерн из E на КАЖДОМ шаге (фикс v2.0.2)
 1126  05C4: 77               MOV M,A             ; заполнение
 1127  05C5: 23               INX H
 1128  05C6: 7C               MOV A,H
 1129  05C7: FE FD            CPI 0FDh
 1130  05C9: C2 C3 05         JNZ RMF
 1131  05CC: 7D               MOV A,L
 1132  05CD: FE D8            CPI 0D8h
 1133  05CF: C2 C3 05         JNZ RMF
 1134  05D2: 21 00 80         LXI H,8000h
 1135  05D5: 7E       RMV:    MOV A,M             ; контроль (8000h..FFD7h)
 1136  05D6: BB               CMP E
 1137  05D7: C2 F2 05         JNZ RMBAD
 1138  05DA: 23               INX H
 1139  05DB: 7C               MOV A,H
 1140  05DC: FE FD            CPI 0FDh
 1141  05DE: C2 D5 05         JNZ RMV
 1142  05E1: 7D               MOV A,L
 1143  05E2: FE D8            CPI 0D8h
 1144  05E4: C2 D5 05         JNZ RMV
 1145  05E7: E1               POP H               ; HL = пара паттерна
 1146  05E8: 23               INX H
 1147  05E9: 23               INX H               ; следующая пара
 1148  05EA: 0D               DCR C
 1149  05EB: C2 B7 05         JNZ RMT0
 1150  05EE: CD A0 01         CALL TICKON         ; ОК
 1151  05F1: C9               RET
 1152  05F2: 22 EB FF RMBAD:  SHLD ADDRL          ; ADDRH/L = адрес сбоя (HL из RMV, до POP!)
 1153  05F5: E1               POP H               ; снять указатель пары (баланс стека)
 1154  05F6: 3E 79            MVI A,79h           ; 'E' -> EEEE
 1155  05F8: CD 4F 03         CALL LSTAT
 1156  05FB: CD 71 03         CALL LDBEEP
 1157  05FE: C9               RET                 ; в меню; D = просмотр байта по адресу сбоя
