  650            ; ---------------------------------------------------------------------
  651            ; RXD: приём байта SID 4800 8N1 (фрагмент 7 + стоп-бит). Выход:
  652            ; C = байт, CY = 0 ОК / CY = 1 обрыв кадра (стоп-бит = 0). Портит A/B/C/D.
  653            ; Цикл строгий - в режиме B таймер ЗАМАСКИРОВАН (TMOFF: DI + SIM 1Fh)
  654            ; и пульки TMIARM запрещены - джиттера нет вообще.
  655            ; Константы v2.0.5: RXHB=17/RXFB=38, пересчёт по реальным тактам
  656            ; (scripts/rxd_cycles.py). Старые 19/41 (модель 14T) давали период бита
  657            ; 691-698T = 221-223 мкс вместо 208 -> d7 на 9,02-9,09 бита (СТОП-БИТ),
  658            ; стоп на 10,10-10,16 (idle): D7 всегда читалась как 1, ':' (3Ah) ->
  659            ; BAh, стоп высокий -> "успех" -> LOADM отбрасывал все ':' = вечный
  660            ; LLLL (diag_ph: 9F на любом символе - его d7 тоже уплывал в стоп).
  661            ; Новые: d0 1,45-1,47, d7 8,42-8,49, стоп 9,43-9,50 бита. v1.2: 15/30.
  662            ; ---------------------------------------------------------------------
  663  02F7: 06 08    RXD:    MVI B,08h
  664  02F9: 20       RXW:    RIM                 ; A7 = SID
  665  02FA: B7               ORA A
  666  02FB: FA F9 02         JM RXW              ; '1' (покой) - ждать старт-бит
  667  02FE: 16 12            MVI D,RXHB          ; полбита - в середину старт-бита
  668  0300: CD F2 02         CALL PAUSE
  669  0303: 20               RIM                 ; подтвердить старт-бит
  670  0304: B7               ORA A
  671  0305: FA F9 02         JM RXW              ; '1' - ложный старт, ждать заново
  672  0308: 0E 00            MVI C,00h
  673  030A: 16 29            MVI D,RXFB          ; бит - в середину D0
  674  030C: CD F2 02         CALL PAUSE
  675  030F: 20       RXL:    RIM                 ; A7 = SID - центр очередного бита
  676  0310: E6 80            ANI 80h
  677  0312: 07               RLC                 ; SID (A7) -> CY. ФИКС v2.0.5: было RAR(1F),
  678                                        ; но RAR берёт CY<-A0=0 и бит SID терялся;
  679                                        ; C собирался как 00h при любой линии                 ; бит -> CY
  680  0313: 79               MOV A,C
  681  0314: 1F               RAR                 ; вставить сверху (LSB-first)
  682  0315: 4F               MOV C,A
  683  0316: 16 29            MVI D,RXFB
  684  0318: CD F2 02         CALL PAUSE
  685  031B: 05               DCR B
  686  031C: C2 0F 03         JNZ RXL
  687                    ; после последней итерации RXL (выборка d7 + бит задержки)
  688                    ; линия = середина стоп-бита
  689  031F: 20               RIM
  690  0320: E6 80            ANI 80h             ; CY = 0 (ANI сбрасывает перенос)
  691  0322: CA 2B 03         JZ RXBAD            ; стоп-бит = 0 - обрыв кадра
  692            
  693  0325: 79               MOV A,C
  694  0326: E6 7F            ANI 7Fh             ; приводим принятый байт к чистому 7-битному ASCII (D7 = 0)
  695  0328: 4F               MOV C,A
  696            
  697  0329: B7               ORA A               ; CY = 0
  698  032A: C9               RET                 ; C = байт, CY = 0
