  726            ; =====================================================================
  727            ; LOADM: Intel HEX загрузчик (клавиша B). Приём SID 4800 8N1.
  728            ; Вход через KLD с TMOFF (7.5 замаскирован, DI) - как v27 по логике
  729            ; парсера. Формат записи: :nnaaaatt[dd...]cc, cc = (-сумма байт) mod 256.
  730            ; Статический дисплей LLLL; адрес каждой записи живёт в ADDRH/L.
  731            ; Запись только в ОЗУ (A15=1): попадание в ROM-окно = ошибка EEEE.
  732            ; Выход: EOF-запись (type 01) -> тик и меню; ошибка -> EEEE + сигнал.
  733            ; Выход из зависшего приёма - RESET (SW20).
  734            ; NOTE: LACC/LNIB/LBPC/LSUM/LTY = клетки FFFB-FFFF; в обычном режиме
  735            ; FFFC-FFFF заняты KRAW (ISR) - в B маски стоят (TMOFF), конфликта нет;
  736            ; TMON на выходе чистит KRAW. XSSEQ/LST = FFFA: на входе LST=0 (=SEQ 0 -
  737            ; клиент логирует рестарт потока), на выходе TMON -> новое SEQ с 0.
  738            ; ---------------------------------------------------------------------
  739  0382: AF       LOADM:  XRA A
  740  0383: 32 FA FF         STA LST             ; ждем ':' (и XSSEQ = 0 - рестарт потока клиента)
  741  0386: 32 FD FF         STA LACC            ; накопитель тетрад тоже с нуля (баг v1.0:
  742                                        ;  сталь ломала первый байт первой записи)
  743  0389: 3E 38            MVI A,38h           ; 'L'
  744  038B: CD 4B 03         CALL LSTAT
  745  038E: CD F7 02 LDLP:   CALL RXD            ; C = байт, CY = ошибка кадра
  746  0391: DA BF 04         JC LDERR
  747  0394: 79               MOV A,C
  748  0395: FE 3A            CPI ':'
  749  0397: CA AA 04         JZ LDNEW            ; начало записи
  750  039A: CD 29 03         CALL NIB            ; тетрада?
  751  039D: D2 8E 03         JNC LDLP            ; прочее (\r\n и т.п.) - пропустить
  752  03A0: 5F               MOV E,A             ; E = тетрада (7.5 замаскирован - E свободен)
  753  03A1: 3A FD FF         LDA LACC
  754  03A4: 07               RLC
  755  03A5: 07               RLC
  756  03A6: 07               RLC
  757  03A7: 07               RLC                 ; накопитель << 4
  758  03A8: B3               ORA E
  759  03A9: 32 FD FF         STA LACC
  760  03AC: 3A FB FF         LDA LNIB
  761  03AF: 3D               DCR A
  762  03B0: 32 FB FF         STA LNIB
  763  03B3: C2 8E 03         JNZ LDLP            ; байт поля ещё не собран
  764                    ; --- байт поля собран - применить по состоянию ---
  765  03B6: 3A FD FF         LDA LACC
  766  03B9: 47               MOV B,A             ; B = байт
  767  03BA: AF               XRA A
  768  03BB: 32 FD FF         STA LACC            ; накопитель очищен к следующему байту
  769  03BE: 3A FA FF         LDA LST
  770  03C1: B7               ORA A
  771  03C2: CA 8E 03         JZ LDLP             ; байт вне записи - игнор
  772  03C5: 3D               DCR A
  773  03C6: CA D8 03         JZ LDCNT            ; 1 = count
  774  03C9: 3D               DCR A
  775  03CA: CA ED 03         JZ LDADR            ; 2 = addr
  776  03CD: 3D               DCR A
  777  03CE: CA 25 04         JZ LDTYP            ; 3 = type
  778  03D1: 3D               DCR A
  779  03D2: CA 58 04         JZ LDDAT            ; 4 = data
  780  03D5: C3 94 04         JMP LDCHK           ; 5 = checksum
  781  03D8: 78       LDCNT:  MOV A,B
  782  03D9: 32 EC FF         STA ADCNT           ; сколько байт данных в записи
  783  03DC: CD 63 03         CALL LDSUM
  784  03DF: 3E 02            MVI A,02h           ; поле addr: 4 тетрады = 2 байта
  785  03E1: 32 FA FF         STA LST
  786  03E4: 32 FC FF         STA LBPC
  787  03E7: 32 FB FF         STA LNIB
  788  03EA: C3 8E 03         JMP LDLP
  789  03ED: 78       LDADR:  MOV A,B
  790  03EE: 32 FF FF         STA LTY             ; временно: тип ещё не читался
  791  03F1: 3A FC FF         LDA LBPC
  792  03F4: FE 02            CPI 02h
  793  03F6: C2 0A 04         JNZ LDAD1
  794  03F9: 3A FF FF         LDA LTY
  795  03FC: 32 EA FF         STA ADDRH           ; старший байт адреса (big-endian)
  796  03FF: 3E 01            MVI A,01h
  797  0401: 32 FC FF         STA LBPC
  798  0404: CD 63 03         CALL LDSUM
  799  0407: C3 8E 03         JMP LDLP
  800  040A: 3A FF FF LDAD1:  LDA LTY
  801  040D: 32 EB FF         STA ADDRL           ; младший байт адреса
  802  0410: CD 63 03         CALL LDSUM
  803  0413: 3E 03            MVI A,03h
  804  0415: 32 FA FF         STA LST             ; type
  805  0418: 3E 01            MVI A,01h
  806  041A: 32 FC FF         STA LBPC
  807  041D: 3E 02            MVI A,02h
  808  041F: 32 FB FF         STA LNIB
  809  0422: C3 8E 03         JMP LDLP
  810  0425: 78       LDTYP:  MOV A,B
  811  0426: 32 FF FF         STA LTY
  812  0429: CD 63 03         CALL LDSUM
  813  042C: 3A FF FF         LDA LTY
  814  042F: FE 01            CPI 01h
  815  0431: CA 47 04         JZ LDTYP1
  816  0434: 3A EC FF         LDA ADCNT           ; type 00: данные
  817  0437: 32 FC FF         STA LBPC
  818  043A: 3E 04            MVI A,04h
  819  043C: 32 FA FF         STA LST
  820  043F: 3E 02            MVI A,02h
  821  0441: 32 FB FF         STA LNIB
  822  0444: C3 8E 03         JMP LDLP
  823  0447: AF       LDTYP1: XRA A               ; type 01 (EOF): данных нет
  824  0448: 32 FC FF         STA LBPC
  825  044B: 3E 05            MVI A,05h
  826  044D: 32 FA FF         STA LST
  827  0450: 3E 02            MVI A,02h
  828  0452: 32 FB FF         STA LNIB
  829  0455: C3 8E 03         JMP LDLP
  830  0458: 3A EA FF LDDAT:  LDA ADDRH
  831  045B: E6 80            ANI 80h             ; запись разрешена только в ОЗУ
  832  045D: CA BF 04         JZ LDERR            ; ROM-окно - ошибка
  833  0460: 3A EA FF         LDA ADDRH
  834  0463: 67               MOV H,A
  835  0464: 3A EB FF         LDA ADDRL
  836  0467: 6F               MOV L,A
  837  0468: 70               MOV M,B             ; [ADDR] = байт (writeback CPLD)
  838  0469: 23               INX H
  839  046A: 7C               MOV A,H
  840  046B: 32 EA FF         STA ADDRH
  841  046E: 7D               MOV A,L
  842  046F: 32 EB FF         STA ADDRL
  843  0472: CD 63 03         CALL LDSUM
  844  0475: 3A FC FF         LDA LBPC
  845  0478: 3D               DCR A
  846  0479: 32 FC FF         STA LBPC
  847  047C: C2 8C 04         JNZ LDDAT2
  848  047F: 3E 05            MVI A,05h           ; данные кончились - ждать checksum
  849  0481: 32 FA FF         STA LST
  850  0484: 3E 02            MVI A,02h
  851  0486: 32 FB FF         STA LNIB
  852  0489: C3 8E 03         JMP LDLP
  853  048C: 3E 02    LDDAT2: MVI A,02h
  854  048E: 32 FB FF         STA LNIB
  855  0491: C3 8E 03         JMP LDLP
  856  0494: 3A FE FF LDCHK:  LDA LSUM            ; контрольная сумма записи
  857  0497: 80               ADD B               ; сумма всех байт + cc = 0 mod 256?
  858  0498: C2 BF 04         JNZ LDERR
  859  049B: 3A FF FF         LDA LTY
  860  049E: FE 01            CPI 01h
  861  04A0: CA BB 04         JZ LDDONE           ; EOF - конец загрузки
  862  04A3: AF               XRA A
  863  04A4: 32 FA FF         STA LST             ; ждем ':' следующей записи
  864  04A7: C3 8E 03         JMP LDLP
  865  04AA: 3E 01    LDNEW:  MVI A,01h           ; ':' - новая запись
  866  04AC: 32 FA FF         STA LST
  867  04AF: 3E 02            MVI A,02h
  868  04B1: 32 FB FF         STA LNIB
  869  04B4: AF               XRA A
  870  04B5: 32 FE FF         STA LSUM
  871  04B8: C3 8E 03         JMP LDLP
  872  04BB: CD A0 01 LDDONE: CALL TICKON         ; подтверждение успешной загрузки
  873  04BE: C9               RET
  874  04BF: 3E 79    LDERR:  MVI A,79h           ; 'E' -> дисплей EEEE
  875  04C1: CD 4B 03         CALL LSTAT
  876  04C4: CD 6D 03         CALL LDBEEP         ; длинный сигнал
  877  04C7: C9               RET                 ; в меню (ADDRH/L = адрес сбоя, D = просмотр)
  878            
  879            ; =====================================================================
  880            ; RAMT: RAM-тест 8000h-FFD7h (клавиша F). 4 паттерна 00/FF/55/AA:
  881            ; заполнение + контроль побайтно. Статический дисплей (DIG0) = глиф
  882            ; паттерна ("0000"/"FFFF"/"5555"/"AAAA"). Сбой: ADDRH/L = адрес сбоя,
  883            ; EEEE + длинный сигнал. Успех: короткий тик. Вход через KRAM с TMOFF:
  884            ; 7.5 замаскирован - ISR не толкает стек в диапазон теста.
  885            ; ГРАНИЦА: FFD8h-FFE7h НЕ тестируется (фикс v2.0.2/tw): там живёт стек
  886            ; монитора - собственный адрес возврата RAMT лежит в FFE7h/FFE6h, и
  887            ; заполнение до FFE7h затирало его -> после теста RET в мусор. Стек до
  888            ; FFD4h не доходит (RAMT без длинных push). Портит всё, кроме клеток.
  889            ; ФИКС v2.0.2 (tw): паттерн восстанавливается из E на каждом шаге
  890            ; (MOV A,E): в v1.2-v2.0.1 MOV A,H после INX H затирал паттерн в A и
  891            ; с 8001h писались МЛАДШИЕ БАЙТЫ АДРЕСА -> вечная "ошибка ОЗУ".
  892            ; ---------------------------------------------------------------------
  893  04C8: 21 76 00 RAMT:   LXI H,RAMPAT        ; HL = текущая пара (value+glyph)
  894  04CB: 0E 04            MVI C,04h           ; 4 паттерна
  895  04CD: 7E       RMT0:   MOV A,M             ; A = значение паттерна
  896  04CE: 5F               MOV E,A
  897  04CF: E5               PUSH H              ; указатель пары - на стек (HL уйдёт под заполнение)
  898  04D0: 23               INX H
  899  04D1: 7E               MOV A,M             ; глиф паттерна
  900  04D2: CD 4B 03         CALL LSTAT          ; статический дисплей ("0000" и т.д.)
  901  04D5: 7B               MOV A,E
  902  04D6: 21 00 80         LXI H,8000h
  903  04D9: 7B       RMF:    MOV A,E             ; паттерн из E на КАЖДОМ шаге (фикс v2.0.2)
  904  04DA: 77               MOV M,A             ; заполнение
  905  04DB: 23               INX H
  906  04DC: 7C               MOV A,H
  907  04DD: FE FD            CPI 0FDh
  908  04DF: C2 D9 04         JNZ RMF
  909  04E2: 7D               MOV A,L
  910  04E3: FE D8            CPI 0D8h
  911  04E5: C2 D9 04         JNZ RMF
  912  04E8: 21 00 80         LXI H,8000h
  913  04EB: 7E       RMV:    MOV A,M             ; контроль (8000h..FFD7h)
  914  04EC: BB               CMP E
  915  04ED: C2 08 05         JNZ RMBAD
  916  04F0: 23               INX H
  917  04F1: 7C               MOV A,H
  918  04F2: FE FD            CPI 0FDh
  919  04F4: C2 EB 04         JNZ RMV
  920  04F7: 7D               MOV A,L
  921  04F8: FE D8            CPI 0D8h
  922  04FA: C2 EB 04         JNZ RMV
  923  04FD: E1               POP H               ; HL = пара паттерна
  924  04FE: 23               INX H
  925  04FF: 23               INX H               ; следующая пара
  926  0500: 0D               DCR C
  927  0501: C2 CD 04         JNZ RMT0
  928  0504: CD A0 01         CALL TICKON         ; ОК
  929  0507: C9               RET
  930  0508: 22 EB FF RMBAD:  SHLD ADDRL          ; ADDRH/L = адрес сбоя (HL из RMV, до POP!)
  931  050B: E1               POP H               ; снять указатель пары (баланс стека)
  932  050C: 3E 79            MVI A,79h           ; 'E' -> EEEE
  933  050E: CD 4B 03         CALL LSTAT
  934  0511: CD 6D 03         CALL LDBEEP
  935  0514: C9               RET                 ; в меню; D = просмотр байта по адресу сбоя
