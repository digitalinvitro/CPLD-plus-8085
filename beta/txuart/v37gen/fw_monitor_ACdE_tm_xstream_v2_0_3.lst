  572            ; =====================================================================
  573            ; UART-канал: передача OUT 04h @1M (TXRDY = IN 03h бит 7, v1.2 Шаг-2),
  574            ; приём RIM/SID @4800 - как v27
  575            ; =====================================================================
  576            
  577            ; ---------------------------------------------------------------------
  578            ; TXBYTE: A = байт -> сериализатор CPLD (1 000 000 8N1). Ожидает TXRDY
  579            ; (запись при busy аппаратно отбрасывается). Используется баннером/строками.
  580            ; ---------------------------------------------------------------------
  581  02DC: F5       TXBYTE: PUSH PSW
  582  02DD: DB 03    TXB1:   IN KBROWP           ; TXRDY = бит 7
  583  02DF: E6 80            ANI 80h             ; tx_idle = ~|bit_cnt: 1 = готов принять байт
  584  02E1: CA DD 02         JZ TXB1
  585  02E4: F1               POP PSW
  586  02E5: D3 04            OUT TXP
  587  02E7: C9               RET
  588            
  589            ; ---------------------------------------------------------------------
  590            ; TXSTR: HL = строка с нулевым завершителем -> TX. Портит A/HL.
  591            ; ---------------------------------------------------------------------
  592  02E8: 7E       TXSTR:  MOV A,M
  593  02E9: B7               ORA A
  594  02EA: C8               RZ
  595  02EB: CD DC 02         CALL TXBYTE
  596  02EE: 23               INX H
  597  02EF: C3 E8 02         JMP TXSTR
  598            
  599            ; ---------------------------------------------------------------------
  600            ; PAUSE: пауза D итераций по 4,5 мкс (DCR+JNZ = 14T @3,125 МГц;
  601            ; в v1.2 считали 15T @400 нс - значение пересчитано, см. EQU).
  602            ; ---------------------------------------------------------------------
  603  02F2: 15       PAUSE:  DCR D
  604  02F3: C2 F2 02         JNZ PAUSE
  605  02F6: C9               RET
  606            
  607            ; ---------------------------------------------------------------------
  608            ; RXD: приём байта SID 4800 8N1 (фрагмент 7 + стоп-бит). Выход:
  609            ; C = байт, CY = 0 ОК / CY = 1 обрыв кадра (стоп-бит = 0). Портит A/B/C/D.
  610            ; Цикл строгий - в режиме B таймер ЗАМАСКИРОВАН (TMOFF: DI + SIM 78h)
  611            ; и пульки TMIARM запрещены - джиттера нет вообще.
  612            ; Константы v2.0: RXHB=19 (полбита ~103 мкс), RXFB=41 (бит ~208 мкс,
  613            ; расчёт в блоке EQU). v1.2: RXHB=15/RXFB=30 @2,5 МГц.
  614            ; ---------------------------------------------------------------------
  615  02F7: 06 08    RXD:    MVI B,08h
  616  02F9: 20       RXW:    RIM                 ; A7 = SID
  617  02FA: B7               ORA A
  618  02FB: FA F9 02         JM RXW              ; '1' (покой) - ждать старт-бит
  619  02FE: 16 13            MVI D,RXHB          ; полбита - в середину старт-бита
  620  0300: CD F2 02         CALL PAUSE
  621  0303: 20               RIM                 ; подтвердить старт-бит
  622  0304: B7               ORA A
  623  0305: FA F9 02         JM RXW              ; '1' - ложный старт, ждать заново
  624  0308: 0E 00            MVI C,00h
  625  030A: 16 29            MVI D,RXFB          ; бит - в середину D0
  626  030C: CD F2 02         CALL PAUSE
  627  030F: 20       RXL:    RIM                 ; A7 = SID - центр очередного бита
  628  0310: E6 80            ANI 80h
  629  0312: 1F               RAR                 ; бит -> CY
  630  0313: 79               MOV A,C
  631  0314: 1F               RAR                 ; вставить сверху (LSB-first)
  632  0315: 4F               MOV C,A
  633  0316: 16 29            MVI D,RXFB
  634  0318: CD F2 02         CALL PAUSE
  635  031B: 05               DCR B
  636  031C: C2 0F 03         JNZ RXL
  637                    ; после последней итерации RXL (выборка d7 + бит задержки)
  638                    ; линия = середина стоп-бита
  639  031F: 20               RIM
  640  0320: E6 80            ANI 80h             ; CY = 0 (ANI сбрасывает перенос)
  641  0322: CA 27 03         JZ RXBAD            ; стоп-бит = 0 - обрыв кадра
  642  0325: B7               ORA A               ; CY = 0
  643  0326: C9               RET                 ; C = байт, CY = 0
  644  0327: 37       RXBAD:  STC
  645  0328: C9               RET                 ; CY = 1
  646            
  647            ; ---------------------------------------------------------------------
  648            ; NIB: A = ASCII-символ -> CY = 1 и A = тетрада 0-F ('0'-'9','A'-'F',
  649            ; 'a'-'f'), иначе CY = 0. Портит A.
  650            ; ---------------------------------------------------------------------
  651  0329: D6 30    NIB:    SUI 30h             ; '0'..'9' -> 0..9
  652  032B: DA 49 03         JC NIBX             ; < '0'
  653  032E: FE 0A            CPI 0Ah
  654  0330: DA 47 03         JC NIBOK            ; цифра 0..9
  655  0333: D6 07            SUI 07h             ; 'A'..'F' -> 10..15
  656  0335: FE 10            CPI 10h
  657  0337: D2 3D 03         JNC NIB2            ; > 'F' - попробовать строчные a..f
  658  033A: C3 47 03         JMP NIBOK
  659  033D: D6 20    NIB2:   SUI 20h             ; ('a'-'0')-07h-20h = 10..15
  660  033F: FE 10            CPI 10h
  661  0341: D2 49 03         JNC NIBX
  662  0344: C3 47 03         JMP NIBOK
  663  0347: 37       NIBOK:  STC
  664  0348: C9               RET
  665  0349: B7       NIBX:   ORA A               ; CY = 0
  666  034A: C9               RET
  667            
  668            ; ---------------------------------------------------------------------
  669            ; LSTAT: A = глиф -> статический дисплей на РАЗРЯДЕ DIG0 (слот-система
  670            ; стоит). Для режимов загрузчика/RAM-теста, где ISR замаскирован (TMOFF).
  671            ; РЕШЕНИЕ ВЛАДЕЛЬЦА (11-22): один разряд вместо четырёх = минимальный
  672            ; ток дисплея во время теста ОЗУ/загрузки -> меньше просадка шины 5 В,
  673            ; чище тест ОЗУ. (В v1.2-v2.0.1 горели все 4 разряда - MVI A,0Fh.)
  674            ; ---------------------------------------------------------------------
  675  034B: C5       LSTAT:  PUSH B
  676  034C: 47               MOV B,A
  677  034D: AF               XRA A
  678  034E: D3 00            OUT SEGP            ; гашение на время переключения
  679  0350: 3E 01            MVI A,01h           ; только DIG0 - токи, см. шапку блока
  680  0352: D3 01            OUT DIGP            ; разряд активен, SND = 0
  681  0354: 78               MOV A,B
  682  0355: D3 00            OUT SEGP            ; глиф на активный разряд
  683  0357: C1               POP B
  684  0358: C9               RET
  685            
  686            ; ---------------------------------------------------------------------
  687            ; DLMS: пауза ~1,02 мс (K_MS=130 итераций 24T @320 нс = 1,002 мс).
  688            ; Портит A/B/C. H/L целы. ВНИМАНИЕ (п.3): внутри DLMS пульки TMIARM
  689            ; нет - на время паузы слоты стоят (один разряд горит ~1 мс, яркость
  690            ; не страдает - скважность 1/4 как всегда; каденция возвращается на
  691            ; следующем TMIARM-вызове).
  692            ; ---------------------------------------------------------------------
  693  0359: 01 82 00 DLMS:   LXI B,K_MS
  694  035C: 0B       DLS1:   DCX B
  695  035D: 78               MOV A,B
  696  035E: B1               ORA C
  697  035F: C2 5C 03         JNZ DLS1
  698  0362: C9               RET
  699            
  700            ; ---------------------------------------------------------------------
  701            ; LDSUM: LSUM += B (mod 256). Портит A.
  702            ; ---------------------------------------------------------------------
  703  0363: F5       LDSUM:  PUSH PSW
  704  0364: 3A FE FF         LDA LSUM
  705  0367: 80               ADD B
  706  0368: 32 FE FF         STA LSUM
  707  036B: F1               POP PSW
  708  036C: C9               RET
  709            
  710            ; ---------------------------------------------------------------------
  711            ; LDBEEP: длинный сигнал ~0,3 с (тоггл D4 DIGP вручную: в B/F 7.5
  712            ; замаскирован (TMOFF) - ISR не пишет DIGP, конфликта нет; CALL
  713            ; TMIARM здесь не нужен (заглушка). Портит A/B/C/D.
  714            ; ---------------------------------------------------------------------
  715  036D: 16 96    LDBEEP: MVI D,150
  716  036F: 3E 1F    LDB1:   MVI A,1Fh           ; SND = 1, разряды on
  717  0371: D3 01            OUT DIGP
  718  0373: CD 59 03         CALL DLMS
  719  0376: 3E 0F            MVI A,0Fh           ; SND = 0
  720  0378: D3 01            OUT DIGP
  721  037A: CD 59 03         CALL DLMS
  722  037D: 15               DCR D
  723  037E: C2 6F 03         JNZ LDB1
  724  0381: C9               RET
