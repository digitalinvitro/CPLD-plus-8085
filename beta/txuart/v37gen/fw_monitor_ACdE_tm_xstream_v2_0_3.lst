    1            ; =====================================================================
    2            ; beta/txuart/v37gen -- fw_monitor_ACdE_tm_xstream v2.0.3: монитор для
    3            ; платы retro_pcld (CPLD top_txuart_por6_v37G01, XC95108). ПАРА ЖЁСТКО
    4            ; СВЯЗАНА: RTL v37G01 <-> fw v2.0.3. База линии - v37G01 (глобальный
    5            ; асинхронный сброс GSR, модуль RESET_CPU, джиффи-таймер); линия v37F
    6            ; ЗАКРЫТА (архив пары v37F-11 <-> v2.0.1 - в beta/txuart/rom).
    7            ;
    8            ; ЛИНИЯ ПРОШИВКИ:
    9            ;   v1.2    (пара RTL v2.9)   - N-таймер в RTL, ре-арм OUT 06h;
   10            ;   v2.0    (пара v37F-11)    - свободный тик 4 мкс, дисциплина TMIARM,
   11            ;                               делитель слотов E=6;
   12            ;   v2.0.1  (пара v37F-11)    - фикс SIM-масок (78h/68h несли чужую
   13            ;                               раскладку битов и снимали ВСЕ маски ->
   14            ;                               торнадо прерываний: ЦП 100% в ISR);
   15            ;   v2.0.2  (пара v37G01, tw) - адаптация к джиффи v37G01: TMIARM ->
   16            ;                               RET-заглушка, E=6 удалён, слот на каждый
   17            ;                               вызов ISR; + 2 фикса близнеца: KSCOL
   18            ;                               (индекс в младший байт BC) и RAMT
   19            ;                               (паттерн из E; граница FFD8h);
   20            ;   v2.0.3  (пара v37G01)     - ЭТА сборка: чистка (TMTINY мёртвый код,
   21            ;                               дубль LXI H,8000h), документация под
   22            ;                               v37G01 (джиффи 4,096 мс, порт 03h
   23            ;                               D6-D5 = tmr_cnt[9:8]), резолюция LSTAT
   24            ;                               (01h = токи, решение владельца 11-22),
   25            ;                               баннер v2.0.3.
   26            ;
   27            ;   1. ТАЙМЕР v37G01: RST 7.5 = СВОБОДНОЕ ДЖИФФИ 4,096 мс (счётчик
   28            ;      tmr_cnt[9:0] в CPLD шагом 4 мкс, импульс 1 клк при переполнении;
   29            ;      1024 x 4 мкс = 4,096 мс = 244,14 Гц). Остановить нельзя - только
   30            ;      замаскировать (DI/маски). OUT 06h: A[7:4] = колонки, A[3:0]
   31            ;      игнорируются. IN 03h: D6-D5 = tmr_cnt[9:8] - МЕДЛЕННАЯ фаза
   32            ;      (шаг 1,024 мс, полный цикл 4,096 мс).
   33            ;
   34            ;   2. ISR САМОДОСТАТОЧЕН (против дисциплины TMIARM v2.0/v2.0.1):
   35            ;      ответ на прерывание ~80T ~ 26 мкс >> 4 мкс тика v37F-11 - там
   36            ;      прямой сервис был невозможен (пульки/маски/E=6). На джиффи
   37            ;      4,096 мс бюджет 12 800 тактов CPU - ISR входит сам, каденция
   38            ;      РОВНАЯ, пульки не нужны. Маска 7.5 снята ПОСТОЯННО (TMON:
   39            ;      SIM 68h), ISR маски не трогает - защёлка перезаряжается сама
   40            ;      к следующему джиффи.
   41            ;
   42            ;   3. СЛОТ = каждый вызов ISR: скан 1 колонки (KSCOL) + регенерация
   43            ;      1 разряда (REFRESH). Каденция ФИКСИРОВАННАЯ: 1 джиффи = 4,096 мс.
   44            ;      Кадр дисплея (4 разряда) = 16,4 мс ~ 61 Гц; полный цикл скана
   45            ;      16,4 мс; ответ на клавишу <= 4,1 мс; ISR ~170 мкс = 4,2% ЦП.
   46            ;      Фаза тона ведётся TICKON'ом (см. п.5), от слотов не зависит.
   47            ;
   48            ;   4. CPU 3,125 МГц (T=320 нс, CLKOUT = X1/2). Константы K_MS 130
   49            ;      (~1,0 мс), RXHB 19, RXFB 41 (4800: бит = 75T фикс + 41x14T =
   50            ;      649T = 207,7 мкс; PAUSE-итерация 14T) - как в v2.0.
   51            ;
   52            ;   5. ЗВУК (фикс v1.2): D4 = бит фазы SNDST.0; фазу тогглит TICKON
   53            ;      раз в ~1 мс -> квадрат ~500 Гц, независимый от слотов.
   54            ;
   55            ;   6. ДИСЦИПЛИНА B/F/GO (проще v1.2 - OUT 06h не нужен):
   56            ;        TMOFF: DI + SIM 78h (маски 5.5/6.5/7.5 + СБРОС защёлки 7.5).
   57            ;        TMON : DI + SIM 78h + чистка KRAW/DPIDX/SNDST + SIM 68h
   58            ;               (маска 7.5 снята ПОСТОЯННО) + EI. Счётчика E нет.
   59            ;      GO (KGO): TMOFF - программа пользователя получает ~96% ЦП
   60            ;      (ISR ~170 мкс раз в 4,096 мс), дисплей/скан живут. Программе,
   61            ;      которой джиффи не нужен: DI или SIM 78h. Вектор 003Ch ведёт в
   62            ;      ROM-TMISR монитора.
   63            ;      B (LOADM): RXD чист от джиттера (маски + DI). F (RAMT): тест
   64            ;      8000h-FFD7h, стек FFD8h-FFE7h не трогается (см. блок RAMT).
   65            ;
   66            ;   7. ПОРТЫ v37G01 (совпадают с v37F-11): ЗАПИСЬ 00h = сегменты
   67            ;      A[6:0] (dp погашен навсегда), 01h = разряды A[3:0] + звук A[4],
   68            ;      04h = TXDATA (однократный строб; запись при busy - байт тихо
   69            ;      теряется), 06h = колонки A[7:4]. ЧТЕНИЕ 03h = {TXRDY(D7),
   70            ;      tmr_cnt[9:8] (D6-D5, шаг 1,024 мс), row4..row0 (D4-D0)}.
   71            ;      02h/05h/07h НЕМАПЛЕНЫ; чтение немапленных = bus_reg (последние
   72            ;      шинные данные; в v37G01 захват bus_reg во время RDn - фикс RTL).
   73            ;
   74            ;   8. XSTREAM (выдача экрана B000h): пейсинг 36,75T/Б сохранён
   75            ;      (11,8 мкс >= 10 мкс байта 1M), CALL TMIARM (заглушка RET) в
   76            ;      шапке каждой 8-Б подгруппы; слот приходит сам раз в 4,096 мс -
   77            ;      ISR-вставка ~170 мкс удлиняет текущий гэп (мин. 25T соблюдён) -
   78            ;      ноль отбросов TX, регенерация/скан идут ВНУТРИ посылки.
   79            ;      Кадр ~37 мс (~27 FPS). Клиент xstream_view.ps1 (COM @1000000
   80            ;      8N1) - БЕЗ ИЗМЕНЕНИЙ: A5 5A [SEQ] + 2000 Б. SEQ в FFFAh.
   81            ;
   82            ; СБОРКА (asm85.py, кодировка CP1251):
   83            ;   python3 ../../../tools/asm85.py fw_monitor_ACdE_tm_xstream_v2_0_3.asm
   84            ;          -o fw_monitor_ACdE_tm_xstream_v2_0_3.hex
   85            ;          -l fw_monitor_ACdE_tm_xstream_v2_0_3.lst
   86            ; Прошивка: flash A29040B, offset 0000h (ROM-окно 0000h-7FFFh).
   87            ;
   88            ; КЛАВИАТУРА (как v27): тетрады 0-F + Enter + F1(меню) + F2(показ
   89            ; адреса); меню: A=адрес C=код D=просмотр E=выполнить B=загрузчик
   90            ; Intel HEX (SID 4800) F=RAM-тест. Выход из залипшего режима - RESET.
   91            ;
   92            ; ОЗУ: переменные FFE8h-FFFFh, стек с FFE7h вниз (SP0 = FFE8h); зона
   93            ; FFD8h-FFE7h RAM-тестом не покрывается (стек, фикс v2.0.2).
   94            ; ГЛУБИНА СТЕКА: максимум XSEND (4 push) + TMISR (PSW+B/D/H +
   95            ; RST-адрес + KSCOL/REFRESH/SETTLE) ~ 26 Б - в свободном ОЗУ.
   96            ; =====================================================================
   97            ; ---- порты CPLD v37G01 (декод по A2-A0, зеркала mod 8; как v37F-11) ----
   98            SEGP    EQU 00h             ; сегменты: D0=a..D6=g, D7=dp (погашен навсегда,
   99                                        ; A7 игнорируется); 1 = горит
  100            DIGP    EQU 01h             ; D3-D0 разряды (1 = горит), D4 = SND (прямой бит)
  101            KBCOLP  EQU 06h             ; OUT: A[7:4] = колонки (1 = заведена); A[3:0]
  102                                        ; ИГНОРИРУЮТСЯ - таймер НЕ пишется (п.1)
  103            KBROWP  EQU 03h             ; IN: D7 = TXRDY (1 = готов принять след. байт),
  104                                        ; D6-D5 = tmr_cnt[9:8] медленная фаза (шаг 1,024 мс),
  105                                        ; D4-D0 ряды (1 = нажата в активной колонке)
  106            TXP     EQU 04h             ; OUT: TXDATA -> сериализатор CPLD (1M 8N1)
  107            ; 02h/05h/07h НЕМАПЛЕНЫ; символы KBCOLP=02h/STP/TMRP/TMN из v1.2 удалены
  108            
  109            ; ---- константы тайминга (CPU 3,125 МГц, T = 320 нс; джиффи 4,096 мс) ----
  110            TQ_MS   EQU 15              ; дебаунс отпускания ~15 мс (DLMS-единиц)
  111            K_MS    EQU 130             ; DLMS-единица ~1,0 мс (130 x 24T x 320 нс)
  112            RXHB    EQU 19              ; полбита 4800 (PAUSE-итераций, ~103 мкс)
  113            RXFB    EQU 41              ; бит приёма 4800 (PAUSE-итераций, ~208 мкс)
  114            ; PAUSE-итерация = DCR D + JNZ = 14T; бит RX = 75T фикс + RXFB x 14T =
  115            ; 649T x 320 нс = 207,7 мкс (идеал 208,3; запас Uart +-10% покрывает)
  116            
  117            ; ---- коды клавиш ----
  118            K_ENT   EQU 10h             ; Enter  (row3/col3, SW16)
  119            K_F1    EQU 11h             ; F1     (row4/col1, SW18) - меню
  120            K_F2    EQU 12h             ; F2     (row4/col2, SW19) - показ адреса
  121            K_NONE  EQU 0FFh            ; пустая позиция матрицы
  122            
  123            ; ---- состояния ----
  124            ST_MENU EQU 00h             ; меню "ACDE" (B = загрузчик, F = RAM-тест)
  125            ST_ADDR EQU 01h             ; ввод адреса
  126            ST_PROG EQU 02h             ; ввод кода (Code)
  127            ST_VIEW EQU 03h             ; просмотр кода
  128            ST_SHOW EQU 04h             ; показ адреса операций (F2)
  129            
  130            ; ---- ОЗУ монитора ----
  131            SP0     EQU 0FFE8h          ; SP монитора
  132            SNDST   EQU 0FFE8h          ; бит0 = фаза тона (тогглит TICKON), бит1 = тон вкл
  133            STATE   EQU 0FFE9h          ; 0=меню, 1=адрес, 2=код, 3=просмотр, 4=показ
  134            ADDRH   EQU 0FFEAh          ; текущий адрес (старший); в загрузчике = адрес записи
  135            ADDRL   EQU 0FFEBh          ; текущий адрес (младший)
  136            ADCNT   EQU 0FFECh          ; тетрады адреса (0..4); в загрузчике = счётчик байт данных
  137            AF3     EQU 0FFEDh          ; тетрады адреса
  138            AF2     EQU 0FFEEh
  139            AF1     EQU 0FFEFh
  140            AF0     EQU 0FFF0h
  141            BDCNT   EQU 0FFF1h          ; введено тетрад байта (0..2)
  142            BF1     EQU 0FFF2h
  143            BF0     EQU 0FFF3h
  144            DPIDX   EQU 0FFF4h          ; фаза регенерации 0..3 = колонка скана (владеет ISR)
  145            DIGIMG  EQU 0FFF5h          ; глифы разрядов DIG0..DIG3
  146            DIGIMG0 EQU 0FFF5h
  147            DIGIMG1 EQU 0FFF6h
  148            DIGIMG2 EQU 0FFF7h
  149            DIGIMG3 EQU 0FFF8h
  150            PREVST  EQU 0FFF9h          ; прежний режим для F2
  151            ; --- парсер Intel HEX (загрузчик B); FFFC-FFFF = шара с KRAW (п.3 v1.2) ---
  152            LST     EQU 0FFFAh          ; состояние: 0=ждём ':' 1=count 2=addr 3=type 4=data 5=chk
  153                                        ;   (шара с XSSEQ - см. п.8; LOADM чистит на входе)
  154            LNIB    EQU 0FFFBh          ; осталось тетрад в текущем байте поля (1..2)
  155            LBPC    EQU 0FFFBh+1        ; осталось байт в текущем поле   = KRAW0
  156            LACC    EQU 0FFFBh+2        ; накопитель тетрад текущего байта = KRAW1
  157            LSUM    EQU 0FFFBh+3        ; сумма байт записи (mod 256)      = KRAW2
  158            LTY     EQU 0FFFBh+4        ; тип последней записи             = KRAW3
  159            ; --- сырой образ клавиатуры (пишет ISR, читает главный цикл) ---
  160            KRAW0   EQU 0FFFBh+1        ; ряды колонки 0 (биты 0-4) = LBPC
  161            KRAW1   EQU 0FFFBh+2        ; ряды колонки 1            = LACC
  162            KRAW2   EQU 0FFFBh+3        ; ряды колонки 2            = LSUM
  163            KRAW3   EQU 0FFFBh+4        ; ряды колонки 3            = LTY
  164            
  165            ; --- XSTREAM: экран -> UART (тик кадра = непрерывный поток, п.8) ---
  166            TXPORT  EQU TXP             ; TXDATA (04h) - синоним для xstream-кода
  167            XBUF    EQU 0B000h          ; ЭКРАН 80x25 = 2000 Б (B000h..B7CFh)
  168            XSSEQ   EQU 0FFFAh          ; SEQ кадра mod 256 (ячейка LST - см. п.8)
  169            XSCNT   EQU XBUF+06E4h      ; живой счётчик SEQ в демо-экране (строка 22, кол. 4-5)
  170            
  171            ; =====================================================================
  172  0000: -                ORG 0000h
  173  0000: C3 B5 07         JMP START
  174            
  175            ; ---- векторная зона: глушилки EI;RET -------------------------------
  176            ; RST 1..7, TRAP (0024h), RST 5.5/6.5. EI обязателен в каждой (снимает
  177            ; блокировку после приёма). На плате: TRAP = PGND (держатель '0'),
  178            ; 5.5/6.5 железно=0 и вдобавок замаскированы SIM - заглушки защитные.
  179            ; RST 7.5 (003Ch) = СВОБОДНЫЙ ТИК 4 мкс (п.1) - НЕ заглушка, обработчик
  180            ; ниже; под TMOFF маскируется, каденцию задаёт владелец точек TMIARM.
  181  0008: -                ORG 0008h           ; RST 1
  182  0008: FB               EI
  183  0009: C9               RET
  184  0010: -                ORG 0010h           ; RST 2
  185  0010: FB               EI
  186  0011: C9               RET
  187  0018: -                ORG 0018h           ; RST 3
  188  0018: FB               EI
  189  0019: C9               RET
  190  0020: -                ORG 0020h           ; RST 4
  191  0020: FB               EI
  192  0021: C9               RET
  193  0024: -                ORG 0024h           ; TRAP - защитная заглушка (пин PGND)
  194  0024: FB               EI
  195  0025: C9               RET
  196  0028: -                ORG 0028h           ; RST 5
  197  0028: FB               EI
  198  0029: C9               RET
  199  002C: -                ORG 002Ch           ; RST 5.5
  200  002C: FB               EI
  201  002D: C9               RET
  202  0030: -                ORG 0030h           ; RST 6
  203  0030: FB               EI
  204  0031: C9               RET
  205  0034: -                ORG 0034h           ; RST 6.5
  206  0034: FB               EI
  207  0035: C9               RET
  208  0038: -                ORG 0038h           ; RST 7
  209  0038: FB               EI
  210  0039: C9               RET
  211  003C: -                ORG 003Ch           ; RST 7.5 = свободное джиффи 4,096 мс (п.1, п.2)
  212  003C: C3 22 01         JMP TMISR
  213            
  214            ; =====================================================================
  215            ; Таблицы (ORG 0044h - векторная зона выше освобождена)
  216            ; =====================================================================
  217  0044: -                ORG 0044h
  218            ; ---- глифы '0'..'F' (a,b,c,d,e,f,g = D0..D6) ----
  219  0044: 3F       GTBL:   DB 3Fh              ; '0'
  220  0045: 06               DB 06h              ; '1'
  221  0046: 5B               DB 5Bh              ; '2'
  222  0047: 4F               DB 4Fh              ; '3'
  223  0048: 66               DB 66h              ; '4'
  224  0049: 6D               DB 6Dh              ; '5'
  225  004A: 7D               DB 7Dh              ; '6'
  226  004B: 07               DB 07h              ; '7'
  227  004C: 7F               DB 7Fh              ; '8'
  228  004D: 6F               DB 6Fh              ; '9'
  229  004E: 77               DB 77h              ; 'A'
  230  004F: 7C               DB 7Ch              ; 'b'
  231  0050: 39               DB 39h              ; 'C'
  232  0051: 5E               DB 5Eh              ; 'd'
  233  0052: 79               DB 79h              ; 'E'
  234  0053: 71               DB 71h              ; 'F'
  235            
  236            ; ---- биты разрядов/колонок (индекс = DPIDX: 0=DIG0 правый ... 3=DIG3 левый) ----
  237  0054: 01 02 04 08 BITTBL: DB 01h,02h,04h,08h
  238            
  239            ; ---- КАРТА КЛАВИШ: KEYTBL[row*4+col] ----
  240  0058: 0A 0B 0C 0D KEYTBL: DB 0Ah,0Bh,0Ch,0Dh  ; row0: A  B  C  D
  241  005C: 07 08 09 0E         DB 07h,08h,09h,0Eh  ; row1: 7  8  9  E
  242  0060: 04 05 06 0F         DB 04h,05h,06h,0Fh  ; row2: 4  5  6  F
  243  0064: 01 02 03 10         DB 01h,02h,03h,10h  ; row3: 1  2  3  Enter
  244  0068: 00 11 12 FF         DB 00h,11h,12h,0FFh ; row4: 0  F1 F2 (нет)
  245            
  246            ; ---- баннер TX @1M (на терминале 4800 = короткая мусорная строка) ----
  247  006C: 41 43 44 45 2D 54 4D 0D 0A 00 TXBAN:  DB 'ACDE-TM',0Dh,0Ah,00h
  248            
  249            ; ---- паттерны RAM-теста: значение + глиф для статического дисплея ----
  250  0076: 00 3F    RAMPAT: DB 00h,3Fh          ; 00h -> "0000"
  251  0078: FF 71            DB 0FFh,71h         ; FFh -> "FFFF"
  252  007A: 55 6D            DB 55h,6Dh          ; 55h -> "5555"
  253  007C: AA 77            DB 0AAh,77h         ; AAh -> "AAAA"
  254            
  255            ; =====================================================================
  256            ; СИСТЕМА ТАЙМЕРА v2.0: TMOFF/TMON/TMIARM + TMISR + слоты (п.2, п.3, п.6)
  257            ; =====================================================================
  258  0100: -                ORG 0100h
  259            
  260            ; ---------------------------------------------------------------------
  261            ; TMOFF: ТИШИНА слот-системы. DI + полные маски (SIM 78h = MSE+M7.5
  262            ; +M6.5+M5.5, заодно СБРОС защёлки RST 7.5). Фронты тика продолжают
  263            ; заряжать защёлку, но ЦП не трогают. Вызывается на входе B/F/GO.
  264            ; Портит A. (v1.2 OUT 06h,0 удалён - стопить нечего, п.1.)
  265            ; ---------------------------------------------------------------------
  266  0100: F3       TMOFF:  DI
  267  0101: 3E 78            MVI A,78h           ; MSE=1, M7.5=1 (маска+сброс защёлки), M6.5=1, M5.5=1
  268  0103: 30               SIM
  269  0104: C9               RET
  270            
  271            ; ---------------------------------------------------------------------
  272            ; TMON: ПУСК слот-системы (START, выход из B/F, MONRET). Чистит
  273            ; состояние ISR, заряжает E=6, снимает маску 7.5, EI. Первый слот
  274            ; придёт из ближайшей точки TMIARM (из START - вершина SCAN).
  275            ; ---------------------------------------------------------------------
  276  0105: F3       TMON:   DI
  277  0106: 3E 78            MVI  A, 78h     ; маски + сброс защёлки RST 7.5
  278  0108: 30               SIM
  279  0109: AF               XRA  A
  280  010A: 32 E8 FF         STA  SNDST      ; тон off, фаза 0
  281  010D: 32 F4 FF         STA  DPIDX      ; фаза регенерации / колонка 0
  282  0110: 32 FC FF         STA  KRAW0      ; сырой образ клавиатуры - в ноль
  283  0113: 32 FD FF         STA  KRAW1
  284  0116: 32 FE FF         STA  KRAW2
  285  0119: 32 FF FF         STA  KRAW3
  286  011C: 3E 68            MVI  A, 68h     ; MSE=1, M7.5=0 (7.5 РАЗРЕШЁН), M6.5=1, M5.5=1
  287  011E: 30               SIM
  288  011F: FB               EI
  289  0120: C9               RET
  290            
  291            ; ---------------------------------------------------------------------
  292            ; TMIARM: СОВМЕСТИМОСТЬ (п.2). На тике v37G01 ISR самодостаточен:
  293            ; маска 7.5 снята ПОСТОЯННО (TMON: SIM 68h), защёлка перезаряжается
  294            ; сама раз в 4,096 мс - пульки не нужны. Заглушка RET оставлена ради
  295            ; 7 мест CALL TMIARM (SCAN/XSL/KRL/KST/TKL/MNR1/MNR3): CALL/RET = 17T,
  296            ; безвредно. (В паре v37F-11 <-> v2.0.1 здесь была пулька MVI A,68h/
  297            ; SIM/NOP - дисциплина точек TMIARM; см. DEVLOG.) Ничего не портит.
  298            ; ---------------------------------------------------------------------
  299  0121: C9       TMIARM: RET             ; заглушка для старых вызовов CALL TMIARM
  300            
  301            ; ---------------------------------------------------------------------
  302            ; ---------------------------------------------------------------------
  303            ; TMISR: RST 7.5 = СВОБОДНОЕ ДЖИФФИ 4,096 мс (п.1). ВХОДИТ САМ: маска
  304            ; 7.5 снята в TMON и более не ставится - каждый вызов = ПОЛНЫЙ СЛОТ:
  305            ; скан 1 колонки (KSCOL) + регенерация 1 разряда (REFRESH). Счётчика
  306            ; E НЕТ (v2.0.2: удалён). Маски/защёлку не трогаем: выход -> защёлка
  307            ; перезарядится сама к следующему джиффи. Сохраняем PSW/B/D/H всегда
  308            ; (слот на каждом вызове). Такты (@3,125 МГц): ~530T ~ 170 мкс =
  309            ; 4,2% ЦП от джиффи 4,096 мс; кадр 4 разряда = 16,4 мс ~ 61 Гц.
  310            ; ---------------------------------------------------------------------
  311            ; ---------------------------------------------------------------------
  312  0122: F5       TMISR:  PUSH PSW
  313  0123: C5               PUSH B
  314  0124: D5               PUSH D
  315  0125: E5               PUSH H
  316  0126: CD 32 01         CALL KSCOL      ; скан 1 колонки (колонка = фаза DPIDX)
  317  0129: CD 60 01         CALL REFRESH    ; регенерация 1 разряда (фаза ++ внутри)
  318  012C: E1               POP  H
  319  012D: D1               POP  D
  320  012E: C1               POP  B
  321  012F: F1               POP  PSW
  322  0130: FB               EI
  323  0131: C9               RET
  324            
  325            ; ---------------------------------------------------------------------
  326            ; KSCOL: скан ОДНОЙ колонки (вызывается из слота). Колонка = текущая
  327            ; фаза регенерации DPIDX - отдельного счётчика нет. Сырой образ рядов
  328            ; (биты 0-4) -> KRAW0..KRAW3[колонка]. Портит A/B/C/D/H/L (в ISR - под
  329            ; PUSH B/D/H). Колонка на выходе погашена. Записей в 06h две
  330            ; (завести/погасить), A[3:0] = 0 - таймер не пишется.
  331            ; ФИКС v2.0.2 (tw): индекс - в МЛАДШИЙ байт BC (MOV C,A/MVI B,0):
  332            ; DAD B прибавляет пару BC. В v1.2-v2.0.1 индекс лежал в B
  333            ; (MOV B,A/MVI C,0) -> смещение индекс*256: работала ТОЛЬКО колонка 0
  334            ; (клавиши A,7,4,1,0), KRAW1-3 оставались нулями.
  335            ; ---------------------------------------------------------------------
  336  0132: 3A F4 FF KSCOL:  LDA DPIDX           ; колонка = фаза регенерации 0..3
  337  0135: E6 03            ANI 03h
  338  0137: 4F               MOV C,A             ; C = младший байт BC (индекс 0..3)
  339  0138: 06 00            MVI B,0
  340  013A: 21 54 00         LXI H,BITTBL
  341  013D: 09               DAD B               ; HL = BITTBL + колонка
  342  013E: 56               MOV D,M             ; D = бит колонки (01/02/04/08)
  343  013F: 21 FC FF         LXI H,KRAW0
  344  0142: 09               DAD B               ; HL = KRAW0 + колонка (B/C целы)
  345  0143: 7A               MOV A,D
  346  0144: 07               RLC                 ; бит колонки (01/02/04/08) -> старший ниббл
  347  0145: 07               RLC                 ; A[7:4] (RLC x4, переноса нет)
  348  0146: 07               RLC
  349  0147: 07               RLC
  350  0148: D3 06            OUT KBCOLP          ; колонка заведена (A[3:0]=0 - легально, п.1)
  351  014A: CD 56 01         CALL SETTLE
  352  014D: DB 03            IN KBROWP           ; ряды активной колонки (D6-D5 фаза тика и
  353  014F: E6 1F            ANI 1Fh             ; D7 TXRDY маскируются - как в v1.2 Шаг-2)
  354  0151: 77               MOV M,A             ; KRAW[колонка] = сырой образ рядов
  355  0152: AF               XRA A
  356  0153: D3 06            OUT KBCOLP          ; колонки off (0000); вторая запись легальна -
  357  0155: C9               RET                 ; колонки просто гасятся (в v1.2 тут был +N)
  358            
  359            ; =====================================================================
  360            ; Системные процедуры (перенос из v1.2/monitor27, константы 3,125 МГц)
  361            ; =====================================================================
  362            
  363            ; ---------------------------------------------------------------------
  364            ; SETTLE: пауза ~26 мкс (LXI+3 итерации 24T @320 нс; установка рядов
  365            ; после заведения колонки). Портит A/B/C. H/L НЕ ТРОГАЕТ (нужно KSCOL).
  366            ; ---------------------------------------------------------------------
  367  0156: 01 03 00 SETTLE: LXI B,3
  368  0159: 0B       STL:    DCX B
  369  015A: 78               MOV A,B
  370  015B: B1               ORA C
  371  015C: C2 59 01         JNZ STL
  372  015F: C9               RET
  373            
  374            ; ---------------------------------------------------------------------
  375            ; REFRESH: один слот регенерации (v27 БЕЗ ИЗМЕНЕНИЙ, кроме тона).
  376            ; ГАШЕНИЕ -> РАЗРЯД -> ГЛИФ. DIGIMG[DPIDX] на разряд DPIDX, фаза ++
  377            ; mod 4. v2.0 ФИКС тона (п.5): D4 = БИТ ФАЗЫ SNDST.0 (в v1.2 D4 горел
  378            ; константой на всё окно - квадрат не образовывался). D/E НЕ ТРОГАЕТ
  379            ; (в ISR критично: D = бит колонки уже погашен, E = счётчик слотов).
  380            ; Портит A/B/C/H/L.
  381            ; ---------------------------------------------------------------------
  382  0160: 3A F4 FF REFRESH: LDA DPIDX
  383  0163: 4F               MOV C,A             ; C = индекс 0..3
  384  0164: 06 00            MVI B,0
  385  0166: 21 54 00         LXI H,BITTBL
  386  0169: 09               DAD B
  387  016A: 46               MOV B,M             ; B = бит разряда (01,02,04,08)
  388  016B: 21 F5 FF         LXI H,DIGIMG        ; HL = DIGIMG + DPIDX (цикл вместо ADD)
  389  016E: 79       RFIL:   MOV A,C
  390  016F: B7               ORA A
  391  0170: CA 78 01         JZ RFGD
  392  0173: 2C               INR L
  393  0174: 0D               DCR C
  394  0175: C3 6E 01         JMP RFIL
  395  0178: 4E       RFGD:   MOV C,M             ; C = глиф разряда
  396  0179: 3A E8 FF         LDA SNDST
  397  017C: E6 02            ANI 02h
  398  017E: CA 8D 01         JZ RFN              ; тон не разрешён - D4 = 0
  399  0181: 3A E8 FF         LDA SNDST
  400  0184: E6 01            ANI 01h
  401  0186: CA 8D 01         JZ RFN              ; фаза 0 - D4 = 0 (полуволна низа)
  402  0189: 78               MOV A,B
  403  018A: F6 10            ORI 10h
  404  018C: 47               MOV B,A             ; фаза 1 -> D4 = 1 (полуволна верха)
  405  018D: AF       RFN:    XRA A
  406  018E: D3 00            OUT SEGP            ; (1) гашение: старый разряд погас
  407  0190: 78               MOV A,B
  408  0191: D3 01            OUT DIGP            ; (2) разряд переключён (сегменты пусты)
  409  0193: 79               MOV A,C
  410  0194: D3 00            OUT SEGP            ; (3) зажгли глиф нового разряда
  411  0196: 3A F4 FF         LDA DPIDX
  412  0199: 3C               INR A
  413  019A: E6 03            ANI 03h
  414  019C: 32 F4 FF         STA DPIDX
  415  019F: C9               RET
  416            
  417            ; ---------------------------------------------------------------------
  418            ; TICKON: короткий тик подтверждения клавиши ~15 мс (TQ_MS единиц
  419            ; DLMS). v2.0 (п.5): фазу тона SNDST.0 тогглит САМ TICKON раз в ~1 мс
  420            ; -> квадрат ~500 Гц, НЕ зависящий от каденции слотов (в v1.2 фазу
  421            ; тогглил слот ~0,7 мс, но REFRESH ставил D4 константой - тона не было).
  422            ; Пулька TMIARM в итерации: слоты идут - дисплей/скан не замирают.
  423            ; Портит A/B/C/H.
  424            ; ---------------------------------------------------------------------
  425  01A0: 3A E8 FF TICKON: LDA SNDST
  426  01A3: F6 02            ORI 02h             ; тон разрешён
  427  01A5: 32 E8 FF         STA SNDST
  428  01A8: 26 0F            MVI H,TQ_MS         ; 15 мс
  429  01AA: 3A E8 FF TKL:    LDA SNDST
  430  01AD: EE 01            XRI 01h             ; тоггл фазы (квадрат ~500 Гц)
  431  01AF: 32 E8 FF         STA SNDST
  432  01B2: CD 21 01         CALL TMIARM         ; слот на итерацию (дисплей жив под тоном)
  433  01B5: CD 59 03         CALL DLMS
  434  01B8: 25               DCR H
  435  01B9: C2 AA 01         JNZ TKL
  436  01BC: 3A E8 FF         LDA SNDST
  437  01BF: E6 FD            ANI 0FDh            ; тон off
  438  01C1: 32 E8 FF         STA SNDST
  439  01C4: C9               RET
  440            
  441            ; ---------------------------------------------------------------------
  442            ; GLOOK: A = тетрада 0..F -> A = глиф (GTBL). Портит A/B/C/H/L.
  443            ; ---------------------------------------------------------------------
  444  01C5: 4F       GLOOK:  MOV C,A
  445  01C6: 06 00            MVI B,0
  446  01C8: 21 44 00         LXI H,GTBL
  447  01CB: 09               DAD B
  448  01CC: 7E               MOV A,M
  449  01CD: C9               RET
  450            ; ---------------------------------------------------------------------
  451            ; REDRAW: пересобрать DIGIMG[0..3] по состоянию (как v5/v27).
  452            ;   меню : "ACdE"; адрес: тетрады вдвигаются справа; код "__C3";
  453            ;   просмотр: [ADDR] в правых разрядах; показ(F2): ADDR на 4 разрядах.
  454            ; Портит A/B/C/D/H/L (D - рабочий в RDW/RDV; ISR сохраняет D - безопасно).
  455            ; ---------------------------------------------------------------------
  456  01CE: 3A E9 FF REDRAW: LDA STATE
  457  01D1: B7               ORA A
  458  01D2: CA 73 02         JZ RDM
  459  01D5: FE 01            CPI 01h
  460  01D7: CA 8A 02         JZ RDA
  461  01DA: FE 03            CPI 03h
  462  01DC: CA 15 02         JZ RDV
  463  01DF: FE 04            CPI 04h
  464  01E1: CA 3E 02         JZ RDW
  465                    ; ---- ST_PROG ----
  466  01E4: AF               XRA A
  467  01E5: 32 F8 FF         STA DIGIMG3
  468  01E8: 32 F7 FF         STA DIGIMG2
  469  01EB: 32 F6 FF         STA DIGIMG1
  470  01EE: 32 F5 FF         STA DIGIMG0
  471  01F1: 3A F1 FF         LDA BDCNT
  472  01F4: FE 02            CPI 02h
  473  01F6: DA 02 02         JC RDPR0            ; <2 - старшая тетрада пуста
  474  01F9: 3A F2 FF         LDA BF1
  475  01FC: CD C5 01         CALL GLOOK
  476  01FF: 32 F6 FF         STA DIGIMG1
  477  0202: 3A F1 FF RDPR0:  LDA BDCNT
  478  0205: B7               ORA A
  479  0206: CA DB 02         JZ RDRE             ; 0 - младшая тоже пуста
  480  0209: 3A F3 FF         LDA BF0
  481  020C: CD C5 01         CALL GLOOK
  482  020F: 32 F5 FF         STA DIGIMG0
  483  0212: C3 DB 02         JMP RDRE
  484  0215: 3A EA FF RDV:    LDA ADDRH           ; ---- ST_VIEW: [ADDR] в правых разрядах ----
  485  0218: 67               MOV H,A
  486  0219: 3A EB FF         LDA ADDRL
  487  021C: 6F               MOV L,A             ; HL = ADDR
  488  021D: 7E               MOV A,M             ; A = [ADDR] (HL>=8000h - ОЗУ)
  489  021E: 57               MOV D,A             ; D = байт (GLOOK портит B)
  490  021F: 0F               RRC
  491  0220: 0F               RRC
  492  0221: 0F               RRC
  493  0222: 0F               RRC
  494  0223: E6 0F            ANI 0Fh             ; старшая тетрада
  495  0225: CD C5 01         CALL GLOOK
  496  0228: 32 F6 FF         STA DIGIMG1
  497  022B: 7A               MOV A,D
  498  022C: E6 0F            ANI 0Fh             ; младшая тетрада
  499  022E: CD C5 01         CALL GLOOK
  500  0231: 32 F5 FF         STA DIGIMG0
  501  0234: AF               XRA A
  502  0235: 32 F8 FF         STA DIGIMG3
  503  0238: 32 F7 FF         STA DIGIMG2
  504  023B: C3 DB 02         JMP RDRE
  505  023E: 3A EA FF RDW:    LDA ADDRH           ; ---- ST_SHOW: ADDR на 4 разрядах ----
  506  0241: 57               MOV D,A             ; D = старший байт (GLOOK портит B)
  507  0242: 0F               RRC
  508  0243: 0F               RRC
  509  0244: 0F               RRC
  510  0245: 0F               RRC
  511  0246: E6 0F            ANI 0Fh
  512  0248: CD C5 01         CALL GLOOK
  513  024B: 32 F8 FF         STA DIGIMG3
  514  024E: 7A               MOV A,D
  515  024F: E6 0F            ANI 0Fh
  516  0251: CD C5 01         CALL GLOOK
  517  0254: 32 F7 FF         STA DIGIMG2
  518  0257: 3A EB FF         LDA ADDRL
  519  025A: 57               MOV D,A
  520  025B: 0F               RRC
  521  025C: 0F               RRC
  522  025D: 0F               RRC
  523  025E: 0F               RRC
  524  025F: E6 0F            ANI 0Fh
  525  0261: CD C5 01         CALL GLOOK
  526  0264: 32 F6 FF         STA DIGIMG1
  527  0267: 7A               MOV A,D
  528  0268: E6 0F            ANI 0Fh
  529  026A: CD C5 01         CALL GLOOK
  530  026D: 32 F5 FF         STA DIGIMG0
  531  0270: C3 DB 02         JMP RDRE
  532  0273: 3E 77    RDM:    MVI A,77h           ; 'A'
  533  0275: 32 F8 FF         STA DIGIMG3
