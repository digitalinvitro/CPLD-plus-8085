  937            ; =====================================================================
  938            ;                    XSTREAM: ЭКРАН -> UART (п.8: непрерывный поток,
  939            ;                    тик кадра = сама скорость канала, регенерация/
  940            ;                    скан ведётся пульками TMIARM внутри посылки)
  941            ; =====================================================================
  942            ; ---------------------------------------------------------------------
  943            ; XSINIT (из START, только холодный старт): демо-экран в B000h,
  944            ; SEQ = 0. Мониторные переменные не трогаются; B000-B7CF -
  945            ; пользовательская область: ЛЮБАЯ программа может рисовать туда
  946            ; свой текст/графику, клиент xstream_view.ps1 покажет окном.
  947            ; ---------------------------------------------------------------------
  948  0515: CD 37 05 XSINIT: CALL XBLANK
  949  0518: 21 99 07         LXI H,XTBL
  950  051B: 5E       XSI1:   MOV E,M             ; DE = адрес назначения
  951  051C: 23               INX H
  952  051D: 56               MOV D,M
  953  051E: 23               INX H               ; HL -> src_lo
  954  051F: 7A               MOV A,D             ; конец таблицы (dst == 0000)?
  955  0520: B3               ORA E
  956  0521: CA 32 05         JZ XSI3
  957  0524: 4E               MOV C,M             ; BC = адрес строки (источник)
  958  0525: 23               INX H
  959  0526: 46               MOV B,M
  960  0527: 23               INX H               ; HL -> следующая запись
  961  0528: E5               PUSH H              ; указатель следующей записи -> стек
  962  0529: 60               MOV H,B
  963  052A: 69               MOV L,C
  964  052B: CD 48 05         CALL XCPY           ; ASCIZ [HL] -> [DE], 0 = конец
  965  052E: E1               POP H
  966  052F: C3 1B 05         JMP XSI1
  967  0532: AF       XSI3:   XRA A
  968  0533: 32 FA FF         STA XSSEQ
  969  0536: C9               RET
  970            
  971  0537: 21 00 B0 XBLANK: LXI H,XBUF          ; 2000 пробелов
  972  053A: 01 D0 07         LXI B,2000
  973  053D: 3E 20    XB1:    MVI A,20h
  974  053F: 77               MOV M,A
  975  0540: 23               INX H
  976  0541: 0B               DCX B
  977  0542: 78               MOV A,B
  978  0543: B1               ORA C
  979  0544: C2 3D 05         JNZ XB1
  980  0547: C9               RET
  981            
  982  0548: 7E       XCPY:   MOV A,M             ; ASCIZ: [HL]->[DE], 0 = конец (A/флаги)
  983  0549: B7               ORA A
  984  054A: C8               RZ
  985  054B: 12               STAX D
  986  054C: 23               INX H
  987  054D: 13               INX D
  988  054E: C3 48 05         JMP XCPY
  989            
  990            ; ---------------------------------------------------------------------
  991            ; XSEND: кадр XSTREAM в UART: A5 5A [SEQ] + 2000 Б из XBUF.
  992            ;   Сохраняет PSW/B/D/H. РАВНОМЕРНЫЙ пейсинг 36,75T/Б без опроса TXRDY:
  993            ;   на 3,125 МГц 36,75T = 11,8 мкс >= 10 мкс байта 1M. CALL TMIARM
  994            ;   (заглушка RET) в шапке КАЖДОЙ 8-Б подгруппы (~94 мкс): слот
  995            ;   приходит САМ раз в 4,096 мс, ISR-вставка ~170 мкс удлиняет текущий
  996            ;   гэп (мин. 25T соблюдён) - ноль отбросов TX; регенерация/скан идут
  997            ;   ВНУТРИ посылки. Кадр ~37 мс (~27 FPS; v1.2: ~42).
  998            ; ---------------------------------------------------------------------
  999  0551: F5       XSEND:  PUSH PSW
 1000  0552: C5               PUSH B
 1001  0553: D5               PUSH D
 1002  0554: E5               PUSH H
 1003  0555: CD C4 05         CALL XUPDCTR        ; живой счётчик SEQ в демо-экран
 1004  0558: 3E A5            MVI A,0A5h
 1005  055A: D3 04            OUT TXPORT          ; шапка: равномерный пейсинг 33T (4 NOP)
 1006  055C: 00               NOP
 1007  055D: 00               NOP
 1008  055E: 00               NOP
 1009  055F: 00               NOP
 1010  0560: 3E 5A            MVI A,05Ah
 1011  0562: D3 04            OUT TXPORT
 1012  0564: 00               NOP
 1013  0565: 00               NOP
 1014  0566: 00               NOP
 1015  0567: 00               NOP
 1016  0568: 3A FA FF         LDA XSSEQ
 1017  056B: D3 04            OUT TXPORT
 1018  056D: 00               NOP
 1019  056E: 00               NOP
 1020  056F: 00               NOP
 1021  0570: 00               NOP
