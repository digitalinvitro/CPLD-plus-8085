  904            ; =====================================================================
  905            ; RAMT: RAM-тест 8000h-FFD7h (клавиша F). 4 паттерна 00/FF/55/AA:
  906            ; заполнение + контроль побайтно. Статический дисплей (DIG0) = глиф
  907            ; паттерна ("0000"/"FFFF"/"5555"/"AAAA"). Сбой: ADDRH/L = адрес сбоя,
  908            ; EEEE + длинный сигнал. Успех: короткий тик. Вход через KRAM с TMOFF:
  909            ; 7.5 замаскирован - ISR не толкает стек в диапазон теста.
  910            ; ГРАНИЦА: FFD8h-FFE7h НЕ тестируется (фикс v2.0.2/tw): там живёт стек
  911            ; монитора - собственный адрес возврата RAMT лежит в FFE7h/FFE6h, и
  912            ; заполнение до FFE7h затирало его -> после теста RET в мусор. Стек до
  913            ; FFD4h не доходит (RAMT без длинных push). Портит всё, кроме клеток.
  914            ; ФИКС v2.0.2 (tw): паттерн восстанавливается из E на каждом шаге
  915            ; (MOV A,E): в v1.2-v2.0.1 MOV A,H после INX H затирал паттерн в A и
  916            ; с 8001h писались МЛАДШИЕ БАЙТЫ АДРЕСА -> вечная "ошибка ОЗУ".
  917            ; ---------------------------------------------------------------------
  918  04C8: 21 76 00 RAMT:   LXI H,RAMPAT        ; HL = текущая пара (value+glyph)
  919  04CB: 0E 04            MVI C,04h           ; 4 паттерна
  920  04CD: 7E       RMT0:   MOV A,M             ; A = значение паттерна
  921  04CE: 5F               MOV E,A
  922  04CF: E5               PUSH H              ; указатель пары - на стек (HL уйдёт под заполнение)
  923  04D0: 23               INX H
  924  04D1: 7E               MOV A,M             ; глиф паттерна
  925  04D2: CD 4B 03         CALL LSTAT          ; статический дисплей ("0000" и т.д.)
  926  04D5: 7B               MOV A,E
  927  04D6: 21 00 80         LXI H,8000h
  928  04D9: 7B       RMF:    MOV A,E             ; паттерн из E на КАЖДОМ шаге (фикс v2.0.2)
  929  04DA: 77               MOV M,A             ; заполнение
  930  04DB: 23               INX H
  931  04DC: 7C               MOV A,H
  932  04DD: FE FD            CPI 0FDh
  933  04DF: C2 D9 04         JNZ RMF
  934  04E2: 7D               MOV A,L
  935  04E3: FE D8            CPI 0D8h
  936  04E5: C2 D9 04         JNZ RMF
  937  04E8: 21 00 80         LXI H,8000h
  938  04EB: 7E       RMV:    MOV A,M             ; контроль (8000h..FFD7h)
  939  04EC: BB               CMP E
  940  04ED: C2 08 05         JNZ RMBAD
  941  04F0: 23               INX H
  942  04F1: 7C               MOV A,H
  943  04F2: FE FD            CPI 0FDh
  944  04F4: C2 EB 04         JNZ RMV
  945  04F7: 7D               MOV A,L
  946  04F8: FE D8            CPI 0D8h
  947  04FA: C2 EB 04         JNZ RMV
  948  04FD: E1               POP H               ; HL = пара паттерна
  949  04FE: 23               INX H
  950  04FF: 23               INX H               ; следующая пара
  951  0500: 0D               DCR C
  952  0501: C2 CD 04         JNZ RMT0
  953  0504: CD A0 01         CALL TICKON         ; ОК
  954  0507: C9               RET
  955  0508: 22 EB FF RMBAD:  SHLD ADDRL          ; ADDRH/L = адрес сбоя (HL из RMV, до POP!)
  956  050B: E1               POP H               ; снять указатель пары (баланс стека)
  957  050C: 3E 79            MVI A,79h           ; 'E' -> EEEE
  958  050E: CD 4B 03         CALL LSTAT
  959  0511: CD 6D 03         CALL LDBEEP
  960  0514: C9               RET                 ; в меню; D = просмотр байта по адресу сбоя
