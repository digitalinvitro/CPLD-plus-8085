  827  0410: CD 63 03         CALL LDSUM
  828  0413: 3E 03            MVI A,03h
  829  0415: 32 FA FF         STA LST             ; type
  830  0418: 3E 01            MVI A,01h
  831  041A: 32 FC FF         STA LBPC
  832  041D: 3E 02            MVI A,02h
  833  041F: 32 FB FF         STA LNIB
  834  0422: C3 8E 03         JMP LDLP
  835  0425: 78       LDTYP:  MOV A,B
  836  0426: 32 FF FF         STA LTY
  837  0429: CD 63 03         CALL LDSUM
  838  042C: 3A FF FF         LDA LTY
  839  042F: FE 01            CPI 01h
  840  0431: CA 47 04         JZ LDTYP1
  841  0434: 3A EC FF         LDA ADCNT           ; type 00: данные
  842  0437: 32 FC FF         STA LBPC
  843  043A: 3E 04            MVI A,04h
  844  043C: 32 FA FF         STA LST
  845  043F: 3E 02            MVI A,02h
  846  0441: 32 FB FF         STA LNIB
  847  0444: C3 8E 03         JMP LDLP
  848  0447: AF       LDTYP1: XRA A               ; type 01 (EOF): данных нет
  849  0448: 32 FC FF         STA LBPC
  850  044B: 3E 05            MVI A,05h
  851  044D: 32 FA FF         STA LST
  852  0450: 3E 02            MVI A,02h
  853  0452: 32 FB FF         STA LNIB
  854  0455: C3 8E 03         JMP LDLP
  855  0458: 3A EA FF LDDAT:  LDA ADDRH
  856  045B: E6 80            ANI 80h             ; запись разрешена только в ОЗУ
  857  045D: CA BF 04         JZ LDERR            ; ROM-окно - ошибка
  858  0460: 3A EA FF         LDA ADDRH
  859  0463: 67               MOV H,A
  860  0464: 3A EB FF         LDA ADDRL
  861  0467: 6F               MOV L,A
