  672            ; ---------------------------------------------------------------------
  673            ; NIB: A = ASCII-символ -> CY = 1 и A = тетрада 0-F ('0'-'9','A'-'F',
  674            ; 'a'-'f'), иначе CY = 0. Портит A.
  675            ; ---------------------------------------------------------------------
  676  0329: D6 30    NIB:    SUI 30h             ; '0'..'9' -> 0..9
  677  032B: DA 49 03         JC NIBX             ; < '0'
  678  032E: FE 0A            CPI 0Ah
  679  0330: DA 47 03         JC NIBOK            ; цифра 0..9
  680  0333: D6 07            SUI 07h             ; 'A'..'F' -> 10..15
  681  0335: FE 10            CPI 10h
  682  0337: D2 3D 03         JNC NIB2            ; > 'F' - попробовать строчные a..f
  683  033A: C3 47 03         JMP NIBOK
  684  033D: D6 20    NIB2:   SUI 20h             ; ('a'-'0')-07h-20h = 10..15
  685  033F: FE 10            CPI 10h
  686  0341: D2 49 03         JNC NIBX
  687  0344: C3 47 03         JMP NIBOK
  688  0347: 37       NIBOK:  STC
  689  0348: C9               RET
  690  0349: B7       NIBX:   ORA A               ; CY = 0
  691  034A: C9               RET
  692            
  693            ; ---------------------------------------------------------------------
  694            ; LSTAT: A = глиф -> статический дисплей на РАЗРЯДЕ DIG0 (слот-система
  695            ; стоит). Для режимов загрузчика/RAM-теста, где ISR замаскирован (TMOFF).
  696            ; РЕШЕНИЕ ВЛАДЕЛЬЦА (11-22): один разряд вместо четырёх = минимальный
  697            ; ток дисплея во время теста ОЗУ/загрузки -> меньше просадка шины 5 В,
  698            ; чище тест ОЗУ. (В v1.2-v2.0.1 горели все 4 разряда - MVI A,0Fh.)
  699            ; ---------------------------------------------------------------------
  700  034B: C5       LSTAT:  PUSH B
  701  034C: 47               MOV B,A
  702  034D: AF               XRA A
  703  034E: D3 00            OUT SEGP            ; гашение на время переключения
  704  0350: 3E 01            MVI A,01h           ; только DIG0 - токи, см. шапку блока
  705  0352: D3 01            OUT DIGP            ; разряд активен, SND = 0
  706  0354: 78               MOV A,B
  707  0355: D3 00            OUT SEGP            ; глиф на активный разряд
  708  0357: C1               POP B
  709  0358: C9               RET
  710            
  711            ; ---------------------------------------------------------------------
  712            ; DLMS: пауза ~1,02 мс (K_MS=130 итераций 24T @320 нс = 1,002 мс).
  713            ; Портит A/B/C. H/L целы. ВНИМАНИЕ (п.3): внутри DLMS пульки TMIARM
  714            ; нет - на время паузы слоты стоят (один разряд горит ~1 мс, яркость
  715            ; не страдает - скважность 1/4 как всегда; каденция возвращается на
  716            ; следующем TMIARM-вызове).
  717            ; ---------------------------------------------------------------------
  718  0359: 01 82 00 DLMS:   LXI B,K_MS
  719  035C: 0B       DLS1:   DCX B
  720  035D: 78               MOV A,B
  721  035E: B1               ORA C
  722  035F: C2 5C 03         JNZ DLS1
  723  0362: C9               RET
  724            
  725            ; ---------------------------------------------------------------------
  726            ; LDSUM: LSUM += B (mod 256). Портит A.
  727            ; ---------------------------------------------------------------------
  728  0363: F5       LDSUM:  PUSH PSW
  729  0364: 3A FE FF         LDA LSUM
  730  0367: 80               ADD B
  731  0368: 32 FE FF         STA LSUM
  732  036B: F1               POP PSW
  733  036C: C9               RET
  734            
  735            ; ---------------------------------------------------------------------
  736            ; LDBEEP: длинный сигнал ~0,3 с (тоггл D4 DIGP вручную: в B/F 7.5
  737            ; замаскирован (TMOFF) - ISR не пишет DIGP, конфликта нет; CALL
  738            ; TMIARM здесь не нужен (заглушка). Портит A/B/C/D.
  739            ; ---------------------------------------------------------------------
  740  036D: 16 96    LDBEEP: MVI D,150
  741  036F: 3E 1F    LDB1:   MVI A,1Fh           ; SND = 1, разряды on
  742  0371: D3 01            OUT DIGP
  743  0373: CD 59 03         CALL DLMS
  744  0376: 3E 0F            MVI A,0Fh           ; SND = 0
  745  0378: D3 01            OUT DIGP
  746  037A: CD 59 03         CALL DLMS
  747  037D: 15               DCR D
  748  037E: C2 6F 03         JNZ LDB1
  749  0381: C9               RET
