    1            ; =====================================================================
    2            ; beta/txuart/v37gen -- fw_monitor_ACdE_tm_xstream v2.0.4: монитор для
    3            ; платы retro_pcld (CPLD top_txuart_por6_v37G01, XC95108). ПАРА ЖЁСТКО
    4            ; СВЯЗАНА: RTL v37G01 <-> fw v2.0.4. База линии - v37G01 (глобальный
    5            ; асинхронный сброс GSR, модуль RESET_CPU, джиффи-таймер); линия v37F
    6            ; ЗАКРЫТА (архив пары v37F-11 <-> v2.0.1 - в beta/txuart/rom).
    7            ;
    8            ; ЛИНИЯ ПРОШИВКИ:
    9            ;   v1.2    (пара RTL v2.9)   - N-таймер в RTL, ре-арм OUT 06h;
   10            ;   v2.0    (пара v37F-11)    - свободный тик 4 мкс, дисциплина TMIARM,
   11            ;                               делитель слотов E=6;
   12            ;   v2.0.1  (пара v37F-11)    - фикс SIM-масок (78h/68h несли чужую
   13            ;                               раскладку битов и снимали ВСЕ маски ->
   14            ;                               торнадо прерываний: ЦП 100% в ISR);
   15            ;   v2.0.2  (пара v37G01, tw) - адаптация к джиффи v37G01: TMIARM ->
   16            ;                               RET-заглушка, E=6 удалён, слот на каждый
   17            ;                               вызов ISR; + 2 фикса близнеца: KSCOL
   18            ;                               (индекс в младший байт BC) и RAMT
   19            ;                               (паттерн из E; граница FFD8h);
   20            ;   v2.0.3  (пара v37G01)     - ЭТА сборка: чистка (TMTINY мёртвый код,
   21            ;                               дубль LXI H,8000h), документация под
   22            ;                               v37G01 (джиффи 4,096 мс, порт 03h
   23            ;                               D6-D5 = tmr_cnt[9:8]), резолюция LSTAT
   24            ;                               (01h = токи, решение владельца 11-22),
   25            ;                               баннер v2.0.3.
   26            ;   v2.0.4  (пара v37G01)     - ЭТА сборка: 1) РЕГРЕССИЯ масок (v2.0.2
   27            ;                               вернул 78h/68h из v2.0 - v2.0.1 уже чинил):
   28            ;                               TMOFF 1Fh, TMON 1Fh+3Bh. 2) ГЛАВНОЕ: пересчёт
   29            ;                               RXD по реальным тактам 8085 (модель 14T/
   30            ;                               итерация врала на 6-8%: JNZ taken=10T не учтён
   31            ;                               в фикс-накладке) - d7 и стоп уходили за границу
   32            ;                               бита, ':' читался как BAh -> вечный LLLL;
   33            ;                               RXHB 19->17, RXFB 41->38.
   34            ;
   35            ;   1. ТАЙМЕР v37G01: RST 7.5 = СВОБОДНОЕ ДЖИФФИ 4,096 мс (счётчик
   36            ;      tmr_cnt[9:0] в CPLD шагом 4 мкс, импульс 1 клк при переполнении;
   37            ;      1024 x 4 мкс = 4,096 мс = 244,14 Гц). Остановить нельзя - только
   38            ;      замаскировать (DI/маски). OUT 06h: A[7:4] = колонки, A[3:0]
   39            ;      игнорируются. IN 03h: D6-D5 = tmr_cnt[9:8] - МЕДЛЕННАЯ фаза
   40            ;      (шаг 1,024 мс, полный цикл 4,096 мс).
   41            ;
   42            ;   2. ISR САМОДОСТАТОЧЕН (против дисциплины TMIARM v2.0/v2.0.1):
   43            ;      ответ на прерывание ~80T ~ 26 мкс >> 4 мкс тика v37F-11 - там
   44            ;      прямой сервис был невозможен (пульки/маски/E=6). На джиффи
   45            ;      4,096 мс бюджет 12 800 тактов CPU - ISR входит сам, каденция
   46            ;      РОВНАЯ, пульки не нужны. Маска 7.5 снята ПОСТОЯННО (TMON:
   47            ;      SIM 3Bh), ISR маски не трогает - защёлка перезаряжается сама
   48            ;      к следующему джиффи.
   49            ;
   50            ;   3. СЛОТ = каждый вызов ISR: скан 1 колонки (KSCOL) + регенерация
   51            ;      1 разряда (REFRESH). Каденция ФИКСИРОВАННАЯ: 1 джиффи = 4,096 мс.
   52            ;      Кадр дисплея (4 разряда) = 16,4 мс ~ 61 Гц; полный цикл скана
   53            ;      16,4 мс; ответ на клавишу <= 4,1 мс; ISR ~170 мкс = 4,2% ЦП.
   54            ;      Фаза тона ведётся TICKON'ом (см. п.5), от слотов не зависит.
   55            ;
   56            ;   4. CPU 3,125 МГц (T=320 нс, CLKOUT = X1/2). Константы K_MS 130
   57            ;      (~1,0 мс), RXHB 17, RXFB 38 (v2.0.4: пересчёт по реальным тактам,
   58            ;      бит RX = 55T фикс + PAUSE(38) = 649-653T = 207,7-209,0 мкс;
   59            ;      см. блок EQU и шапку RXD).
   60            ;
   61            ;   5. ЗВУК (фикс v1.2): D4 = бит фазы SNDST.0; фазу тогглит TICKON
   62            ;      раз в ~1 мс -> квадрат ~500 Гц, независимый от слотов.
   63            ;
   64            ;   6. ДИСЦИПЛИНА B/F/GO (проще v1.2 - OUT 06h не нужен):
   65            ;        TMOFF: DI + SIM 1Fh (все маски 5.5/6.5/7.5 + СБРОС защёлки 7.5).
   66            ;        TMON : DI + SIM 1Fh + чистка KRAW/DPIDX/SNDST + SIM 3Bh
   67            ;               (маска 7.5 снята ПОСТОЯННО) + EI. Счётчика E нет.
   68            ;      GO (KGO): TMOFF - программа пользователя получает ~96% ЦП
   69            ;      (ISR ~170 мкс раз в 4,096 мс), дисплей/скан живут. Программе,
   70            ;      которой джиффи не нужен: DI или SIM 1Fh. Вектор 003Ch ведёт в
   71            ;      ROM-TMISR монитора.
   72            ;      B (LOADM): RXD чист от джиттера (маски + DI). F (RAMT): тест
   73            ;      8000h-FFD7h, стек FFD8h-FFE7h не трогается (см. блок RAMT).
   74            ;
   75            ;   7. ПОРТЫ v37G01 (совпадают с v37F-11): ЗАПИСЬ 00h = сегменты
   76            ;      A[6:0] (dp погашен навсегда), 01h = разряды A[3:0] + звук A[4],
   77            ;      04h = TXDATA (однократный строб; запись при busy - байт тихо
   78            ;      теряется), 06h = колонки A[7:4]. ЧТЕНИЕ 03h = {TXRDY(D7),
   79            ;      tmr_cnt[9:8] (D6-D5, шаг 1,024 мс), row4..row0 (D4-D0)}.
   80            ;      02h/05h/07h НЕМАПЛЕНЫ; чтение немапленных = bus_reg (последние
   81            ;      шинные данные; в v37G01 захват bus_reg во время RDn - фикс RTL).
   82            ;
   83            ;   8. XSTREAM (выдача экрана B000h): пейсинг 36,75T/Б сохранён
   84            ;      (11,8 мкс >= 10 мкс байта 1M), CALL TMIARM (заглушка RET) в
   85            ;      шапке каждой 8-Б подгруппы; слот приходит сам раз в 4,096 мс -
   86            ;      ISR-вставка ~170 мкс удлиняет текущий гэп (мин. 25T соблюдён) -
   87            ;      ноль отбросов TX, регенерация/скан идут ВНУТРИ посылки.
   88            ;      Кадр ~37 мс (~27 FPS). Клиент xstream_view.ps1 (COM @1000000
   89            ;      8N1) - БЕЗ ИЗМЕНЕНИЙ: A5 5A [SEQ] + 2000 Б. SEQ в FFFAh.
   90            ;
   91            ; СБОРКА (asm85.py, кодировка CP1251):
   92            ;   python3 ../../../tools/asm85.py fw_monitor_ACdE_tm_xstream_v2_0_3.asm
   93            ;          -o fw_monitor_ACdE_tm_xstream_v2_0_3.hex
   94            ;          -l fw_monitor_ACdE_tm_xstream_v2_0_3.lst
   95            ; Прошивка: flash A29040B, offset 0000h (ROM-окно 0000h-7FFFh).
   96            ;
   97            ; КЛАВИАТУРА (как v27): тетрады 0-F + Enter + F1(меню) + F2(показ
   98            ; адреса); меню: A=адрес C=код D=просмотр E=выполнить B=загрузчик
   99            ; Intel HEX (SID 4800) F=RAM-тест. Выход из залипшего режима - RESET.
  100            ;
  101            ; ОЗУ: переменные FFE8h-FFFFh, стек с FFE7h вниз (SP0 = FFE8h); зона
  102            ; FFD8h-FFE7h RAM-тестом не покрывается (стек, фикс v2.0.2).
  103            ; ГЛУБИНА СТЕКА: максимум XSEND (4 push) + TMISR (PSW+B/D/H +
  104            ; RST-адрес + KSCOL/REFRESH/SETTLE) ~ 26 Б - в свободном ОЗУ.
  105            ; =====================================================================
  106            ; ---- порты CPLD v37G01 (декод по A2-A0, зеркала mod 8; как v37F-11) ----
  107            SEGP    EQU 00h             ; сегменты: D0=a..D6=g, D7=dp (погашен навсегда,
  108                                        ; A7 игнорируется); 1 = горит
  109            DIGP    EQU 01h             ; D3-D0 разряды (1 = горит), D4 = SND (прямой бит)
  110            KBCOLP  EQU 06h             ; OUT: A[7:4] = колонки (1 = заведена); A[3:0]
  111                                        ; ИГНОРИРУЮТСЯ - таймер НЕ пишется (п.1)
  112            KBROWP  EQU 03h             ; IN: D7 = TXRDY (1 = готов принять след. байт),
  113                                        ; D6-D5 = tmr_cnt[9:8] медленная фаза (шаг 1,024 мс),
  114                                        ; D4-D0 ряды (1 = нажата в активной колонке)
  115            TXP     EQU 04h             ; OUT: TXDATA -> сериализатор CPLD (1M 8N1)
  116            ; 02h/05h/07h НЕМАПЛЕНЫ; символы KBCOLP=02h/STP/TMRP/TMN из v1.2 удалены
  117            
  118            ; ---- константы тайминга (CPU 3,125 МГц, T = 320 нс; джиффи 4,096 мс) ----
  119            TQ_MS   EQU 15              ; дебаунс отпускания ~15 мс (DLMS-единиц)
  120            K_MS    EQU 130             ; DLMS-единица ~1,0 мс (130 x 24T x 320 нс)
  121            RXHB    EQU 17              ; полбита 4800 (v2.0.4: PAUSE-итераций)
  122            RXFB    EQU 38              ; бит приёма 4800 (v2.0.4: PAUSE-итераций)
  123            ; РЕАЛЬНАЯ тактовка 8085 (v2.0.4; модель "14T/итерация" врала на 6-8%:
  124            ; JNZ taken = 10T / not-taken = 7T не учтены в фикс-накладке):
  125            ; PAUSE(n) = 15n+24T c CALL/RET. Полубит: 19T (ORA/JM в RXW) + MVI D 7T
  126            ; + PAUSE(17) 279T + RIM+ORA 12T = 317T = 101 мкс = 0,49 бита от выборки
  127            ; фронта (+ джиттер обнаружения до 19T = 6 мкс). Бит RX: 55T фикс
  128            ; (ANI/RAR/MOVx2/MVI/DCR/JNZ/след.RIM) + PAUSE(38) = 649-653T = 207,7-
  129            ; 209,0 мкс (идеал 208,3). Выборки (rxd_cycles.py, RIM 8-12T): d0 1,45-
  130            ; 1,47, d7 8,42-8,49, стоп 9,43-9,50 бита. Было (19/41): d7 9,02-9,09 =
  131            ; СТОП-БИТ, стоп 10,10-10,16 = idle -> ':' читался как BAh (LLL!).
  132            
  133            ; ---- коды клавиш ----
  134            K_ENT   EQU 10h             ; Enter  (row3/col3, SW16)
  135            K_F1    EQU 11h             ; F1     (row4/col1, SW18) - меню
  136            K_F2    EQU 12h             ; F2     (row4/col2, SW19) - показ адреса
  137            K_NONE  EQU 0FFh            ; пустая позиция матрицы
  138            
  139            ; ---- состояния ----
  140            ST_MENU EQU 00h             ; меню "ACDE" (B = загрузчик, F = RAM-тест)
  141            ST_ADDR EQU 01h             ; ввод адреса
  142            ST_PROG EQU 02h             ; ввод кода (Code)
  143            ST_VIEW EQU 03h             ; просмотр кода
  144            ST_SHOW EQU 04h             ; показ адреса операций (F2)
  145            
  146            ; ---- ОЗУ монитора ----
  147            SP0     EQU 0FFE8h          ; SP монитора
  148            SNDST   EQU 0FFE8h          ; бит0 = фаза тона (тогглит TICKON), бит1 = тон вкл
  149            STATE   EQU 0FFE9h          ; 0=меню, 1=адрес, 2=код, 3=просмотр, 4=показ
  150            ADDRH   EQU 0FFEAh          ; текущий адрес (старший); в загрузчике = адрес записи
  151            ADDRL   EQU 0FFEBh          ; текущий адрес (младший)
  152            ADCNT   EQU 0FFECh          ; тетрады адреса (0..4); в загрузчике = счётчик байт данных
  153            AF3     EQU 0FFEDh          ; тетрады адреса
  154            AF2     EQU 0FFEEh
  155            AF1     EQU 0FFEFh
  156            AF0     EQU 0FFF0h
  157            BDCNT   EQU 0FFF1h          ; введено тетрад байта (0..2)
  158            BF1     EQU 0FFF2h
  159            BF0     EQU 0FFF3h
  160            DPIDX   EQU 0FFF4h          ; фаза регенерации 0..3 = колонка скана (владеет ISR)
  161            DIGIMG  EQU 0FFF5h          ; глифы разрядов DIG0..DIG3
  162            DIGIMG0 EQU 0FFF5h
  163            DIGIMG1 EQU 0FFF6h
  164            DIGIMG2 EQU 0FFF7h
  165            DIGIMG3 EQU 0FFF8h
  166            PREVST  EQU 0FFF9h          ; прежний режим для F2
  167            ; --- парсер Intel HEX (загрузчик B); FFFC-FFFF = шара с KRAW (п.3 v1.2) ---
  168            LST     EQU 0FFFAh          ; состояние: 0=ждём ':' 1=count 2=addr 3=type 4=data 5=chk
  169                                        ;   (шара с XSSEQ - см. п.8; LOADM чистит на входе)
  170            LNIB    EQU 0FFFBh          ; осталось тетрад в текущем байте поля (1..2)
  171            LBPC    EQU 0FFFBh+1        ; осталось байт в текущем поле   = KRAW0
  172            LACC    EQU 0FFFBh+2        ; накопитель тетрад текущего байта = KRAW1
  173            LSUM    EQU 0FFFBh+3        ; сумма байт записи (mod 256)      = KRAW2
  174            LTY     EQU 0FFFBh+4        ; тип последней записи             = KRAW3
  175            ; --- сырой образ клавиатуры (пишет ISR, читает главный цикл) ---
  176            KRAW0   EQU 0FFFBh+1        ; ряды колонки 0 (биты 0-4) = LBPC
  177            KRAW1   EQU 0FFFBh+2        ; ряды колонки 1            = LACC
  178            KRAW2   EQU 0FFFBh+3        ; ряды колонки 2            = LSUM
  179            KRAW3   EQU 0FFFBh+4        ; ряды колонки 3            = LTY
  180            
  181            ; --- XSTREAM: экран -> UART (тик кадра = непрерывный поток, п.8) ---
  182            TXPORT  EQU TXP             ; TXDATA (04h) - синоним для xstream-кода
  183            XBUF    EQU 0B000h          ; ЭКРАН 80x25 = 2000 Б (B000h..B7CFh)
  184            XSSEQ   EQU 0FFFAh          ; SEQ кадра mod 256 (ячейка LST - см. п.8)
  185            XSCNT   EQU XBUF+06E4h      ; живой счётчик SEQ в демо-экране (строка 22, кол. 4-5)
  186            
  187            ; =====================================================================
  188  0000: -                ORG 0000h
  189  0000: C3 B5 07         JMP START
  190            
  191            ; ---- векторная зона: глушилки EI;RET -------------------------------
  192            ; RST 1..7, TRAP (0024h), RST 5.5/6.5. EI обязателен в каждой (снимает
  193            ; блокировку после приёма). На плате: TRAP = PGND (держатель '0'),
  194            ; 5.5/6.5 железно=0 и вдобавок замаскированы SIM - заглушки защитные.
  195            ; RST 7.5 (003Ch) = СВОБОДНЫЙ ТИК 4 мкс (п.1) - НЕ заглушка, обработчик
  196            ; ниже; под TMOFF маскируется, каденцию задаёт владелец точек TMIARM.
  197  0008: -                ORG 0008h           ; RST 1
  198  0008: FB               EI
  199  0009: C9               RET
  200  0010: -                ORG 0010h           ; RST 2
  201  0010: FB               EI
  202  0011: C9               RET
  203  0018: -                ORG 0018h           ; RST 3
  204  0018: FB               EI
  205  0019: C9               RET
  206  0020: -                ORG 0020h           ; RST 4
  207  0020: FB               EI
  208  0021: C9               RET
  209  0024: -                ORG 0024h           ; TRAP - защитная заглушка (пин PGND)
  210  0024: FB               EI
  211  0025: C9               RET
  212  0028: -                ORG 0028h           ; RST 5
  213  0028: FB               EI
  214  0029: C9               RET
  215  002C: -                ORG 002Ch           ; RST 5.5
  216  002C: FB               EI
  217  002D: C9               RET
  218  0030: -                ORG 0030h           ; RST 6
  219  0030: FB               EI
  220  0031: C9               RET
  221  0034: -                ORG 0034h           ; RST 6.5
  222  0034: FB               EI
  223  0035: C9               RET
  224  0038: -                ORG 0038h           ; RST 7
  225  0038: FB               EI
  226  0039: C9               RET
  227  003C: -                ORG 003Ch           ; RST 7.5 = свободное джиффи 4,096 мс (п.1, п.2)
  228  003C: C3 22 01         JMP TMISR
  229            
  230            ; =====================================================================
  231            ; Таблицы (ORG 0044h - векторная зона выше освобождена)
  232            ; =====================================================================
  233  0044: -                ORG 0044h
  234            ; ---- глифы '0'..'F' (a,b,c,d,e,f,g = D0..D6) ----
  235  0044: 3F       GTBL:   DB 3Fh              ; '0'
  236  0045: 06               DB 06h              ; '1'
  237  0046: 5B               DB 5Bh              ; '2'
  238  0047: 4F               DB 4Fh              ; '3'
  239  0048: 66               DB 66h              ; '4'
  240  0049: 6D               DB 6Dh              ; '5'
  241  004A: 7D               DB 7Dh              ; '6'
  242  004B: 07               DB 07h              ; '7'
  243  004C: 7F               DB 7Fh              ; '8'
  244  004D: 6F               DB 6Fh              ; '9'
  245  004E: 77               DB 77h              ; 'A'
  246  004F: 7C               DB 7Ch              ; 'b'
  247  0050: 39               DB 39h              ; 'C'
  248  0051: 5E               DB 5Eh              ; 'd'
  249  0052: 79               DB 79h              ; 'E'
  250  0053: 71               DB 71h              ; 'F'
  251            
  252            ; ---- биты разрядов/колонок (индекс = DPIDX: 0=DIG0 правый ... 3=DIG3 левый) ----
  253  0054: 01 02 04 08 BITTBL: DB 01h,02h,04h,08h
  254            
  255            ; ---- КАРТА КЛАВИШ: KEYTBL[row*4+col] ----
  256  0058: 0A 0B 0C 0D KEYTBL: DB 0Ah,0Bh,0Ch,0Dh  ; row0: A  B  C  D
  257  005C: 07 08 09 0E         DB 07h,08h,09h,0Eh  ; row1: 7  8  9  E
  258  0060: 04 05 06 0F         DB 04h,05h,06h,0Fh  ; row2: 4  5  6  F
  259  0064: 01 02 03 10         DB 01h,02h,03h,10h  ; row3: 1  2  3  Enter
  260  0068: 00 11 12 FF         DB 00h,11h,12h,0FFh ; row4: 0  F1 F2 (нет)
  261            
  262            ; ---- баннер TX @1M (на терминале 4800 = короткая мусорная строка) ----
  263  006C: 41 43 44 45 2D 54 4D 0D 0A 00 TXBAN:  DB 'ACDE-TM',0Dh,0Ah,00h
  264            
  265            ; ---- паттерны RAM-теста: значение + глиф для статического дисплея ----
  266  0076: 00 3F    RAMPAT: DB 00h,3Fh          ; 00h -> "0000"
  267  0078: FF 71            DB 0FFh,71h         ; FFh -> "FFFF"
  268  007A: 55 6D            DB 55h,6Dh          ; 55h -> "5555"
  269  007C: AA 77            DB 0AAh,77h         ; AAh -> "AAAA"
  270            
  271            ; =====================================================================
  272            ; СИСТЕМА ТАЙМЕРА v2.0: TMOFF/TMON/TMIARM + TMISR + слоты (п.2, п.3, п.6)
  273            ; =====================================================================
  274  0100: -                ORG 0100h
  275            
  276            ; ---------------------------------------------------------------------
  277            ; TMOFF: ТИШИНА слот-системы. DI + полные маски (SIM 1Fh = MSE+M7.5
  278            ; +M6.5+M5.5, заодно СБРОС защёлки RST 7.5). Фронты тика продолжают
  279            ; заряжать защёлку, но ЦП не трогают. Вызывается на входе B/F/GO.
  280            ; Портит A. (v1.2 OUT 06h,0 удалён - стопить нечего, п.1.)
  281            ; ---------------------------------------------------------------------
  282  0100: F3       TMOFF:  DI
  283  0101: 3E 1F            MVI A,1Fh           ; MSE=1, M7.5=1, M6.5=1, M5.5=1 (ВСЕ ЗАМАСКИРОВАНЫ)
  284                                        ; + R7.5=1 (сброс защёлки); SDE=0. (78h ВРАЛ:
  285                                        ; снимал ВСЕ маски - регрессия v2.0.2, п.ченджлог)
  286  0103: 30               SIM
  287  0104: C9               RET
  288            
  289            ; ---------------------------------------------------------------------
  290            ; TMON: ПУСК слот-системы (START, выход из B/F, MONRET). Чистит
  291            ; состояние ISR, заряжает E=6, снимает маску 7.5, EI. Первый слот
  292            ; придёт из ближайшей точки TMIARM (из START - вершина SCAN).
  293            ; ---------------------------------------------------------------------
  294  0105: F3       TMON:   DI
  295  0106: 3E 1F            MVI  A, 1Fh     ; все маски + сброс защёлки RST 7.5 (78h снимал ВСЕ!)
  296  0108: 30               SIM
  297  0109: AF               XRA  A
  298  010A: 32 E8 FF         STA  SNDST      ; тон off, фаза 0
  299  010D: 32 F4 FF         STA  DPIDX      ; фаза регенерации / колонка 0
  300  0110: 32 FC FF         STA  KRAW0      ; сырой образ клавиатуры - в ноль
  301  0113: 32 FD FF         STA  KRAW1
  302  0116: 32 FE FF         STA  KRAW2
  303  0119: 32 FF FF         STA  KRAW3
  304  011C: 3E 3B            MVI  A, 3Bh     ; MSE=1, M7.5=0 (7.5 РАЗРЕШЁН), M6.5=1, M5.5=1
  305                                    ; + R7.5=1 (гасим фронты из DI-окна); SDE=0 (68h
  306                                    ; снимал ВСЕ маски, а не только 6.5/5.5!)
  307  011E: 30               SIM
  308  011F: FB               EI
  309  0120: C9               RET
  310            
  311            ; ---------------------------------------------------------------------
  312            ; TMIARM: СОВМЕСТИМОСТЬ (п.2). На тике v37G01 ISR самодостаточен:
  313            ; маска 7.5 снята ПОСТОЯННО (TMON: SIM 3Bh), защёлка перезаряжается
  314            ; сама раз в 4,096 мс - пульки не нужны. Заглушка RET оставлена ради
  315            ; 7 мест CALL TMIARM (SCAN/XSL/KRL/KST/TKL/MNR1/MNR3): CALL/RET = 17T,
  316            ; безвредно. (В паре v37F-11 <-> v2.0.1 здесь была пулька MVI A,68h/
  317            ; SIM/NOP - дисциплина точек TMIARM; см. DEVLOG.) Ничего не портит.
  318            ; ---------------------------------------------------------------------
  319  0121: C9       TMIARM: RET             ; заглушка для старых вызовов CALL TMIARM
  320            
  321            ; ---------------------------------------------------------------------
  322            ; ---------------------------------------------------------------------
  323            ; TMISR: RST 7.5 = СВОБОДНОЕ ДЖИФФИ 4,096 мс (п.1). ВХОДИТ САМ: маска
  324            ; 7.5 снята в TMON и более не ставится - каждый вызов = ПОЛНЫЙ СЛОТ:
  325            ; скан 1 колонки (KSCOL) + регенерация 1 разряда (REFRESH). Счётчика
  326            ; E НЕТ (v2.0.2: удалён). Маски/защёлку не трогаем: выход -> защёлка
  327            ; перезарядится сама к следующему джиффи. Сохраняем PSW/B/D/H всегда
  328            ; (слот на каждом вызове). Такты (@3,125 МГц): ~530T ~ 170 мкс =
  329            ; 4,2% ЦП от джиффи 4,096 мс; кадр 4 разряда = 16,4 мс ~ 61 Гц.
  330            ; ---------------------------------------------------------------------
  331            ; ---------------------------------------------------------------------
  332  0122: F5       TMISR:  PUSH PSW
  333  0123: C5               PUSH B
  334  0124: D5               PUSH D
  335  0125: E5               PUSH H
  336  0126: CD 32 01         CALL KSCOL      ; скан 1 колонки (колонка = фаза DPIDX)
  337  0129: CD 60 01         CALL REFRESH    ; регенерация 1 разряда (фаза ++ внутри)
  338  012C: E1               POP  H
  339  012D: D1               POP  D
  340  012E: C1               POP  B
  341  012F: F1               POP  PSW
  342  0130: FB               EI
  343  0131: C9               RET
  344            
  345            ; ---------------------------------------------------------------------
  346            ; KSCOL: скан ОДНОЙ колонки (вызывается из слота). Колонка = текущая
  347            ; фаза регенерации DPIDX - отдельного счётчика нет. Сырой образ рядов
  348            ; (биты 0-4) -> KRAW0..KRAW3[колонка]. Портит A/B/C/D/H/L (в ISR - под
  349            ; PUSH B/D/H). Колонка на выходе погашена. Записей в 06h две
  350            ; (завести/погасить), A[3:0] = 0 - таймер не пишется.
  351            ; ФИКС v2.0.2 (tw): индекс - в МЛАДШИЙ байт BC (MOV C,A/MVI B,0):
  352            ; DAD B прибавляет пару BC. В v1.2-v2.0.1 индекс лежал в B
  353            ; (MOV B,A/MVI C,0) -> смещение индекс*256: работала ТОЛЬКО колонка 0
  354            ; (клавиши A,7,4,1,0), KRAW1-3 оставались нулями.
  355            ; ---------------------------------------------------------------------
  356  0132: 3A F4 FF KSCOL:  LDA DPIDX           ; колонка = фаза регенерации 0..3
  357  0135: E6 03            ANI 03h
  358  0137: 4F               MOV C,A             ; C = младший байт BC (индекс 0..3)
  359  0138: 06 00            MVI B,0
  360  013A: 21 54 00         LXI H,BITTBL
  361  013D: 09               DAD B               ; HL = BITTBL + колонка
  362  013E: 56               MOV D,M             ; D = бит колонки (01/02/04/08)
  363  013F: 21 FC FF         LXI H,KRAW0
  364  0142: 09               DAD B               ; HL = KRAW0 + колонка (B/C целы)
  365  0143: 7A               MOV A,D
  366  0144: 07               RLC                 ; бит колонки (01/02/04/08) -> старший ниббл
  367  0145: 07               RLC                 ; A[7:4] (RLC x4, переноса нет)
  368  0146: 07               RLC
  369  0147: 07               RLC
  370  0148: D3 06            OUT KBCOLP          ; колонка заведена (A[3:0]=0 - легально, п.1)
  371  014A: CD 56 01         CALL SETTLE
  372  014D: DB 03            IN KBROWP           ; ряды активной колонки (D6-D5 фаза тика и
  373  014F: E6 1F            ANI 1Fh             ; D7 TXRDY маскируются - как в v1.2 Шаг-2)
  374  0151: 77               MOV M,A             ; KRAW[колонка] = сырой образ рядов
  375  0152: AF               XRA A
  376  0153: D3 06            OUT KBCOLP          ; колонки off (0000); вторая запись легальна -
  377  0155: C9               RET                 ; колонки просто гасятся (в v1.2 тут был +N)
  378            
  379            ; =====================================================================
  380            ; Системные процедуры (перенос из v1.2/monitor27, константы 3,125 МГц)
  381            ; =====================================================================
  382            
  383            ; ---------------------------------------------------------------------
  384            ; SETTLE: пауза ~26 мкс (LXI+3 итерации 24T @320 нс; установка рядов
  385            ; после заведения колонки). Портит A/B/C. H/L НЕ ТРОГАЕТ (нужно KSCOL).
  386            ; ---------------------------------------------------------------------
  387  0156: 01 03 00 SETTLE: LXI B,3
  388  0159: 0B       STL:    DCX B
  389  015A: 78               MOV A,B
  390  015B: B1               ORA C
  391  015C: C2 59 01         JNZ STL
  392  015F: C9               RET
  393            
  394            ; ---------------------------------------------------------------------
  395            ; REFRESH: один слот регенерации (v27 БЕЗ ИЗМЕНЕНИЙ, кроме тона).
  396            ; ГАШЕНИЕ -> РАЗРЯД -> ГЛИФ. DIGIMG[DPIDX] на разряд DPIDX, фаза ++
  397            ; mod 4. v2.0 ФИКС тона (п.5): D4 = БИТ ФАЗЫ SNDST.0 (в v1.2 D4 горел
  398            ; константой на всё окно - квадрат не образовывался). D/E НЕ ТРОГАЕТ
  399            ; (в ISR критично: D = бит колонки уже погашен, E = счётчик слотов).
  400            ; Портит A/B/C/H/L.
  401            ; ---------------------------------------------------------------------
  402  0160: 3A F4 FF REFRESH: LDA DPIDX
  403  0163: 4F               MOV C,A             ; C = индекс 0..3
  404  0164: 06 00            MVI B,0
  405  0166: 21 54 00         LXI H,BITTBL
  406  0169: 09               DAD B
  407  016A: 46               MOV B,M             ; B = бит разряда (01,02,04,08)
  408  016B: 21 F5 FF         LXI H,DIGIMG        ; HL = DIGIMG + DPIDX (цикл вместо ADD)
  409  016E: 79       RFIL:   MOV A,C
  410  016F: B7               ORA A
  411  0170: CA 78 01         JZ RFGD
  412  0173: 2C               INR L
  413  0174: 0D               DCR C
  414  0175: C3 6E 01         JMP RFIL
  415  0178: 4E       RFGD:   MOV C,M             ; C = глиф разряда
  416  0179: 3A E8 FF         LDA SNDST
  417  017C: E6 02            ANI 02h
  418  017E: CA 8D 01         JZ RFN              ; тон не разрешён - D4 = 0
  419  0181: 3A E8 FF         LDA SNDST
  420  0184: E6 01            ANI 01h
  421  0186: CA 8D 01         JZ RFN              ; фаза 0 - D4 = 0 (полуволна низа)
  422  0189: 78               MOV A,B
  423  018A: F6 10            ORI 10h
  424  018C: 47               MOV B,A             ; фаза 1 -> D4 = 1 (полуволна верха)
  425  018D: AF       RFN:    XRA A
  426  018E: D3 00            OUT SEGP            ; (1) гашение: старый разряд погас
  427  0190: 78               MOV A,B
  428  0191: D3 01            OUT DIGP            ; (2) разряд переключён (сегменты пусты)
  429  0193: 79               MOV A,C
  430  0194: D3 00            OUT SEGP            ; (3) зажгли глиф нового разряда
  431  0196: 3A F4 FF         LDA DPIDX
  432  0199: 3C               INR A
  433  019A: E6 03            ANI 03h
  434  019C: 32 F4 FF         STA DPIDX
  435  019F: C9               RET
  436            
  437            ; ---------------------------------------------------------------------
  438            ; TICKON: короткий тик подтверждения клавиши ~15 мс (TQ_MS единиц
  439            ; DLMS). v2.0 (п.5): фазу тона SNDST.0 тогглит САМ TICKON раз в ~1 мс
  440            ; -> квадрат ~500 Гц, НЕ зависящий от каденции слотов (в v1.2 фазу
  441            ; тогглил слот ~0,7 мс, но REFRESH ставил D4 константой - тона не было).
  442            ; Пулька TMIARM в итерации: слоты идут - дисплей/скан не замирают.
  443            ; Портит A/B/C/H.
  444            ; ---------------------------------------------------------------------
  445  01A0: 3A E8 FF TICKON: LDA SNDST
  446  01A3: F6 02            ORI 02h             ; тон разрешён
  447  01A5: 32 E8 FF         STA SNDST
  448  01A8: 26 0F            MVI H,TQ_MS         ; 15 мс
  449  01AA: 3A E8 FF TKL:    LDA SNDST
  450  01AD: EE 01            XRI 01h             ; тоггл фазы (квадрат ~500 Гц)
  451  01AF: 32 E8 FF         STA SNDST
  452  01B2: CD 21 01         CALL TMIARM         ; слот на итерацию (дисплей жив под тоном)
  453  01B5: CD 59 03         CALL DLMS
  454  01B8: 25               DCR H
  455  01B9: C2 AA 01         JNZ TKL
  456  01BC: 3A E8 FF         LDA SNDST
  457  01BF: E6 FD            ANI 0FDh            ; тон off
  458  01C1: 32 E8 FF         STA SNDST
  459  01C4: C9               RET
  460            
  461            ; ---------------------------------------------------------------------
  462            ; GLOOK: A = тетрада 0..F -> A = глиф (GTBL). Портит A/B/C/H/L.
  463            ; ---------------------------------------------------------------------
  464  01C5: 4F       GLOOK:  MOV C,A
  465  01C6: 06 00            MVI B,0
  466  01C8: 21 44 00         LXI H,GTBL
  467  01CB: 09               DAD B
  468  01CC: 7E               MOV A,M
  469  01CD: C9               RET
  470            ; ---------------------------------------------------------------------
  471            ; REDRAW: пересобрать DIGIMG[0..3] по состоянию (как v5/v27).
  472            ;   меню : "ACdE"; адрес: тетрады вдвигаются справа; код "__C3";
  473            ;   просмотр: [ADDR] в правых разрядах; показ(F2): ADDR на 4 разрядах.
  474            ; Портит A/B/C/D/H/L (D - рабочий в RDW/RDV; ISR сохраняет D - безопасно).
  475            ; ---------------------------------------------------------------------
  476  01CE: 3A E9 FF REDRAW: LDA STATE
  477  01D1: B7               ORA A
  478  01D2: CA 73 02         JZ RDM
  479  01D5: FE 01            CPI 01h
  480  01D7: CA 8A 02         JZ RDA
  481  01DA: FE 03            CPI 03h
  482  01DC: CA 15 02         JZ RDV
  483  01DF: FE 04            CPI 04h
  484  01E1: CA 3E 02         JZ RDW
  485                    ; ---- ST_PROG ----
  486  01E4: AF               XRA A
  487  01E5: 32 F8 FF         STA DIGIMG3
  488  01E8: 32 F7 FF         STA DIGIMG2
  489  01EB: 32 F6 FF         STA DIGIMG1
  490  01EE: 32 F5 FF         STA DIGIMG0
  491  01F1: 3A F1 FF         LDA BDCNT
  492  01F4: FE 02            CPI 02h
  493  01F6: DA 02 02         JC RDPR0            ; <2 - старшая тетрада пуста
  494  01F9: 3A F2 FF         LDA BF1
  495  01FC: CD C5 01         CALL GLOOK
  496  01FF: 32 F6 FF         STA DIGIMG1
  497  0202: 3A F1 FF RDPR0:  LDA BDCNT
  498  0205: B7               ORA A
  499  0206: CA DB 02         JZ RDRE             ; 0 - младшая тоже пуста
  500  0209: 3A F3 FF         LDA BF0
  501  020C: CD C5 01         CALL GLOOK
  502  020F: 32 F5 FF         STA DIGIMG0
  503  0212: C3 DB 02         JMP RDRE
  504  0215: 3A EA FF RDV:    LDA ADDRH           ; ---- ST_VIEW: [ADDR] в правых разрядах ----
  505  0218: 67               MOV H,A
  506  0219: 3A EB FF         LDA ADDRL
  507  021C: 6F               MOV L,A             ; HL = ADDR
  508  021D: 7E               MOV A,M             ; A = [ADDR] (HL>=8000h - ОЗУ)
  509  021E: 57               MOV D,A             ; D = байт (GLOOK портит B)
  510  021F: 0F               RRC
  511  0220: 0F               RRC
  512  0221: 0F               RRC
  513  0222: 0F               RRC
  514  0223: E6 0F            ANI 0Fh             ; старшая тетрада
  515  0225: CD C5 01         CALL GLOOK
  516  0228: 32 F6 FF         STA DIGIMG1
  517  022B: 7A               MOV A,D
  518  022C: E6 0F            ANI 0Fh             ; младшая тетрада
  519  022E: CD C5 01         CALL GLOOK
  520  0231: 32 F5 FF         STA DIGIMG0
  521  0234: AF               XRA A
  522  0235: 32 F8 FF         STA DIGIMG3
  523  0238: 32 F7 FF         STA DIGIMG2
  524  023B: C3 DB 02         JMP RDRE
  525  023E: 3A EA FF RDW:    LDA ADDRH           ; ---- ST_SHOW: ADDR на 4 разрядах ----
  526  0241: 57               MOV D,A             ; D = старший байт (GLOOK портит B)
  527  0242: 0F               RRC
  528  0243: 0F               RRC
  529  0244: 0F               RRC
  530  0245: 0F               RRC
  531  0246: E6 0F            ANI 0Fh
  532  0248: CD C5 01         CALL GLOOK
  533  024B: 32 F8 FF         STA DIGIMG3
  534  024E: 7A               MOV A,D
  535  024F: E6 0F            ANI 0Fh
  536  0251: CD C5 01         CALL GLOOK
  537  0254: 32 F7 FF         STA DIGIMG2
  538  0257: 3A EB FF         LDA ADDRL
  539  025A: 57               MOV D,A
  540  025B: 0F               RRC
  541  025C: 0F               RRC
  542  025D: 0F               RRC
  543  025E: 0F               RRC
  544  025F: E6 0F            ANI 0Fh
  545  0261: CD C5 01         CALL GLOOK
  546  0264: 32 F6 FF         STA DIGIMG1
  547  0267: 7A               MOV A,D
  548  0268: E6 0F            ANI 0Fh
  549  026A: CD C5 01         CALL GLOOK
  550  026D: 32 F5 FF         STA DIGIMG0
  551  0270: C3 DB 02         JMP RDRE
  552  0273: 3E 77    RDM:    MVI A,77h           ; 'A'
  553  0275: 32 F8 FF         STA DIGIMG3
  554  0278: 3E 39            MVI A,39h           ; 'C'
  555  027A: 32 F7 FF         STA DIGIMG2
  556  027D: 3E 5E            MVI A,5Eh           ; 'd' (D)
  557  027F: 32 F6 FF         STA DIGIMG1
  558  0282: 3E 79            MVI A,79h           ; 'E'
  559  0284: 32 F5 FF         STA DIGIMG0
  560  0287: C3 DB 02         JMP RDRE
  561  028A: AF       RDA:    XRA A               ; ---- ST_ADDR: последняя тетрада справа ----
  562  028B: 32 F8 FF         STA DIGIMG3
  563  028E: 32 F7 FF         STA DIGIMG2
  564  0291: 32 F6 FF         STA DIGIMG1
  565  0294: 32 F5 FF         STA DIGIMG0
  566  0297: 3A EC FF         LDA ADCNT
  567  029A: FE 01            CPI 01h
  568  029C: DA DB 02         JC RDRE             ; 0 тетрад - всё пусто
  569  029F: 3A F0 FF         LDA AF0
  570  02A2: CD C5 01         CALL GLOOK
  571  02A5: 32 F5 FF         STA DIGIMG0
  572  02A8: 3A EC FF         LDA ADCNT
  573  02AB: FE 02            CPI 02h
  574  02AD: DA DB 02         JC RDRE
  575  02B0: 3A EF FF         LDA AF1
  576  02B3: CD C5 01         CALL GLOOK
  577  02B6: 32 F6 FF         STA DIGIMG1
  578  02B9: 3A EC FF         LDA ADCNT
  579  02BC: FE 03            CPI 03h
  580  02BE: DA DB 02         JC RDRE
  581  02C1: 3A EE FF         LDA AF2
  582  02C4: CD C5 01         CALL GLOOK
  583  02C7: 32 F7 FF         STA DIGIMG2
  584  02CA: 3A EC FF         LDA ADCNT
  585  02CD: FE 04            CPI 04h
  586  02CF: DA DB 02         JC RDRE
  587  02D2: 3A ED FF         LDA AF3
  588  02D5: CD C5 01         CALL GLOOK
  589  02D8: 32 F8 FF         STA DIGIMG3
  590  02DB: C9       RDRE:   RET
  591            
  592            ; =====================================================================
  593            ; UART-канал: передача OUT 04h @1M (TXRDY = IN 03h бит 7, v1.2 Шаг-2),
  594            ; приём RIM/SID @4800 - как v27
  595            ; =====================================================================
  596            
  597            ; ---------------------------------------------------------------------
  598            ; TXBYTE: A = байт -> сериализатор CPLD (1 000 000 8N1). Ожидает TXRDY
  599            ; (запись при busy аппаратно отбрасывается). Используется баннером/строками.
  600            ; ---------------------------------------------------------------------
  601  02DC: F5       TXBYTE: PUSH PSW
  602  02DD: DB 03    TXB1:   IN KBROWP           ; TXRDY = бит 7
  603  02DF: E6 80            ANI 80h             ; tx_idle = ~|bit_cnt: 1 = готов принять байт
  604  02E1: CA DD 02         JZ TXB1
  605  02E4: F1               POP PSW
  606  02E5: D3 04            OUT TXP
  607  02E7: C9               RET
  608            
  609            ; ---------------------------------------------------------------------
  610            ; TXSTR: HL = строка с нулевым завершителем -> TX. Портит A/HL.
  611            ; ---------------------------------------------------------------------
  612  02E8: 7E       TXSTR:  MOV A,M
  613  02E9: B7               ORA A
  614  02EA: C8               RZ
  615  02EB: CD DC 02         CALL TXBYTE
  616  02EE: 23               INX H
  617  02EF: C3 E8 02         JMP TXSTR
  618            
  619            ; ---------------------------------------------------------------------
  620            ; PAUSE: пауза D итераций (v2.0.4: DCR 5T + JNZ 10T/7T -> PAUSE(n) =
  621            ; 15n+24T c CALL/RET = 4,8n+7,7 мкс; модель 14T врала на ~7%).
  622            ; ---------------------------------------------------------------------
  623  02F2: 15       PAUSE:  DCR D
  624  02F3: C2 F2 02         JNZ PAUSE
  625  02F6: C9               RET
  626            
  627            ; ---------------------------------------------------------------------
  628            ; RXD: приём байта SID 4800 8N1 (фрагмент 7 + стоп-бит). Выход:
  629            ; C = байт, CY = 0 ОК / CY = 1 обрыв кадра (стоп-бит = 0). Портит A/B/C/D.
  630            ; Цикл строгий - в режиме B таймер ЗАМАСКИРОВАН (TMOFF: DI + SIM 1Fh)
  631            ; и пульки TMIARM запрещены - джиттера нет вообще.
  632            ; Константы v2.0.4: RXHB=17/RXFB=38, пересчёт по реальным тактам
  633            ; (scripts/rxd_cycles.py). Старые 19/41 (модель 14T) давали период бита
  634            ; 691-698T = 221-223 мкс вместо 208 -> d7 на 9,02-9,09 бита (СТОП-БИТ),
  635            ; стоп на 10,10-10,16 (idle): D7 всегда читалась как 1, ':' (3Ah) ->
  636            ; BAh, стоп высокий -> "успех" -> LOADM отбрасывал все ':' = вечный
  637            ; LLLL (diag_ph: 9F на любом символе - его d7 тоже уплывал в стоп).
  638            ; Новые: d0 1,45-1,47, d7 8,42-8,49, стоп 9,43-9,50 бита. v1.2: 15/30.
  639            ; ---------------------------------------------------------------------
  640  02F7: 06 08    RXD:    MVI B,08h
  641  02F9: 20       RXW:    RIM                 ; A7 = SID
  642  02FA: B7               ORA A
  643  02FB: FA F9 02         JM RXW              ; '1' (покой) - ждать старт-бит
  644  02FE: 16 11            MVI D,RXHB          ; полбита - в середину старт-бита
  645  0300: CD F2 02         CALL PAUSE
  646  0303: 20               RIM                 ; подтвердить старт-бит
  647  0304: B7               ORA A
  648  0305: FA F9 02         JM RXW              ; '1' - ложный старт, ждать заново
  649  0308: 0E 00            MVI C,00h
  650  030A: 16 26            MVI D,RXFB          ; бит - в середину D0
  651  030C: CD F2 02         CALL PAUSE
  652  030F: 20       RXL:    RIM                 ; A7 = SID - центр очередного бита
  653  0310: E6 80            ANI 80h
  654  0312: 1F               RAR                 ; бит -> CY
  655  0313: 79               MOV A,C
  656  0314: 1F               RAR                 ; вставить сверху (LSB-first)
  657  0315: 4F               MOV C,A
  658  0316: 16 26            MVI D,RXFB
  659  0318: CD F2 02         CALL PAUSE
  660  031B: 05               DCR B
  661  031C: C2 0F 03         JNZ RXL
  662                    ; после последней итерации RXL (выборка d7 + бит задержки)
  663                    ; линия = середина стоп-бита
  664  031F: 20               RIM
  665  0320: E6 80            ANI 80h             ; CY = 0 (ANI сбрасывает перенос)
  666  0322: CA 27 03         JZ RXBAD            ; стоп-бит = 0 - обрыв кадра
  667  0325: B7               ORA A               ; CY = 0
  668  0326: C9               RET                 ; C = байт, CY = 0
  669  0327: 37       RXBAD:  STC
  670  0328: C9               RET                 ; CY = 1
