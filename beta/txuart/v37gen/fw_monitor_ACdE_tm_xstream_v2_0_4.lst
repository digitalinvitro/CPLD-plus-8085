  751            ; =====================================================================
  752            ; LOADM: Intel HEX загрузчик (клавиша B). Приём SID 4800 8N1.
  753            ; Вход через KLD с TMOFF (7.5 замаскирован, DI) - как v27 по логике
  754            ; парсера. Формат записи: :nnaaaatt[dd...]cc, cc = (-сумма байт) mod 256.
  755            ; Статический дисплей LLLL; адрес каждой записи живёт в ADDRH/L.
  756            ; Запись только в ОЗУ (A15=1): попадание в ROM-окно = ошибка EEEE.
  757            ; Выход: EOF-запись (type 01) -> тик и меню; ошибка -> EEEE + сигнал.
  758            ; Выход из зависшего приёма - RESET (SW20).
  759            ; NOTE: LACC/LNIB/LBPC/LSUM/LTY = клетки FFFB-FFFF; в обычном режиме
  760            ; FFFC-FFFF заняты KRAW (ISR) - в B маски стоят (TMOFF), конфликта нет;
  761            ; TMON на выходе чистит KRAW. XSSEQ/LST = FFFA: на входе LST=0 (=SEQ 0 -
  762            ; клиент логирует рестарт потока), на выходе TMON -> новое SEQ с 0.
  763            ; ---------------------------------------------------------------------
  764  0382: AF       LOADM:  XRA A
  765  0383: 32 FA FF         STA LST             ; ждем ':' (и XSSEQ = 0 - рестарт потока клиента)
  766  0386: 32 FD FF         STA LACC            ; накопитель тетрад тоже с нуля (баг v1.0:
  767                                        ;  сталь ломала первый байт первой записи)
  768  0389: 3E 38            MVI A,38h           ; 'L'
  769  038B: CD 4B 03         CALL LSTAT
  770  038E: CD F7 02 LDLP:   CALL RXD            ; C = байт, CY = ошибка кадра
  771  0391: DA BF 04         JC LDERR
  772  0394: 79               MOV A,C
  773  0395: FE 3A            CPI ':'
  774  0397: CA AA 04         JZ LDNEW            ; начало записи
  775  039A: CD 29 03         CALL NIB            ; тетрада?
  776  039D: D2 8E 03         JNC LDLP            ; прочее (\r\n и т.п.) - пропустить
  777  03A0: 5F               MOV E,A             ; E = тетрада (7.5 замаскирован - E свободен)
  778  03A1: 3A FD FF         LDA LACC
  779  03A4: 07               RLC
  780  03A5: 07               RLC
  781  03A6: 07               RLC
  782  03A7: 07               RLC                 ; накопитель << 4
  783  03A8: B3               ORA E
  784  03A9: 32 FD FF         STA LACC
  785  03AC: 3A FB FF         LDA LNIB
  786  03AF: 3D               DCR A
  787  03B0: 32 FB FF         STA LNIB
  788  03B3: C2 8E 03         JNZ LDLP            ; байт поля ещё не собран
  789                    ; --- байт поля собран - применить по состоянию ---
  790  03B6: 3A FD FF         LDA LACC
  791  03B9: 47               MOV B,A             ; B = байт
  792  03BA: AF               XRA A
  793  03BB: 32 FD FF         STA LACC            ; накопитель очищен к следующему байту
  794  03BE: 3A FA FF         LDA LST
  795  03C1: B7               ORA A
  796  03C2: CA 8E 03         JZ LDLP             ; байт вне записи - игнор
  797  03C5: 3D               DCR A
  798  03C6: CA D8 03         JZ LDCNT            ; 1 = count
  799  03C9: 3D               DCR A
  800  03CA: CA ED 03         JZ LDADR            ; 2 = addr
  801  03CD: 3D               DCR A
  802  03CE: CA 25 04         JZ LDTYP            ; 3 = type
  803  03D1: 3D               DCR A
  804  03D2: CA 58 04         JZ LDDAT            ; 4 = data
  805  03D5: C3 94 04         JMP LDCHK           ; 5 = checksum
  806  03D8: 78       LDCNT:  MOV A,B
  807  03D9: 32 EC FF         STA ADCNT           ; сколько байт данных в записи
  808  03DC: CD 63 03         CALL LDSUM
  809  03DF: 3E 02            MVI A,02h           ; поле addr: 4 тетрады = 2 байта
  810  03E1: 32 FA FF         STA LST
  811  03E4: 32 FC FF         STA LBPC
  812  03E7: 32 FB FF         STA LNIB
  813  03EA: C3 8E 03         JMP LDLP
  814  03ED: 78       LDADR:  MOV A,B
  815  03EE: 32 FF FF         STA LTY             ; временно: тип ещё не читался
  816  03F1: 3A FC FF         LDA LBPC
  817  03F4: FE 02            CPI 02h
  818  03F6: C2 0A 04         JNZ LDAD1
  819  03F9: 3A FF FF         LDA LTY
  820  03FC: 32 EA FF         STA ADDRH           ; старший байт адреса (big-endian)
  821  03FF: 3E 01            MVI A,01h
  822  0401: 32 FC FF         STA LBPC
  823  0404: CD 63 03         CALL LDSUM
  824  0407: C3 8E 03         JMP LDLP
  825  040A: 3A FF FF LDAD1:  LDA LTY
