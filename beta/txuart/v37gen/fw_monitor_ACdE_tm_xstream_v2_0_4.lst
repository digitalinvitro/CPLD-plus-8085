  962            ; =====================================================================
  963            ;                    XSTREAM: ЭКРАН -> UART (п.8: непрерывный поток,
  964            ;                    тик кадра = сама скорость канала, регенерация/
  965            ;                    скан ведётся пульками TMIARM внутри посылки)
  966            ; =====================================================================
  967            ; ---------------------------------------------------------------------
  968            ; XSINIT (из START, только холодный старт): демо-экран в B000h,
  969            ; SEQ = 0. Мониторные переменные не трогаются; B000-B7CF -
  970            ; пользовательская область: ЛЮБАЯ программа может рисовать туда
  971            ; свой текст/графику, клиент xstream_view.ps1 покажет окном.
  972            ; ---------------------------------------------------------------------
  973  0515: CD 37 05 XSINIT: CALL XBLANK
  974  0518: 21 99 07         LXI H,XTBL
  975  051B: 5E       XSI1:   MOV E,M             ; DE = адрес назначения
  976  051C: 23               INX H
  977  051D: 56               MOV D,M
  978  051E: 23               INX H               ; HL -> src_lo
  979  051F: 7A               MOV A,D             ; конец таблицы (dst == 0000)?
  980  0520: B3               ORA E
  981  0521: CA 32 05         JZ XSI3
  982  0524: 4E               MOV C,M             ; BC = адрес строки (источник)
  983  0525: 23               INX H
  984  0526: 46               MOV B,M
  985  0527: 23               INX H               ; HL -> следующая запись
