*******************************  Equations  ********************************

********** Mapped Logic **********


$OpTx$FX_DC$12289 <= (NOT t0_q AND baud_tick AND NOT x1_q.LFBK AND tmr_cnt(0).LFBK AND 
	tmr_cnt(1).LFBK);


$OpTx$FX_DC$12296 <= (NOT t0_q AND tmr_cnt(2) AND tmr_cnt(3) AND baud_tick AND 
	NOT x1_q.LFBK AND tmr_cnt(0).LFBK AND tmr_cnt(4).LFBK AND 
	tmr_cnt(5).LFBK AND tmr_cnt(6).LFBK AND tmr_cnt(7).LFBK AND 
	tmr_cnt(1).LFBK);


A_I(0) <= ((addr_latch(0) AND NOT rd_drive)
	OR (rd_drive AND row0 AND io_rd_kb/io_rd_kb_D2.LFBK)
	OR (rd_drive AND bus_reg(0).LFBK AND 
	NOT io_rd_kb/io_rd_kb_D2.LFBK));
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(1) <= ((addr_latch(1) AND NOT rd_drive)
	OR (D(1) AND rd_drive AND NOT io_rd_kb/io_rd_kb_D2.LFBK)
	OR (rd_drive AND row1 AND io_rd_kb/io_rd_kb_D2.LFBK));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
A_OE(1) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(2) <= ((addr_latch(2) AND NOT rd_drive)
	OR (D(2) AND rd_drive AND NOT io_rd_kb/io_rd_kb_D2.LFBK)
	OR (rd_drive AND row2 AND io_rd_kb/io_rd_kb_D2.LFBK));
A(2) <= A_I(2) when A_OE(2) = '1' else 'Z';
A_OE(2) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(3) <= ((addr_latch(3) AND NOT rd_drive)
	OR (D(3) AND rd_drive AND NOT io_rd_kb/io_rd_kb_D2.LFBK)
	OR (rd_drive AND row3 AND io_rd_kb/io_rd_kb_D2.LFBK));
A(3) <= A_I(3) when A_OE(3) = '1' else 'Z';
A_OE(3) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(4) <= ((addr_latch(4) AND NOT rd_drive)
	OR (D(4) AND rd_drive AND NOT io_rd_kb/io_rd_kb_D2.LFBK)
	OR (rd_drive AND row4 AND io_rd_kb/io_rd_kb_D2.LFBK));
A(4) <= A_I(4) when A_OE(4) = '1' else 'Z';
A_OE(4) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(5) <= ((addr_latch(5) AND NOT rd_drive)
	OR (D(5) AND rd_drive AND NOT io_rd_kb/io_rd_kb_D2)
	OR (rd_drive AND tmr_cnt(8) AND io_rd_kb/io_rd_kb_D2));
A(5) <= A_I(5) when A_OE(5) = '1' else 'Z';
A_OE(5) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(6) <= ((addr_latch(6) AND NOT rd_drive)
	OR (D(6) AND rd_drive AND NOT io_rd_kb/io_rd_kb_D2)
	OR (rd_drive AND tmr_cnt(9) AND io_rd_kb/io_rd_kb_D2));
A(6) <= A_I(6) when A_OE(6) = '1' else 'Z';
A_OE(6) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(7) <= ((addr_latch(7) AND NOT rd_drive)
	OR (D(7) AND rd_drive AND NOT io_rd_kb/io_rd_kb_D2)
	OR (rd_drive AND io_rd_kb/io_rd_kb_D2 AND 
	NOT bit_cnt(0).LFBK AND NOT bit_cnt(1).LFBK AND NOT bit_cnt(2).LFBK AND 
	NOT bit_cnt(3).LFBK));
A(7) <= A_I(7) when A_OE(7) = '1' else 'Z';
A_OE(7) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_7_IOBUFE/A_7_IOBUFE_TRST <= (NOT rd_drive AND NOT in_wb.LFBK);


CS1 <= '1';


CS_n <= ((IOM AND NOT in_wb.LFBK)
	OR (NOT A15 AND NOT in_wb.LFBK));


CSr_n <= NOT ((NOT IOM AND NOT A15));

FDCPE_D0: FDCPE port map (D_I(0),D(0),clk,RST,'0');
D(0) <= ((D(0).PIN AND bus_ld_t1.LFBK)
	OR (bus_ld_t2 AND A(0).PIN AND NOT bus_ld_t1.LFBK)
	OR (NOT bus_ld_t2 AND NOT bus_ld_t1.LFBK AND bus_reg(0).LFBK));
D(0) <= D_I(0) when D_OE(0) = '1' else 'Z';
D_OE(0) <= in_wb.LFBK;

FDCPE_D1: FDCPE port map (D_I(1),D(1),clk,RST,'0');
D(1) <= ((bus_ld_t1 AND D(1).PIN)
	OR (NOT bus_ld_t1 AND bus_ld_t2 AND A(1).PIN)
	OR (NOT bus_ld_t1 AND NOT bus_ld_t2 AND bus_reg(1).LFBK));
D(1) <= D_I(1) when D_OE(1) = '1' else 'Z';
D_OE(1) <= in_wb;

FDCPE_D2: FDCPE port map (D_I(2),D(2),clk,RST,'0');
D(2) <= ((bus_ld_t1 AND D(2).PIN)
	OR (NOT bus_ld_t1 AND bus_ld_t2 AND A(2).PIN)
	OR (NOT bus_ld_t1 AND NOT bus_ld_t2 AND bus_reg(2).LFBK));
D(2) <= D_I(2) when D_OE(2) = '1' else 'Z';
D_OE(2) <= in_wb;

FDCPE_D3: FDCPE port map (D_I(3),D(3),clk,RST,'0');
D(3) <= ((bus_ld_t1 AND D(3).PIN)
	OR (NOT bus_ld_t1 AND bus_ld_t2 AND A(3).PIN)
	OR (NOT bus_ld_t1 AND NOT bus_ld_t2 AND bus_reg(3).LFBK));
D(3) <= D_I(3) when D_OE(3) = '1' else 'Z';
D_OE(3) <= in_wb;

FDCPE_D4: FDCPE port map (D_I(4),D(4),clk,RST,'0');
D(4) <= ((bus_ld_t1 AND D(4).PIN)
	OR (NOT bus_ld_t1 AND bus_ld_t2 AND A(4).PIN)
	OR (NOT bus_ld_t1 AND NOT bus_ld_t2 AND bus_reg(4).LFBK));
D(4) <= D_I(4) when D_OE(4) = '1' else 'Z';
D_OE(4) <= in_wb;

FDCPE_D5: FDCPE port map (D_I(5),D(5),clk,RST,'0');
D(5) <= ((bus_ld_t1 AND D(5).PIN)
	OR (NOT bus_ld_t1 AND bus_ld_t2 AND A(5).PIN)
	OR (NOT bus_ld_t1 AND NOT bus_ld_t2 AND bus_reg(5).LFBK));
D(5) <= D_I(5) when D_OE(5) = '1' else 'Z';
D_OE(5) <= in_wb;

FDCPE_D6: FDCPE port map (D_I(6),D(6),clk,RST,'0');
D(6) <= ((D(6).PIN AND bus_ld_t1.LFBK)
	OR (bus_ld_t2 AND A(6).PIN AND NOT bus_ld_t1.LFBK)
	OR (NOT bus_ld_t2 AND NOT bus_ld_t1.LFBK AND bus_reg(6).LFBK));
D(6) <= D_I(6) when D_OE(6) = '1' else 'Z';
D_OE(6) <= in_wb.LFBK;

FDCPE_D7: FDCPE port map (D_I(7),D(7),clk,RST,'0');
D(7) <= ((D(7).PIN AND bus_ld_t1.LFBK)
	OR (bus_ld_t2 AND A(7).PIN AND NOT bus_ld_t1.LFBK)
	OR (NOT bus_ld_t2 AND NOT bus_ld_t1.LFBK AND bus_reg(7).LFBK));
D(7) <= D_I(7) when D_OE(7) = '1' else 'Z';
D_OE(7) <= in_wb.LFBK;


OE_n <= NOT (((NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND in_wb)
	OR (NOT IOM AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND A15)));


OEr_n <= NOT ((NOT IOM AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND NOT A15));


READY <= '1';

FTCPE_RESET_IN: FTCPE port map (RESET_IN,RESET_IN_T,CLKOUT,RST,'0');
RESET_IN_T <= (NOT RESET_IN_OBUF.LFBK AND u_reset_cpu/tt(0).LFBK AND 
	u_reset_cpu/tt(1).LFBK);

FDCPE_RST75: FDCPE port map (RST75,RST75_D,clk,'0','0');
RST75_D <= (tmr_cnt(8) AND tmr_cnt(2) AND tmr_cnt(3) AND 
	tmr_cnt(9) AND $OpTx$FX_DC$12289.LFBK AND tmr_cnt(4).LFBK AND 
	tmr_cnt(5).LFBK AND tmr_cnt(6).LFBK AND tmr_cnt(7).LFBK);


SID <= RX;

FTCPE_SND: FTCPE port map (SND,SND_T,clk,RST,'0');
SND_T <= ((addr_latch(0) AND NOT addr_latch(1) AND NOT addr_latch(2) AND 
	io_wr AND A(4).PIN AND NOT snd_q.LFBK)
	OR (addr_latch(0) AND NOT addr_latch(1) AND NOT addr_latch(2) AND 
	io_wr AND NOT A(4).PIN AND snd_q.LFBK));

FDCPE_TX: FDCPE port map (TX,TX_D,clk,'0',RST);
TX_D <= ((shreg(1) AND baud_tick AND NOT io_wr_tx)
	OR (NOT baud_tick AND NOT io_wr_tx AND shreg(0).LFBK));


WE_n <= ((NOT state_FSM_FFd3)
	OR (NOT state_FSM_FFd2 AND state_FSM_FFd1));

FTCPE_X1: FTCPE port map (X1,t0_q,clk,'0','0');

FTCPE_X2: FTCPE port map (X2,t0_q,clk,'0','0');

FTCPE_addr_latch0: FTCPE port map (addr_latch(0),addr_latch_T(0),clk,RST,'0');
addr_latch_T(0) <= ((NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND ALE AND 
	A(0).PIN AND state_FSM_FFd1.LFBK AND NOT addr_latch(0).LFBK)
	OR (NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND ALE AND 
	NOT A(0).PIN AND state_FSM_FFd1.LFBK AND addr_latch(0).LFBK));

FTCPE_addr_latch1: FTCPE port map (addr_latch(1),addr_latch_T(1),clk,RST,'0');
addr_latch_T(1) <= ((NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND ALE AND 
	A(1).PIN AND state_FSM_FFd1.LFBK AND NOT addr_latch(1).LFBK)
	OR (NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND ALE AND 
	NOT A(1).PIN AND state_FSM_FFd1.LFBK AND addr_latch(1).LFBK));

FTCPE_addr_latch2: FTCPE port map (addr_latch(2),addr_latch_T(2),clk,RST,'0');
addr_latch_T(2) <= ((NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND ALE AND 
	A(2).PIN AND state_FSM_FFd1.LFBK AND NOT addr_latch(2).LFBK)
	OR (NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND ALE AND 
	NOT A(2).PIN AND state_FSM_FFd1.LFBK AND addr_latch(2).LFBK));

FTCPE_addr_latch3: FTCPE port map (addr_latch(3),addr_latch_T(3),clk,RST,'0');
addr_latch_T(3) <= ((NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND ALE AND 
	A(3).PIN AND state_FSM_FFd1.LFBK AND NOT addr_latch(3).LFBK)
	OR (NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND ALE AND 
	NOT A(3).PIN AND state_FSM_FFd1.LFBK AND addr_latch(3).LFBK));

FTCPE_addr_latch4: FTCPE port map (addr_latch(4),addr_latch_T(4),clk,RST,'0');
addr_latch_T(4) <= ((NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND ALE AND 
	A(4).PIN AND state_FSM_FFd1.LFBK AND NOT addr_latch(4).LFBK)
	OR (NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND ALE AND 
	NOT A(4).PIN AND state_FSM_FFd1.LFBK AND addr_latch(4).LFBK));

FTCPE_addr_latch5: FTCPE port map (addr_latch(5),addr_latch_T(5),clk,RST,'0');
addr_latch_T(5) <= ((NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND ALE AND 
	A(5).PIN AND state_FSM_FFd1.LFBK AND NOT addr_latch(5).LFBK)
	OR (NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND ALE AND 
	NOT A(5).PIN AND state_FSM_FFd1.LFBK AND addr_latch(5).LFBK));

FTCPE_addr_latch6: FTCPE port map (addr_latch(6),addr_latch_T(6),clk,RST,'0');
addr_latch_T(6) <= ((state_FSM_FFd1 AND ALE AND A(6).PIN AND 
	NOT state_FSM_FFd2.LFBK AND NOT state_FSM_FFd3.LFBK AND NOT addr_latch(6).LFBK)
	OR (state_FSM_FFd1 AND ALE AND NOT A(6).PIN AND 
	NOT state_FSM_FFd2.LFBK AND NOT state_FSM_FFd3.LFBK AND addr_latch(6).LFBK));

FTCPE_addr_latch7: FTCPE port map (addr_latch(7),addr_latch_T(7),clk,RST,'0');
addr_latch_T(7) <= ((state_FSM_FFd1 AND ALE AND A(7).PIN AND 
	NOT state_FSM_FFd2.LFBK AND NOT state_FSM_FFd3.LFBK AND NOT addr_latch(7).LFBK)
	OR (state_FSM_FFd1 AND ALE AND NOT A(7).PIN AND 
	NOT state_FSM_FFd2.LFBK AND NOT state_FSM_FFd3.LFBK AND addr_latch(7).LFBK));

FDCPE_baud_cnt0: FDCPE port map (baud_cnt(0),baud_cnt_D(0),clk,RST,'0');
baud_cnt_D(0) <= (NOT io_wr_tx.LFBK AND NOT baud_tick AND NOT baud_cnt(0).LFBK);

FDCPE_baud_cnt1: FDCPE port map (baud_cnt(1),baud_cnt_D(1),clk,RST,'0');
baud_cnt_D(1) <= ((baud_cnt(0) AND NOT baud_tick AND NOT io_wr_tx AND 
	NOT baud_cnt(1).LFBK)
	OR (NOT baud_cnt(0) AND NOT baud_tick AND NOT io_wr_tx AND 
	baud_cnt(1).LFBK));

FDCPE_baud_cnt2: FDCPE port map (baud_cnt(2),baud_cnt_D(2),clk,RST,'0');
baud_cnt_D(2) <= ((NOT baud_cnt(0) AND NOT baud_tick AND NOT io_wr_tx AND 
	baud_cnt(2).LFBK)
	OR (NOT baud_cnt(1) AND NOT baud_tick AND NOT io_wr_tx AND 
	baud_cnt(2).LFBK)
	OR (baud_cnt(0) AND baud_cnt(1) AND NOT baud_tick AND 
	NOT io_wr_tx AND NOT baud_cnt(2).LFBK));

FTCPE_baud_cnt3: FTCPE port map (baud_cnt(3),baud_cnt_T(3),clk,RST,'0');
baud_cnt_T(3) <= ((baud_tick AND baud_cnt(3).LFBK)
	OR (io_wr_tx AND baud_cnt(3).LFBK)
	OR (baud_cnt(0) AND baud_cnt(1) AND NOT baud_tick AND 
	NOT io_wr_tx AND baud_cnt(2).LFBK));

FTCPE_baud_cnt4: FTCPE port map (baud_cnt(4),baud_cnt_T(4),clk,RST,'0');
baud_cnt_T(4) <= ((baud_tick AND baud_cnt(4).LFBK)
	OR (io_wr_tx AND baud_cnt(4).LFBK)
	OR (baud_cnt(0) AND baud_cnt(1) AND NOT baud_tick AND 
	NOT io_wr_tx AND baud_cnt(2).LFBK AND baud_cnt(3).LFBK));

FDCPE_bit_cnt0: FDCPE port map (bit_cnt(0),bit_cnt_D(0),clk,RST,'0');
bit_cnt_D(0) <= ((baud_tick AND bit_cnt(0).LFBK)
	OR (NOT io_wr_tx.LFBK AND NOT baud_tick AND NOT bit_cnt(0).LFBK)
	OR (baud_tick AND bit_cnt(1).LFBK AND NOT bit_cnt(2).LFBK AND 
	bit_cnt(3).LFBK)
	OR (NOT io_wr_tx.LFBK AND baud_tick AND NOT bit_cnt(1).LFBK AND 
	NOT bit_cnt(2).LFBK AND NOT bit_cnt(3).LFBK));

FTCPE_bit_cnt1: FTCPE port map (bit_cnt(1),bit_cnt_T(1),clk,RST,'0');
bit_cnt_T(1) <= ((baud_tick AND bit_cnt(0).LFBK)
	OR (io_wr_tx.LFBK AND NOT baud_tick AND bit_cnt(1).LFBK)
	OR (baud_tick AND bit_cnt(1).LFBK AND NOT bit_cnt(2).LFBK AND 
	bit_cnt(3).LFBK));

FTCPE_bit_cnt2: FTCPE port map (bit_cnt(2),bit_cnt_T(2),clk,RST,'0');
bit_cnt_T(2) <= ((io_wr_tx.LFBK AND NOT baud_tick AND bit_cnt(2).LFBK)
	OR (baud_tick AND bit_cnt(0).LFBK AND bit_cnt(1).LFBK));

FTCPE_bit_cnt3: FTCPE port map (bit_cnt(3),bit_cnt_T(3),clk,RST,'0');
bit_cnt_T(3) <= ((io_wr_tx.LFBK AND NOT baud_tick AND bit_cnt(3).LFBK)
	OR (baud_tick AND bit_cnt(0).LFBK AND bit_cnt(1).LFBK AND 
	bit_cnt(2).LFBK)
	OR (baud_tick AND NOT bit_cnt(0).LFBK AND bit_cnt(1).LFBK AND 
	NOT bit_cnt(2).LFBK AND bit_cnt(3).LFBK));


bus_ld_t1 <= (NOT RDn AND NOT IOM AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	state_FSM_FFd1);


bus_ld_t2 <= (state_FSM_FFd1 AND NOT WRn AND state_FSM_FFd2.LFBK AND 
	NOT state_FSM_FFd3.LFBK);

FDCPE_col0: FDCPE port map (col0,col0_D,clk,'0','0');
col0_D <= ((A(4).PIN AND kbcol_wr06)
	OR (NOT kbcol_wr06 AND kbcol_q(0).LFBK));

FDCPE_col1: FDCPE port map (col1,col1_D,clk,'0','0');
col1_D <= ((A(5).PIN AND kbcol_wr06)
	OR (NOT kbcol_wr06 AND kbcol_q(1).LFBK));

FDCPE_col2: FDCPE port map (col2,col2_D,clk,'0','0');
col2_D <= ((A(6).PIN AND kbcol_wr06)
	OR (NOT kbcol_wr06 AND kbcol_q(2).LFBK));

FDCPE_col3: FDCPE port map (col3,col3_D,clk,'0','0');
col3_D <= ((A(7).PIN AND kbcol_wr06)
	OR (NOT kbcol_wr06 AND kbcol_q(3).LFBK));

FTCPE_dig0: FTCPE port map (dig(0),dig_T(0),clk,RST,'0');
dig_T(0) <= ((addr_latch(0) AND NOT addr_latch(1) AND NOT addr_latch(2) AND 
	io_wr.LFBK AND A(0).PIN AND dig_0_OBUF.LFBK)
	OR (addr_latch(0) AND NOT addr_latch(1) AND NOT addr_latch(2) AND 
	io_wr.LFBK AND NOT A(0).PIN AND NOT dig_0_OBUF.LFBK));

FTCPE_dig1: FTCPE port map (dig(1),dig_T(1),clk,RST,'0');
dig_T(1) <= ((io_wr AND A(1).PIN AND addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND dig_1_OBUF.LFBK)
	OR (io_wr AND NOT A(1).PIN AND addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND NOT dig_1_OBUF.LFBK));

FTCPE_dig2: FTCPE port map (dig(2),dig_T(2),clk,RST,'0');
dig_T(2) <= ((io_wr AND A(2).PIN AND addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND dig_2_OBUF.LFBK)
	OR (io_wr AND NOT A(2).PIN AND addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND NOT dig_2_OBUF.LFBK));

FTCPE_dig3: FTCPE port map (dig(3),dig_T(3),clk,RST,'0');
dig_T(3) <= ((io_wr AND A(3).PIN AND addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND dig_3_OBUF.LFBK)
	OR (io_wr AND NOT A(3).PIN AND addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND NOT dig_3_OBUF.LFBK));


fsm_rddone <= (RDn AND rd_seen);


fsm_wrdone <= (wr_seen AND WRn);


in_wb <= ((state_FSM_FFd3)
	OR (state_FSM_FFd2 AND NOT state_FSM_FFd1));


io_rd_kb/io_rd_kb_D2 <= (IOM AND addr_latch(0) AND addr_latch(1) AND 
	NOT addr_latch(2));


io_wr <= (IOM AND NOT WRn AND FC_1_.OUT);


io_wr_tx <= (NOT addr_latch(0) AND NOT addr_latch(1) AND addr_latch(2) AND 
	io_wr.LFBK AND NOT bit_cnt(0).LFBK AND NOT bit_cnt(1).LFBK AND 
	NOT bit_cnt(2).LFBK AND NOT bit_cnt(3).LFBK AND RESET_IN.PIN);


kbcol_wr06 <= (NOT addr_latch(0) AND addr_latch(1) AND addr_latch(2) AND 
	io_wr.LFBK);


rd_drive <= (NOT RDn AND state_FSM_FFd1 AND NOT ALE AND 
	state_FSM_FFd2.LFBK AND NOT state_FSM_FFd3.LFBK AND rd_seen.LFBK);

FTCPE_rd_seen: FTCPE port map (rd_seen,rd_seen_T,clk,RST,'0');
rd_seen_T <= ((NOT RDn AND state_FSM_FFd1 AND fsm_wrdone AND 
	state_FSM_FFd2.LFBK AND NOT state_FSM_FFd3.LFBK AND NOT rd_seen.LFBK)
	OR (state_FSM_FFd1 AND ALE AND NOT fsm_wrdone AND 
	state_FSM_FFd2.LFBK AND NOT state_FSM_FFd3.LFBK AND rd_seen.LFBK)
	OR (state_FSM_FFd1 AND NOT fsm_wrdone AND fsm_rddone AND 
	state_FSM_FFd2.LFBK AND NOT state_FSM_FFd3.LFBK AND rd_seen.LFBK)
	OR (NOT RDn AND state_FSM_FFd1 AND NOT ALE AND NOT fsm_rddone AND 
	state_FSM_FFd2.LFBK AND NOT state_FSM_FFd3.LFBK AND NOT rd_seen.LFBK));

FTCPE_seg0: FTCPE port map (seg(0),seg_T(0),clk,'0',RST);
seg_T(0) <= ((A(0).PIN AND FC_2_.OUT AND seg_0_OBUF.LFBK)
	OR (NOT A(0).PIN AND FC_2_.OUT AND NOT seg_0_OBUF.LFBK));

FTCPE_seg1: FTCPE port map (seg(1),seg_T(1),clk,'0',RST);
seg_T(1) <= ((io_wr AND A(1).PIN AND NOT addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND seg_1_OBUF.LFBK)
	OR (io_wr AND NOT A(1).PIN AND NOT addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND NOT seg_1_OBUF.LFBK));

FTCPE_seg2: FTCPE port map (seg(2),seg_T(2),clk,'0',RST);
seg_T(2) <= ((io_wr AND A(2).PIN AND NOT addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND seg_2_OBUF.LFBK)
	OR (io_wr AND NOT A(2).PIN AND NOT addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND NOT seg_2_OBUF.LFBK));

FTCPE_seg3: FTCPE port map (seg(3),seg_T(3),clk,'0',RST);
seg_T(3) <= ((io_wr AND A(3).PIN AND NOT addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND seg_3_OBUF.LFBK)
	OR (io_wr AND NOT A(3).PIN AND NOT addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND NOT seg_3_OBUF.LFBK));

FTCPE_seg4: FTCPE port map (seg(4),seg_T(4),clk,'0',RST);
seg_T(4) <= ((io_wr AND A(4).PIN AND NOT addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND seg_4_OBUF.LFBK)
	OR (io_wr AND NOT A(4).PIN AND NOT addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND NOT seg_4_OBUF.LFBK));

FTCPE_seg5: FTCPE port map (seg(5),seg_T(5),clk,'0',RST);
seg_T(5) <= ((io_wr AND A(5).PIN AND NOT addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND seg_5_OBUF.LFBK)
	OR (io_wr AND NOT A(5).PIN AND NOT addr_latch(0).LFBK AND 
	NOT addr_latch(1).LFBK AND NOT addr_latch(2).LFBK AND NOT seg_5_OBUF.LFBK));

FTCPE_seg6: FTCPE port map (seg(6),seg_T(6),clk,RST,'0');
seg_T(6) <= ((NOT addr_latch(0) AND NOT addr_latch(1) AND NOT addr_latch(2) AND 
	io_wr.LFBK AND A(6).PIN AND seg_6_OBUF.LFBK)
	OR (NOT addr_latch(0) AND NOT addr_latch(1) AND NOT addr_latch(2) AND 
	io_wr.LFBK AND NOT A(6).PIN AND NOT seg_6_OBUF.LFBK));


seg(7) <= '1';

FDCPE_shreg1: FDCPE port map (shreg(1),shreg_D(1),clk,'0',RST);
shreg_D(1) <= ((io_wr_tx.LFBK AND A(0).PIN)
	OR (NOT io_wr_tx.LFBK AND baud_tick AND shreg(2).LFBK)
	OR (NOT io_wr_tx.LFBK AND NOT baud_tick AND shreg(1).LFBK));

FDCPE_shreg2: FDCPE port map (shreg(2),shreg_D(2),clk,'0',RST);
shreg_D(2) <= ((io_wr_tx.LFBK AND A(1).PIN)
	OR (shreg(3) AND NOT io_wr_tx.LFBK AND baud_tick)
	OR (NOT io_wr_tx.LFBK AND NOT baud_tick AND shreg(2).LFBK));

FDCPE_shreg3: FDCPE port map (shreg(3),shreg_D(3),clk,'0',RST);
shreg_D(3) <= ((A(2).PIN AND io_wr_tx)
	OR (baud_tick AND NOT io_wr_tx AND shreg(4).LFBK)
	OR (NOT baud_tick AND NOT io_wr_tx AND shreg(3).LFBK));

FDCPE_shreg4: FDCPE port map (shreg(4),shreg_D(4),clk,'0',RST);
shreg_D(4) <= ((A(3).PIN AND io_wr_tx)
	OR (baud_tick AND NOT io_wr_tx AND shreg(5).LFBK)
	OR (NOT baud_tick AND NOT io_wr_tx AND shreg(4).LFBK));

FDCPE_shreg5: FDCPE port map (shreg(5),shreg_D(5),clk,'0',RST);
shreg_D(5) <= ((A(4).PIN AND io_wr_tx)
	OR (baud_tick AND NOT io_wr_tx AND shreg(6).LFBK)
	OR (NOT baud_tick AND NOT io_wr_tx AND shreg(5).LFBK));

FDCPE_shreg6: FDCPE port map (shreg(6),shreg_D(6),clk,'0',RST);
shreg_D(6) <= ((A(5).PIN AND io_wr_tx)
	OR (shreg(7) AND baud_tick AND NOT io_wr_tx)
	OR (NOT baud_tick AND NOT io_wr_tx AND shreg(6).LFBK));

FDCPE_shreg7: FDCPE port map (shreg(7),shreg_D(7),clk,'0',RST);
shreg_D(7) <= ((A(6).PIN AND io_wr_tx)
	OR (baud_tick AND NOT io_wr_tx AND shreg(8).LFBK)
	OR (NOT baud_tick AND NOT io_wr_tx AND shreg(7).LFBK));

FDCPE_shreg8: FDCPE port map (shreg(8),shreg_D(8),clk,'0',RST);
shreg_D(8) <= ((NOT A(7).PIN AND io_wr_tx)
	OR (NOT baud_tick AND NOT io_wr_tx AND NOT shreg(8).LFBK));

FDCPE_state_FSM_FFd1: FDCPE port map (state_FSM_FFd1,state_FSM_FFd1_D,clk,RST,'0');
state_FSM_FFd1_D <= ((NOT state_FSM_FFd2 AND state_FSM_FFd1.LFBK)
	OR (NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND ALE)
	OR (NOT state_FSM_FFd3 AND NOT ALE AND NOT fsm_wrdone AND NOT fsm_rddone AND 
	state_FSM_FFd1.LFBK)
	OR (NOT IOM AND NOT state_FSM_FFd3 AND A15 AND fsm_wrdone AND 
	state_FSM_FFd1.LFBK AND RESET_IN.PIN));

FDCPE_state_FSM_FFd2: FDCPE port map (state_FSM_FFd2,state_FSM_FFd2_D,clk,RST,'0');
state_FSM_FFd2_D <= ((NOT state_FSM_FFd1 AND state_FSM_FFd3.LFBK)
	OR (NOT state_FSM_FFd2.LFBK AND state_FSM_FFd3.LFBK)
	OR (state_FSM_FFd1 AND NOT ALE AND NOT state_FSM_FFd2.LFBK)
	OR (state_FSM_FFd1 AND NOT ALE AND NOT fsm_wrdone AND NOT fsm_rddone AND 
	NOT state_FSM_FFd3.LFBK));

FTCPE_state_FSM_FFd3: FTCPE port map (state_FSM_FFd3,state_FSM_FFd3_T,clk,RST,'0');
state_FSM_FFd3_T <= ((NOT state_FSM_FFd1 AND NOT state_FSM_FFd2.LFBK AND 
	state_FSM_FFd3.LFBK)
	OR (NOT IOM AND state_FSM_FFd1 AND A15 AND fsm_wrdone AND 
	RESET_IN_OBUF.LFBK AND state_FSM_FFd2.LFBK AND NOT state_FSM_FFd3.LFBK));

FTCPE_t0_q: FTCPE port map (t0_q,'1',clk,'0','0');

FTCPE_tmr_cnt0: FTCPE port map (tmr_cnt(0),tmr_cnt_T(0),clk,'0','0');
tmr_cnt_T(0) <= (NOT t0_q AND baud_tick AND NOT x1_q.LFBK);

FTCPE_tmr_cnt1: FTCPE port map (tmr_cnt(1),tmr_cnt_T(1),clk,'0','0');
tmr_cnt_T(1) <= (NOT t0_q AND baud_tick AND NOT x1_q.LFBK AND tmr_cnt(0).LFBK);

FTCPE_tmr_cnt2: FTCPE port map (tmr_cnt(2),$OpTx$FX_DC$12289,clk,'0','0');

FTCPE_tmr_cnt3: FTCPE port map (tmr_cnt(3),FC_0_.OUT,clk,'0','0');

FTCPE_tmr_cnt4: FTCPE port map (tmr_cnt(4),tmr_cnt_T(4),clk,'0','0');
tmr_cnt_T(4) <= (tmr_cnt(2) AND tmr_cnt(3) AND $OpTx$FX_DC$12289.LFBK);

FTCPE_tmr_cnt5: FTCPE port map (tmr_cnt(5),tmr_cnt_T(5),clk,'0','0');
tmr_cnt_T(5) <= (tmr_cnt(2) AND tmr_cnt(3) AND $OpTx$FX_DC$12289.LFBK AND 
	tmr_cnt(4).LFBK);

FTCPE_tmr_cnt6: FTCPE port map (tmr_cnt(6),tmr_cnt_T(6),clk,'0','0');
tmr_cnt_T(6) <= (tmr_cnt(2) AND tmr_cnt(3) AND $OpTx$FX_DC$12289.LFBK AND 
	tmr_cnt(4).LFBK AND tmr_cnt(5).LFBK);

FTCPE_tmr_cnt7: FTCPE port map (tmr_cnt(7),tmr_cnt_T(7),clk,'0','0');
tmr_cnt_T(7) <= (tmr_cnt(2) AND tmr_cnt(3) AND $OpTx$FX_DC$12289.LFBK AND 
	tmr_cnt(4).LFBK AND tmr_cnt(5).LFBK AND tmr_cnt(6).LFBK);

FTCPE_tmr_cnt8: FTCPE port map (tmr_cnt(8),$OpTx$FX_DC$12296,clk,'0','0');

FTCPE_tmr_cnt9: FTCPE port map (tmr_cnt(9),tmr_cnt_T(9),clk,'0','0');
tmr_cnt_T(9) <= (tmr_cnt(8) AND $OpTx$FX_DC$12296);

FTCPE_u_reset_cpu/tt0: FTCPE port map (u_reset_cpu/tt(0),RESET_IN_OBUF.LFBK,CLKOUT,RST,'0');

FTCPE_u_reset_cpu/tt1: FTCPE port map (u_reset_cpu/tt(1),u_reset_cpu/tt_T(1),CLKOUT,RST,'0');
u_reset_cpu/tt_T(1) <= (NOT RESET_IN_OBUF.LFBK AND u_reset_cpu/tt(0).LFBK);

FTCPE_wr_seen: FTCPE port map (wr_seen,wr_seen_T,clk,RST,'0');
wr_seen_T <= ((state_FSM_FFd1 AND fsm_wrdone AND 
	state_FSM_FFd2.LFBK AND NOT state_FSM_FFd3.LFBK AND wr_seen.LFBK)
	OR (state_FSM_FFd1 AND ALE AND NOT fsm_rddone AND 
	state_FSM_FFd2.LFBK AND NOT state_FSM_FFd3.LFBK AND wr_seen.LFBK)
	OR (state_FSM_FFd1 AND NOT ALE AND NOT WRn AND NOT fsm_wrdone AND 
	state_FSM_FFd2.LFBK AND NOT state_FSM_FFd3.LFBK AND NOT wr_seen.LFBK)
	OR (state_FSM_FFd1 AND NOT WRn AND NOT fsm_wrdone AND fsm_rddone AND 
	state_FSM_FFd2.LFBK AND NOT state_FSM_FFd3.LFBK AND NOT wr_seen.LFBK));

Register Legend:
 FDCPE (Q,D,C,CLR,PRE); 
 FTCPE (Q,D,C,CLR,PRE); 
 LDCP  (Q,D,G,CLR,PRE); 

