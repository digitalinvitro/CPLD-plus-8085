    1            ; =====================================================================
    2            ; beta/txuart/v37gen -- fw_diag_sid: ДИАГНОСТИКА RX-ПУТИ (SID) для платы
    3            ; retro_pcld (CPLD v37G01, XC95108). Одно назначение: показать, доходят
    4            ; ли ФРОНТЫ сигнала от терминала до пина CPU.SID.
    5            ;
    6            ;   ЧТО ДЕЛАЕТ: безостановочный опрос RIM (A7 = SID). Каждый ПАДАЮЩИЙ
    7            ;   фронт (1->0, как старт-бит UART) инкрементирует счётчик FALLC,
    8            ;   каждый ВОСХОДЯЩИЙ (0->1, как стоп-бит) - RISEC. Дисплей (динамическая
    9            ;   развёртка самим ЦП, без прерываний, ~70 Гц):
   10            ;       DIG3 DIG2  DIG1 DIG0   (слева направо)
   11            ;       [ FALLC  ] [ RISEC  ]  - два 8-битных счётчика, hex, wrap 00-FF.
   12            ;
   13            ;   КАК ЧИТАТЬ (терминал 4800 8N1, на плате светодиод = просто RESET):
   14            ;     FALL=00 RISE=00 при вводе текста        -> на SID НИЧЕГО не приходит:
   15            ;         линия CH340G.TXD -> P38 -> P73(CPU.SID) мертва. Проверить
   16            ;         провод/пин P38, наличие jed с транзитом SID<=RX в ПЛИС.
   17            ;     FALL=01 RISE=00 (застряло)              -> P38/SDI удерживается в 0
   18            ;         (провод на землю, CH340G не подключён/не в режиме).
   19            ;     FALL и RISE РАСТУТ ВМЕСТЕ при вводе     -> линия ЖИВА (каждый байт =
   20            ;         1 падение + 1 подъём). Если счётчики идут - проблема НЕ в
   21            ;         железе: проверять скорость (4800) и формат.
   22            ;     Хаотичное дёрганье обоих счётчиков без ввода -> вход висит в
   23            ;         воздухе (наводки): тот же вывод - провод до P38 отсутствует.
   24            ;
   25            ;   ВЫХОД - RESET (SW20). После диагностики прошить обратно
   26            ;   fw_monitor_ACdE_tm_xstream_v2_0_3.hex (offset 0000h).
   27            ;
   28            ; ПОРТЫ (v37G01): 00h = сегменты D6-D0 (D0=a..D6=g, 1=горит), 01h =
   29            ; разряды D3-D0 (1=горит), D4 = SND. RAM: PREV=FFE8h, FALLC=FFE9h,
   30            ; RISEC=FFEAh. Прерывания НЕ используются (IE=0 после сброса; RIM
   31            ; работает всегда). CPU 3,125 МГц.
   32            ; Сборка: python3 ../../../tools/asm85.py fw_diag_sid.asm -o
   33            ;         fw_diag_sid.hex -l fw_diag_sid.lst   (кодировка CP1251)
   34            ; =====================================================================
   35            
   36            SEGP    EQU 00h             ; сегменты
   37            DIGP    EQU 01h             ; разряды + SND
   38            
   39            PREV    EQU 0FFE8h          ; предыдущий уровень SID (00h/80h)
   40            FALLC   EQU 0FFE9h          ; счётчик падающих фронтов (wrap 8 бит)
   41            RISEC   EQU 0FFEAh          ; счётчик восходящих фронтов (wrap 8 бит)
   42            
   43  0000: -                ORG 0000h
   44  0000: C3 40 00         JMP START
   45            
   46  0008: -                ORG 0008h
   47  0008: C9               RET                 ; RST 1 - заглушки (IE=0, сюда не попадаем)
   48  0010: -                ORG 0010h
   49  0010: C9               RET
   50  0018: -                ORG 0018h
   51  0018: C9               RET
   52  0020: -                ORG 0020h
   53  0020: C9               RET
   54  0024: -                ORG 0024h
   55  0024: C9               RET                 ; TRAP
   56  0028: -                ORG 0028h
   57  0028: C9               RET
   58  0030: -                ORG 0030h
   59  0030: C9               RET
   60  0038: -                ORG 0038h
   61  0038: C9               RET
   62  003C: -                ORG 003Ch
   63  003C: C9               RET                 ; RST 7.5 - джиффи-вектор, в diag не нужен
   64            
   65            ; ---------------------------------------------------------------------
   66  0040: -                ORG 0040h
   67  0040: 31 E7 FF START:  LXI SP,0FFE7h       ; стек в ОЗУ (1-2 уровня CALL)
   68  0043: AF               XRA A
   69  0044: D3 00            OUT SEGP            ; сегменты blank
   70  0046: D3 01            OUT DIGP            ; разряды off
   71  0048: 32 E9 FF         STA FALLC           ; счётчики = 0
   72  004B: 32 EA FF         STA RISEC
   73  004E: 20               RIM                 ; текущий уровень SID -> PREV
   74  004F: E6 80            ANI 80h             ; (без фантомного фронта на старте)
   75  0051: 32 E8 FF         STA PREV
   76            
   77            ; ---- главный цикл: 4 слота развёртки, в каждом - непрерывный опрос SID
   78  0054: 3A E9 FF MAIN:   LDA FALLC           ; старшая тетрада FALLC -> DIG3 (левый)
   79  0057: CD 83 00         CALL GNIBH
   80  005A: 06 08            MVI B,08h
   81  005C: CD 92 00         CALL SLOT
   82  005F: 3A E9 FF         LDA FALLC           ; младшая тетрада FALLC -> DIG2
   83  0062: CD 87 00         CALL GNIBL
   84  0065: 06 04            MVI B,04h
   85  0067: CD 92 00         CALL SLOT
   86  006A: 3A EA FF         LDA RISEC           ; старшая тетрада RISEC -> DIG1
   87  006D: CD 83 00         CALL GNIBH
   88  0070: 06 02            MVI B,02h
   89  0072: CD 92 00         CALL SLOT
   90  0075: 3A EA FF         LDA RISEC           ; младшая тетрада RISEC -> DIG0 (правый)
   91  0078: CD 87 00         CALL GNIBL
   92  007B: 06 01            MVI B,01h
   93  007D: CD 92 00         CALL SLOT
   94  0080: C3 54 00         JMP MAIN
   95            
   96            ; ---------------------------------------------------------------------
   97            ; GNIBH/GNIBL: A (байт счётчика) -> A = глиф старшей/младшей тетрады.
   98  0083: 0F       GNIBH:  RRC
   99  0084: 0F               RRC
  100  0085: 0F               RRC
  101  0086: 0F               RRC
  102  0087: E6 0F    GNIBL:  ANI 0Fh
  103  0089: 5F               MOV E,A
  104  008A: 16 00            MVI D,00h
  105  008C: 21 C2 00         LXI H,GTBL
  106  008F: 19               DAD D
  107  0090: 7E               MOV A,M
  108  0091: C9               RET
  109            
  110            ; ---------------------------------------------------------------------
  111            ; SLOT: показать глиф (A) на разряде (B) ~3 мс, всю паузу опрашивая SID
  112            ; и считая фронты. Портит A/C/D, B сохраняет.
  113  0092: D3 00    SLOT:   OUT SEGP            ; глиф на сегменты
  114  0094: 78               MOV A,B
  115  0095: D3 01            OUT DIGP            ; один разряд горит
  116  0097: 16 C8            MVI D,0C8h          ; ~200 итераций x ~15-18 мкс ~ 3 мс
  117  0099: 20       SLOT1:  RIM                 ; A7 = SID
  118  009A: E6 80            ANI 80h
  119  009C: 4F               MOV C,A             ; C = текущий уровень (00h/80h)
  120  009D: 3A E8 FF         LDA PREV
  121  00A0: B9               CMP C               ; уровень не менялся?
  122  00A1: CA BD 00         JZ  SLOT2
  123  00A4: 79               MOV A,C
  124  00A5: 32 E8 FF         STA PREV            ; запомнить новый уровень
  125  00A8: B7               ORA A               ; S = текущий уровень
  126  00A9: FA B6 00         JM  SLOTUP          ; 0->1 = восходящий фронт
  127  00AC: 3A E9 FF         LDA FALLC           ; 1->0 = падающий (старт-бит-подобный)
  128  00AF: 3C               INR A
  129  00B0: 32 E9 FF         STA FALLC
  130  00B3: C3 BD 00         JMP SLOT2
  131  00B6: 3A EA FF SLOTUP: LDA RISEC
  132  00B9: 3C               INR A
  133  00BA: 32 EA FF         STA RISEC
  134  00BD: 15       SLOT2:  DCR D
  135  00BE: C2 99 00         JNZ SLOT1
  136  00C1: C9               RET
  137            
  138            ; ---- глифы 7-сегм (как в мониторе v2.0.3: D0=a..D6=g, 1=горит) ----
  139  00C2: 3F       GTBL:   DB 3Fh              ; '0'
  140  00C3: 06               DB 06h              ; '1'
  141  00C4: 5B               DB 5Bh              ; '2'
  142  00C5: 4F               DB 4Fh              ; '3'
  143  00C6: 66               DB 66h              ; '4'
  144  00C7: 6D               DB 6Dh              ; '5'
  145  00C8: 7D               DB 7Dh              ; '6'
  146  00C9: 07               DB 07h              ; '7'
  147  00CA: 7F               DB 7Fh              ; '8'
  148  00CB: 6F               DB 6Fh              ; '9'
  149  00CC: 77               DB 77h              ; 'A'
  150  00CD: 7C               DB 7Ch              ; 'b'
  151  00CE: 39               DB 39h              ; 'C'
  152  00CF: 5E               DB 5Eh              ; 'd'
  153  00D0: 79               DB 79h              ; 'E'
  154  00D1: 71               DB 71h              ; 'F'
