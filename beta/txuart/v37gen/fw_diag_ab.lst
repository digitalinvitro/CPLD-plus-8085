    1            ; =====================================================================
    2            ; beta/txuart/v37gen -- fw_diag_ab: ДИАГНОСТИКА RX v2 = АВТОБОД + ДЕКОД.
    3            ; Плата retro_pcld (CPLD v37G01, XC95108), CPU 8085 @3,125 МГц.
    4            ;
    5            ;   ПРЕДЫСТОРИЯ: fw_diag_sid (v1, счётчики фронтов SID) показал +3/+3
    6            ;   на символ ('1','2','3' при 8N1 = 3 падения + 3 подъёма) - RX-путь
    7            ;   ЖИВ, кадры чистые. Но счёт фронтов НЕ ЗАВИСИТ от скорости: v1 не
    8            ;   различает 4800/9600/7E1. Монитор висит на LLLL при ручном
    9            ;   ':00000001FF'. Гипотезы: (H1) терминал не 4800/8N1 -> мусор/пропуск
   10            ;   молча; (H2) всё декодируется, но выход загрузчика (TICKON) сломан.
   11            ;   v2 различает их за один прогон.
   12            ;
   13            ;   ЧТО ДЕЛАЕТ:
   14            ;   1) Ловит падающий фронт SID (старт-бит), меряет его ШИРИНУ в
   15            ;      единицах ~11,8 мкс (петля 37T: RIM+ORA+JM+INR+JMP) и берёт
   16            ;      минимум по кадрам (d0=0 удваивает ширину - кадр с d0=0
   17            ;      отбрасывается: декодируются только кадры, где W <= MINW).
   18            ;   2) Классифицирует MINW: [6..13]=9600, [14..27]=4800, [28..55]=2400,
   19            ;      [56..110]=1200, прочее - вне диапазона (декод не делается).
   20            ;   3) Декодирует текущий кадр по RXD-схеме монитора (полубит-
   21            ;      подтверждение, 8 выборок LSB-first, проверка стопа) с константой
   22            ;      DLAY(n) = 31T + 14n*T: 9600 -> n=21, 4800 -> n=44, 2400 -> n=90,
   23            ;      1200 -> n=183. Полубит = n/2 через RRC.
   24            ;
   25            ;   ДИСПЛЕЙ (~70 Гц, динамическая развёртка самим ЦП):
   26            ;       DIG3 DIG2 | DIG1 DIG0
   27            ;       [ W=MINW ] [ байт ]   hex; байт: 'EE' = ошибка стоп-бита,
   28            ;       00 (blank) = ещё не декодировано.
   29            ;   ЧТЕНИЕ (измеренная ширина в единицах ~11,8 мкс, минус ~2 ед.
   30            ;   задержки обнаружения от истинных 17,6/8,8/35,2/70,4):
   31            ;       ~15-16 = 4800;  ~7 = 9600;  ~33 = 2400;  ~68 = 1200;
   32            ;       ~3-4 = 19200 (не декодируется - слишком быстро для петли).
   33            ;   ИНТЕРПРЕТАЦИЯ:
   34            ;       W~17 и байт 3A на ':'  -> H2: приём работает, копать выход
   35            ;                                 загрузчика (TICKON/LDDONE).
   36            ;       W~9 и байт 3A          -> H1: терминал реально на 9600.
   37            ;       W~17, байты с битом 7  -> 7 бит данных (7N1/7E1).
   38            ;       W~17, байт EE          -> parity/стоп не 8N1.
   39            ;   ПЕРВЫЙ СИМВОЛ ПОСЛЕ RESET - ':' (у него d0=1, ширина старт-бита
   40            ;   измерится верно; кадры с d0=0 не декодируются по построению).
   41            ;   После смены скорости в терминале - RESET платы.
   42            ;
   43            ;   ПОРТЫ: 00h сегменты D6-D0 (D0=a..D6=g), 01h разряды D3-D0 + D4 SND.
   44            ;   RAM: PREV=FFE8, MINW=FFE9, WGLH=FFEA, WGLL=FFEB, BGLH=FFEC,
   45            ;   BGLL=FFED. SP=FFE7 (глубина <=3 CALL -> FFE1, всё в ОЗУ).
   46            ;   Прерывания не используются (IE=0). Выход - RESET, затем вернуть
   47            ;   fw_monitor_ACdE_tm_xstream_v2_0_3.hex (offset 0000h).
   48            ; =====================================================================
   49            
   50            SEGP    EQU 00h             ; сегменты
   51            DIGP    EQU 01h             ; разряды + SND
   52            
   53            PREV    EQU 0FFE8h          ; предыдущий уровень SID (00h/80h)
   54            MINW    EQU 0FFE9h          ; ширина старт-бита (ед. ~11,8 мкс), FF = не мерили
   55            WGLH    EQU 0FFEAh          ; глиф старшей тетрады W
   56            WGLL    EQU 0FFEBh          ; глиф младшей тетрады W
   57            BGLH    EQU 0FFECh          ; глиф старшей тетрады байта
   58            BGLL    EQU 0FFEDh          ; глиф младшей тетрады байта
   59            
   60  0000: -                ORG 0000h
   61  0000: C3 40 00         JMP START
   62            
   63  0008: -                ORG 0008h
   64  0008: C9               RET
   65  0010: -                ORG 0010h
   66  0010: C9               RET
   67  0018: -                ORG 0018h
   68  0018: C9               RET
   69  0020: -                ORG 0020h
   70  0020: C9               RET
   71  0024: -                ORG 0024h
   72  0024: C9               RET
   73  0028: -                ORG 0028h
   74  0028: C9               RET
   75  0030: -                ORG 0030h
   76  0030: C9               RET
   77  0038: -                ORG 0038h
   78  0038: C9               RET
   79  003C: -                ORG 003Ch
   80  003C: C9               RET
   81            
   82            ; ---------------------------------------------------------------------
   83  0040: -                ORG 0040h
   84  0040: 31 E7 FF START:  LXI SP,0FFE7h
   85  0043: AF               XRA A
   86  0044: D3 00            OUT SEGP            ; сегменты blank
   87  0046: D3 01            OUT DIGP            ; разряды off
   88  0048: 32 EA FF         STA WGLH            ; все глифы = blank (00h)
   89  004B: 32 EB FF         STA WGLL
   90  004E: 32 EC FF         STA BGLH
   91  0051: 32 ED FF         STA BGLL
   92  0054: 3E FF            MVI A,0FFh
   93  0056: 32 E9 FF         STA MINW            ; ширина ещё не измерена
   94  0059: 20               RIM                 ; текущий уровень SID -> PREV
   95  005A: E6 80            ANI 80h
   96  005C: 32 E8 FF         STA PREV
   97            
   98            ; ---- главный цикл: развёртка 4 разрядов, в паузах - опрос SID ----
   99  005F: 3A EA FF MAIN:   LDA WGLH
  100  0062: 06 08            MVI B,08h           ; DIG3
  101  0064: CD 8E 00         CALL SLOT
  102  0067: DA B2 00         JC  MEAS            ; в слоте поймано падение -> измерить
  103  006A: 3A EB FF         LDA WGLL
  104  006D: 06 04            MVI B,04h           ; DIG2
  105  006F: CD 8E 00         CALL SLOT
  106  0072: DA B2 00         JC  MEAS
  107  0075: 3A EC FF         LDA BGLH
  108  0078: 06 02            MVI B,02h           ; DIG1
  109  007A: CD 8E 00         CALL SLOT
  110  007D: DA B2 00         JC  MEAS
  111  0080: 3A ED FF         LDA BGLL
  112  0083: 06 01            MVI B,01h           ; DIG0
  113  0085: CD 8E 00         CALL SLOT
  114  0088: DA B2 00         JC  MEAS
  115  008B: C3 5F 00         JMP MAIN
  116            
  117            ; ---------------------------------------------------------------------
  118            ; SLOT: показать глиф (A) на разряде (B) ~3 мс. Всю паузу опрашивает
  119            ; SID (итерация 39T ~ 12,5 мкс: PREV кэшируется в E, запись в память -
  120            ; только при смене уровня); при ПАДАЮЩЕМ фронте (был 1 -> стал 0)
  121            ; выходит сразу с CY=1. PREV обновляется при смене уровня. Портит
  122            ; A/C/D/E; B сохраняет.
  123  008E: D3 00    SLOT:   OUT SEGP
  124  0090: 78               MOV A,B
  125  0091: D3 01            OUT DIGP
  126  0093: 16 C8            MVI D,0C8h
  127  0095: 3A E8 FF         LDA PREV
  128  0098: 5F               MOV E,A             ; E = кэш PREV на время слота
  129  0099: 20       SLOT1:  RIM                 ; A7 = SID
  130  009A: E6 80            ANI 80h
  131  009C: 4F               MOV C,A             ; C = текущий уровень
  132  009D: 7B               MOV A,E
  133  009E: B9               CMP C               ; уровень сменился?
  134  009F: CA AC 00         JZ  SLOT2           ; нет - продолжить слот
  135  00A2: 79               MOV A,C             ; смена: обновить PREV и кэш
  136  00A3: 32 E8 FF         STA PREV
  137  00A6: 5F               MOV E,A
  138  00A7: DA AC 00         JC  SLOT2           ; CY=1: 00->80, восходящий - игнор
  139  00AA: 37               STC                 ; падающий (1->0) - старт-бит!
  140  00AB: C9               RET
  141  00AC: 15       SLOT2:  DCR D
  142  00AD: C2 99 00         JNZ SLOT1
  143  00B0: AF               XRA A               ; CY = 0 - слот отработал целиком
  144  00B1: C9               RET
  145            
  146            ; ---------------------------------------------------------------------
  147            ; MEAS: ширина низкого уровня (старт-бита), минимум по кадрам,
  148            ; классификация, декод кадра по схеме RXD монитора.
  149  00B2: 0E 00    MEAS:   MVI C,00h
  150  00B4: 20       WLP:    RIM                 ; A7 = SID
  151  00B5: B7               ORA A
  152  00B6: FA C0 00         JM  WDONE           ; линия ушла в 1 - конец низа
  153  00B9: 0C               INR C
  154  00BA: CA 78 01         JZ  WOVF            ; >3 мс низа - не UART (break/наводка)
  155  00BD: C3 B4 00         JMP WLP
  156  00C0: 3E 80    WDONE:  MVI A,80h
  157  00C2: 32 E8 FF         STA PREV            ; текущий уровень = 1
  158  00C5: 3A E9 FF         LDA MINW
  159  00C8: B9               CMP C               ; MINW < C? (CY=1) - кадр шире минимума
  160  00C9: DA 5A 01         JC  MEASX           ; -> фаза сомнительна (d0=0), не декодировать
  161  00CC: 79               MOV A,C
  162  00CD: 32 E9 FF         STA MINW            ; новый минимум
  163  00D0: 47               MOV B,A             ; B = W (GNIB берёт байт в B, сохраняет его)
  164  00D1: CD 62 01         CALL GNIBH
  165  00D4: 32 EA FF         STA WGLH
  166  00D7: CD 6C 01         CALL GNIBL
  167  00DA: 32 EB FF         STA WGLL
  168  00DD: 78               MOV A,B             ; классификация W
  169  00DE: FE 06            CPI 6               ; [2..5] - слишком быстро (19200+)
  170  00E0: DA 5A 01         JC  MEASX
  171  00E3: FE 0E            CPI 14              ; [7..13] - 9600
  172  00E5: DA FA 00         JC  SP9600
  173  00E8: FE 1C            CPI 28              ; [14..27] - 4800
  174  00EA: DA FF 00         JC  SP4800
  175  00ED: FE 38            CPI 56              ; [28..55] - 2400
  176  00EF: DA 04 01         JC  SP2400
  177  00F2: FE 6F            CPI 111             ; [56..110] - 1200
  178  00F4: DA 09 01         JC  SP1200
  179  00F7: C3 5A 01         JMP MEASX           ; медленнее 1200 / мусор - только ширина
  180  00FA: 0E 15    SP9600: MVI C,21
  181  00FC: C3 0B 01         JMP RXD2
  182  00FF: 0E 2C    SP4800: MVI C,44
  183  0101: C3 0B 01         JMP RXD2
  184  0104: 0E 5A    SP2400: MVI C,90
  185  0106: C3 0B 01         JMP RXD2
  186  0109: 0E B7    SP1200: MVI C,183
  187                    ; JMP RXD2
  188            ; ---------------------------------------------------------------------
  189            ; RXD2: декод кадра. Вход: C = полная задержка бита (ед. DLAY: 14T).
  190            ; Ждёт idle-high, затем падение, полубит-подтверждение, 8 выборок
  191            ; LSB-first, стоп-бит. Успех: глифы байта; сбой: глифы 'EE'.
  192  010B: 20       RXD2:   RIM                 ; 1) дождаться idle-high (после WMEAS может
  193  010C: B7               ORA A               ;    быть уже high)
  194  010D: F2 0B 01         JP  RXD2
  195  0110: 06 08            MVI B,08h
  196  0112: 20       RXW2:   RIM                 ; 2) ждать падение (старт-бит)
  197  0113: B7               ORA A
  198  0114: FA 12 01         JM  RXW2
  199  0117: 79               MOV A,C             ; 3) полубит - подтвердить старт
  200  0118: 0F               RRC
  201  0119: E6 7F            ANI 7Fh             ; RRC для нечётных C тянет A0 в A7 - маскировать
  202  011B: 57               MOV D,A
  203  011C: CD 5D 01         CALL DLAY
  204  011F: 20               RIM
  205  0120: B7               ORA A
  206  0121: FA 12 01         JM  RXW2            ; ложный старт
  207  0124: AF               XRA A
  208  0125: 5F               MOV E,A             ; E = накопитель байта
  209  0126: 79               MOV A,C
  210  0127: 57               MOV D,A             ; 4) полный бит - центр D0
  211  0128: CD 5D 01         CALL DLAY
  212  012B: 20       RXL2:   RIM                 ; выборка бита
  213  012C: E6 80            ANI 80h
  214  012E: 1F               RAR                 ; бит -> CY
  215  012F: 7B               MOV A,E
  216  0130: 1F               RAR                 ; вставить сверху (LSB-first)
  217  0131: 5F               MOV E,A
  218  0132: 79               MOV A,C
  219  0133: 57               MOV D,A
  220  0134: CD 5D 01         CALL DLAY
  221  0137: 05               DCR B
  222  0138: C2 2B 01         JNZ RXL2
  223  013B: 20               RIM                 ; 5) центр стоп-бита
  224  013C: E6 80            ANI 80h
  225  013E: CA 52 01         JZ  RXERR
  226  0141: 7B               MOV A,E             ; 6) успех - глифы байта
  227  0142: 47               MOV B,A
  228  0143: CD 62 01         CALL GNIBH
  229  0146: 32 EC FF         STA BGLH
  230  0149: CD 6C 01         CALL GNIBL
  231  014C: 32 ED FF         STA BGLL
  232  014F: C3 5A 01         JMP MEASX
  233  0152: 3E 79    RXERR:  MVI A,79h           ; 'E'
  234  0154: 32 EC FF         STA BGLH
  235  0157: 32 ED FF         STA BGLL
  236  015A: C3 5F 00 MEASX:  JMP MAIN
  237            
  238            ; ---------------------------------------------------------------------
  239            ; DLAY: задержка (31 + 14*n)T = 9,9 + 4,48n мкс. Вход D = n (>=1).
  240  015D: 15       DLAY:   DCR D
  241  015E: C2 5D 01         JNZ DLAY
  242  0161: C9               RET
  243            
  244            ; GNIBH/GNIBL: байт в B -> A = глиф старшей/младшей тетрады.
  245            ; Сохраняет B/C, портит A/D/E/HL.
  246  0162: 78       GNIBH:  MOV A,B
  247  0163: 0F               RRC
  248  0164: 0F               RRC
  249  0165: 0F               RRC
  250  0166: 0F               RRC
  251  0167: E6 0F            ANI 0Fh
  252  0169: C3 6F 01         JMP GNIBC
  253  016C: 78       GNIBL:  MOV A,B
  254  016D: E6 0F            ANI 0Fh
  255  016F: 5F       GNIBC:  MOV E,A
  256  0170: 16 00            MVI D,00h
  257  0172: 21 80 01         LXI H,GTBL
  258  0175: 19               DAD D
  259  0176: 7E               MOV A,M
  260  0177: C9               RET
  261            
  262  0178: 3E 80    WOVF:   MVI A,80h           ; слишком долгий низ - просто возобновить
  263  017A: 32 E8 FF         STA PREV            ; развёртку (PREV уже верен, для порядка)
  264  017D: C3 5A 01         JMP MEASX
  265            
  266  0180: 3F       GTBL:   DB 3Fh              ; '0'
  267  0181: 06               DB 06h              ; '1'
  268  0182: 5B               DB 5Bh              ; '2'
  269  0183: 4F               DB 4Fh              ; '3'
  270  0184: 66               DB 66h              ; '4'
  271  0185: 6D               DB 6Dh              ; '5'
  272  0186: 7D               DB 7Dh              ; '6'
  273  0187: 07               DB 07h              ; '7'
  274  0188: 7F               DB 7Fh              ; '8'
  275  0189: 6F               DB 6Fh              ; '9'
  276  018A: 77               DB 77h              ; 'A'
  277  018B: 7C               DB 7Ch              ; 'b'
  278  018C: 39               DB 39h              ; 'C'
  279  018D: 5E               DB 5Eh              ; 'd'
  280  018E: 79               DB 79h              ; 'E'
  281  018F: 71               DB 71h              ; 'F'
