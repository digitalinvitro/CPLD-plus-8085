    1            ; =====================================================================
    2            ; beta/txuart/rom -- fw_monitor_ACdE_tm_xstream v2.0: монитор для платы
    3            ; retro_pcld (CPLD top_txuart_por6_v37f11, XC95108). ПАРА ЖЁСТКО СВЯЗАНА:
    4            ; RTL v37F-11 <-> fw v2.0. Против v1.2 (пара RTL v2.9) изменилась СУТЬ
    5            ; ТАЙМЕРА и темп CPU:
    6            ;
    7            ;   1. ТАЙМЕР СТАЛ СВОБОДНЫМ (узел «ТАЙМЕР» удалён из RTL v37F ради
    8            ;      МЦ): N-таймера БОЛЬШЕ НЕТ. RST 7.5 стреляет КАЖДЫЙ ТИК 4 мкс
    9            ;      (edge-защёлка), фаза тика tmr_cnt[1:0] читается в IN 03h D6-D5
   10            ;      (0..3, полный цикл 16 мкс). ОСТАНОВИТЬ тик нельзя - только
   11            ;      замаскировать. OUT 06h: A[7:4] = колонки, A[3:0] ИГНОРИРУЮТСЯ.
   12            ;
   13            ;   2. ДИСЦИПЛИНА TMIARM (вместо армирования): прямой сервис тика
   14            ;      НЕВОЗМОЖЕН - ответ на прерывание ~19T + минимальное тело ~60T =
   15            ;      ~80T = 26 мкс >> 4 мкс тика (даже /4 = 16 мкс не хватает).
   16            ;      Поэтому ISR ВСЕГДА выходит ЗАМАСКИРОВАННЫМ (SIM 78h: M7.5=1 +
   17            ;      сброс защёлки), а главный код вызывает ТОЧКИ TMIARM:
   18            ;          TMIARM: MVI A,68h / SIM / NOP / RET
   19            ;      Защёлка RST 7.5 замаскированной НЕ блокирует захват фронтов -
   20            ;      она всегда заряжена (тики идут каждые 4 мкс); снятие маски
   21            ;      стреляет ПЕНДИНГ-фронтом СИНХРОННО на NOP. Замаскированные тики
   22            ;      стоят 0 тактов. Каденция ISR = частота вызовов TMIARM.
   23            ;      Точки TMIARM (полный список, IE обязан быть on):
   24            ;        SCAN (вершина главного цикла), XSL (каждая 8-Б подгруппа
   25            ;        XSEND, ~94 мкс), KRL/MNR1 (спин отпускания клавиш - БЕЗ
   26            ;        пульки KRAW застынет ненулевым и спин станет вечным!),
   27            ;        KST/MNR3 (дебаунс, 1 пулька на DLMS), TKL (тон, 1 на DLMS),
   28            ;        TMON (стартовый: EI + SIM 68h; первый слот придёт из SCAN).
   29            ;      ПОД ЗАПРЕТОМ: любые пульки в B/F/GO (RXD/RAMT требуют тишины -
   30            ;      TMOFF маскирует, пулька сняла бы маску в обход).
   31            ;
   32            ;   3. СЛОТЫ: каждый 6-й вызов ISR = СЛОТ: скан 1 колонки (KSCOL) +
   33            ;      регенерация 1 разряда (REFRESH) + фаза тона в SNDST.0 ведётся
   34            ;      TICKON'ом (см. п.5), счётчик в E (главный цикл написан БЕЗ E).
   35            ;      Каденция слота теперь ПЛАВАЮЩАЯ (зависит от плотности точек
   36            ;      TMIARM): меню/xstream ~0,7 мс, спин клавиши ~0,3 мс, паузы
   37            ;      DLMS ~1-6 мс. Питч тона и частота скана следуют за каденцией.
   38            ;
   39            ;   4. CPU 2,5 -> 3,125 МГц (T=400 -> 320 нс, CLKOUT = X1/2). Все
   40            ;      CPU-временные константы пересчитаны: K_MS 104 -> 130 (~1,0 мс),
   41            ;      RXHB 15 -> 19, RXFB 30 -> 41 (4800: бит = 75T фикс + 41x14T =
   42            ;      649T = 207,7 мкс; PAUSE-итерация = DCR+JNZ = 14T, в v1.2 считали
   43            ;      15T @400 нс). Каденция дисплея/скана NOT CPU-зависима от старого
   44            ;      N-таймера - теперь она зависит от точек TMIARM (см. п.3).
   45            ;
   46            ;   5. ЗВУК (ФИКС v1.2): в v1.2 REFRESH ставил D4 константой на всё
   47            ;      окно тона (ORA A по всему SNDST) - квадрат не образовывался
   48            ;      (слышен был щелчок). v2.0: D4 = БИТ ФАЗЫ SNDST.0; фазу тогглит
   49            ;      САМ TICKON раз в ~1 мс -> квадрат ~500 Гц, НЕ зависящий от
   50            ;      каденции слотов. SNDTOG из слота удалён.
   51            ;
   52            ;   6. ДИСЦИПЛИНА B/F/GO (проще v1.2 - OUT 06h не нужен):
   53            ;        TMOFF: DI + SIM 78h (маски 5.5/6.5/7.5 + СБРОС защёлки RST 7.5).
   54            ;        TMON : DI + SIM 78h + чистка KRAW/DPIDX/SNDST + E=6
   55            ;               + SIM 68h (снята маска 7.5) + EI.
   56            ;      GO (KGO): TMOFF - программа пользователя получает 100% ЦП при
   57            ;      ЗАМАСКИРОВАННОМ 7.5 (тики идут, защёлка заряжается, ЦП не трогают).
   58            ;      Программе, которой нужен тик, достаточно EI + SIM 68h (вектор
   59            ;      003Ch ведёт в ROM-TMISR монитора); при желании - своя ISR.
   60            ;      B (LOADM): RXD чист от джиттера (маски + DI). F (RAMT): стек
   61            ;      статичен, тест 8000h-FFE7h без чужих pushes.
   62            ;
   63            ;   7. ПОРТЫ v37F-11: ЗАПИСЬ 00h = сегменты A[6:0] (dp погашен
   64            ;      навсегда), 01h = разряды A[3:0] + звук A[4], 04h = TXDATA
   65            ;      (однократный строб; запись при busy - байт тихо теряется),
   66            ;      06h = колонки A[7:4]. ЧТЕНИЕ 03h = {TXRDY(D7), tmr_cnt[1:0]
   67            ;      (D6-D5, НОВОЕ), row4..row0 (D4-D0)}. 02h/05h/07h НЕМАПЛЕНЫ;
   68            ;      чтение немапленных = bus_reg (последние шинные данные).
   69            ;
   70            ;   8. XSTREAM (выдача экрана B000h): пейсинг 36,75T/Б сохранён
   71            ;      (11,8 мкс >= 10 мкс байта 1M), пулька TMIARM в шапке каждой
   72            ;      8-Б подгруппы: ISR-вставки только УДЛИНЯЮТ гэпы (ноль отбросов
   73            ;      TX), регенерация/скан идут ВНУТРИ посылки. Кадр ~37 мс
   74            ;      @3,125 МГц с пульками (~27 FPS против ~24 у v1.2). Клиент
   75            ;      xstream_view.ps1 (COM @1000000 8N1) - БЕЗ ИЗМЕНЕНИЙ:
   76            ;      A5 5A [SEQ] + 2000 Б. SEQ в FFFAh (шара с LST).
   77            ;
   78            ; СБОРКА (asm85.py, кодировка CP1251):
   79            ;   python3 ../../../tools/asm85.py fw_monitor_ACdE_tm_xstream_v2_0.asm -o
   80            ;          fw_monitor_ACdE_tm_xstream_v2_0.hex -l fw_monitor_ACdE_tm_xstream_v2_0.lst
   81            ; Прошивка: flash A29040B, offset 0000h (ROM-окно 0000h-7FFFh).
   82            ;
   83            ; КЛАВИАТУРА (как v27): тетрады 0-F + Enter + F1(меню) + F2(показ
   84            ; адреса); меню: A=адрес C=код D=просмотр E=выполнить B=загрузчик
   85            ; Intel HEX (SID 4800) F=RAM-тест. Выход из залипшего режима - RESET.
   86            ;
   87            ; ОЗУ: переменные FFE8h-FFFFh, стек с FFE7h вниз (SP0 = FFE8h).
   88            ; ГЛУБИНА СТЕКА: максимум XSEND (4 push) + TMISR слот (PSW+B/D/H +
   89            ; RST-адрес + KSCOL/REFRESH/SETTLE) ~ 26 Б - как v1.2, в свободном ОЗУ.
   90            ; =====================================================================
   91            
   92            ; ---- порты CPLD v37F-11 (декод по A2-A0, зеркала mod 8) ----
   93            SEGP    EQU 00h             ; сегменты: D0=a..D6=g, D7=dp (погашен навсегда,
   94                                        ; A7 игнорируется); 1 = горит
   95            DIGP    EQU 01h             ; D3-D0 разряды (1 = горит), D4 = SND (прямой бит)
   96            KBCOLP  EQU 06h             ; OUT: A[7:4] = колонки (1 = заведена); A[3:0]
   97                                        ; ИГНОРИРУЮТСЯ - таймер НЕ пишется (п.1)
   98            KBROWP  EQU 03h             ; IN: D7 = TXRDY (1 = готов принять след. байт),
   99                                        ; D6-D5 = tmr_cnt[1:0] фаза тика 0..3 (НОВОЕ),
  100                                        ; D4-D0 ряды (1 = нажата в активной колонке)
  101            TXP     EQU 04h             ; OUT: TXDATA -> сериализатор CPLD (1M 8N1)
  102            ; 02h/05h/07h НЕМАПЛЕНЫ; символы KBCOLP=02h/STP/TMRP/TMN из v1.2 удалены
  103            
  104            ; ---- константы тайминга (CPU 3,125 МГц, T = 320 нс; тик 4 мкс) ----
  105            TQ_MS   EQU 15              ; дебаунс отпускания ~15 мс (DLMS-единиц)
  106            K_MS    EQU 130             ; DLMS-единица ~1,0 мс (130 x 24T x 320 нс)
  107            RXHB    EQU 19              ; полбита 4800 (PAUSE-итераций, ~103 мкс)
  108            RXFB    EQU 41              ; бит приёма 4800 (PAUSE-итераций, ~208 мкс)
  109            ; PAUSE-итерация = DCR D + JNZ = 14T; бит RX = 75T фикс + RXFB x 14T =
  110            ; 649T x 320 нс = 207,7 мкс (идеал 208,3; запас Uart +-10% покрывает)
  111            
  112            ; ---- коды клавиш ----
  113            K_ENT   EQU 10h             ; Enter  (row3/col3, SW16)
  114            K_F1    EQU 11h             ; F1     (row4/col1, SW18) - меню
  115            K_F2    EQU 12h             ; F2     (row4/col2, SW19) - показ адреса
  116            K_NONE  EQU 0FFh            ; пустая позиция матрицы
  117            
  118            ; ---- состояния ----
  119            ST_MENU EQU 00h             ; меню "ACDE" (B = загрузчик, F = RAM-тест)
  120            ST_ADDR EQU 01h             ; ввод адреса
  121            ST_PROG EQU 02h             ; ввод кода (Code)
  122            ST_VIEW EQU 03h             ; просмотр кода
  123            ST_SHOW EQU 04h             ; показ адреса операций (F2)
  124            
  125            ; ---- ОЗУ монитора ----
  126            SP0     EQU 0FFE8h          ; SP монитора
  127            SNDST   EQU 0FFE8h          ; бит0 = фаза тона (тогглит TICKON), бит1 = тон вкл
  128            STATE   EQU 0FFE9h          ; 0=меню, 1=адрес, 2=код, 3=просмотр, 4=показ
  129            ADDRH   EQU 0FFEAh          ; текущий адрес (старший); в загрузчике = адрес записи
  130            ADDRL   EQU 0FFEBh          ; текущий адрес (младший)
  131            ADCNT   EQU 0FFECh          ; тетрады адреса (0..4); в загрузчике = счётчик байт данных
  132            AF3     EQU 0FFEDh          ; тетрады адреса
  133            AF2     EQU 0FFEEh
  134            AF1     EQU 0FFEFh
  135            AF0     EQU 0FFF0h
  136            BDCNT   EQU 0FFF1h          ; введено тетрад байта (0..2)
  137            BF1     EQU 0FFF2h
  138            BF0     EQU 0FFF3h
  139            DPIDX   EQU 0FFF4h          ; фаза регенерации 0..3 = колонка скана (владеет ISR)
  140            DIGIMG  EQU 0FFF5h          ; глифы разрядов DIG0..DIG3
  141            DIGIMG0 EQU 0FFF5h
  142            DIGIMG1 EQU 0FFF6h
  143            DIGIMG2 EQU 0FFF7h
  144            DIGIMG3 EQU 0FFF8h
  145            PREVST  EQU 0FFF9h          ; прежний режим для F2
  146            ; --- парсер Intel HEX (загрузчик B); FFFC-FFFF = шара с KRAW (п.3 v1.2) ---
  147            LST     EQU 0FFFAh          ; состояние: 0=ждём ':' 1=count 2=addr 3=type 4=data 5=chk
  148                                        ;   (шара с XSSEQ - см. п.8; LOADM чистит на входе)
  149            LNIB    EQU 0FFFBh          ; осталось тетрад в текущем байте поля (1..2)
  150            LBPC    EQU 0FFFBh+1        ; осталось байт в текущем поле   = KRAW0
  151            LACC    EQU 0FFFBh+2        ; накопитель тетрад текущего байта = KRAW1
  152            LSUM    EQU 0FFFBh+3        ; сумма байт записи (mod 256)      = KRAW2
  153            LTY     EQU 0FFFBh+4        ; тип последней записи             = KRAW3
  154            ; --- сырой образ клавиатуры (пишет ISR, читает главный цикл) ---
  155            KRAW0   EQU 0FFFBh+1        ; ряды колонки 0 (биты 0-4) = LBPC
  156            KRAW1   EQU 0FFFBh+2        ; ряды колонки 1            = LACC
  157            KRAW2   EQU 0FFFBh+3        ; ряды колонки 2            = LSUM
  158            KRAW3   EQU 0FFFBh+4        ; ряды колонки 3            = LTY
  159            
  160            ; --- XSTREAM: экран -> UART (тик кадра = непрерывный поток, п.8) ---
  161            TXPORT  EQU TXP             ; TXDATA (04h) - синоним для xstream-кода
  162            XBUF    EQU 0B000h          ; ЭКРАН 80x25 = 2000 Б (B000h..B7CFh)
  163            XSSEQ   EQU 0FFFAh          ; SEQ кадра mod 256 (ячейка LST - см. п.8)
  164            XSCNT   EQU XBUF+06E4h      ; живой счётчик SEQ в демо-экране (строка 22, кол. 4-5)
  165            
  166            ; =====================================================================
  167  0000: -                ORG 0000h
  168  0000: C3 BC 07         JMP START
  169            
  170            ; ---- векторная зона: глушилки EI;RET -------------------------------
  171            ; RST 1..7, TRAP (0024h), RST 5.5/6.5. EI обязателен в каждой (снимает
  172            ; блокировку после приёма). На плате: TRAP = PGND (держатель '0'),
  173            ; 5.5/6.5 железно=0 и вдобавок замаскированы SIM - заглушки защитные.
  174            ; RST 7.5 (003Ch) = СВОБОДНЫЙ ТИК 4 мкс (п.1) - НЕ заглушка, обработчик
  175            ; ниже; под TMOFF маскируется, каденцию задаёт владелец точек TMIARM.
  176  0008: -                ORG 0008h           ; RST 1
  177  0008: FB               EI
  178  0009: C9               RET
  179  0010: -                ORG 0010h           ; RST 2
  180  0010: FB               EI
  181  0011: C9               RET
  182  0018: -                ORG 0018h           ; RST 3
  183  0018: FB               EI
  184  0019: C9               RET
  185  0020: -                ORG 0020h           ; RST 4
  186  0020: FB               EI
  187  0021: C9               RET
  188  0024: -                ORG 0024h           ; TRAP - защитная заглушка (пин PGND)
  189  0024: FB               EI
  190  0025: C9               RET
  191  0028: -                ORG 0028h           ; RST 5
  192  0028: FB               EI
  193  0029: C9               RET
  194  002C: -                ORG 002Ch           ; RST 5.5
  195  002C: FB               EI
  196  002D: C9               RET
  197  0030: -                ORG 0030h           ; RST 6
  198  0030: FB               EI
  199  0031: C9               RET
  200  0034: -                ORG 0034h           ; RST 6.5
  201  0034: FB               EI
  202  0035: C9               RET
  203  0038: -                ORG 0038h           ; RST 7
  204  0038: FB               EI
  205  0039: C9               RET
  206  003C: -                ORG 003Ch           ; RST 7.5 = свободный тик 4 мкс (п.1, п.2)
  207  003C: C3 22 01         JMP TMISR
  208            
  209            ; =====================================================================
  210            ; Таблицы (ORG 0044h - векторная зона выше освобождена)
  211            ; =====================================================================
  212  0044: -                ORG 0044h
  213            ; ---- глифы '0'..'F' (a,b,c,d,e,f,g = D0..D6) ----
  214  0044: 3F       GTBL:   DB 3Fh              ; '0'
  215  0045: 06               DB 06h              ; '1'
  216  0046: 5B               DB 5Bh              ; '2'
  217  0047: 4F               DB 4Fh              ; '3'
  218  0048: 66               DB 66h              ; '4'
  219  0049: 6D               DB 6Dh              ; '5'
  220  004A: 7D               DB 7Dh              ; '6'
  221  004B: 07               DB 07h              ; '7'
  222  004C: 7F               DB 7Fh              ; '8'
  223  004D: 6F               DB 6Fh              ; '9'
  224  004E: 77               DB 77h              ; 'A'
  225  004F: 7C               DB 7Ch              ; 'b'
  226  0050: 39               DB 39h              ; 'C'
  227  0051: 5E               DB 5Eh              ; 'd'
  228  0052: 79               DB 79h              ; 'E'
  229  0053: 71               DB 71h              ; 'F'
  230            
  231            ; ---- биты разрядов/колонок (индекс = DPIDX: 0=DIG0 правый ... 3=DIG3 левый) ----
  232  0054: 01 02 04 08 BITTBL: DB 01h,02h,04h,08h
  233            
  234            ; ---- КАРТА КЛАВИШ: KEYTBL[row*4+col] ----
  235  0058: 0A 0B 0C 0D KEYTBL: DB 0Ah,0Bh,0Ch,0Dh  ; row0: A  B  C  D
  236  005C: 07 08 09 0E         DB 07h,08h,09h,0Eh  ; row1: 7  8  9  E
  237  0060: 04 05 06 0F         DB 04h,05h,06h,0Fh  ; row2: 4  5  6  F
  238  0064: 01 02 03 10         DB 01h,02h,03h,10h  ; row3: 1  2  3  Enter
  239  0068: 00 11 12 FF         DB 00h,11h,12h,0FFh ; row4: 0  F1 F2 (нет)
  240            
  241            ; ---- баннер TX @1M (на терминале 4800 = короткая мусорная строка) ----
  242  006C: 41 43 44 45 2D 54 4D 0D 0A 00 TXBAN:  DB 'ACDE-TM',0Dh,0Ah,00h
  243            
  244            ; ---- паттерны RAM-теста: значение + глиф для статического дисплея ----
  245  0076: 00 3F    RAMPAT: DB 00h,3Fh          ; 00h -> "0000"
  246  0078: FF 71            DB 0FFh,71h         ; FFh -> "FFFF"
  247  007A: 55 6D            DB 55h,6Dh          ; 55h -> "5555"
  248  007C: AA 77            DB 0AAh,77h         ; AAh -> "AAAA"
  249            
  250            ; =====================================================================
  251            ; СИСТЕМА ТАЙМЕРА v2.0: TMOFF/TMON/TMIARM + TMISR + слоты (п.2, п.3, п.6)
  252            ; =====================================================================
  253  0100: -                ORG 0100h
  254            
  255            ; ---------------------------------------------------------------------
  256            ; TMOFF: ТИШИНА слот-системы. DI + полные маски (SIM 78h = MSE+M7.5
  257            ; +M6.5+M5.5, заодно СБРОС защёлки RST 7.5). Фронты тика продолжают
  258            ; заряжать защёлку, но ЦП не трогают. Вызывается на входе B/F/GO.
  259            ; Портит A. (v1.2 OUT 06h,0 удалён - стопить нечего, п.1.)
  260            ; ---------------------------------------------------------------------
  261  0100: F3       TMOFF:  DI
  262  0101: 3E 78            MVI A,78h           ; MSE=1, M7.5=1 (маска+сброс защёлки), M6.5=1, M5.5=1
  263  0103: 30               SIM
  264  0104: C9               RET
  265            
  266            ; ---------------------------------------------------------------------
  267            ; TMON: ПУСК слот-системы (START, выход из B/F, MONRET). Чистит
  268            ; состояние ISR, заряжает E=6, снимает маску 7.5, EI. Первый слот
  269            ; придёт из ближайшей точки TMIARM (из START - вершина SCAN).
  270            ; ---------------------------------------------------------------------
  271  0105: F3       TMON:   DI
  272  0106: 3E 78            MVI  A, 78h     ; маски + сброс защёлки RST 7.5
  273  0108: 30               SIM
  274  0109: AF               XRA  A
  275  010A: 32 E8 FF         STA  SNDST      ; тон off, фаза 0
  276  010D: 32 F4 FF         STA  DPIDX      ; фаза регенерации / колонка 0
  277  0110: 32 FC FF         STA  KRAW0      ; сырой образ клавиатуры - в ноль
  278  0113: 32 FD FF         STA  KRAW1
  279  0116: 32 FE FF         STA  KRAW2
  280  0119: 32 FF FF         STA  KRAW3
  281  011C: 3E 68            MVI  A, 68h     ; MSE=1, M7.5=0 (7.5 РАЗРЕШЁН), M6.5=1, M5.5=1
  282  011E: 30               SIM
  283  011F: FB               EI
  284  0120: C9               RET
  285            
  286            ; ---------------------------------------------------------------------
  287            ; TMIARM: ТОЧКА СИНХРОННОЙ ПУЛЬКИ (п.2). Снимает маску 7.5 - всегда
  288            ; заряженная защёлка (тики 4 мкс) стреляет СРАЗУ после NOP: ISR
  289            ; отрабатывает здесь же и снова замаскировывает 7.5 (дисциплина).
  290            ; Вызывать ТОЛЬКО при IE=on и в мониторном режиме (под TMOFF ЗАПРЕЩЕНО -
  291            ; пулька сняла бы маску в обход TMOFF, см. п.2). Портит A.
  292            ; ---------------------------------------------------------------------
  293  0121: C9       TMIARM: RET             ; заглушка для старых вызовов CALL TMIARM
  294            
  295            ; ---------------------------------------------------------------------
  296            ; TMISR: RST 7.5 = тик 4 мкс, НО входит ISR только через точки TMIARM
  297            ; (п.2). Счётчик слотов В E; слот = каждый 6-й вызов: скан колонки +
  298            ; регенерация разряда. РЕ-АРМОВ БОЛЬШЕ НЕТ - вместо них МАСКА В КОНЦЕ
  299            ; обеих ветвей (SIM 78h: M7.5=1 + сброс защёлки). Сохраняем PSW всегда
  300            ; (флаги главного цикла), B/D/H - только в слоте; E НЕ сохраняем -
  301            ; главный цикл его не держит.
  302            ; Такты (@3,125 МГц, T=320 нс): быстрый вызов ~80T ~ 26 мкс (бюджет
  303            ; тика 4 мкс НЕ выдерживает - потому и дисциплина TMIARM, п.2); слот
  304            ; ~530T ~ 170 мкс. Каденция = частота точек TMIARM (п.3).
  305            ; ---------------------------------------------------------------------
  306  0122: F5       TMISR:  PUSH PSW
  307  0123: C5               PUSH B
  308  0124: D5               PUSH D
  309  0125: E5               PUSH H
  310  0126: CD 38 01         CALL KSCOL      ; скан 1 колонки (колонка = фаза DPIDX)
  311  0129: CD 66 01         CALL REFRESH    ; регенерация 1 разряда (фаза ++ внутри)
  312  012C: E1               POP  H
  313  012D: D1               POP  D
  314  012E: C1               POP  B
  315  012F: F1               POP  PSW
  316  0130: FB               EI
  317  0131: C9               RET
  318  0132: 3E 78    TMTINY: MVI A,78h           ; 7   маска + сброс защёлки (v1.2: OUT TMRP
  319  0134: 30               SIM                 ; 10  ре-арм - удалён, п.1/п.2)
  320  0135: F1               POP PSW
  321  0136: FB               EI
  322  0137: C9               RET
  323            
  324            ; ---------------------------------------------------------------------
  325            ; KSCOL: скан ОДНОЙ колонки (вызывается из слота). Колонка = текущая
  326            ; фаза регенерации DPIDX - отдельного счётчика нет. Сырой образ рядов
  327            ; (биты 0-4) -> KRAW0..KRAW3[колонка]. Портит A/B/C/D/H/L (в ISR - под
  328            ; PUSH B/D/H). Колонка на выходе погашена. v2.0: записей в 06h две
  329            ; (завести/погасить), A[3:0] = 0 - таймер не пишется (п.1).
  330            ; ---------------------------------------------------------------------
  331  0138: 3A F4 FF KSCOL:  LDA DPIDX           ; колонка = фаза регенерации 0..3
  332  013B: E6 03            ANI 03h
  333  013D: 4F               MOV C,A             ; B = индекс колонки
  334  013E: 06 00            MVI B,0
  335  0140: 21 54 00         LXI H,BITTBL
  336  0143: 09               DAD B               ; HL = BITTBL + колонка
  337  0144: 56               MOV D,M             ; D = бит колонки (01/02/04/08)
  338  0145: 21 FC FF         LXI H,KRAW0
  339  0148: 09               DAD B               ; HL = KRAW0 + колонка (B/C целы)
  340  0149: 7A               MOV A,D
  341  014A: 07               RLC                 ; бит колонки (01/02/04/08) -> старший ниббл
  342  014B: 07               RLC                 ; A[7:4] (RLC x4, переноса нет)
  343  014C: 07               RLC
  344  014D: 07               RLC
  345  014E: D3 06            OUT KBCOLP          ; колонка заведена (A[3:0]=0 - легально, п.1)
  346  0150: CD 5C 01         CALL SETTLE
  347  0153: DB 03            IN KBROWP           ; ряды активной колонки (D6-D5 фаза тика и
  348  0155: E6 1F            ANI 1Fh             ; D7 TXRDY маскируются - как в v1.2 Шаг-2)
  349  0157: 77               MOV M,A             ; KRAW[колонка] = сырой образ рядов
  350  0158: AF               XRA A
  351  0159: D3 06            OUT KBCOLP          ; колонки off (0000); вторая запись легальна -
  352  015B: C9               RET                 ; колонки просто гасятся (в v1.2 тут был +N)
  353            
  354            ; =====================================================================
  355            ; Системные процедуры (перенос из v1.2/monitor27, константы 3,125 МГц)
  356            ; =====================================================================
  357            
  358            ; ---------------------------------------------------------------------
  359            ; SETTLE: пауза ~26 мкс (LXI+3 итерации 24T @320 нс; установка рядов
  360            ; после заведения колонки). Портит A/B/C. H/L НЕ ТРОГАЕТ (нужно KSCOL).
  361            ; ---------------------------------------------------------------------
  362  015C: 01 03 00 SETTLE: LXI B,3
  363  015F: 0B       STL:    DCX B
  364  0160: 78               MOV A,B
  365  0161: B1               ORA C
  366  0162: C2 5F 01         JNZ STL
  367  0165: C9               RET
  368            
  369            ; ---------------------------------------------------------------------
  370            ; REFRESH: один слот регенерации (v27 БЕЗ ИЗМЕНЕНИЙ, кроме тона).
  371            ; ГАШЕНИЕ -> РАЗРЯД -> ГЛИФ. DIGIMG[DPIDX] на разряд DPIDX, фаза ++
  372            ; mod 4. v2.0 ФИКС тона (п.5): D4 = БИТ ФАЗЫ SNDST.0 (в v1.2 D4 горел
  373            ; константой на всё окно - квадрат не образовывался). D/E НЕ ТРОГАЕТ
  374            ; (в ISR критично: D = бит колонки уже погашен, E = счётчик слотов).
  375            ; Портит A/B/C/H/L.
  376            ; ---------------------------------------------------------------------
  377  0166: 3A F4 FF REFRESH: LDA DPIDX
  378  0169: 4F               MOV C,A             ; C = индекс 0..3
  379  016A: 06 00            MVI B,0
  380  016C: 21 54 00         LXI H,BITTBL
  381  016F: 09               DAD B
  382  0170: 46               MOV B,M             ; B = бит разряда (01,02,04,08)
  383  0171: 21 F5 FF         LXI H,DIGIMG        ; HL = DIGIMG + DPIDX (цикл вместо ADD)
  384  0174: 79       RFIL:   MOV A,C
  385  0175: B7               ORA A
  386  0176: CA 7E 01         JZ RFGD
  387  0179: 2C               INR L
  388  017A: 0D               DCR C
  389  017B: C3 74 01         JMP RFIL
  390  017E: 4E       RFGD:   MOV C,M             ; C = глиф разряда
  391  017F: 3A E8 FF         LDA SNDST
  392  0182: E6 02            ANI 02h
  393  0184: CA 93 01         JZ RFN              ; тон не разрешён - D4 = 0
  394  0187: 3A E8 FF         LDA SNDST
  395  018A: E6 01            ANI 01h
  396  018C: CA 93 01         JZ RFN              ; фаза 0 - D4 = 0 (полуволна низа)
  397  018F: 78               MOV A,B
  398  0190: F6 10            ORI 10h
  399  0192: 47               MOV B,A             ; фаза 1 -> D4 = 1 (полуволна верха)
  400  0193: AF       RFN:    XRA A
  401  0194: D3 00            OUT SEGP            ; (1) гашение: старый разряд погас
  402  0196: 78               MOV A,B
  403  0197: D3 01            OUT DIGP            ; (2) разряд переключён (сегменты пусты)
  404  0199: 79               MOV A,C
  405  019A: D3 00            OUT SEGP            ; (3) зажгли глиф нового разряда
  406  019C: 3A F4 FF         LDA DPIDX
  407  019F: 3C               INR A
  408  01A0: E6 03            ANI 03h
  409  01A2: 32 F4 FF         STA DPIDX
  410  01A5: C9               RET
  411            
  412            ; ---------------------------------------------------------------------
  413            ; TICKON: короткий тик подтверждения клавиши ~15 мс (TQ_MS единиц
  414            ; DLMS). v2.0 (п.5): фазу тона SNDST.0 тогглит САМ TICKON раз в ~1 мс
  415            ; -> квадрат ~500 Гц, НЕ зависящий от каденции слотов (в v1.2 фазу
  416            ; тогглил слот ~0,7 мс, но REFRESH ставил D4 константой - тона не было).
  417            ; Пулька TMIARM в итерации: слоты идут - дисплей/скан не замирают.
  418            ; Портит A/B/C/H.
  419            ; ---------------------------------------------------------------------
  420  01A6: 3A E8 FF TICKON: LDA SNDST
  421  01A9: F6 02            ORI 02h             ; тон разрешён
  422  01AB: 32 E8 FF         STA SNDST
  423  01AE: 26 0F            MVI H,TQ_MS         ; 15 мс
  424  01B0: 3A E8 FF TKL:    LDA SNDST
  425  01B3: EE 01            XRI 01h             ; тоггл фазы (квадрат ~500 Гц)
  426  01B5: 32 E8 FF         STA SNDST
  427  01B8: CD 21 01         CALL TMIARM         ; слот на итерацию (дисплей жив под тоном)
  428  01BB: CD 5F 03         CALL DLMS
  429  01BE: 25               DCR H
  430  01BF: C2 B0 01         JNZ TKL
  431  01C2: 3A E8 FF         LDA SNDST
  432  01C5: E6 FD            ANI 0FDh            ; тон off
  433  01C7: 32 E8 FF         STA SNDST
  434  01CA: C9               RET
  435            
  436            ; ---------------------------------------------------------------------
  437            ; GLOOK: A = тетрада 0..F -> A = глиф (GTBL). Портит A/B/C/H/L.
  438            ; ---------------------------------------------------------------------
  439  01CB: 4F       GLOOK:  MOV C,A
  440  01CC: 06 00            MVI B,0
  441  01CE: 21 44 00         LXI H,GTBL
  442  01D1: 09               DAD B
  443  01D2: 7E               MOV A,M
  444  01D3: C9               RET
  445            ; ---------------------------------------------------------------------
  446            ; REDRAW: пересобрать DIGIMG[0..3] по состоянию (как v5/v27).
  447            ;   меню : "ACdE"; адрес: тетрады вдвигаются справа; код "__C3";
  448            ;   просмотр: [ADDR] в правых разрядах; показ(F2): ADDR на 4 разрядах.
  449            ; Портит A/B/C/D/H/L (D - рабочий в RDW/RDV; ISR сохраняет D - безопасно).
  450            ; ---------------------------------------------------------------------
  451  01D4: 3A E9 FF REDRAW: LDA STATE
  452  01D7: B7               ORA A
  453  01D8: CA 79 02         JZ RDM
  454  01DB: FE 01            CPI 01h
  455  01DD: CA 90 02         JZ RDA
  456  01E0: FE 03            CPI 03h
  457  01E2: CA 1B 02         JZ RDV
  458  01E5: FE 04            CPI 04h
  459  01E7: CA 44 02         JZ RDW
  460                    ; ---- ST_PROG ----
  461  01EA: AF               XRA A
  462  01EB: 32 F8 FF         STA DIGIMG3
  463  01EE: 32 F7 FF         STA DIGIMG2
  464  01F1: 32 F6 FF         STA DIGIMG1
  465  01F4: 32 F5 FF         STA DIGIMG0
  466  01F7: 3A F1 FF         LDA BDCNT
  467  01FA: FE 02            CPI 02h
  468  01FC: DA 08 02         JC RDPR0            ; <2 - старшая тетрада пуста
  469  01FF: 3A F2 FF         LDA BF1
  470  0202: CD CB 01         CALL GLOOK
  471  0205: 32 F6 FF         STA DIGIMG1
  472  0208: 3A F1 FF RDPR0:  LDA BDCNT
  473  020B: B7               ORA A
  474  020C: CA E1 02         JZ RDRE             ; 0 - младшая тоже пуста
  475  020F: 3A F3 FF         LDA BF0
  476  0212: CD CB 01         CALL GLOOK
  477  0215: 32 F5 FF         STA DIGIMG0
  478  0218: C3 E1 02         JMP RDRE
  479  021B: 3A EA FF RDV:    LDA ADDRH           ; ---- ST_VIEW: [ADDR] в правых разрядах ----
  480  021E: 67               MOV H,A
  481  021F: 3A EB FF         LDA ADDRL
  482  0222: 6F               MOV L,A             ; HL = ADDR
  483  0223: 7E               MOV A,M             ; A = [ADDR] (HL>=8000h - ОЗУ)
  484  0224: 57               MOV D,A             ; D = байт (GLOOK портит B)
  485  0225: 0F               RRC
  486  0226: 0F               RRC
  487  0227: 0F               RRC
  488  0228: 0F               RRC
  489  0229: E6 0F            ANI 0Fh             ; старшая тетрада
  490  022B: CD CB 01         CALL GLOOK
  491  022E: 32 F6 FF         STA DIGIMG1
  492  0231: 7A               MOV A,D
  493  0232: E6 0F            ANI 0Fh             ; младшая тетрада
  494  0234: CD CB 01         CALL GLOOK
  495  0237: 32 F5 FF         STA DIGIMG0
  496  023A: AF               XRA A
  497  023B: 32 F8 FF         STA DIGIMG3
  498  023E: 32 F7 FF         STA DIGIMG2
  499  0241: C3 E1 02         JMP RDRE
  500  0244: 3A EA FF RDW:    LDA ADDRH           ; ---- ST_SHOW: ADDR на 4 разрядах ----
  501  0247: 57               MOV D,A             ; D = старший байт (GLOOK портит B)
  502  0248: 0F               RRC
  503  0249: 0F               RRC
  504  024A: 0F               RRC
  505  024B: 0F               RRC
  506  024C: E6 0F            ANI 0Fh
  507  024E: CD CB 01         CALL GLOOK
  508  0251: 32 F8 FF         STA DIGIMG3
  509  0254: 7A               MOV A,D
  510  0255: E6 0F            ANI 0Fh
  511  0257: CD CB 01         CALL GLOOK
  512  025A: 32 F7 FF         STA DIGIMG2
  513  025D: 3A EB FF         LDA ADDRL
  514  0260: 57               MOV D,A
  515  0261: 0F               RRC
  516  0262: 0F               RRC
  517  0263: 0F               RRC
  518  0264: 0F               RRC
  519  0265: E6 0F            ANI 0Fh
  520  0267: CD CB 01         CALL GLOOK
  521  026A: 32 F6 FF         STA DIGIMG1
  522  026D: 7A               MOV A,D
  523  026E: E6 0F            ANI 0Fh
  524  0270: CD CB 01         CALL GLOOK
  525  0273: 32 F5 FF         STA DIGIMG0
  526  0276: C3 E1 02         JMP RDRE
  527  0279: 3E 77    RDM:    MVI A,77h           ; 'A'
  528  027B: 32 F8 FF         STA DIGIMG3
  529  027E: 3E 39            MVI A,39h           ; 'C'
  530  0280: 32 F7 FF         STA DIGIMG2
  531  0283: 3E 5E            MVI A,5Eh           ; 'd' (D)
  532  0285: 32 F6 FF         STA DIGIMG1
  533  0288: 3E 79            MVI A,79h           ; 'E'
  534  028A: 32 F5 FF         STA DIGIMG0
  535  028D: C3 E1 02         JMP RDRE
  536  0290: AF       RDA:    XRA A               ; ---- ST_ADDR: последняя тетрада справа ----
  537  0291: 32 F8 FF         STA DIGIMG3
  538  0294: 32 F7 FF         STA DIGIMG2
  539  0297: 32 F6 FF         STA DIGIMG1
  540  029A: 32 F5 FF         STA DIGIMG0
  541  029D: 3A EC FF         LDA ADCNT
  542  02A0: FE 01            CPI 01h
  543  02A2: DA E1 02         JC RDRE             ; 0 тетрад - всё пусто
  544  02A5: 3A F0 FF         LDA AF0
  545  02A8: CD CB 01         CALL GLOOK
  546  02AB: 32 F5 FF         STA DIGIMG0
  547  02AE: 3A EC FF         LDA ADCNT
  548  02B1: FE 02            CPI 02h
  549  02B3: DA E1 02         JC RDRE
  550  02B6: 3A EF FF         LDA AF1
  551  02B9: CD CB 01         CALL GLOOK
  552  02BC: 32 F6 FF         STA DIGIMG1
  553  02BF: 3A EC FF         LDA ADCNT
  554  02C2: FE 03            CPI 03h
  555  02C4: DA E1 02         JC RDRE
  556  02C7: 3A EE FF         LDA AF2
  557  02CA: CD CB 01         CALL GLOOK
  558  02CD: 32 F7 FF         STA DIGIMG2
  559  02D0: 3A EC FF         LDA ADCNT
  560  02D3: FE 04            CPI 04h
  561  02D5: DA E1 02         JC RDRE
  562  02D8: 3A ED FF         LDA AF3
  563  02DB: CD CB 01         CALL GLOOK
  564  02DE: 32 F8 FF         STA DIGIMG3
  565  02E1: C9       RDRE:   RET
  566            
  567            ; =====================================================================
  568            ; UART-канал: передача OUT 04h @1M (TXRDY = IN 03h бит 7, v1.2 Шаг-2),
  569            ; приём RIM/SID @4800 - как v27
  570            ; =====================================================================
  571            
  572            ; ---------------------------------------------------------------------
  573            ; TXBYTE: A = байт -> сериализатор CPLD (1 000 000 8N1). Ожидает TXRDY
  574            ; (запись при busy аппаратно отбрасывается). Используется баннером/строками.
  575            ; ---------------------------------------------------------------------
  576  02E2: F5       TXBYTE: PUSH PSW
  577  02E3: DB 03    TXB1:   IN KBROWP           ; TXRDY = бит 7
  578  02E5: E6 80            ANI 80h             ; tx_idle = ~|bit_cnt: 1 = готов принять байт
  579  02E7: CA E3 02         JZ TXB1
  580  02EA: F1               POP PSW
  581  02EB: D3 04            OUT TXP
  582  02ED: C9               RET
  583            
  584            ; ---------------------------------------------------------------------
  585            ; TXSTR: HL = строка с нулевым завершителем -> TX. Портит A/HL.
  586            ; ---------------------------------------------------------------------
  587  02EE: 7E       TXSTR:  MOV A,M
  588  02EF: B7               ORA A
  589  02F0: C8               RZ
  590  02F1: CD E2 02         CALL TXBYTE
  591  02F4: 23               INX H
  592  02F5: C3 EE 02         JMP TXSTR
  593            
  594            ; ---------------------------------------------------------------------
  595            ; PAUSE: пауза D итераций по 4,5 мкс (DCR+JNZ = 14T @3,125 МГц;
  596            ; в v1.2 считали 15T @400 нс - значение пересчитано, см. EQU).
  597            ; ---------------------------------------------------------------------
  598  02F8: 15       PAUSE:  DCR D
  599  02F9: C2 F8 02         JNZ PAUSE
  600  02FC: C9               RET
  601            
  602            ; ---------------------------------------------------------------------
  603            ; RXD: приём байта SID 4800 8N1 (фрагмент 7 + стоп-бит). Выход:
  604            ; C = байт, CY = 0 ОК / CY = 1 обрыв кадра (стоп-бит = 0). Портит A/B/C/D.
  605            ; Цикл строгий - в режиме B таймер ЗАМАСКИРОВАН (TMOFF: DI + SIM 78h)
  606            ; и пульки TMIARM запрещены - джиттера нет вообще.
  607            ; Константы v2.0: RXHB=19 (полбита ~103 мкс), RXFB=41 (бит ~208 мкс,
  608            ; расчёт в блоке EQU). v1.2: RXHB=15/RXFB=30 @2,5 МГц.
  609            ; ---------------------------------------------------------------------
  610  02FD: 06 08    RXD:    MVI B,08h
  611  02FF: 20       RXW:    RIM                 ; A7 = SID
  612  0300: B7               ORA A
  613  0301: FA FF 02         JM RXW              ; '1' (покой) - ждать старт-бит
  614  0304: 16 13            MVI D,RXHB          ; полбита - в середину старт-бита
  615  0306: CD F8 02         CALL PAUSE
  616  0309: 20               RIM                 ; подтвердить старт-бит
  617  030A: B7               ORA A
  618  030B: FA FF 02         JM RXW              ; '1' - ложный старт, ждать заново
  619  030E: 0E 00            MVI C,00h
  620  0310: 16 29            MVI D,RXFB          ; бит - в середину D0
  621  0312: CD F8 02         CALL PAUSE
  622  0315: 20       RXL:    RIM                 ; A7 = SID - центр очередного бита
  623  0316: E6 80            ANI 80h
  624  0318: 1F               RAR                 ; бит -> CY
  625  0319: 79               MOV A,C
  626  031A: 1F               RAR                 ; вставить сверху (LSB-first)
  627  031B: 4F               MOV C,A
  628  031C: 16 29            MVI D,RXFB
  629  031E: CD F8 02         CALL PAUSE
  630  0321: 05               DCR B
  631  0322: C2 15 03         JNZ RXL
  632                    ; после последней итерации RXL (выборка d7 + бит задержки)
  633                    ; линия = середина стоп-бита
  634  0325: 20               RIM
  635  0326: E6 80            ANI 80h             ; CY = 0 (ANI сбрасывает перенос)
  636  0328: CA 2D 03         JZ RXBAD            ; стоп-бит = 0 - обрыв кадра
  637  032B: B7               ORA A               ; CY = 0
  638  032C: C9               RET                 ; C = байт, CY = 0
  639  032D: 37       RXBAD:  STC
  640  032E: C9               RET                 ; CY = 1
  641            
  642            ; ---------------------------------------------------------------------
  643            ; NIB: A = ASCII-символ -> CY = 1 и A = тетрада 0-F ('0'-'9','A'-'F',
  644            ; 'a'-'f'), иначе CY = 0. Портит A.
  645            ; ---------------------------------------------------------------------
  646  032F: D6 30    NIB:    SUI 30h             ; '0'..'9' -> 0..9
  647  0331: DA 4F 03         JC NIBX             ; < '0'
  648  0334: FE 0A            CPI 0Ah
  649  0336: DA 4D 03         JC NIBOK            ; цифра 0..9
  650  0339: D6 07            SUI 07h             ; 'A'..'F' -> 10..15
  651  033B: FE 10            CPI 10h
  652  033D: D2 43 03         JNC NIB2            ; > 'F' - попробовать строчные a..f
  653  0340: C3 4D 03         JMP NIBOK
  654  0343: D6 20    NIB2:   SUI 20h             ; ('a'-'0')-07h-20h = 10..15
  655  0345: FE 10            CPI 10h
  656  0347: D2 4F 03         JNC NIBX
  657  034A: C3 4D 03         JMP NIBOK
  658  034D: 37       NIBOK:  STC
  659  034E: C9               RET
  660  034F: B7       NIBX:   ORA A               ; CY = 0
  661  0350: C9               RET
  662            
  663            ; ---------------------------------------------------------------------
  664            ; LSTAT: A = глиф -> статический дисплей (все 4 разряда, слот-система
  665            ; стоит). Для режимов загрузчика/RAM-теста, где ISR замаскирован (TMOFF).
  666            ; ---------------------------------------------------------------------
  667  0351: C5       LSTAT:  PUSH B
  668  0352: 47               MOV B,A
  669  0353: AF               XRA A
  670  0354: D3 00            OUT SEGP            ; гашение на время переключения
  671  0356: 3E 01            MVI A,01h
  672  0358: D3 01            OUT DIGP            ; все 4 разряда, SND = 0
  673  035A: 78               MOV A,B
  674  035B: D3 00            OUT SEGP            ; глиф на все разряды
  675  035D: C1               POP B
  676  035E: C9               RET
  677            
  678            ; ---------------------------------------------------------------------
  679            ; DLMS: пауза ~1,02 мс (K_MS=130 итераций 24T @320 нс = 1,002 мс).
  680            ; Портит A/B/C. H/L целы. ВНИМАНИЕ (п.3): внутри DLMS пульки TMIARM
  681            ; нет - на время паузы слоты стоят (один разряд горит ~1 мс, яркость
  682            ; не страдает - скважность 1/4 как всегда; каденция возвращается на
  683            ; следующем TMIARM-вызове).
  684            ; ---------------------------------------------------------------------
  685  035F: 01 82 00 DLMS:   LXI B,K_MS
  686  0362: 0B       DLS1:   DCX B
  687  0363: 78               MOV A,B
  688  0364: B1               ORA C
  689  0365: C2 62 03         JNZ DLS1
  690  0368: C9               RET
  691            
  692            ; ---------------------------------------------------------------------
  693            ; LDSUM: LSUM += B (mod 256). Портит A.
  694            ; ---------------------------------------------------------------------
  695  0369: F5       LDSUM:  PUSH PSW
  696  036A: 3A FE FF         LDA LSUM
  697  036D: 80               ADD B
  698  036E: 32 FE FF         STA LSUM
  699  0371: F1               POP PSW
  700  0372: C9               RET
  701            
  702            ; ---------------------------------------------------------------------
  703            ; LDBEEP: длинный сигнал ~0,3 с (тоггл D4 DIGP вручную: в B/F 7.5
  704            ; замаскирован (TMOFF) - ISR не пишет DIGP, конфликта нет; пульки
  705            ; TMIARM здесь ЗАПРЕЩЕНЫ - см. п.2). Портит A/B/C/D.
  706            ; ---------------------------------------------------------------------
  707  0373: 16 96    LDBEEP: MVI D,150
  708  0375: 3E 1F    LDB1:   MVI A,1Fh           ; SND = 1, разряды on
  709  0377: D3 01            OUT DIGP
  710  0379: CD 5F 03         CALL DLMS
  711  037C: 3E 0F            MVI A,0Fh           ; SND = 0
  712  037E: D3 01            OUT DIGP
  713  0380: CD 5F 03         CALL DLMS
  714  0383: 15               DCR D
  715  0384: C2 75 03         JNZ LDB1
  716  0387: C9               RET
  717            
  718            ; =====================================================================
  719            ; LOADM: Intel HEX загрузчик (клавиша B). Приём SID 4800 8N1.
  720            ; Вход через KLD с TMOFF (7.5 замаскирован, DI) - как v27 по логике
  721            ; парсера. Формат записи: :nnaaaatt[dd...]cc, cc = (-сумма байт) mod 256.
  722            ; Статический дисплей LLLL; адрес каждой записи живёт в ADDRH/L.
  723            ; Запись только в ОЗУ (A15=1): попадание в ROM-окно = ошибка EEEE.
  724            ; Выход: EOF-запись (type 01) -> тик и меню; ошибка -> EEEE + сигнал.
  725            ; Выход из зависшего приёма - RESET (SW20).
  726            ; NOTE: LACC/LNIB/LBPC/LSUM/LTY = клетки FFFB-FFFF; в обычном режиме
  727            ; FFFC-FFFF заняты KRAW (ISR) - в B маски стоят (TMOFF), конфликта нет;
  728            ; TMON на выходе чистит KRAW. XSSEQ/LST = FFFA: на входе LST=0 (=SEQ 0 -
  729            ; клиент логирует рестарт потока), на выходе TMON -> новое SEQ с 0.
  730            ; ---------------------------------------------------------------------
  731  0388: AF       LOADM:  XRA A
  732  0389: 32 FA FF         STA LST             ; ждем ':' (и XSSEQ = 0 - рестарт потока клиента)
  733  038C: 32 FD FF         STA LACC            ; накопитель тетрад тоже с нуля (баг v1.0:
  734                                        ;  сталь ломала первый байт первой записи)
  735  038F: 3E 38            MVI A,38h           ; 'L'
  736  0391: CD 51 03         CALL LSTAT
  737  0394: CD FD 02 LDLP:   CALL RXD            ; C = байт, CY = ошибка кадра
  738  0397: DA C5 04         JC LDERR
  739  039A: 79               MOV A,C
  740  039B: FE 3A            CPI ':'
  741  039D: CA B0 04         JZ LDNEW            ; начало записи
  742  03A0: CD 2F 03         CALL NIB            ; тетрада?
  743  03A3: D2 94 03         JNC LDLP            ; прочее (\r\n и т.п.) - пропустить
  744  03A6: 5F               MOV E,A             ; E = тетрада (7.5 замаскирован - E свободен)
  745  03A7: 3A FD FF         LDA LACC
  746  03AA: 07               RLC
  747  03AB: 07               RLC
  748  03AC: 07               RLC
  749  03AD: 07               RLC                 ; накопитель << 4
  750  03AE: B3               ORA E
  751  03AF: 32 FD FF         STA LACC
  752  03B2: 3A FB FF         LDA LNIB
  753  03B5: 3D               DCR A
  754  03B6: 32 FB FF         STA LNIB
  755  03B9: C2 94 03         JNZ LDLP            ; байт поля ещё не собран
  756                    ; --- байт поля собран - применить по состоянию ---
  757  03BC: 3A FD FF         LDA LACC
  758  03BF: 47               MOV B,A             ; B = байт
  759  03C0: AF               XRA A
  760  03C1: 32 FD FF         STA LACC            ; накопитель очищен к следующему байту
  761  03C4: 3A FA FF         LDA LST
  762  03C7: B7               ORA A
  763  03C8: CA 94 03         JZ LDLP             ; байт вне записи - игнор
  764  03CB: 3D               DCR A
  765  03CC: CA DE 03         JZ LDCNT            ; 1 = count
  766  03CF: 3D               DCR A
  767  03D0: CA F3 03         JZ LDADR            ; 2 = addr
  768  03D3: 3D               DCR A
  769  03D4: CA 2B 04         JZ LDTYP            ; 3 = type
  770  03D7: 3D               DCR A
  771  03D8: CA 5E 04         JZ LDDAT            ; 4 = data
  772  03DB: C3 9A 04         JMP LDCHK           ; 5 = checksum
  773  03DE: 78       LDCNT:  MOV A,B
  774  03DF: 32 EC FF         STA ADCNT           ; сколько байт данных в записи
  775  03E2: CD 69 03         CALL LDSUM
  776  03E5: 3E 02            MVI A,02h           ; поле addr: 4 тетрады = 2 байта
  777  03E7: 32 FA FF         STA LST
  778  03EA: 32 FC FF         STA LBPC
  779  03ED: 32 FB FF         STA LNIB
  780  03F0: C3 94 03         JMP LDLP
  781  03F3: 78       LDADR:  MOV A,B
  782  03F4: 32 FF FF         STA LTY             ; временно: тип ещё не читался
  783  03F7: 3A FC FF         LDA LBPC
  784  03FA: FE 02            CPI 02h
  785  03FC: C2 10 04         JNZ LDAD1
  786  03FF: 3A FF FF         LDA LTY
  787  0402: 32 EA FF         STA ADDRH           ; старший байт адреса (big-endian)
  788  0405: 3E 01            MVI A,01h
  789  0407: 32 FC FF         STA LBPC
  790  040A: CD 69 03         CALL LDSUM
  791  040D: C3 94 03         JMP LDLP
  792  0410: 3A FF FF LDAD1:  LDA LTY
  793  0413: 32 EB FF         STA ADDRL           ; младший байт адреса
  794  0416: CD 69 03         CALL LDSUM
  795  0419: 3E 03            MVI A,03h
  796  041B: 32 FA FF         STA LST             ; type
  797  041E: 3E 01            MVI A,01h
  798  0420: 32 FC FF         STA LBPC
  799  0423: 3E 02            MVI A,02h
  800  0425: 32 FB FF         STA LNIB
  801  0428: C3 94 03         JMP LDLP
  802  042B: 78       LDTYP:  MOV A,B
  803  042C: 32 FF FF         STA LTY
  804  042F: CD 69 03         CALL LDSUM
  805  0432: 3A FF FF         LDA LTY
  806  0435: FE 01            CPI 01h
  807  0437: CA 4D 04         JZ LDTYP1
  808  043A: 3A EC FF         LDA ADCNT           ; type 00: данные
  809  043D: 32 FC FF         STA LBPC
  810  0440: 3E 04            MVI A,04h
  811  0442: 32 FA FF         STA LST
  812  0445: 3E 02            MVI A,02h
  813  0447: 32 FB FF         STA LNIB
  814  044A: C3 94 03         JMP LDLP
  815  044D: AF       LDTYP1: XRA A               ; type 01 (EOF): данных нет
  816  044E: 32 FC FF         STA LBPC
  817  0451: 3E 05            MVI A,05h
  818  0453: 32 FA FF         STA LST
  819  0456: 3E 02            MVI A,02h
  820  0458: 32 FB FF         STA LNIB
  821  045B: C3 94 03         JMP LDLP
  822  045E: 3A EA FF LDDAT:  LDA ADDRH
  823  0461: E6 80            ANI 80h             ; запись разрешена только в ОЗУ
  824  0463: CA C5 04         JZ LDERR            ; ROM-окно - ошибка
  825  0466: 3A EA FF         LDA ADDRH
  826  0469: 67               MOV H,A
  827  046A: 3A EB FF         LDA ADDRL
  828  046D: 6F               MOV L,A
  829  046E: 70               MOV M,B             ; [ADDR] = байт (writeback CPLD)
  830  046F: 23               INX H
  831  0470: 7C               MOV A,H
  832  0471: 32 EA FF         STA ADDRH
  833  0474: 7D               MOV A,L
  834  0475: 32 EB FF         STA ADDRL
  835  0478: CD 69 03         CALL LDSUM
  836  047B: 3A FC FF         LDA LBPC
  837  047E: 3D               DCR A
  838  047F: 32 FC FF         STA LBPC
  839  0482: C2 92 04         JNZ LDDAT2
  840  0485: 3E 05            MVI A,05h           ; данные кончились - ждать checksum
  841  0487: 32 FA FF         STA LST
  842  048A: 3E 02            MVI A,02h
  843  048C: 32 FB FF         STA LNIB
  844  048F: C3 94 03         JMP LDLP
  845  0492: 3E 02    LDDAT2: MVI A,02h
  846  0494: 32 FB FF         STA LNIB
  847  0497: C3 94 03         JMP LDLP
  848  049A: 3A FE FF LDCHK:  LDA LSUM            ; контрольная сумма записи
  849  049D: 80               ADD B               ; сумма всех байт + cc = 0 mod 256?
  850  049E: C2 C5 04         JNZ LDERR
  851  04A1: 3A FF FF         LDA LTY
  852  04A4: FE 01            CPI 01h
  853  04A6: CA C1 04         JZ LDDONE           ; EOF - конец загрузки
  854  04A9: AF               XRA A
  855  04AA: 32 FA FF         STA LST             ; ждем ':' следующей записи
  856  04AD: C3 94 03         JMP LDLP
  857  04B0: 3E 01    LDNEW:  MVI A,01h           ; ':' - новая запись
  858  04B2: 32 FA FF         STA LST
  859  04B5: 3E 02            MVI A,02h
  860  04B7: 32 FB FF         STA LNIB
  861  04BA: AF               XRA A
  862  04BB: 32 FE FF         STA LSUM
  863  04BE: C3 94 03         JMP LDLP
  864  04C1: CD A6 01 LDDONE: CALL TICKON         ; подтверждение успешной загрузки
  865  04C4: C9               RET
  866  04C5: 3E 79    LDERR:  MVI A,79h           ; 'E' -> дисплей EEEE
  867  04C7: CD 51 03         CALL LSTAT
  868  04CA: CD 73 03         CALL LDBEEP         ; длинный сигнал
  869  04CD: C9               RET                 ; в меню (ADDRH/L = адрес сбоя, D = просмотр)
  870            
  871            ; =====================================================================
  872            ; RAMT: RAM-тест 8000h-FFE7h (клавиша F). 4 паттерна 00/FF/55/AA:
  873            ; заполнение + контроль побайтно. Статический дисплей = глиф паттерна
  874            ; ("0000"/"FFFF"/"5555"/"AAAA"). Сбой: ADDRH/L = адрес сбоя, EEEE +
  875            ; длинный сигнал. Успех: короткий тик. Вход через KRAM с TMOFF:
  876            ; 7.5 замаскирован - ISR не толкает стек в диапазон теста, тест
  877            ; КРИСТАЛЬНО чистый. Стек до FFD4h не доходит (RAMT без длинных push).
  878            ; Портит всё (кроме клеток монитора).
  879            ; ---------------------------------------------------------------------
  880  04CE: 21 76 00 RAMT:   LXI H,RAMPAT        ; HL = текущая пара (value+glyph)
  881  04D1: 0E 04            MVI C,04h           ; 4 паттерна
  882  04D3: 7E       RMT0:   MOV A,M             ; A = значение паттерна
  883  04D4: 5F               MOV E,A
  884  04D5: E5               PUSH H              ; указатель пары - на стек (HL уйдёт под заполнение)
  885  04D6: 23               INX H
  886  04D7: 7E               MOV A,M             ; глиф паттерна
  887  04D8: CD 51 03         CALL LSTAT          ; статический дисплей ("0000" и т.д.)
  888  04DB: 7B               MOV A,E
  889  04DC: 21 00 80         LXI H,8000h
  890  04DF: 21 00 80         LXI H,8000h
  891  04E2: 7B       RMF:    MOV A,E             ; <--- ВОССТАНАВЛИВАЕМ ПАТТЕРН ИЗ E НА КАЖДОМ ПРОХОДЕ!
  892  04E3: 77               MOV M,A             ; заполнение
  893  04E4: 23               INX H
  894  04E5: 7C               MOV A,H
  895  04E6: FE FD            CPI 0FDh
  896  04E8: C2 E2 04         JNZ RMF
  897  04EB: 7D               MOV A,L
  898  04EC: FE D8            CPI 0D8h
  899  04EE: C2 E2 04         JNZ RMF
  900  04F1: 21 00 80         LXI H,8000h
  901  04F4: 7E       RMV:    MOV A,M             ; контроль (8000h..FFD7h)
  902  04F5: BB               CMP E
  903  04F6: C2 11 05         JNZ RMBAD
  904  04F9: 23               INX H
  905  04FA: 7C               MOV A,H
  906  04FB: FE FD            CPI 0FDh
  907  04FD: C2 F4 04         JNZ RMV
  908  0500: 7D               MOV A,L
  909  0501: FE D8            CPI 0D8h
  910  0503: C2 F4 04         JNZ RMV
  911  0506: E1               POP H               ; HL = пара паттерна
  912  0507: 23               INX H
  913  0508: 23               INX H               ; следующая пара
  914  0509: 0D               DCR C
  915  050A: C2 D3 04         JNZ RMT0
  916  050D: CD A6 01         CALL TICKON         ; ОК
  917  0510: C9               RET
  918  0511: 22 EB FF RMBAD:  SHLD ADDRL          ; ADDRH/L = адрес сбоя (HL из RMV, до POP!)
  919  0514: E1               POP H               ; снять указатель пары (баланс стека)
  920  0515: 3E 79            MVI A,79h           ; 'E' -> EEEE
  921  0517: CD 51 03         CALL LSTAT
  922  051A: CD 73 03         CALL LDBEEP
  923  051D: C9               RET                 ; в меню; D = просмотр байта по адресу сбоя
