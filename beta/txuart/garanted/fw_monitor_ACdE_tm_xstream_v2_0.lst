  925            ; =====================================================================
  926            ;                    XSTREAM: ЭКРАН -> UART (п.8: непрерывный поток,
  927            ;                    тик кадра = сама скорость канала, регенерация/
  928            ;                    скан ведётся пульками TMIARM внутри посылки)
  929            ; =====================================================================
  930            ; ---------------------------------------------------------------------
  931            ; XSINIT (из START, только холодный старт): демо-экран в B000h,
  932            ; SEQ = 0. Мониторные переменные не трогаются; B000-B7CF -
  933            ; пользовательская область: ЛЮБАЯ программа может рисовать туда
  934            ; свой текст/графику, клиент xstream_view.ps1 покажет окном.
  935            ; ---------------------------------------------------------------------
  936  051E: CD 40 05 XSINIT: CALL XBLANK
  937  0521: 21 A0 07         LXI H,XTBL
  938  0524: 5E       XSI1:   MOV E,M             ; DE = адрес назначения
  939  0525: 23               INX H
  940  0526: 56               MOV D,M
  941  0527: 23               INX H               ; HL -> src_lo
  942  0528: 7A               MOV A,D             ; конец таблицы (dst == 0000)?
  943  0529: B3               ORA E
  944  052A: CA 3B 05         JZ XSI3
  945  052D: 4E               MOV C,M             ; BC = адрес строки (источник)
  946  052E: 23               INX H
  947  052F: 46               MOV B,M
  948  0530: 23               INX H               ; HL -> следующая запись
  949  0531: E5               PUSH H              ; указатель следующей записи -> стек
  950  0532: 60               MOV H,B
  951  0533: 69               MOV L,C
  952  0534: CD 51 05         CALL XCPY           ; ASCIZ [HL] -> [DE], 0 = конец
  953  0537: E1               POP H
  954  0538: C3 24 05         JMP XSI1
  955  053B: AF       XSI3:   XRA A
  956  053C: 32 FA FF         STA XSSEQ
  957  053F: C9               RET
  958            
  959  0540: 21 00 B0 XBLANK: LXI H,XBUF          ; 2000 пробелов
  960  0543: 01 D0 07         LXI B,2000
  961  0546: 3E 20    XB1:    MVI A,20h
  962  0548: 77               MOV M,A
  963  0549: 23               INX H
  964  054A: 0B               DCX B
  965  054B: 78               MOV A,B
  966  054C: B1               ORA C
  967  054D: C2 46 05         JNZ XB1
  968  0550: C9               RET
  969            
  970  0551: 7E       XCPY:   MOV A,M             ; ASCIZ: [HL]->[DE], 0 = конец (A/флаги)
  971  0552: B7               ORA A
  972  0553: C8               RZ
  973  0554: 12               STAX D
  974  0555: 23               INX H
  975  0556: 13               INX D
  976  0557: C3 51 05         JMP XCPY
  977            
  978            ; ---------------------------------------------------------------------
  979            ; XSEND: кадр XSTREAM в UART: A5 5A [SEQ] + 2000 Б из XBUF.
  980            ;   Сохраняет PSW/B/D/H. РАВНОМЕРНЫЙ пейсинг 36,75T/Б без опроса TXRDY:
  981            ;   на 3,125 МГц 36,75T = 11,8 мкс >= 10 мкс байта 1M. ПУЛЬКА TMIARM в
  982            ;   шапке КАЖДОЙ 8-Б подгруппы (~94 мкс): ISR-вставки только УДЛИНЯЮТ
  983            ;   гэпы (мин. 25T соблюдён) - ноль отбросов TX; регенерация/скан идут
  984            ;   ВНУТРИ посылки (каденция слота ~0,7 мс, как у v1.2). E не трогает
  985            ;   (счётчик слотов ISR). Кадр ~37 мс с пульками (~27 FPS; v1.2: ~42).
  986            ; ---------------------------------------------------------------------
  987  055A: F5       XSEND:  PUSH PSW
  988  055B: C5               PUSH B
  989  055C: D5               PUSH D
  990  055D: E5               PUSH H
  991  055E: CD CD 05         CALL XUPDCTR        ; живой счётчик SEQ в демо-экран
  992  0561: 3E A5            MVI A,0A5h
  993  0563: D3 04            OUT TXPORT          ; шапка: равномерный пейсинг 33T (4 NOP)
  994  0565: 00               NOP
  995  0566: 00               NOP
  996  0567: 00               NOP
  997  0568: 00               NOP
  998  0569: 3E 5A            MVI A,05Ah
  999  056B: D3 04            OUT TXPORT
 1000  056D: 00               NOP
 1001  056E: 00               NOP
 1002  056F: 00               NOP
 1003  0570: 00               NOP
 1004  0571: 3A FA FF         LDA XSSEQ
 1005  0574: D3 04            OUT TXPORT
 1006  0576: 00               NOP
 1007  0577: 00               NOP
 1008  0578: 00               NOP
 1009  0579: 00               NOP
 1010  057A: 3C               INR A
 1011  057B: 32 FA FF         STA XSSEQ           ; SEQ++ mod 256
 1012  057E: 21 00 B0         LXI H,XBUF          ; HL = экран
 1013  0581: 06 0A            MVI B,10            ; внешний: 10 групп по 200 Б
 1014  0583: 0E 19    XSOUT:  MVI C,25            ; внутренний: 25 подгрупп по 8 Б
 1015  0585: CD 21 01 XSL:    CALL TMIARM         ; пулька слота на подгруппу (~94 мкс): ISR
 1016  0588: 7E               MOV A,M             ; удлиняет гэп, ноль отбросов TX (п.8)
 1017  0589: D3 04            OUT TXPORT          ; равномерный пейсинг: гэп OUT->OUT >= 25T байта
 1018  058B: 23               INX H
 1019  058C: 00               NOP
 1020  058D: 00               NOP
 1021  058E: 00               NOP
 1022  058F: 7E               MOV A,M
 1023  0590: D3 04            OUT TXPORT
 1024  0592: 23               INX H
 1025  0593: 00               NOP
 1026  0594: 00               NOP
 1027  0595: 00               NOP
 1028  0596: 7E               MOV A,M
 1029  0597: D3 04            OUT TXPORT
 1030  0599: 23               INX H
 1031  059A: 00               NOP
 1032  059B: 00               NOP
