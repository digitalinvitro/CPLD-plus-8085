 1410  0A00: D3 00            OUT SEGP            ; сегменты 0
 1411  0A02: D3 01            OUT DIGP            ; разряды 0, SND 0
 1412  0A04: CD 00 01         CALL TMOFF          ; маски+сброс защёлки (v1.2 OUT 06h,0 удалён -
 1413                                        ; стопить нечего): программа пользователя - 100%
 1414                                        ; ЦП, тики идут в замаскированную защёлку; ей
 1415                                        ; нужен тик - EI + SIM 68h (вектор 003Ch = TMISR)
 1416  0A07: 31 E8 FF         LXI SP,SP0
 1417  0A0A: 21 1C 0A         LXI H,MONRET
 1418  0A0D: E5               PUSH H              ; адрес возврата в монитор
 1419  0A0E: 3A EA FF         LDA ADDRH
 1420  0A11: 67               MOV H,A
 1421  0A12: 3A EB FF         LDA ADDRL
 1422  0A15: 6F               MOV L,A             ; HL = адрес запуска
 1423  0A16: AF               XRA A
 1424  0A17: 47               MOV B,A
 1425  0A18: 4F               MOV C,A
 1426  0A19: 57               MOV D,A
 1427  0A1A: 5F               MOV E,A             ; регистры обнулены
 1428  0A1B: E9               PCHL                ; ушли в программу пользователя
 1429  0A1C: F3       MONRET: DI
 1430  0A1D: 31 E8 FF         LXI SP,SP0
 1431  0A20: CD 05 01         CALL TMON           ; слот-система заново (чистка KRAW/DPIDX/EI)
 1432                    ; ждём отпускания всех клавиш + дебаунс (KRAW живой)
 1433  0A23: CD 21 01 MNR1:   CALL TMIARM         ; критично как KRL: без пульки KRAW застынет
 1434  0A26: 3A FC FF         LDA KRAW0
 1435  0A29: 4F               MOV C,A
 1436  0A2A: 3A FD FF         LDA KRAW1
 1437  0A2D: B1               ORA C
 1438  0A2E: 4F               MOV C,A
 1439  0A2F: 3A FE FF         LDA KRAW2
 1440  0A32: B1               ORA C
 1441  0A33: 4F               MOV C,A
 1442  0A34: 3A FF FF         LDA KRAW3
 1443  0A37: B1               ORA C
 1444  0A38: B7               ORA A
 1445  0A39: C2 23 0A         JNZ MNR1
 1446  0A3C: 26 0F            MVI H,TQ_MS         ; 15 мс дебаунс
 1447  0A3E: CD 21 01 MNR3:   CALL TMIARM         ; слот на итерацию
 1448  0A41: CD 5F 03         CALL DLMS
 1449  0A44: 25               DCR H
 1450  0A45: C2 3E 0A         JNZ MNR3
 1451  0A48: C3 CC 07         JMP MAIN2           ; реинициализация, ADDR сохранён
 1452            
 1453  0A4B: -                END
