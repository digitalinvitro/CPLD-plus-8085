# =====================================================================
# top_txuart_por6_v37G01.ucf - XC95108-15PQ100C, дизайн top_txuart_por6_v37G01.v
# Переход на глобальный асинхронный сброс GSR по пину RST (P1, BUFG=SR)
# и модуль RESET_CPU (3 счетных T-триггера FTCPE).
# =====================================================================

# ---------------------------------------------------------------------
# ТАКТ И ГЛОБАЛЬНЫЙ СБРОС
# ---------------------------------------------------------------------
NET "clk"  LOC = "P29";                 # GCK3, такт логики: 25 МГц (H1 С ШУНТОМ)
NET "RST"  LOC = "P1" | BUFG = SR;      # SW20 -> выделенный пин GSR (активная "1")

# ---------------------------------------------------------------------
# ШИНА i8085 (входы автомата) - активные уровни: ALE=1, WR#/RD#=0, IOM: 1=IO
# ---------------------------------------------------------------------
NET "ALE"  LOC = "P93";   # cpu1 (нога 30)
NET "WRn"  LOC = "P92";   # cpu2 (нога 31), активный 0
NET "RDn"  LOC = "P91";   # cpu3 (нога 32), активный 0
NET "IOM"  LOC = "P88";   # cpu5 (нога 34): 1=IO, 0=память
NET "A15"  LOC = "P97";   # декод памяти: 1=SRAM 8000h-FFFFh, 0=flash 0000h-7FFFh

# ---------------------------------------------------------------------
# МУЛЬТИПЛЕКСИРОВАННАЯ ШИНА AD0-AD7 = сети A0..A7 (bidir, IO-MC)
# ---------------------------------------------------------------------
NET "A<0>" LOC = "P26";
NET "A<1>" LOC = "P21";
NET "A<2>" LOC = "P19";
NET "A<3>" LOC = "P17";
NET "A<4>" LOC = "P15";
NET "A<5>" LOC = "P13";
NET "A<6>" LOC = "P11";
NET "A<7>" LOC = "P9";

# ---------------------------------------------------------------------
# ШИНА ДАННЫХ ПАМЯТИ D0-D7 (bidir, IO-MC)
# ---------------------------------------------------------------------
NET "D<0>" LOC = "P30";
NET "D<1>" LOC = "P32";
NET "D<2>" LOC = "P35";
NET "D<3>" LOC = "P36";
NET "D<4>" LOC = "P34";
NET "D<5>" LOC = "P31";
NET "D<6>" LOC = "P27";
NET "D<7>" LOC = "P22";

# ---------------------------------------------------------------------
# УПРАВЛЕНИЕ ПАМЯТЬЮ (активные 0)
# ---------------------------------------------------------------------
NET "CSr_n" LOC = "P20";  # flash U10 /CE (U10.22): CSr_n = A15 | IOM
NET "OEr_n" LOC = "P16";  # flash U10 /OE (U10.24): OEr_n = CSr_n | wr_phase
NET "CS_n"  LOC = "P25";  # SRAM U4 /CE (U4.22): CS_n = in_wb ? 0 : (!A15 | IOM)
NET "OE_n"  LOC = "P37";  # SRAM U4 /OE (U4.24): OE_n = CS_n | wr_phase
NET "WE_n"  LOC = "P24";  # SRAM U4 /WE (U4.29): только writeback
NET "CS1"   LOC = "P99";  # SRAM U4 CE2 (U4.30), константа '1'

# ---------------------------------------------------------------------
# ПОДДЕРЖКА ПРОЦЕССОРА
# ---------------------------------------------------------------------
NET "X1"        LOC = "P68";  # cpu21 (нога 1): 6,25 МГц -> CPU 3,125 МГц
NET "READY"     LOC = "P87";  # cpu6 (нога 35): константа '1'
NET "RESET_IN"  LOC = "P84";  # cpu7 (нога 36): выход модуля RESET_CPU (активный 0)
NET "RST75"     LOC = "P75";  # cpu15 (U3.7 = CPU RST 7.5): импульс 1 клк на тик 4 мкс

# ---------------------------------------------------------------------
# SOFT-UART ТРАНЗИТЫ + АППАРАТНЫЙ ПЕРЕДАТЧИК TXUART
# ---------------------------------------------------------------------
NET "RX"  LOC = "P38";    # CH340G.TXD -> транзит в SID
NET "TX"  LOC = "P39";    # shreg[0] -> CH340G.RXD (1 000 000 бод 8N1)
NET "SOD" LOC = "P72";    # CPU.SOD - наблюдатель БЕЗ нагрузки
NET "SID" LOC = "P73";    # CPU.SID - ВЫХОД CPLD (транзит RX)

# ---------------------------------------------------------------------
# УЗЕЛ ЧАСЫ / НАБЛЮДАТЕЛИ («мёртвые» пины = Hi-Z входы)
# ---------------------------------------------------------------------
NET "X2"     LOC = "P69";  # cpu20 (нога 2): ВХОД, X2 ОТКРЫТ (Hi-Z)
NET "RSTOUT" LOC = "P70";  # cpu19 (нога 3): CPU RESET OUT
NET "INTAn"  LOC = "P80";  # cpu11 (нога 11)
NET "HLDA"   LOC = "P82";  # cpu9 (нога 38)
NET "CLKOUT" LOC = "P83";  # cpu8 (нога 37): 3,125 МГц (тактирует RESET_CPU)
NET "S0"     LOC = "P94";  # cpu0 (нога 29)
NET "S1"     LOC = "P89";  # cpu4 (нога 33)
NET "AH8"    LOC = "P10";  # цепь A8 (нога 21)
NET "AH9"    LOC = "P12";  # цепь A9 (нога 22)
NET "AH10"   LOC = "P18";  # цепь A10 (нога 23)
NET "AH11"   LOC = "P14";  # цепь A11 (нога 24)
NET "AH12"   LOC = "P4";   # цепь A12 (нога 25)
NET "AH13"   LOC = "P8";   # цепь A13 (нога 26)
NET "AH14"   LOC = "P3";   # цепь A14 (нога 27)

# ---------------------------------------------------------------------
# КЛАВИАТУРА 4x5
# ---------------------------------------------------------------------
NET "col0" LOC = "P44";   # SW1/SW5/SW9/SW13/SW17
NET "col1" LOC = "P43";   # SW2/SW6/SW10/SW14/SW18
NET "col2" LOC = "P42";   # SW3/SW7/SW11/SW15/SW19
NET "col3" LOC = "P41";   # SW4/SW8/SW12/SW16 (SW20 вне матрицы - это RST)
NET "row0" LOC = "P56";   # подтяжка R25, SW1..SW4
NET "row1" LOC = "P55";   # подтяжка R24, SW5..SW8
NET "row2" LOC = "P54";   # подтяжка R23, SW9..SW12
NET "row3" LOC = "P52";   # подтяжка R22, SW13..SW16
NET "row4" LOC = "P51";   # подтяжка R21, SW17..SW19

# ---------------------------------------------------------------------
# ИНДИКАЦИЯ (ОБЩИЙ АНОД: сегменты и разряды - АКТИВНЫЙ 0) И ЗВУК
# ---------------------------------------------------------------------
NET "seg<0>" LOC = "P45";  # сегмент a (LD1.11)
NET "seg<1>" LOC = "P62";  # сегмент b (LD1.7)
NET "seg<2>" LOC = "P61";  # сегмент c (LD1.4)
NET "seg<3>" LOC = "P57";  # сегмент d (LD1.2)
NET "seg<4>" LOC = "P58";  # сегмент e (LD1.1)
NET "seg<5>" LOC = "P66";  # сегмент f (LD1.10)
NET "seg<6>" LOC = "P5";   # сегмент g (LD1.5)
NET "seg<7>" LOC = "P60";  # dp (LD1.3): константа '1' = погас
NET "dig<0>" LOC = "P6";   # R5 240 -> VT1 -> CA0 (LD1.6)
NET "dig<1>" LOC = "P63";  # R10 240 -> VT2 -> CA1 (LD1.8)
NET "dig<2>" LOC = "P65";  # R11 240 -> VT3 -> CA2 (LD1.9)
NET "dig<3>" LOC = "P48";  # R12 240 -> VT4 -> CA3 (LD1.12)
NET "SND"    LOC = "P67";  # BUZZER1.1 (пассивный), BUZZER1.2 -> R4 -> GND

# ---------------------------------------------------------------------
# ОГРАНИЧЕНИЯ ТАКТОВОЙ ЧАСТОТЫ
# ---------------------------------------------------------------------
NET "clk" TNM_NET = clk;
TIMESPEC TS_clk = PERIOD "clk" 25 MHz HIGH 50%;
