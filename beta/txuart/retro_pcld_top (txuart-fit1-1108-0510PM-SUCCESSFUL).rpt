*******************************  Equations  ********************************

********** Mapped Logic **********


$OpTx$FX_DC$175 <= (NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	ALE);


$OpTx$FX_DC$176 <= (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT addr_latch(0) AND NOT addr_latch(1) AND NOT addr_latch(2) AND IOM AND NOT WRn);


$OpTx$FX_DC$177 <= ((NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT WRn)
	OR (NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND state_FSM_FFd1 AND 
	ALE AND NOT IOM));


$OpTx$FX_DC$178 <= (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	addr_latch(0) AND NOT addr_latch(1) AND NOT addr_latch(2) AND IOM AND NOT WRn);


$OpTx$FX_DC$179 <= (NOT state_FSM_FFd3 AND state_FSM_FFd2 AND state_FSM_FFd1 AND 
	NOT addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND IOM AND NOT WRn);


$OpTx$FX_DC$702 <= ((cnt(0) AND NOT cnt(1) AND NOT cnt(2))
	OR (NOT cnt(0) AND cnt(1) AND cnt(2)));


A_I(0) <= ((addr_latch(0) AND NOT rd_drive/rd_drive_D2)
	OR (D(0) AND rd_drive/rd_drive_D2 AND NOT N48/N48_D2)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND row0));
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(1) <= ((addr_latch(1) AND NOT rd_drive/rd_drive_D2)
	OR (D(1) AND NOT addr_latch(0) AND addr_latch(1))
	OR (D(1) AND addr_latch(1) AND NOT IOM)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND row1)
	OR (D(1) AND addr_latch(1) AND addr_latch(2))
	OR (D(1) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (D(1) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (D(1) AND NOT addr_latch(1) AND NOT addr_latch(2) AND 
	rd_drive/rd_drive_D2)
	OR (addr_latch(0) AND NOT addr_latch(1) AND addr_latch(2) AND 
	NOT tx_run AND IOM AND rd_drive/rd_drive_D2));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
A_OE(1) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(2) <= ((addr_latch(2) AND NOT rd_drive/rd_drive_D2)
	OR (D(2) AND rd_drive/rd_drive_D2 AND NOT N48/N48_D2)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
