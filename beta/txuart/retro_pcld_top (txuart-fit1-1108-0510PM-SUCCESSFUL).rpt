A_7_IOBUFE/A_7_IOBUFE_TRST <= (NOT bus_reg(7)/bus_reg(7)_TRST AND NOT rd_drive/rd_drive_D2);


CS1 <= '1';


CS_n <= NOT (((state_FSM_FFd3)
	OR (state_FSM_FFd2 AND NOT state_FSM_FFd1)
	OR (NOT IOM AND A15)));


CSr_n <= NOT ((NOT IOM AND NOT A15));

