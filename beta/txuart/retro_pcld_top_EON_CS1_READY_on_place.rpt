FDCPE_shreg8: FDCPE port map (shreg(8),shreg_D(8),clk,'0',cpu_rst_r);
shreg_D(8) <= ((io_wr_tx.LFBK AND NOT A(7).PIN)
	OR (NOT baud_tick AND NOT io_wr_tx.LFBK AND NOT shreg(8).LFBK));

FDCPE_state_FSM_FFd1: FDCPE port map (state_FSM_FFd1,state_FSM_FFd1_D,clk,cpu_rst_r,'0');
state_FSM_FFd1_D <= ((NOT state_FSM_FFd2 AND state_FSM_FFd1.LFBK)
	OR (NOT state_FSM_FFd2 AND ALE AND NOT state_FSM_FFd3.LFBK)
	OR (NOT ALE AND NOT fsm_wrdone AND NOT fsm_rddone AND 
	NOT state_FSM_FFd3.LFBK AND state_FSM_FFd1.LFBK)
	OR (NOT IOM AND A15 AND fsm_wrdone AND NOT state_FSM_FFd3.LFBK AND 
	state_FSM_FFd1.LFBK));

FDCPE_state_FSM_FFd2: FDCPE port map (state_FSM_FFd2,state_FSM_FFd2_D,clk,cpu_rst_r,'0');
state_FSM_FFd2_D <= ((NOT state_FSM_FFd2.LFBK AND state_FSM_FFd3)
	OR (state_FSM_FFd3 AND NOT state_FSM_FFd1)
	OR (NOT state_FSM_FFd2.LFBK AND state_FSM_FFd1 AND NOT ALE)
	OR (NOT state_FSM_FFd3 AND state_FSM_FFd1 AND NOT ALE AND 
	FC_0_.OUT));

FTCPE_state_FSM_FFd3: FTCPE port map (state_FSM_FFd3,state_FSM_FFd3_T,clk,cpu_rst_r,'0');
state_FSM_FFd3_T <= ((NOT state_FSM_FFd2 AND state_FSM_FFd3.LFBK AND 
	NOT state_FSM_FFd1.LFBK)
	OR (state_FSM_FFd2 AND NOT IOM AND A15 AND fsm_wrdone AND 
	NOT state_FSM_FFd3.LFBK AND state_FSM_FFd1.LFBK));

FTCPE_t0_q: FTCPE port map (t0_q,'1',clk,'0','0');

FTCPE_tmr_cnt0: FTCPE port map (tmr_cnt(0),tmr_cnt_T(0),clk,'0','0');
tmr_cnt_T(0) <= (baud_tick AND $OpTx$FX_DC$4003);

FTCPE_tmr_cnt1: FTCPE port map (tmr_cnt(1),tmr_cnt_T(1),clk,'0','0');
tmr_cnt_T(1) <= (baud_tick AND $OpTx$FX_DC$4003 AND tmr_cnt(0).LFBK);

FTCPE_wr_seen: FTCPE port map (wr_seen,wr_seen_T,clk,cpu_rst_r.LFBK,'0');
wr_seen_T <= ((state_FSM_FFd2 AND NOT state_FSM_FFd3 AND state_FSM_FFd1 AND 
	fsm_wrdone AND wr_seen.LFBK)
	OR (state_FSM_FFd2 AND NOT state_FSM_FFd3 AND state_FSM_FFd1 AND 
	ALE AND wr_seen.LFBK AND NOT fsm_rddone.LFBK)
	OR (state_FSM_FFd2 AND NOT state_FSM_FFd3 AND state_FSM_FFd1 AND 
	NOT ALE AND NOT WRn AND NOT fsm_wrdone AND NOT wr_seen.LFBK)
	OR (state_FSM_FFd2 AND NOT state_FSM_FFd3 AND state_FSM_FFd1 AND 
	NOT WRn AND NOT fsm_wrdone AND NOT wr_seen.LFBK AND fsm_rddone.LFBK));

