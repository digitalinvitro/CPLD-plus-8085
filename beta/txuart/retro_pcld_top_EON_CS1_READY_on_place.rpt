D_OE(7) <= in_wb.LFBK;


OE_n <= NOT (((in_wb AND FC_0_.OUT)
	OR (NOT IOM AND A15 AND FC_0_.OUT)));


OEr_n <= NOT ((NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND NOT IOM AND NOT A15));


READY <= '1';

FDCPE_RESET_IN: FDCPE port map (RESET_IN,RESET_IN_D,clk,'0','0');
RESET_IN_D <= ((RESET_IN_OBUF.LFBK AND NOT rst_press.LFBK)
	OR (CLKOUT AND rst_win(0).LFBK AND rst_win(1).LFBK AND 
	rst_win(2).LFBK AND NOT clkout_d.LFBK AND $OpTx$FX_DC$88498.LFBK));

