*******************************  Equations  ********************************

********** Mapped Logic **********


$OpTx$FX_DC$88088 <= (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM);


$OpTx$FX_DC$88498 <= (NOT rst_sync AND NOT rst_press.LFBK);


$OpTx$FX_DC$88517 <= (ALE AND NOT state_FSM_FFd3.LFBK AND state_FSM_FFd1.LFBK AND 
	NOT state_FSM_FFd2.LFBK);


$OpTx$FX_DC$88518 <= (NOT addr_latch(0) AND NOT addr_latch(1) AND NOT addr_latch(2) AND 
	io_wr);


$OpTx$FX_DC$88526 <= ((rst_sync AND rst_press.LFBK)
	OR (NOT rst_sync AND RESET_IN_OBUF.LFBK AND NOT rst_press.LFBK));


A_I(0) <= ((addr_latch(0) AND NOT rd_drive)
	OR (row0 AND $OpTx$FX_DC$88088.LFBK)
	OR (rd_drive AND bus_reg(0).LFBK AND 
	NOT $OpTx$FX_DC$88088.LFBK));
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(1) <= ((addr_latch(1) AND NOT rd_drive)
	OR (row1 AND $OpTx$FX_DC$88088.LFBK)
	OR (D(1) AND rd_drive AND NOT $OpTx$FX_DC$88088.LFBK));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
A_OE(1) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(2) <= NOT (((addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND NOT row2)
	OR (NOT addr_latch(2) AND NOT rd_drive)
	OR (NOT D(2) AND rd_drive AND NOT row2)
	OR (NOT D(2) AND rd_drive AND NOT $OpTx$FX_DC$88088.LFBK)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND NOT $OpTx$FX_DC$88088.LFBK)));
A(2) <= A_I(2) when A_OE(2) = '1' else 'Z';
A_OE(2) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(3) <= ((addr_latch(3) AND NOT rd_drive)
	OR (D(3) AND rd_drive AND NOT $OpTx$FX_DC$88088.LFBK)
	OR (rd_drive AND row3 AND $OpTx$FX_DC$88088.LFBK));
A(3) <= A_I(3) when A_OE(3) = '1' else 'Z';
A_OE(3) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(4) <= ((addr_latch(4) AND NOT rd_drive)
	OR (D(4) AND rd_drive AND NOT $OpTx$FX_DC$88088.LFBK)
	OR (rd_drive AND row4 AND $OpTx$FX_DC$88088.LFBK));
A(4) <= A_I(4) when A_OE(4) = '1' else 'Z';
A_OE(4) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(5) <= ((addr_latch(5) AND NOT rd_drive)
	OR (D(5) AND rd_drive AND NOT $OpTx$FX_DC$88088)
	OR (rd_drive AND tmr_cnt(0) AND $OpTx$FX_DC$88088));
A(5) <= A_I(5) when A_OE(5) = '1' else 'Z';
A_OE(5) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(6) <= ((addr_latch(6) AND NOT rd_drive)
	OR (D(6) AND rd_drive AND NOT $OpTx$FX_DC$88088)
	OR (rd_drive AND tmr_cnt(1) AND $OpTx$FX_DC$88088));
A(6) <= A_I(6) when A_OE(6) = '1' else 'Z';
