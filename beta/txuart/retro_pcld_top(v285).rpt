*******************************  Equations  ********************************

********** Mapped Logic **********


A_I(0) <= ((D(0) AND addr_latch(1) AND addr_latch(2) AND rd_drive)
	OR (D(0) AND NOT addr_latch(1) AND NOT addr_latch(2) AND rd_drive)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND row0)
	OR (addr_latch(0) AND NOT rd_drive)
	OR (D(0) AND NOT addr_latch(0) AND rd_drive)
	OR (D(0) AND NOT IOM AND rd_drive));
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(1) <= ((D(1) AND NOT addr_latch(1) AND NOT addr_latch(2) AND rd_drive)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND row1)
	OR (addr_latch(0) AND NOT addr_latch(1) AND addr_latch(2) AND 
	IOM AND rd_drive AND FC_0_.OUT)
	OR (addr_latch(1) AND NOT rd_drive)
	OR (D(1) AND NOT addr_latch(0) AND rd_drive)
	OR (D(1) AND addr_latch(1) AND addr_latch(2))
	OR (D(1) AND NOT IOM AND rd_drive));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
A_OE(1) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(2) <= ((D(2) AND addr_latch(1) AND addr_latch(2))
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND rd_drive AND row2)
	OR (addr_latch(2) AND NOT rd_drive)
	OR (D(2) AND NOT addr_latch(0) AND rd_drive)
	OR (D(2) AND NOT IOM AND rd_drive)
	OR (D(2) AND NOT addr_latch(1) AND NOT addr_latch(2) AND rd_drive));
A(2) <= A_I(2) when A_OE(2) = '1' else 'Z';
A_OE(2) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(3) <= ((D(3) AND NOT addr_latch(0) AND rd_drive)
	OR (D(3) AND NOT IOM AND rd_drive)
	OR (D(3) AND addr_latch(1) AND addr_latch(2) AND rd_drive)
	OR (D(3) AND NOT addr_latch(1) AND NOT addr_latch(2) AND rd_drive)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND rd_drive AND row3)
	OR (addr_latch(3) AND NOT rd_drive));
A(3) <= A_I(3) when A_OE(3) = '1' else 'Z';
A_OE(3) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(4) <= ((D(4) AND NOT addr_latch(1) AND NOT addr_latch(2) AND rd_drive)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND rd_drive AND row4)
	OR (addr_latch(4) AND NOT rd_drive)
	OR (D(4) AND NOT addr_latch(0) AND rd_drive)
	OR (D(4) AND NOT IOM AND rd_drive)
	OR (D(4) AND addr_latch(1) AND addr_latch(2) AND rd_drive));
A(4) <= A_I(4) when A_OE(4) = '1' else 'Z';
A_OE(4) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(5) <= NOT (((NOT D(5) AND rd_drive)
	OR (NOT addr_latch(5) AND NOT rd_drive)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND rd_drive)
	OR (addr_latch(0) AND NOT addr_latch(1) AND addr_latch(2) AND 
	IOM AND rd_drive)));
A(5) <= A_I(5) when A_OE(5) = '1' else 'Z';
A_OE(5) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(6) <= NOT (((NOT D(6) AND rd_drive)
	OR (NOT addr_latch(6) AND NOT rd_drive)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND rd_drive)
	OR (addr_latch(0) AND NOT addr_latch(1) AND addr_latch(2) AND 
	IOM AND rd_drive)));
A(6) <= A_I(6) when A_OE(6) = '1' else 'Z';
A_OE(6) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(7) <= NOT (((NOT D(7) AND rd_drive)
	OR (NOT addr_latch(7) AND NOT rd_drive)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND rd_drive)
	OR (addr_latch(0) AND NOT addr_latch(1) AND addr_latch(2) AND 
	IOM AND rd_drive)));
A(7) <= A_I(7) when A_OE(7) = '1' else 'Z';
A_OE(7) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_7_IOBUFE/A_7_IOBUFE_TRST <= (NOT rd_drive AND NOT in_wb);


CS1 <= '1';


CS_n <= ((IOM AND NOT in_wb)
	OR (NOT A15 AND NOT in_wb));


CSr_n <= NOT ((NOT IOM AND NOT A15));

FTCPE_D0: FTCPE port map (D_I(0),D_T(0),clk,NOT wr_seen/wr_seen_RSTF__$INT,'0');
D_T(0) <= ((NOT D(0) AND NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND 
	state_FSM_FFd1 AND ALE AND NOT IOM AND D(0).PIN)
	OR (D(0) AND NOT state_FSM_FFd3 AND state_FSM_FFd2 AND 
	state_FSM_FFd1 AND NOT WRn AND NOT A(0).PIN)
	OR (NOT D(0) AND NOT state_FSM_FFd3 AND state_FSM_FFd2 AND 
	state_FSM_FFd1 AND NOT WRn AND A(0).PIN)
	OR (D(0) AND NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND 
	state_FSM_FFd1 AND ALE AND NOT IOM AND NOT D(0).PIN));
D(0) <= D_I(0) when D_OE(0) = '1' else 'Z';
D_OE(0) <= in_wb;

FTCPE_D1: FTCPE port map (D_I(1),D_T(1),clk,NOT wr_seen/wr_seen_RSTF__$INT,'0');
D_T(1) <= ((D(1) AND NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND 
	state_FSM_FFd1 AND ALE AND NOT IOM AND NOT D(1).PIN)
	OR (NOT D(1) AND NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND 
	state_FSM_FFd1 AND ALE AND NOT IOM AND D(1).PIN)
	OR (D(1) AND NOT state_FSM_FFd3 AND state_FSM_FFd2 AND 
	state_FSM_FFd1 AND NOT WRn AND NOT A(1).PIN)
	OR (NOT D(1) AND NOT state_FSM_FFd3 AND state_FSM_FFd2 AND 
	state_FSM_FFd1 AND NOT WRn AND A(1).PIN));
D(1) <= D_I(1) when D_OE(1) = '1' else 'Z';
D_OE(1) <= in_wb;

FTCPE_D2: FTCPE port map (D_I(2),D_T(2),clk,NOT wr_seen/wr_seen_RSTF__$INT,'0');
D_T(2) <= ((D(2) AND NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND 
	state_FSM_FFd1 AND ALE AND NOT IOM AND NOT D(2).PIN)
	OR (NOT D(2) AND NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND 
	state_FSM_FFd1 AND ALE AND NOT IOM AND D(2).PIN)
	OR (D(2) AND NOT state_FSM_FFd3 AND state_FSM_FFd2 AND 
	state_FSM_FFd1 AND NOT WRn AND NOT A(2).PIN)
	OR (NOT D(2) AND NOT state_FSM_FFd3 AND state_FSM_FFd2 AND 
	state_FSM_FFd1 AND NOT WRn AND A(2).PIN));
D(2) <= D_I(2) when D_OE(2) = '1' else 'Z';
D_OE(2) <= in_wb;

FTCPE_D3: FTCPE port map (D_I(3),D_T(3),clk,NOT wr_seen/wr_seen_RSTF__$INT,'0');
D_T(3) <= ((NOT D(3) AND NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND 
	state_FSM_FFd1 AND ALE AND NOT IOM AND D(3).PIN)
	OR (D(3) AND NOT state_FSM_FFd3 AND state_FSM_FFd2 AND 
	state_FSM_FFd1 AND NOT WRn AND NOT A(3).PIN)
	OR (NOT D(3) AND NOT state_FSM_FFd3 AND state_FSM_FFd2 AND 
	state_FSM_FFd1 AND NOT WRn AND A(3).PIN)
	OR (D(3) AND NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND 
	state_FSM_FFd1 AND ALE AND NOT IOM AND NOT D(3).PIN));
D(3) <= D_I(3) when D_OE(3) = '1' else 'Z';
D_OE(3) <= in_wb;

FTCPE_D4: FTCPE port map (D_I(4),D_T(4),clk,NOT wr_seen/wr_seen_RSTF__$INT,'0');
D_T(4) <= ((NOT D(4) AND NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND 
	state_FSM_FFd1 AND ALE AND NOT IOM AND D(4).PIN)
	OR (D(4) AND NOT state_FSM_FFd3 AND state_FSM_FFd2 AND 
	state_FSM_FFd1 AND NOT WRn AND NOT A(4).PIN)
	OR (NOT D(4) AND NOT state_FSM_FFd3 AND state_FSM_FFd2 AND 
	state_FSM_FFd1 AND NOT WRn AND A(4).PIN)
	OR (D(4) AND NOT state_FSM_FFd3 AND NOT state_FSM_FFd2 AND 
	state_FSM_FFd1 AND ALE AND NOT IOM AND NOT D(4).PIN));
D(4) <= D_I(4) when D_OE(4) = '1' else 'Z';
D_OE(4) <= in_wb;

FTCPE_D5: FTCPE port map (D_I(5),D_T(5),clk,NOT wr_seen/wr_seen_RSTF__$INT,'0');
D_T(5) <= ((NOT D(5) AND NOT state_FSM_FFd3 AND state_FSM_FFd2 AND 
	state_FSM_FFd1 AND NOT WRn AND A(5).PIN)
