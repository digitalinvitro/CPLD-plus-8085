A(5) <= A_I(5) when A_OE(5) = '1' else 'Z';
A_OE(5) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(6) <= ((addr_latch(6) AND NOT $OpTx$FX_DC$70)
	OR (D(6) AND NOT IOM AND $OpTx$FX_DC$70)
	OR (D(6) AND NOT addr_latch(0) AND $OpTx$FX_DC$70)
	OR (NOT ALE AND NOT RDn AND IOM AND NOT state_FSM_FFd1 AND 
