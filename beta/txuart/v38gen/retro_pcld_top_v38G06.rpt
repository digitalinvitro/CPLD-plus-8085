A_I(7) <= ((addr_latch(7) AND NOT $OpTx$FX_DC$70)
	OR (D(7) AND NOT IOM AND $OpTx$FX_DC$70)
	OR (D(7) AND NOT addr_latch(0) AND $OpTx$FX_DC$70)
	OR (NOT ALE AND NOT RDn AND IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT u_txuart/bit_cnt(0) AND NOT u_txuart/bit_cnt(1) AND 
	NOT u_txuart/bit_cnt(2) AND addr_latch(0) AND NOT u_txuart/bit_cnt(3)));
A(7) <= A_I(7) when A_OE(7) = '1' else 'Z';
A_OE(7) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_7_IOBUFE/A_7_IOBUFE_TRST <= (NOT bus_reg(7)/bus_reg(7)_TRST AND NOT $OpTx$FX_DC$70);


BUF_u_txuart/baud_cnt(3)__$INT <= ((tx_baud_tick)
	OR (IOM AND RESET_IN AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT state_FSM_FFd3 AND NOT u_txuart/bit_cnt(0) AND 
	NOT u_txuart/bit_cnt(1) AND NOT u_txuart/bit_cnt(2) AND NOT u_txuart/bit_cnt(3) AND 
	addr_latch(2) AND NOT WRn)
	OR (NOT u_txuart/baud_cnt(0) AND NOT u_txuart/baud_cnt(3))
	OR (NOT u_txuart/baud_cnt(1) AND NOT u_txuart/baud_cnt(3))
	OR (NOT u_txuart/baud_cnt(2) AND NOT u_txuart/baud_cnt(3))
	OR (u_txuart/baud_cnt(0) AND u_txuart/baud_cnt(1) AND 
	u_txuart/baud_cnt(2) AND u_txuart/baud_cnt(3)));


CS1 <= '1';


CS_n <= NOT (((NOT IOM AND A15)
	OR (state_FSM_FFd1 AND state_FSM_FFd2)
	OR (state_FSM_FFd1 AND state_FSM_FFd3)));


CSr_n <= NOT ((NOT IOM AND NOT A15));

FDCPE_D0: FDCPE port map (D_I(0),D(0),clk,RST,'0');
D(0) <= ((RDn AND NOT state_FSM_FFd1 AND state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND NOT WRn AND A(0).PIN)
	OR (D(0) AND NOT $OpTx$FX_DC$82)
