*******************************  Equations  ********************************

********** Mapped Logic **********


$OpTx$FX_DC$70 <= (NOT ALE AND NOT RDn AND NOT state_FSM_FFd1 AND state_FSM_FFd2);


$OpTx$FX_DC$78 <= (ALE AND NOT state_FSM_FFd1 AND NOT state_FSM_FFd2 AND 
	state_FSM_FFd3);


$OpTx$FX_DC$80 <= (IOM AND NOT state_FSM_FFd1 AND state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND addr_latch(0) AND NOT WRn);


$OpTx$FX_DC$82 <= ((NOT RDn AND NOT IOM AND NOT state_FSM_FFd1 AND state_FSM_FFd2)
	OR (state_FSM_FFd1 AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	NOT WRn)
	OR (NOT state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	NOT WRn));


$OpTx$FX_DC$83 <= (IOM AND NOT state_FSM_FFd1 AND state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND addr_latch(1) AND NOT WRn);


$OpTx$FX_SC$728 <= ((tx_baud_tick)
	OR (IOM AND RESET_IN AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT state_FSM_FFd3 AND NOT u_txuart/bit_cnt(0) AND 
	NOT u_txuart/bit_cnt(1) AND NOT u_txuart/bit_cnt(2) AND NOT u_txuart/bit_cnt(3) AND 
	addr_latch(2) AND NOT WRn));


$OpTx$FX_SC$729 <= ((NOT tx_baud_tick)
	OR (IOM AND RESET_IN AND NOT u_txuart/bit_cnt(0) AND 
	NOT u_txuart/bit_cnt(1) AND NOT u_txuart/bit_cnt(2) AND NOT u_txuart/bit_cnt(3) AND NOT WRn AND 
	FC_2_.OUT));


A_I(0) <= ((addr_latch(0) AND NOT $OpTx$FX_DC$70)
	OR (D(0) AND NOT IOM AND $OpTx$FX_DC$70)
	OR (D(0) AND NOT addr_latch(0) AND $OpTx$FX_DC$70)
	OR (NOT ALE AND NOT RDn AND IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND addr_latch(0) AND row0));
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(1) <= ((addr_latch(1) AND NOT $OpTx$FX_DC$70)
	OR (D(1) AND NOT IOM AND $OpTx$FX_DC$70)
	OR (D(1) AND NOT addr_latch(0) AND $OpTx$FX_DC$70)
	OR (NOT ALE AND NOT RDn AND IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND addr_latch(0) AND row1));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
A_OE(1) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(2) <= ((addr_latch(2) AND NOT $OpTx$FX_DC$70)
	OR (D(2) AND NOT IOM AND $OpTx$FX_DC$70)
	OR (D(2) AND NOT addr_latch(0) AND $OpTx$FX_DC$70)
	OR (NOT ALE AND NOT RDn AND IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND addr_latch(0) AND row2));
A(2) <= A_I(2) when A_OE(2) = '1' else 'Z';
A_OE(2) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(3) <= ((addr_latch(3) AND NOT $OpTx$FX_DC$70)
	OR (D(3) AND NOT IOM AND $OpTx$FX_DC$70)
	OR (D(3) AND NOT addr_latch(0) AND $OpTx$FX_DC$70)
	OR (NOT ALE AND NOT RDn AND IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND addr_latch(0) AND row3));
A(3) <= A_I(3) when A_OE(3) = '1' else 'Z';
A_OE(3) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(4) <= ((addr_latch(4) AND NOT $OpTx$FX_DC$70)
	OR (D(4) AND NOT IOM AND $OpTx$FX_DC$70)
	OR (D(4) AND NOT addr_latch(0) AND $OpTx$FX_DC$70)
	OR (NOT ALE AND NOT RDn AND IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND addr_latch(0) AND row4));
A(4) <= A_I(4) when A_OE(4) = '1' else 'Z';
A_OE(4) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(5) <= ((addr_latch(5) AND NOT $OpTx$FX_DC$70)
	OR (D(5) AND NOT IOM AND $OpTx$FX_DC$70)
	OR (D(5) AND NOT addr_latch(0) AND $OpTx$FX_DC$70)
	OR (NOT ALE AND NOT RDn AND IOM AND NOT state_FSM_FFd1 AND 
