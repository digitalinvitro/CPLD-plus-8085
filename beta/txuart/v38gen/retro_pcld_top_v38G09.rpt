*******************************  Equations  ********************************

********** Mapped Logic **********


$OpTx$FX_DC$225 <= ((NOT RDn AND NOT IOM AND NOT state_FSM_FFd1 AND state_FSM_FFd2)
	OR (state_FSM_FFd1 AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	NOT WRn)
	OR (NOT state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	NOT WRn)
	OR (NOT RDn AND NOT state_FSM_FFd1 AND state_FSM_FFd2 AND 
	NOT addr_latch(0)));


$OpTx$FX_DC$233 <= ((tx_baud_tick)
	OR (IOM AND NOT state_FSM_FFd1 AND state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND NOT u_txuart/bit_cnt(0) AND NOT u_txuart/bit_cnt(1) AND 
	NOT u_txuart/bit_cnt(2) AND NOT u_txuart/bit_cnt(3) AND addr_latch(2) AND NOT WRn));


A_I(0) <= ((ALE AND addr_latch(0))
	OR (RDn AND addr_latch(0))
	OR (state_FSM_FFd1 AND addr_latch(0))
	OR (NOT state_FSM_FFd2 AND addr_latch(0))
	OR (D(0) AND NOT IOM AND addr_latch(0))
	OR (IOM AND addr_latch(0) AND row0)
	OR (D(0) AND NOT ALE AND NOT RDn AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT addr_latch(0)));
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(1) <= ((D(1) AND NOT ALE AND NOT RDn AND NOT IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2)
	OR (D(1) AND NOT ALE AND NOT RDn AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT addr_latch(0))
	OR (NOT ALE AND NOT RDn AND IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND addr_latch(0) AND row1)
	OR (ALE AND addr_latch(1))
	OR (RDn AND addr_latch(1))
	OR (state_FSM_FFd1 AND addr_latch(1))
	OR (NOT state_FSM_FFd2 AND addr_latch(1)));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
A_OE(1) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(2) <= ((D(2) AND NOT ALE AND NOT RDn AND NOT IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2)
	OR (D(2) AND NOT ALE AND NOT RDn AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT addr_latch(0))
	OR (NOT ALE AND NOT RDn AND IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND addr_latch(0) AND row2)
	OR (ALE AND addr_latch(2))
	OR (RDn AND addr_latch(2))
	OR (state_FSM_FFd1 AND addr_latch(2))
	OR (NOT state_FSM_FFd2 AND addr_latch(2)));
A(2) <= A_I(2) when A_OE(2) = '1' else 'Z';
A_OE(2) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(3) <= ((D(3) AND NOT ALE AND NOT RDn AND NOT IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2)
	OR (D(3) AND NOT ALE AND NOT RDn AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT addr_latch(0))
	OR (NOT ALE AND NOT RDn AND IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND addr_latch(0) AND row3)
	OR (ALE AND addr_latch(3))
	OR (RDn AND addr_latch(3))
	OR (state_FSM_FFd1 AND addr_latch(3))
	OR (NOT state_FSM_FFd2 AND addr_latch(3)));
A(3) <= A_I(3) when A_OE(3) = '1' else 'Z';
A_OE(3) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(4) <= A(4)_BUFR;
A(4) <= A_I(4) when A_OE(4) = '1' else 'Z';
A_OE(4) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A(4)_BUFR <= ((ALE AND addr_latch(4))
	OR (RDn AND addr_latch(4))
	OR (D(4) AND NOT ALE AND NOT RDn AND NOT IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2)
	OR (D(4) AND NOT ALE AND NOT RDn AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT addr_latch(0))
	OR (NOT ALE AND NOT RDn AND IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND addr_latch(0) AND row4)
	OR (state_FSM_FFd1 AND addr_latch(4))
	OR (NOT state_FSM_FFd2 AND addr_latch(4)));


A_I(5) <= ((D(5) AND NOT ALE AND NOT RDn AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT addr_latch(0))
	OR (D(5) AND NOT ALE AND NOT RDn AND NOT IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2)
	OR (NOT ALE AND NOT RDn AND IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND addr_latch(0) AND tmr_cnt(9))
	OR (ALE AND addr_latch(5))
	OR (RDn AND addr_latch(5))
	OR (state_FSM_FFd1 AND addr_latch(5))
	OR (NOT state_FSM_FFd2 AND addr_latch(5)));
A(5) <= A_I(5) when A_OE(5) = '1' else 'Z';
A_OE(5) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(6) <= ((ALE AND addr_latch(6))
	OR (D(6) AND NOT ALE AND NOT RDn AND NOT IOM AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2)
	OR (D(6) AND NOT ALE AND NOT RDn AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT addr_latch(0))
