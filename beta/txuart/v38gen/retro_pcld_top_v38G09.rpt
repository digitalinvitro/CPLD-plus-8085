FDCPE_u_txuart/shreg6: FDCPE port map (u_txuart/shreg(6),u_txuart/shreg_D(6),clk,'0',RST);
u_txuart/shreg_D(6) <= ((NOT state_FSM_FFd2 AND u_txuart/shreg(7) AND 
