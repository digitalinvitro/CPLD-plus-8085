FDCPE_state_FSM_FFd3: FDCPE port map (state_FSM_FFd3,state_FSM_FFd3_D,clk,RST,'0');
state_FSM_FFd3_D <= ((ALE AND NOT state_FSM_FFd1 AND NOT state_FSM_FFd2)
	OR (NOT RDn AND NOT state_FSM_FFd1 AND state_FSM_FFd2)
	OR (state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3)
	OR (NOT IOM AND state_FSM_FFd1 AND NOT state_FSM_FFd3 AND WRn AND 
