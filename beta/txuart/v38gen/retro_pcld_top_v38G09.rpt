	OR (NOT addr_latch(2) AND NOT u_txuart/shreg(8) AND NOT tx_baud_tick)
	OR (NOT u_txuart/shreg(8) AND WRn AND NOT tx_baud_tick)
	OR (state_FSM_FFd1 AND NOT u_txuart/shreg(8) AND 
	NOT tx_baud_tick)
	OR (IOM AND NOT state_FSM_FFd1 AND state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND NOT u_txuart/bit_cnt(0) AND NOT u_txuart/bit_cnt(1) AND 
	NOT u_txuart/bit_cnt(2) AND NOT u_txuart/bit_cnt(3) AND addr_latch(2) AND NOT WRn AND 
	NOT A(7).PIN)
	OR (NOT IOM AND NOT u_txuart/shreg(8) AND NOT tx_baud_tick)
