seg(7) <= '1';

FTCPE_state_FSM_FFd1: FTCPE port map (state_FSM_FFd1,state_FSM_FFd1_T,clk,RST,'0');
state_FSM_FFd1_T <= ((state_FSM_FFd1 AND state_FSM_FFd2 AND state_FSM_FFd3)
	OR (RDn AND NOT state_FSM_FFd1 AND state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND NOT WRn)
	OR (IOM AND state_FSM_FFd1 AND NOT state_FSM_FFd2 AND 
