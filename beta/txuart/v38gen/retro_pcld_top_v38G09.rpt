FTCPE_state_FSM_FFd2: FTCPE port map (state_FSM_FFd2,state_FSM_FFd2_T,clk,RST,'0');
state_FSM_FFd2_T <= ((RDn AND NOT state_FSM_FFd1 AND state_FSM_FFd2)
