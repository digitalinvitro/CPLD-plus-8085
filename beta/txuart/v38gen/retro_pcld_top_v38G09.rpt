FDCPE_u_txuart/shreg1: FDCPE port map (u_txuart/shreg(1),u_txuart/shreg_D(1),clk,'0',RST);
u_txuart/shreg_D(1) <= ((u_txuart/shreg(2) AND WRn AND tx_baud_tick)
	OR (u_txuart/shreg(2) AND tx_baud_tick AND NOT FC_1_.OUT)
