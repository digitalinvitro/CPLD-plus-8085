SID <= RX;

FDCPE_SND: FDCPE port map (SND,SND_D,clk,RST,'0');
SND_D <= ((A(4).PIN AND $OpTx$FX_DC$93)
	OR (NOT $OpTx$FX_DC$93 AND snd_q.LFBK));


TX <= NOT u_txuart/tx_n;


WE_n <= NOT ((state_FSM_FFd1 AND state_FSM_FFd2.LFBK));

FTCPE_X1: FTCPE port map (X1,t0_q,clk,'0','0');

FTCPE_X2: FTCPE port map (X2,t0_q,clk,'0','0');

FDCPE_addr_latch0: FDCPE port map (addr_latch(0),addr_latch_D(0),clk,RST,'0');
addr_latch_D(0) <= ((A(0).PIN AND $OpTx$FX_DC$91)
