FDCPE_addr_latch7: FDCPE port map (addr_latch(7),addr_latch_D(7),clk,RST,'0');
addr_latch_D(7) <= ((A(7).PIN AND $OpTx$FX_DC$91)
	OR (NOT $OpTx$FX_DC$91 AND addr_latch(7).LFBK));


bus_ld_mem <= (NOT state_FSM_FFd1 AND NOT IOM AND NOT RDn AND 
	state_FSM_FFd2.LFBK);


bus_ld_rx <= (state_FSM_FFd2 AND IOM AND NOT RDn AND NOT addr_latch(0).LFBK AND 
	NOT state_FSM_FFd1.LFBK);


bus_ld_wr <= ((state_FSM_FFd1 AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	NOT WRn)
	OR (NOT state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	NOT WRn));


bus_reg(2)/bus_reg(2)_TRST <= ((state_FSM_FFd1 AND state_FSM_FFd3)
	OR (state_FSM_FFd1 AND state_FSM_FFd2.LFBK)
	OR (NOT state_FSM_FFd1 AND NOT state_FSM_FFd3 AND NOT ALE AND 
	NOT state_FSM_FFd2.LFBK));

FTCPE_col0: FTCPE port map (col0,col0_T,clk,'0','0');
col0_T <= ((NOT state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
