FDCPE_u_rxuart/rx_shreg_n6: FDCPE port map (u_rxuart/rx_shreg_n(6),u_rxuart/rx_shreg_n_D(6),clk,RST,'0');
u_rxuart/rx_shreg_n_D(6) <= ((RX AND NOT u_rxuart/rx_busy.LFBK AND 
	u_rxuart/rx_shreg_n(6).LFBK)
	OR (u_rxuart/rx_busy.LFBK AND u_rxuart/sample_tick.LFBK AND 
