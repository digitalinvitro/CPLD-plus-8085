	OR (D(7) AND NOT bus_ld_mem AND NOT bus_ld_rx AND NOT bus_ld_wr)
	OR (NOT bus_ld_mem AND NOT bus_ld_rx AND A(7).PIN AND bus_ld_wr));


OE_n <= NOT (((NOT state_FSM_FFd1 AND NOT state_FSM_FFd2 AND NOT IOM AND A15)
	OR (NOT state_FSM_FFd1 AND state_FSM_FFd3 AND NOT IOM AND A15)));


OEr_n <= NOT (((NOT state_FSM_FFd1 AND state_FSM_FFd3 AND NOT IOM AND NOT A15)
	OR (NOT state_FSM_FFd1 AND NOT IOM AND NOT A15 AND 
	NOT state_FSM_FFd2.LFBK)));


READY <= '1';

FTCPE_RESET_IN: FTCPE port map (RESET_IN,RESET_IN_T,CLKOUT,RST,'0');
RESET_IN_T <= (NOT RESET_IN_OBUF.LFBK AND u_reset_cpu/tt(0).LFBK AND 
