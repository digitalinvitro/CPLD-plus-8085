*******************************  Equations  ********************************

********** Mapped Logic **********


$OpTx$FX_DC$6 <= ((state_FSM_FFd2 AND NOT IOM AND NOT RDn AND 
	NOT state_FSM_FFd1.LFBK)
	OR (state_FSM_FFd2 AND NOT RDn AND NOT addr_latch(0).LFBK AND 
	NOT state_FSM_FFd1.LFBK));


$OpTx$FX_DC$9 <= (NOT state_FSM_FFd1 AND NOT ALE AND NOT RDn AND 
	state_FSM_FFd2.LFBK);


$OpTx$FX_DC$91 <= (NOT state_FSM_FFd1 AND state_FSM_FFd3 AND ALE AND 
	NOT state_FSM_FFd2.LFBK);


$OpTx$FX_DC$92 <= (state_FSM_FFd2 AND NOT WRn AND IOM AND addr_latch(0).LFBK AND 
	NOT state_FSM_FFd1.LFBK AND NOT state_FSM_FFd3.LFBK);


$OpTx$FX_DC$93 <= (NOT state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	NOT WRn AND IOM AND addr_latch(1).LFBK);


A_I(0) <= A(0)_BUFR;
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A(0)_BUFR <= ((D(0) AND state_FSM_FFd2 AND NOT IOM AND NOT RDn AND 
	addr_latch(0).LFBK AND NOT state_FSM_FFd1.LFBK)
	OR (row0 AND addr_latch(0).LFBK AND state_FSM_FFd1.LFBK)
	OR (NOT $OpTx$FX_DC$9 AND addr_latch(0).LFBK)
	OR (D(0) AND $OpTx$FX_DC$9 AND NOT addr_latch(0).LFBK)
	OR (NOT state_FSM_FFd2 AND row0 AND addr_latch(0).LFBK)
	OR (IOM AND row0 AND addr_latch(0).LFBK)
	OR (RDn AND row0 AND addr_latch(0).LFBK));


A_I(1) <= ((addr_latch(1) AND NOT $OpTx$FX_DC$9.LFBK)
	OR (D(1) AND NOT ALE AND $OpTx$FX_DC$6)
	OR (row1 AND NOT $OpTx$FX_DC$6 AND $OpTx$FX_DC$9.LFBK));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
A_OE(1) <= A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(2) <= ((addr_latch(2) AND NOT $OpTx$FX_DC$9.LFBK)
	OR (D(2) AND NOT ALE AND $OpTx$FX_DC$6)
	OR (row2 AND NOT $OpTx$FX_DC$6 AND $OpTx$FX_DC$9.LFBK));
A(2) <= A_I(2) when A_OE(2) = '1' else 'Z';
A_OE(2) <= A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(3) <= ((addr_latch(3) AND NOT $OpTx$FX_DC$9.LFBK)
	OR (D(3) AND NOT ALE AND $OpTx$FX_DC$6)
	OR (row3 AND NOT $OpTx$FX_DC$6 AND $OpTx$FX_DC$9.LFBK));
A(3) <= A_I(3) when A_OE(3) = '1' else 'Z';
A_OE(3) <= A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(4) <= ((addr_latch(4) AND NOT $OpTx$FX_DC$9.LFBK)
	OR (D(4) AND NOT ALE AND $OpTx$FX_DC$6)
	OR (row4 AND NOT $OpTx$FX_DC$6 AND $OpTx$FX_DC$9.LFBK));
A(4) <= A_I(4) when A_OE(4) = '1' else 'Z';
A_OE(4) <= A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(5) <= ((NOT $OpTx$FX_DC$9 AND addr_latch(5).LFBK)
	OR (D(5) AND NOT ALE AND $OpTx$FX_DC$6.LFBK)
	OR ($OpTx$FX_DC$9 AND NOT $OpTx$FX_DC$6.LFBK AND 
	rx_ready.LFBK));
A(5) <= A_I(5) when A_OE(5) = '1' else 'Z';
A_OE(5) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(6) <= ((NOT $OpTx$FX_DC$9 AND addr_latch(6).LFBK)
	OR (D(6) AND NOT ALE AND $OpTx$FX_DC$6.LFBK)
	OR ($OpTx$FX_DC$9 AND tx_idle AND NOT $OpTx$FX_DC$6.LFBK));
A(6) <= A_I(6) when A_OE(6) = '1' else 'Z';
A_OE(6) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(7) <= ((addr_latch(7) AND NOT $OpTx$FX_DC$9)
	OR (D(7) AND NOT ALE AND $OpTx$FX_DC$6.LFBK));
A(7) <= A_I(7) when A_OE(7) = '1' else 'Z';
A_OE(7) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_7_IOBUFE/A_7_IOBUFE_TRST <= ((bus_reg(2)/bus_reg(2)_TRST.LFBK)
	OR (NOT ALE AND NOT RDn AND state_FSM_FFd2.LFBK));


CS1 <= '1';


CS_n <= NOT (((state_FSM_FFd1 AND state_FSM_FFd3)
	OR (state_FSM_FFd1 AND state_FSM_FFd2.LFBK)
	OR (NOT IOM AND A15)));


CSr_n <= NOT ((NOT IOM AND NOT A15));

FDCPE_D0: FDCPE port map (D_I(0),D(0),clk,RST,'0');
D(0) <= ((D(0).PIN AND bus_ld_mem.LFBK)
	OR (NOT u_rxuart/rx_shreg_n(0) AND bus_ld_rx AND 
	NOT bus_ld_mem.LFBK)
	OR (NOT bus_ld_rx AND A(0).PIN AND bus_ld_wr AND 
	NOT bus_ld_mem.LFBK)
	OR (NOT bus_ld_rx AND NOT bus_ld_wr AND NOT bus_ld_mem.LFBK AND 
	bus_reg(0).LFBK));
D(0) <= D_I(0) when D_OE(0) = '1' else 'Z';
D_OE(0) <= bus_reg(2)/bus_reg(2)_TRST.LFBK;

FDCPE_D1: FDCPE port map (D_I(1),D(1),clk,RST,'0');
D(1) <= ((bus_ld_mem AND D(1).PIN)
	OR (NOT u_rxuart/rx_shreg_n(1) AND NOT bus_ld_mem AND bus_ld_rx)
	OR (NOT bus_ld_mem AND NOT bus_ld_rx AND A(1).PIN AND 
	bus_ld_wr.LFBK)
	OR (NOT bus_ld_mem AND NOT bus_ld_rx AND NOT bus_ld_wr.LFBK AND 
	bus_reg(1).LFBK));
D(1) <= D_I(1) when D_OE(1) = '1' else 'Z';
D_OE(1) <= bus_reg(2)/bus_reg(2)_TRST;

FDCPE_D2: FDCPE port map (D_I(2),D(2),clk,RST,'0');
D(2) <= ((bus_ld_mem AND D(2).PIN)
	OR (NOT u_rxuart/rx_shreg_n(2) AND NOT bus_ld_mem AND bus_ld_rx)
	OR (NOT bus_ld_mem AND NOT bus_ld_rx AND A(2).PIN AND 
	bus_ld_wr.LFBK)
	OR (NOT bus_ld_mem AND NOT bus_ld_rx AND NOT bus_ld_wr.LFBK AND 
