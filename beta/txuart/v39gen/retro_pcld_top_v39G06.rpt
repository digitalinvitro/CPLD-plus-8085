	OR (bus_ld_rx AND NOT bus_ld_mem AND NOT u_rxuart/rx_shreg_n(4))
	OR (D(4) AND NOT bus_ld_rx AND NOT bus_ld_mem AND NOT bus_ld_wr)
	OR (NOT bus_ld_rx AND NOT bus_ld_mem AND bus_ld_wr AND A(4).PIN));

