u_rxuart/rx_busy_D <= ((NOT u_rxuart/rx_busy AND NOT RX)
	OR (u_rxuart/rx_busy AND NOT u_rxuart/os_cnt(2))
	OR (u_rxuart/rx_busy AND NOT u_rxuart/os_cnt(0))
	OR (u_rxuart/rx_busy AND NOT t0_q)
	OR (NOT u_rxuart/rx_shreg_n(7) AND NOT u_rxuart/rx_shreg_n(1) AND 
	NOT u_rxuart/rx_shreg_n(2) AND NOT u_rxuart/rx_shreg_n(3) AND NOT u_rxuart/rx_shreg_n(4) AND 
	NOT u_rxuart/rx_shreg_n(5) AND NOT u_rxuart/rx_shreg_n(6) AND NOT u_rxuart/rx_shreg_n(0) AND 
	NOT RX)
	OR (u_rxuart/rx_busy AND u_rxuart/os_cnt(1)));

