*******************************  Equations  ********************************

********** Mapped Logic **********


$OpTx$FX_DC$2 <= (IOM AND NOT WRn AND NOT state_FSM_FFd1 AND state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND addr_latch(1));


$OpTx$FX_DC$6 <= (IOM AND NOT WRn AND NOT state_FSM_FFd1 AND state_FSM_FFd2 AND 
	addr_latch(0) AND NOT state_FSM_FFd3);


$OpTx$FX_DC$9 <= (ALE AND NOT state_FSM_FFd1 AND NOT state_FSM_FFd2 AND 
	state_FSM_FFd3);


A_I(0) <= ((D(0) AND NOT IOM AND addr_latch(0))
	OR (IOM AND addr_latch(0) AND row0)
	OR (D(0) AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT addr_latch(0))
	OR (RDn AND addr_latch(0))
	OR (ALE AND addr_latch(0))
	OR (state_FSM_FFd1 AND addr_latch(0))
	OR (NOT state_FSM_FFd2 AND addr_latch(0)));
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(1) <= ((D(1) AND NOT IOM AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2)
	OR (D(1) AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT addr_latch(0))
	OR (IOM AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND addr_latch(0) AND row1)
	OR (RDn AND addr_latch(1))
	OR (ALE AND addr_latch(1))
	OR (state_FSM_FFd1 AND addr_latch(1))
	OR (NOT state_FSM_FFd2 AND addr_latch(1)));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
A_OE(1) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(2) <= ((D(2) AND NOT IOM AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2)
	OR (D(2) AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT addr_latch(0))
	OR (IOM AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND addr_latch(0) AND row2)
	OR (RDn AND addr_latch(2))
	OR (ALE AND addr_latch(2))
	OR (state_FSM_FFd1 AND addr_latch(2))
	OR (NOT state_FSM_FFd2 AND addr_latch(2)));
A(2) <= A_I(2) when A_OE(2) = '1' else 'Z';
A_OE(2) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(3) <= ((D(3) AND NOT IOM AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2)
	OR (D(3) AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT addr_latch(0))
	OR (IOM AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND addr_latch(0) AND row3)
	OR (RDn AND addr_latch(3))
	OR (ALE AND addr_latch(3))
	OR (state_FSM_FFd1 AND addr_latch(3))
	OR (NOT state_FSM_FFd2 AND addr_latch(3)));
A(3) <= A_I(3) when A_OE(3) = '1' else 'Z';
A_OE(3) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A(4)_BUFR <= ((state_FSM_FFd1 AND addr_latch(4))
	OR (D(4) AND NOT IOM AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2)
	OR (D(4) AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT addr_latch(0))
	OR (IOM AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND addr_latch(0) AND row4)
	OR (RDn AND addr_latch(4))
	OR (ALE AND addr_latch(4))
	OR (NOT state_FSM_FFd2 AND addr_latch(4)));


A_I(4) <= A(4)_BUFR;
A(4) <= A_I(4) when A_OE(4) = '1' else 'Z';
A_OE(4) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(5) <= NOT (((NOT D(5) AND NOT IOM AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2)
	OR (NOT D(5) AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT addr_latch(0))
	OR (RDn AND NOT addr_latch(5))
	OR (ALE AND NOT addr_latch(5))
	OR (state_FSM_FFd1 AND NOT addr_latch(5))
	OR (NOT state_FSM_FFd2 AND NOT addr_latch(5))));
A(5) <= A_I(5) when A_OE(5) = '1' else 'Z';
A_OE(5) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(6) <= ((D(6) AND NOT IOM AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2)
	OR (D(6) AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT addr_latch(0))
	OR (IOM AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND addr_latch(0) AND tx_idle)
	OR (RDn AND addr_latch(6))
	OR (ALE AND addr_latch(6))
	OR (state_FSM_FFd1 AND addr_latch(6))
	OR (NOT state_FSM_FFd2 AND addr_latch(6)));
A(6) <= A_I(6) when A_OE(6) = '1' else 'Z';
A_OE(6) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(7) <= NOT (((NOT D(7) AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2 AND NOT addr_latch(0))
	OR (NOT D(7) AND NOT IOM AND NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND 
	state_FSM_FFd2)
	OR (RDn AND NOT addr_latch(7))
	OR (ALE AND NOT addr_latch(7))
	OR (state_FSM_FFd1 AND NOT addr_latch(7))
	OR (NOT state_FSM_FFd2 AND NOT addr_latch(7))));
A(7) <= A_I(7) when A_OE(7) = '1' else 'Z';
A_OE(7) <= A_7_IOBUFE/A_7_IOBUFE_TRST;


A_7_IOBUFE/A_7_IOBUFE_TRST <= ((bus_reg(4)/bus_reg(4)_TRST)
	OR (NOT RDn AND NOT ALE AND state_FSM_FFd2));


CS1 <= '1';


CS_n <= NOT (((NOT IOM AND A15)
	OR (state_FSM_FFd1 AND state_FSM_FFd2)
	OR (state_FSM_FFd1 AND state_FSM_FFd3)));


CSr_n <= NOT ((NOT IOM AND NOT A15));

FDCPE_D0: FDCPE port map (D_I(0),D(0),cpld_clk,RST,'0');
D(0) <= ((bus_ld_mem AND D(0).PIN)
	OR (bus_ld_rx AND NOT bus_ld_mem AND NOT u_rxuart/rx_shreg_n(0))
	OR (D(0) AND NOT bus_ld_rx AND NOT bus_ld_mem AND NOT bus_ld_wr)
	OR (NOT bus_ld_rx AND NOT bus_ld_mem AND bus_ld_wr AND A(0).PIN));
D(0) <= D_I(0) when D_OE(0) = '1' else 'Z';
D_OE(0) <= bus_reg(4)/bus_reg(4)_TRST;

FDCPE_D1: FDCPE port map (D_I(1),D(1),cpld_clk,RST,'0');
D(1) <= ((bus_ld_mem AND D(1).PIN)
	OR (bus_ld_rx AND NOT bus_ld_mem AND NOT u_rxuart/rx_shreg_n(1))
	OR (D(1) AND NOT bus_ld_rx AND NOT bus_ld_mem AND NOT bus_ld_wr)
	OR (NOT bus_ld_rx AND NOT bus_ld_mem AND bus_ld_wr AND A(1).PIN));
