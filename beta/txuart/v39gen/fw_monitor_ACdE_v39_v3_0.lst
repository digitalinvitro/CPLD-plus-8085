  708            ; =====================================================================
  709            ; UART-канал: передача OUT 04h @1M (TXRDY = IN 03h бит 7, v1.2 Шаг-2),
  710            ; приём RIM/SID @4800 - как v27
  711            ; =====================================================================
  712            
  713            ; ---------------------------------------------------------------------
  714            ; TXBYTE: A = байт -> сериализатор CPLD (1 000 000 8N1). Ожидает TXRDY
  715            ; (запись при busy аппаратно отбрасывается). Используется баннером/строками.
  716            ; ---------------------------------------------------------------------
  717  02F2: F5       TXBYTE: PUSH PSW
  718  02F3: DB 01    TXB1:   IN KBROWP           ; TXRDY = бит 6 (tx_idle, v39G02)
  719  02F5: E6 40            ANI 040h            ; 1 = готов принять байт (busy-запись игнор)
  720  02F7: CA F3 02         JZ TXB1
  721  02FA: F1               POP PSW
  722  02FB: D3 02            OUT TXP
  723  02FD: C9               RET
  724            
  725            ; ---------------------------------------------------------------------
  726            ; TXSTR: HL = строка с нулевым завершителем -> TX. Портит A/HL.
  727            ; ---------------------------------------------------------------------
  728  02FE: 7E       TXSTR:  MOV A,M
  729  02FF: B7               ORA A
  730  0300: C8               RZ
  731  0301: CD F2 02         CALL TXBYTE
  732  0304: 23               INX H
  733  0305: C3 FE 02         JMP TXSTR
  734            
  735            ; ---------------------------------------------------------------------
  736            ; PAUSE: пауза D итераций (v2.0.5: DCR 5T + JNZ 10T/7T -> PAUSE(n) =
  737            ; 15n+24T c CALL/RET = 4,8n+7,7 мкс; модель 14T врала на ~7%).
  738            ; ---------------------------------------------------------------------
  739  0308: 15       PAUSE:  DCR D
  740  0309: C2 08 03         JNZ PAUSE
  741  030C: C9               RET
  742            
  743            ; ---------------------------------------------------------------------
  744            ; RXD: приём байта SID 4800 8N1 (фрагмент 7 + стоп-бит). Выход:
  745            ; C = байт, CY = 0 ОК / CY = 1 обрыв кадра (стоп-бит = 0). Портит A/B/C/D.
  746            ; Цикл строгий - в режиме B таймер ЗАМАСКИРОВАН (TMOFF: DI + SIM 1Fh)
  747            ; и пульки TMIARM запрещены - джиттера нет вообще.
  748            ; Константы v2.0.5: RXHB=17/RXFB=38, пересчёт по реальным тактам
  749            ; (scripts/rxd_cycles.py). Старые 19/41 (модель 14T) давали период бита
  750            ; 691-698T = 221-223 мкс вместо 208 -> d7 на 9,02-9,09 бита (СТОП-БИТ),
  751            ; стоп на 10,10-10,16 (idle): D7 всегда читалась как 1, ':' (3Ah) ->
  752            ; BAh, стоп высокий -> "успех" -> LOADM отбрасывал все ':' = вечный
  753            ; LLLL (diag_ph: 9F на любом символе - его d7 тоже уплывал в стоп).
  754            ; Новые: d0 1,45-1,47, d7 8,42-8,49, стоп 9,43-9,50 бита. v1.2: 15/30.
  755            ; ---------------------------------------------------------------------
  756  030D: 06 08    RXD:    MVI B,08h
  757  030F: 20       RXW:    RIM                 ; A7 = SID
  758  0310: B7               ORA A
  759  0311: FA 0F 03         JM RXW              ; '1' (покой) - ждать старт-бит
  760  0314: 16 12            MVI D,RXHB          ; полбита - в середину старт-бита
  761  0316: CD 08 03         CALL PAUSE
  762  0319: 20               RIM                 ; подтвердить старт-бит
  763  031A: B7               ORA A
  764  031B: FA 0F 03         JM RXW              ; '1' - ложный старт, ждать заново
  765  031E: 0E 00            MVI C,00h
  766  0320: 16 29            MVI D,RXFB          ; бит - в середину D0
  767  0322: CD 08 03         CALL PAUSE
  768  0325: 20       RXL:    RIM                 ; A7 = SID - центр очередного бита
  769  0326: E6 80            ANI 80h
  770  0328: 07               RLC                 ; SID (A7) -> CY. ФИКС v2.0.5: было RAR(1F),
  771                                        ; но RAR берёт CY<-A0=0 и бит SID терялся;
  772                                        ; C собирался как 00h при любой линии                 ; бит -> CY
  773  0329: 79               MOV A,C
  774  032A: 1F               RAR                 ; вставить сверху (LSB-first)
  775  032B: 4F               MOV C,A
  776  032C: 16 29            MVI D,RXFB
  777  032E: CD 08 03         CALL PAUSE
  778  0331: 05               DCR B
  779  0332: C2 25 03         JNZ RXL
  780                    ; после последней итерации RXL (выборка d7 + бит задержки)
  781                    ; линия = середина стоп-бита
  782  0335: 20               RIM
  783  0336: E6 80            ANI 80h             ; CY = 0 (ANI сбрасывает перенос)
  784  0338: CA 41 03         JZ RXBAD            ; стоп-бит = 0 - обрыв кадра
  785            
  786  033B: 79               MOV A,C
  787  033C: E6 7F            ANI 7Fh             ; приводим принятый байт к чистому 7-битному ASCII (D7 = 0)
  788  033E: 4F               MOV C,A
  789            
  790  033F: B7               ORA A               ; CY = 0
  791  0340: C9               RET                 ; C = байт, CY = 0
  792                    ; СТАЛО (устойчивый приём стоп-бита на границе D7):
  793            ;        MVI B,15            ; окно ~100 мкс для дотягивания до стоп-бита
  794            ;RXST:   RIM
  795            ;        ANI 80h
  796            ;        JNZ RXOK            ; стоп-бит = 1 пойман!
  797            ;        DCR B
  798            ;        JNZ RXST
  799            ;        JMP RXBAD           ; линия застряла в 0 (реальный обрыв/Break)
  800            ;RXOK:   ORA A               ; CY = 0
  801            ;        RET                 ; C = байт, CY = 0
  802            
  803            
  804  0341: 37       RXBAD:  STC
  805  0342: C9               RET                 ; CY = 1
  806            
  807            ; ---------------------------------------------------------------------
  808            ; ---------------------------------------------------------------------
  809            ; LMODE/GETB v3: источник байтов парсера по подменю B.
  810            ;   LMODE = 0: SID 4800 (RXD, без изменений; SID = RX passthrough v39G02).
  811            ;   LMODE = 1: FAST - CPLD RXUART 2.083М. Пир шлёт КАЖДЫЙ ASCII-байт
  812            ;   записи как ПАРУ байтов 0xC0|nib (hi-тетрада первой): у 0xC0|nib
  813            ;   d6=d7=1 - дефекты RX RTL (оф-бай-ван rx=(b&7F)<<1 и фантомный
  814            ;   перезапуск, 16.18) невозможны; CPLD отдаёт 0x80|(nib<<1), nib =
  815            ;   (rx>>1)&0F. Пауза ПК >= 15 мкс между байтами пары (poll-петля 27T
  816            ;   = 8.6 мкс должна успевать до следующего кадра - иначе перезапись
  817            ;   rx_data). Собранный ASCII-байт отдаётся парсеру как есть.
  818            ; LMODE в клетке AF0 (0FFF0h): в B-режиме тетрады адреса свободны.
  819            ; ---------------------------------------------------------------------
  820            LMODE   EQU AF0             ; 0 = SID 4800, 1 = FAST (шара с AF0)
  821            
  822  0343: 3A F0 FF GETB:   LDA LMODE
  823  0346: B7               ORA A
  824  0347: CA 0D 03         JZ RXD              ; SID: C = байт, CY = 0 ОК / 1 обрыв
  825  034A: 06 02            MVI B,002h          ; --- FAST: собрать ASCII-байт из 2 nib ---
  826  034C: DB 01    GF1:    IN KBROWP
  827  034E: E6 20            ANI 020h            ; rx_ready (D5)
  828  0350: CA 4C 03         JZ GF1
  829  0353: DB 00            IN RXP              ; rx = 0x80|(nib<<1); ready снялся сам
  830  0355: 0F               RRC                 ; nib = (rx>>1)&0F
  831  0356: E6 0F            ANI 00Fh
  832  0358: 07               RLC
  833  0359: 07               RLC
  834  035A: 07               RLC
  835  035B: 07               RLC                 ; hi-тетрада -> биты 7..4
  836  035C: 4F               MOV C,A
  837  035D: DB 01    GF2:    IN KBROWP
  838  035F: E6 20            ANI 020h
  839  0361: CA 5D 03         JZ GF2
  840  0364: DB 00            IN RXP
  841  0366: 0F               RRC
  842  0367: E6 0F            ANI 00Fh
  843  0369: B1               ORA C               ; ASCII-байт (обычно ':' или тетрада-символ)
  844  036A: 4F               MOV C,A
  845  036B: B7               ORA A               ; CY = 0 (обрывов нет; тишина = вечный poll ->
  846  036C: C9               RET                 ;  выход RESET, как в SID-режиме)
  847            
  848            ; ---------------------------------------------------------------------
  849            ; NIB: A = ASCII-символ -> CY = 1 и A = тетрада 0-F ('0'-'9','A'-'F',
  850            ; 'a'-'f'), иначе CY = 0. Портит A.
  851            ; ---------------------------------------------------------------------
  852  036D: D6 30    NIB:    SUI 30h             ; '0'..'9' -> 0..9
  853  036F: DA 8D 03         JC NIBX             ; < '0'
  854  0372: FE 0A            CPI 0Ah
  855  0374: DA 8B 03         JC NIBOK            ; цифра 0..9
  856  0377: D6 07            SUI 07h             ; 'A'..'F' -> 10..15
  857  0379: FE 10            CPI 10h
  858  037B: D2 81 03         JNC NIB2            ; > 'F' - попробовать строчные a..f
  859  037E: C3 8B 03         JMP NIBOK
  860  0381: D6 20    NIB2:   SUI 20h             ; ('a'-'0')-07h-20h = 10..15
  861  0383: FE 10            CPI 10h
  862  0385: D2 8D 03         JNC NIBX
  863  0388: C3 8B 03         JMP NIBOK
  864  038B: 37       NIBOK:  STC
  865  038C: C9               RET
  866  038D: B7       NIBX:   ORA A               ; CY = 0
  867  038E: C9               RET
  868            
  869            ; ---------------------------------------------------------------------
  870            ; ---------------------------------------------------------------------
  871            ; LSTAT v3: A = глиф -> статический разряд DIG0 парой OUT в конвейер.
  872            ; Маска DIG0 = BITTBL[0] (уже с DPOL), глиф из A (уже с DPOL - caller
  873            ; берёт из GTBL/GLOOK). Промежуточное состояние между OUT ~7 мкс -
  874            ; невидимо. Такты ~55T.
  875            ; ---------------------------------------------------------------------
  876  038F: C5       LSTAT:  PUSH B
  877  0390: 47               MOV B,A             ; B = глиф (с DPOL)
  878  0391: 3A 54 00         LDA BITTBL          ; [0] = маска DIG0 (0Eh при DPOL=0)
  879  0394: D3 01            OUT DISPP           ; (1) маска DIG0
  880  0396: 78               MOV A,B
  881  0397: D3 01            OUT DISPP           ; (2) глиф: пара готова - DIG0 = глиф
  882  0399: C1               POP B
  883  039A: C9               RET
  884            
  885            ; ---------------------------------------------------------------------
  886            ; DLMS: пауза ~1,02 мс (K_MS=130 итераций 24T @320 нс = 1,002 мс).
  887            ; Портит A/B/C. H/L целы. ВНИМАНИЕ (п.3): внутри DLMS пульки TMIARM
  888            ; нет - на время паузы слоты стоят (один разряд горит ~1 мс, яркость
  889            ; не страдает - скважность 1/4 как всегда; каденция возвращается на
  890            ; следующем TMIARM-вызове).
  891            ; ---------------------------------------------------------------------
  892  039B: 01 82 00 DLMS:   LXI B,K_MS
  893  039E: 0B       DLS1:   DCX B
  894  039F: 78               MOV A,B
  895  03A0: B1               ORA C
  896  03A1: C2 9E 03         JNZ DLS1
  897  03A4: C9               RET
  898            
  899            ; ---------------------------------------------------------------------
  900            ; LDSUM: LSUM += B (mod 256). Портит A.
  901            ; ---------------------------------------------------------------------
  902  03A5: F5       LDSUM:  PUSH PSW
  903  03A6: 3A FE FF         LDA LSUM
  904  03A9: 80               ADD B
  905  03AA: 32 FE FF         STA LSUM
  906  03AD: F1               POP PSW
  907  03AE: C9               RET
  908            
  909            ; ---------------------------------------------------------------------
  910            ; LDBEEP: длинный сигнал ~0,3 с (тоггл D4 DIGP вручную: в B/F 7.5
  911            ; замаскирован (TMOFF) - ISR не пишет DIGP, конфликта нет; CALL
  912            ; TMIARM здесь не нужен (заглушка). Портит A/B/C/D.
  913            ; ---------------------------------------------------------------------
  914            ; v3: тон на SOD (SIM): C0h = SDE+SOD=1, 40h = SDE+SOD=0; MSE=0 - маски
  915            ; целы. Дисплей в B/F - статика LSTAT, конвейер не трогаем.
  916  03AF: 16 96    LDBEEP: MVI D,150
  917  03B1: 3E C0    LDB1:   MVI A,0C0h          ; SOD=1
  918  03B3: 30               SIM
  919  03B4: CD 9B 03         CALL DLMS
  920  03B7: 3E 40            MVI A,040h          ; SOD=0
  921  03B9: 30               SIM
  922  03BA: CD 9B 03         CALL DLMS
  923  03BD: 15               DCR D
  924  03BE: C2 B1 03         JNZ LDB1
  925  03C1: C9               RET
  926            
  927            ; =====================================================================
  928            ; LOADM: Intel HEX загрузчик (клавиша B). Приём SID 4800 8N1.
  929            ; Вход через KLD с TMOFF (7.5 замаскирован, DI) - как v27 по логике
  930            ; парсера. Формат записи: :nnaaaatt[dd...]cc, cc = (-сумма байт) mod 256.
  931            ; Статический дисплей 'L', после первой записи - счётчик записей mod 16
  932            ; на DIG0 (v2.0.6). Адрес каждой записи живёт в ADDRH/L.
  933            ; Запись только в ОЗУ (A15=1): попадание в ROM-окно = ошибка.
  934            ; Выход: EOF-запись (type 01) -> тик и меню; ошибка -> EEEE горит + звук
  935            ; SOS до нажатия Enter (v2.0.6), потом меню. Выход из зависшего приёма
  936            ; (тишина на SID) - RESET (SW20).
  937            ; NOTE: LACC/LNIB/LBPC/LSUM/LTY = клетки FFFB-FFFF; в обычном режиме
  938            ; FFFC-FFFF заняты KRAW (ISR) - в B маски стоят (TMOFF), конфликта нет;
  939            ; TMON на выходе чистит KRAW. XSSEQ/LST = FFFA: на входе LST=0 (=SEQ 0 -
  940            ; клиент логирует рестарт потока), на выходе TMON -> новое SEQ с 0.
  941            ; ---------------------------------------------------------------------
  942  03C2: AF       LOADM:  XRA A
  943  03C3: 32 FA FF         STA LST             ; ждем ':' (и XSSEQ = 0 - рестарт потока клиента)
  944  03C6: 32 FD FF         STA LACC            ; накопитель тетрад тоже с нуля (баг v1.0:
  945                                        ;  сталь ломала первый байт первой записи)
