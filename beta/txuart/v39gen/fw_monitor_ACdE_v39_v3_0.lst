 1485            ; DISPOFF v3: погасить дисплей парой OUT (конвейер). При DPOL=0 ("пин=1
 1486            ; горит") маска-запись 0Fh -> пины разрядов 0 (off), сегмент-запись 7Fh
 1487            ; (7 бит) -> пины сегментов 0 (off). При DPOL=1 - нули. Портит A.
 1488            ; ---------------------------------------------------------------------
 1489            DISPOFF:
 1490            IF DPOL
 1491  08DA: AF               XRA A
 1492  08DB: D3 01            OUT DISPP           ; маска 00h
 1493  08DD: D3 01            OUT DISPP           ; сегменты 00h
 1494            ELSE
 1495                    MVI A,00Fh
 1496                    OUT DISPP           ; маска 0Fh (пины разрядов = 0 = off)
 1497                    MVI A,07Fh
 1498                    OUT DISPP           ; сегменты 7Fh (7 бит, пины = 0 = off)
 1499            ENDIF
