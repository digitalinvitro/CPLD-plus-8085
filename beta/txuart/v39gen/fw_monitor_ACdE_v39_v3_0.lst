 1293            ; =====================================================================
 1294            ;                    XSTREAM: ЭКРАН -> UART (п.8: непрерывный поток,
 1295            ;                    тик кадра = сама скорость канала, регенерация/
 1296            ;                    скан ведётся пульками TMIARM внутри посылки)
 1297            ; =====================================================================
 1298            ; ---------------------------------------------------------------------
 1299            ; XSINIT (из START, только холодный старт): демо-экран в B000h,
 1300            ; SEQ = 0. Мониторные переменные не трогаются; B000-B7CF -
 1301            ; пользовательская область: ЛЮБАЯ программа может рисовать туда
 1302            ; свой текст/графику, клиент xstream_view.ps1 покажет окном.
 1303            ; ---------------------------------------------------------------------
 1304  0638: CD 5A 06 XSINIT: CALL XBLANK
 1305  063B: 21 BE 08         LXI H,XTBL
 1306  063E: 5E       XSI1:   MOV E,M             ; DE = адрес назначения
 1307  063F: 23               INX H
 1308  0640: 56               MOV D,M
 1309  0641: 23               INX H               ; HL -> src_lo
 1310  0642: 7A               MOV A,D             ; конец таблицы (dst == 0000)?
 1311  0643: B3               ORA E
 1312  0644: CA 55 06         JZ XSI3
 1313  0647: 4E               MOV C,M             ; BC = адрес строки (источник)
 1314  0648: 23               INX H
 1315  0649: 46               MOV B,M
 1316  064A: 23               INX H               ; HL -> следующая запись
 1317  064B: E5               PUSH H              ; указатель следующей записи -> стек
