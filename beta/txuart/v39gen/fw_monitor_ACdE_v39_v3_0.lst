 1161            ; ---------------------------------------------------------------------
 1162            ; SCAN1: полный скан клавиатурной матрицы (вручную - в B/F ISR стоит).
 1163            ; Логика KSCOL, но все 4 колонки за проход. Возврат: A = код клавиши
 1164            ; (KEYTBL) первой нажатой (младший ряд первенствует, как в KDL) или
 1165            ; 0FFh. Портит A/B/C/D/H/L.
 1166            ; ---------------------------------------------------------------------
 1167  0588: 0E 00    SCAN1:  MVI C,0             ; колонка 0..3
 1168  058A: 06 00    SC1:    MVI B,0
 1169  058C: 21 00 00         LXI H,BITTBL
 1170  058F: 09               DAD B               ; HL = BITTBL + колонка (DAD B = +BC)
 1171  0590: 56               MOV D,M             ; D = бит колонки (01/02/04/08)
 1172  0591: 7A               MOV A,D
 1173  0592: 07               RLC
 1174  0593: 07               RLC
 1175  0594: 07               RLC
 1176  0595: 07               RLC                 ; бит колонки -> старший ниббл
 1177  0596: D3 08            OUT KBCOLP          ; колонка заведена (A[3:0] игнорируются)
 1178  0598: CD 72 01         CALL SETTLE
