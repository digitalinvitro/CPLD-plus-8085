 1180  059D: E6 1F            ANI 1Fh             ; ряды (D7 TXRDY, D6-D5 фаза - маскируются)
 1181  059F: 47               MOV B,A             ; B = образ рядов
 1182  05A0: AF               XRA A
 1183  05A1: D3 08            OUT KBCOLP          ; колонка off
 1184  05A3: 78               MOV A,B
 1185  05A4: B7               ORA A
