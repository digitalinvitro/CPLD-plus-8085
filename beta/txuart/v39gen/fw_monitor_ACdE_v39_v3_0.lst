 1214            ; ---------------------------------------------------------------------
 1215            ; WAITENT: держим EEEE+SOS, пока не нажат Enter (K_ENT). Возврат после
 1216            ; отпускания + дебаунс 15 мс. Другие клавиши - игнор.
 1217            ; ---------------------------------------------------------------------
 1218            WAITENT:
 1219  05D1: CD 88 05 WE1:    CALL SCAN1
 1220  05D4: FE 10            CPI K_ENT
 1221  05D6: CA DC 05         JZ WE2
 1222  05D9: C3 D1 05         JMP WE1
 1223  05DC: CD 88 05 WE2:    CALL SCAN1          ; ждём отпускания
 1224  05DF: FE FF            CPI 0FFh
 1225  05E1: C2 DC 05         JNZ WE2
 1226  05E4: 16 0F            MVI D,TQ_MS         ; 15 мс дебаунс (как KRL/MNR1)
 1227  05E6: CD 80 05         CALL MSD
 1228  05E9: C9               RET
 1229            
 1230            ; =====================================================================
 1231            ; RAMT: RAM-тест 8000h-FFD7h (клавиша F). 4 паттерна 00/FF/55/AA:
 1232            ; заполнение + контроль побайтно. Статический дисплей (DIG0) = глиф
 1233            ; паттерна ("0000"/"FFFF"/"5555"/"AAAA"). Сбой: ADDRH/L = адрес сбоя,
 1234            ; EEEE + длинный сигнал. Успех: короткий тик. Вход через KRAM с TMOFF:
 1235            ; 7.5 замаскирован - ISR не толкает стек в диапазон теста.
 1236            ; ГРАНИЦА: FFD8h-FFE7h НЕ тестируется (фикс v2.0.2/tw): там живёт стек
 1237            ; монитора - собственный адрес возврата RAMT лежит в FFE7h/FFE6h, и
 1238            ; заполнение до FFE7h затирало его -> после теста RET в мусор. Стек до
 1239            ; FFD4h не доходит (RAMT без длинных push). Портит всё, кроме клеток.
 1240            ; ФИКС v2.0.2 (tw): паттерн восстанавливается из E на каждом шаге
 1241            ; (MOV A,E): в v1.2-v2.0.1 MOV A,H после INX H затирал паттерн в A и
 1242            ; с 8001h писались МЛАДШИЕ БАЙТЫ АДРЕСА -> вечная "ошибка ОЗУ".
 1243            ; ---------------------------------------------------------------------
 1244  05EA: 21 75 00 RAMT:   LXI H,RAMPAT        ; HL = текущая пара (value+glyph)
 1245  05ED: 0E 04            MVI C,04h           ; 4 паттерна
 1246  05EF: 7E       RMT0:   MOV A,M             ; A = значение паттерна
 1247  05F0: 5F               MOV E,A
 1248  05F1: E5               PUSH H              ; указатель пары - на стек (HL уйдёт под заполнение)
 1249  05F2: 23               INX H
 1250  05F3: 7E               MOV A,M             ; глиф паттерна
 1251  05F4: CD 8E 03         CALL LSTAT          ; статический дисплей ("0000" и т.д.)
 1252  05F7: 7B               MOV A,E
 1253  05F8: 21 00 80         LXI H,8000h
 1254  05FB: 7B       RMF:    MOV A,E             ; паттерн из E на КАЖДОМ шаге (фикс v2.0.2)
 1255  05FC: 77               MOV M,A             ; заполнение
 1256  05FD: 23               INX H
 1257  05FE: 7C               MOV A,H
 1258  05FF: FE FD            CPI 0FDh
 1259  0601: C2 FB 05         JNZ RMF
 1260  0604: 7D               MOV A,L
 1261  0605: FE D8            CPI 0D8h
 1262  0607: C2 FB 05         JNZ RMF
 1263  060A: 21 00 80         LXI H,8000h
 1264  060D: 7E       RMV:    MOV A,M             ; контроль (8000h..FFD7h)
 1265  060E: BB               CMP E
 1266  060F: C2 2A 06         JNZ RMBAD
 1267  0612: 23               INX H
 1268  0613: 7C               MOV A,H
 1269  0614: FE FD            CPI 0FDh
 1270  0616: C2 0D 06         JNZ RMV
 1271  0619: 7D               MOV A,L
 1272  061A: FE D8            CPI 0D8h
 1273  061C: C2 0D 06         JNZ RMV
 1274  061F: E1               POP H               ; HL = пара паттерна
 1275  0620: 23               INX H
 1276  0621: 23               INX H               ; следующая пара
 1277  0622: 0D               DCR C
 1278  0623: C2 EF 05         JNZ RMT0
 1279  0626: CD A9 01         CALL TICKON         ; ОК
 1280  0629: C9               RET
 1281  062A: 22 EB FF RMBAD:  SHLD ADDRL          ; ADDRH/L = адрес сбоя (HL из RMV, до POP!)
 1282  062D: E1               POP H               ; снять указатель пары (баланс стека)
 1283  062E: 3E 79            MVI A,79h           ; 'E' -> EEEE
 1284  0630: CD 8E 03         CALL LSTAT
 1285  0633: CD AE 03         CALL LDBEEP
 1286  0636: C9               RET                 ; в меню; D = просмотр байта по адресу сбоя
