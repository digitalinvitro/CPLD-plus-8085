 1187  05A8: 16 00            MVI D,0             ; D = номер ряда (младший установленный бит)
 1188  05AA: 78       SC2:    MOV A,B
 1189  05AB: 0F               RRC
 1190  05AC: 47               MOV B,A
 1191  05AD: DA B4 05         JC SC3
 1192  05B0: 14               INR D
 1193  05B1: C3 AA 05         JMP SC2
 1194  05B4: 7A       SC3:    MOV A,D             ; код = KEYTBL[row*4+col]
 1195  05B5: 07               RLC
 1196  05B6: 07               RLC
 1197  05B7: B1               ORA C
 1198  05B8: 4F               MOV C,A
 1199  05B9: 06 00            MVI B,0
 1200  05BB: 21 58 00         LXI H,KEYTBL
 1201  05BE: 09               DAD B
 1202  05BF: 7E               MOV A,M
 1203  05C0: FE FF            CPI 0FFh
 1204  05C2: C8               RZ                  ; пустая позиция матрицы - клавиши нет
 1205  05C3: C9               RET                 ; A = код клавиши
 1206  05C4: 0C       SCNC:   INR C
 1207  05C5: 79               MOV A,C
 1208  05C6: FE 04            CPI 04h
 1209  05C8: CA CE 05         JZ SCX
 1210  05CB: C3 8A 05         JMP SC1
 1211  05CE: 3E FF    SCX:    MVI A,0FFh          ; весь скан чист - клавиш нет
 1212  05D0: C9               RET
