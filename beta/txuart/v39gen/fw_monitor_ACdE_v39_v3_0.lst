 1219            ; ---------------------------------------------------------------------
 1220            ; WAITENT: держим EEEE+SOS, пока не нажат Enter (K_ENT). Возврат после
 1221            ; отпускания + дебаунс 15 мс. Другие клавиши - игнор.
 1222            ; ---------------------------------------------------------------------
 1223            WAITENT:
 1224  05D2: CD 89 05 WE1:    CALL SCAN1
 1225  05D5: FE 10            CPI K_ENT
 1226  05D7: CA DD 05         JZ WE2
 1227  05DA: C3 D2 05         JMP WE1
 1228  05DD: CD 89 05 WE2:    CALL SCAN1          ; ждём отпускания
 1229  05E0: FE FF            CPI 0FFh
 1230  05E2: C2 DD 05         JNZ WE2
 1231  05E5: 16 0F            MVI D,TQ_MS         ; 15 мс дебаунс (как KRL/MNR1)
 1232  05E7: CD 81 05         CALL MSD
 1233  05EA: C9               RET
 1234            
 1235            ; =====================================================================
 1236            ; RAMT: RAM-тест 8000h-FFD7h (клавиша F). 4 паттерна 00/FF/55/AA:
 1237            ; заполнение + контроль побайтно. Статический дисплей (DIG0) = глиф
 1238            ; паттерна ("0000"/"FFFF"/"5555"/"AAAA"). Сбой: ADDRH/L = адрес сбоя,
 1239            ; EEEE + длинный сигнал. Успех: короткий тик. Вход через KRAM с TMOFF:
 1240            ; 7.5 замаскирован - ISR не толкает стек в диапазон теста.
 1241            ; ГРАНИЦА: FFD8h-FFE7h НЕ тестируется (фикс v2.0.2/tw): там живёт стек
 1242            ; монитора - собственный адрес возврата RAMT лежит в FFE7h/FFE6h, и
 1243            ; заполнение до FFE7h затирало его -> после теста RET в мусор. Стек до
 1244            ; FFD4h не доходит (RAMT без длинных push). Портит всё, кроме клеток.
 1245            ; ФИКС v2.0.2 (tw): паттерн восстанавливается из E на каждом шаге
 1246            ; (MOV A,E): в v1.2-v2.0.1 MOV A,H после INX H затирал паттерн в A и
 1247            ; с 8001h писались МЛАДШИЕ БАЙТЫ АДРЕСА -> вечная "ошибка ОЗУ".
 1248            ; ---------------------------------------------------------------------
 1249  05EB: 21 75 00 RAMT:   LXI H,RAMPAT        ; HL = текущая пара (value+glyph)
 1250  05EE: 0E 04            MVI C,04h           ; 4 паттерна
 1251  05F0: 7E       RMT0:   MOV A,M             ; A = значение паттерна
 1252  05F1: 5F               MOV E,A
 1253  05F2: E5               PUSH H              ; указатель пары - на стек (HL уйдёт под заполнение)
 1254  05F3: 23               INX H
 1255  05F4: 7E               MOV A,M             ; глиф паттерна
 1256  05F5: CD 8F 03         CALL LSTAT          ; статический дисплей ("0000" и т.д.)
 1257  05F8: 7B               MOV A,E
 1258  05F9: 21 00 80         LXI H,8000h
 1259  05FC: 7B       RMF:    MOV A,E             ; паттерн из E на КАЖДОМ шаге (фикс v2.0.2)
 1260  05FD: 77               MOV M,A             ; заполнение
 1261  05FE: 23               INX H
 1262  05FF: 7C               MOV A,H
 1263  0600: FE FD            CPI 0FDh
 1264  0602: C2 FC 05         JNZ RMF
 1265  0605: 7D               MOV A,L
 1266  0606: FE D8            CPI 0D8h
 1267  0608: C2 FC 05         JNZ RMF
 1268  060B: 21 00 80         LXI H,8000h
 1269  060E: 7E       RMV:    MOV A,M             ; контроль (8000h..FFD7h)
 1270  060F: BB               CMP E
 1271  0610: C2 2B 06         JNZ RMBAD
 1272  0613: 23               INX H
 1273  0614: 7C               MOV A,H
 1274  0615: FE FD            CPI 0FDh
 1275  0617: C2 0E 06         JNZ RMV
 1276  061A: 7D               MOV A,L
 1277  061B: FE D8            CPI 0D8h
 1278  061D: C2 0E 06         JNZ RMV
 1279  0620: E1               POP H               ; HL = пара паттерна
 1280  0621: 23               INX H
 1281  0622: 23               INX H               ; следующая пара
 1282  0623: 0D               DCR C
 1283  0624: C2 F0 05         JNZ RMT0
 1284  0627: CD AA 01         CALL TICKON         ; ОК
 1285  062A: C9               RET
 1286  062B: 22 EB FF RMBAD:  SHLD ADDRL          ; ADDRH/L = адрес сбоя (HL из RMV, до POP!)
 1287  062E: E1               POP H               ; снять указатель пары (баланс стека)
 1288  062F: 3E 79            MVI A,79h           ; 'E' -> EEEE
 1289  0631: CD 8F 03         CALL LSTAT
 1290  0634: CD AF 03         CALL LDBEEP
 1291  0637: C9               RET                 ; в меню; D = просмотр байта по адресу сбоя
