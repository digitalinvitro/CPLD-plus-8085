  635  0244: CD DB 01         CALL GLOOK
  636  0247: 32 F5 FF         STA DIGIMG0
  637  024A: AF               XRA A
  638  024B: 32 F8 FF         STA DIGIMG3
  639  024E: 32 F7 FF         STA DIGIMG2
  640  0251: C3 F1 02         JMP RDRE
  641  0254: 3A EA FF RDW:    LDA ADDRH           ; ---- ST_SHOW: ADDR на 4 разрядах ----
  642  0257: 57               MOV D,A             ; D = старший байт (GLOOK портит B)
  643  0258: 0F               RRC
  644  0259: 0F               RRC
  645  025A: 0F               RRC
  646  025B: 0F               RRC
