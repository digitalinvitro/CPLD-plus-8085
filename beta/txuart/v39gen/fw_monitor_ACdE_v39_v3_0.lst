  668  0294: 32 F6 FF         STA DIGIMG1
  669  0297: 3E 79            MVI A,79h           ; 'E'
  670  0299: 32 F5 FF         STA DIGIMG0
  671  029C: C3 F0 02         JMP RDRE
  672  029F: AF       RDA:    XRA A               ; ---- ST_ADDR: последняя тетрада справа ----
  673  02A0: 32 F8 FF         STA DIGIMG3
  674  02A3: 32 F7 FF         STA DIGIMG2
  675  02A6: 32 F6 FF         STA DIGIMG1
  676  02A9: 32 F5 FF         STA DIGIMG0
