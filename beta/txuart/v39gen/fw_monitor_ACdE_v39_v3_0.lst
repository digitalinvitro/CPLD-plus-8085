 1479            ; ---------------------------------------------------------------------
 1480            ; DISPOFF v3: погасить дисплей парой OUT (конвейер). При DPOL=0 ("пин=1
 1481            ; горит") маска-запись 0Fh -> пины разрядов 0 (off), сегмент-запись 7Fh
 1482            ; (7 бит) -> пины сегментов 0 (off). При DPOL=1 - нули. Портит A.
 1483            ; ---------------------------------------------------------------------
 1484            DISPOFF:
 1485            IF DPOL
 1486                    XRA A
 1487                    OUT DISPP           ; маска 00h
 1488                    OUT DISPP           ; сегменты 00h
 1489            ELSE
 1490  08D9: 3E 0F            MVI A,00Fh
 1491  08DB: D3 01            OUT DISPP           ; маска 0Fh (пины разрядов = 0 = off)
 1492  08DD: 3E 7F            MVI A,07Fh
 1493  08DF: D3 01            OUT DISPP           ; сегменты 7Fh (7 бит, пины = 0 = off)
 1494            ENDIF
 1495  08E1: C9               RET
