  703            ; =====================================================================
  704            ; UART-канал: передача OUT 04h @1M (TXRDY = IN 03h бит 7, v1.2 Шаг-2),
  705            ; приём RIM/SID @4800 - как v27
  706            ; =====================================================================
  707            
  708            ; ---------------------------------------------------------------------
  709            ; TXBYTE: A = байт -> сериализатор CPLD (1 000 000 8N1). Ожидает TXRDY
  710            ; (запись при busy аппаратно отбрасывается). Используется баннером/строками.
  711            ; ---------------------------------------------------------------------
  712  02F1: F5       TXBYTE: PUSH PSW
  713  02F2: DB 01    TXB1:   IN KBROWP           ; TXRDY = бит 6 (tx_idle, v39G02)
  714  02F4: E6 40            ANI 040h            ; 1 = готов принять байт (busy-запись игнор)
  715  02F6: CA F2 02         JZ TXB1
  716  02F9: F1               POP PSW
  717  02FA: D3 02            OUT TXP
  718  02FC: C9               RET
  719            
  720            ; ---------------------------------------------------------------------
  721            ; TXSTR: HL = строка с нулевым завершителем -> TX. Портит A/HL.
  722            ; ---------------------------------------------------------------------
  723  02FD: 7E       TXSTR:  MOV A,M
  724  02FE: B7               ORA A
  725  02FF: C8               RZ
  726  0300: CD F1 02         CALL TXBYTE
  727  0303: 23               INX H
  728  0304: C3 FD 02         JMP TXSTR
  729            
  730            ; ---------------------------------------------------------------------
  731            ; PAUSE: пауза D итераций (v2.0.5: DCR 5T + JNZ 10T/7T -> PAUSE(n) =
  732            ; 15n+24T c CALL/RET = 4,8n+7,7 мкс; модель 14T врала на ~7%).
  733            ; ---------------------------------------------------------------------
  734  0307: 15       PAUSE:  DCR D
  735  0308: C2 07 03         JNZ PAUSE
  736  030B: C9               RET
  737            
  738            ; ---------------------------------------------------------------------
  739            ; RXD: приём байта SID 4800 8N1 (фрагмент 7 + стоп-бит). Выход:
  740            ; C = байт, CY = 0 ОК / CY = 1 обрыв кадра (стоп-бит = 0). Портит A/B/C/D.
  741            ; Цикл строгий - в режиме B таймер ЗАМАСКИРОВАН (TMOFF: DI + SIM 1Fh)
  742            ; и пульки TMIARM запрещены - джиттера нет вообще.
  743            ; Константы v2.0.5: RXHB=17/RXFB=38, пересчёт по реальным тактам
  744            ; (scripts/rxd_cycles.py). Старые 19/41 (модель 14T) давали период бита
  745            ; 691-698T = 221-223 мкс вместо 208 -> d7 на 9,02-9,09 бита (СТОП-БИТ),
  746            ; стоп на 10,10-10,16 (idle): D7 всегда читалась как 1, ':' (3Ah) ->
  747            ; BAh, стоп высокий -> "успех" -> LOADM отбрасывал все ':' = вечный
  748            ; LLLL (diag_ph: 9F на любом символе - его d7 тоже уплывал в стоп).
  749            ; Новые: d0 1,45-1,47, d7 8,42-8,49, стоп 9,43-9,50 бита. v1.2: 15/30.
  750            ; ---------------------------------------------------------------------
  751  030C: 06 08    RXD:    MVI B,08h
  752  030E: 20       RXW:    RIM                 ; A7 = SID
  753  030F: B7               ORA A
  754  0310: FA 0E 03         JM RXW              ; '1' (покой) - ждать старт-бит
  755  0313: 16 12            MVI D,RXHB          ; полбита - в середину старт-бита
  756  0315: CD 07 03         CALL PAUSE
  757  0318: 20               RIM                 ; подтвердить старт-бит
  758  0319: B7               ORA A
  759  031A: FA 0E 03         JM RXW              ; '1' - ложный старт, ждать заново
  760  031D: 0E 00            MVI C,00h
  761  031F: 16 29            MVI D,RXFB          ; бит - в середину D0
  762  0321: CD 07 03         CALL PAUSE
  763  0324: 20       RXL:    RIM                 ; A7 = SID - центр очередного бита
  764  0325: E6 80            ANI 80h
  765  0327: 07               RLC                 ; SID (A7) -> CY. ФИКС v2.0.5: было RAR(1F),
  766                                        ; но RAR берёт CY<-A0=0 и бит SID терялся;
  767                                        ; C собирался как 00h при любой линии                 ; бит -> CY
  768  0328: 79               MOV A,C
  769  0329: 1F               RAR                 ; вставить сверху (LSB-first)
  770  032A: 4F               MOV C,A
  771  032B: 16 29            MVI D,RXFB
  772  032D: CD 07 03         CALL PAUSE
  773  0330: 05               DCR B
  774  0331: C2 24 03         JNZ RXL
  775                    ; после последней итерации RXL (выборка d7 + бит задержки)
  776                    ; линия = середина стоп-бита
  777  0334: 20               RIM
  778  0335: E6 80            ANI 80h             ; CY = 0 (ANI сбрасывает перенос)
  779  0337: CA 40 03         JZ RXBAD            ; стоп-бит = 0 - обрыв кадра
  780            
  781  033A: 79               MOV A,C
  782  033B: E6 7F            ANI 7Fh             ; приводим принятый байт к чистому 7-битному ASCII (D7 = 0)
  783  033D: 4F               MOV C,A
  784            
  785  033E: B7               ORA A               ; CY = 0
  786  033F: C9               RET                 ; C = байт, CY = 0
  787                    ; СТАЛО (устойчивый приём стоп-бита на границе D7):
  788            ;        MVI B,15            ; окно ~100 мкс для дотягивания до стоп-бита
  789            ;RXST:   RIM
  790            ;        ANI 80h
  791            ;        JNZ RXOK            ; стоп-бит = 1 пойман!
  792            ;        DCR B
  793            ;        JNZ RXST
  794            ;        JMP RXBAD           ; линия застряла в 0 (реальный обрыв/Break)
  795            ;RXOK:   ORA A               ; CY = 0
  796            ;        RET                 ; C = байт, CY = 0
  797            
  798            
  799  0340: 37       RXBAD:  STC
  800  0341: C9               RET                 ; CY = 1
  801            
  802            ; ---------------------------------------------------------------------
  803            ; ---------------------------------------------------------------------
  804            ; LMODE/GETB v3: источник байтов парсера по подменю B.
  805            ;   LMODE = 0: SID 4800 (RXD, без изменений; SID = RX passthrough v39G02).
  806            ;   LMODE = 1: FAST - CPLD RXUART 2.083М. Пир шлёт КАЖДЫЙ ASCII-байт
  807            ;   записи как ПАРУ байтов 0xC0|nib (hi-тетрада первой): у 0xC0|nib
  808            ;   d6=d7=1 - дефекты RX RTL (оф-бай-ван rx=(b&7F)<<1 и фантомный
  809            ;   перезапуск, 16.18) невозможны; CPLD отдаёт 0x80|(nib<<1), nib =
  810            ;   (rx>>1)&0F. Пауза ПК >= 15 мкс между байтами пары (poll-петля 27T
  811            ;   = 8.6 мкс должна успевать до следующего кадра - иначе перезапись
  812            ;   rx_data). Собранный ASCII-байт отдаётся парсеру как есть.
  813            ; LMODE в клетке AF0 (0FFF0h): в B-режиме тетрады адреса свободны.
  814            ; ---------------------------------------------------------------------
  815            LMODE   EQU AF0             ; 0 = SID 4800, 1 = FAST (шара с AF0)
  816            
  817  0342: 3A F0 FF GETB:   LDA LMODE
  818  0345: B7               ORA A
  819  0346: CA 0C 03         JZ RXD              ; SID: C = байт, CY = 0 ОК / 1 обрыв
  820  0349: 06 02            MVI B,002h          ; --- FAST: собрать ASCII-байт из 2 nib ---
  821  034B: DB 01    GF1:    IN KBROWP
  822  034D: E6 20            ANI 020h            ; rx_ready (D5)
  823  034F: CA 4B 03         JZ GF1
  824  0352: DB 00            IN RXP              ; rx = 0x80|(nib<<1); ready снялся сам
  825  0354: 0F               RRC                 ; nib = (rx>>1)&0F
  826  0355: E6 0F            ANI 00Fh
  827  0357: 07               RLC
  828  0358: 07               RLC
  829  0359: 07               RLC
  830  035A: 07               RLC                 ; hi-тетрада -> биты 7..4
  831  035B: 4F               MOV C,A
  832  035C: DB 01    GF2:    IN KBROWP
  833  035E: E6 20            ANI 020h
  834  0360: CA 5C 03         JZ GF2
  835  0363: DB 00            IN RXP
  836  0365: 0F               RRC
  837  0366: E6 0F            ANI 00Fh
  838  0368: B1               ORA C               ; ASCII-байт (обычно ':' или тетрада-символ)
  839  0369: 4F               MOV C,A
  840  036A: B7               ORA A               ; CY = 0 (обрывов нет; тишина = вечный poll ->
  841  036B: C9               RET                 ;  выход RESET, как в SID-режиме)
  842            
  843            ; ---------------------------------------------------------------------
  844            ; NIB: A = ASCII-символ -> CY = 1 и A = тетрада 0-F ('0'-'9','A'-'F',
  845            ; 'a'-'f'), иначе CY = 0. Портит A.
  846            ; ---------------------------------------------------------------------
  847  036C: D6 30    NIB:    SUI 30h             ; '0'..'9' -> 0..9
  848  036E: DA 8C 03         JC NIBX             ; < '0'
  849  0371: FE 0A            CPI 0Ah
  850  0373: DA 8A 03         JC NIBOK            ; цифра 0..9
  851  0376: D6 07            SUI 07h             ; 'A'..'F' -> 10..15
  852  0378: FE 10            CPI 10h
  853  037A: D2 80 03         JNC NIB2            ; > 'F' - попробовать строчные a..f
  854  037D: C3 8A 03         JMP NIBOK
  855  0380: D6 20    NIB2:   SUI 20h             ; ('a'-'0')-07h-20h = 10..15
  856  0382: FE 10            CPI 10h
  857  0384: D2 8C 03         JNC NIBX
  858  0387: C3 8A 03         JMP NIBOK
  859  038A: 37       NIBOK:  STC
  860  038B: C9               RET
  861  038C: B7       NIBX:   ORA A               ; CY = 0
  862  038D: C9               RET
  863            
  864            ; ---------------------------------------------------------------------
  865            ; ---------------------------------------------------------------------
  866            ; LSTAT v3: A = глиф -> статический разряд DIG0 парой OUT в конвейер.
  867            ; Маска DIG0 = BITTBL[0] (уже с DPOL), глиф из A (уже с DPOL - caller
  868            ; берёт из GTBL/GLOOK). Промежуточное состояние между OUT ~7 мкс -
  869            ; невидимо. Такты ~55T.
  870            ; ---------------------------------------------------------------------
  871  038E: C5       LSTAT:  PUSH B
  872  038F: 47               MOV B,A             ; B = глиф (с DPOL)
  873  0390: 3A 00 00         LDA BITTBL          ; [0] = маска DIG0 (0Eh при DPOL=0)
  874  0393: D3 01            OUT DISPP           ; (1) маска DIG0
  875  0395: 78               MOV A,B
  876  0396: D3 01            OUT DISPP           ; (2) глиф: пара готова - DIG0 = глиф
  877  0398: C1               POP B
  878  0399: C9               RET
  879            
  880            ; ---------------------------------------------------------------------
  881            ; DLMS: пауза ~1,02 мс (K_MS=130 итераций 24T @320 нс = 1,002 мс).
  882            ; Портит A/B/C. H/L целы. ВНИМАНИЕ (п.3): внутри DLMS пульки TMIARM
  883            ; нет - на время паузы слоты стоят (один разряд горит ~1 мс, яркость
  884            ; не страдает - скважность 1/4 как всегда; каденция возвращается на
  885            ; следующем TMIARM-вызове).
  886            ; ---------------------------------------------------------------------
  887  039A: 01 82 00 DLMS:   LXI B,K_MS
  888  039D: 0B       DLS1:   DCX B
  889  039E: 78               MOV A,B
  890  039F: B1               ORA C
  891  03A0: C2 9D 03         JNZ DLS1
  892  03A3: C9               RET
  893            
  894            ; ---------------------------------------------------------------------
  895            ; LDSUM: LSUM += B (mod 256). Портит A.
  896            ; ---------------------------------------------------------------------
  897  03A4: F5       LDSUM:  PUSH PSW
  898  03A5: 3A FE FF         LDA LSUM
  899  03A8: 80               ADD B
  900  03A9: 32 FE FF         STA LSUM
  901  03AC: F1               POP PSW
  902  03AD: C9               RET
  903            
  904            ; ---------------------------------------------------------------------
  905            ; LDBEEP: длинный сигнал ~0,3 с (тоггл D4 DIGP вручную: в B/F 7.5
  906            ; замаскирован (TMOFF) - ISR не пишет DIGP, конфликта нет; CALL
  907            ; TMIARM здесь не нужен (заглушка). Портит A/B/C/D.
  908            ; ---------------------------------------------------------------------
  909            ; v3: тон на SOD (SIM): C0h = SDE+SOD=1, 40h = SDE+SOD=0; MSE=0 - маски
  910            ; целы. Дисплей в B/F - статика LSTAT, конвейер не трогаем.
  911  03AE: 16 96    LDBEEP: MVI D,150
  912  03B0: 3E C0    LDB1:   MVI A,0C0h          ; SOD=1
  913  03B2: 30               SIM
  914  03B3: CD 9A 03         CALL DLMS
  915  03B6: 3E 40            MVI A,040h          ; SOD=0
  916  03B8: 30               SIM
  917  03B9: CD 9A 03         CALL DLMS
  918  03BC: 15               DCR D
  919  03BD: C2 B0 03         JNZ LDB1
  920  03C0: C9               RET
  921            
  922            ; =====================================================================
  923            ; LOADM: Intel HEX загрузчик (клавиша B). Приём SID 4800 8N1.
  924            ; Вход через KLD с TMOFF (7.5 замаскирован, DI) - как v27 по логике
  925            ; парсера. Формат записи: :nnaaaatt[dd...]cc, cc = (-сумма байт) mod 256.
  926            ; Статический дисплей 'L', после первой записи - счётчик записей mod 16
  927            ; на DIG0 (v2.0.6). Адрес каждой записи живёт в ADDRH/L.
  928            ; Запись только в ОЗУ (A15=1): попадание в ROM-окно = ошибка.
  929            ; Выход: EOF-запись (type 01) -> тик и меню; ошибка -> EEEE горит + звук
  930            ; SOS до нажатия Enter (v2.0.6), потом меню. Выход из зависшего приёма
  931            ; (тишина на SID) - RESET (SW20).
  932            ; NOTE: LACC/LNIB/LBPC/LSUM/LTY = клетки FFFB-FFFF; в обычном режиме
  933            ; FFFC-FFFF заняты KRAW (ISR) - в B маски стоят (TMOFF), конфликта нет;
  934            ; TMON на выходе чистит KRAW. XSSEQ/LST = FFFA: на входе LST=0 (=SEQ 0 -
  935            ; клиент логирует рестарт потока), на выходе TMON -> новое SEQ с 0.
  936            ; ---------------------------------------------------------------------
  937  03C1: AF       LOADM:  XRA A
  938  03C2: 32 FA FF         STA LST             ; ждем ':' (и XSSEQ = 0 - рестарт потока клиента)
  939  03C5: 32 FD FF         STA LACC            ; накопитель тетрад тоже с нуля (баг v1.0:
  940                                        ;  сталь ломала первый байт первой записи)
  941  03C8: 32 F5 FF         STA LDCTR           ; v2.0.6: счётчик записей = 0 ('L' до первой)
  942  03CB: 3E 38            MVI A,38h           ; 'L'
  943  03CD: CD 8E 03         CALL LSTAT
  944            
  945  03D0: CD 42 03 LDLP:   CALL GETB           ; v3: источник по LMODE (SID 4800 / FAST 2.083М)
  946  03D3: DA 15 05         JC LDERR            ; v2.0.6: приборация этапов парсера (v2.0.5G)
  947  03D6: 79               MOV A,C             ;  удалена - байт в A и дальше по состоянию
