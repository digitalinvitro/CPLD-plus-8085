 1288            ; =====================================================================
 1289            ;                    XSTREAM: ЭКРАН -> UART (п.8: непрерывный поток,
 1290            ;                    тик кадра = сама скорость канала, регенерация/
 1291            ;                    скан ведётся пульками TMIARM внутри посылки)
 1292            ; =====================================================================
 1293            ; ---------------------------------------------------------------------
 1294            ; XSINIT (из START, только холодный старт): демо-экран в B000h,
 1295            ; SEQ = 0. Мониторные переменные не трогаются; B000-B7CF -
 1296            ; пользовательская область: ЛЮБАЯ программа может рисовать туда
 1297            ; свой текст/графику, клиент xstream_view.ps1 покажет окном.
 1298            ; ---------------------------------------------------------------------
 1299  0637: CD 59 06 XSINIT: CALL XBLANK
 1300  063A: 21 BD 08         LXI H,XTBL
 1301  063D: 5E       XSI1:   MOV E,M             ; DE = адрес назначения
 1302  063E: 23               INX H
 1303  063F: 56               MOV D,M
 1304  0640: 23               INX H               ; HL -> src_lo
 1305  0641: 7A               MOV A,D             ; конец таблицы (dst == 0000)?
 1306  0642: B3               ORA E
 1307  0643: CA 54 06         JZ XSI3
 1308  0646: 4E               MOV C,M             ; BC = адрес строки (источник)
 1309  0647: 23               INX H
 1310  0648: 46               MOV B,M
 1311  0649: 23               INX H               ; HL -> следующая запись
 1312  064A: E5               PUSH H              ; указатель следующей записи -> стек
 1313  064B: 60               MOV H,B
 1314  064C: 69               MOV L,C
 1315  064D: CD 6A 06         CALL XCPY           ; ASCIZ [HL] -> [DE], 0 = конец
 1316  0650: E1               POP H
 1317  0651: C3 3D 06         JMP XSI1
 1318  0654: AF       XSI3:   XRA A
 1319  0655: 32 FA FF         STA XSSEQ
 1320  0658: C9               RET
