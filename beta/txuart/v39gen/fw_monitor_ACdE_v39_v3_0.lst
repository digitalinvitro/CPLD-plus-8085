 1166            ; ---------------------------------------------------------------------
 1167            ; SCAN1: полный скан клавиатурной матрицы (вручную - в B/F ISR стоит).
 1168            ; Логика KSCOL, но все 4 колонки за проход. Возврат: A = код клавиши
 1169            ; (KEYTBL) первой нажатой (младший ряд первенствует, как в KDL) или
 1170            ; 0FFh. Портит A/B/C/D/H/L.
 1171            ; ---------------------------------------------------------------------
 1172  0589: 0E 00    SCAN1:  MVI C,0             ; колонка 0..3
 1173  058B: 06 00    SC1:    MVI B,0
 1174  058D: 21 54 00         LXI H,BITTBL
 1175  0590: 09               DAD B               ; HL = BITTBL + колонка (DAD B = +BC)
 1176  0591: 56               MOV D,M             ; D = бит колонки (01/02/04/08)
 1177  0592: 7A               MOV A,D
 1178  0593: 07               RLC
 1179  0594: 07               RLC
 1180  0595: 07               RLC
 1181  0596: 07               RLC                 ; бит колонки -> старший ниббл
 1182  0597: D3 08            OUT KBCOLP          ; колонка заведена (A[3:0] игнорируются)
 1183  0599: CD 73 01         CALL SETTLE
 1184  059C: DB 01            IN KBROWP
 1185  059E: E6 1F            ANI 1Fh             ; ряды (D7 TXRDY, D6-D5 фаза - маскируются)
 1186  05A0: 47               MOV B,A             ; B = образ рядов
 1187  05A1: AF               XRA A
 1188  05A2: D3 08            OUT KBCOLP          ; колонка off
 1189  05A4: 78               MOV A,B
 1190  05A5: B7               ORA A
 1191  05A6: CA C5 05         JZ SCNC             ; колонка пуста
 1192  05A9: 16 00            MVI D,0             ; D = номер ряда (младший установленный бит)
 1193  05AB: 78       SC2:    MOV A,B
 1194  05AC: 0F               RRC
 1195  05AD: 47               MOV B,A
 1196  05AE: DA B5 05         JC SC3
 1197  05B1: 14               INR D
 1198  05B2: C3 AB 05         JMP SC2
 1199  05B5: 7A       SC3:    MOV A,D             ; код = KEYTBL[row*4+col]
 1200  05B6: 07               RLC
 1201  05B7: 07               RLC
 1202  05B8: B1               ORA C
 1203  05B9: 4F               MOV C,A
 1204  05BA: 06 00            MVI B,0
 1205  05BC: 21 58 00         LXI H,KEYTBL
 1206  05BF: 09               DAD B
 1207  05C0: 7E               MOV A,M
 1208  05C1: FE FF            CPI 0FFh
 1209  05C3: C8               RZ                  ; пустая позиция матрицы - клавиши нет
 1210  05C4: C9               RET                 ; A = код клавиши
 1211  05C5: 0C       SCNC:   INR C
 1212  05C6: 79               MOV A,C
 1213  05C7: FE 04            CPI 04h
 1214  05C9: CA CF 05         JZ SCX
 1215  05CC: C3 8B 05         JMP SC1
 1216  05CF: 3E FF    SCX:    MVI A,0FFh          ; весь скан чист - клавиш нет
 1217  05D1: C9               RET
