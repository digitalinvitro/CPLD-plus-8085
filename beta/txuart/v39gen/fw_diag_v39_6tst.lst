    1            ; =====================================================================
    2            ; fw_diag_v39_6tst v1.0 (11-26): ДИАГНОСТИКА v39G02 ПО ШАГАМ ВЛАДЕЛЬЦА.
    3            ; Бенч 11-26: "8888 после сброса, тактовая/противофаза/CLKOUT есть, ALE
    4            ; появляется ненадолго и пропадает". Разбор: 8888 = СБРОСОВОЕ состояние
    5            ; конвейера (Rseg=Rdig=0 -> пины 0) => ПЛАТА АКТИВ-НИЗКАЯ (пин=0 горит),
    6            ; DPOL=1 подтверждена железом. ALE пропадает = ЦП ОСТАНОВИЛСЯ (HLT/WAIT);
    7            ; READY=1'b1 держит CPLD - заливание в WAIT исключено; HLDA/борт без
    8            ; изменений (v2.0.7 на G07 работал). Претенденты: шторм RST7.5 (8.14 кГц),
    9            ; уход исполнения в данные ('v'=76h=HLT в текстах баннера), позднее железо.
   10            ; ЭТА ПРОШИВКА БИСЕКТИРУЕТ: DI + SIM 1Fh (все маски + СБРОС защёлки 7.5)
   11            ; ПЕРВОЙ инструкцией; EI ТОЛЬКО в тесте 6; HLT нигде нет - ALE живёт во
   12            ; всех петлях. Если ALE умрёт уже на тесте 1 - прерывания НЕ при чём.
   13            ; 1. ДИСПЛЕЙ : '8' на каждом разряде по 700 мс -> скан "8888" ~2 с
   14            ; 2. ЗВУК    : 3 бипа по 100 мс (SOD/SIM, C0h/40h, MSE=0)
   15            ; 3. КЛАВИАТ.: полный скан, код клавиши (0-F) на DIG0 + тик 30 мс;
   16            ;              Enter -> шаг 4; нет клавиш 10 с -> авто-дальше
   17            ; 4. UART TX : баннер "DIAG-4 TX OK" каждые 500 мс (poll D6)
   18            ; 5. UART RX : эхо FAST-пар 0xC0|nib -> TX, счётчик mod 16 на DIG0
   19            ; 6. ТАЙМЕР  : RST7.5 (8.14 кГц) - минимальный ISR (62T), DIG0 мигает
   20            ;              '8'/пусто с периодом ~1 с (H[3]); Enter -> 'F' и DI.
   21            ; СБОРКА: python3 ../rom/asm85.py fw_diag_v39_6tst.asm -o ... -D DPOL=1
   22            ; (дефолт бенч-подтверждён; DPOL=0 - для пин=1-горит плат).
   23            ; Примитивы (пары конвейера/TX/FAST-RX) верифицированы на цикломодели
   24            ; 16.19 (sim_fw_v3_check.py ALL OK) - у диага те же последовательности.
   25            ; =====================================================================
   26            ; ---- порты v39G02 (бит-декод, ТОЛЬКО канонические) ----
   27            DISPP   EQU 01h             ; OUT: конвейер Rdig<-Rseg<-BUS (пара OUT)
   28            TXP     EQU 02h             ; OUT: TXDATA 1.0417М 8N1
   29            KBCOLP  EQU 08h             ; OUT: AD[7:4] = колонки
   30            KBROWP  EQU 01h             ; IN: D7=1, D6=tx_idle, D5=rx_ready, D4-D0=rows
   31            RXP     EQU 00h             ; IN: RXDATA = (байт&7F)<<1, чтение снимает ready
   32            ; ---- константы ----
   33            K_MS    EQU 130             ; DLMS ~1 мс (130 x 25T x 320 нс)
   34            K_ENT   EQU 10h             ; код клавиши Enter
   35            ; ---- RAM диага (стек растёт вниз от FFE7) ----
   36            TICKL   EQU 0FFE8h          ; счётчик тиков (ISR)
   37            TICKH   EQU 0FFE9h
   38            T1CL    EQU 0FFEBh          ; счётчик кадров скана шага 1
   39            T1CH    EQU 0FFECh
   40            T3CL    EQU 0FFEDh          ; счётчик таймаута шага 3
   41            T3CH    EQU 0FFEEh
   42            T5C     EQU 0FFEFh          ; счётчик принятых байтов шага 5
   43            T6P     EQU 0FFF0h          ; прошлое состояние мигания
   44            
   45            ; =====================================================================
   46  0000: -                ORG 0000h
   47  0000: F3               DI                  ; ПЕРВАЯ инструкция: прерывания запрещены
   48  0001: 3E 1F            MVI A,01Fh          ; MSE=1: маски 5.5/6.5/7.5=1 + СБРОС защёлки 7.5
   49  0003: 30               SIM
   50  0004: 31 E8 FF         LXI SP,0FFE8h
   51  0007: CD 00 00         CALL DISPOFF        ; гашение парой (после сброса горело 8888)
   52  000A: C3 3B 01         JMP T1
   53            
   54            ; =====================================================================
   55            ; RST 7.5 (003Ch): минимальный ISR 62T - только счётчик тиков.
   56            ; =====================================================================
   57  003C: -                ORG 003Ch
   58  003C: F5               PUSH PSW
   59  003D: 3A E8 FF         LDA TICKL
   60  0040: 3C               INR A
   61  0041: 32 E8 FF         STA TICKL
   62  0044: C2 4E 00         JNZ T6I
   63  0047: 3A E9 FF         LDA TICKH
   64  004A: 3C               INR A
   65  004B: 32 E9 FF         STA TICKH
   66  004E: F1       T6I:    POP PSW
   67  004F: FB               EI
   68  0050: C9               RET
   69            
   70            ; ---------------------------------------------------------------------
   71            ; DISPOFF: погасить дисплей парой OUT. DPOL=1 (пин=0 горит): маска 00 ->
   72            ; пины разрядов F (никто не выбран), сегмент 00 -> пины 7F (все off).
   73            ; ---------------------------------------------------------------------
   74            DISPOFF:
   75            IF DPOL
   76  0051: AF               XRA A
   77  0052: D3 01            OUT DISPP
   78  0054: D3 01            OUT DISPP
   79            ELSE
   80                    MVI A,00Fh
   81                    OUT DISPP
   82                    MVI A,07Fh
   83                    OUT DISPP
   84            ENDIF
   85  0056: C9               RET
   86            
   87            ; ---------------------------------------------------------------------
   88            ; BLK0: пусто на DIG0 парой (маска DIG0 активна, сегменты все off).
   89            ; ---------------------------------------------------------------------
   90            BLK0:   IF DPOL
   91  0057: 3E 01            MVI A,001h          ; маска DIG0 (пин=0 = выбран)
   92  0059: D3 01            OUT DISPP
   93  005B: AF               XRA A               ; глиф 00 -> пины 7F = все off
   94  005C: D3 01            OUT DISPP
   95            ELSE
   96                    MVI A,00Eh
   97                    OUT DISPP
   98                    MVI A,07Fh
   99                    OUT DISPP
  100            ENDIF
  101  005E: C9               RET
  102            
  103            ; ---------------------------------------------------------------------
  104            ; GLOOK: A = тетрада 0..F -> A = глиф (GTBL, уже с полярностью DPOL).
  105            ; ---------------------------------------------------------------------
  106  005F: 4F       GLOOK:  MOV C,A
  107  0060: 06 00            MVI B,0
  108  0062: 21 E0 02         LXI H,GTBL
  109  0065: 09               DAD B
  110  0066: 7E               MOV A,M
  111  0067: C9               RET
  112            
  113            ; ---------------------------------------------------------------------
  114            ; SHOW: D = индекс разряда 0..3 (DIG0 правый), A = глиф -> ПАРА OUT.
  115            ; Портит D/E (вход D одноразовый).
  116            ; ---------------------------------------------------------------------
  117  0068: C5       SHOW:   PUSH B
  118  0069: 47               MOV B,A             ; B = глиф
  119  006A: 7A               MOV A,D
  120  006B: 5F               MOV E,A
  121  006C: 16 00            MVI D,0
  122  006E: 21 F0 02         LXI H,BITTBL
  123  0071: 19               DAD D
  124  0072: 7E               MOV A,M             ; A = маска разряда (с DPOL)
  125  0073: D3 01            OUT DISPP           ; (1) маска
  126  0075: 78               MOV A,B
  127  0076: D3 01            OUT DISPP           ; (2) глиф: пара готова
  128  0078: C1               POP B
  129  0079: C9               RET
  130            
  131            ; ---------------------------------------------------------------------
  132            ; DLMS: ~1 мс (CPU-цикл, от прерываний не зависит). DLMSN: B = мс.
  133            ; PAUS: ~200 мкс. Портят B/C.
  134            ; ---------------------------------------------------------------------
  135  007A: 01 82 00 DLMS:   LXI B,K_MS
  136  007D: 0B       DLS1:   DCX B
  137  007E: 78               MOV A,B
  138  007F: B1               ORA C
  139  0080: C2 7D 00         JNZ DLS1
  140  0083: C9               RET
  141  0084: C5       DLMSN:  PUSH B
  142  0085: C5       DLN1:   PUSH B
  143  0086: CD 7A 00         CALL DLMS
  144  0089: C1               POP B
  145  008A: 05               DCR B
  146  008B: C2 85 00         JNZ DLN1
  147  008E: C1               POP B
  148  008F: C9               RET
  149  0090: 01 19 00 PAUS:   LXI B,25
  150  0093: 0B       PL1:    DCX B
  151  0094: 78               MOV A,B
  152  0095: B1               ORA C
  153  0096: C2 93 00         JNZ PL1
  154  0099: C9               RET
  155            
  156            ; ---------------------------------------------------------------------
  157            ; TXBYTE: A = байт -> poll tx_idle (D6) -> OUT TXP (1.0417М 8N1).
  158            ; ---------------------------------------------------------------------
  159  009A: C5       TXBYTE: PUSH B
  160  009B: 4F               MOV C,A
  161  009C: DB 01    TXB1:   IN KBROWP
  162  009E: E6 40            ANI 040h            ; tx_idle (D6, v39G02)
  163  00A0: CA 9C 00         JZ TXB1
  164  00A3: 79               MOV A,C
  165  00A4: D3 02            OUT TXP
  166  00A6: C1               POP B
  167  00A7: C9               RET
  168            
  169            ; ---------------------------------------------------------------------
  170            ; TXS: HL = строка (0-терминатор) -> TX. Портит A/H/L.
  171            ; ---------------------------------------------------------------------
  172  00A8: 7E       TXS:    MOV A,M
  173  00A9: B7               ORA A
  174  00AA: C8               RZ
  175  00AB: CD 9A 00         CALL TXBYTE
  176  00AE: 23               INX H
  177  00AF: C3 A8 00         JMP TXS
  178            
  179            ; ---------------------------------------------------------------------
  180            ; GETBF: FAST-приём байта из пары 0xC0|nib (CPLD RXUART 2.083М).
  181            ; C = ASCII-байт. Poll rx_ready (D5) -> IN RXP -> nib=(rx>>1)&0F.
  182            ; ---------------------------------------------------------------------
  183  00B2: 06 02    GETBF:  MVI B,002h
  184  00B4: DB 01    GF1:    IN KBROWP
  185  00B6: E6 20            ANI 020h
  186  00B8: CA B4 00         JZ GF1
  187  00BB: DB 00            IN RXP
  188  00BD: 0F               RRC
  189  00BE: E6 0F            ANI 00Fh
  190  00C0: 07               RLC
  191  00C1: 07               RLC
  192  00C2: 07               RLC
  193  00C3: 07               RLC
  194  00C4: 4F               MOV C,A
  195  00C5: DB 01    GF2:    IN KBROWP
  196  00C7: E6 20            ANI 020h
  197  00C9: CA C5 00         JZ GF2
  198  00CC: DB 00            IN RXP
  199  00CE: 0F               RRC
  200  00CF: E6 0F            ANI 00Fh
  201  00D1: B1               ORA C
  202  00D2: 4F               MOV C,A
  203  00D3: C9               RET
  204            
  205            ; ---------------------------------------------------------------------
  206            ; SETTLE: ~26 мкс (заведение рядов). SCAN1: полный скан 4 колонок;
  207            ; A = код клавиши (KEYTBL) или FF. Портит A/B/C/D/H/L.
  208            ; ---------------------------------------------------------------------
  209  00D4: 01 03 00 SETTLE: LXI B,3
  210  00D7: 0B       STL:    DCX B
  211  00D8: 78               MOV A,B
  212  00D9: B1               ORA C
  213  00DA: C2 D7 00         JNZ STL
  214  00DD: C9               RET
  215  00DE: 0E 00    SCAN1:  MVI C,0
  216  00E0: 06 00    SC1:    MVI B,0
  217  00E2: 21 F0 02         LXI H,BITTBL
  218  00E5: 09               DAD B
  219  00E6: 56               MOV D,M             ; бит колонки (01,02,04,08 - с DPOL)
  220  00E7: 7A               MOV A,D
  221  00E8: 07               RLC
  222  00E9: 07               RLC
  223  00EA: 07               RLC
  224  00EB: 07               RLC                 ; бит колонки -> старший ниббл
  225  00EC: D3 08            OUT KBCOLP          ; колонка заведена
  226  00EE: CD D4 00         CALL SETTLE
  227  00F1: DB 01            IN KBROWP
  228  00F3: E6 1F            ANI 01Fh            ; ряды
  229  00F5: 47               MOV B,A
  230  00F6: AF               XRA A
  231  00F7: D3 08            OUT KBCOLP          ; колонка off
  232  00F9: 78               MOV A,B
  233  00FA: B7               ORA A
  234  00FB: CA 1A 01         JZ SCNC
  235  00FE: 16 00            MVI D,0
  236  0100: 78       SC2:    MOV A,B
  237  0101: 0F               RRC
  238  0102: 47               MOV B,A
  239  0103: DA 0A 01         JC SC3
  240  0106: 14               INR D
  241  0107: C3 00 01         JMP SC2
  242  010A: 7A       SC3:    MOV A,D
  243  010B: 07               RLC
  244  010C: 07               RLC
  245  010D: B1               ORA C
  246  010E: 4F               MOV C,A
  247  010F: 06 00            MVI B,0
  248  0111: 21 F4 02         LXI H,KEYTBL
  249  0114: 09               DAD B
  250  0115: 7E               MOV A,M
  251  0116: FE FF            CPI 0FFh
  252  0118: C8               RZ
  253  0119: C9               RET
  254  011A: 0C       SCNC:   INR C
  255  011B: 79               MOV A,C
  256  011C: FE 04            CPI 4
  257  011E: CA 24 01         JZ SCX
  258  0121: C3 E0 00         JMP SC1
  259  0124: 3E FF    SCX:    MVI A,0FFh
  260  0126: C9               RET
  261            
  262            ; ---------------------------------------------------------------------
  263            ; TIK: короткий бип 30 мс (SOD/SIM). Портит A/D.
  264            ; ---------------------------------------------------------------------
  265  0127: 3E C0    TIK:    MVI A,0C0h          ; SDE=1, SOD=1, MSE=0 - маски целы
  266  0129: 30               SIM
  267  012A: 06 1E            MVI B,30
  268  012C: CD 84 00         CALL DLMSN
  269  012F: 3E 40            MVI A,040h          ; SOD=0
  270  0131: 30               SIM
  271  0132: C9               RET
  272            
  273            ; ---------------------------------------------------------------------
  274            ; NUM3: A = номер шага 0..F -> 'F'-глиф на DIG3 (индикация шага).
  275            ; ---------------------------------------------------------------------
  276  0133: CD 5F 00 NUM3:   CALL GLOOK
  277  0136: 16 03            MVI D,3
  278  0138: C3 68 00         JMP SHOW            ; хвост: (D=3, A=глиф)
  279            
  280            ; =====================================================================
  281            ; ШАГ 1: ТЕСТ ДИСПЛЕЯ. '8' на каждом разряде по 700 мс (видно каждый),
  282            ; затем программный скан "8888" ~2 с (кадр ~900 мкс, 1.1 кГц).
  283            ; Всё статикой/сканом CPU, прерываний нет - ALE живёт.
  284            ; =====================================================================
  285  013B: 3E 01    T1:     MVI A,1
  286  013D: CD 33 01         CALL NUM3           ; '1' на DIG3
  287  0140: 16 00            MVI D,0
  288  0142: 3E 08    T1L:    MVI A,8
  289  0144: CD 5F 00         CALL GLOOK          ; глиф '8' (все сегменты)
  290  0147: CD 68 00         CALL SHOW           ; '8' на разряде D (портит D/E!)
  291  014A: 1E 07            MVI E,7             ; 7 x 100 мс = 700 мс
  292  014C: 06 64    T1W:    MVI B,100
  293  014E: CD 84 00         CALL DLMSN
  294  0151: 1D               DCR E
  295  0152: C2 4C 01         JNZ T1W
  296  0155: 14               INR D
  297  0156: 7A               MOV A,D
  298  0157: FE 04            CPI 4
  299  0159: CA 5F 01         JZ T1B
  300  015C: C3 42 01         JMP T1L
  301  015F: AF       T1B:    XRA A               ; --- скан "8888" ~2 с ---
  302  0160: 32 EB FF         STA T1CL
  303  0163: 32 EC FF         STA T1CH
  304  0166: 16 00    T1S:    MVI D,0
  305  0168: 3E 08    T1C:    MVI A,8
  306  016A: CD 5F 00         CALL GLOOK
  307  016D: CD 68 00         CALL SHOW
  308  0170: CD 90 00         CALL PAUS           ; ~200 мкс на разряд
  309  0173: 14               INR D
  310  0174: 7A               MOV A,D
  311  0175: FE 04            CPI 4
  312  0177: C2 68 01         JNZ T1C
  313  017A: 3A EB FF         LDA T1CL            ; счётчик кадров (16 бит)
  314  017D: 3C               INR A
  315  017E: 32 EB FF         STA T1CL
  316  0181: C2 66 01         JNZ T1S
  317  0184: 3A EC FF         LDA T1CH
  318  0187: 3C               INR A
  319  0188: 32 EC FF         STA T1CH
  320  018B: FE 09            CPI 9               ; ~9x256 кадров x 0.9 мс = ~2.1 с
  321  018D: DA 66 01         JC T1S
  322  0190: C3 93 01         JMP T2
  323            
  324            ; =====================================================================
  325            ; ШАГ 2: ТЕСТ ЗВУКА. '2' на DIG3, 3 бипа по 100 мс (SOD/SIM).
  326            ; =====================================================================
  327  0193: 3E 02    T2:     MVI A,2
  328  0195: CD 33 01         CALL NUM3
  329  0198: 1E 06            MVI E,6             ; 6 x 100 мс = 600 мс пауза перед бипами
  330  019A: 06 64    T2W:    MVI B,100
  331  019C: CD 84 00         CALL DLMSN
  332  019F: 1D               DCR E
  333  01A0: C2 9A 01         JNZ T2W
  334  01A3: 1E 03            MVI E,3
  335  01A5: 3E C0    T2L:    MVI A,0C0h          ; SOD=1 (SDE=1, MSE=0)
  336  01A7: 30               SIM
  337  01A8: 06 64            MVI B,100
  338  01AA: CD 84 00         CALL DLMSN
  339  01AD: 3E 40            MVI A,040h          ; SOD=0
  340  01AF: 30               SIM
  341  01B0: 06 64            MVI B,100
  342  01B2: CD 84 00         CALL DLMSN
  343  01B5: 1D               DCR E
  344  01B6: C2 A5 01         JNZ T2L
  345  01B9: 1E 04            MVI E,4             ; 4 x 100 мс пауза перед шагом 3
  346  01BB: 06 64    T2X:    MVI B,100
  347  01BD: CD 84 00         CALL DLMSN
  348  01C0: 1D               DCR E
  349  01C1: C2 BB 01         JNZ T2X
  350  01C4: C3 C7 01         JMP T3
  351            
  352            ; =====================================================================
  353            ; ШАГ 3: ТЕСТ КЛАВИАТУРЫ. '3' на DIG3; код клавиши (0-F) на DIG0 + тик;
  354            ; Enter -> шаг 4; 10 с без клавиш -> авто-дальше.
  355            ; =====================================================================
  356  01C7: 3E 03    T3:     MVI A,3
  357  01C9: CD 33 01         CALL NUM3
  358  01CC: AF               XRA A
  359  01CD: 32 ED FF         STA T3CL
  360  01D0: 32 EE FF         STA T3CH
  361  01D3: CD DE 00 T3L:    CALL SCAN1
  362  01D6: FE FF            CPI 0FFh
  363  01D8: CA EB 01         JZ T3T              ; пусто - тик таймаута
  364  01DB: FE 10            CPI 10h
  365  01DD: CA 18 02         JZ T4               ; Enter - дальше
  366  01E0: CD 5F 00         CALL GLOOK          ; глиф кода клавиши (0..F)
  367  01E3: 16 00            MVI D,0
  368  01E5: CD 68 00         CALL SHOW           ; код на DIG0
  369  01E8: CD 27 01         CALL TIK            ; подтверждение бипом
  370  01EB: 06 14    T3T:    MVI B,20            ; 20 мс тик
  371  01ED: CD 84 00         CALL DLMSN
  372  01F0: 3A ED FF         LDA T3CL
  373  01F3: 3C               INR A
  374  01F4: 32 ED FF         STA T3CL
  375  01F7: C2 D3 01         JNZ T3L
  376  01FA: 3A EE FF         LDA T3CH
  377  01FD: 3C               INR A
  378  01FE: 32 EE FF         STA T3CH
  379  0201: FE 02            CPI 2               ; 512 x 20.5 мс = ~10.5 с
  380  0203: C2 D3 01         JNZ T3L
  381  0206: C3 18 02         JMP T4              ; таймаут: клавиатура мертва - идём дальше
  382            
  383            ; =====================================================================
  384            ; ШАГ 4: ТЕСТ ПЕРЕДАЧИ UART. '4' на DIG3; баннер каждые 500 мс;
  385            ; терминал 1000000 8N1. Enter -> шаг 5.
  386            ; =====================================================================
  387  0209: 44 49 41 47 2D 34 20 54 58 20 4F 4B 0D 0A 00 S_B4:   DB 'DIAG-4 TX OK',0Dh,0Ah,00h
  388  0218: 3E 04    T4:     MVI A,4
  389  021A: CD 33 01         CALL NUM3
  390  021D: 21 09 02         LXI H,S_B4
  391  0220: CD A8 00         CALL TXS
  392  0223: 1E 05    T4L:    MVI E,5             ; 5 x 100 мс = 500 мс между баннерами
  393  0225: 06 64    T4W:    MVI B,100
  394  0227: CD 84 00         CALL DLMSN
  395  022A: 1D               DCR E
  396  022B: C2 25 02         JNZ T4W
  397  022E: CD DE 00         CALL SCAN1
  398  0231: FE 10            CPI 10h
  399  0233: CA 50 02         JZ T5
  400  0236: 21 09 02         LXI H,S_B4
  401  0239: CD A8 00         CALL TXS
  402  023C: C3 23 02         JMP T4L
  403            
  404            ; =====================================================================
  405            ; ШАГ 5: ТЕСТ ПРИЁМА UART. '5' на DIG3; эхо FAST-байта -> TX,
  406            ; счётчик mod 16 на DIG0. Пир: fw_load_fast.ps1 (пары 0xC0|nib).
  407            ; Enter -> шаг 6.
  408            ; =====================================================================
  409  023F: 44 49 41 47 2D 35 20 52 58 20 45 43 48 4F 0D 0A 00 S_B5:   DB 'DIAG-5 RX ECHO',0Dh,0Ah,00h
  410  0250: 3E 05    T5:     MVI A,5
  411  0252: CD 33 01         CALL NUM3
  412  0255: 21 3F 02         LXI H,S_B5
  413  0258: CD A8 00         CALL TXS
  414  025B: AF               XRA A
  415  025C: 32 EF FF         STA T5C
  416  025F: CD B2 00 T5L:    CALL GETBF          ; C = принятый ASCII-байт
  417  0262: 79               MOV A,C
  418  0263: CD 9A 00         CALL TXBYTE         ; ЭХО -> терминал
  419  0266: 3A EF FF         LDA T5C             ; счётчик mod 16 на DIG0
  420  0269: 3C               INR A
  421  026A: 32 EF FF         STA T5C
  422  026D: E6 0F            ANI 00Fh
  423  026F: CD 5F 00         CALL GLOOK
  424  0272: 16 00            MVI D,0
  425  0274: CD 68 00         CALL SHOW
  426  0277: CD DE 00         CALL SCAN1
  427  027A: FE 10            CPI 10h
  428  027C: CA 82 02         JZ T6
  429  027F: C3 5F 02         JMP T5L
  430            
  431            ; =====================================================================
  432            ; ШАГ 6: ТЕСТ ИНТЕРВАЛЬНОГО ТАЙМЕРА. ЕДИНСТВЕННОЕ место с EI: RST7.5
  433            ; (tmr_cnt[6], фронт раз в 122.88 мкс) -> минимальный ISR (62T) тикает
  434            ; 16-бит счётчик; DIG0 мигает '8'/пусто с периодом ~0.5 с (H[3]:
  435            ; тоггл каждые 8 инкр H = 251 мс). Enter -> DI + 'F' на DIG3.
  436            ; =====================================================================
  437  0282: 3E 06    T6:     MVI A,6
  438  0284: CD 33 01         CALL NUM3
  439  0287: AF               XRA A
  440  0288: 32 E8 FF         STA TICKL
  441  028B: 32 E9 FF         STA TICKH
  442  028E: 32 F0 FF         STA T6P
  443  0291: 3E 08            MVI A,8
  444  0293: CD 5F 00         CALL GLOOK
  445  0296: 16 00            MVI D,0
  446  0298: CD 68 00         CALL SHOW           ; '8' на DIG0 - стартовое состояние
  447  029B: 3E 3B            MVI A,03Bh          ; MSE=1: 5.5/6.5 маскированы, 7.5 СНЯТ,
  448  029D: 30               SIM                 ;  защёлка 7.5 сброшена
  449  029E: FB               EI                  ; ЕДИНСТВЕННЫЙ EI диага
  450  029F: 3A E9 FF T6L:    LDA TICKH
  451  02A2: E6 08            ANI 008h            ; H[3] - тоггл ~0.5 с
  452  02A4: 47               MOV B,A
  453  02A5: 3A F0 FF         LDA T6P
  454  02A8: B8               CMP B
  455  02A9: CA C4 02         JZ T6K
  456  02AC: 78               MOV A,B
  457  02AD: 32 F0 FF         STA T6P
  458  02B0: B7               ORA A
  459  02B1: CA C1 02         JZ T6Z              ; стал 0 - погасить DIG0
  460  02B4: 3E 08            MVI A,8
  461  02B6: CD 5F 00         CALL GLOOK
  462  02B9: 16 00            MVI D,0
  463  02BB: CD 68 00         CALL SHOW
  464  02BE: C3 C4 02         JMP T6K
  465  02C1: CD 00 00 T6Z:    CALL BLK0
  466  02C4: CD DE 00 T6K:    CALL SCAN1
  467  02C7: FE 10            CPI 10h
  468  02C9: CA CF 02         JZ T6X
  469  02CC: C3 9F 02         JMP T6L
  470  02CF: F3       T6X:    DI
  471  02D0: 3E 1F            MVI A,01Fh          ; все маски + сброс защёлки
  472  02D2: 30               SIM
  473  02D3: 3E 0F    FIN:    MVI A,0Fh
  474  02D5: CD 5F 00         CALL GLOOK
  475  02D8: 16 03            MVI D,3
  476  02DA: CD 68 00         CALL SHOW           ; 'F' на DIG3 - все шаги пройдены
  477  02DD: C3 DD 02 FINL:   JMP FINL            ; idle без HLT - ALE живёт
  478            
  479            ; =====================================================================
  480            ; Таблицы (полярность DPOL: регистр v39 хранит ~AD; при DPOL=1 запись
  481            ; как есть - пин=0 горит; при DPOL=0 - инверсия 127-G / 15-M).
  482            ; =====================================================================
  483            IF DPOL
  484  02E0: 3F       GTBL:   DB 3Fh              ; '0'
  485  02E1: 06               DB 06h              ; '1'
  486  02E2: 5B               DB 5Bh              ; '2'
  487  02E3: 4F               DB 4Fh              ; '3'
  488  02E4: 66               DB 66h              ; '4'
  489  02E5: 6D               DB 6Dh              ; '5'
  490  02E6: 7D               DB 7Dh              ; '6'
  491  02E7: 07               DB 07h              ; '7'
  492  02E8: 7F               DB 7Fh              ; '8'
  493  02E9: 6F               DB 6Fh              ; '9'
  494  02EA: 77               DB 77h              ; 'A'
  495  02EB: 7C               DB 7Ch              ; 'b'
  496  02EC: 39               DB 39h              ; 'C'
  497  02ED: 5E               DB 5Eh              ; 'd'
  498  02EE: 79               DB 79h              ; 'E'
  499  02EF: 71               DB 71h              ; 'F'
  500            ELSE
  501            GTBL:   DB 127-3Fh
  502                    DB 127-06h
  503                    DB 127-5Bh
  504                    DB 127-4Fh
  505                    DB 127-66h
  506                    DB 127-6Dh
  507                    DB 127-7Dh
  508                    DB 127-07h
  509                    DB 127-7Fh
  510                    DB 127-6Fh
  511                    DB 127-77h
  512                    DB 127-7Ch
  513                    DB 127-39h
  514                    DB 127-5Eh
  515                    DB 127-79h
  516                    DB 127-71h
  517            ENDIF
  518            IF DPOL
  519  02F0: 01 02 04 08 BITTBL: DB 01h,02h,04h,08h  ; маска выбранного разряда (пин=0 горит)
  520            ELSE
  521            BITTBL: DB 0Eh,0Dh,0Bh,07h
  522            ENDIF
  523  02F4: 0A 0B 0C 0D KEYTBL: DB 0Ah,0Bh,0Ch,0Dh  ; row0: A  B  C  D
  524  02F8: 07 08 09 0E         DB 07h,08h,09h,0Eh  ; row1: 7  8  9  E
  525  02FC: 04 05 06 0F         DB 04h,05h,06h,0Fh  ; row2: 4  5  6  F
  526  0300: 01 02 03 10         DB 01h,02h,03h,10h  ; row3: 1  2  3  Enter
  527  0304: 00 11 12 FF         DB 00h,11h,12h,0FFh ; row4: 0  F1 F2 (нет)
  528            
  529  0308: -                END
