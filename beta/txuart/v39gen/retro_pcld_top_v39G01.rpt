*******************************  Equations  ********************************

********** Mapped Logic **********


$OpTx$FX_DC$465 <= (ALE AND NOT state_FSM_FFd1 AND NOT state_FSM_FFd2 AND 
	state_FSM_FFd3);


$OpTx$FX_DC$471 <= (IOM AND NOT state_FSM_FFd1 AND state_FSM_FFd2 AND 
	NOT state_FSM_FFd3 AND addr_latch(0) AND NOT WRn);


A_I(0) <= ((addr_latch(0) AND NOT rd_drive/rd_drive_D2)
	OR (D(0) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (D(0) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (IOM AND addr_latch(0) AND row0));
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(1) <= ((addr_latch(1) AND NOT rd_drive/rd_drive_D2)
	OR (D(1) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (D(1) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (IOM AND addr_latch(0) AND row1 AND 
	rd_drive/rd_drive_D2));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
A_OE(1) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(2) <= ((addr_latch(2) AND NOT rd_drive/rd_drive_D2)
	OR (D(2) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (D(2) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (IOM AND addr_latch(0) AND row2 AND 
	rd_drive/rd_drive_D2));
A(2) <= A_I(2) when A_OE(2) = '1' else 'Z';
A_OE(2) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(3) <= ((addr_latch(3) AND NOT rd_drive/rd_drive_D2)
	OR (D(3) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (D(3) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (IOM AND addr_latch(0) AND row3 AND 
	rd_drive/rd_drive_D2));
A(3) <= A_I(3) when A_OE(3) = '1' else 'Z';
A_OE(3) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(4) <= ((addr_latch(4) AND NOT rd_drive/rd_drive_D2)
	OR (D(4) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (D(4) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (IOM AND addr_latch(0) AND row4 AND 
	rd_drive/rd_drive_D2));
A(4) <= A_I(4) when A_OE(4) = '1' else 'Z';
A_OE(4) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(5) <= ((addr_latch(5) AND NOT rd_drive/rd_drive_D2)
	OR (D(5) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (D(5) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (IOM AND addr_latch(0) AND rx_ready AND 
	rd_drive/rd_drive_D2));
A(5) <= A_I(5) when A_OE(5) = '1' else 'Z';
A_OE(5) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(6) <= ((addr_latch(6) AND NOT rd_drive/rd_drive_D2)
	OR (D(6) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (D(6) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (IOM AND addr_latch(0) AND NOT u_txuart/tx_busy_q AND 
	rd_drive/rd_drive_D2));
A(6) <= A_I(6) when A_OE(6) = '1' else 'Z';
A_OE(6) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(7) <= NOT (((NOT addr_latch(7) AND NOT rd_drive/rd_drive_D2)
	OR (NOT D(7) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (NOT D(7) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)));
A(7) <= A_I(7) when A_OE(7) = '1' else 'Z';
A_OE(7) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_7_IOBUFE/A_7_IOBUFE_TRST <= (NOT bus_reg(7)/bus_reg(7)_TRST AND NOT rd_drive/rd_drive_D2);


CS1 <= '1';


CS_n <= NOT (((NOT IOM AND A15)
	OR (state_FSM_FFd1 AND state_FSM_FFd2)
	OR (state_FSM_FFd1 AND state_FSM_FFd3)));


CSr_n <= NOT ((NOT IOM AND NOT A15));

FDCPE_D0: FDCPE port map (D_I(0),D(0),clk,RST,'0');
D(0) <= ((bus_ld_mem AND D(0).PIN)
	OR (NOT bus_ld_mem AND NOT u_rxuart/rx_shreg_n(0) AND bus_ld_rx)
	OR (D(0) AND NOT bus_ld_mem AND NOT bus_ld_rx AND NOT bus_ld_wr)
	OR (NOT bus_ld_mem AND NOT bus_ld_rx AND A(0).PIN AND bus_ld_wr));
