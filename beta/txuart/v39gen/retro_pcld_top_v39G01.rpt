	OR (D(1) AND NOT bus_ld_mem AND NOT bus_ld_rx AND NOT bus_ld_wr)
	OR (NOT bus_ld_mem AND NOT bus_ld_rx AND A(1).PIN AND bus_ld_wr));
D(1) <= D_I(1) when D_OE(1) = '1' else 'Z';
