D_D(3)_BUFR <= ((bus_ld_mem AND D(3).PIN)
	OR (NOT bus_ld_mem AND NOT u_rxuart/rx_shreg_n(3) AND bus_ld_rx)
	OR (D(3) AND NOT bus_ld_mem AND NOT bus_ld_rx AND NOT bus_ld_wr)
	OR (NOT bus_ld_mem AND NOT bus_ld_rx AND A(3).PIN AND bus_ld_wr));


