*******************************  Equations  ********************************

********** Mapped Logic **********


A_I(0) <= ((addr_latch(0).LFBK AND NOT rd_drive/rd_drive_D2.LFBK)
	OR (IOM AND row0 AND addr_latch(0).LFBK)
	OR (NOT IOM AND bus_reg(0).LFBK AND 
	rd_drive/rd_drive_D2.LFBK)
	OR (bus_reg(0).LFBK AND NOT addr_latch(0).LFBK AND 
	rd_drive/rd_drive_D2.LFBK));
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(1) <= ((addr_latch(1) AND NOT rd_drive/rd_drive_D2.LFBK)
	OR (D(1) AND NOT IOM AND rd_drive/rd_drive_D2.LFBK)
	OR (D(1) AND NOT addr_latch(0).LFBK AND 
	rd_drive/rd_drive_D2.LFBK)
	OR (IOM AND row1 AND addr_latch(0).LFBK AND 
	rd_drive/rd_drive_D2.LFBK));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
A_OE(1) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(2) <= ((addr_latch(2) AND NOT rd_drive/rd_drive_D2.LFBK)
	OR (D(2) AND NOT IOM AND rd_drive/rd_drive_D2.LFBK)
	OR (D(2) AND NOT addr_latch(0).LFBK AND 
	rd_drive/rd_drive_D2.LFBK)
	OR (IOM AND row2 AND addr_latch(0).LFBK AND 
	rd_drive/rd_drive_D2.LFBK));
A(2) <= A_I(2) when A_OE(2) = '1' else 'Z';
A_OE(2) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(3) <= ((addr_latch(3) AND NOT rd_drive/rd_drive_D2.LFBK)
	OR (D(3) AND NOT IOM AND rd_drive/rd_drive_D2.LFBK)
	OR (D(3) AND NOT addr_latch(0).LFBK AND 
	rd_drive/rd_drive_D2.LFBK)
	OR (IOM AND row3 AND addr_latch(0).LFBK AND 
	rd_drive/rd_drive_D2.LFBK));
A(3) <= A_I(3) when A_OE(3) = '1' else 'Z';
A_OE(3) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(4) <= ((addr_latch(4) AND NOT rd_drive/rd_drive_D2.LFBK)
	OR (D(4) AND NOT IOM AND rd_drive/rd_drive_D2.LFBK)
	OR (D(4) AND NOT addr_latch(0).LFBK AND 
	rd_drive/rd_drive_D2.LFBK)
	OR (IOM AND row4 AND addr_latch(0).LFBK AND 
	rd_drive/rd_drive_D2.LFBK));
A(4) <= A_I(4) when A_OE(4) = '1' else 'Z';
A_OE(4) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(5) <= ((NOT rd_drive/rd_drive_D2 AND addr_latch(5).LFBK)
	OR (D(5) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (D(5) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (addr_latch(0) AND rx_ready AND IOM AND 
	rd_drive/rd_drive_D2));
A(5) <= A_I(5) when A_OE(5) = '1' else 'Z';
A_OE(5) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(6) <= ((NOT rd_drive/rd_drive_D2 AND addr_latch(6).LFBK)
	OR (D(6) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (D(6) AND NOT IOM AND rd_drive/rd_drive_D2)
	OR (addr_latch(0) AND NOT u_txuart/tx_busy_q AND IOM AND 
	rd_drive/rd_drive_D2));
A(6) <= A_I(6) when A_OE(6) = '1' else 'Z';
A_OE(6) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(7) <= NOT (((NOT rd_drive/rd_drive_D2 AND NOT addr_latch(7).LFBK)
	OR (NOT D(7) AND NOT addr_latch(0) AND rd_drive/rd_drive_D2)
	OR (NOT D(7) AND NOT IOM AND rd_drive/rd_drive_D2)));
A(7) <= A_I(7) when A_OE(7) = '1' else 'Z';
A_OE(7) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_7_IOBUFE/A_7_IOBUFE_TRST <= (NOT bus_reg(7)/bus_reg(7)_TRST.LFBK AND 
	NOT rd_drive/rd_drive_D2.LFBK);


CS1 <= '1';


CS_n <= NOT (((state_FSM_FFd1 AND state_FSM_FFd3)
	OR (state_FSM_FFd1 AND state_FSM_FFd2.LFBK)
	OR (NOT IOM AND A15)));


CSr_n <= NOT ((NOT IOM AND NOT A15));

FDCPE_D0: FDCPE port map (D_I(0),D(0),clk,RST,'0');
D(0) <= ((D(0).PIN AND bus_ld_mem.LFBK)
	OR (NOT u_rxuart/rx_shreg_n(0) AND bus_ld_rx AND 
	NOT bus_ld_mem.LFBK)
	OR (NOT bus_ld_rx AND A(0).PIN AND bus_ld_wr AND 
	NOT bus_ld_mem.LFBK)
	OR (NOT bus_ld_rx AND NOT bus_ld_wr AND NOT bus_ld_mem.LFBK AND 
	bus_reg(0).LFBK));
D(0) <= D_I(0) when D_OE(0) = '1' else 'Z';
D_OE(0) <= bus_reg(7)/bus_reg(7)_TRST.LFBK;

FDCPE_D1: FDCPE port map (D_I(1),D(1),clk,RST,'0');
D(1) <= ((bus_ld_mem AND D(1).PIN)
	OR (NOT u_rxuart/rx_shreg_n(1) AND NOT bus_ld_mem AND bus_ld_rx)
	OR (NOT bus_ld_mem AND NOT bus_ld_rx AND A(1).PIN AND 
	bus_ld_wr.LFBK)
	OR (NOT bus_ld_mem AND NOT bus_ld_rx AND bus_reg(1).LFBK AND 
	NOT bus_ld_wr.LFBK));
D(1) <= D_I(1) when D_OE(1) = '1' else 'Z';
D_OE(1) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D2_BUFR: FDCPE port map (D(2)_BUFR,D_D(2)_BUFR,clk,RST,'0');
D_D(2)_BUFR <= ((bus_ld_mem AND D(2).PIN)
	OR (NOT bus_ld_mem AND bus_ld_rx AND 
	NOT u_rxuart/rx_shreg_n(2).LFBK)
	OR (D(2) AND NOT bus_ld_mem AND NOT bus_ld_rx AND NOT bus_ld_wr)
	OR (NOT bus_ld_mem AND NOT bus_ld_rx AND A(2).PIN AND bus_ld_wr));


D_I(2) <= D(2)_BUFR;
D(2) <= D_I(2) when D_OE(2) = '1' else 'Z';
D_OE(2) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D3_BUFR: FDCPE port map (D(3)_BUFR,D_D(3)_BUFR,clk,RST,'0');
D_D(3)_BUFR <= ((bus_ld_mem AND D(3).PIN)
	OR (NOT bus_ld_mem AND bus_ld_rx AND 
	NOT u_rxuart/rx_shreg_n(3).LFBK)
	OR (D(3) AND NOT bus_ld_mem AND NOT bus_ld_rx AND NOT bus_ld_wr)
	OR (NOT bus_ld_mem AND NOT bus_ld_rx AND A(3).PIN AND bus_ld_wr));


D_I(3) <= D(3)_BUFR;
D(3) <= D_I(3) when D_OE(3) = '1' else 'Z';
D_OE(3) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D4_BUFR: FDCPE port map (D(4)_BUFR,D_D(4)_BUFR,clk,RST,'0');
D_D(4)_BUFR <= ((bus_ld_mem AND D(4).PIN)
	OR (NOT u_rxuart/rx_shreg_n(4) AND NOT bus_ld_mem AND bus_ld_rx)
	OR (D(4) AND NOT bus_ld_mem AND NOT bus_ld_rx AND NOT bus_ld_wr)
	OR (NOT bus_ld_mem AND NOT bus_ld_rx AND A(4).PIN AND bus_ld_wr));


D_I(4) <= D(4)_BUFR;
D(4) <= D_I(4) when D_OE(4) = '1' else 'Z';
D_OE(4) <= bus_reg(7)/bus_reg(7)_TRST;


D_I(5) <= D(5)_BUFR;
D(5) <= D_I(5) when D_OE(5) = '1' else 'Z';
D_OE(5) <= bus_reg(7)/bus_reg(7)_TRST;

FDCPE_D5_BUFR: FDCPE port map (D(5)_BUFR,D_D(5)_BUFR,clk,RST,'0');
D_D(5)_BUFR <= ((bus_ld_mem AND D(5).PIN)
	OR (NOT u_rxuart/rx_shreg_n(5) AND NOT bus_ld_mem AND bus_ld_rx)
	OR (D(5) AND NOT bus_ld_mem AND NOT bus_ld_rx AND NOT bus_ld_wr)
	OR (NOT bus_ld_mem AND NOT bus_ld_rx AND A(5).PIN AND bus_ld_wr));

FDCPE_D6: FDCPE port map (D_I(6),D(6),clk,RST,'0');
D(6) <= ((D(6).PIN AND bus_ld_mem.LFBK)
	OR (NOT u_rxuart/rx_shreg_n(6) AND bus_ld_rx AND 
	NOT bus_ld_mem.LFBK)
	OR (NOT bus_ld_rx AND A(6).PIN AND bus_ld_wr AND 
	NOT bus_ld_mem.LFBK)
	OR (NOT bus_ld_rx AND NOT bus_ld_wr AND NOT bus_ld_mem.LFBK AND 
	bus_reg(6).LFBK));
D(6) <= D_I(6) when D_OE(6) = '1' else 'Z';
D_OE(6) <= bus_reg(7)/bus_reg(7)_TRST.LFBK;


D_I(7) <= D(7)_BUFR;
D(7) <= D_I(7) when D_OE(7) = '1' else 'Z';
D_OE(7) <= bus_reg(7)/bus_reg(7)_TRST.LFBK;

FDCPE_D7_BUFR: FDCPE port map (D(7)_BUFR,D_D(7)_BUFR,clk,RST,'0');
D_D(7)_BUFR <= ((bus_ld_mem AND D(7).PIN)
	OR (NOT u_rxuart/rx_shreg_n(7) AND NOT bus_ld_mem AND bus_ld_rx)
	OR (D(7) AND NOT bus_ld_mem AND NOT bus_ld_rx AND NOT bus_ld_wr)
	OR (NOT bus_ld_mem AND NOT bus_ld_rx AND A(7).PIN AND bus_ld_wr));


OE_n <= NOT (((NOT state_FSM_FFd1 AND NOT state_FSM_FFd2 AND NOT IOM AND A15)
	OR (NOT state_FSM_FFd1 AND state_FSM_FFd3 AND NOT IOM AND A15)));


OEr_n <= NOT (((NOT state_FSM_FFd1 AND state_FSM_FFd3 AND NOT IOM AND NOT A15)
	OR (NOT state_FSM_FFd1 AND NOT IOM AND NOT A15 AND 
	NOT state_FSM_FFd2.LFBK)));


READY <= '1';

FTCPE_RESET_IN: FTCPE port map (RESET_IN,RESET_IN_T,CLKOUT,RST,'0');
RESET_IN_T <= (NOT RESET_IN_OBUF.LFBK AND u_reset_cpu/tt(0).LFBK AND 
	u_reset_cpu/tt(1).LFBK);

FTCPE_RST75: FTCPE port map (RST75,RST75_T,clk,RST,'0');
RST75_T <= (tmr_cnt(0) AND tmr_cnt(1) AND tx_baud_tick AND 
	tmr_cnt(2).LFBK AND tmr_cnt(3).LFBK AND tmr_cnt(4).LFBK AND 
	tmr_cnt(5).LFBK);


SID <= RX;


SND <= SOD;

FDCPE_TX: FDCPE port map (TX,TX_D,clk,'0',RST);
TX_D <= ((NOT u_txuart/shreg_n(1) AND tx_baud_tick AND 
	NOT u_txuart/load)
	OR (NOT tx_baud_tick AND NOT u_txuart/load AND TX_OBUF.LFBK));


WE_n <= NOT ((state_FSM_FFd1 AND state_FSM_FFd2.LFBK));

FTCPE_X1: FTCPE port map (X1,t0_q,clk,'0','0');

FTCPE_X2: FTCPE port map (X2,t0_q,clk,'0','0');

FTCPE_addr_latch0: FTCPE port map (addr_latch(0),addr_latch_T(0),clk,RST,'0');
addr_latch_T(0) <= ((NOT state_FSM_FFd1 AND state_FSM_FFd3 AND ALE AND 
	A(0).PIN AND NOT addr_latch(0).LFBK AND NOT state_FSM_FFd2.LFBK)
	OR (NOT state_FSM_FFd1 AND state_FSM_FFd3 AND ALE AND 
	NOT A(0).PIN AND addr_latch(0).LFBK AND NOT state_FSM_FFd2.LFBK));

FTCPE_addr_latch1: FTCPE port map (addr_latch(1),addr_latch_T(1),clk,RST,'0');
addr_latch_T(1) <= ((NOT state_FSM_FFd2 AND ALE AND A(1).PIN AND 
	NOT state_FSM_FFd1.LFBK AND state_FSM_FFd3.LFBK AND NOT addr_latch(1).LFBK)
	OR (NOT state_FSM_FFd2 AND ALE AND NOT A(1).PIN AND 
	NOT state_FSM_FFd1.LFBK AND state_FSM_FFd3.LFBK AND addr_latch(1).LFBK));

FTCPE_addr_latch2: FTCPE port map (addr_latch(2),addr_latch_T(2),clk,RST,'0');
addr_latch_T(2) <= ((NOT state_FSM_FFd1 AND NOT state_FSM_FFd2 AND state_FSM_FFd3 AND 
	ALE AND A(2).PIN AND NOT addr_latch(2).LFBK)
	OR (NOT state_FSM_FFd1 AND NOT state_FSM_FFd2 AND state_FSM_FFd3 AND 
	ALE AND NOT A(2).PIN AND addr_latch(2).LFBK));

FTCPE_addr_latch3: FTCPE port map (addr_latch(3),addr_latch_T(3),clk,RST,'0');
addr_latch_T(3) <= ((NOT state_FSM_FFd1 AND NOT state_FSM_FFd2 AND state_FSM_FFd3 AND 
	ALE AND A(3).PIN AND NOT addr_latch(3).LFBK)
	OR (NOT state_FSM_FFd1 AND NOT state_FSM_FFd2 AND state_FSM_FFd3 AND 
	ALE AND NOT A(3).PIN AND addr_latch(3).LFBK));

FTCPE_addr_latch4: FTCPE port map (addr_latch(4),addr_latch_T(4),clk,RST,'0');
addr_latch_T(4) <= ((NOT state_FSM_FFd1 AND NOT state_FSM_FFd2 AND state_FSM_FFd3 AND 
	ALE AND A(4).PIN AND NOT addr_latch(4).LFBK)
	OR (NOT state_FSM_FFd1 AND NOT state_FSM_FFd2 AND state_FSM_FFd3 AND 
	ALE AND NOT A(4).PIN AND addr_latch(4).LFBK));

FTCPE_addr_latch5: FTCPE port map (addr_latch(5),addr_latch_T(5),clk,RST,'0');
addr_latch_T(5) <= ((NOT state_FSM_FFd2 AND ALE AND A(5).PIN AND 
	NOT addr_latch(5).LFBK AND NOT state_FSM_FFd1.LFBK AND state_FSM_FFd3.LFBK)
	OR (NOT state_FSM_FFd2 AND ALE AND NOT A(5).PIN AND 
	addr_latch(5).LFBK AND NOT state_FSM_FFd1.LFBK AND state_FSM_FFd3.LFBK));

FTCPE_addr_latch6: FTCPE port map (addr_latch(6),addr_latch_T(6),clk,RST,'0');
addr_latch_T(6) <= ((NOT state_FSM_FFd2 AND ALE AND A(6).PIN AND 
	NOT addr_latch(6).LFBK AND NOT state_FSM_FFd1.LFBK AND state_FSM_FFd3.LFBK)
	OR (NOT state_FSM_FFd2 AND ALE AND NOT A(6).PIN AND 
	addr_latch(6).LFBK AND NOT state_FSM_FFd1.LFBK AND state_FSM_FFd3.LFBK));

FTCPE_addr_latch7: FTCPE port map (addr_latch(7),addr_latch_T(7),clk,RST,'0');
addr_latch_T(7) <= ((NOT state_FSM_FFd2 AND ALE AND A(7).PIN AND 
	NOT addr_latch(7).LFBK AND NOT state_FSM_FFd1.LFBK AND state_FSM_FFd3.LFBK)
	OR (NOT state_FSM_FFd2 AND ALE AND NOT A(7).PIN AND 
	addr_latch(7).LFBK AND NOT state_FSM_FFd1.LFBK AND state_FSM_FFd3.LFBK));


bus_ld_mem <= (NOT state_FSM_FFd1 AND NOT IOM AND NOT RDn AND 
	state_FSM_FFd2.LFBK);


bus_ld_rx <= (NOT state_FSM_FFd1 AND state_FSM_FFd2 AND NOT addr_latch(0) AND 
	IOM AND NOT RDn);


bus_ld_wr <= ((state_FSM_FFd1 AND NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	NOT WRn)
	OR (NOT state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	NOT WRn));


bus_reg(7)/bus_reg(7)_TRST <= ((state_FSM_FFd1 AND state_FSM_FFd3)
	OR (state_FSM_FFd1 AND state_FSM_FFd2.LFBK)
	OR (NOT state_FSM_FFd1 AND NOT state_FSM_FFd3 AND NOT ALE AND 
	NOT state_FSM_FFd2.LFBK));

FTCPE_col0: FTCPE port map (col0,col0_T,clk,RST,'0');
col0_T <= ((NOT state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	addr_latch(3) AND NOT WRn AND IOM AND A(4).PIN AND NOT kbcol_q(0).LFBK)
	OR (NOT state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	addr_latch(3) AND NOT WRn AND IOM AND NOT A(4).PIN AND kbcol_q(0).LFBK));

FTCPE_col1: FTCPE port map (col1,col1_T,clk,RST,'0');
col1_T <= ((NOT state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	addr_latch(3) AND NOT WRn AND IOM AND A(5).PIN AND NOT kbcol_q(1).LFBK)
	OR (NOT state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	addr_latch(3) AND NOT WRn AND IOM AND NOT A(5).PIN AND kbcol_q(1).LFBK));

FTCPE_col2: FTCPE port map (col2,col2_T,clk,RST,'0');
col2_T <= ((NOT state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	addr_latch(3) AND NOT WRn AND IOM AND A(6).PIN AND NOT kbcol_q(2).LFBK)
	OR (NOT state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	addr_latch(3) AND NOT WRn AND IOM AND NOT A(6).PIN AND kbcol_q(2).LFBK));

FTCPE_col3: FTCPE port map (col3,col3_T,clk,RST,'0');
col3_T <= ((NOT state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	addr_latch(3) AND NOT WRn AND IOM AND A(7).PIN AND NOT kbcol_q(3).LFBK)
	OR (NOT state_FSM_FFd1 AND state_FSM_FFd2 AND NOT state_FSM_FFd3 AND 
	addr_latch(3) AND NOT WRn AND IOM AND NOT A(7).PIN AND kbcol_q(3).LFBK));

FDCPE_dig0: FDCPE port map (dig(0),dig_D(0),clk,RST,'0');
dig_D(0) <= ((dig_0_OBUF.LFBK AND NOT io_wr_disp/io_wr_disp_D2.LFBK)
	OR (io_wr_disp/io_wr_disp_D2.LFBK AND seg(0).PIN));

FDCPE_dig1: FDCPE port map (dig(1),dig_D(1),clk,RST,'0');
dig_D(1) <= ((io_wr_disp/io_wr_disp_D2 AND seg_1_OBUF.LFBK)
	OR (NOT io_wr_disp/io_wr_disp_D2 AND dig_1_OBUF.LFBK));

FDCPE_dig2: FDCPE port map (dig(2),dig_D(2),clk,RST,'0');
dig_D(2) <= ((io_wr_disp/io_wr_disp_D2 AND seg_2_OBUF.LFBK)
	OR (NOT io_wr_disp/io_wr_disp_D2 AND dig_2_OBUF.LFBK));

FDCPE_dig3: FDCPE port map (dig(3),dig_D(3),clk,RST,'0');
dig_D(3) <= ((io_wr_disp/io_wr_disp_D2 AND seg_3_OBUF.LFBK)
	OR (NOT io_wr_disp/io_wr_disp_D2 AND dig_3_OBUF.LFBK));


io_wr_disp/io_wr_disp_D2 <= (state_FSM_FFd2 AND addr_latch(0) AND NOT WRn AND IOM AND 
	NOT state_FSM_FFd1.LFBK AND NOT state_FSM_FFd3.LFBK);


rd_drive/rd_drive_D2 <= (NOT state_FSM_FFd1 AND NOT ALE AND NOT RDn AND 
	state_FSM_FFd2.LFBK);

FDCPE_rx_ready: FDCPE port map (rx_ready,rx_ready_D,clk,RST,'0');
rx_ready_D <= ((u_rxuart/rx_busy AND u_rxuart/rx_shreg_n(0) AND t0_q AND 
	u_rxuart/os_cnt(0).LFBK AND NOT u_rxuart/os_cnt(1).LFBK AND u_rxuart/os_cnt(2).LFBK)
	OR (state_FSM_FFd1 AND rx_ready.LFBK)
	OR (NOT state_FSM_FFd2 AND rx_ready.LFBK)
	OR (NOT state_FSM_FFd3 AND rx_ready.LFBK)
	OR (addr_latch(0) AND rx_ready.LFBK)
	OR (NOT IOM AND rx_ready.LFBK)
	OR (NOT RDn AND rx_ready.LFBK));

FDCPE_seg0: FDCPE port map (seg(0),seg_D(0),clk,RST,'0');
seg_D(0) <= ((NOT A(0).PIN AND io_wr_disp/io_wr_disp_D2)
	OR (NOT io_wr_disp/io_wr_disp_D2 AND seg_0_OBUF.LFBK));

FDCPE_seg1: FDCPE port map (seg(1),seg_D(1),clk,RST,'0');
seg_D(1) <= ((NOT A(1).PIN AND io_wr_disp/io_wr_disp_D2)
	OR (NOT io_wr_disp/io_wr_disp_D2 AND seg_1_OBUF.LFBK));

FDCPE_seg2: FDCPE port map (seg(2),seg_D(2),clk,RST,'0');
seg_D(2) <= ((NOT A(2).PIN AND io_wr_disp/io_wr_disp_D2)
	OR (NOT io_wr_disp/io_wr_disp_D2 AND seg_2_OBUF.LFBK));

FDCPE_seg3: FDCPE port map (seg(3),seg_D(3),clk,RST,'0');
seg_D(3) <= ((NOT A(3).PIN AND io_wr_disp/io_wr_disp_D2)
	OR (NOT io_wr_disp/io_wr_disp_D2 AND seg_3_OBUF.LFBK));

FDCPE_seg4: FDCPE port map (seg(4),seg_D(4),clk,RST,'0');
seg_D(4) <= ((NOT A(4).PIN AND io_wr_disp/io_wr_disp_D2)
	OR (NOT io_wr_disp/io_wr_disp_D2 AND seg_4_OBUF.LFBK));

FDCPE_seg5: FDCPE port map (seg(5),seg_D(5),clk,RST,'0');
seg_D(5) <= ((NOT A(5).PIN AND io_wr_disp/io_wr_disp_D2)
	OR (NOT io_wr_disp/io_wr_disp_D2 AND seg_5_OBUF.LFBK));

FDCPE_seg6: FDCPE port map (seg(6),seg_D(6),clk,RST,'0');
seg_D(6) <= ((NOT A(6).PIN AND io_wr_disp/io_wr_disp_D2.LFBK)
	OR (NOT io_wr_disp/io_wr_disp_D2.LFBK AND seg_6_OBUF.LFBK));


seg(7) <= '1';

FTCPE_state_FSM_FFd1: FTCPE port map (state_FSM_FFd1,state_FSM_FFd1_T,clk,RST,'0');
state_FSM_FFd1_T <= ((state_FSM_FFd2 AND state_FSM_FFd1.LFBK AND 
	state_FSM_FFd3.LFBK)
	OR (state_FSM_FFd2 AND NOT WRn AND RDn AND 
	NOT state_FSM_FFd1.LFBK AND NOT state_FSM_FFd3.LFBK)
	OR (NOT state_FSM_FFd2 AND WRn AND IOM AND 
	state_FSM_FFd1.LFBK AND NOT state_FSM_FFd3.LFBK)
	OR (NOT state_FSM_FFd2 AND WRn AND NOT A15 AND 
	state_FSM_FFd1.LFBK AND NOT state_FSM_FFd3.LFBK));

FTCPE_state_FSM_FFd2: FTCPE port map (state_FSM_FFd2,state_FSM_FFd2_T,clk,RST,'0');
state_FSM_FFd2_T <= ((state_FSM_FFd1 AND state_FSM_FFd3)
	OR (NOT state_FSM_FFd1 AND RDn AND state_FSM_FFd2.LFBK)
	OR (state_FSM_FFd3 AND NOT ALE AND NOT state_FSM_FFd2.LFBK));

FDCPE_state_FSM_FFd3: FDCPE port map (state_FSM_FFd3,state_FSM_FFd3_D,clk,RST,'0');
state_FSM_FFd3_D <= ((state_FSM_FFd2 AND NOT RDn AND NOT state_FSM_FFd1.LFBK)
	OR (state_FSM_FFd2 AND state_FSM_FFd1.LFBK AND 
	NOT state_FSM_FFd3.LFBK)
	OR (NOT state_FSM_FFd2 AND ALE AND NOT state_FSM_FFd1.LFBK)
	OR (WRn AND NOT IOM AND A15 AND state_FSM_FFd1.LFBK AND 
	NOT state_FSM_FFd3.LFBK));

FTCPE_t0_q: FTCPE port map (t0_q,'1',clk,'0','0');

FTCPE_tmr_cnt0: FTCPE port map (tmr_cnt(0),tx_baud_tick,clk,RST,'0');

FTCPE_tmr_cnt1: FTCPE port map (tmr_cnt(1),FC_1_.OUT,clk,RST,'0');

FTCPE_tmr_cnt2: FTCPE port map (tmr_cnt(2),tmr_cnt_T(2),clk,RST,'0');
tmr_cnt_T(2) <= (tmr_cnt(0) AND tmr_cnt(1) AND tx_baud_tick);

FTCPE_tmr_cnt3: FTCPE port map (tmr_cnt(3),tmr_cnt_T(3),clk,RST,'0');
tmr_cnt_T(3) <= (tmr_cnt(0) AND tmr_cnt(1) AND tx_baud_tick AND 
	tmr_cnt(2).LFBK);

FTCPE_tmr_cnt4: FTCPE port map (tmr_cnt(4),tmr_cnt_T(4),clk,RST,'0');
tmr_cnt_T(4) <= (tmr_cnt(0) AND tmr_cnt(1) AND tx_baud_tick AND 
	tmr_cnt(2).LFBK AND tmr_cnt(3).LFBK);

FTCPE_tmr_cnt5: FTCPE port map (tmr_cnt(5),tmr_cnt_T(5),clk,RST,'0');
tmr_cnt_T(5) <= (tmr_cnt(0) AND tmr_cnt(1) AND tx_baud_tick AND 
	tmr_cnt(2).LFBK AND tmr_cnt(3).LFBK AND tmr_cnt(4).LFBK);


tx_baud_tick <= (u_txuart/ck_q AND FC_0_.OUT);

FTCPE_u_reset_cpu/tt0: FTCPE port map (u_reset_cpu/tt(0),RESET_IN_OBUF.LFBK,CLKOUT,RST,'0');

FTCPE_u_reset_cpu/tt1: FTCPE port map (u_reset_cpu/tt(1),u_reset_cpu/tt_T(1),CLKOUT,RST,'0');
u_reset_cpu/tt_T(1) <= (NOT RESET_IN_OBUF.LFBK AND u_reset_cpu/tt(0).LFBK);


u_rxuart/N01/u_rxuart/N01_D2 <= ((NOT u_rxuart/rx_busy AND NOT RX)
	OR (u_rxuart/rx_busy AND t0_q AND 
	u_rxuart/os_cnt(0).LFBK AND NOT u_rxuart/os_cnt(1).LFBK AND u_rxuart/os_cnt(2).LFBK));

FTCPE_u_rxuart/os_cnt0: FTCPE port map (u_rxuart/os_cnt(0),u_rxuart/os_cnt_T(0),clk,RST,'0');
u_rxuart/os_cnt_T(0) <= ((u_rxuart/rx_busy AND t0_q)
	OR (NOT u_rxuart/rx_busy AND NOT RX AND NOT u_rxuart/os_cnt(0).LFBK));

FTCPE_u_rxuart/os_cnt1: FTCPE port map (u_rxuart/os_cnt(1),u_rxuart/os_cnt_T(1),clk,RST,'0');
u_rxuart/os_cnt_T(1) <= ((NOT u_rxuart/rx_busy AND NOT RX AND NOT u_rxuart/os_cnt(1).LFBK)
	OR (u_rxuart/rx_busy AND t0_q AND 
	u_rxuart/os_cnt(0).LFBK AND u_rxuart/os_cnt(1).LFBK)
	OR (u_rxuart/rx_busy AND t0_q AND 
	u_rxuart/os_cnt(0).LFBK AND NOT u_rxuart/os_cnt(2).LFBK));

FTCPE_u_rxuart/os_cnt2: FTCPE port map (u_rxuart/os_cnt(2),u_rxuart/os_cnt_T(2),clk,RST,'0');
u_rxuart/os_cnt_T(2) <= ((NOT u_rxuart/rx_busy AND NOT RX AND u_rxuart/os_cnt(2).LFBK)
	OR (u_rxuart/rx_busy AND t0_q AND 
	u_rxuart/os_cnt(0).LFBK AND u_rxuart/os_cnt(1).LFBK)
	OR (u_rxuart/rx_busy AND t0_q AND 
	u_rxuart/os_cnt(0).LFBK AND u_rxuart/os_cnt(2).LFBK));

FDCPE_u_rxuart/rx_busy: FDCPE port map (u_rxuart/rx_busy,u_rxuart/rx_busy_D,clk,RST,'0');
u_rxuart/rx_busy_D <= ((NOT u_rxuart/N01/u_rxuart/N01_D2 AND 
	NOT u_rxuart/rx_busy.LFBK)
	OR (NOT u_rxuart/os_cnt(0) AND RX AND NOT u_rxuart/rx_busy.LFBK)
	OR (u_rxuart/os_cnt(0) AND t0_q AND 
	u_rxuart/N01/u_rxuart/N01_D2 AND u_rxuart/rx_busy.LFBK AND 
	u_rxuart/rx_shreg_n(0).LFBK)
	OR (NOT u_rxuart/os_cnt(0) AND NOT t0_q AND 
