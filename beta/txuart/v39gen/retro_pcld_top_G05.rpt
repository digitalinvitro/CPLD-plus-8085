********** Mapped Logic **********


$OpTx$FX_DC$43 <= (NOT RDn AND NOT ALE AND NOT state_FSM_FFd1 AND state_FSM_FFd2);


$OpTx$FX_DC$48 <= ((NOT IOM)
	OR (NOT addr_latch(0).LFBK AND NOT addr_latch(1).LFBK AND 
	NOT addr_latch(2).LFBK AND NOT addr_latch(3) AND NOT addr_latch(4) AND NOT addr_latch(5) AND 
	NOT addr_latch(6).LFBK AND NOT addr_latch(7)));


$OpTx$FX_DC$51 <= ((NOT u_rxuart/rx_busy AND NOT RX)
	OR (u_rxuart/rx_busy AND NOT u_rxuart/os_cnt(1) AND 
	t0_q.LFBK AND u_rxuart/os_cnt(0).LFBK AND u_rxuart/os_cnt(2).LFBK));


$OpTx$FX_DC$52 <= (ALE AND NOT state_FSM_FFd1 AND NOT state_FSM_FFd2 AND 
	state_FSM_FFd3);


A_I(0) <= ((addr_latch(0) AND NOT $OpTx$FX_DC$43)
	OR (row0 AND $OpTx$FX_DC$43 AND NOT $OpTx$FX_DC$48)
	OR ($OpTx$FX_DC$43 AND $OpTx$FX_DC$48 AND 
	bus_reg(0).LFBK));
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(1) <= ((addr_latch(1) AND NOT $OpTx$FX_DC$43)
	OR (D(1) AND $OpTx$FX_DC$43 AND $OpTx$FX_DC$48)
	OR (row1 AND $OpTx$FX_DC$43 AND NOT $OpTx$FX_DC$48));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
A_OE(1) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST.LFBK;


A_I(2) <= ((addr_latch(2) AND NOT $OpTx$FX_DC$43)
	OR (D(2) AND $OpTx$FX_DC$43 AND $OpTx$FX_DC$48)
