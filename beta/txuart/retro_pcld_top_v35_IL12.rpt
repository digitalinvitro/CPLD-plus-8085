*******************************  Equations  ********************************

********** Mapped Logic **********


$OpTx$FX_DC$115 <= (NOT state_FSM_FFd2 AND ALE AND FC_1_.OUT);


$OpTx$FX_DC$116 <= (NOT addr_latch(0) AND NOT addr_latch(1) AND NOT addr_latch(2) AND 
	io_wr);


A_I(0) <= ((D(0) AND NOT IOM AND rd_drive)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND row0)
	OR (addr_latch(0) AND NOT rd_drive)
	OR (D(0) AND NOT addr_latch(0) AND rd_drive)
	OR (D(0) AND NOT addr_latch(1) AND rd_drive)
	OR (D(0) AND addr_latch(2) AND rd_drive));
A(0) <= A_I(0) when A_OE(0) = '1' else 'Z';
A_OE(0) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(1) <= ((D(1) AND NOT IOM AND rd_drive)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND row1)
	OR (addr_latch(1) AND NOT rd_drive)
	OR (D(1) AND NOT addr_latch(0) AND rd_drive)
	OR (D(1) AND NOT addr_latch(1) AND rd_drive)
	OR (D(1) AND addr_latch(2) AND rd_drive));
A(1) <= A_I(1) when A_OE(1) = '1' else 'Z';
A_OE(1) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(2) <= NOT (((NOT D(2) AND addr_latch(2) AND rd_drive)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND NOT row2)
	OR (NOT addr_latch(2) AND NOT rd_drive)
	OR (NOT D(2) AND NOT addr_latch(0) AND rd_drive)
	OR (NOT D(2) AND NOT addr_latch(1) AND rd_drive)
	OR (NOT D(2) AND NOT IOM AND rd_drive)));
A(2) <= A_I(2) when A_OE(2) = '1' else 'Z';
A_OE(2) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(3) <= ((D(3) AND NOT addr_latch(1) AND rd_drive)
	OR (D(3) AND addr_latch(2) AND rd_drive)
	OR (D(3) AND NOT IOM AND rd_drive)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND rd_drive AND row3)
	OR (addr_latch(3) AND NOT rd_drive)
	OR (D(3) AND NOT addr_latch(0) AND rd_drive));
A(3) <= A_I(3) when A_OE(3) = '1' else 'Z';
A_OE(3) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(4) <= ((D(4) AND NOT IOM AND rd_drive)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND rd_drive AND row4)
	OR (addr_latch(4) AND NOT rd_drive)
	OR (D(4) AND NOT addr_latch(0) AND rd_drive)
	OR (D(4) AND NOT addr_latch(1) AND rd_drive)
	OR (D(4) AND addr_latch(2) AND rd_drive));
A(4) <= A_I(4) when A_OE(4) = '1' else 'Z';
A_OE(4) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(5) <= NOT (((NOT D(5) AND rd_drive)
	OR (NOT addr_latch(5) AND NOT rd_drive)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND rd_drive)));
A(5) <= A_I(5) when A_OE(5) = '1' else 'Z';
A_OE(5) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(6) <= NOT (((NOT D(6) AND rd_drive)
	OR (NOT addr_latch(6) AND NOT rd_drive)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	IOM AND rd_drive)));
A(6) <= A_I(6) when A_OE(6) = '1' else 'Z';
A_OE(6) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_I(7) <= ((D(7) AND NOT IOM AND rd_drive)
	OR (addr_latch(0) AND addr_latch(1) AND NOT addr_latch(2) AND 
	NOT bit_cnt(0) AND NOT bit_cnt(1) AND NOT bit_cnt(2) AND NOT bit_cnt(3) AND IOM AND 
	rd_drive)
	OR (addr_latch(7) AND NOT rd_drive)
	OR (D(7) AND NOT addr_latch(0) AND rd_drive)
	OR (D(7) AND NOT addr_latch(1) AND rd_drive)
	OR (D(7) AND addr_latch(2) AND rd_drive));
A(7) <= A_I(7) when A_OE(7) = '1' else 'Z';
A_OE(7) <= NOT A_7_IOBUFE/A_7_IOBUFE_TRST;


A_7_IOBUFE/A_7_IOBUFE_TRST <= (NOT rd_drive AND NOT in_wb);


CS1 <= '1';


CS_n <= ((IOM AND NOT in_wb)
	OR (NOT A15 AND NOT in_wb));


CSr_n <= NOT ((NOT IOM AND NOT A15));

FDCPE_D0: FDCPE port map (D_I(0),D(0),clk,cpu_rst_r,'0');
D(0) <= ((bus_ld_t1 AND D(0).PIN)
	OR (D(0) AND NOT bus_ld_t1 AND NOT bus_ld_t2)
	OR (NOT bus_ld_t1 AND bus_ld_t2 AND A(0).PIN));
D(0) <= D_I(0) when D_OE(0) = '1' else 'Z';
D_OE(0) <= in_wb;

FDCPE_D1: FDCPE port map (D_I(1),D(1),clk,cpu_rst_r,'0');
D(1) <= ((bus_ld_t1 AND D(1).PIN)
	OR (D(1) AND NOT bus_ld_t1 AND NOT bus_ld_t2)
	OR (NOT bus_ld_t1 AND bus_ld_t2 AND A(1).PIN));
D(1) <= D_I(1) when D_OE(1) = '1' else 'Z';
D_OE(1) <= in_wb;

FDCPE_D2: FDCPE port map (D_I(2),D(2),clk,cpu_rst_r,'0');
D(2) <= ((bus_ld_t1 AND D(2).PIN)
	OR (D(2) AND NOT bus_ld_t1 AND NOT bus_ld_t2)
	OR (NOT bus_ld_t1 AND bus_ld_t2 AND A(2).PIN));
D(2) <= D_I(2) when D_OE(2) = '1' else 'Z';
D_OE(2) <= in_wb;

FDCPE_D3: FDCPE port map (D_I(3),D(3),clk,cpu_rst_r,'0');
D(3) <= ((bus_ld_t1 AND D(3).PIN)
	OR (D(3) AND NOT bus_ld_t1 AND NOT bus_ld_t2)
	OR (NOT bus_ld_t1 AND bus_ld_t2 AND A(3).PIN));
D(3) <= D_I(3) when D_OE(3) = '1' else 'Z';
D_OE(3) <= in_wb;

FDCPE_D4: FDCPE port map (D_I(4),D(4),clk,cpu_rst_r,'0');
D(4) <= ((bus_ld_t1 AND D(4).PIN)
	OR (D(4) AND NOT bus_ld_t1 AND NOT bus_ld_t2)
	OR (NOT bus_ld_t1 AND bus_ld_t2 AND A(4).PIN));
D(4) <= D_I(4) when D_OE(4) = '1' else 'Z';
D_OE(4) <= in_wb;

FDCPE_D5: FDCPE port map (D_I(5),D(5),clk,cpu_rst_r,'0');
D(5) <= ((bus_ld_t1 AND D(5).PIN)
	OR (D(5) AND NOT bus_ld_t1 AND NOT bus_ld_t2)
	OR (NOT bus_ld_t1 AND bus_ld_t2 AND A(5).PIN));
D(5) <= D_I(5) when D_OE(5) = '1' else 'Z';
D_OE(5) <= in_wb;

FDCPE_D6: FDCPE port map (D_I(6),D(6),clk,cpu_rst_r,'0');
D(6) <= ((bus_ld_t1 AND D(6).PIN)
	OR (D(6) AND NOT bus_ld_t1 AND NOT bus_ld_t2)
	OR (NOT bus_ld_t1 AND bus_ld_t2 AND A(6).PIN));
D(6) <= D_I(6) when D_OE(6) = '1' else 'Z';
D_OE(6) <= in_wb;

FDCPE_D7: FDCPE port map (D_I(7),D(7),clk,cpu_rst_r,'0');
D(7) <= ((bus_ld_t1 AND D(7).PIN)
	OR (D(7) AND NOT bus_ld_t1 AND NOT bus_ld_t2)
	OR (NOT bus_ld_t1 AND bus_ld_t2 AND A(7).PIN));
D(7) <= D_I(7) when D_OE(7) = '1' else 'Z';
D_OE(7) <= in_wb;




OE_n <= NOT (((in_wb AND FC_2_.OUT)
	OR (NOT IOM AND A15 AND FC_2_.OUT)));


OEr_n <= NOT ((NOT state_FSM_FFd2 AND NOT state_FSM_FFd3 AND NOT IOM AND NOT A15));


READY <= '1';

FDCPE_RESET_IN: FDCPE port map (RESET_IN,RESET_IN_D,clk,'0','0');
RESET_IN_D <= ((RESET_IN AND NOT rst_press)
	OR (NOT rst_press AND rst_cnt(0) AND rst_cnt(1) AND 
	rst_cnt(2) AND clkout_sync AND NOT clkout_d));

FDCPE_RST75: FDCPE port map (RST75,RST75_D,clk,'0','0');
RST75_D <= ((RST75 AND NOT tmr_wr06)
	OR (NOT tmr_cnt(0) AND NOT tmr_cnt(1) AND NOT tmr_cnt(2) AND NOT tmr_wr06));


SID <= RX;

FTCPE_SND: FTCPE port map (SND,SND_T,clk,cpu_rst_r,'0');
SND_T <= ((SND AND addr_latch(0) AND NOT addr_latch(1) AND 
	NOT addr_latch(2) AND io_wr AND NOT A(4).PIN)
	OR (NOT SND AND addr_latch(0) AND NOT addr_latch(1) AND 
	NOT addr_latch(2) AND io_wr AND A(4).PIN));

FDCPE_TX: FDCPE port map (TX,TX_D,clk,'0',cpu_rst_r);
TX_D <= ((TX AND NOT ld_tx_q AND NOT baud_tick)
	OR (NOT ld_tx_q AND baud_tick AND shreg(1)));


WE_n <= NOT (((state_FSM_FFd2 AND state_FSM_FFd3)
	OR (state_FSM_FFd3 AND NOT state_FSM_FFd1)));

FTCPE_X1: FTCPE port map (X1,t0_q,clk,'0','0');

FDCPE_addr_latch0: FDCPE port map (addr_latch(0),addr_latch_D(0),clk,cpu_rst_r,'0');
addr_latch_D(0) <= ((addr_latch(0) AND NOT $OpTx$FX_DC$115)
	OR (A(0).PIN AND $OpTx$FX_DC$115));

FDCPE_addr_latch1: FDCPE port map (addr_latch(1),addr_latch_D(1),clk,cpu_rst_r,'0');
addr_latch_D(1) <= ((addr_latch(1) AND NOT $OpTx$FX_DC$115)
	OR (A(1).PIN AND $OpTx$FX_DC$115));

FDCPE_addr_latch2: FDCPE port map (addr_latch(2),addr_latch_D(2),clk,cpu_rst_r,'0');
addr_latch_D(2) <= ((addr_latch(2) AND NOT $OpTx$FX_DC$115)
	OR (A(2).PIN AND $OpTx$FX_DC$115));

FDCPE_addr_latch3: FDCPE port map (addr_latch(3),addr_latch_D(3),clk,cpu_rst_r,'0');
addr_latch_D(3) <= ((addr_latch(3) AND NOT $OpTx$FX_DC$115)
	OR (A(3).PIN AND $OpTx$FX_DC$115));

FDCPE_addr_latch4: FDCPE port map (addr_latch(4),addr_latch_D(4),clk,cpu_rst_r,'0');
addr_latch_D(4) <= ((addr_latch(4) AND NOT $OpTx$FX_DC$115)
	OR (A(4).PIN AND $OpTx$FX_DC$115));

FDCPE_addr_latch5: FDCPE port map (addr_latch(5),addr_latch_D(5),clk,cpu_rst_r,'0');
addr_latch_D(5) <= ((addr_latch(5) AND NOT $OpTx$FX_DC$115)
	OR (A(5).PIN AND $OpTx$FX_DC$115));

FDCPE_addr_latch6: FDCPE port map (addr_latch(6),addr_latch_D(6),clk,cpu_rst_r,'0');
addr_latch_D(6) <= ((addr_latch(6) AND NOT $OpTx$FX_DC$115)
	OR (A(6).PIN AND $OpTx$FX_DC$115));

FDCPE_addr_latch7: FDCPE port map (addr_latch(7),addr_latch_D(7),clk,cpu_rst_r,'0');
addr_latch_D(7) <= ((addr_latch(7) AND NOT $OpTx$FX_DC$115)
	OR (A(7).PIN AND $OpTx$FX_DC$115));

FDCPE_baud_cnt0: FDCPE port map (baud_cnt(0),baud_cnt_D(0),clk,cpu_rst_r,'0');
baud_cnt_D(0) <= (NOT ld_tx_q AND NOT baud_tick AND NOT baud_cnt(0));

